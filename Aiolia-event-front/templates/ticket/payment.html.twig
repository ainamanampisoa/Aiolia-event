{% extends 'base.html.twig' %}

{% block title %}Paiement - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('vente-ticket/css/payment.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    <main class="payment-page">
        <div class="container">
            {% set items = items|default([]) %}
            {% set orderTotal = orderTotal|default(0) %}
            {% set serviceFees = serviceFees|default(0) %}
            {% set grandTotal = orderTotal + serviceFees %}

            <header class="payment-header">
                {# <span class="badge-step">Étape 2 sur 3</span> #}
                <h1>Paiement sécurisé</h1>
                <p>
                    {% if orderReference is defined %}Référence de commande : <strong>{{ orderReference }}</strong>{% endif %}
                </p>
            </header>

            {# Affichage des messages flash #}
            {% for message in app.flashes('error') %}
                <div class="alert alert-error" style="background: #fee; border: 1px solid #fcc; padding: 15px; margin: 20px 0; border-radius: 8px; color: #c33;">
                    <i class="fas fa-exclamation-circle"></i> {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success" style="background: #efe; border: 1px solid #cfc; padding: 15px; margin: 20px 0; border-radius: 8px; color: #3c3;">
                    <i class="fas fa-check-circle"></i> {{ message }}
                </div>
            {% endfor %}

            <div class="payment-layout">
                <section class="payment-summary">
                    <h2>Résumé de la commande</h2>
                    <div class="summary-card">
                        {% if items|length > 0 %}
                            <ul class="summary-list">
                                {% for item in items %}
                                    {% set adultTotal = item.adultQuantity * item.event.adultPrice %}
                                    {% set childPrice = item.event.childPrice ?? 0 %}
                                    {% set childTotal = item.childQuantity * childPrice %}
                                    <li class="summary-item">
                                        <div class="summary-info">
                                            <span class="event-category">{{ item.event.category }}</span>
                                            <h3>{{ item.event.title }}</h3>
                                            <p>
                                                <i class="fas fa-calendar-day"></i> {{ item.event.date|date('d M Y · H:i') }}<br>
                                                <i class="fas fa-map-marker-alt"></i> {{ item.event.location }}
                                            </p>
                                        </div>
                                        <div class="summary-pricing">
                                            <div>
                                                <span>{{ item.adultQuantity }} billet(s) adulte</span>
                                                <strong>{{ adultTotal|number_format(0, ',', ' ') }} MGA</strong>
                                            </div>
                                            {% if childPrice > 0 %}
                                                <div>
                                                    <span>{{ item.childQuantity }} billet(s) enfant</span>
                                                    <strong>{{ childTotal|number_format(0, ',', ' ') }} MGA</strong>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <div class="summary-empty">
                                <i class="fas fa-ticket-alt"></i>
                                <p>Aucun billet trouvé. Retournez au panier pour ajouter des événements.</p>
                                <a href="{{ path('cart') }}" class="btn-link">Retour au panier</a>
                            </div>
                        {% endif %}

                        <div class="summary-totals">
                            <div class="line">
                                <span>Sous-total</span>
                                <span>{{ orderTotal|number_format(0, ',', ' ') }} MGA</span>
                            </div>
                            <div class="line">
                                <span>Frais de service</span>
                                <span>{{ serviceFees|number_format(0, ',', ' ') }} MGA</span>
                            </div>
                            <div class="line total">
                                <span>Total à payer</span>
                                <span>{{ grandTotal|number_format(0, ',', ' ') }} MGA</span>
                            </div>
                        </div>
                    </div>

                    <div class="support-card">
                        <h3>Besoin d'aide ?</h3>
                        <p>Contactez notre support au <strong>034 12 345 67</strong> ou par e-mail : support@venteticket.mg</p>
                        <span class="availability">Disponible 7j/7 de 8h à 20h</span>
                    </div>
                </section>

                <section class="payment-content">
                    <form class="payment-form" action="{{ path('checkout_process') }}{% if app.request.query.get('event') %}?event={{ app.request.query.get('event') }}{% endif %}" method="post">
                        <div class="form-section">
                            <h2>Méthode de paiement</h2>
                            <div class="method-grid">
                                <label class="method-option" data-method="mvola">
                                    <input type="radio" name="payment_method" value="mvola" checked>
                                    <span class="method-content">
                                        <span class="method-icon">
                                            <img src="{{ asset('vente-ticket/images/m-vola.png') }}" alt="M-Vola">
                                        </span>
                                        <span class="method-text">
                                            <strong>M-Vola</strong>
                                            <small>Confirmation immédiate</small>
                                        </span>
                                    </span>
                                </label>
                            </div>
                            <p class="method-note">Vous recevrez un message de confirmation dès que le paiement sera validé.</p>
                        </div>

                        <div class="form-section">
                            <h2>Informations de paiement</h2>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="payment-name">Nom et prénom</label>
                                    <input type="text" id="payment-name" name="payment_name" placeholder="Nom et prénom du titulaire du compte">
                                </div>
                                <div class="form-group">
                                    <label for="payment-email">Adresse e-mail</label>
                                    <input type="email" id="payment-email" name="payment_email" placeholder="exemple@domain.mg">
                                </div>
                                <div class="form-group">
                                    <label for="payment-phone">Numéro de téléphone (Mobile Money)</label>
                                    <input type="tel" id="payment-phone" name="payment_phone" placeholder="034 12 345 67">
                                </div>
                                <div class="form-group">
                                    <label for="payment-invoice">Souhaitez-vous une facture ?</label>
                                    <select id="payment-invoice" name="payment_invoice">
                                        <option value="no">Non</option>
                                        <option value="yes" selected>Oui</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <h2>Conditions</h2>
                            <label class="checkbox">
                                <input type="checkbox" name="terms" checked>
                                <span>J'accepte les conditions générales d'utilisation et la politique de confidentialité.</span>
                            </label>
                            <label class="checkbox">
                                <input type="checkbox" name="receive_emails">
                                <span>Je souhaite recevoir ma confirmation de paiement par SMS et e-mail.</span>
                            </label>
                        </div>

                        <div class="submit-area">
                            <button type="button" class="btn-secondary" onclick="window.location.href='{{ path('cart') }}'">
                                <i class="fas fa-arrow-left"></i> Retour au panier
                            </button>
                            <button type="submit" id="btn-payment-confirm" class="btn-primary">
                                Confirmer et payer {{ grandTotal|number_format(0, ',', ' ') }} MGA
                            </button>
                        </div>
                    </form>

                    <div class="security-note">
                        <i class="fas fa-shield-alt"></i>
                        <div>
                            <strong>Paiement sécurisé</strong>
                            <p>Vos informations sont chiffrées. VenteTicket ne stocke jamais vos données de paiement.</p>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const methodInputs = document.querySelectorAll('.method-option input[type="radio"]');
            const invoiceSelect = document.getElementById('payment-invoice');
            const confirmButton = document.getElementById('btn-payment-confirm');
            const form = document.querySelector('.payment-form');

            methodInputs.forEach(input => {
                const option = input.closest('.method-option');
                input.addEventListener('change', () => {
                    document.querySelectorAll('.method-option').forEach(opt => opt.classList.remove('active'));
                    option.classList.add('active');
                });

                if (input.checked) {
                    option.classList.add('active');
                }
            });


            if (confirmButton && form) {
                form.addEventListener('submit', function (e) {
                    const termsCheckbox = form.querySelector('input[name="terms"]');
                    
                    if (!termsCheckbox || !termsCheckbox.checked) {
                        e.preventDefault();
                        e.stopPropagation();
                        alert('Veuillez accepter les conditions générales d\'utilisation.');
                        return false;
                    }
                    
                    // Désactiver le bouton pour éviter les doubles soumissions
                    confirmButton.disabled = true;
                    const originalText = confirmButton.innerHTML;
                    confirmButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Traitement en cours...';
                    
                    // Laisser le formulaire se soumettre normalement
                    // Ne pas appeler e.preventDefault() ici
                });
            }
        });
    </script>
{% endblock %}
