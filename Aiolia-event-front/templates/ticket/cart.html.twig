{% extends 'base.html.twig' %}

{% block title %}{{ 'tickets.cart_page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/cart.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    <main>
        <section class="sec-event all-event">
            <div class="container">
                <!-- TITRE CENTRÉ -->
                <div class="cart-header wow fadeIn" data-wow-delay="300ms">
                    <h2>{{ 'tickets.cart_title'|trans }}</h2>
                    <p>{{ 'tickets.cart_subtitle'|trans }}</p>
                </div>

                {% if items is defined and items|length == 0 %}
                    <div class="wow fadeInUp empty-cart" data-wow-delay="200ms">
                        <div class="empty-cart-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div class="empty-cart-title">{{ 'tickets.cart_empty_title'|trans }}</div>
                        <p class="empty-cart-desc">{{ 'tickets.cart_empty_desc'|trans }}</p>
                        <a href="{{ path('events') }}" class="btn-checkout-all" style="text-decoration: none; width: fit-content; margin: 0 auto; padding: 12px 24px;">
                            <i class="fas fa-calendar-alt"></i>
                            {{ 'tickets.cart_empty_cta'|trans }}
                        </a>
                    </div>
                {% else %}
                <div class="wow fadeInUp cart-wrap" data-wow-delay="200ms">
                    <div class="cart-items">
                        {% for item in items %}
                        <div class="cart-card" data-event-id="{{ item.event.id }}-{{ loop.index0 }}" data-cart-key="{{ item.cart_key|default('') }}">
                            <!-- En-tête de la carte -->
                            <div class="cart-card-header">
                                <div class="cart-image">
                                    {% set imagePath = item.event.image starts with 'http' ? item.event.image : asset(item.event.image|trim('/')) %}
                                    <img src="{{ imagePath }}" alt="{{ item.event.title }}">
                                </div>
                                    <div class="cart-header-info">
                                        <span class="category-badge">{{ item.event.category }}</span>
                                        <h3>{{ item.event.title }}</h3>
                                        <div class="cart-meta">
                                            <span><i class="fas fa-map-marker-alt"></i> {{ item.event.location }}</span>
                                            <span><i class="fas fa-calendar"></i> {{ item.event.date|date('d M Y — H:i') }}</span>
                                        </div>
                                        
                                        <!-- Timer par événement -->
                                        <div class="event-timer" 
                                             data-event-id="{{ item.event.id }}"
                                             data-added-at="{{ item.event.added_at|date('Y-m-d H:i:s') }}"
                                             data-event-date="{{ item.event.starts_at|date('Y-m-d H:i:s') }}">
                                            <i class="fas fa-clock"></i>
                                            <span>{{ 'tickets.cart_expires_in'|trans }}</span>
                                            <span class="timer-value" id="timer-{{ item.event.id }}-{{ loop.index0 }}">Calcul...</span>
                                        </div>
                                    </div>
                            </div>
                            
                            <!-- Corps de la carte -->
                            <div class="cart-card-body">
                                <!-- Section quantité -->
                                <div class="quantity-section">
                                    <div class="quantity-header">
                                        <h4>Quantités des billets</h4>
                                    </div>
                                    
                                    {# Vérifier les prix disponibles #}
                                    {% set hasAdultPrice = item.event.adultPrice is defined and item.event.adultPrice is not null and item.event.adultPrice > 0 %}
                                    {% set hasChildPrice = item.event.childPrice is defined and item.event.childPrice is not null and item.event.childPrice > 0 %}
                                    
                                    {# Vérifier si c'est un type "all" (même prix pour adulte et enfant, ou seulement un prix) #}
                                    {% set hasNoPrices = not hasAdultPrice and not hasChildPrice %}
                                    {% set hasBothPrices = hasAdultPrice and hasChildPrice %}
                                    {% set hasSamePrice = hasBothPrices and item.event.adultPrice == item.event.childPrice %}
                                    {% set isAllType = hasSamePrice or (hasAdultPrice and not hasChildPrice) or (not hasAdultPrice and hasChildPrice) or hasNoPrices %}
                                    {% set uniquePrice = hasAdultPrice ? item.event.adultPrice : (hasChildPrice ? item.event.childPrice : 0) %}
                                    
                                    {# Si c'est un type "all" (même prix, ou seulement un prix, ou aucun prix), afficher juste "Quantité" #}
                                    {% if isAllType %}
                                        {# Cas : Type "all" ou aucun type - afficher juste "Quantité" #}
                                        <div class="quantity-control" style="justify-content: center;">
                                            <label style="text-align: center; width: 100%;">
                                                <i class="fas fa-ticket-alt"></i> Quantité
                                            </label>
                                            <div class="quantity-input-group">
                                                <div class="numbers-row">
                                                    <button type="button" class="dec button" data-type="quantity">-</button>
                                                    <input type="text" name="quantity_qtt" value="{{ item.adultQuantity + item.childQuantity }}" class="qtt" data-price="{{ uniquePrice }}" data-type="quantity">
                                                    <button type="button" class="inc button" data-type="quantity">+</button>
                                                </div>
                                                <div class="price-indicator">
                                                    {% if uniquePrice > 0 %}
                                                        {{ uniquePrice|number_format(0, ',', ' ') }}MGA / unité
                                                    {% else %}
                                                        Prix non disponible
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        {# Cas : Afficher les inputs adulte et/ou enfant #}
                                        
                                        {# Quantité adultes - afficher seulement si prix adulte existe #}
                                        {% if hasAdultPrice %}
                                        <div class="quantity-control">
                                            <label><i class="fas fa-user"></i> Billets Adultes</label>
                                            <div class="quantity-input-group">
                                                <div class="numbers-row">
                                                    <button type="button" class="dec button" data-type="adult">-</button>
                                                    <input type="text" name="adult_qtt" value="{{ item.adultQuantity }}" class="qtt" data-price="{{ item.event.adultPrice }}" data-type="adult">
                                                    <button type="button" class="inc button" data-type="adult">+</button>
                                                </div>
                                                <div class="price-indicator">
                                                    {{ item.event.adultPrice|number_format(0, ',', ' ') }}MGA / unité
                                                </div>
                                            </div>
                                        </div>
                                        {% endif %}
                                        
                                        {# Quantité enfants #}
                                        {% if hasChildPrice %}
                                        {# Prix enfant disponible - afficher l'input normal #}
                                        <div class="quantity-control">
                                            <label>
                                                <i class="fas fa-child"></i> 
                                                Billets Enfants
                                            </label>
                                            <div class="quantity-input-group">
                                                <div class="numbers-row">
                                                    <button type="button" class="dec button" data-type="child">-</button>
                                                    <input type="text" name="child_qtt" value="{{ item.childQuantity }}" class="qtt" 
                                                           data-price="{{ item.event.childPrice }}" 
                                                           data-type="child">
                                                    <button type="button" class="inc button" data-type="child">+</button>
                                                </div>
                                                <div class="price-indicator">
                                                    {{ item.event.childPrice|number_format(0, ',', ' ') }}MGA / unité
                                                </div>
                                            </div>
                                        </div>
                                        {% elseif hasAdultPrice %}
                                        {# Prix enfant non disponible mais prix adulte existe - afficher avec "(Non disponible)" en rouge #}
                                        <div class="quantity-control disabled">
                                            <label>
                                                <i class="fas fa-child"></i> 
                                                Billets Enfants
                                                <span style="color: #FF0000; font-size: 12px; margin-left: 5px; font-weight: normal;">(Non disponible)</span>
                                            </label>
                                            <div class="quantity-input-group">
                                                <div class="numbers-row">
                                                    <button type="button" class="dec button disabled" data-type="child" disabled>-</button>
                                                    <input type="text" name="child_qtt" value="0" class="qtt disabled" 
                                                           data-price="0" 
                                                           data-type="child"
                                                           disabled>
                                                    <button type="button" class="inc button disabled" data-type="child" disabled>+</button>
                                                </div>
                                                <div class="price-indicator" style="color: #999;">
                                                    Non disponible
                                                </div>
                                            </div>
                                        </div>
                                        {% endif %}
                                    {% endif %}
                                </div>
                                
                                <!-- Résumé par événement -->
                                <div class="event-summary">
                                    <div class="summary-title">
                                        <i class="fas fa-receipt"></i>
                                        Résumé de commande
                                    </div>
                                    
                                    {# Vérifier si c'est un type "all" (même prix ou un seul type) #}
                                    {% set totalQuantity = item.adultQuantity + item.childQuantity %}
                                    {% set hasOnlyOneType = (hasAdultPrice and not hasChildPrice) or (not hasAdultPrice and hasChildPrice) or (not hasAdultPrice and not hasChildPrice) %}
                                    {% set hasSamePrice = hasAdultPrice and hasChildPrice and item.event.adultPrice == item.event.childPrice %}
                                    {% set isAllType = hasOnlyOneType or hasSamePrice %}
                                    {% set unitPrice = hasAdultPrice ? item.event.adultPrice : (hasChildPrice ? item.event.childPrice : 0) %}
                                    
                                    {% if isAllType %}
                                        {# Affichage pour type "all" - juste le nombre total de billets #}
                                        <div class="summary-item">
                                            <span class="total-quantity">{{ totalQuantity }} billet(s)</span>
                                            <span class="total-price">{{ (totalQuantity * unitPrice)|number_format(0, ',', ' ') }}MGA</span>
                                        </div>
                                    {% else %}
                                        {# Affichage séparé adulte/enfant #}
                                        {% if item.adultQuantity > 0 or (hasAdultPrice and not hasChildPrice) %}
                                        <div class="summary-item">
                                            <span class="adult-quantity">{{ item.adultQuantity }} billet(s) adulte</span>
                                            <span class="adult-total">
                                                {% if item.event.adultPrice and item.event.adultPrice > 0 %}
                                                    {{ (item.adultQuantity * item.event.adultPrice)|number_format(0, ',', ' ') }}MGA
                                                {% else %}
                                                    0MGA
                                                {% endif %}
                                            </span>
                                        </div>
                                        {% endif %}
                                        
                                        {% if item.childQuantity > 0 or (hasChildPrice and not hasAdultPrice) %}
                                        <div class="summary-item">
                                            <span class="child-quantity">{{ item.childQuantity }} billet(s) enfant</span>
                                            <span class="child-total">
                                                {% if item.event.childPrice and item.event.childPrice > 0 %}
                                                    {{ (item.childQuantity * item.event.childPrice)|number_format(0, ',', ' ') }}MGA
                                                {% else %}
                                                    0MGA
                                                {% endif %}
                                            </span>
                                        </div>
                                        {% endif %}
                                    {% endif %}
                                    
                                    <div class="summary-item">
                                        <span>Frais de service</span>
                                        <span>0MGA</span>
                                    </div>
                                    
                                    <!-- TOTAL AMÉLIORÉ - PLUS COMPACT -->
                                    <div class="summary-item total">
                                        <span class="total-label">Total</span>
                                        <span class="total-amount" id="subtotal-{{ item.event.id }}-{{ loop.index0 }}">
                                            {% set adultTotal = (item.adultQuantity * (item.event.adultPrice ?? 0)) %}
                                            {% set childTotal = (item.childQuantity * (item.event.childPrice ?? 0)) %}
                                            {{ (adultTotal + childTotal)|number_format(0, ',', ' ') }}MGA
                                        </span>
                                    </div>
                                    
                                    <div class="summary-actions">
                                        <button class="btn-icon btn-remove remove-item" data-event-id="{{ item.event.id }}-{{ loop.index0 }}" data-cart-key="{{ item.cart_key|default('') }}" title="Retirer du panier">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                        <!-- ICÔNE VERTE POUR VALIDER -->
                                        <button class="btn-icon btn-validate validate-event" data-event-id="{{ item.event.id }}-{{ loop.index0 }}" title="Valider cet événement">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Code promo -->
                                <div class="promo-section">
                                    <div class="cart-line-promo">
                                        <input type="text" class="chp" placeholder="Entrez un code promo pour cet événement">
                                        <button class="btn-promo apply-promo">
                                            <i class="fas fa-tag"></i>
                                            Appliquer
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    
                    <!-- Actions globales -->
                    <div class="global-actions wow fadeInUp" data-wow-delay="400ms">
                        <a href="{{ path('events') }}" class="btn-continue">
                            <i class="fas fa-arrow-left"></i>
                            Continuer mes achats
                        </a>
                        <button class="btn-checkout-all">
                            <i class="fas fa-lock"></i>
                            Valider tout le panier
                        </button>
                    </div>
                    
                    <!-- PAGINATION - EN BAS -->
                    {% set totalEvents = items|length %}
                    {% set eventsPerPage = 4 %}
                    {% set totalPages = (totalEvents / eventsPerPage)|round(0, 'ceil') %}
                    
                    {% if totalEvents > eventsPerPage %}
                    <div class="pagination-container wow fadeInUp" data-wow-delay="500ms">
                        <div class="pagination">
                            <button class="page-btn prev disabled">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            
                            {% for i in 1..totalPages %}
                                <button class="page-btn {% if i == 1 %}active{% endif %}" data-page="{{ i }}">
                                    {{ i }}
                                </button>
                            {% endfor %}
                            
                            <button class="page-btn next {% if totalPages == 1 %}disabled{% endif %}">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
    <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
<script>
    // Charger le panier depuis LocalStorage au démarrage si disponible
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof CartStorage !== 'undefined') {
            // Charger depuis LocalStorage immédiatement pour un affichage rapide
            const localItems = CartStorage.getItems();
            if (Object.keys(localItems).length > 0) {
                // Synchroniser avec le serveur
                CartStorage.loadFromServer(function(data) {
                    if (data.status === 'success') {
                        // Recharger la page pour afficher les items fusionnés
                        // ou mettre à jour le DOM directement
                        console.log('Panier chargé depuis le serveur:', data);
                    }
                });
            }
        }
    });
    
    // Timers individuels par événement
    const eventTimers = {};
    
    // Ancienne fonction startEventTimer remplacée par initEventTimers
    // Conservée pour compatibilité mais non utilisée
    function startEventTimer_OLD(eventId, minutes, seconds) {
        let totalSeconds = minutes * 60 + seconds;
        const timerElement = document.getElementById('timer-' + eventId);
        
        if (!timerElement) return;
        
        eventTimers[eventId] = setInterval(function() {
            const mins = Math.floor(totalSeconds / 60);
            const secs = totalSeconds % 60;
            
            timerElement.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            
            // Changement de couleur pour les dernières minutes
            if (mins < 5) {
                timerElement.parentElement.style.background = 'var(--danger)';
            }
            
            if (totalSeconds <= 0) {
                clearInterval(eventTimers[eventId]);
                timerElement.textContent = '00:00';
                showEventExpiredModal(eventId);
            }
            
            totalSeconds--;
        }, 1000);
    }

    function showEventExpiredModal(eventId) {
        const card = document.querySelector(`[data-event-id="${eventId}"]`);
        if (!card) return;
        
        card.style.opacity = '0.6';
        card.style.pointerEvents = 'none';
        
        // Ajouter un badge "Expiré"
        const expiredBadge = document.createElement('div');
        expiredBadge.style.cssText = `
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(255, 112, 112, 0.95);
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            z-index: 10;
            font-size: 16px;
        `;
        expiredBadge.textContent = 'Temps écoulé';
        card.style.position = 'relative';
        card.appendChild(expiredBadge);
    }

    // Gestion des quantités avec calcul automatique
    document.addEventListener('DOMContentLoaded', function() {
        // Initialiser les gestionnaires d'événements
        initQuantityHandlers();
        initActionButtons();
        initPagination();
        
        // Démarrer les timers pour chaque événement (15 minutes chacun)
        // Bouton de validation globale
        document.querySelector('.btn-checkout-all').addEventListener('click', function() {
            window.location.href = '{{ path("checkout_payment") }}';
        });
        
        // Initialiser les timers de compte à rebours
        initEventTimers();
    });
    
    /**
     * Initialise les timers de compte à rebours pour chaque événement dans le panier
     */
    function initEventTimers() {
        const timers = document.querySelectorAll('.event-timer');
        
        timers.forEach(timer => {
            const eventId = timer.dataset.eventId;
            const addedAt = timer.dataset.addedAt;
            const eventDate = timer.dataset.eventDate;
            const timerValue = timer.querySelector('.timer-value');
            
            if (!addedAt || !eventDate || !timerValue) {
                timerValue.textContent = 'N/A';
                return;
            }
            
            // Convertir les dates en objets Date
            const addedDate = new Date(addedAt);
            const eventDateTime = new Date(eventDate);
            
            // Calculer la durée totale entre l'ajout et l'événement
            const totalDuration = eventDateTime - addedDate;
            
            if (totalDuration <= 0) {
                timerValue.textContent = 'Expiré';
                timer.classList.add('expired');
                return;
            }
            
            // Fonction pour mettre à jour le timer
            function updateTimer() {
                const now = new Date();
                const elapsed = now - addedDate;
                const remaining = totalDuration - elapsed;
                
                if (remaining <= 0) {
                    timerValue.textContent = 'Expiré';
                    timer.classList.add('expired');
                    return;
                }
                
                // Calculer les jours, heures, minutes et secondes
                const days = Math.floor(remaining / (1000 * 60 * 60 * 24));
                const hours = Math.floor((remaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((remaining % (1000 * 60)) / 1000);
                
                // Formater l'affichage - TOUJOURS afficher les secondes pour que ça bouge
                let timeString = '';
                if (days > 0) {
                    timeString = `${days}j ${hours.toString().padStart(2, '0')}h ${minutes.toString().padStart(2, '0')}m ${seconds.toString().padStart(2, '0')}s`;
                } else if (hours > 0) {
                    timeString = `${hours}h ${minutes.toString().padStart(2, '0')}m ${seconds.toString().padStart(2, '0')}s`;
                } else {
                    timeString = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                }
                
                timerValue.textContent = timeString;
                
                // Ajouter une classe si le temps est critique (moins de 1 heure)
                if (remaining < 3600000) { // 1 heure en millisecondes
                    timer.classList.add('critical');
                } else {
                    timer.classList.remove('critical');
                }
            }
            
            // Mettre à jour immédiatement
            updateTimer();
            
            // Mettre à jour toutes les secondes
            setInterval(updateTimer, 1000);
        });
    }

    function initQuantityHandlers() {
        // Utilisation de la délégation d'événements avec stopImmediatePropagation
        document.addEventListener('click', function(event) {
            const button = event.target;
            
            // Vérifier si c'est un bouton + ou - et qu'il n'est pas désactivé
            if (button.classList.contains('button') && 
                (button.classList.contains('inc') || button.classList.contains('dec')) &&
                !button.classList.contains('disabled')) {
                
                // EMPÊCHER LA PROPAGATION IMMÉDIATE POUR ÉVITER LE DOUBLE DÉCLENCHEMENT
                event.stopImmediatePropagation();
                event.preventDefault();
                
                const type = button.dataset.type;
                const input = button.closest('.numbers-row').querySelector('.qtt[data-type="' + type + '"]');
                
                // Vérifier si l'input n'est pas désactivé
                if (!input || input.disabled) return;
                
                let value = parseInt(input.value) || 0;
                
                if (button.classList.contains('dec')) {
                    // Bouton - : diminuer de 1, minimum 0
                    value = Math.max(0, value - 1);
                } else {
                    // Bouton + : augmenter de 1
                    value = value + 1;
                }
                
                // Mettre à jour la valeur de l'input
                input.value = value;
                
                // Déclencher l'événement change pour forcer la mise à jour
                const changeEvent = new Event('change', { bubbles: true });
                input.dispatchEvent(changeEvent);
            }
        }, true); // Utiliser capture: true pour exécuter notre code en premier

        // Gestion des changements manuels dans l'input
        document.addEventListener('change', function(event) {
            if (event.target.classList.contains('qtt') && !event.target.classList.contains('disabled')) {
                const input = event.target;
                let value = parseInt(input.value);
                
                if (isNaN(value) || value < 0) {
                    input.value = 0;
                    value = 0;
                }
                
                // Mettre à jour le résumé
                updateEventSummary(input.closest('.cart-card'));
            }
        });

        // Nettoyer l'input pour n'accepter que des chiffres
        document.addEventListener('input', function(event) {
            if (event.target.classList.contains('qtt') && !event.target.classList.contains('disabled')) {
                event.target.value = event.target.value.replace(/[^0-9]/g, '');
            }
        });
    }

    function initActionButtons() {
        // Boutons retirer
        document.querySelectorAll('.remove-item').forEach(button => {
            button.addEventListener('click', function() {
                const eventId = this.dataset.eventId;
                const cartKey = this.dataset.cartKey;
                const card = this.closest('.cart-card');
                
                if (!cartKey) {
                    alert('Erreur: impossible de retirer cet élément.');
                    console.error('Cart key manquante pour eventId:', eventId);
                    return;
                }
                
                // Arrêter le timer
                if (eventTimers[eventId]) {
                    clearInterval(eventTimers[eventId]);
                }
                
                // Désactiver le bouton pendant la requête
                this.disabled = true;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                
                // Appel AJAX pour supprimer de la session
                const removeUrl = '{{ path("remove_from_cart", {"cartKey": "CART_KEY_PLACEHOLDER"}) }}'.replace('CART_KEY_PLACEHOLDER', encodeURIComponent(cartKey));
                fetch(removeUrl, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json',
                    },
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'success') {
                        // Animation de suppression
                        card.style.transform = 'scale(0.8)';
                        card.style.opacity = '0';
                        
                        setTimeout(() => {
                            // Supprimer de LocalStorage aussi
                            if (typeof CartStorage !== 'undefined') {
                                CartStorage.removeItem(cartKey);
                                // Synchroniser avec le serveur
                                CartStorage.syncWithServer();
                            }
                            
                            card.remove();
                            checkEmptyCart();
                            updatePaginationDisplay();
                            // Mettre à jour le badge du panier
                            const remainingItems = document.querySelectorAll('.cart-card').length;
                            updateCartBadge(remainingItems);
                            // Déclencher un événement pour mettre à jour le badge sur toutes les pages
                            document.dispatchEvent(new CustomEvent('cartUpdated', { detail: { count: remainingItems } }));
                        }, 300);
                    } else {
                        alert('Erreur: ' + (data.message || 'Impossible de retirer cet élément.'));
                        this.disabled = false;
                        this.innerHTML = '<i class="fas fa-trash"></i>';
                    }
                })
                .catch(error => {
                    console.error('Erreur lors de la suppression:', error);
                    alert('Erreur lors de la suppression. Veuillez réessayer.');
                    this.disabled = false;
                    this.innerHTML = '<i class="fas fa-trash"></i>';
                });
            });
        });

        // Boutons appliquer promo
        document.querySelectorAll('.apply-promo').forEach(button => {
            button.addEventListener('click', function() {
                const input = this.previousElementSibling;
                const code = input.value.trim();
                
                if (code) {
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    this.disabled = true;
                    
                    // Simulation d'appel API
                    setTimeout(() => {
                        this.innerHTML = '<i class="fas fa-check"></i> Appliqué';
                        this.style.background = 'var(--success)';
                        input.style.borderColor = 'var(--success)';
                        input.disabled = true;
                    }, 1000);
                }
            });
        });

        // Boutons valider événement
        document.querySelectorAll('.validate-event').forEach(button => {
            button.addEventListener('click', function() {
                const eventId = this.dataset.eventId;
                // Arrêter le timer
                if (eventTimers[eventId]) {
                    clearInterval(eventTimers[eventId]);
                }
                // Redirection vers la page de validation
                window.location.href = '{{ path("checkout_payment") }}?event=' + eventId;
            });
        });
    }

    function initPagination() {
        const pageButtons = document.querySelectorAll('.page-btn:not(.disabled)');
        const eventsPerPage = 4;
        let currentPage = 1;
        
        // Initialiser l'affichage de la pagination
        updatePaginationDisplay(currentPage);
        
        pageButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                if (this.classList.contains('disabled')) return;
                
                if (this.classList.contains('prev')) {
                    if (currentPage > 1) {
                        currentPage--;
                    }
                } else if (this.classList.contains('next')) {
                    const totalEvents = document.querySelectorAll('.cart-card').length;
                    const totalPages = Math.ceil(totalEvents / eventsPerPage);
                    if (currentPage < totalPages) {
                        currentPage++;
                    }
                } else {
                    currentPage = parseInt(this.dataset.page);
                }
                
                updatePaginationDisplay(currentPage);
            });
        });
    }

    function updatePaginationDisplay(page = 1) {
        const events = document.querySelectorAll('.cart-card');
        const eventsPerPage = 4;
        const totalEvents = events.length;
        const totalPages = Math.ceil(totalEvents / eventsPerPage);
        
        // Masquer tous les événements
        events.forEach(event => {
            event.style.display = 'none';
        });
        
        // Afficher les événements de la page courante
        const startIndex = (page - 1) * eventsPerPage;
        const endIndex = startIndex + eventsPerPage;
        
        for (let i = startIndex; i < endIndex && i < totalEvents; i++) {
            if (events[i]) {
                events[i].style.display = 'flex';
            }
        }
        
        // Mettre à jour les boutons de pagination
        const pageButtons = document.querySelectorAll('.page-btn');
        pageButtons.forEach(btn => {
            btn.classList.remove('active');
            if (!btn.classList.contains('prev') && !btn.classList.contains('next')) {
                if (parseInt(btn.dataset.page) === page) {
                    btn.classList.add('active');
                }
            }
        });
        
        // Mettre à jour les boutons précédent/suivant
        const prevBtn = document.querySelector('.page-btn.prev');
        const nextBtn = document.querySelector('.page-btn.next');
        
        if (prevBtn) {
            if (page === 1) {
                prevBtn.classList.add('disabled');
            } else {
                prevBtn.classList.remove('disabled');
            }
        }
        
        if (nextBtn) {
            if (page === totalPages) {
                nextBtn.classList.add('disabled');
            } else {
                nextBtn.classList.remove('disabled');
            }
        }
    }

    // FONCTION PRINCIPALE DE SYNCHRONISATION
    function updateEventSummary(card) {
        // Récupérer les inputs adultes et enfants
        const adultInput = card.querySelector('.qtt[data-type="adult"]');
        const childInput = card.querySelector('.qtt[data-type="child"]');
        const quantityInput = card.querySelector('.qtt[data-type="quantity"]');
        
        // Déterminer les quantités et les prix
        let adultQty = 0;
        let childQty = 0;
        let adultPrice = 0;
        let childPrice = 0;
        let isAllType = false;
        
        if (quantityInput) {
            // Mode quantité unique (type "all")
            adultQty = parseInt(quantityInput.value) || 0;
            childQty = 0;
            adultPrice = parseFloat(quantityInput.dataset.price) || 0;
            childPrice = 0;
            isAllType = true;
        } else {
            // Mode adulte/enfant
            if (adultInput) {
                adultQty = parseInt(adultInput.value) || 0;
                adultPrice = parseFloat(adultInput.dataset.price) || 0;
            }
            if (childInput && !childInput.disabled) {
                childQty = parseInt(childInput.value) || 0;
                childPrice = parseFloat(childInput.dataset.price) || 0;
            }
            
            // Vérifier si c'est un type "all" (mêmes prix ou un seul type)
            const hasAdultPrice = adultPrice > 0;
            const hasChildPrice = childPrice > 0;
            const hasOnlyOneType = (hasAdultPrice && !hasChildPrice) || (!hasAdultPrice && hasChildPrice);
            const hasSamePrice = hasAdultPrice && hasChildPrice && adultPrice === childPrice;
            isAllType = hasOnlyOneType || hasSamePrice;
        }
        
        const totalQty = adultQty + childQty;
        const adultTotal = adultQty * adultPrice;
        const childTotal = childQty * childPrice;
        const subtotal = adultTotal + childTotal;
        const unitPrice = adultPrice || childPrice || 0;
        
        // METTRE À JOUR LE RÉSUMÉ
        const adultQuantityElement = card.querySelector('.adult-quantity');
        const adultTotalElement = card.querySelector('.adult-total');
        const childQuantityElement = card.querySelector('.child-quantity');
        const childTotalElement = card.querySelector('.child-total');
        const totalQuantityElement = card.querySelector('.total-quantity');
        const totalPriceElement = card.querySelector('.total-price');
        const subtotalElement = card.querySelector('.total-amount');
        
        if (isAllType) {
            // Affichage pour type "all" - juste le nombre total
            // Cacher les éléments adulte/enfant si présents
            const adultItem = adultQuantityElement?.closest('.summary-item');
            const childItem = childQuantityElement?.closest('.summary-item');
            if (adultItem && adultItem !== card.querySelector('.summary-item.total')) {
                adultItem.style.display = 'none';
            }
            if (childItem && childItem !== card.querySelector('.summary-item.total')) {
                childItem.style.display = 'none';
            }
            
            // Afficher ou créer l'élément total
            let quantitySpan = totalQuantityElement;
            let priceSpan = totalPriceElement;
            
            if (!quantitySpan || !priceSpan) {
                // Créer l'élément si il n'existe pas
                const summaryItemsContainer = card.querySelector('.event-summary');
                const existingItems = summaryItemsContainer.querySelectorAll('.summary-item:not(.total)');
                let firstItem = null;
                
                // Trouver le premier élément non masqué
                for (let item of existingItems) {
                    if (item.style.display !== 'none' && !item.querySelector('.total-quantity')) {
                        firstItem = item;
                        break;
                    }
                }
                
                // Créer un nouvel élément pour le total
                const newItem = document.createElement('div');
                newItem.className = 'summary-item';
                quantitySpan = document.createElement('span');
                quantitySpan.className = 'total-quantity';
                priceSpan = document.createElement('span');
                priceSpan.className = 'total-price';
                newItem.appendChild(quantitySpan);
                newItem.appendChild(priceSpan);
                
                if (firstItem) {
                    summaryItemsContainer.insertBefore(newItem, firstItem);
                } else {
                    const summaryTitle = summaryItemsContainer.querySelector('.summary-title');
                    if (summaryTitle && summaryTitle.nextSibling) {
                        summaryItemsContainer.insertBefore(newItem, summaryTitle.nextSibling);
                    } else {
                        summaryItemsContainer.appendChild(newItem);
                    }
                }
            }
            
            // Afficher l'élément si il était masqué
            const totalItem = quantitySpan.closest('.summary-item');
            if (totalItem) {
                totalItem.style.display = '';
            }
            
            if (quantitySpan) {
                quantitySpan.textContent = `${totalQty} billet(s)`;
            }
            if (priceSpan) {
                priceSpan.textContent = `${(totalQty * unitPrice).toLocaleString('fr-FR')}MGA`;
            }
        } else {
            // Affichage séparé adulte/enfant
            // Cacher l'élément total si présent
            const totalItem = totalQuantityElement?.closest('.summary-item');
            if (totalItem && totalItem !== card.querySelector('.summary-item.total')) {
                totalItem.style.display = 'none';
            }
            
            // Afficher les éléments adulte/enfant
            const adultItem = adultQuantityElement?.closest('.summary-item');
            const childItem = childQuantityElement?.closest('.summary-item');
            if (adultItem && adultItem !== card.querySelector('.summary-item.total')) {
                adultItem.style.display = '';
            }
            if (childItem && childItem !== card.querySelector('.summary-item.total')) {
                childItem.style.display = '';
            }
            
            // Synchroniser les quantités dans le résumé
            if (adultQuantityElement) {
                adultQuantityElement.textContent = `${adultQty} billet(s) adulte`;
            }
            if (adultTotalElement) {
                adultTotalElement.textContent = `${adultTotal.toLocaleString('fr-FR')}MGA`;
            }
            if (childQuantityElement) {
                childQuantityElement.textContent = `${childQty} billet(s) enfant`;
            }
            if (childTotalElement) {
                childTotalElement.textContent = `${childTotal.toLocaleString('fr-FR')}MGA`;
            }
        }
        
        // Mettre à jour le total dans tous les cas
        if (subtotalElement) {
            subtotalElement.textContent = `${subtotal.toLocaleString('fr-FR')}MGA`;
        }
    }

    function checkEmptyCart() {
        const items = document.querySelectorAll('.cart-card');
        if (items.length === 0) {
            updateCartBadge();
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        }
    }
    
    // La fonction updateCartBadge est définie globalement dans base.html.twig
    // On peut l'appeler directement ici
</script>
