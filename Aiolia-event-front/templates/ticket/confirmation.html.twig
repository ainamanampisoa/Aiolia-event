{% extends 'base.html.twig' %}

{% block title %}Confirmation d'achat - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .confirmation-section {
            padding: 80px 0;
            min-height: 60vh;
        }
        .confirmation-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 50px 40px;
            max-width: 700px;
            margin: 0 auto;
            text-align: center;
        }
        .confirmation-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            color: white;
            font-size: 50px;
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        }
        .confirmation-title {
            font-size: 32px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 15px;
        }
        .confirmation-message {
            color: #6b7280;
            font-size: 18px;
            margin-bottom: 40px;
            line-height: 1.6;
        }
        .order-details-box {
            background: #f9fafb;
            border-radius: 12px;
            padding: 30px;
            margin: 40px 0;
            text-align: left;
            border: 1px solid #e5e7eb;
        }
        .order-detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid #e5e7eb;
        }
        .order-detail-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        .order-detail-label {
            color: #6b7280;
            font-size: 15px;
            font-weight: 500;
        }
        .order-detail-value {
            color: #1f2937;
            font-weight: 700;
            font-size: 16px;
        }
        .order-code {
            font-size: 24px;
            color: #3b82f6;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: #d1fae5;
            color: #065f46;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }
        .confirmation-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 40px;
        }
        .btn-confirmation {
            padding: 14px 28px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            font-size: 16px;
        }
        .btn-primary-confirm {
            background: #3b82f6;
            color: white;
            border: none;
        }
        .btn-primary-confirm:hover {
            background: #2563eb;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }
        .btn-secondary-confirm {
            background: #f3f4f6;
            color: #1f2937;
            border: 2px solid #e5e7eb;
        }
        .btn-secondary-confirm:hover {
            background: #e5e7eb;
            color: #1f2937;
            transform: translateY(-2px);
        }
        .info-note {
            color: #6b7280;
            font-size: 14px;
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #e5e7eb;
        }
        .info-note i {
            color: #3b82f6;
            margin-right: 8px;
        }
    </style>
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    <main>
        <section class="sec-event confirmation-section">
            <div class="container">
                <div class="confirmation-card wow fadeInUp" data-wow-delay="200ms">
                    <div class="confirmation-icon wow fadeIn" data-wow-delay="300ms">
                        <i class="fas fa-check"></i>
                    </div>
                    
                    <h1 class="confirmation-title wow fadeIn" data-wow-delay="400ms">{{ 'tickets.payment_confirmed'|trans }}</h1>
                    <p class="confirmation-message wow fadeIn" data-wow-delay="500ms">
                        {{ 'tickets.payment_success'|trans }}
                    </p>
                    
                    {% if order_code is defined %}
                    <div class="order-details-box wow fadeInUp" data-wow-delay="600ms">
                        <div class="order-detail-row">
                            <span class="order-detail-label">
                                <i class="fas fa-receipt"></i> {{ 'tickets.order_number'|trans }}
                            </span>
                            <span class="order-detail-value order-code">{{ order_code }}</span>
                        </div>
                        {% if tickets_count is defined %}
                        <div class="order-detail-row">
                            <span class="order-detail-label">
                                <i class="fas fa-ticket-alt"></i> {{ 'tickets.tickets_count_label'|trans }}
                            </span>
                            <span class="order-detail-value">{{ 'tickets.tickets_count_singular'|trans({'count': tickets_count}) }}</span>
                        </div>
                        {% endif %}
                        {% if total_amount is defined %}
                        <div class="order-detail-row">
                            <span class="order-detail-label">
                                <i class="fas fa-money-bill-wave"></i> {{ 'tickets.total_amount'|trans }}
                            </span>
                            <span class="order-detail-value">{{ total_amount|number_format(0, ',', ' ') }} {{ 'profile_financial.currency_mga'|trans }}</span>
                        </div>
                        {% endif %}
                        <div class="order-detail-row">
                            <span class="order-detail-label">
                                <i class="fas fa-info-circle"></i> {{ 'tickets.status'|trans }}
                            </span>
                            <span class="status-badge">
                                <i class="fas fa-check-circle"></i> {{ 'tickets.paid'|trans }}
                            </span>
                        </div>
                    </div>
                    {% endif %}
                    
                    <p class="info-note wow fadeIn" data-wow-delay="700ms">
                        <i class="fas fa-envelope"></i> {{ 'tickets.confirmation_email_sent'|trans }}
                    </p>
                    
                    <div class="confirmation-actions wow fadeInUp" data-wow-delay="800ms">
                        <a href="{{ path('my_tickets') }}" class="btn-confirmation btn-primary-confirm">
                            <i class="fas fa-ticket-alt"></i>
                            {{ 'tickets.view_my_tickets'|trans }}
                        </a>
                        <a href="{{ path('events') }}" class="btn-confirmation btn-secondary-confirm">
                            <i class="fas fa-calendar-alt"></i>
                            {{ 'tickets.discover_other_events'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </section>
        </main>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
    <script>
        // Initialiser WOW.js pour les animations
        if (typeof WOW !== 'undefined') {
            new WOW().init();
        }

        // Après un paiement réussi, vider le panier côté front
        document.addEventListener('DOMContentLoaded', function () {
            try {
                // Vider le panier dans le LocalStorage (front)
                if (typeof CartStorage !== 'undefined' && CartStorage && typeof CartStorage.clear === 'function') {
                    CartStorage.clear();
                }

                // Mettre à jour le badge du panier dans le header
                if (typeof updateCartBadge === 'function') {
                    updateCartBadge(0);
                }
            } catch (e) {
                console.error('Erreur lors du reset du panier après paiement:', e);
            }
        });
    </script>
{% endblock %}
