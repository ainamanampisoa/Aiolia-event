{% extends 'base.html.twig' %}

{% block title %}{{ 'tickets.my_tickets_page_title'|trans }}{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/my-tickets.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
        <main>
            <section class="sec-event all-event">
                <div class="container">
            <div class="page-header wow fadeIn" data-wow-delay="300ms">
                <h2>{{ 'tickets.my_tickets_title'|trans }}</h2>
                <p class="page-subtitle">{{ 'tickets.my_tickets_subtitle'|trans }}</p>
            </div>

            <!-- Filtres et statistiques -->
                    <div class="wow fadeInUp ticket-filters" data-wow-delay="200ms">
                {% set currentFilter = currentFilter|default('upcoming') %}
                {% set counts = statusCounts|default({'upcoming': 0, 'past': 0, 'cancelled': 0}) %}
                
                <div class="filter-group">
                    <a href="{{ path('my_tickets', {filter: 'upcoming' }) }}"
                       class="filter-btn {% if currentFilter == 'upcoming' %}filter-active{% endif %}">
                        <i class="fas fa-calendar-alt"></i>
                        {{ 'tickets.filter_upcoming'|trans }} ({{ counts.upcoming|default(0) }})
                    </a>
                    <a href="{{ path('my_tickets', {filter: 'past' }) }}"
                       class="filter-btn {% if currentFilter == 'past' %}filter-active{% endif %}">
                        <i class="fas fa-history"></i>
                        {{ 'tickets.filter_past'|trans }} ({{ counts.past|default(0) }})
                    </a>
                    <a href="{{ path('my_tickets', {filter: 'cancelled' }) }}"
                       class="filter-btn {% if currentFilter == 'cancelled' %}filter-active{% endif %}">
                        <i class="fas fa-times-circle"></i>
                        {{ 'tickets.filter_cancelled'|trans }} ({{ counts.cancelled|default(0) }})
                    </a>
                </div>

                <div class="ticket-stats">
                    <span class="ticket-badge">
                        <i class="fas fa-ticket-alt"></i>
                        {{ 'tickets.upcoming_count'|trans({'count': counts.upcoming|default(0)}) }}
                    </span>
                </div>
                    </div>

            <!-- État vide -->
                    {% if tickets is defined and tickets|length == 0 %}
                        <div class="wow fadeInUp ticket-empty" data-wow-delay="200ms">
                <div class="empty-icon">
                    <i class="fas fa-ticket-alt"></i>
                        </div>
                <div class="ticket-empty-title">{{ 'tickets.empty_title'|trans }}</div>
                <p class="ticket-empty-desc">
                    {% if currentFilter == 'upcoming' %}
                        {{ 'tickets.empty_upcoming'|trans }}
                    {% elseif currentFilter == 'past' %}
                        {{ 'tickets.empty_past'|trans }}
                    {% else %}
                        {{ 'tickets.empty_cancelled'|trans }}
                    {% endif %}
                </p>
                <a href="{{ path('events') }}" class="btn btn-primary">
                    <i class="fas fa-calendar-plus"></i>
                    {{ 'profile_ticket_chance.discover_events'|trans }}
                </a>
            </div>
            {% else %}
            <!-- Liste des billets -->
            <div class="lst-event tickets-grid">
                {% for ticket in tickets %}
                {% set event = ticket.event %}
                {% set startsAt = event.date %}
                <div class="item ticket-card wow fadeInUp" data-wow-delay="{{ (loop.index * 0.1) + 0.3 }}s">
                        <div class="inner">
                        <!-- Colonne principale -->
                                <div class="blc-col1">
                            <!-- Date, heure et QR code (même style que /events) -->
                                    <div class="col1">
                                        <div class="date">
                                            {% if startsAt %}
                                                <span>{{ startsAt|date('l')|capitalize }}</span>
                                                <strong>{{ startsAt|date('d') }}</strong>
                                                <span class="text-upper">{{ startsAt|date('M Y')|upper }}</span>
                                            {% else %}
                                                <span>{{ 'tickets.filter_upcoming'|trans }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="hour">
                                            {% if startsAt %}
                                                {{ 'tickets.time_prefix'|trans }} {{ startsAt|date('H\\hi') }}
                                            {% else %}
                                                {{ 'tickets.time_to_confirm'|trans }}
                                            {% endif %}
                                        </div>
                                        <div class="code-barre qr-code">
                                            <img
                                                src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data={{ (ticket.qr_code ?? ticket.id)|url_encode }}"
                                                alt="{{ 'tickets.qr_code_alt'|trans }}"
                                            >
                                        </div>
                                    </div>

                            <!-- Détails de l'événement -->
                            <div class="col2">
                                <span class="bandeau {{ event.category|lower|replace({' ': '-'}) }}">{{ event.category }}</span>
                                <h3>{{ event.title }}</h3>
                                
                                <div class="adresse">{{ event.location }}</div>
                                <div class="tarif">
                                    {% if ticket.price is not null %}
                                        {{ ticket.price|number_format(0, ',', ' ') }} {{ 'profile_financial.currency_mga'|trans }}
                                    {% else %}
                                        {{ 'tickets.ticket_free'|trans }}
                                    {% endif %}
                                    · {{ ticket.ticket_type }}
                                </div>

                                <!-- Actions améliorées -->
                                <!-- Actions améliorées -->
                                <!-- Actions améliorées -->
                                <div class="blcBtn ticket-actions">
                                    <a href="{{ path('my_ticket_details', {id: ticket.id}) }}" class="btn btn-primary details">
                                        <i class="fas fa-eye"></i>
                                        <span class="btn-text">{{ 'tickets.details'|trans }}</span>
                                    </a>
                                    <div class="action-group enhanced compact-mobile">
                                        <a href="{{ path('ticket_pdf', {id: ticket.id}) }}"
                                           class="action-btn btn-pdf"
                                           data-tooltip="{{ 'tickets.download_pdf'|trans }}">
                                            <i class="fas fa-file-pdf"></i>
                                            <span class="btn-text">{{ 'tickets.pdf'|trans }}</span>
                                        </a>
                                        
                                        <div class="calendar-dropdown">
                                            <button class="action-btn btn-calendar" 
                                                    data-tooltip="{{ 'tickets.add_to_calendar'|trans }}"
                                                    data-event-title="{{ event.title|e('html_attr') }}"
                                                    data-event-date="{{ startsAt ? startsAt|date('Y-m-d\\TH:i:s') : '' }}"
                                                    data-event-location="{{ event.location|e('html_attr') }}"
                                                    data-event-description="{{ 'tickets.ticket_type_price'|trans({'type': ticket.ticket_type, 'price': ticket.price ? (ticket.price|number_format(0, ',', ' ') ~ ' ' ~ 'profile_financial.currency_mga'|trans) : 'tickets.ticket_free'|trans}) }}"
                                                    data-ticket-id="{{ ticket.id }}">
                                                <i class="fas fa-calendar-plus"></i>
                                                <span class="btn-text">{{ 'tickets.calendar'|trans }}</span>
                                            </button>
                                            <div class="calendar-menu">
                                                <a href="#" class="calendar-option" data-calendar="google">
                                                    <i class="fab fa-google"></i> Google Calendar
                                                </a>
                                                <a href="#" class="calendar-option" data-calendar="ical">
                                                    <i class="fas fa-apple-alt"></i> Apple Calendar
                                                </a>
                                                <a href="#" class="calendar-option" data-calendar="outlook">
                                                    <i class="fab fa-microsoft"></i> Outlook
                                                </a>
                                            </div>
                                        </div>
                                    </div>  
                                </div>

                                <!-- Statut et info commande -->
                                <div class="ticket-meta">
                                    <span class="ticket-status ticket-status-{{ ticket.status_key }}">
                                        <i class="fas fa-circle status-dot"></i>
                                        {{ ticket.status_label }}
                                    </span>
                                    {% if ticket.order_number is defined and ticket.order_number %}
                                    <span class="order-number">
                                        Commande #{{ ticket.order_number }}
                                    </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <!-- Image de l'événement -->
                        <div class="blc-col2">
                            <div class="img event-image">
                                {% set imagePath = event.image starts with 'http' ? event.image : asset(event.image|trim('/')) %}
                                <img src="{{ imagePath }}" alt="{{ event.title }}">

                            </div>  
                        </div>
                    </div>
                </div>
                {% endfor %}
                    </div>
                    {% endif %}
                    
            <!-- Pagination améliorée -->
            {% if tickets|length > 1 %}
            <div class="pagination-wrapper">
                    <div class="pagination">
                    <a href="#" class="page-nav prev">
                        <i class="fas fa-chevron-left"></i>
                        Précédent
                    </a>
                    <div class="page-numbers">
                        {% for page in 1..tickets|length %}
                            <a href="#" class="page-number {{ page == 1 ? 'active' : '' }}">{{ page }}</a>
                        {% endfor %}
                    </div>
                    <a href="#" class="page-nav next">
                        Suivant
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
                <div class="pagination-info">
                    {{ 'tickets.display_count'|trans({'count': tickets|length}) }}
                </div>
            </div>
            {% endif %}
                </div>
            </section>
        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
    
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // ===== CALENDRIER =====
        // Afficher/masquer le menu calendrier
        document.querySelectorAll('.btn-calendar').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const parentDropdown = this.parentElement;
                const wasActive = parentDropdown.classList.contains('active');
                
                // Fermer les autres menus ouverts et reset z-index
                document.querySelectorAll('.calendar-dropdown.active').forEach(dropdown => {
                    dropdown.classList.remove('active');
                    // Reset z-index du parent card
                    const card = dropdown.closest('.ticket-card');
                    if (card) card.style.zIndex = '';
                });
                
                if (!wasActive) {
                    parentDropdown.classList.add('active');
                    // Augmenter z-index pour passer au-dessus des autres cartes
                    const card = parentDropdown.closest('.ticket-card');
                    if (card) card.style.zIndex = '100';
                }
            });
        });

        // Fermer le menu si on clique ailleurs
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.calendar-dropdown')) {
                document.querySelectorAll('.calendar-dropdown.active').forEach(dropdown => {
                    dropdown.classList.remove('active');
                    // Reset z-index
                    const card = dropdown.closest('.ticket-card');
                    if (card) card.style.zIndex = '';
                });
            }
        });

        // Gérer les options du calendrier
        document.querySelectorAll('.calendar-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                
                const dropdown = this.closest('.calendar-dropdown');
                const btn = dropdown.querySelector('.btn-calendar');
                const calendarType = this.getAttribute('data-calendar');
                
                const eventData = {
                    title: btn.getAttribute('data-event-title'),
                    date: btn.getAttribute('data-event-date'),
                    location: btn.getAttribute('data-event-location'),
                    description: btn.getAttribute('data-event-description')
                };

                // Durée par défaut : 2 heures
                const startDate = new Date(eventData.date);
                const endDate = new Date(startDate.getTime() + 2 * 60 * 60 * 1000);

                if (calendarType === 'google') {
                    addToGoogleCalendar(eventData, startDate, endDate);
                } else if (calendarType === 'ical' || calendarType === 'outlook') {
                    downloadICS(eventData, startDate, endDate, calendarType);
                }

                dropdown.classList.remove('active');
            });
        });

        // Ajouter à Google Calendar
        function addToGoogleCalendar(event, startDate, endDate) {
            const formatDate = (date) => date.toISOString().replace(/-|:|\.\d+/g, '').slice(0, 15) + 'Z';
            
            const url = new URL('https://calendar.google.com/calendar/render');
            url.searchParams.set('action', 'TEMPLATE');
            url.searchParams.set('text', event.title);
            url.searchParams.set('dates', formatDate(startDate) + '/' + formatDate(endDate));
            url.searchParams.set('location', event.location);
            url.searchParams.set('details', event.description + '\n\nBillet réservé sur Aiolia Event');
            
            window.open(url.toString(), '_blank');
        }

        // Télécharger fichier ICS (Apple Calendar / Outlook)
        function downloadICS(event, startDate, endDate, type) {
            const formatDate = (date) => date.toISOString().replace(/-|:|\.\d+/g, '').slice(0, 15) + 'Z';
            
            const icsContent = [
                'BEGIN:VCALENDAR',
                'VERSION:2.0',
                'PRODID:-//Aiolia Event//Ticket//FR',
                'CALSCALE:GREGORIAN',
                'METHOD:PUBLISH',
                'BEGIN:VEVENT',
                'DTSTART:' + formatDate(startDate),
                'DTEND:' + formatDate(endDate),
                'SUMMARY:' + event.title,
                'LOCATION:' + event.location,
                'DESCRIPTION:' + event.description.replace(/\n/g, '\\n') + '\\n\\n{{ 'tickets.calendar_description'|trans|replace({'\n': '\\n'}) }}',
                'STATUS:CONFIRMED',
                'BEGIN:VALARM',
                'TRIGGER:-P1D',
                'ACTION:DISPLAY',
                'DESCRIPTION:Rappel : ' + event.title + ' demain !',
                'END:VALARM',
                'BEGIN:VALARM',
                'TRIGGER:-PT2H',
                'ACTION:DISPLAY',
                'DESCRIPTION:Rappel : ' + event.title + ' dans 2 heures !',
                'END:VALARM',
                'END:VEVENT',
                'END:VCALENDAR'
            ].join('\r\n');

            const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = event.title.replace(/[^a-z0-9]/gi, '_') + '.ics';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(link.href);
        }

        // ===== TOOLTIPS RESPONSIVE =====
        function handleTooltips() {
            const isMobile = window.innerWidth <= 480;
            document.querySelectorAll('.action-btn[data-tooltip]').forEach(btn => {
                if (isMobile) {
                    btn.setAttribute('title', btn.getAttribute('data-tooltip'));
                } else {
                    btn.removeAttribute('title');
                }
            });
        }

        handleTooltips();
        window.addEventListener('resize', handleTooltips);
    });
    </script>
{% endblock %}