<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ 'tickets.ticket_details_title'|trans }} - {{ ticket.event.title }}</title>
    <style>
        @page {
            size: A4 landscape;
            margin: 0;
        }
        body {
            font-family: 'Rubik', DejaVu Sans, Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #ffffff;
            color: #1F2D3D;
        }
        
        /* Main Container matching the card look */
        .ticket-container {
            width: 1000px; /* Fixed width for A4 Landscape */
            margin: 0 auto;
            background-color: #EFEFEF;
            border-radius: 8px; /* May not render perfectly in all dompdf versions but worth try */
            border: 1px solid #ddd;
        }

        /* The layout table */
        table.layout {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            height: 334px; /* Fixed height matching original design */
            table-layout: fixed;
        }

        td {
            vertical-align: top;
            padding: 0;
            margin: 0;
        }

        /* LEFT COLUMN: DATE & QR */
        td.col-left {
            width: 220px;
            background-color: #ffffff;
            border-right: 1px dashed #ccc; /* Separator simulation */
            text-align: center;
        }
        
        .left-content {
            padding: 25px 20px;
            position: relative;
            height: 334px;
        }

        /* Decorative bg strip on the right of col-left (inside) */
        .left-bg-decor {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 15px;
            background-image: url('file://{{ public_dir }}/vente-ticket/images/bg1.png');
            background-repeat: repeat-y;
            background-position: center;
        }

        .date-block { margin-bottom: 20px; }
        .day-name { font-size: 16px; color: #666; text-transform: capitalize; margin-bottom: 5px; display: block;}
        .date-number { font-size: 70px; font-weight: bold; color: #C5C1A4; line-height: 1; margin: 10px 0; display: block;}
        .month-year { font-size: 14px; color: #333; text-transform: uppercase; letter-spacing: 1px; display: block;}
        
        .time-block {
            font-size: 18px; font-weight: 600; color: #1F2D3D;
            margin: 15px auto; text-align: center;
            padding: 5px 15px;
            background: #f5f5f5; border-radius: 4px;
            display: inline-block;
        }

        .qr-block {
            margin-top: 20px;
            text-align: center;
        }
        .qr-code-img {
            width: 100px;
            height: 100px;
            padding: 5px;
            background: #fff;
            border: 1px solid #eee;
        }

        /* CENTER COLUMN: DETAILS */
        td.col-center {
            /* Width calculation: 1000 - 220 - 250 = 530px */
            width: 530px; 
            padding: 25px 35px;
            vertical-align: middle; /* Center vertically like flex justify-center */
        }
        
        .category-badge {
            background-color: #C5C1A4; color: white;
            padding: 6px 20px; border-radius: 15px;
            font-size: 12px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;
            display: inline-block; margin-bottom: 15px;
        }
        
        h1.title {
            font-size: 32px; font-weight: bold; margin: 0 0 15px 0;
            color: #1F2D3D; line-height: 1.2;
        }
        
        .location {
            font-size: 16px; color: #666; margin-bottom: 25px;
            padding-left: 25px; position: relative;
        }
        .location:before {
            content: "📍"; position: absolute; left: 0; top: 0;
        }
        
        .price-info {
            font-size: 16px; color: #333; margin-bottom: 10px;
        }
        .price-amount { font-weight: bold; color: #1F2D3D; font-size: 18px; }
        
        .order-info {
            font-size: 14px; color: #666; margin-top: 20px; padding-top: 15px;
            border-top: 1px dashed #ccc;
        }

        /* RIGHT COLUMN: IMAGE */
        td.col-right {
            width: 250px;
            /* background-color: #ccc; removed to show container bg or white */
            vertical-align: middle;
            text-align: center;
            padding: 10px; /* Add some padding so image isn't edge-to-edge if large */
        }
        
        .event-img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
            display: inline-block;
            border-radius: 4px; /* Optional: adds nice touch */
        }
        
        /* Debug fallback */
        .img-fallback {
            width: 250px; height: 334px;
            background: linear-gradient(135deg, #E8E5D3 0%, #C5C1A4 100%);
            text-align: center;
            line-height: 334px;
            color: #666;
        }

    </style>
</head>
<body>
{% set startsAt = ticket.event.date %}

<div class="ticket-container">
    <table class="layout">
        <tr>
            <!-- COL 1 -->
            <td class="col-left">
                <div class="left-content">
                    <div class="left-bg-decor"></div>
                    
                    <div class="date-block">
                        <span class="day-name">
                            {% if startsAt %}{{ startsAt|date('l')|capitalize }}{% else %}Beited{% endif %}
                        </span>
                        <span class="date-number">
                            {% if startsAt %}{{ startsAt|date('d') }}{% else %}--{% endif %}
                        </span>
                        <span class="month-year">
                            {% if startsAt %}{{ startsAt|date('M Y')|upper }}{% else %}A VENIR{% endif %}
                        </span>
                    </div>

                    <div class="time-block">
                        {% if startsAt %}
                            {{ startsAt|date('H') }}H{{ startsAt|date('i') }}
                        {% else %}
                            TBD
                        {% endif %}
                    </div>

                    <div class="qr-block">
                        {% if qrCodeBase64 %}
                            <img src="{{ qrCodeBase64 }}" class="qr-code-img" alt="QR">
                        {% else %}
                            <div style="width:100px; height:100px; background:#eee; margin:0 auto; padding-top:40px; font-size:10px;">NO QR</div>
                        {% endif %}
                    </div>
                </div>
            </td>

            <!-- COL 2 -->
            <td class="col-center">
                <div class="category-badge">
                    {{ ticket.event.category ?? 'ÉVÈNEMENT' }}
                </div>
                
                <h1 class="title">{{ ticket.event.title }}</h1>
                
                <div class="location">
                    {{ ticket.event.location ?? 'Lieu non précisé' }}
                </div>
                
                {% if ticket.price %}
                    <div class="price-info">
                        {{ 'tickets.purchased_price'|trans }} : <br>
                        <span class="price-amount">{{ ticket.price|number_format(0, '.', ' ') }} {{ 'profile_financial.currency_mga'|trans }}</span>
                        · {{ ticket.ticket_type }}
                    </div>
                {% endif %}
                
                {% if ticket.order_number %}
                    <div class="order-info">
                        Commande n° <strong>{{ ticket.order_number }}</strong>
                    </div>
                {% endif %}
            </td>

            <!-- COL 3 -->
            <td class="col-right">
                {% if eventImageBase64 %}
                    <img src="{{ eventImageBase64 }}" class="event-img" alt="Event">
                {% else %}
                    <div class="img-fallback">No Image</div>
                {% endif %}
            </td>
        </tr>
    </table>
</div>

</body>
</html>