<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Billet - {{ ticket.event.title }}</title>
    <style>
        @page {
            size: A4 landscape;
            margin: 0;
        }

        body {
            font-family: 'Rubik', DejaVu Sans, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #EFEFEF; /* même fond que les cartes */
        }

        .sec-event {
            max-width: 1200px;
            margin: 40px auto;
        }

        .lst-event .item {
            background-color: #EFEFEF; /* var(--beige) */
            padding: 35px;
            margin-bottom: 0;
            page-break-inside: avoid;
        }

        .lst-event .item .inner {
            display: flex;
        }

        .lst-event .item .blc-col1 {
            display: flex;
            width: 695px;
            height: 334px;
            position: relative;
        }

        .lst-event .item .blc-col1 .col1 {
            text-align: center;
            width: 188px;
            padding-top: 64px;
            padding-bottom: 35px;
            position: relative;
            background-color: #ffffff; /* var(--white) */
            margin-left: 15px;
        }

        /* on enlève les petits fonds décoratifs pour le PDF */
        .lst-event .item .blc-col1 .col1:before,
        .lst-event .item .blc-col1 .col2:before,
        .lst-event .item .blc-col1 .col2:after {
            content: "";
            display: none;
        }

        .lst-event .item .blc-col1 .date span {
            display: block;
        }

        .lst-event .item .blc-col1 .date span.text-upper {
            text-transform: uppercase;
            line-height: normal;
        }

        .lst-event .item .blc-col1 .date strong {
            font-size: 67px;
            line-height: 75px;
            font-weight: bold;
            color: #C5C1A4; /* var(--green) */
        }

        .lst-event .item .blc-col1 .date {
            margin-top: -12px;
        }

        .lst-event .item .blc-col1 .hour {
            font-size: 20px;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 31px;
            margin-top: 0;
            line-height: normal;
        }

        .code-barre.qr-code {
            margin-top: -18px;
            margin-bottom: 31px;
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            max-width: 72px;
        }

        .code-barre.qr-code img {
            display: block;
            max-width: 72px;
            height: auto;
        }

        .lst-event .item .blc-col1 .col2 {
            padding: 27px 36px;
            position: relative;
            background-color: #ffffff; /* var(--white) */
            margin-right: 15px;
            margin-left: 19px;
            width: calc(100% - 34px);
        }

        .lst-event .item .blc-col1 .col2 .bandeau {
            background-color: #EFE6DD; /* var(--beige2) */
            padding: 1px 30px;
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 20px;
            display: inline-block;
        }

        .lst-event .item .blc-col1 .col2 h3 {
            font-size: 28px;
            margin-bottom: 22px;
            margin-top: 0;
        }

        .lst-event .item .blc-col1 .col2 .adresse {
            padding-left: 40px;
            position: relative;
            margin-bottom: 11px;
        }

        .lst-event .item .blc-col1 .col2 .adresse:before {
            content: "📍";
            position: absolute;
            left: 0;
            top: 3px;
            font-size: 20px;
        }

        .lst-event .item .blc-col1 .col2 .tarif {
            padding-left: 40px;
            position: relative;
            margin-bottom: 27px;
        }

        .lst-event .item .blc-col1 .col2 .tarif:before {
            content: "💰";
            position: absolute;
            left: 0;
            top: 8px;
            font-size: 19px;
        }

        .lst-event .item .inner .blc-col2 {
            padding-left: 15px;
        }

        .lst-event .item .inner .blc-col2 .img {
            width: 235px;
            height: 334px;
            display: block;
        }

        .lst-event .item .inner .blc-col2 .img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
</head>
<body>
{% set startsAt = ticket.event.date %}
<div class="sec-event">
    <div class="lst-event">
        <div class="item">
            <div class="inner">
                <div class="blc-col1">
                    <div class="col1">
                        <div class="date">
                            {% if startsAt %}
                                <span>{{ startsAt|date('l')|capitalize }}</span>
                                <strong>{{ startsAt|date('d') }}</strong>
                                <span class="text-upper">{{ startsAt|date('M Y')|upper }}</span>
                            {% else %}
                                <span>À venir</span>
                            {% endif %}
                        </div>
                        <div class="hour">
                            {% if startsAt %}
                                À {{ startsAt|date('H') }}H{{ startsAt|date('i') }}
                            {% else %}
                                Heure à confirmer
                            {% endif %}
                        </div>
                        <div class="code-barre qr-code">
                            <img
                                src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data={{ (ticket.qr_code ?? ticket.id)|url_encode }}"
                                alt="QR Code du billet"
                            >
                        </div>
                    </div>
                    <div class="col2">
                        <span class="bandeau">
                            {{ ticket.event.category ?? 'Évènement' }}
                        </span>
                        <h3>{{ ticket.event.title }}</h3>
                        <div class="adresse">
                            {{ ticket.event.location ?? '' }}
                        </div>
                        {% if ticket.price %}
                            <div class="tarif">
                                <strong>Tarif acheté :</strong>
                                {{ ticket.price|number_format(0, '.', ' ') }} MGA · {{ ticket.ticket_type }}
                            </div>
                        {% endif %}
                        {% if ticket.order_number %}
                            <div class="tarif">
                                Commande {{ ticket.order_number }}
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="blc-col2">
                    <div class="img">
                        {% set imagePath = ticket.event.image starts with 'http' ? ticket.event.image : asset(ticket.event.image|trim('/')) %}
                        <img src="{{ imagePath }}" alt="{{ ticket.event.title }}">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>