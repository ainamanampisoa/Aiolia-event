{% extends 'base.html.twig' %}

{% block title %}{{ 'profile_stats.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-stats.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    <main class="profile-stats-wrapper">
        <div class="container">
            <header class="stats-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>{{ 'profile_stats.header_title'|trans }}</h1>
                    <p>{{ 'profile_stats.header_desc'|trans }}</p>
                </div>
                <div class="stats-actions">
                    <div class="period-filter">
                        <button class="btn-outline period-btn {{ currentPeriod == 'all' ? 'active' : '' }}" data-period="all">
                            <i class="fas fa-calendar-alt"></i> Toutes périodes
                        </button>
                        <button class="btn-outline period-btn {{ currentPeriod == '30' ? 'active' : '' }}" data-period="30">
                            <i class="fas fa-calendar-day"></i> 30 jours
                        </button>
                        <button class="btn-outline period-btn {{ currentPeriod == '90' ? 'active' : '' }}" data-period="90">
                            <i class="fas fa-calendar-week"></i> 90 jours
                        </button>
                        <button class="btn-outline period-btn {{ currentPeriod == '365' ? 'active' : '' }}" data-period="365">
                            <i class="fas fa-calendar"></i> 1 an
                        </button>
                    </div>
                    <a href="{{ path('profile_stats_export', {'period': currentPeriod}) }}" class="btn-solid">
                        <i class="fas fa-download"></i> {{ 'profile_stats.btn_export'|trans|default('Exporter CSV') }}
                    </a>
                </div>
            </header>

            <section class="stats-cards wow fadeInUp" data-wow-delay="150ms">
                <article class="stat-card">
                    <span class="stat-label">{{ 'profile_stats.card_tickets_label'|trans }}</span>
                    <strong>{{ stats.total_tickets|default(0) }}</strong>
                    <small><i class="fas fa-arrow-up"></i>
                        {% if stats.total_tickets > 0 %}
                            {{ 'profile_stats.card_tickets_suffix_increase'|trans }}
                        {% else %}
                            {{ 'profile_stats.card_tickets_suffix_none'|trans }}
                        {% endif %}
                    </small>
                </article>
                <article class="stat-card">
                    <span class="stat-label">{{ 'profile_stats.card_spent_label'|trans }}</span>
                    <strong>{{ stats.total_spent|default('0 MGA') }}</strong>
                    <small><i class="fas fa-wallet"></i> {{ 'profile_stats.card_spent_avg_prefix'|trans }} {{ stats.avg_cart|default('0 MGA') }}</small>
                </article>
                <article class="stat-card">
                    <span class="stat-label">{{ 'profile_stats.card_events_label'|trans }}</span>
                    <strong>{{ stats.unique_events|default(0) }}</strong>
                    <small><i class="fas fa-calendar-check"></i>
                        {% if stats.unique_events > 0 %}
                            {{ 'profile_stats.card_events_suffix'|trans({'{count}': (stats.unique_events / 6)|round})|raw }}
                        {% else %}
                            {{ 'profile_stats.card_events_none'|trans }}
                        {% endif %}
                    </small>
                </article>
                <article class="stat-card">
                    <span class="stat-label">{{ 'profile_stats.card_orders_label'|trans }}</span>
                    <strong>{{ stats.total_orders|default(0) }}</strong>
                    <small><i class="fas fa-shopping-bag"></i> {{ 'profile_stats.card_orders_suffix'|trans }}</small>
                </article>
            </section>

            <section class="stats-charts">
                {# Graphique 1: Catégories préférées (Donut) #}
                <div class="chart-card wow fadeInUp" data-wow-delay="200ms">
                    <header>
                        <h2>Catégories préférées</h2>
                        <span class="chart-period">Répartition de vos achats</span>
                    </header>
                    <div class="chart-placeholder donut" data-categories='{{ eventTypeDistribution|slice(0, 5)|map(d => {"category": d.category, "percentage": d.percentage})|json_encode|raw }}'>
                        {% if eventTypeDistribution|length > 0 %}
                            <div class="donut-chart">
                                <svg viewBox="0 0 36 36" class="donut-svg" id="donut-chart-svg">
                                    <circle class="donut-hole" cx="18" cy="18" r="9"></circle>
                                </svg>
                                <div class="donut-value" id="donut-value">
                                    {% set distribution = eventTypeDistribution|slice(0, 5) %}
                                    {{ distribution[0].percentage }} %<span>{{ distribution[0].category }}</span>
                                </div>
                            </div>
                            <ul class="chart-legend">
                                {% set colors = ['dot-1', 'dot-2', 'dot-3', 'dot-4', 'dot-5'] %}
                                {% for i, dist in eventTypeDistribution|slice(0, 5) %}
                                    <li>
                                        <span class="dot {{ colors[i % colors|length] }}"></span> 
                                        {{ dist.category }} ({{ dist.percentage }}%)
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <div class="donut-chart">
                                <svg viewBox="0 0 36 36" class="donut-svg">
                                    <circle class="donut-hole" cx="18" cy="18" r="9"></circle>
                                </svg>
                                <div class="donut-value">0 %<span>Aucune donnée</span></div>
                            </div>
                            <ul class="chart-legend">
                                <li><span class="dot dot-1"></span> Aucune catégorie disponible</li>
                            </ul>
                        {% endif %}
                    </div>
                </div>

                {# Graphique 2: Top 5 événements achetés #}
                <div class="chart-card wow fadeInUp" data-wow-delay="240ms">
                    <header>
                        <h2>Top 5 événements achetés</h2>
                        <span class="chart-period">Vos événements favoris par dépense</span>
                    </header>
                    <div class="chart-placeholder top-events">
                        {% if topEvents|length > 0 %}
                            {% set maxSpent = topEvents[0].total_spent_raw %}
                            <div class="top-events-list">
                                {% for event in topEvents %}
                                    {% set percentage = maxSpent > 0 ? ((event.total_spent_raw / maxSpent) * 100)|round : 0 %}
                                    <div class="top-event-item">
                                        <div class="event-header">
                                            <div class="event-rank">#{{ loop.index }}</div>
                                            <div class="event-info">
                                                <h4>
                                                    <a href="{{ path('event_details', {'id': event.id}) }}" class="event-link">
                                                        {{ event.title }}
                                                    </a>
                                                </h4>
                                                <span class="event-category">{{ event.category }}</span>
                                            </div>
                                        </div>
                                        <div class="event-stats">
                                            <div class="event-bar-wrapper">
                                                <div class="event-bar" style="width: {{ percentage }}%; background: linear-gradient(90deg, #4A90E2 0%, #50C878 100%);"></div>
                                            </div>
                                            <div class="event-details">
                                                <span class="event-amount">{{ event.total_spent }}</span>
                                                <span class="event-tickets">{{ event.total_tickets }} billet{{ event.total_tickets > 1 ? 's' : '' }}</span>
                                                <span class="event-purchases">{{ event.purchase_count }} achat{{ event.purchase_count > 1 ? 's' : '' }}</span>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="no-data-message">
                                <i class="fas fa-chart-bar"></i>
                                <p>Aucun événement acheté pour le moment</p>
                                <a href="{{ path('events') }}" class="btn-solid">Découvrir les événements</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </section>

            <section class="stats-insights wow fadeInUp" data-wow-delay="260ms">
                <div class="insight-card">
                    <h3>Moments mémorables</h3>
                    <p>Découvrez vos moments forts et vos réalisations</p>
                    <ul>
                        {% if insights.moments|length > 0 %}
                            {% for moment in insights.moments %}
                                <li><i class="{{ moment.icon }}"></i> {{ moment.text|raw }}</li>
                            {% endfor %}
                        {% else %}
                            <li><i class="fas fa-info-circle"></i> Continuez vos achats pour voir vos moments mémorables</li>
                        {% endif %}
                    </ul>
                </div>
                <div class="insight-card">
                    <h3>Suggestions personnalisées</h3>
                    <p>Basées sur vos préférences d'achat</p>
                    {% if insights.suggestions|length > 0 or insights.recommended_categories|length > 0 %}
                        <div class="insight-tags">
                            {% if insights.suggestions|length > 0 %}
                                {% for suggestion in insights.suggestions %}
                                    <span>{{ suggestion.category }}</span>
                                {% endfor %}
                            {% endif %}
                            {% for category in insights.recommended_categories|slice(0, 3) %}
                                <span>{{ category.category }}</span>
                            {% endfor %}
                        </div>
                        <a href="{{ path('events') }}" class="btn-solid">Découvrir les événements</a>
                    {% else %}
                        <p style="color: rgba(17, 34, 68, 0.6); margin: 16px 0;">Explorez nos événements pour recevoir des suggestions personnalisées</p>
                        <a href="{{ path('events') }}" class="btn-solid">Découvrir les événements</a>
                    {% endif %}
                </div>
            </section>
            
            {# Graphique des dépenses mensuelles (optionnel) #}
            {% if monthlyExpenses|length > 0 %}
            <section class="stats-charts" style="margin-top: 32px;">
                <div class="chart-card wow fadeInUp" data-wow-delay="280ms" style="grid-column: 1 / -1;">
                    <header>
                        <h2>Évolution des dépenses</h2>
                        <span class="chart-period">Derniers 6 mois</span>
                    </header>
                    <div class="chart-placeholder">
                        <div class="bars">
                            {% set maxValue = maxExpense %}
                            {% for expense in monthlyExpenses|reverse %}
                                {% set height = maxValue > 0 ? ((expense.total_raw / maxValue) * 100 + 40)|round : 40 %}
                                <span style="height: {{ height }}px" title="{{ expense.month }}: {{ expense.total }}"></span>
                            {% endfor %}
                        </div>
                        <div class="chart-legend">
                            <span><i></i> Dépenses mensuelles (MGA)</span>
                        </div>
                    </div>
                </div>
            </section>
            {% endif %}
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Générer le graphique donut
            const donutContainer = document.querySelector('.chart-placeholder.donut[data-categories]');
            if (donutContainer) {
                try {
                    const categoriesData = JSON.parse(donutContainer.getAttribute('data-categories'));
                    const svg = document.getElementById('donut-chart-svg');
                    const donutValue = document.getElementById('donut-value');
                    
                    if (svg && categoriesData && categoriesData.length > 0) {
                        const colors = ['#4A90E2', '#50C878', '#FF6B6B', '#FFA500', '#9B59B6', '#1ABC9C'];
                        const circumference = 2 * Math.PI * 16; // r = 16
                        const radius = 16;
                        const centerX = 18;
                        const centerY = 18;
                        
                        let currentOffset = 0;
                        
                        // Insérer les segments avant le cercle central
                        const hole = svg.querySelector('.donut-hole');
                        
                        categoriesData.forEach((item, index) => {
                            const percentage = parseFloat(item.percentage) || 0;
                            const arcLength = (percentage / 100) * circumference;
                            const color = colors[index % colors.length];
                            
                            const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                            circle.setAttribute('class', 'donut-segment');
                            circle.setAttribute('cx', centerX);
                            circle.setAttribute('cy', centerY);
                            circle.setAttribute('r', radius);
                            circle.setAttribute('fill', 'transparent');
                            circle.setAttribute('stroke', color);
                            circle.setAttribute('stroke-width', '3');
                            circle.setAttribute('stroke-dasharray', `${arcLength} ${circumference}`);
                            circle.setAttribute('stroke-dashoffset', `-${currentOffset}`);
                            circle.setAttribute('transform', 'rotate(-90 18 18)');
                            circle.setAttribute('data-percentage', percentage);
                            circle.setAttribute('data-category', item.category);
                            
                            svg.insertBefore(circle, hole);
                            currentOffset += arcLength;
                            
                            // Ajouter l'événement hover
                            circle.addEventListener('mouseenter', function() {
                                if (donutValue) {
                                    donutValue.innerHTML = `${percentage}%<span>${item.category}</span>`;
                                }
                            });
                        });
                        
                        // Réinitialiser au survol de la zone
                        donutContainer.addEventListener('mouseleave', function() {
                            if (donutValue && categoriesData.length > 0) {
                                donutValue.innerHTML = `${categoriesData[0].percentage}%<span>${categoriesData[0].category}</span>`;
                            }
                        });
                    }
                } catch (e) {
                    console.error('Erreur lors de la génération du graphique donut:', e);
                }
            }
            
            // Initialiser WOW.js
            if (typeof WOW !== 'undefined') {
                new WOW().init();
            }
            
            // Gestion des filtres de période
            document.querySelectorAll('.period-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const period = this.getAttribute('data-period');
                    const url = new URL(window.location.href);
                    url.searchParams.set('period', period);
                    window.location.href = url.toString();
                });
            });
        });
    </script>
{% endblock %}
