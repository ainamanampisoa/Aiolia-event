{% extends 'base.html.twig' %}

{% block title %}{{ 'profile_stats.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-stats.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    <main class="profile-stats-wrapper">
        <div class="container">
            <header class="stats-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>{{ 'profile_stats.header_title'|trans }}</h1>
                    <p>{{ 'profile_stats.header_desc'|trans }}</p>
                </div>
                <div class="stats-actions">
                    <button class="btn-outline"><i class="fas fa-calendar-alt"></i> {{ 'profile_stats.btn_last_90_days'|trans }}</button>
                    <button class="btn-solid"><i class="fas fa-download"></i> {{ 'profile_stats.btn_export'|trans }}</button>
                </div>
            </header>

            <section class="stats-cards wow fadeInUp" data-wow-delay="150ms">
                <article class="stat-card">
                    <span class="stat-label">{{ 'profile_stats.card_tickets_label'|trans }}</span>
                    <strong>{{ stats.total_tickets|default(0) }}</strong>
                    <small><i class="fas fa-arrow-up"></i>
                        {% if stats.total_tickets > 0 %}
                            {{ 'profile_stats.card_tickets_suffix_increase'|trans }}
                        {% else %}
                            {{ 'profile_stats.card_tickets_suffix_none'|trans }}
                        {% endif %}
                    </small>
                </article>
                <article class="stat-card">
                    <span class="stat-label">{{ 'profile_stats.card_spent_label'|trans }}</span>
                    <strong>{{ stats.total_spent|default('0 MGA') }}</strong>
                    <small><i class="fas fa-wallet"></i> {{ 'profile_stats.card_spent_avg_prefix'|trans }} {{ stats.avg_cart|default('0 MGA') }}</small>
                </article>
                <article class="stat-card">
                    <span class="stat-label">{{ 'profile_stats.card_events_label'|trans }}</span>
                    <strong>{{ stats.unique_events|default(0) }}</strong>
                    <small><i class="fas fa-calendar-check"></i>
                        {% if stats.unique_events > 0 %}
                            {{ 'profile_stats.card_events_suffix'|trans({'{count}': (stats.unique_events / 6)|round})|raw }}
                        {% else %}
                            {{ 'profile_stats.card_events_none'|trans }}
                        {% endif %}
                    </small>
                </article>
                <article class="stat-card">
                    <span class="stat-label">{{ 'profile_stats.card_orders_label'|trans }}</span>
                    <strong>{{ stats.total_orders|default(0) }}</strong>
                    <small><i class="fas fa-shopping-bag"></i> {{ 'profile_stats.card_orders_suffix'|trans }}</small>
                </article>
            </section>

            <section class="stats-charts">
                <div class="chart-card wow fadeInUp" data-wow-delay="200ms">
                    <header>
                        <h2>{{ 'profile_stats.chart_expenses_title'|trans }}</h2>
                        <span class="chart-period">{{ 'profile_stats.chart_expenses_period'|trans }}</span>
                    </header>
                    <div class="chart-placeholder">
                        <div class="bars">
                            {% if monthlyExpenses|length > 0 %}
                                {% set maxValue = maxExpense %}
                                {% for expense in monthlyExpenses|reverse %}
                                    {% set height = maxValue > 0 ? ((expense.total_raw / maxValue) * 100 + 40)|round : 40 %}
                                    <span style="height: {{ height }}px" title="{{ expense.month }}: {{ expense.total }}"></span>
                                {% endfor %}
                            {% else %}
                                {% for i in 1..6 %}
                                    <span style="height: 40px"></span>
                                {% endfor %}
                            {% endif %}
                        </div>
                        <div class="chart-legend">
                            <span><i></i> {{ 'profile_stats.chart_expenses_legend'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="chart-card wow fadeInUp" data-wow-delay="240ms">
                    <header>
                        <h2>{{ 'profile_stats.chart_types_title'|trans }}</h2>
                        <span class="chart-period">{{ 'profile_stats.chart_types_period'|trans }}</span>
                    </header>
                    <div class="chart-placeholder donut">
                        <div class="donut-chart">
                            <svg viewBox="0 0 36 36">
                                <path class="slice slice-1" d="M18 2a16 16 0 0 1 11.314 27.314L18 18Z" />
                                <path class="slice slice-2" d="M29.314 29.314A16 16 0 1 1 18 2l0 16Z" />
                                <circle class="donut-hole" cx="18" cy="18" r="9"></circle>
                            </svg>
                            <div class="donut-value">35 %<span>Live Music</span></div>
                        </div>
                        <ul class="chart-legend">
                            {% if eventTypeDistribution|length > 0 %}
                                {% set colors = ['dot-1', 'dot-2', 'dot-3', 'dot-4', 'dot-5'] %}
                                {% for i, dist in eventTypeDistribution|slice(0, 5) %}
                                    <li><span class="dot {{ colors[i % colors|length] }}"></span> {{ dist.category }} ({{ dist.percentage }} %)</li>
                                {% endfor %}
                            {% else %}
                                <li><span class="dot dot-1"></span> {{ 'profile_stats.chart_types_no_data'|trans }}</li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </section>

            <section class="stats-insights wow fadeInUp" data-wow-delay="260ms">
                <div class="insight-card">
                    <h3>{{ 'profile_stats.insights_moments_title'|trans }}</h3>
                    <p>{{ 'profile_stats.insights_moments_text'|trans }}</p>
                    <ul>
                        <li><i class="fas fa-check"></i> {{ 'profile_stats.insights_moments_li1'|trans }}</li>
                        <li><i class="fas fa-check"></i> {{ 'profile_stats.insights_moments_li2'|trans }}</li>
                    </ul>
                </div>
                <div class="insight-card">
                    <h3>{{ 'profile_stats.insights_suggestions_title'|trans }}</h3>
                    <p>{{ 'profile_stats.insights_suggestions_text'|trans }}</p>
                    <div class="insight-tags">
                        {% for tag in 'profile_stats.insights_suggestions_tags'|trans|split(',') %}
                            <span>{{ tag }}</span>
                        {% endfor %}
                    </div>
                    <a href="{{ path('events') }}" class="btn-solid">{{ 'profile_stats.insights_suggestions_cta'|trans }}</a>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
