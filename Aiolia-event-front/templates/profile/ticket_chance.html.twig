{% extends 'base.html.twig' %}

{% block title %}Ticket Chance - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-ticket-chance.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set eligibility = eligibility|default({
        can_play: false,
        total_spent: 0,
        threshold: 100000,
        remaining: 100000,
        progress: 0
    }) %}
    {% set recentWins = recentWins|default([]) %}
    
    <main class="ticket-chance-wrapper">
        <div class="container">
            <header class="ticket-chance-header wow fadeIn" data-wow-delay="100ms">
                <div class="header-content">
                    <h1>Ticket Chance</h1>
                    <p>Tentez votre chance et gagnez des réductions ou des billets offerts pour vos prochains évènements.</p>
                </div>
            </header>

            {# Barre de progression pour atteindre le seuil #}
            {% if not eligibility.is_unlocked %}
            <section class="eligibility-progress wow fadeIn" data-wow-delay="120ms">
                <div class="glass-card progress-card">
                    <div class="progress-header">
                        <div class="icon-box warning">
                            <i class="fas fa-lock"></i>
                        </div>
                        <div class="text-content">
                            <h3>Débloquez le Ticket Chance</h3>
                            <p>Atteignez <strong>{{ eligibility.threshold|number_format(0, ',', ' ') }} MGA</strong> d'achat pour pouvoir jouer</p>
                        </div>
                    </div>
                    <div class="progress-bar-wrapper">
                        <div class="progress-info">
                            <span class="progress-label">Progression</span>
                            <span class="progress-percentage">{{ eligibility.progress|round }}%</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: {{ eligibility.progress }}%;"></div>
                        </div>
                        <div class="progress-stats">
                            <span class="stat-current">{{ eligibility.total_spent|number_format(0, ',', ' ') }} MGA <small>dépensés</small></span>
                            <span class="stat-remaining">{{ eligibility.remaining|number_format(0, ',', ' ') }} MGA <small>restants</small></span>
                        </div>
                    </div>
                </div>
            </section>
            {% endif %}

            <div class="main-grid">
                <!-- Left Column: Wheel & Action -->
                <section class="game-section wow fadeInUp" data-wow-delay="150ms">
                    <div class="glass-card game-card">
                        <div class="wheel-header">
                            <h2>Roulette des récompenses</h2>
                            {% if eligibility.can_play %}
                                <span class="status-badge active"><i class="fas fa-check-circle"></i> Disponible</span>
                            {% elseif eligibility.is_unlocked %}
                                <span class="status-badge" style="background: #fab1a0; color: #d63031;"><i class="fas fa-clock"></i> 0 Ticket</span>
                            {% else %}
                                <span class="status-badge locked"><i class="fas fa-lock"></i> Verrouillé</span>
                            {% endif %}
                        </div>

                        <div class="prize-wheel-container">
                            <div class="prize-wheel {% if not eligibility.can_play %}disabled{% endif %}" id="prizeWheel">
                                {% set prizeCount = availablePrizes|length %}
                                {% set anglePerPrize = 360 / prizeCount %}
                                {% set conicGradient = [] %}
                                {% for prize in availablePrizes %}
                                    {% set startAngle = loop.index0 * anglePerPrize %}
                                    {% set endAngle = loop.index * anglePerPrize %}
                                    {% set color = prize.color %}
                                    {# Alternating colors if not defined #}
                                    {% if not color %}
                                        {% set color = loop.index0 is even ? '#4A90E2' : '#50E3C2' %}
                                    {% endif %}
                                    {% set conicGradient = conicGradient|merge([color ~ ' ' ~ startAngle ~ 'deg ' ~ endAngle ~ 'deg']) %}
                                {% endfor %}
                                
                                <div class="wheel-outer-ring"></div>
                                <div class="wheel" id="wheel" style="background: conic-gradient({{ conicGradient|join(', ') }});">
                                    {% for prize in availablePrizes %}
                                        {% set startAngle = loop.index0 * anglePerPrize %}
                                        {% set rotation = startAngle + (anglePerPrize / 2) %}
                                        <div class="wheel-segment" 
                                             data-prize-id="{{ prize.id }}"
                                             style="--rotation: {{ rotation }}deg;">
                                            <div class="segment-content">
                                                <i class="fas {{ prize.icon }}"></i>
                                                <span class="segment-label">{{ prize.label }}</span>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                
                                <div class="wheel-center">
                                    <div class="center-inner">
                                        <i class="fas fa-gift"></i>
                                    </div>
                                </div>

                                <div class="wheel-pointer"></div>
                            </div>
                        </div>

                        <div class="game-controls">
                            {% if eligibility.can_play %}
                                <button class="btn-play-large pulse-animation" id="spinBtn">
                                    <span class="btn-content">
                                        <i class="fas fa-play"></i> Lancer la roue
                                    </span>
                                    <span class="btn-shine"></span>
                                </button>
                                <p class="game-hint">Bonne chance ! 🍀</p>
                            {% elseif eligibility.is_unlocked %}
                                <button class="btn-play-large disabled" disabled style="opacity: 0.7; filter: grayscale(1);">
                                    <i class="fas fa-hourglass-half"></i> Plus de tickets
                                </button>
                                <div class="game-hint-box" style="margin-top: 15px; font-size: 0.9em; color: #636e72;">
                                    <p style="margin-bottom: 5px;">Vous avez utilisé vos tickets disponibles.</p>
                                    <small><i class="fas fa-info-circle"></i> Prochain ticket gratuit : {{ eligibility.next_free_play|date('d/m/Y') }}</small>
                                </div>
                            {% else %}
                                <button class="btn-play-large disabled" disabled>
                                    <i class="fas fa-lock"></i> Verrouillé
                                </button>
                                <p class="game-hint">Continuez vos achats pour débloquer</p>
                            {% endif %}
                        </div>
                    </div>
                </section>

                <!-- Right Column: Info, Rules, History -->
                <aside class="sidebar-section wow fadeInUp" data-wow-delay="180ms">
                    
                    <!-- Prizes List (Mini) -->
                    <div class="glass-card prizes-card mb-4">
                        <h3><i class="fas fa-trophy"></i> Récompenses possibles</h3>
                        <div class="prizes-grid">
                            {% for prize in availablePrizes %}
                                <div class="mini-prize-item" style="--prize-color: {{ prize.color|default('#4A90E2') }}">
                                    <div class="prize-icon">
                                        <i class="fas {{ prize.icon }}"></i>
                                    </div>
                                    <span class="prize-name">{{ prize.label }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Rules -->
                    <div class="glass-card rules-card mb-4">
                        <h3><i class="fas fa-info-circle"></i> Comment ça marche ?</h3>
                        <ul class="clean-list">
                            <li>
                                <span class="step-number">1</span>
                                <div class="step-content">
                                    <strong>Achetez des billets</strong>
                                    <p>Cumulez {{ eligibility.threshold|number_format(0, ',', ' ') }} MGA d'achats.</p>
                                </div>
                            </li>
                            <li>
                                <span class="step-number">2</span>
                                <div class="step-content">
                                    <strong>Tournez la roue</strong>
                                    <p>Utilisez votre ticket chance pour gagner.</p>
                                </div>
                            </li>
                            <li>
                                <span class="step-number">3</span>
                                <div class="step-content">
                                    <strong>Profitez !</strong>
                                    <p>Utilisez vos réductions sur vos prochains achats.</p>
                                </div>
                            </li>
                        </ul>
                        <div class="rules-footer">
                            <small><i class="fas fa-exclamation-triangle"></i> Les gains sont valables pour une durée limitée.</small>
                        </div>
                    </div>

                    <!-- History -->
                    <div class="glass-card history-card">
                        <h3><i class="fas fa-history"></i> Vos derniers gains</h3>
                        {% if recentWins|length > 0 %}
                            <div class="history-list">
                                {% for win in recentWins %}
                                    <div class="history-item" style="border-left: 3px solid {{ win.color|default('#4A90E2') }}">
                                        <div class="history-icon" style="background: {{ win.color|default('#4A90E2') }}">
                                            <i class="fas {{ win.icon|default('fa-gift') }}"></i>
                                        </div>
                                        <div class="history-details">
                                            <span class="history-prize">{{ win.prize }}</span>
                                            <span class="history-date">{{ win.date|date('d/m/Y') }}</span>
                                            {% if win.promo_code %}
                                                <span class="history-code">Code: {{ win.promo_code }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="history-status">
                                            {% if win.status == 'claimed' %}
                                                <span class="badge badge-used">Utilisé</span>
                                            {% else %}
                                                <span class="badge badge-available">Disponible</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="empty-state">
                                <i class="fas fa-ghost"></i>
                                <p>Aucun gain pour le moment</p>
                                <small>Tournez la roue pour gagner des récompenses !</small>
                            </div>
                        {% endif %}
                    </div>

                </aside>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const spinBtn = document.getElementById('spinBtn');
            const wheel = document.getElementById('wheel');
            
            // Prix disponibles depuis le backend
            const availablePrizes = {{ availablePrizes|json_encode|raw }};
            const prizeCount = availablePrizes.length;
            const anglePerPrize = 360 / prizeCount;
            
            {% if eligibility.can_play %}
            // Animation de la roue
            if (spinBtn && wheel) {
                let isSpinning = false;
                let currentRotation = 0;
                
                spinBtn.addEventListener('click', async function() {
                    if (isSpinning) return;
                    
                    isSpinning = true;
                    spinBtn.disabled = true;
                    
                    const btnContent = spinBtn.querySelector('.btn-content');
                    if (btnContent) {
                        btnContent.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Tirage en cours...';
                    }
                    
                    try {
                        // Appeler l'API pour effectuer le tirage
                        const response = await fetch('{{ path("api_ticket_chance_play") }}', {
                            method: 'POST',
                            credentials: 'include',
                            headers: {
                                'Accept': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });
                        
                        const data = await response.json();
                        
                        if (!data.success) {
                            throw new Error(data.error || 'Erreur lors du tirage');
                        }
                        
                        // Trouver l'index du prix gagné
                        const wonPrize = data.prize;
                        const prizeIndex = availablePrizes.findIndex(p => p.id === wonPrize.id);
                        
                        // Calculer l'angle pour pointer vers le prix gagné
                        const targetAngle = prizeIndex * anglePerPrize + (anglePerPrize / 2);
                        const finalAngle = 360 - targetAngle;
                        
                        // Ajouter plusieurs rotations pour l'effet
                        const rotations = 5 + Math.random() * 3;
                        const totalRotation = currentRotation + (rotations * 360) + finalAngle;
                        
                        wheel.style.transition = 'transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99)';
                        wheel.style.transform = `rotate(${totalRotation}deg)`;
                        
                        currentRotation = totalRotation % 360;
                        
                        // Afficher le résultat après l'animation
                        setTimeout(() => {
                            showWinModal(wonPrize, data.play_type);
                        }, 4200);
                        
                    } catch (error) {
                        console.error('Erreur:', error);
                        alert(error.message || 'Une erreur est survenue. Veuillez réessayer.');
                        location.reload();
                    }
                });
            }
            {% endif %}
            
            // Modal de victoire
            function showWinModal(prize, playType) {
                const modal = document.createElement('div');
                modal.className = 'win-modal';
                modal.innerHTML = `
                    <div class="win-modal-content">
                        <div class="win-icon" style="background: ${prize.color}">
                            <i class="fas ${prize.icon}"></i>
                        </div>
                        <h2>🎉 Félicitations !</h2>
                        <p class="win-prize">Vous avez gagné</p>
                        <div class="win-prize-name" style="color: ${prize.color}">${prize.label}</div>
                        ${prize.type === 'extra_play' ? 
                            '<p class="win-info">Vous pouvez rejouer immédiatement !</p>' :
                            '<p class="win-info">Votre gain a été ajouté à votre compte.</p>'
                        }
                        <button class="btn-close-modal" onclick="location.reload()">
                            ${prize.type === 'extra_play' ? 'Rejouer maintenant' : 'Super !'}
                        </button>
                    </div>
                `;
                document.body.appendChild(modal);
                
                // Animation d'entrée
                setTimeout(() => modal.classList.add('show'), 10);
            }
            
            // Animation de la barre de progression
            const progressFill = document.querySelector('.progress-fill');
            if (progressFill) {
                const progress = {{ eligibility.progress }};
                setTimeout(() => {
                    progressFill.style.width = progress + '%';
                }, 300);
            }
        });
    </script>
    
    <style>
        /* Modal de victoire */
        .win-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .win-modal.show {
            opacity: 1;
        }
        
        .win-modal-content {
            background: white;
            border-radius: 24px;
            padding: 40px;
            text-align: center;
            max-width: 400px;
            transform: scale(0.8);
            transition: transform 0.3s ease;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }
        
        .win-modal.show .win-modal-content {
            transform: scale(1);
        }
        
        .win-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 36px;
            color: white;
            animation: bounce 0.6s ease;
        }
        
        @keyframes bounce {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2); }
        }
        
        .win-modal h2 {
            margin: 0 0 10px;
            font-size: 28px;
            color: #2D3436;
        }
        
        .win-prize {
            margin: 0;
            color: #636E72;
            font-size: 16px;
        }
        
        .win-prize-name {
            font-size: 32px;
            font-weight: 800;
            margin: 15px 0;
        }
        
        .win-info {
            color: #636E72;
            font-size: 14px;
            margin-bottom: 25px;
        }
        
        .btn-close-modal {
            background: linear-gradient(135deg, #4A90E2, #50E3C2);
            color: white;
            border: none;
            padding: 14px 40px;
            border-radius: 100px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .btn-close-modal:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(74, 144, 226, 0.4);
        }
    </style>
{% endblock %}
