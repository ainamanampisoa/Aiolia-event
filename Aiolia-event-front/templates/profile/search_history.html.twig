{% extends 'base.html.twig' %}

{% block title %}Historique de recherche - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-search-history.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set searches = searches|default([
        { query: 'Concert jazz Antananarivo', date: '07 nov. 2025 · 14:10', results: 12 },
        { query: 'Festival urbain 2025', date: '05 nov. 2025 · 22:45', results: 8 },
        { query: 'Afterwork networking', date: '02 nov. 2025 · 09:02', results: 5 },
        { query: 'Spectacle enfants décembre', date: '29 oct. 2025 · 19:18', results: 9 }
    ]) %}

    <main class="profile-search-wrapper">
        <div class="container">
            <header class="search-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>Historique de recherche</h1>
                    <p>Retrouvez vos mots-clés récents pour rejouer une recherche ou créer une alerte personnalisée.</p>
                </div>
                <button class="btn-outline"><i class="fas fa-trash"></i> Effacer l'historique</button>
            </header>

            <section class="search-card wow fadeInUp" data-wow-delay="150ms">
                <div class="search-input">
                    <i class="fas fa-search"></i>
                    <input type="search" placeholder="Rechercher dans votre historique">
                    <div class="sort-container">
                        <button class="btn-solid" id="sortByDateBtn"><i class="fas fa-sort"></i> Trier par date</button>
                        <div class="date-picker-dropdown" id="datePickerDropdown">
                            <div class="date-options">
                                <button class="date-option active" data-sort="newest">
                                    <i class="fas fa-arrow-down"></i>
                                    <span>Plus récentes</span>
                                </button>
                                <button class="date-option" data-sort="oldest">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>Plus anciennes</span>
                                </button>
                                <div class="date-separator"></div>
                                <button class="date-option" data-sort="custom">
                                    <i class="fas fa-calendar-alt"></i>
                                    <span>Période personnalisée</span>
                                </button>
                            </div>
                            <div class="custom-date-picker">
                                <div class="date-inputs">
                                    <div class="input-group">
                                        <label>Du</label>
                                        <input type="date" id="startDate">
                                    </div>
                                    <div class="input-group">
                                        <label>Au</label>
                                        <input type="date" id="endDate">
                                    </div>
                                </div>
                                <button class="btn-apply-date">Appliquer</button>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="search-list">
                    {% for item in searches %}
                        <li>
                            <div class="search-query">
                                <i class="fas fa-clock"></i>
                                <div>
                                    <strong>{{ item.query }}</strong>
                                    <span>{{ item.date }}</span>
                                </div>
                            </div>
                            <div class="search-actions">
                                <span class="results">{{ item.results }} résultats</span>
                                <div class="search-buttons">
                                    <a href="{{ path('events') }}" class="btn-outline">Relancer</a>
                                    <button class="btn-link">Créer alerte</button>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sortBtn = document.getElementById('sortByDateBtn');
            const dateDropdown = document.getElementById('datePickerDropdown');
            const dateOptions = document.querySelectorAll('.date-option');
            const applyDateBtn = document.querySelector('.btn-apply-date');
            
            // Toggle dropdown
            sortBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                dateDropdown.classList.toggle('active');
            });
            
            // Gestion des options de tri
            dateOptions.forEach(option => {
                option.addEventListener('click', function() {
                    // Retirer la classe active de toutes les options
                    dateOptions.forEach(opt => opt.classList.remove('active'));
                    // Ajouter la classe active à l'option cliquée
                    this.classList.add('active');
                    
                    const sortType = this.dataset.sort;
                    
                    if (sortType === 'custom') {
                        // Afficher le sélecteur de date personnalisé
                        document.querySelector('.custom-date-picker').style.display = 'block';
                    } else {
                        // Masquer le sélecteur de date personnalisé
                        document.querySelector('.custom-date-picker').style.display = 'none';
                        // Appliquer le tri
                        applySort(sortType);
                        // Fermer le dropdown
                        dateDropdown.classList.remove('active');
                    }
                });
            });
            
            // Appliquer la période personnalisée
            applyDateBtn.addEventListener('click', function() {
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;
                
                if (startDate && endDate) {
                    applySort('custom', { startDate, endDate });
                    dateDropdown.classList.remove('active');
                } else {
                    alert('Veuillez sélectionner une période complète');
                }
            });
            
            // Fermer le dropdown en cliquant ailleurs
            document.addEventListener('click', function() {
                dateDropdown.classList.remove('active');
            });
            
            // Empêcher la fermeture quand on clique dans le dropdown
            dateDropdown.addEventListener('click', function(e) {
                e.stopPropagation();
            });
            
            function applySort(sortType, customDates = null) {
                // Ici vous pouvez implémenter la logique de tri
                console.log('Tri appliqué:', sortType, customDates);
                
                // Mettre à jour le texte du bouton
                let buttonText = 'Trier par date';
                switch(sortType) {
                    case 'newest':
                        buttonText = 'Plus récentes';
                        break;
                    case 'oldest':
                        buttonText = 'Plus anciennes';
                        break;
                    case 'custom':
                        buttonText = 'Période personnalisée';
                        break;
                }
                
                sortBtn.innerHTML = `<i class="fas fa-sort"></i> ${buttonText}`;
                
                // Ajouter une classe pour indiquer qu'un tri est actif
                sortBtn.classList.add('sort-active');
            }
        });
    </script>
{% endblock %}