{% extends 'base.html.twig' %}

{% block title %}{{ 'profile_wallet.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-wallet.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set transactions = transactions|default([
        {
            date: '07 nov. 2025',
            label: 'Afro Jazz Experience',
            type: 'Débit',
            amount: '-320 000 MGA',
            status: 'Confirmée',
            details: 'Paiement par Mobile Money'
        },
        {
            date: '29 oct. 2025',
            label: 'Remboursement Fashion Night',
            type: 'Crédit',
            amount: '+240 000 MGA',
            status: 'Remboursée',
            details: 'Crédité sur Wallet'
        },
        {
            date: '18 oct. 2025',
            label: 'Recharge Wallet',
            type: 'Crédit',
            amount: '+200 000 MGA',
            status: 'Confirmée',
            details: 'Mobile Money'
        },
        {
            date: '02 oct. 2025',
            label: 'Soirée Electro Rooftop',
            type: 'Débit',
            amount: '-160 000 MGA',
            status: 'Annulée',
            details: 'Remboursement prévu'
        }
    ]) %}

    <main class="profile-wallet-wrapper">
        <div class="container">
            <header class="wallet-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>{{ 'profile_wallet.header_title'|trans }}</h1>
                    <p>{{ 'profile_wallet.header_desc'|trans }}</p>
                </div>
                <div class="wallet-actions">
                    <button class="btn-outline"><i class="fas fa-plus"></i> {{ 'profile_wallet.btn_recharge'|trans }}</button>
                    <button class="btn-solid"><i class="fas fa-paper-plane"></i> {{ 'profile_wallet.btn_transfer'|trans }}</button>
                </div>
            </header>

            <section class="wallet-balance wow fadeInUp" data-wow-delay="150ms">
                <div class="balance-card">
                    <div class="balance-header">
                        <span>{{ 'profile_wallet.balance_label'|trans }}</span>
                        <button class="link-btn"><i class="fas fa-history"></i> {{ 'profile_wallet.balance_history'|trans }}</button>
                    </div>
                    <strong>420 000 MGA</strong>
                    <small>{{ 'profile_wallet.balance_last_update'|trans({'{date}': '07 novembre 2025 à 14:32'})|raw }}</small>
                    <div class="balance-progress">
                        <div class="progress-fill" style="width: 65%"></div>
                    </div>
                    <div class="balance-meta">
                        <span>{{ 'profile_wallet.balance_monthly_limit'|trans }} <strong>700 000 MGA</strong></span>
                        <span>{{ 'profile_wallet.balance_loyalty_points'|trans }} <strong>1 250 pts</strong></span>
                    </div>
                </div>
                <div class="balance-card methods">
                    <h2>{{ 'profile_wallet.methods_title'|trans }}</h2>
                    <ul>
                        <li><i class="fas fa-mobile-alt"></i> {{ 'profile_wallet.methods_primary_mobile'|trans }} <button class="link-btn">{{ 'profile_wallet.methods_edit'|trans }}</button></li>
                        <li><i class="fas fa-credit-card"></i> {{ 'profile_wallet.methods_visa_suffix'|trans }} <button class="link-btn">{{ 'profile_wallet.methods_remove'|trans }}</button></li>
                        <li><i class="fas fa-wallet"></i> {{ 'profile_wallet.methods_add_card'|trans }} <button class="btn-outline">{{ 'profile_wallet.methods_add_btn'|trans }}</button></li>
                    </ul>
                </div>
            </section>

            <section class="wallet-transactions wow fadeInUp" data-wow-delay="200ms">
                <header>
                    <h2>{{ 'profile_wallet.movements_title'|trans }}</h2>
                    <div class="wallet-filters">
                        <button class="tag active">{{ 'profile_wallet.movements_tag_all'|trans }}</button>
                        <button class="tag">{{ 'profile_wallet.movements_tag_debits'|trans }}</button>
                        <button class="tag">{{ 'profile_wallet.movements_tag_credits'|trans }}</button>
                    </div>
                </header>
                <div class="transactions-table">
                    <table>
                        <thead>
                            <tr>
                                <th>{{ 'profile_wallet.col_date'|trans }}</th>
                                <th>{{ 'profile_wallet.col_label'|trans }}</th>
                                <th>{{ 'profile_wallet.col_type'|trans }}</th>
                                <th>{{ 'profile_wallet.col_amount'|trans }}</th>
                                <th>{{ 'profile_wallet.col_status'|trans }}</th>
                                <th>{{ 'profile_wallet.col_details'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for transaction in transactions %}
                                <tr class="transaction-row {{ transaction.type|lower }}">
                                    <td>{{ transaction.date }}</td>
                                    <td><strong>{{ transaction.label }}</strong></td>
                                    <td>{{ transaction.type }}</td>
                                    <td>{{ transaction.amount }}</td>
                                    <td><span class="status">{{ transaction.status }}</span></td>
                                    <td>{{ transaction.details }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
