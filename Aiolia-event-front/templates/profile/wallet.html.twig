{% extends 'base.html.twig' %}

{% block title %}Portefeuille - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-wallet.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set transactions = transactions|default([
        {
            date: '07 nov. 2025',
            label: 'Afro Jazz Experience',
            type: 'Débit',
            amount: '-320 000 MGA',
            status: 'Confirmée',
            details: 'Paiement par Mobile Money'
        },
        {
            date: '29 oct. 2025',
            label: 'Remboursement Fashion Night',
            type: 'Crédit',
            amount: '+240 000 MGA',
            status: 'Remboursée',
            details: 'Crédité sur Wallet'
        },
        {
            date: '18 oct. 2025',
            label: 'Recharge Wallet',
            type: 'Crédit',
            amount: '+200 000 MGA',
            status: 'Confirmée',
            details: 'Mobile Money'
        },
        {
            date: '02 oct. 2025',
            label: 'Soirée Electro Rooftop',
            type: 'Débit',
            amount: '-160 000 MGA',
            status: 'Annulée',
            details: 'Remboursement prévu'
        }
    ]) %}

    <main class="profile-wallet-wrapper">
        <div class="container">
            <header class="wallet-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>Mon portefeuille</h1>
                    <p>Consultez votre solde disponible, vos moyens de paiement et vos transactions récentes.</p>
                </div>
                <div class="wallet-actions">
                    <button class="btn-outline"><i class="fas fa-plus"></i> Recharger</button>
                    <button class="btn-solid"><i class="fas fa-paper-plane"></i> Transférer</button>
                </div>
            </header>

            <section class="wallet-balance wow fadeInUp" data-wow-delay="150ms">
                <div class="balance-card">
                    <div class="balance-header">
                        <span>Solde wallet</span>
                        <button class="link-btn"><i class="fas fa-history"></i> Historique complet</button>
                    </div>
                    <strong>420 000 MGA</strong>
                    <small>Dernière mise à jour : 07 novembre 2025 à 14:32</small>
                    <div class="balance-progress">
                        <div class="progress-fill" style="width: 65%"></div>
                    </div>
                    <div class="balance-meta">
                        <span>Limite mensuelle : <strong>700 000 MGA</strong></span>
                        <span>Points fidélité : <strong>1 250 pts</strong></span>
                    </div>
                </div>
                <div class="balance-card methods">
                    <h2>Moyens de paiement</h2>
                    <ul>
                        <li><i class="fas fa-mobile-alt"></i> Mobile Money (primaire) <button class="link-btn">Modifier</button></li>
                        <li><i class="fas fa-credit-card"></i> Visa se terminant par 1123 <button class="link-btn">Retirer</button></li>
                        <li><i class="fas fa-wallet"></i> Ajouter une carte <button class="btn-outline">Ajouter</button></li>
                    </ul>
                </div>
            </section>

            <section class="wallet-transactions wow fadeInUp" data-wow-delay="200ms">
                <header>
                    <h2>Mouvements récents</h2>
                    <div class="wallet-filters">
                        <button class="tag active">Tous</button>
                        <button class="tag">Débits</button>
                        <button class="tag">Crédits</button>
                    </div>
                </header>
                <div class="transactions-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Libellé</th>
                                <th>Type</th>
                                <th>Montant</th>
                                <th>Statut</th>
                                <th>Détails</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for transaction in transactions %}
                                <tr class="transaction-row {{ transaction.type|lower }}">
                                    <td>{{ transaction.date }}</td>
                                    <td><strong>{{ transaction.label }}</strong></td>
                                    <td>{{ transaction.type }}</td>
                                    <td>{{ transaction.amount }}</td>
                                    <td><span class="status">{{ transaction.status }}</span></td>
                                    <td>{{ transaction.details }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
