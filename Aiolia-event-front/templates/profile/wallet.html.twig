{% extends 'base.html.twig' %}

{% block title %}Portefeuille numérique - Aiolia Event{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-wallet.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    <main class="profile-wallet-wrapper">
        <div class="container">
            <header class="wallet-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>Fonctionnalité suspendue</h1>
                    <p>Le portefeuille numérique et les points de fidélité sont temporairement désactivés.</p>
                </div>
            </header>

            <section class="wallet-transactions wow fadeInUp" data-wow-delay="200ms">
                <div class="transactions-table">
                    <div style="text-align: center; padding: 48px; color: #555; border: 1px solid #eee; border-radius: 12px; background: #fafafa;">
                        <i class="fas fa-pause-circle" style="font-size: 48px; margin-bottom: 16px; display: block; opacity: 0.4;"></i>
                        <p style="font-size: 16px;">Nous travaillons sur de nouvelles priorités. Revenez bientôt.</p>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <style>
        /* Aucune personnalisation supplémentaire pour le moment */
    </style>

    <script>
        // Portefeuille désactivé : aucun comportement dynamique
    </script>
{% endblock %}
