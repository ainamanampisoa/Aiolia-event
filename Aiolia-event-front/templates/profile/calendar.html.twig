{% extends 'base.html.twig' %}

{% block title %}{{ 'profile_calendar.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-calendar.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}

    <main class="profile-calendar-wrapper">
        <div class="container">
            <header class="calendar-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>{{ 'profile_calendar.header_title'|trans }}</h1>
                    <p>{{ 'profile_calendar.header_desc'|trans }}</p>
                </div>
            </header>

            <section class="calendar-grid">
                <div class="calendar-month wow fadeInLeft" data-wow-delay="150ms">
                    <div class="calendar-month-header">
                        <button class="nav prev" aria-label="{{ 'profile_calendar.month_prev_aria'|trans }}"><i class="fas fa-chevron-left"></i></button>
                        <div class="month">{{ 'profile_calendar.month_label'|trans }}</div>
                        <button class="nav next" aria-label="{{ 'profile_calendar.month_next_aria'|trans }}"><i class="fas fa-chevron-right"></i></button>
                    </div>
                    <div class="calendar-weekdays">
                        {% set weekdays = 'profile_calendar.weekdays_short'|trans|split(',') %}
                        {% for wd in weekdays %}
                            <span>{{ wd }}</span>
                        {% endfor %}
                    </div>
                    <div class="calendar-days" id="calendar-days">
                        {# Les jours seront générés dynamiquement par JavaScript #}
                    </div>
                </div>

                <div class="calendar-agenda wow fadeInRight" data-wow-delay="180ms">
                    <header>
                        <h2>{{ 'profile_calendar.agenda_title'|trans }}</h2>
                        <div class="agenda-filters">
                            <button class="tag active" data-filter="all">{{ 'profile_calendar.agenda_filter_all'|trans }}</button>
                            <button class="tag" data-filter="upcoming">{{ 'profile_calendar.agenda_filter_upcoming'|trans }}</button>
                            <button class="tag" data-filter="past">{{ 'profile_calendar.agenda_filter_past'|trans }}</button>
                        </div>
                    </header>
                    <div class="agenda-list">
                        {% if events is defined and events|length > 0 %}
                            {% for event in events %}
                                {% if event.starts_at is not null %}
                                    {% set eventDateStr = event.starts_at|date('d F Y') %}
                                    {% set eventTime = event.starts_at|date('H:i') %}
                                    {% set eventDay = event.starts_at|date('d') %}
                                    {% set eventMonth = event.starts_at|date('F Y') %}
                                    {% set catClass = '' %}
                                    {% set catLabel = event.category_label|default('Événement') %}
                                    {% if catLabel|lower matches '/concert|musique|music/' %}{% set catClass = 'category-concert' %}
                                    {% elseif catLabel|lower matches '/sport/' %}{% set catClass = 'category-sport' %}
                                    {% elseif catLabel|lower matches '/théâtre|art|spectacle/' %}{% set catClass = 'category-theater' %}
                                    {% elseif catLabel|lower matches '/conférence|business|salon/' %}{% set catClass = 'category-business' %}
                                    {% elseif catLabel|lower matches '/festival/' %}{% set catClass = 'category-festival' %}
                                    {% endif %}

                                    <article class="agenda-item {{ catClass }}" data-event-date="{{ event.starts_at|date('Y-m-d\\TH:i:sP') }}">
                                        <div class="agenda-date">
                                            <span class="day">{{ eventDay }}</span>
                                            <span class="month">{{ eventMonth }}</span>
                                        </div>
                                        <div class="agenda-content">
                                            <h3><a href="{{ path('event_details', { id: event.id }) }}" style="text-decoration: none; color: inherit;">{{ event.title }}</a></h3>
                                            <div class="agenda-meta">
                                                <span class="cat-badge"><i class="fas fa-tag"></i> {{ catLabel }}</span>
                                                <span><i class="fas fa-clock"></i> {{ eventTime }}</span>
                                                <span><i class="fas fa-map-marker-alt"></i> {{ event.venue_name ?? event.city ?? 'Lieu non spécifié' }}</span>
                                                {% if event.ticket_count|default(0) > 0 %}
                                                    <span><i class="fas fa-ticket-alt"></i> {{ event.ticket_count }} billet{{ event.ticket_count > 1 ? 's' : '' }}</span>
                                                {% endif %}
                                            </div>
                                            <div class="agenda-status">
                                                <span class="status-dot {% if event.order_status == 'paid' %}status-confirmed{% endif %}"></span> {{ event.order_status == 'paid' ? 'Confirmé' : 'En attente' }}
                                            </div>
                                        </div>
                                        <div class="agenda-actions">
                                            <a href="{{ path('event_details', { id: event.id }) }}" class="btn-tickets-improved"><i class="fas fa-ticket-alt"></i> {{ 'profile_calendar.btn_tickets'|trans }}</a>
                                        </div>
                                    </article>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <div class="agenda-item agenda-empty-message">
                                <div class="agenda-content" style="width: 100%; text-align: center; padding: 2rem;">
                                    <h3>Aucun événement à venir</h3>
                                    <p>Vous n'avez pas d'événements à venir pour le moment.</p>
                                    <a href="{{ path('events') }}" class="btn-solid" style="margin-top: 1rem;">Découvrir les événements</a>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </section>
        </div>
    </main>
    
    {# Passer les événements au JavaScript avec formatage des dates #}
    <script>
        window.AIOLIA_USER_EVENTS = [
            {% if events is defined and events|length > 0 %}
                {% for event in events %}
                    {% if event.starts_at is not null %}
                        {
                            id: {{ event.id }},
                            title: {{ event.title|json_encode|raw }},
                            starts_at: {{ event.starts_at|date('Y-m-d\\TH:i:sP')|json_encode|raw }},
                            venue_name: {{ (event.venue_name ?? event.city ?? '')|json_encode|raw }},
                            category_label: {{ (event.category_label ?? 'Événement')|json_encode|raw }},
                            ticket_count: {{ event.ticket_count|default(0) }},
                            order_status: {{ (event.order_status ?? '')|json_encode|raw }}
                        }{% if not loop.last %},{% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %}
        ];
    </script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const events = window.AIOLIA_USER_EVENTS || [];
            const currentDate = new Date();
            let currentMonth = currentDate.getMonth();
            let currentYear = currentDate.getFullYear();
            
            const monthNames = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin',
                'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
            
            // Créer un index des événements par date (YYYY-MM-DD)
            const eventsByDate = {};
            events.forEach(event => {
                if (event.starts_at) {
                    const date = new Date(event.starts_at);
                    if (!isNaN(date.getTime())) {
                        const dateKey = date.getFullYear() + '-' + 
                            String(date.getMonth() + 1).padStart(2, '0') + '-' + 
                            String(date.getDate()).padStart(2, '0');
                        if (!eventsByDate[dateKey]) {
                            eventsByDate[dateKey] = [];
                        }
                        eventsByDate[dateKey].push(event);
                    }
                }
            });
            
            function renderCalendar() {
                const monthElement = document.querySelector('.month');
                const calendarDays = document.getElementById('calendar-days');
                
                if (!monthElement || !calendarDays) return;
                
                // Mettre à jour le label du mois
                monthElement.textContent = monthNames[currentMonth] + ' ' + currentYear;
                
                // Obtenir le premier jour du mois et le nombre de jours
                const firstDay = new Date(currentYear, currentMonth, 1);
                const lastDay = new Date(currentYear, currentMonth + 1, 0);
                const daysInMonth = lastDay.getDate();
                const startingDayOfWeek = firstDay.getDay() === 0 ? 6 : firstDay.getDay() - 1; // Lundi = 0
                
                // Vider le conteneur
                calendarDays.innerHTML = '';
                
                // Ajouter des jours vides au début
                for (let i = 0; i < startingDayOfWeek; i++) {
                    const emptyDay = document.createElement('span');
                    emptyDay.className = 'empty';
                    calendarDays.appendChild(emptyDay);
                }
                
                // Ajouter les jours du mois
                for (let day = 1; day <= daysInMonth; day++) {
                    const dayElement = document.createElement('span');
                    dayElement.className = 'day';
                    
                    const dateKey = currentYear + '-' + 
                        String(currentMonth + 1).padStart(2, '0') + '-' + 
                        String(day).padStart(2, '0');
                    
                    // Vérifier si ce jour a des événements
                    if (eventsByDate[dateKey] && eventsByDate[dateKey].length > 0) {
                        dayElement.classList.add('has-event');
                        
                        // Ajouter une classe de catégorie basée sur le premier événement
                        const firstEvent = eventsByDate[dateKey][0];
                        const catLabel = (firstEvent.category_label || '').toLowerCase();
                        let catClass = '';
                        if (catLabel.match(/concert|musique|music/)) catClass = 'category-concert';
                        else if (catLabel.match(/sport/)) catClass = 'category-sport';
                        else if (catLabel.match(/théâtre|art|spectacle/)) catClass = 'category-theater';
                        else if (catLabel.match(/conférence|business|salon/)) catClass = 'category-business';
                        else if (catLabel.match(/festival/)) catClass = 'category-festival';
                        
                        if (catClass) dayElement.classList.add(catClass);
                        
                        dayElement.title = eventsByDate[dateKey].map(e => e.title).join(', ');
                        
                        // Ajouter une icône
                        const icon = document.createElement('i');
                        icon.className = 'fas fa-calendar-check';
                        dayElement.appendChild(document.createTextNode(String(day).padStart(2, '0')));
                        dayElement.appendChild(icon);
                    } else {
                        dayElement.textContent = String(day).padStart(2, '0');
                    }
                    
                    calendarDays.appendChild(dayElement);
                }
            }
            
            // Gestion des boutons de navigation
            const prevBtn = document.querySelector('.calendar-month-header .nav.prev');
            const nextBtn = document.querySelector('.calendar-month-header .nav.next');
            
            if (prevBtn) {
                prevBtn.addEventListener('click', function() {
                    currentMonth--;
                    if (currentMonth < 0) {
                        currentMonth = 11;
                        currentYear--;
                    }
                    renderCalendar();
                });
            }
            
            if (nextBtn) {
                nextBtn.addEventListener('click', function() {
                    currentMonth++;
                    if (currentMonth > 11) {
                        currentMonth = 0;
                        currentYear++;
                    }
                    renderCalendar();
                });
            }
            
            // Rendre le calendrier initial
            renderCalendar();
            
            // Gestion des filtres
            const filterButtons = document.querySelectorAll('.agenda-filters .tag');
            const agendaList = document.querySelector('.agenda-list');
            const now = new Date();
            now.setHours(0, 0, 0, 0); // Réinitialiser l'heure pour comparer uniquement les dates
            
            function filterEvents(filterType) {
                const agendaItems = document.querySelectorAll('.agenda-item:not(.agenda-empty-message)');
                let visibleCount = 0;
                
                agendaItems.forEach(item => {
                    const eventDateStr = item.getAttribute('data-event-date');
                    if (!eventDateStr) {
                        item.style.display = 'none';
                        return;
                    }
                    
                    const eventDate = new Date(eventDateStr);
                    if (isNaN(eventDate.getTime())) {
                        item.style.display = 'none';
                        return;
                    }
                    
                    // Normaliser la date de l'événement (ignorer l'heure)
                    eventDate.setHours(0, 0, 0, 0);
                    
                    let show = false;
                    
                    switch(filterType) {
                        case 'all':
                            show = true;
                            break;
                        case 'upcoming':
                            // Événements futurs ou aujourd'hui
                            show = eventDate >= now;
                            break;
                        case 'past':
                            // Événements passés (avant aujourd'hui)
                            show = eventDate < now;
                            break;
                    }
                    
                    if (show) {
                        item.style.display = '';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });
                
                // Gérer le message "aucun événement"
                let emptyMessage = agendaList.querySelector('.agenda-empty-message');
                
                if (visibleCount === 0) {
                    // Masquer le message par défaut s'il existe
                    const defaultEmptyMsg = agendaList.querySelector('.agenda-item:not([data-event-date])');
                    if (defaultEmptyMsg) {
                        defaultEmptyMsg.style.display = 'none';
                    }
                    
                    if (!emptyMessage) {
                        emptyMessage = document.createElement('div');
                        emptyMessage.className = 'agenda-item agenda-empty-message';
                        agendaList.appendChild(emptyMessage);
                    }
                    
                    const messages = {
                        'all': { title: 'Aucun événement', desc: 'Vous n\'avez pas d\'événements pour le moment.', showLink: true },
                        'upcoming': { title: 'Aucun événement à venir', desc: 'Vous n\'avez pas d\'événements à venir pour le moment.', showLink: true },
                        'past': { title: 'Aucun événement passé', desc: 'Vous n\'avez pas d\'événements passés.', showLink: false }
                    };
                    
                    const msg = messages[filterType] || messages['all'];
                    emptyMessage.innerHTML = `
                        <div class="agenda-content" style="width: 100%; text-align: center; padding: 2rem;">
                            <h3>${msg.title}</h3>
                            <p>${msg.desc}</p>
                            ${msg.showLink ? '<a href="{{ path("events") }}" class="btn-solid" style="margin-top: 1rem;">Découvrir les événements</a>' : ''}
                        </div>
                    `;
                    emptyMessage.style.display = '';
                } else {
                    // Masquer le message d'absence d'événements
                    if (emptyMessage) {
                        emptyMessage.style.display = 'none';
                    }
                }
            }
            
            // Ajouter les event listeners aux boutons de filtre
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Retirer la classe active de tous les boutons
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    // Ajouter la classe active au bouton cliqué
                    this.classList.add('active');
                    // Filtrer les événements
                    const filterType = this.getAttribute('data-filter');
                    filterEvents(filterType);
                });
            });
            
            // Initialiser avec le filtre "Tous" au chargement
            filterEvents('all');
        });
    </script>
{% endblock %}
