{% extends 'base.html.twig' %}

{% block title %}Historique financier - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-financial.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set monthly = monthly|default([]) %}
    {% set financialData = financialData|default({
        total_spent: '0 MGA',
        total_refunded: '0 MGA',
        refund_count: 0,
        wallet_balance: '0 MGA',
        wallet_points: 0
    }) %}
    {% set paymentMethods = paymentMethods|default([]) %}

    <main class="profile-financial-wrapper">
        <div class="container">
            <header class="financial-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>Historique financier détaillé</h1>
                    <p>Analysez vos dépenses, vos remboursements et vos soldes mois par mois.</p>
                </div>
                <div class="financial-actions">
                    <button class="btn-outline"><i class="fas fa-file-export"></i> Exporter CSV</button>
                    <button class="btn-solid"><i class="fas fa-file-pdf"></i> Rapport PDF</button>
                </div>
            </header>

            <section class="financial-summary wow fadeInUp" data-wow-delay="150ms">
                <div class="financial-card">
                    <span>Total dépenses {{ "now"|date("Y") }}</span>
                    <strong>{{ financialData.total_spent }}</strong>
                    <small><i class="fas fa-arrow-up"></i> {% if financialData.total_spent != '0 MGA' %}+8 % vs année précédente{% else %}Aucune dépense{% endif %}</small>
                </div>
                <div class="financial-card">
                    <span>Remboursements reçus</span>
                    <strong>{{ financialData.total_refunded }}</strong>
                    <small><i class="fas fa-undo"></i> {{ financialData.refund_count }} évènement(s)</small>
                </div>
                <div class="financial-card">
                    <span>Solde Wallet actuel</span>
                    <strong>{{ financialData.wallet_balance }}</strong>
                    <small><i class="fas fa-wallet"></i> {{ financialData.wallet_points }} points fidélité</small>
                </div>
            </section>

            <section class="financial-grid">
                <div class="financial-chart wow fadeInUp" data-wow-delay="180ms">
                    <header>
                        <h2>Répartition mensuelle</h2>
                        <span>Mai - Novembre 2025</span>
                    </header>
                    <div class="financial-bars">
                        {% if monthly|length > 0 %}
                            {% set maxValue = 0 %}
                            {% for item in monthly %}
                                {% set value = item.total|replace({' MGA': '', ' ': ''})|number_format(0, '', '')|number_format(0, '', '') %}
                                {% if value > maxValue %}
                                    {% set maxValue = value %}
                                {% endif %}
                            {% endfor %}
                            {% for item in monthly %}
                                {% set value = item.total|replace({' MGA': '', ' ': ''})|number_format(0, '', '')|number_format(0, '', '') %}
                                {% set height = maxValue > 0 ? ((value / maxValue) * 200 + 60)|round : 60 %}
                                <div class="bar-item">
                                    <div class="bar" style="height: {{ height }}px"></div>
                                    <span class="bar-month">{{ item.month }}</span>
                                    <span class="bar-value">{{ item.total }}</span>
                                </div>
                            {% endfor %}
                        {% else %}
                            {% for i in 1..5 %}
                                <div class="bar-item">
                                    <div class="bar" style="height: 60px"></div>
                                    <span class="bar-month">Mois {{ i }}</span>
                                    <span class="bar-value">0 MGA</span>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
                <div class="financial-breakdown wow fadeInUp" data-wow-delay="210ms">
                    <header>
                        <h2>Sources de paiement</h2>
                    </header>
                    <ul>
                        {% if paymentMethods|length > 0 %}
                            {% set colors = ['dot-1', 'dot-2', 'dot-3', 'dot-4'] %}
                            {% for i, method in paymentMethods|slice(0, 4) %}
                                <li><span class="dot {{ colors[i % colors|length] }}"></span> {{ method.label }} <strong>{{ method.percentage }} %</strong></li>
                            {% endfor %}
                        {% else %}
                            <li><span class="dot dot-1"></span> Aucune donnée disponible</li>
                        {% endif %}
                    </ul>
                    <div class="financial-note">
                        Astuce : rechargez votre wallet pour bénéficier des réductions fidélité automatiques.
                    </div>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
