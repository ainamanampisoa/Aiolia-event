{% extends 'base.html.twig' %}

{% block title %}Historique financier - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-financial.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set monthly = monthly|default([
        { month: 'Juillet', total: '220 000 MGA' },
        { month: 'Août', total: '180 000 MGA' },
        { month: 'Septembre', total: '260 000 MGA' },
        { month: 'Octobre', total: '320 000 MGA' },
        { month: 'Novembre', total: '300 000 MGA' }
    ]) %}

    <main class="profile-financial-wrapper">
        <div class="container">
            <header class="financial-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>Historique financier détaillé</h1>
                    <p>Analysez vos dépenses, vos remboursements et vos soldes mois par mois.</p>
                </div>
                <div class="financial-actions">
                    <button class="btn-outline"><i class="fas fa-file-export"></i> Exporter CSV</button>
                    <button class="btn-solid"><i class="fas fa-file-pdf"></i> Rapport PDF</button>
                </div>
            </header>

            <section class="financial-summary wow fadeInUp" data-wow-delay="150ms">
                <div class="financial-card">
                    <span>Total dépenses 2025</span>
                    <strong>1 820 000 MGA</strong>
                    <small><i class="fas fa-arrow-up"></i> +8 % vs 2024</small>
                </div>
                <div class="financial-card">
                    <span>Remboursements reçus</span>
                    <strong>360 000 MGA</strong>
                    <small><i class="fas fa-undo"></i> 4 évènements</small>
                </div>
                <div class="financial-card">
                    <span>Solde Wallet actuel</span>
                    <strong>420 000 MGA</strong>
                    <small><i class="fas fa-wallet"></i> Recharge suggérée 280 000 MGA</small>
                </div>
            </section>

            <section class="financial-grid">
                <div class="financial-chart wow fadeInUp" data-wow-delay="180ms">
                    <header>
                        <h2>Répartition mensuelle</h2>
                        <span>Mai - Novembre 2025</span>
                    </header>
                    <div class="financial-bars">
                        {% for item in monthly %}
                            <div class="bar-item">
                                <div class="bar" style="height: {{ loop.index * 40 + 80 }}px"></div>
                                <span class="bar-month">{{ item.month }}</span>
                                <span class="bar-value">{{ item.total }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="financial-breakdown wow fadeInUp" data-wow-delay="210ms">
                    <header>
                        <h2>Sources de paiement</h2>
                    </header>
                    <ul>
                        <li><span class="dot dot-1"></span> Mobile Money <strong>55 %</strong></li>
                        <li><span class="dot dot-2"></span> Cartes bancaires <strong>28 %</strong></li>
                        <li><span class="dot dot-3"></span> Wallet <strong>12 %</strong></li>
                        <li><span class="dot dot-4"></span> Autres <strong>5 %</strong></li>
                    </ul>
                    <div class="financial-note">
                        Astuce : rechargez votre wallet pour bénéficier des réductions fidélité automatiques.
                    </div>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
