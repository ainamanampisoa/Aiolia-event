{% extends 'base.html.twig' %}

{% block title %}Historique financier - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-financial.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set monthly = monthly|default([]) %}
    {% set financialData = financialData|default({
        total_spent: '0 MGA',
        total_refunded: '0 MGA',
        refund_count: 0,
        wallet_balance: '0 MGA',
        wallet_points: 0,
        total_orders: 0,
        average_order: '0 MGA',
        monthly_spent: '0 MGA',
        year_over_year_change: 0
    }) %}
    {% set paymentMethods = paymentMethods|default([]) %}
    {% set currentYear = currentYear|default("now"|date("Y")) %}
    {% set currentMonth = currentMonth|default(0) %}
    {% set currentPeriod = currentPeriod|default('year') %}

    <main class="profile-financial-wrapper">
        <div class="container">
            <header class="financial-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1 style="color: #1F2D3D;">Historique financier détaillé</h1>
                    <p>Analysez vos dépenses et vos remboursements mois par mois.</p>
                </div>
                <div class="financial-actions">
                    <a href="{{ path('profile_financial_export_pdf', {
                        'year': currentYear,
                        'month': currentMonth,
                        'period': currentPeriod,
                        'monthly_range': monthlyRange|default('last_6'),
                        'payment_method': paymentMethodFilter|default('all'),
                        'min_amount': minAmount|default(null),
                        'max_amount': maxAmount|default(null),
                        'category': categoryFilter|default('all')
                    }) }}" class="btn-solid btn-pdf" target="_blank">
                        <i class="fas fa-file-pdf"></i> Rapport PDF
                    </a>
                    <a href="{{ path('profile_financial_export_csv', {
                        'year': currentYear,
                        'month': currentMonth,
                        'period': currentPeriod,
                        'monthly_range': monthlyRange|default('last_6'),
                        'payment_method': paymentMethodFilter|default('all'),
                        'min_amount': minAmount|default(null),
                        'max_amount': maxAmount|default(null),
                        'category': categoryFilter|default('all')
                    }) }}" class="btn-solid btn-csv" style="background: linear-gradient(135deg, #50C878 0%, #3FAF6B 100%); margin-left: 10px;">
                        <i class="fas fa-file-csv"></i> Export CSV
                    </a>
                </div>
            </header>

            {# Filtres de statistiques #}
            <section class="financial-filters wow fadeIn" data-wow-delay="120ms">
                <form method="GET" action="{{ path('profile_financial') }}" class="filter-form">
                    <div class="filter-group">
                        <label for="period"><i class="fas fa-calendar"></i> Période</label>
                        <select name="period" id="period" onchange="this.form.submit()">
                            <option value="year" {{ currentPeriod == 'year' ? 'selected' : '' }}>Année</option>
                            <option value="month" {{ currentPeriod == 'month' ? 'selected' : '' }}>Mois</option>
                            <option value="all" {{ currentPeriod == 'all' ? 'selected' : '' }}>Tout</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="year"><i class="fas fa-calendar-alt"></i> Année</label>
                        <select name="year" id="year" onchange="this.form.submit()">
                            {% for y in range("now"|date("Y"), "now"|date("Y") - 5) %}
                                <option value="{{ y }}" {{ currentYear == y ? 'selected' : '' }}>{{ y }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% if currentPeriod == 'month' %}
                    <div class="filter-group">
                        <label for="month"><i class="fas fa-calendar-week"></i> Mois</label>
                        <select name="month" id="month" onchange="this.form.submit()">
                            <option value="0" {{ currentMonth == 0 ? 'selected' : '' }}>Tous les mois</option>
                            {% set months = {
                                1: 'Janvier', 2: 'Février', 3: 'Mars', 4: 'Avril',
                                5: 'Mai', 6: 'Juin', 7: 'Juillet', 8: 'Août',
                                9: 'Septembre', 10: 'Octobre', 11: 'Novembre', 12: 'Décembre'
                            } %}
                            {% for monthNum, monthName in months %}
                                <option value="{{ monthNum }}" {{ currentMonth == monthNum ? 'selected' : '' }}>{{ monthName }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endif %}
                    <div class="filter-actions">
                        <button type="submit" class="btn-filter"><i class="fas fa-filter"></i> Filtrer</button>
                        <a href="{{ path('profile_financial') }}" class="btn-reset"><i class="fas fa-redo"></i> Réinitialiser</a>
                    </div>
                </form>
            </section>

            {# Filtres avancés #}
            <section class="financial-filters-advanced wow fadeIn" data-wow-delay="140ms">
                <form method="GET" action="{{ path('profile_financial') }}" class="filter-form-advanced">
                    {# Conserver les filtres de base #}
                    <input type="hidden" name="period" value="{{ currentPeriod }}">
                    <input type="hidden" name="year" value="{{ currentYear }}">
                    {% if currentMonth > 0 %}
                        <input type="hidden" name="month" value="{{ currentMonth }}">
                    {% endif %}
                    
                    <div class="advanced-filters-header">
                        <h3><i class="fas fa-sliders-h"></i> Filtres avancés</h3>
                        <button type="button" class="toggle-advanced-filters" onclick="toggleAdvancedFilters()">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </div>
                    
                    <div class="advanced-filters-content" id="advancedFiltersContent" style="display: {{ (paymentMethodFilter != 'all' or minAmount or maxAmount or categoryFilter != 'all') ? 'block' : 'none' }};">
                        {# Méthode de paiement : Mvola uniquement - filtre retiré car une seule option #}
                        <input type="hidden" name="payment_method" value="all">
                        <div class="filter-info-mvola">
                            <div class="mvola-badge">
                                <i class="fas fa-mobile-alt"></i>
                                <strong>MVola</strong> - Méthode de paiement exclusive
                            </div>
                        </div>
                        
                        <div class="filter-group">
                            <label for="min_amount"><i class="fas fa-money-bill-wave"></i> Montant minimum (MGA)</label>
                            <input type="number" name="min_amount" id="min_amount" value="{{ minAmount }}" placeholder="Ex: 10000" min="0" step="1000">
                        </div>
                        
                        <div class="filter-group">
                            <label for="max_amount"><i class="fas fa-money-bill-wave"></i> Montant maximum (MGA)</label>
                            <input type="number" name="max_amount" id="max_amount" value="{{ maxAmount }}" placeholder="Ex: 100000" min="0" step="1000">
                        </div>
                        
                        <div class="filter-group">
                            <label for="category"><i class="fas fa-tags"></i> Catégorie d'événement</label>
                            <select name="category" id="category">
                                <option value="all" {{ categoryFilter == 'all' ? 'selected' : '' }}>Toutes</option>
                                {% if availableCategories is defined and availableCategories is iterable %}
                                    {% for cat in availableCategories %}
                                        {% if cat is iterable and cat.slug is defined %}
                                            <option value="{{ cat.slug }}" {{ categoryFilter == cat.slug ? 'selected' : '' }}>{{ cat.label }}</option>
                                        {% else %}
                                            <option value="{{ cat }}" {{ categoryFilter == cat ? 'selected' : '' }}>{{ cat }}</option>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            </select>
                        </div>
                        
                        <div class="filter-actions">
                            <button type="submit" class="btn-filter"><i class="fas fa-search"></i> Appliquer</button>
                        </div>
                    </div>
                </form>
            </section>

            {# Insights intelligents #}
            {% if financialInsights is defined and financialInsights|length > 0 %}
            <section class="financial-insights wow fadeInUp" data-wow-delay="160ms">
                <h2><i class="fas fa-lightbulb"></i> Analyses et recommandations</h2>
                <div class="insights-grid">
                    {% for insight in financialInsights %}
                        <div class="insight-card insight-{{ insight.type }}">
                            <div class="insight-icon">
                                <i class="{{ insight.icon }}"></i>
                            </div>
                            <div class="insight-content">
                                <h4>{{ insight.title }}</h4>
                                <p>{{ insight.message }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            {# Comparaison avec période précédente #}
            {% if comparison is defined and comparison.has_comparison %}
            <section class="financial-comparison wow fadeInUp" data-wow-delay="165ms">
                <h2><i class="fas fa-chart-line"></i> Comparaison avec la période précédente</h2>
                <div class="comparison-grid">
                    <div class="comparison-card">
                        <div class="comparison-label">Dépenses</div>
                        <div class="comparison-values">
                            <span class="current-value">{{ comparison.current_spent|number_format(0, ',', ' ') }} MGA</span>
                            <span class="change-badge {{ comparison.spent_increase ? 'increase' : 'decrease' }}">
                                <i class="fas fa-arrow-{{ comparison.spent_increase ? 'up' : 'down' }}"></i>
                                {{ comparison.spent_change|abs|number_format(1) }}%
                            </span>
                        </div>
                        <div class="previous-value">vs {{ comparison.previous_spent|number_format(0, ',', ' ') }} MGA</div>
                    </div>
                    
                    <div class="comparison-card">
                        <div class="comparison-label">Commandes</div>
                        <div class="comparison-values">
                            <span class="current-value">{{ comparison.current_orders }}</span>
                            <span class="change-badge {{ comparison.orders_increase ? 'increase' : 'decrease' }}">
                                <i class="fas fa-arrow-{{ comparison.orders_increase ? 'up' : 'down' }}"></i>
                                {{ comparison.orders_change|abs|number_format(1) }}%
                            </span>
                        </div>
                        <div class="previous-value">vs {{ comparison.previous_orders }}</div>
                    </div>
                </div>
            </section>
            {% endif %}

            <section class="financial-summary wow fadeInUp" data-wow-delay="150ms">
                <div class="financial-card card-total">
                    <div class="card-icon icon-total">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="card-content">
                        <span>Total dépenses 
                            {% if currentPeriod == 'year' %}
                                {{ currentYear }}
                            {% elseif currentPeriod == 'month' and currentMonth > 0 %}
                                {% set months = {
                                    1: 'Janvier', 2: 'Février', 3: 'Mars', 4: 'Avril',
                                    5: 'Mai', 6: 'Juin', 7: 'Juillet', 8: 'Août',
                                    9: 'Septembre', 10: 'Octobre', 11: 'Novembre', 12: 'Décembre'
                                } %}
                                {{ months[currentMonth] }} {{ currentYear }}
                            {% else %}
                                Toutes périodes
                            {% endif %}
                        </span>
                        <strong>{{ financialData.total_spent }}</strong>
                        <small>
                            {% if currentPeriod == 'year' and financialData.total_spent != '0 MGA' %}
                                <i class="fas fa-arrow-{{ financialData.year_over_year_change >= 0 ? 'up' : 'down' }}"></i>
                                {{ financialData.year_over_year_change >= 0 ? '+' : '' }}{{ financialData.year_over_year_change }}% vs année précédente
                            {% elseif financialData.total_spent != '0 MGA' %}
                                <i class="fas fa-chart-line"></i>
                                Période sélectionnée
                            {% else %}
                                <i class="fas fa-info-circle"></i>
                                Aucune dépense
                            {% endif %}
                        </small>
                    </div>
                </div>
                <div class="financial-card card-monthly">
                    <div class="card-icon icon-monthly">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <div class="card-content">
                        <span>Dépenses ce mois</span>
                        <strong>{{ financialData.monthly_spent }}</strong>
                        <small><i class="fas fa-calendar"></i> {{ "now"|date("F Y") }}</small>
                    </div>
                </div>
                <div class="financial-card card-orders">
                    <div class="card-icon icon-orders">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div class="card-content">
                        <span>Nombre de commandes</span>
                        <strong>{{ financialData.total_orders }}</strong>
                        <small><i class="fas fa-receipt"></i> Moyenne: {{ financialData.average_order }}</small>
                    </div>
                </div>
                <div class="financial-card card-refunds">
                    <div class="card-icon icon-refunds">
                        <i class="fas fa-undo"></i>
                    </div>
                    <div class="card-content">
                        <span>Remboursements reçus</span>
                        <strong>{{ financialData.total_refunded }}</strong>
                        <small><i class="fas fa-ticket-alt"></i> {{ financialData.refund_count }} évènement(s)</small>
                    </div>
                </div>
            </section>

            <section class="financial-grid">
                <div class="financial-chart wow fadeInUp" data-wow-delay="180ms">
                    <header>
                        <h2>Répartition mensuelle (12 derniers mois)</h2>
                        <div class="chart-legend">
                            <span class="legend-item"><i class="fas fa-circle" style="color: #4A90E2;"></i> Dépenses</span>
                        </div>
                    </header>
                    {% set monthlyRolling = monthlyRolling|default([]) %}
                    
                    {# Calculer le maximum pour déterminer l'échelle #}
                    {% set rawMax = 0 %}
                    {% for item in monthlyRolling %}
                        {% set rVal = item.total_raw|default(0) %}
                        {% if rVal > rawMax %}{% set rawMax = rVal %}{% endif %}
                    {% endfor %}
                    
                    {# Calculer un pas adaptatif pour avoir environ 6-8 labels maximum #}
                    {% if rawMax > 0 %}
                        {# Calculer un pas qui donnera environ 6-8 divisions #}
                        {% set targetDivisions = 7 %}
                        {% set calculatedStep = (rawMax / targetDivisions)|round(0, 'ceil') %}
                        {# Arrondir le pas à un multiple de 5000 ou 10000 pour des valeurs propres #}
                        {% if calculatedStep <= 5000 %}
                            {% set step = 5000 %}
                        {% elseif calculatedStep <= 10000 %}
                            {% set step = 10000 %}
                        {% elseif calculatedStep <= 20000 %}
                            {% set step = 20000 %}
                        {% elseif calculatedStep <= 50000 %}
                            {% set step = 50000 %}
                        {% else %}
                            {% set step = ((calculatedStep / 10000)|round(0, 'ceil')) * 10000 %}
                        {% endif %}
                        {% set maxValue = ((rawMax / step)|round(0, 'ceil')) * step %}
                    {% else %}
                        {% set step = 10000 %}
                        {% set maxValue = step %}
                    {% endif %}
                    
                    {# Nombre de lignes de grille = nombre de pas de 0 à maxValue #}
                    {% set gridLines = (maxValue / step)|round(0, 'ceil') %}
                    
                    {# Couleurs distinctes #}
                    {% set barColors = ['linear-gradient(180deg, #FF8C42 0%, #FF6B1A 100%)', 'linear-gradient(180deg, #FFD93D 0%, #FFC107 100%)', 'linear-gradient(180deg, #6BCB77 0%, #4CAF50 100%)', 'linear-gradient(180deg, #4D96FF 0%, #2563EB 100%)', 'linear-gradient(180deg, #9B59B6 0%, #7B2CBF 100%)', 'linear-gradient(180deg, #FF6B6B 0%, #E63946 100%)', 'linear-gradient(180deg, #74B9FF 0%, #0984E3 100%)', 'linear-gradient(180deg, #FFA07A 0%, #FF7F50 100%)', 'linear-gradient(180deg, #20BF6B 0%, #01A368 100%)', 'linear-gradient(180deg, #A29BFE 0%, #6C5CE7 100%)', 'linear-gradient(180deg, #FD79A8 0%, #E84393 100%)', 'linear-gradient(180deg, #FDCB6E 0%, #F39C12 100%)'] %}

                    <div class="financial-bars-wrapper">
                        {# Axe Y #}
                        <div class="chart-y-axis">
                            {% for i in range(0, gridLines) %}
                                {% set labelVal = step * i %}
                                {% set positionPercent = (i * 100 / gridLines)|round(2) %}
                                <div class="y-label" style="bottom: {{ positionPercent }}%;">
                                    {{ labelVal|number_format(0, ',', ' ') ~ ' MGA' }}
                                </div>
                            {% endfor %}
                        </div>
                        
                        {# Zone du graphique #}
                        <div class="financial-bars">
                            <div class="chart-grid">
                                {% for i in range(0, gridLines) %}
                                    {% set positionPercent = (i * 100 / gridLines)|round(2) %}
                                    <div class="grid-line" style="bottom: {{ positionPercent }}%;"></div>
                                {% endfor %}
                            </div>
                            
                            <div class="bars-container sliding-mode">
                                {% if monthlyRolling|length > 0 %}
                                    {% for item in monthlyRolling %}
                                        {% set valNum = item.total_raw|default(0) + 0 %}
                                        {% set height = ((valNum / maxValue) * 300)|round %}
                                        {% if height > 300 %}{% set height = 300 %}{% endif %}
                                        {% if height < 4 and valNum > 0 %}{% set height = 4 %}{% endif %}
                                        
                                        {% set colorIndex = (loop.index0 % barColors|length) %}
                                        
                                        <div class="bar-item-modern {{ valNum == 0 ? 'bar-empty' : '' }}">
                                            {% if valNum > 0 %}
                                            <div class="bar-value-top" style="bottom: {{ height + 5 }}px;">
                                                {{ (valNum >= 1000) ? (valNum/1000)|round ~ 'k' : valNum }}
                                            </div>
                                            {% endif %}
                                            <div class="bar-container">
                                                <div class="bar-modern" style="height: {{ height }}px; {{ valNum > 0 ? 'background: ' ~ barColors[colorIndex] ~ ';' : '' }}" title="{{ item.total }}">
                                                </div>
                                            </div>
                                            <div class="bar-label-double">
                                                <span class="month-name">{{ item.month|slice(0, 3) }}.</span>
                                                <span class="year-name">{{ item.month_key|slice(2, 2) }}</span>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="no-data-message">
                                        <p><i class="fas fa-info-circle"></i> Aucune donnée de dépense.</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="financial-breakdown wow fadeInUp" data-wow-delay="210ms">
                    <header>
                        <h2><i class="fas fa-mobile-alt"></i> Méthode de paiement</h2>
                    </header>
                    <div class="mvola-payment-info">
                        <div class="mvola-logo-card">
                            <div class="mvola-icon">
                                <i class="fas fa-mobile-alt"></i>
                            </div>
                            <div class="mvola-details">
                                <h3>MVola</h3>
                                <p>Paiement mobile sécurisé</p>
                                <span class="mvola-badge-exclusive">Méthode exclusive</span>
                            </div>
                        </div>
                        {% if financialData.total_orders > 0 %}
                        <div class="mvola-stats">
                            <div class="stat-item">
                                <i class="fas fa-check-circle"></i>
                                <span>{{ financialData.total_orders }} transaction(s)</span>
                            </div>
                            <div class="stat-item">
                                <i class="fas fa-shield-alt"></i>
                                <span>100% sécurisé</span>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                    <div class="financial-note mvola-note">
                        <i class="fas fa-info-circle"></i> Tous vos paiements sont effectués via MVola pour une sécurité optimale.
                    </div>
                </div>
            </section>


        </div>
    </main>

    <script>
        function updateMonthlyChart(range) {
            const url = new URL(window.location.href);
            url.searchParams.set('monthly_range', range);
            window.location.href = url.toString();
        }

        function toggleAdvancedFilters() {
            const content = document.getElementById('advancedFiltersContent');
            const button = document.querySelector('.toggle-advanced-filters i');
            
            if (content.style.display === 'none' || content.style.display === '') {
                content.style.display = 'block';
                button.classList.remove('fa-chevron-down');
                button.classList.add('fa-chevron-up');
            } else {
                content.style.display = 'none';
                button.classList.remove('fa-chevron-up');
                button.classList.add('fa-chevron-down');
            }
        }

        // Auto-expand advanced filters if any are active
        document.addEventListener('DOMContentLoaded', function() {
            const content = document.getElementById('advancedFiltersContent');
            if (content && content.style.display === 'block') {
                const button = document.querySelector('.toggle-advanced-filters i');
                if (button) {
                    button.classList.remove('fa-chevron-down');
                    button.classList.add('fa-chevron-up');
                }
            }
        });
    </script>

    <style>
        .financial-filters-advanced {
            background: #ffffff;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .advanced-filters-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .advanced-filters-header h3 {
            font-size: 1.1rem;
            color: #1F2D3D;
            margin: 0;
        }

        .toggle-advanced-filters {
            background: none;
            border: none;
            color: #4A90E2;
            font-size: 1.2rem;
            cursor: pointer;
            transition: transform 0.3s;
        }

        .toggle-advanced-filters:hover {
            transform: scale(1.1);
        }

        .advanced-filters-content {
            animation: slideDown 0.3s ease-out;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .filter-form-advanced .filter-group {
            margin-bottom: 15px;
        }

        .filter-form-advanced input[type="number"] {
            width: 100%;
            padding: 10px 15px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: border-color 0.3s;
        }

        /* Nouvelles variables de couleurs pour l'animation */
        :root {
            --color-total: #1F2D3D;
            --color-monthly: #4A90E2;
            --color-orders: #50C878;
            --color-refunds: #E74C3C;
        }

        .financial-card {
            border: 1px solid rgba(31, 45, 61, 0.05);
        }

        .financial-card.card-total { border-left: 4px solid var(--color-total); }
        .financial-card.card-monthly { border-left: 4px solid var(--color-monthly); }
        .financial-card.card-orders { border-left: 4px solid var(--color-orders); }
        .financial-card.card-refunds { border-left: 4px solid var(--color-refunds); }

        .icon-total { background: rgba(31, 45, 61, 0.1) !important; color: var(--color-total) !important; }
        .icon-monthly { background: rgba(74, 144, 226, 0.1) !important; color: var(--color-monthly) !important; }
        .icon-orders { background: rgba(80, 200, 120, 0.1) !important; color: var(--color-orders) !important; }
        .icon-refunds { background: rgba(231, 76, 60, 0.1) !important; color: var(--color-refunds) !important; }

        .financial-card:hover .icon-total { background: var(--color-total) !important; color: white !important; }
        .financial-card:hover .icon-monthly { background: var(--color-monthly) !important; color: white !important; }
        .financial-card:hover .icon-orders { background: var(--color-orders) !important; color: white !important; }
        .financial-card:hover .icon-refunds { background: var(--color-refunds) !important; color: white !important; }

        .financial-comparison {
            background: linear-gradient(135deg, #ffffff 0%, #f0f4f8 100%);
            border: 1px solid rgba(74, 144, 226, 0.15);
        }

        .mvola-logo-card {
            box-shadow: 0 10px 30px rgba(31, 45, 61, 0.2);
            position: relative;
            overflow: hidden;
        }

        .mvola-logo-card::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            pointer-events: none;
        }

