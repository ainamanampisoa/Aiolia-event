{% extends 'base.html.twig' %}

{% block title %}{{ 'profile_history.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-history.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set orders = orders|default([]) %}
    {% set stats = stats|default({
        total_spent: '0 MGA',
        confirmed_orders: 0,
        total_tickets: 0,
        vip_tickets: 0,
        refunded_count: 0,
        refunded_amount: '0 MGA',
        average_cart: '0 MGA'
    }) %}

    <main class="profile-history-wrapper">
        <div class="container">
            <header class="profile-history-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>{{ 'profile_history.header_title'|trans }}</h1>
                    <p>{{ 'profile_history.header_desc'|trans }}</p>
                </div>
                <div class="profile-history-actions">
                    <a href="{{ path('my_tickets') }}" class="btn-solid">
                        <i class="fas fa-ticket-alt"></i> {{ 'profile_history.view_tickets'|trans|default('Mes billets') }}
                    </a>
                    <button class="btn-outline"><i class="fas fa-file-download"></i> {{ 'profile_history.export_pdf'|trans }}</button>
                    <button class="btn-solid secondary"><i class="fas fa-filter"></i> {{ 'profile_history.filter'|trans }}</button>
                </div>
            </header>

            <section class="profile-history-summary wow fadeInUp" data-wow-delay="150ms">
                <div class="summary-card">
                    <span class="summary-label">{{ 'profile_history.total_spent_label'|trans }}</span>
                    <strong>{{ stats.total_spent }}</strong>
                    <small>{{ stats.confirmed_orders }} {{ 'profile_history.total_spent_suffix'|trans }}</small>
                </div>
                <div class="summary-card">
                    <span class="summary-label">{{ 'profile_history.tickets_label'|trans }}</span>
                    <strong>{{ stats.total_tickets }} {{ 'profile_history.tickets_suffix'|trans }}</strong>
                    <small>
                        {% if stats.vip_tickets > 0 %}
                            {{ 'profile_history.tickets_vip_suffix'|trans({'{vip}': stats.vip_tickets})|raw }}
                        {% else %}
                            {{ 'profile_history.tickets_no_vip'|trans }}
                        {% endif %}
                    </small>
                </div>
                <div class="summary-card">
                    <span class="summary-label">{{ 'profile_history.refunds_label'|trans }}</span>
                    <strong>{{ stats.refunded_count }} {{ 'profile_history.refunds_transactions'|trans }}</strong>
                    <small>{{ 'profile_history.refunds_amount_prefix'|trans }} {{ stats.refunded_amount }}</small>
                </div>
            </section>

            <section class="profile-history-table wow fadeInUp" data-wow-delay="200ms">
                        <div class="history-table-head">
                            <form method="get" action="{{ path('profile_history') }}" class="history-search-form">
                                <div class="history-search">
                                    <i class="fas fa-search"></i>
                                    <input type="search" name="search" value="{{ searchQuery|default('') }}" placeholder="{{ 'profile_history.search_placeholder'|trans|default('Rechercher par événement, numéro de commande...') }}">
                                    {% if searchQuery %}
                                        <a href="{{ path('profile_history', {status: currentStatusFilter|default('all')}) }}" class="clear-search" title="Effacer la recherche">
                                            <i class="fas fa-times"></i>
                                        </a>
                                    {% endif %}
                                </div>
                                <input type="hidden" name="status" id="status-filter-input" value="{{ currentStatusFilter|default('all') }}">
                            </form>
                            <div class="history-filters">
                                <button class="tag {% if currentStatusFilter|default('all') == 'all' %}active{% endif %}" data-status="all" onclick="filterByStatus('all')">
                                    {{ 'profile_history.tag_all'|trans|default('Tous') }}
                                </button>
                                {% if availableStatuses is defined and availableStatuses|length > 0 %}
                                    {% for status in availableStatuses %}
                                        <button class="tag {% if currentStatusFilter|default('all') == status.key %}active{% endif %}" data-status="{{ status.key }}" onclick="filterByStatus('{{ status.key }}')">
                                            {{ status.label }} ({{ status.count }})
                                        </button>
                                    {% endfor %}
                                {% else %}
                                    {# Fallback si aucun statut n'est disponible #}
                                    <button class="tag {% if currentStatusFilter|default('all') == 'paid' %}active{% endif %}" data-status="paid" onclick="filterByStatus('paid')">
                                        Payée
                                    </button>
                                    <button class="tag {% if currentStatusFilter|default('all') == 'refunded' %}active{% endif %}" data-status="refunded" onclick="filterByStatus('refunded')">
                                        Remboursée
                                    </button>
                                    <button class="tag {% if currentStatusFilter|default('all') == 'cancelled' %}active{% endif %}" data-status="cancelled" onclick="filterByStatus('cancelled')">
                                        Annulée
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                <div class="history-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>{{ 'profile_history.col_order'|trans }}</th>
                                <th>{{ 'profile_history.col_event'|trans }}</th>
                                <th>{{ 'profile_history.col_datetime'|trans }}</th>
                                <th>{{ 'profile_history.col_tickets'|trans }}</th>
                                <th>{{ 'profile_history.col_amount'|trans }}</th>
                                <th>{{ 'profile_history.col_payment'|trans }}</th>
                                <th class="align-right">{{ 'profile_history.col_actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if orders|length > 0 %}
                                {% for order in orders %}
                                    <tr class="history-row {% if order.status_key == 'confirmed' %}is-confirmed{% elseif order.status_key == 'refunded' %}is-refunded{% else %}is-cancelled{% endif %}">
                                        <td>
                                            <div class="order-code">{{ order.code }}</div>
                                            <span class="order-status">{{ order.status }}</span>
                                        </td>
                                        <td>
                                            <strong>{{ order.title }}</strong>
                                        </td>
                                        <td>
                                            <div>{{ order.date }}</div>
                                            <small>{{ order.hour }}</small>
                                        </td>
                                        <td>{{ order.tickets }} {{ 'profile_history.tickets_suffix'|trans }}</td>
                                        <td>{{ order.amount }}</td>
                                        <td>
                                            <i class="fas fa-credit-card"></i> {{ order.method }}
                                        </td>
                                        <td class="align-right">
                                            <button class="link-btn"><i class="fas fa-receipt"></i> {{ 'profile_history.btn_receipt'|trans }}</button>
                                            <button class="link-btn"><i class="fas fa-print"></i> {{ 'profile_history.btn_print'|trans }}</button>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="7" style="text-align: center; padding: 40px;">
                                        <i class="fas fa-shopping-bag" style="font-size: 48px; color: #ccc; margin-bottom: 16px;"></i>
                                        <p style="color: #999;">{{ 'profile_history.no_orders'|trans }}</p>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        // Fonction pour filtrer par statut
        function filterByStatus(status) {
            const form = document.querySelector('.history-search-form');
            if (!form) return;
            
            const statusInput = document.getElementById('status-filter-input');
            if (statusInput) {
                statusInput.value = status;
            }
            
            // Mettre à jour les boutons actifs
            document.querySelectorAll('.history-filters .tag').forEach(btn => {
                btn.classList.remove('active');
                if (btn.dataset.status === status) {
                    btn.classList.add('active');
                }
            });
            
            // Soumettre le formulaire
            form.submit();
        }

        // Gestion de la recherche
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.querySelector('.history-search input[type="search"]');
            const form = document.querySelector('.history-search-form');
            let searchTimeout;

            if (searchInput && form) {
                // Recherche avec délai (debounce)
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(function() {
                        form.submit();
                    }, 500); // Attendre 500ms après la dernière frappe
                });

                // Recherche immédiate sur Enter
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        clearTimeout(searchTimeout);
                        form.submit();
                    }
                });
            }
        });
    </script>
{% endblock %}
