{% extends 'base.html.twig' %}

{% block title %}Historique d'achat{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-history.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set orders = orders|default([]) %}
    {% set stats = stats|default({
        total_spent: '0 MGA',
        confirmed_orders: 0,
        total_tickets: 0,
        vip_tickets: 0,
        upcoming_events: 0,
        average_cart: '0 MGA'
    }) %}

    {# Script inline pour restaurer la position AVANT le rendu #}
    <script>
        (function() {
            const savedPosition = sessionStorage.getItem('historyTableScrollPosition');
            if (savedPosition) {
                // Empêcher le scroll automatique du navigateur
                if ('scrollRestoration' in history) {
                    history.scrollRestoration = 'manual';
                }
                // Restaurer immédiatement
                window.addEventListener('DOMContentLoaded', function() {
                    const position = parseInt(savedPosition, 10);
                    if (position > 0) {
                        window.scrollTo(0, position);
                    }
                });
            }
        })();
    </script>

    <main class="profile-history-wrapper">
        <div class="container">
            <header class="profile-history-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>Historique d'achat</h1>
                    <p>Consultez l'historique de toutes vos commandes et transactions</p>
                </div>
                <div class="profile-history-actions">
                    <a href="{{ path('my_tickets') }}" class="btn-solid">
                        <i class="fas fa-ticket-alt"></i> Mes billets
                    </a>
                    {% set exportParams = {
                        'search': searchQuery|default(''),
                        'status': currentStatusFilter|default('all'),
                        'payment_method': currentPaymentMethodFilter|default('all')
                    } %}
                    <a href="{{ path('profile_history_export', exportParams) }}" class="btn-outline" title="Exporter l'historique en CSV">
                        <i class="fas fa-file-csv"></i> Exporter en CSV
                    </a>
                </div>
            </header>

            <section class="profile-history-summary wow fadeInUp" data-wow-delay="150ms">
                <div class="summary-card">
                    <span class="summary-label">Total dépensé</span>
                    <strong>{{ stats.total_spent }}</strong>
                    <small>{{ stats.confirmed_orders }} commande(s)</small>
                </div>
                <div class="summary-card">
                    <span class="summary-label">Billets achetés</span>
                    <strong>{{ stats.total_tickets }} billet(s)</strong>
                    <small>
                        {% if stats.vip_tickets > 0 %}
                            dont {{ stats.vip_tickets }} VIP
                        {% else %}
                            Aucun billet VIP
                        {% endif %}
                    </small>
                </div>
                <div class="summary-card">
                    <span class="summary-label">Événements à venir</span>
                    <strong>{{ stats.upcoming_events }} événement(s)</strong>
                    <small>
                        {% if stats.upcoming_events > 0 %}
                            Prochain événement bientôt
                        {% else %}
                            Aucun événement à venir
                        {% endif %}
                    </small>
                </div>
            </section>

            {# Section du graphique d'évolution #}
            <section class="profile-history-chart wow fadeInUp" data-wow-delay="180ms">
                <div class="chart-header">
                    <h3>Évolution de vos dépenses</h3>
                    <div class="chart-actions">
                        <select id="chart-period" class="chart-select">
                            <option value="6" {{ chartPeriod|default(6) == 6 ? 'selected' : '' }}>6 mois</option>
                            <option value="12" {{ chartPeriod|default(6) == 12 ? 'selected' : '' }}>12 mois</option>
                        </select>
                    </div>
                </div>
                <div class="chart-container">
                    <canvas id="spendingChart"></canvas>
                </div>
            </section>

            <section id="history-table" class="profile-history-table wow fadeInUp" data-wow-delay="200ms">
                <div class="history-filters-section">
                    <form method="get" action="{{ path('profile_history') }}" class="history-search-form" id="history-filter-form">
                        <input type="hidden" name="chart_period" value="{{ chartPeriod|default(6) }}">
                        <div class="filters-container">
                            <div class="history-search-wrapper">
                                <div class="history-search">
                                    <i class="fas fa-search"></i>
                                    <input type="search" name="search" value="{{ searchQuery|default('') }}" 
                                           placeholder="Rechercher un événement, numéro de commande..." 
                                           class="search-input">
                                    {% if searchQuery %}
                                        <button type="button" class="clear-search-btn" title="Effacer la recherche" onclick="clearSearch()">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    {% endif %}
                                    <button type="submit" class="search-submit-btn" title="Rechercher">
                                        <i class="fas fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                            
                            <div class="filters-row filters-row-below">
                                <div class="filter-group">
                                    <div class="filter-label">
                                        <i class="fas fa-tag"></i>
                                        <span>Statut</span>
                                    </div>
                                    <select id="status-filter-select" name="status" class="filter-select auto-submit">
                                        <option value="all" {% if currentStatusFilter|default('all') == 'all' %}selected{% endif %}>Tous les statuts</option>
                                        {% if availableStatuses is defined and availableStatuses|length > 0 %}
                                            {% for status in availableStatuses %}
                                                <option value="{{ status.key }}" {% if currentStatusFilter|default('all') == status.key %}selected{% endif %}>
                                                    {{ status.label }}
                                                </option>
                                            {% endfor %}
                                        {% endif %}
                                    </select>
                                </div>
                                
                                <div class="filter-group">
                                    <div class="filter-label">
                                        <i class="fas fa-credit-card"></i>
                                        <span>Paiement</span>
                                    </div>
                                    <select name="payment_method" class="filter-select auto-submit">
                                        <option value="all">Tous les paiements</option>
                                        <option value="mvola" {% if currentPaymentMethodFilter|default('all') == 'mvola' %}selected{% endif %}>M-Vola</option>
                                        <option value="orange-money" {% if currentPaymentMethodFilter|default('all') == 'orange-money' %}selected{% endif %}>Orange Money</option>
                                        <option value="airtel-money" {% if currentPaymentMethodFilter|default('all') == 'airtel-money' %}selected{% endif %}>Airtel Money</option>
                                    </select>
                                </div>
                                
                                <div class="filter-group">
                                    <div class="filter-label">
                                        <i class="fas fa-calendar-alt"></i>
                                        <span>Période</span>
                                    </div>
                                    <select name="date_range" class="filter-select auto-submit">
                                        <option value="all">Toute période</option>
                                        <option value="today" {% if currentDateFilter|default('all') == 'today' %}selected{% endif %}>Aujourd'hui</option>
                                        <option value="week" {% if currentDateFilter|default('all') == 'week' %}selected{% endif %}>Cette semaine</option>
                                        <option value="month" {% if currentDateFilter|default('all') == 'month' %}selected{% endif %}>Ce mois</option>
                                        <option value="3months" {% if currentDateFilter|default('all') == '3months' %}selected{% endif %}>3 derniers mois</option>
                                        <option value="year" {% if currentDateFilter|default('all') == 'year' %}selected{% endif %}>Cette année</option>
                                    </select>
                                </div>
                                
                                <div class="filter-group filter-group-dates">
                                    <div class="filter-label">
                                        <i class="fas fa-calendar-check"></i>
                                        <span>Dates</span>
                                    </div>
                                    <div class="date-inputs">
                                        <input type="date" name="start_date" value="{{ startDate|default('') }}" 
                                               class="date-input auto-submit" placeholder="De">
                                        <span class="date-separator">à</span>
                                        <input type="date" name="end_date" value="{{ endDate|default('') }}" 
                                               class="date-input auto-submit" placeholder="À">
                                    </div>
                                </div>

                                {# Bouton de réinitialisation #}
                                <div class="filter-group filter-group-actions">
                                    <div class="filter-label" style="opacity: 0;">Actions</div>
                                    <a href="{{ path('profile_history') }}" class="btn-reset-filters" title="Réinitialiser tous les filtres">
                                        <i class="fas fa-redo"></i>
                                        <span>Réinitialiser</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                
                <div class="history-table-wrapper">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Commande</th>
                                <th>Événement</th>
                                <th>Date et heure</th>
                                <th>Billets</th>
                                <th>Montant</th>
                                <th>Paiement</th>
                                <th class="align-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if orders|length > 0 %}
                                {% for order in orders %}
                                    <tr class="history-row {% if order.is_refunded %}is-refunded{% elseif order.status_key == 'paid' %}is-confirmed{% elseif order.status_key == 'cancelled' %}is-cancelled{% elseif order.status_key == 'failed' %}is-failed{% else %}is-pending{% endif %}">
                                        <td>
                                            <div class="order-code">{{ order.code }}</div>
                                            <span class="order-status">{{ order.status }}</span>
                                            {% if order.is_refunded and order.refund_reason %}
                                                <small class="refund-reason" style="display: block; margin-top: 4px; color: #e74c3c; font-size: 11px;">
                                                    <i class="fas fa-undo"></i> {{ order.refund_reason }}
                                                </small>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="event-info">
                                                <strong>{{ order.title }}</strong>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="date-time-info">
                                                <div class="date-value">{{ order.date }}</div>
                                                <small class="time-value">{{ order.hour }}</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="tickets-badge">{{ order.tickets }} billet(s)</span>
                                        </td>
                                        <td>
                                            <span class="amount-value">{{ order.amount }}</span>
                                        </td>
                                        <td>
                                            <div class="payment-method">
                                                <i class="fas fa-credit-card"></i>
                                                <span>{{ order.method }}</span>
                                            </div>
                                        </td>
                                        <td class="align-right">
                                            <div class="action-icons">
                                            <a href="{{ path('profile_history_invoice', {id: order.id}) }}" 
                                                   class="btn-icon btn-icon-pdf" 
                                               target="_blank"
                                               title="Télécharger la facture PDF">
                                                <i class="fas fa-file-pdf"></i>
                                            </a>
                                                <button type="button" 
                                                        class="btn-icon btn-icon-delete" 
                                                        data-order-id="{{ order.id }}"
                                                        title="Supprimer cette commande">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="7" class="empty-state">
                                        <div class="empty-content">
                                            <i class="fas fa-shopping-bag"></i>
                                            <p>Aucune commande trouvée</p>
                                            {% if searchQuery or currentStatusFilter != 'all' or currentPaymentMethodFilter != 'all' or currentDateFilter != 'all' %}
                                                <a href="{{ path('profile_history') }}" class="btn-solid btn-small">
                                                    <i class="fas fa-redo"></i> Réinitialiser les filtres
                                                </a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
                
                {# Pagination style panier #}
                {% if totalPages is defined and totalResults is defined and totalResults > perPage %}
                <div class="pagination-container">
                    <div class="pagination">
                        {% if currentPage > 1 %}
                            <a href="{{ path('profile_history', app.request.query.all|merge({page: currentPage - 1})) }}" class="page-btn prev">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        {% else %}
                            <span class="page-btn prev disabled">
                                <i class="fas fa-chevron-left"></i>
                            </span>
                        {% endif %}
                        
                        {% for page in 1..totalPages %}
                            {% if page == currentPage %}
                                <span class="page-btn active">{{ page }}</span>
                            {% else %}
                                <a href="{{ path('profile_history', app.request.query.all|merge({page: page})) }}" class="page-btn">{{ page }}</a>
                            {% endif %}
                        {% endfor %}
                        
                        {% if currentPage < totalPages %}
                            <a href="{{ path('profile_history', app.request.query.all|merge({page: currentPage + 1})) }}" class="page-btn next">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        {% else %}
                            <span class="page-btn next disabled">
                                <i class="fas fa-chevron-right"></i>
                            </span>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </section>
        </div>
    </main>

    {# Modal de confirmation de suppression #}
    <div id="deleteConfirmModal" class="delete-modal-overlay">
        <div class="delete-modal">
            <div class="delete-modal-header">
                <div class="delete-modal-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h3>Confirmer la suppression</h3>
            </div>
            <div class="delete-modal-body">
                <p>Êtes-vous sûr de vouloir supprimer cette commande de votre historique ?</p>
                <p class="delete-modal-warning">Cette action est irréversible.</p>
            </div>
            <div class="delete-modal-footer">
                <button type="button" class="btn-modal-cancel" id="deleteModalCancel">
                    <i class="fas fa-times"></i> Annuler
                </button>
                <button type="button" class="btn-modal-confirm" id="deleteModalConfirm">
                    <i class="fas fa-trash"></i> Supprimer
                </button>
            </div>
        </div>
    </div>

    {# Modal d'erreur #}
    <div id="errorModal" class="delete-modal-overlay">
        <div class="delete-modal">
            <div class="delete-modal-header">
                <div class="delete-modal-icon" style="background: linear-gradient(135deg, rgba(231, 76, 60, 0.15), rgba(192, 57, 43, 0.15)); border-color: rgba(231, 76, 60, 0.2);">
                    <i class="fas fa-times-circle" style="color: #e74c3c;"></i>
                </div>
                <h3>Erreur</h3>
            </div>
            <div class="delete-modal-body">
                <p id="errorModalMessage"></p>
            </div>
            <div class="delete-modal-footer">
                <button type="button" class="btn-modal-confirm" id="errorModalClose" style="width: 100%;">
                    <i class="fas fa-check"></i> Compris
                </button>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Fonction pour effacer la recherche
        function clearSearch() {
            const form = document.getElementById('history-filter-form');
            const searchInput = form.querySelector('input[name="search"]');
            searchInput.value = '';
            
            // Sauvegarder la position avant soumission
            saveScrollPosition();
            form.submit();
        }

        // Fonction pour filtrer par statut
        function filterByStatus(status) {
            const form = document.getElementById('history-filter-form');
            if (!form) return;
            
            const statusSelect = document.getElementById('status-filter-select');
            if (statusSelect) {
                statusSelect.value = status;
            }
            
            // Soumettre le formulaire
            form.submit();
        }

        // Gestion de la recherche et soumission automatique des filtres
        (function() {
            const form = document.getElementById('history-filter-form');
            if (!form) return;

            // Empêcher le scroll automatique du navigateur
            if ('scrollRestoration' in history) {
                history.scrollRestoration = 'manual';
            }
            
            // Sauvegarder la position de scroll avant la soumission
            function saveScrollPosition() {
                const scrollPosition = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop;
                if (scrollPosition > 0) {
                    sessionStorage.setItem('historyTableScrollPosition', scrollPosition.toString());
                }
            }

            // Restaurer la position de scroll après le chargement
            function restoreScrollPosition() {
                const savedPosition = sessionStorage.getItem('historyTableScrollPosition');
                if (savedPosition) {
                    const position = parseInt(savedPosition, 10);
                    if (position > 0) {
                        // Restaurer immédiatement
                        window.scrollTo(0, position);
                        
                        // Vérifier et ajuster si nécessaire
                        setTimeout(function() {
                            const currentScroll = window.pageYOffset || document.documentElement.scrollTop;
                            if (Math.abs(currentScroll - position) > 10) {
                                window.scrollTo(0, position);
                            }
                            sessionStorage.removeItem('historyTableScrollPosition');
                        }, 10);
                    } else {
                        sessionStorage.removeItem('historyTableScrollPosition');
                    }
                }
            }

            // Restaurer la position dès que possible
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', restoreScrollPosition);
            } else {
                restoreScrollPosition();
            }
            
            // Aussi essayer immédiatement
            restoreScrollPosition();

            // Recherche avec délai (debounce)
            const searchInput = document.querySelector('.search-input');
            let searchTimeout;

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(function() {
                        saveScrollPosition();
                        form.submit();
                    }, 500);
                });

                // Recherche immédiate sur Enter
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        clearTimeout(searchTimeout);
                        saveScrollPosition();
                        form.submit();
                    }
                });
            }

            // Soumission automatique pour tous les filtres avec classe auto-submit
            const autoSubmitElements = document.querySelectorAll('.auto-submit');
            autoSubmitElements.forEach(element => {
                element.addEventListener('change', function() {
                    saveScrollPosition();
                    form.submit();
                });
            });

            // Gestion du modal de confirmation de suppression
            const deleteModal = document.getElementById('deleteConfirmModal');
            const deleteModalCancel = document.getElementById('deleteModalCancel');
            const deleteModalConfirm = document.getElementById('deleteModalConfirm');
            const errorModal = document.getElementById('errorModal');
            const errorModalMessage = document.getElementById('errorModalMessage');
            const errorModalClose = document.getElementById('errorModalClose');
            let currentDeleteButton = null;
            let currentOrderId = null;
            let currentOrderRow = null;

            // Fonction pour afficher le modal d'erreur
            function showErrorModal(message) {
                if (errorModal && errorModalMessage) {
                    errorModalMessage.textContent = message;
                    errorModal.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            }

            // Fonction pour fermer le modal d'erreur
            function closeErrorModal() {
                if (errorModal) {
                    errorModal.classList.remove('active');
                    document.body.style.overflow = '';
                }
            }

            // Fermer le modal d'erreur
            if (errorModalClose) {
                errorModalClose.addEventListener('click', closeErrorModal);
            }
            if (errorModal) {
                errorModal.addEventListener('click', function(e) {
                    if (e.target === errorModal) {
                        closeErrorModal();
                    }
                });
            }

            // Fonction pour ouvrir le modal
            function openDeleteModal(orderId, orderRow, deleteButton) {
                if (!deleteModal) return;
                
                currentOrderId = orderId;
                currentOrderRow = orderRow;
                currentDeleteButton = deleteButton;
                deleteModal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            // Fonction pour fermer le modal
            function closeDeleteModal() {
                if (deleteModal) {
                    deleteModal.classList.remove('active');
                    document.body.style.overflow = '';
                }
                currentOrderId = null;
                currentOrderRow = null;
                currentDeleteButton = null;
            }

            // Fermer le modal en cliquant sur l'overlay
            if (deleteModal) {
                deleteModal.addEventListener('click', function(e) {
                    if (e.target === deleteModal) {
                        closeDeleteModal();
                    }
                });
            }

            // Fermer le modal avec le bouton Annuler
            if (deleteModalCancel) {
                deleteModalCancel.addEventListener('click', closeDeleteModal);
            }

            // Fermer le modal avec la touche Escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && deleteModal && deleteModal.classList.contains('active')) {
                    closeDeleteModal();
                }
            });

            // Confirmer la suppression
            if (deleteModalConfirm) {
                deleteModalConfirm.addEventListener('click', function() {
                    if (!currentOrderId || !currentOrderRow || !currentDeleteButton) {
                        closeDeleteModal();
                        return;
                    }

                    // Désactiver le bouton pendant la requête
                    currentDeleteButton.disabled = true;
                    if (currentDeleteButton.style) {
                        currentDeleteButton.style.opacity = '0.5';
                    }
                    if (deleteModalConfirm) {
                        deleteModalConfirm.disabled = true;
                        deleteModalConfirm.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Suppression...';
                    }

                // Envoyer la requête de suppression
                fetch(`/profile/history/${currentOrderId}/delete`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin'
                })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(data => {
                            throw new Error(data.message || 'Erreur lors de la suppression');
                        });
                    }
                    return response.json();
                })
                .then(data => {
                    // Sauvegarder les références avant de fermer le modal
                    const orderRow = currentOrderRow;
                    const deleteButton = currentDeleteButton;
                    
                    closeDeleteModal();
                    
                    if (data.success) {
                        // Vérifier que l'élément existe toujours dans le DOM
                        if (orderRow && orderRow.parentNode) {
                            // Animation de disparition
                            orderRow.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                            orderRow.style.opacity = '0';
                            orderRow.style.transform = 'translateX(-20px)';
                            
                            setTimeout(() => {
                                if (orderRow && orderRow.parentNode) {
                                    orderRow.remove();
                                    
                                    // Vérifier s'il reste des lignes
                                    const remainingRows = document.querySelectorAll('.history-row');
                                    if (remainingRows.length === 0) {
                                        // Recharger la page pour afficher l'état vide
                                        window.location.reload();
                                    }
                                }
                            }, 300);
                        } else {
                            // Si l'élément n'existe plus, recharger la page
                            window.location.reload();
                        }
                    } else {
                        // Afficher le message d'erreur du serveur
                        showErrorModal(data.message || 'Une erreur est survenue lors de la suppression');
                        if (deleteButton) {
                            deleteButton.disabled = false;
                            deleteButton.style.opacity = '1';
                        }
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    // Sauvegarder la référence avant de fermer le modal
                    const deleteButton = currentDeleteButton;
                    closeDeleteModal();
                    showErrorModal(error.message || 'Erreur lors de la suppression. Veuillez réessayer.');
                    if (deleteButton) {
                        deleteButton.disabled = false;
                        deleteButton.style.opacity = '1';
                    }
                })
                .finally(() => {
                    if (deleteModalConfirm) {
                        deleteModalConfirm.disabled = false;
                        deleteModalConfirm.innerHTML = '<i class="fas fa-trash"></i> Supprimer';
                    }
                });
                });
            }

            // Gestion de la suppression d'une commande
            const deleteButtons = document.querySelectorAll('.btn-icon-delete');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    const orderId = this.getAttribute('data-order-id');
                    const orderRow = this.closest('.history-row');
                    
                    if (!orderId) return;
                    
                    // Ouvrir le modal de confirmation
                    openDeleteModal(orderId, orderRow, this);
                });
            });
        })();

        // Graphique d'évolution des dépenses
        let spendingChart = null;
        
        // URL de l'API pour récupérer les données du graphique
        const chartDataApiUrl = '{{ path('api_profile_history_chart_data') }}';
        
        function initializeSpendingChart() {
            const ctx = document.getElementById('spendingChart');
            if (!ctx) return;
            
            const ctx2d = ctx.getContext('2d');
            
            // Récupérer les données depuis le template Twig
            const chartDataFromServer = {{ chartData|default({labels: [], data: []})|json_encode|raw }};
            const currentPeriod = {{ chartPeriod|default(6) }};
            
            const chartData = {
                labels: chartDataFromServer.labels || [],
                datasets: [{
                    label: 'Dépenses (MGA)',
                    data: chartDataFromServer.data || [],
                    borderColor: '#1F2D3D',
                    backgroundColor: 'rgba(31, 45, 61, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#1F2D3D',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4
                }]
            };

            // Calculer le maximum des dépenses pour l'axe Y
            const dataArray = chartData.datasets[0].data || [];
            const maxSpending = dataArray.length > 0 ? Math.max(...dataArray) : 0;
            // Ajouter 15% d'espace en haut pour une meilleure lisibilité
            const yAxisMax = maxSpending > 0 ? Math.ceil(maxSpending * 1.15) : 10000;
            
            console.log('Données du graphique:', dataArray);
            console.log('Maximum des dépenses:', maxSpending);
            console.log('Maximum de l\'axe Y (avec 15% d\'espace):', yAxisMax);
            console.log('Nombre de mois:', currentPeriod);

            spendingChart = new Chart(ctx2d, {
                type: 'line',
                data: chartData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#1F2D3D',
                            titleColor: '#ffffff',
                            bodyColor: '#ffffff',
                            borderColor: 'rgba(255, 255, 255, 0.1)',
                            borderWidth: 1,
                            callbacks: {
                                label: function(context) {
                                    return `Dépenses: ${context.parsed.y.toLocaleString('fr-FR')} MGA`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            suggestedMax: yAxisMax,
                            grid: {
                                color: 'rgba(31, 45, 61, 0.1)'
                            },
                            ticks: {
                                stepSize: Math.ceil(yAxisMax / 5 / 1000) * 1000,
                                callback: function(value) {
                                    return value.toLocaleString('fr-FR') + ' MGA';
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });

            // Changer la période du graphique dynamiquement
            const periodSelect = document.getElementById('chart-period');
            if (periodSelect) {
                // Définir la valeur actuelle du select
                periodSelect.value = currentPeriod.toString();
                
                // Ajouter l'event listener directement (pas besoin de cloner si on n'a qu'un seul listener)
                periodSelect.addEventListener('change', function(e) {
                    const newPeriod = parseInt(e.target.value, 10);
                    console.log('Changement de période détecté:', newPeriod);
                    
                    // Recharger la page avec le nouveau paramètre
                    const url = new URL(window.location.href);
                    url.searchParams.set('chart_period', newPeriod);
                    window.location.href = url.toString();
                });
            } else {
                console.error('Select chart-period non trouvé');
            }
        }

        // Fonction pour mettre à jour les données du graphique
        function updateChartData(period) {
            if (!spendingChart) {
                console.error('Graphique non initialisé');
                return;
            }
            
            // Afficher un indicateur de chargement
            const periodSelect = document.getElementById('chart-period');
            if (periodSelect) {
                periodSelect.disabled = true;
            }
            
            console.log('Mise à jour du graphique pour', period, 'mois');
            console.log('URL API:', chartDataApiUrl);
            
            // Récupérer les nouvelles données via l'API
            fetch(`${chartDataApiUrl}?period=${period}`, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin',
                cache: 'no-cache'
            })
                .then(response => {
                    console.log('Réponse reçue, status:', response.status);
                    if (!response.ok) {
                        if (response.status === 401) {
                            // Si 401, essayer de recharger la page pour rafraîchir la session
                            console.warn('Session expirée, rechargement de la page...');
                            window.location.reload();
                            // Lancer une erreur pour arrêter la chaîne de promesses
                            throw new Error('SESSION_EXPIRED');
                        }
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(result => {
                    // Vérifier que result existe (ne devrait pas arriver si 401 car on a lancé une erreur)
                    if (!result) {
                        console.error('Aucune donnée reçue');
                        return;
                    }
                    
                    console.log('Données reçues:', result);
                    if (result.status === 'success' && result.data) {
                        const chartData = result.data;
                        
                        // Mettre à jour les labels et les données
                        spendingChart.data.labels = chartData.labels || [];
                        spendingChart.data.datasets[0].data = chartData.data || [];
                        
                        // Calculer le nouveau maximum pour l'axe Y
                        const maxSpending = chartData.data && chartData.data.length > 0 
                            ? Math.max(...chartData.data) 
                            : 0;
                        const yAxisMax = maxSpending > 0 ? maxSpending * 1.15 : 10000;
                        
                        console.log('Max dépenses:', maxSpending, 'Y Axis Max:', yAxisMax);
                        console.log('Labels:', chartData.labels);
                        console.log('Data:', chartData.data);
                        
                        // Mettre à jour l'axe Y - recréer complètement les options pour forcer la mise à jour
                        spendingChart.options.scales.y = {
                            beginAtZero: true,
                            suggestedMax: yAxisMax,
                            grid: {
                                color: 'rgba(31, 45, 61, 0.1)'
                            },
                            ticks: {
                                stepSize: Math.ceil(yAxisMax / 5 / 1000) * 1000,
                                callback: function(value) {
                                    return value.toLocaleString('fr-FR') + ' MGA';
                                }
                            }
                        };
                        
                        // Mettre à jour le graphique avec animation désactivée pour un changement immédiat
                        spendingChart.update('none');
                        
                        // Mettre à jour l'URL sans recharger la page
                        const url = new URL(window.location.href);
                        url.searchParams.set('chart_period', period);
                        window.history.pushState({}, '', url.toString());
                        
                        console.log('Graphique mis à jour avec succès');
                    } else {
                        console.error('Erreur lors de la récupération des données:', result.message || 'Données invalides');
                        alert('Erreur lors de la récupération des données du graphique');
                    }
                })
                .catch(error => {
                    console.error('Erreur lors de la mise à jour du graphique:', error);
                    // Ne pas afficher d'alerte si c'est une erreur de session expirée car on recharge déjà la page
                    if (error.message === 'SESSION_EXPIRED') {
                        // La page va être rechargée, pas besoin de faire autre chose
                        return;
                    }
                    // Ne pas afficher d'alerte si c'est une erreur 401 car on recharge déjà la page
                    if (!error.message.includes('401') && !error.message.includes('connecté') && !error.message.includes('SESSION_EXPIRED')) {
                        alert('Erreur lors de la mise à jour du graphique: ' + error.message);
                    }
                })
                .finally(() => {
                    // Réactiver le select
                    if (periodSelect) {
                        periodSelect.disabled = false;
                    }
                });
        }

        // Initialiser le graphique une fois que le DOM est prêt
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                initializeSpendingChart();
            });
        } else {
            // DOM déjà chargé
            initializeSpendingChart();
        }
    </script>
{% endblock %}