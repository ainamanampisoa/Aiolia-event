{% extends 'base.html.twig' %}

{% block title %}Historique d’achat - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-history.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set orders = orders|default([]) %}
    {% set stats = stats|default({
        total_spent: '0 MGA',
        confirmed_orders: 0,
        total_tickets: 0,
        vip_tickets: 0,
        refunded_count: 0,
        refunded_amount: '0 MGA',
        average_cart: '0 MGA'
    }) %}

    <main class="profile-history-wrapper">
        <div class="container">
            <header class="profile-history-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>Historique d’achat</h1>
                    <p>Retrouvez toutes vos commandes passées, remboursements et reçus téléchargeables.</p>
                </div>
                <div class="profile-history-actions">
                    <button class="btn-outline"><i class="fas fa-file-download"></i> Exporter (PDF)</button>
                    <button class="btn-solid"><i class="fas fa-filter"></i> Filtrer</button>
                </div>
            </header>

            <section class="profile-history-summary wow fadeInUp" data-wow-delay="150ms">
                <div class="summary-card">
                    <span class="summary-label">Total dépensé</span>
                    <strong>{{ stats.total_spent }}</strong>
                    <small>{{ stats.confirmed_orders }} commande(s) confirmée(s)</small>
                </div>
                <div class="summary-card">
                    <span class="summary-label">Billets achetés</span>
                    <strong>{{ stats.total_tickets }} billet(s)</strong>
                    <small>{% if stats.vip_tickets > 0 %}Dont {{ stats.vip_tickets }} VIP{% else %}Aucun VIP{% endif %}</small>
                </div>
                <div class="summary-card">
                    <span class="summary-label">Remboursements</span>
                    <strong>{{ stats.refunded_count }} transaction(s)</strong>
                    <small>Montant total {{ stats.refunded_amount }}</small>
                </div>
            </section>

            <section class="profile-history-table wow fadeInUp" data-wow-delay="200ms">
                <div class="history-table-head">
                    <div class="history-search">
                        <i class="fas fa-search"></i>
                        <input type="search" placeholder="Rechercher une commande ou un évènement">
                    </div>
                    <div class="history-filters">
                        <button class="tag active">Tous</button>
                        <button class="tag">Confirmés</button>
                        <button class="tag">Remboursés</button>
                        <button class="tag">Annulés</button>
                    </div>
                </div>
                <div class="history-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Commande</th>
                                <th>Évènement</th>
                                <th>Date & heure</th>
                                <th>Billets</th>
                                <th>Montant</th>
                                <th>Paiement</th>
                                <th class="align-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if orders|length > 0 %}
                                {% for order in orders %}
                                    <tr class="history-row {% if order.status_key == 'confirmed' %}is-confirmed{% elseif order.status_key == 'refunded' %}is-refunded{% else %}is-cancelled{% endif %}">
                                        <td>
                                            <div class="order-code">{{ order.code }}</div>
                                            <span class="order-status">{{ order.status }}</span>
                                        </td>
                                        <td>
                                            <strong>{{ order.title }}</strong>
                                        </td>
                                        <td>
                                            <div>{{ order.date }}</div>
                                            <small>{{ order.hour }}</small>
                                        </td>
                                        <td>{{ order.tickets }} billet(s)</td>
                                        <td>{{ order.amount }}</td>
                                        <td>
                                            <i class="fas fa-credit-card"></i> {{ order.method }}
                                        </td>
                                        <td class="align-right">
                                            <button class="link-btn"><i class="fas fa-receipt"></i> Reçu</button>
                                            <button class="link-btn"><i class="fas fa-print"></i> Imprimer</button>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="7" style="text-align: center; padding: 40px;">
                                        <i class="fas fa-shopping-bag" style="font-size: 48px; color: #ccc; margin-bottom: 16px;"></i>
                                        <p style="color: #999;">Aucune commande trouvée</p>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
