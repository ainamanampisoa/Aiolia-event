{% extends 'base.html.twig' %}

{% block title %}{{ 'profile_favorites.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile-favorites.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set favorites = favorites|default([]) %}

    <main class="profile-favorites-wrapper">
        <div class="container">
            <header class="favorites-header wow fadeIn" data-wow-delay="100ms">
                <div>
                    <h1>{{ 'profile_favorites.header_title'|trans }}</h1>
                    <p>{{ 'profile_favorites.header_desc'|trans }}</p>
                </div>
                <a href="{{ path('events') }}" class="btn-discover"><i class="fas fa-compass"></i> {{ 'profile_favorites.discover_cta'|trans }}</a>
            </header>

            {% if favorites|length == 0 %}
                <section class="favorites-empty wow fadeInUp" data-wow-delay="150ms">
                    <i class="fas fa-heart"></i>
                    <h2>{{ 'profile_favorites.empty_title'|trans }}</h2>
                    <p>{{ 'profile_favorites.empty_desc'|trans }}</p>
                    <a href="{{ path('events') }}" class="btn-solid">{{ 'profile_favorites.empty_cta'|trans }}</a>
                </section>
            {% else %}
                <section class="favorites-grid">
                    {% for event in favorites %}
                        {# Debug: vérifier que l'événement est bien présent #}
                        {# {{ dump(event) }} #}
                        {% set imagePath = event.image
                            ? (event.image starts with 'http' ? event.image : asset(event.image|trim('/')))
                            : asset('vente-ticket/images/img1.png') %}
                        <article class="favorite-card wow fadeInUp" data-wow-delay="{{ loop.index * 80 }}ms">
                            <div class="favorite-cover">
                                <img src="{{ imagePath }}" alt="{{ event.title }}">
                                <button class="favorite-remove" data-event-id="{{ event.id }}" title="Retirer des favoris"><i class="fas fa-times"></i></button>
                            </div>
                            <div class="favorite-content">
                                <div class="favorite-badges">
                                    {% for badge in event.badges %}
                                        <span>{{ badge }}</span>
                                    {% endfor %}
                                </div>
                                <h2>{{ event.title }}</h2>
                                <div class="favorite-meta">
                                    <span><i class="fas fa-calendar-alt"></i> {{ event.date }}</span>
                                    <span><i class="fas fa-map-marker-alt"></i> {{ event.location }}</span>
                                </div>
                                <div class="favorite-status">
                                    <span class="status-dot"></span> {{ event.status }}
                                </div>
                                <div class="favorite-footer">
                                    <span class="favorite-price">{{ event.price }}</span>
                                    <div class="favorite-actions">
                                        <a href="{{ path('event_details', { id: event.id }) }}" class="btn-details"><i class="fas fa-info-circle"></i> {{ 'profile_favorites.btn_details'|trans }}</a>
                                        <button class="btn-notify"><i class="fas fa-bell"></i> {{ 'profile_favorites.btn_alert'|trans }}</button>
                                    </div>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </section>
            {% endif %}
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
<script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
<script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
<script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
<script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Gestion du retrait des favoris
        document.querySelectorAll('.favorite-remove').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const eventId = this.dataset.eventId;
                const card = this.closest('.favorite-card');
                
                if (!confirm('{{ 'profile_favorites.confirm_remove'|trans }}')) {
                    return;
                }
                
                // Animation de suppression
                card.style.transform = 'scale(0.8)';
                card.style.opacity = '0';
                
                // Appel API pour retirer des favoris
                fetch(`/events/${eventId}/favorite`, {
                    method: 'DELETE',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json',
                    },
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'success') {
                        // Supprimer la carte après l'animation
                        setTimeout(() => {
                            card.remove();
                            
                            // Vérifier s'il reste des favoris
                            const remainingFavorites = document.querySelectorAll('.favorite-card').length;
                            if (remainingFavorites === 0) {
                                location.reload(); // Recharger pour afficher le message "Aucun favori"
                            }
                        }, 300);
                    } else {
                        // Annuler l'animation en cas d'erreur
                        card.style.transform = 'scale(1)';
                        card.style.opacity = '1';
                        alert('{{ 'profile_favorites.error_remove_prefix'|trans }}: ' + (data.message || '{{ 'profile_favorites.error_unknown'|trans }}'));
                    }
                })
                .catch(error => {
                    console.error('Erreur lors du retrait des favoris:', error);
                    // Annuler l'animation en cas d'erreur
                    card.style.transform = 'scale(1)';
                    card.style.opacity = '1';
                    alert('{{ 'profile_favorites.error_remove_retry'|trans }}');
                });
            });
        });
    });
</script>
{% endblock %}
