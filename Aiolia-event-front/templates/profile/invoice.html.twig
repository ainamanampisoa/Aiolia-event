<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facture</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Arial', 'Helvetica', sans-serif;
            font-size: 11px;
            color: #2c3e50;
            background: #ffffff;
            padding: 15px;
            line-height: 1.4;
        }
        .invoice-container {
            max-width: 100%;
            margin: 0 auto;
            background: #ffffff;
            padding: 20px 25px;
        }
        .invoice-header {
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 2px solid #1F2D3D;
        }
        .invoice-main-title {
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            color: #1F2D3D;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 5px;
        }
        .invoice-number {
            text-align: center;
            font-size: 13px;
            font-weight: 600;
            color: #5a6c7d;
            margin-bottom: 12px;
        }
        .brand-block {
            text-align: center;
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid #e1e8ed;
        }
        .brand-name {
            font-size: 16px;
            font-weight: bold;
            color: #1F2D3D;
            letter-spacing: 0.5px;
        }
        .brand-subtitle {
            font-size: 9px;
            color: #7b8190;
            margin-top: 3px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .header-meta {
            margin-top: 12px;
            overflow: hidden;
            background: #f8f9fa;
            padding: 8px 12px;
            border-radius: 4px;
        }
        .meta-left,
        .meta-right {
            width: 50%;
            float: left;
            font-size: 10px;
            color: #555;
            line-height: 1.5;
        }
        .meta-right {
            text-align: right;
        }
        .header-label {
            font-weight: bold;
            color: #1F2D3D;
            margin-right: 4px;
        }
        .invoice-body {
            margin: 18px 0;
        }
        .section {
            margin-bottom: 15px;
            padding: 10px 12px;
            background: #fafbfc;
            border-radius: 4px;
            border-left: 3px solid #1F2D3D;
        }
        .section-title {
            font-size: 12px;
            font-weight: bold;
            color: #1F2D3D;
            margin-bottom: 8px;
            padding-bottom: 5px;
            border-bottom: 1px solid #e4e7f0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .section p {
            margin: 4px 0;
            color: #555;
            font-size: 11px;
        }
        .section p strong {
            color: #2c3e50;
            font-size: 11px;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            background: #ffffff;
        }
        .details-table th,
        .details-table td {
            padding: 8px 10px;
            text-align: left;
            border-bottom: 1px solid #e8ecef;
        }
        .details-table th {
            background: #1F2D3D;
            color: #ffffff;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: 0.5px;
        }
        .details-table td {
            color: #555;
            font-size: 11px;
        }
        .details-table tbody tr:hover {
            background: #f8f9fa;
        }
        .total-section {
            margin-top: 15px;
            text-align: right;
            background: #f8f9fa;
            padding: 12px 15px;
            border-radius: 4px;
        }
        .total-row {
            margin: 5px 0;
            padding: 4px 0;
            overflow: hidden;
        }
        .total-label {
            float: right;
            width: 140px;
            text-align: right;
            font-weight: 600;
            color: #555;
            margin-right: 12px;
            font-size: 11px;
        }
        .total-value {
            float: right;
            width: 120px;
            text-align: right;
            color: #2c3e50;
            font-size: 11px;
        }
        .total-final {
            font-size: 16px;
            font-weight: bold;
            padding-top: 8px;
            margin-top: 6px;
            border-top: 2px solid #1F2D3D;
        }
        .total-final .total-label {
            color: #1F2D3D;
            font-size: 14px;
        }
        .total-final .total-value {
            color: #1F2D3D;
            font-size: 16px;
        }
        .invoice-footer {
            margin-top: 20px;
            padding-top: 12px;
            border-top: 1px solid #e1e8ed;
            text-align: center;
            color: #7b8190;
            font-size: 9px;
            line-height: 1.6;
        }
        .invoice-footer p {
            margin: 3px 0;
        }
        @media print {
            body {
                padding: 10px;
                margin: 0;
            }
            .invoice-container {
                max-width: 100%;
                padding: 15px 20px;
                page-break-inside: avoid;
            }
            .invoice-header {
                page-break-after: avoid;
            }
            .section {
                page-break-inside: avoid;
            }
            .total-section {
                page-break-inside: avoid;
            }
            @page {
                margin: 1cm;
                size: A4 portrait;
            }
        }
    </style>
</head>
<body>
    {% set invoice_number = 'FAC-' ~ '%06d'|format(order.id) %}
    <div class="invoice-container">
        <div class="invoice-header">
            <div class="invoice-main-title">Facture</div>
            <div class="invoice-number">n° {{ invoice_number }}</div>
            <div class="header-meta">
                <div class="meta-left">
                    <span class="header-label">Date de paiement :</span><br>
                    {{ order.date|date('d/m/Y à H:i') }}
                </div>
                <div class="meta-right">
                    <span class="header-label">Statut :</span><br>
                    Payée
                </div>
                <div style="clear: both;"></div>
            </div>
            <div class="brand-block">
                <div class="brand-name">Aiolia Events</div>
                <div class="brand-subtitle">Billetterie en ligne</div>
            </div>
        </div>

        <div class="invoice-body">
            <div class="section">
                <div class="section-title">Informations client</div>
                <p style="margin-bottom: 5px;"><strong>{{ user.first_name|default('') }} {{ user.last_name|default('') }}</strong></p>
                <p>{{ user.email|default('') }}</p>
            </div>

            <div class="section">
                <div class="section-title">Détails de la commande</div>
                <table class="details-table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Quantité</th>
                            <th style="text-align: right;">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>{{ order.event_titles }}</td>
                            <td>{{ order.total_tickets }} billet(s)</td>
                            <td style="text-align: right;">{{ order.total_amount|number_format(0, ',', ' ') }} {{ order.currency }}</td>
                        </tr>
                        {% if order.discount_amount > 0 %}
                        <tr>
                            <td colspan="2">Remise{% if order.promotion_code %} ({{ order.promotion_code }}){% endif %}</td>
                            <td style="text-align: right;">-{{ order.discount_amount|number_format(0, ',', ' ') }} {{ order.currency }}</td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>

            <div class="total-section">
                <div class="total-row">
                    <div class="total-value">{{ (order.total_amount + order.discount_amount)|number_format(0, ',', ' ') }} {{ order.currency }}</div>
                    <div class="total-label">Sous-total :</div>
                    <div style="clear: both;"></div>
                </div>
                {% if order.discount_amount > 0 %}
                <div class="total-row">
                    <div class="total-value">-{{ order.discount_amount|number_format(0, ',', ' ') }} {{ order.currency }}</div>
                    <div class="total-label">Remise :</div>
                    <div style="clear: both;"></div>
                </div>
                {% endif %}
                <div class="total-row total-final">
                    <div class="total-value">{{ order.total_amount|number_format(0, ',', ' ') }} {{ order.currency }}</div>
                    <div class="total-label">Total TTC :</div>
                    <div style="clear: both;"></div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Méthode de paiement</div>
                <p>{{ order.payment_method }}</p>
            </div>
        </div>

        <div class="invoice-footer">
            <p>Merci pour votre achat !</p>
            <p>Cette facture a été générée automatiquement le {{ "now"|date('d/m/Y à H:i') }}</p>
        </div>
    </div>
</body>
</html>

