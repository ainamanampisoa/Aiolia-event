<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facture {{ order.code }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Arial', sans-serif;
            font-size: 12px;
            color: #333;
            background: #fff;
            padding: 20px;
        }
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
        }
        .invoice-header {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #1F2D3D;
            overflow: hidden;
        }
        .invoice-header-left {
            float: left;
        }
        .invoice-header-right {
            float: right;
            text-align: right;
        }
        .invoice-title {
            font-size: 28px;
            font-weight: bold;
            color: #1F2D3D;
        }
        .invoice-number {
            font-size: 14px;
            color: #666;
            margin-top: 5px;
        }
        .invoice-info {
            text-align: right;
        }
        .invoice-info p {
            margin: 3px 0;
            color: #666;
        }
        .invoice-body {
            margin: 30px 0;
        }
        .section {
            margin-bottom: 25px;
        }
        .section-title {
            font-size: 14px;
            font-weight: bold;
            color: #1F2D3D;
            margin-bottom: 10px;
            padding-bottom: 5px;
            border-bottom: 1px solid #eee;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        .details-table th,
        .details-table td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }
        .details-table th {
            background: #f8f9fa;
            font-weight: bold;
            color: #1F2D3D;
        }
        .details-table td {
            color: #666;
        }
        .total-section {
            margin-top: 20px;
            text-align: right;
        }
        .total-row {
            margin: 5px 0;
            padding: 5px 0;
            overflow: hidden;
        }
        .total-label {
            float: right;
            width: 150px;
            text-align: right;
            font-weight: bold;
            color: #1F2D3D;
            margin-right: 10px;
        }
        .total-value {
            float: right;
            width: 120px;
            text-align: right;
            color: #1F2D3D;
        }
        .total-final {
            font-size: 18px;
            font-weight: bold;
            padding-top: 10px;
            border-top: 2px solid #1F2D3D;
        }
        .invoice-footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #eee;
            text-align: center;
            color: #999;
            font-size: 10px;
        }
        @media print {
            body {
                padding: 0;
            }
            .invoice-container {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <div class="invoice-header">
            <div class="invoice-header-left">
                <div class="invoice-title">FACTURE</div>
                <div class="invoice-number">{{ order.code }}</div>
            </div>
            <div class="invoice-header-right invoice-info">
                <p><strong>Date d'émission :</strong> {{ order.date|date('d/m/Y à H:i') }}</p>
                <p><strong>Statut :</strong> Payée</p>
            </div>
            <div style="clear: both;"></div>
        </div>

        <div class="invoice-body">
            <div class="section">
                <div class="section-title">Informations client</div>
                <p><strong>{{ user.first_name|default('') }} {{ user.last_name|default('') }}</strong></p>
                <p>{{ user.email|default('') }}</p>
            </div>

            <div class="section">
                <div class="section-title">Détails de la commande</div>
                <table class="details-table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Quantité</th>
                            <th style="text-align: right;">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>{{ order.event_titles }}</td>
                            <td>{{ order.total_tickets }} billet(s)</td>
                            <td style="text-align: right;">{{ order.total_amount|number_format(0, ',', ' ') }} {{ order.currency }}</td>
                        </tr>
                        {% if order.discount_amount > 0 %}
                        <tr>
                            <td colspan="2">Remise{% if order.promotion_code %} ({{ order.promotion_code }}){% endif %}</td>
                            <td style="text-align: right;">-{{ order.discount_amount|number_format(0, ',', ' ') }} {{ order.currency }}</td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>

            <div class="total-section">
                <div class="total-row">
                    <div class="total-value">{{ (order.total_amount + order.discount_amount)|number_format(0, ',', ' ') }} {{ order.currency }}</div>
                    <div class="total-label">Sous-total :</div>
                    <div style="clear: both;"></div>
                </div>
                {% if order.discount_amount > 0 %}
                <div class="total-row">
                    <div class="total-value">-{{ order.discount_amount|number_format(0, ',', ' ') }} {{ order.currency }}</div>
                    <div class="total-label">Remise :</div>
                    <div style="clear: both;"></div>
                </div>
                {% endif %}
                <div class="total-row total-final">
                    <div class="total-value">{{ order.total_amount|number_format(0, ',', ' ') }} {{ order.currency }}</div>
                    <div class="total-label">Total TTC :</div>
                    <div style="clear: both;"></div>
                </div>
            </div>

            <div class="section">
                <div class="section-title">Méthode de paiement</div>
                <p>{{ order.payment_method }}</p>
            </div>
        </div>

        <div class="invoice-footer">
            <p>Merci pour votre achat !</p>
            <p>Cette facture a été générée automatiquement le {{ "now"|date('d/m/Y à H:i') }}</p>
        </div>
    </div>
</body>
</html>

