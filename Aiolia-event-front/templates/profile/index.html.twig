{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/profile.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set sessionUser = app.session.get('user') %}
    {% set userInfo = user|default({}) %}
    {% set displayName = userInfo.full_name|default(sessionUser.username|default('Utilisateur')) %}
    {% set displayMail = userInfo.email|default(sessionUser.email|default('')) %}
    {% set initial = (userInfo.first_name|default(displayName))|slice(0, 1)|upper %}
    {% set memberSince = (userInfo.created_at is defined and userInfo.created_at) ? userInfo.created_at|date('Y') : '2023' %}

    <main class="profile-wrapper">
        <div class="container">
            <div class="profile-grid">
                <aside class="profile-card wow fadeInLeft" data-wow-delay="150ms">
                    <div>
                        <div class="profile-avatar">{{ initial }}</div>
                        <h2 class="profile-name">{{ displayName }}</h2>
                        <div class="profile-email"><i class="fas fa-envelope"></i> {{ displayMail }}</div>
                    </div>
                    <div class="profile-tags">
                        {# <span class="profile-tag"><i class="fas fa-crown"></i> Membre premium</span> #}
                        <span class="profile-tag"><i class="fas fa-user-clock"></i> {{ 'profile.member_since'|trans({'{year}': memberSince})|raw }}</span>
                    </div>
                    <div class="profile-actions">
                        <a href="{{ path('profile_settings') }}" class="profile-action" style="text-decoration: none; color: inherit; display: flex; align-items: center; justify-content: space-between; width: 100%;">
                            <span><i class="fas fa-user-edit"></i> {{ 'profile.card_edit_profile'|trans }}</span>
                            <i class="fas fa-chevron-right"></i>
                        </a>
                        <a href="{{ path('profile_settings') }}#notifications" class="profile-action" style="text-decoration: none; color: inherit; display: flex; align-items: center; justify-content: space-between; width: 100%;">
                            <span><i class="fas fa-bell"></i> {{ 'profile.card_notifications_prefs'|trans }}</span>
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </div>
                </aside>

                <section class="profile-main wow fadeInRight" data-wow-delay="200ms">
                    <div class="profile-section">
                        <h3>{{ 'profile.overview_title'|trans }}</h3>
                        <div class="profile-stats">
                            <div class="profile-stat">
                                <span>{{ 'profile.stat_active_tickets'|trans }}</span>
                                <strong>{{ stats.active_tickets|default(0)|number_format(0, ',', ' ') }}</strong>
                            </div>
                            <div class="profile-stat">
                                <span>{{ 'profile.stat_favorite_events'|trans }}</span>
                                <strong>{{ stats.favorite_events|default(0)|number_format(0, ',', ' ') }}</strong>
                            </div>
                            <div class="profile-stat">
                                <span>{{ 'profile.stat_cart_items'|trans }}</span>
                                <strong>{{ stats.cart_items|default(0)|number_format(0, ',', ' ') }}</strong>
                            </div>
                            <div class="profile-stat">
                                <span>{{ 'profile.stat_loyalty_points'|trans }}</span>
                                <strong>{{ stats.loyalty_points|default(0)|number_format(0, ',', ' ') }}</strong>
                            </div>
                        </div>
                    </div>

                    <div class="profile-section">
                        <h3>{{ 'profile.recent_activity_title'|trans }}</h3>
                        <div class="profile-timeline">
                            {% if activities is defined and activities|length > 0 %}
                                {% for activity in activities %}
                                    <div class="profile-timeline-item">
                                        <div class="timeline-icon"><i class="{{ activity.icon }}"></i></div>
                                        <div class="timeline-content">
                                            <h4>{{ activity.title|raw }}</h4>
                                            <div class="timeline-meta">{{ activity.meta }}</div>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="profile-timeline-item">
                                    <div class="timeline-icon"><i class="fas fa-info-circle"></i></div>
                                    <div class="timeline-content">
                                        <h4>{{ 'profile.recent_activity_empty_title'|trans }}</h4>
                                        <div class="timeline-meta">{{ 'profile.recent_activity_empty_desc'|trans }}</div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="profile-section">
                        <h3>{{ 'profile.quick_access_title'|trans }}</h3>
                        <div class="profile-grid-secondary">
                            <a href="{{ path('my_tickets') }}" class="profile-card-link">
                                <i class="fas fa-layer-group"></i>
                                <strong>{{ 'profile.quick_access_my_tickets_title'|trans }}</strong>
                                <span>{{ 'profile.quick_access_my_tickets_desc'|trans }}</span>
                            </a>
                            <a href="{{ path('cart') }}" class="profile-card-link">
                                <i class="fas fa-shopping-bag"></i>
                                <strong>{{ 'profile.quick_access_cart_title'|trans }}</strong>
                                <span>{{ 'profile.quick_access_cart_desc'|trans }}</span>
                            </a>
                            <a href="{{ path('profile_history') }}" class="profile-card-link">
                                <i class="fas fa-history"></i>
                                <strong>{{ 'profile.quick_access_history_title'|trans }}</strong>
                                <span>{{ 'profile.quick_access_history_desc'|trans }}</span>
                            </a>
                            <a href="{{ path('profile_wallet') }}" class="profile-card-link">
                                <i class="fas fa-wallet"></i>
                                <strong>{{ 'profile.quick_access_wallet_title'|trans }}</strong>
                                <span>{{ 'profile.quick_access_wallet_desc'|trans }}</span>
                            </a>
                            <a href="{{ path('profile_favorites') }}" class="profile-card-link">
                                <i class="fas fa-star"></i>
                                <strong>{{ 'profile.quick_access_favorites_title'|trans }}</strong>
                                <span>{{ 'profile.quick_access_favorites_desc'|trans }}</span>
                            </a>
                            <a href="{{ path('profile_settings') }}" class="profile-card-link">
                                <i class="fas fa-cog"></i>
                                <strong>{{ 'profile.quick_access_settings_title'|trans }}</strong>
                                <span>{{ 'profile.quick_access_settings_desc'|trans }}</span>
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>
{% endblock %}
