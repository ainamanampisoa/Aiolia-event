{% extends 'base.html.twig' %}

{% block title %}Accueil - Vente tickets{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
{% endblock %}

{% block body %}
        {% set sessionUser = sessionUser ?? null %}
        {% set isAuthenticated = isAuthenticated ?? (sessionUser is iterable and sessionUser.id is defined) %}
        <main>

            <section class="sec-event">
                <div class="container">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">Evènements</h2>
                    <div class="lst-event">
                        {% if events is not empty %}
                            {% for event in events %}
                                {% set startsAt = event.starts_at %}
                                {% set imagePath = event.image_url
                                    ? (event.image_url starts with 'http' ? event.image_url : asset(event.image_url|trim('/')))
                                    : asset('vente-ticket/images/img1.png') %}
                                {% set event_url = isAuthenticated ? path('event_details', { id: event.id }) : path('login') %}
                                <div class="item wow fadeInUp" data-wow-delay="300ms">
                            <div class="inner">
                                <div class="blc-col1">
                                    <div class="col1">
                                        <div class="date">
                                                    {% if startsAt %}
                                                        <span>{{ startsAt|date('l')|capitalize }}</span>
                                                        <strong>{{ startsAt|date('d') }}</strong>
                                                        <span class="text-upper">{{ startsAt|date('M Y')|upper }}</span>
                                                    {% else %}
                                                        <span>À venir</span>
                                                    {% endif %}
                                                </div>
                                                <div class="hour">
                                                    {% if startsAt %}
                                                        à {{ startsAt|date('H\\hi') }}
                                                    {% else %}
                                                        Horaire à confirmer
                                                    {% endif %}
                                                </div>
                                                <div class="code-barre">
                                                    <img src="{{ asset('vente-ticket/images/code1.png') }}" alt="Code barre">
                                        </div>
                                    </div>
                                    <div class="col2">
                                                <span class="bandeau">
                                                    {{ event.category_label is not empty ? event.category_label : 'Événement' }}
                                                </span>
                                                <h3>{{ event.title }}</h3>
                                                {% if event.venue_name or event.city %}
                                                    <div class="adresse">
                                                        Lieu :
                                                        {% if event.venue_name %}
                                                            {{ event.venue_name }}
                                                        {% endif %}
                                                        {% if event.city %}
                                                            {% if event.venue_name %}, {% endif %}
                                                            {{ event.city }}
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                                <div class="tarif">
                                                    {% if event.min_price is not null %}
                                                        {% if event.max_price is not null and event.max_price > event.min_price %}
                                                            Tarifs : {{ event.min_price|number_format(0, '.', ' ') }} MGA - {{ event.max_price|number_format(0, '.', ' ') }} MGA
                                                        {% else %}
                                                            Tarif : {{ event.min_price|number_format(0, '.', ' ') }} MGA
                                                        {% endif %}
                                                    {% else %}
                                                        Tarifs : non communiqué
                                                    {% endif %}
                                                </div>
                                                <div class="blcBtn">
                                                    <a href="{{ event_url }}" class="btn ticket">Acheter un ticket</a>
                                                    <a href="{{ event_url }}" class="btn details">détails</a>
                                                </div>
                                    </div>
                                    
                                </div>
                                <div class="blc-col2">
                                    <div class="img">
                                                <img src="{{ imagePath }}" alt="{{ event.title }}">
                                                    </div>
                                                </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p class="text-center">Aucun événement disponible pour le moment.</p>
                        {% endif %}
                    </div>
                    <div class="pagination">
                        <ul>
                            <li class="prev"><a href="#"></a></li>
                            <li class="selected"><a href="#">1</a></li>
                            <li><a href="#">2</a></li>
                            <li><a href="#">3</a></li>
                            <li><a href="#">4</a></li>
                            <li class="next"><a href="#"></a></li>
                        </ul>
                    </div>

                    <div class="blcBtn-bot text-center">
                        <a href="#" class="btn" title="Voir tous les évènements">voir tous les évènements</a>
                    </div>
                </div>
            </section>

            <section class="sec-bandeau">
                <div class="container">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">Comment acheter votre ticket ?</h2>
                    <div class="lst-step d-flex justify-content-center wow fadeInUp" data-wow-delay="300ms">
                        <div class="item">
                            <div class="inner">
                                <div class="ico"><img src="{{ asset('vente-ticket/images/ico1.svg') }}"></div>
                                <h3><strong>01</strong> Réservez vos billets</h3>
                                <p>Choisissez l’événement et le nombre de places souhaitées directement en ligne.</p>
                            </div>
                        </div>
                        <div class="item">
                            <div class="inner">
                                <div class="ico"><img src="{{ asset('vente-ticket/images/ico2.svg') }}"></div>
                                <h3><strong>02</strong> Confirmez la réservation</h3>
                                <p>Remplissez vos informations et vérifiez les détails avant validation.</p>
                            </div>
                        </div>
                        <div class="item">
                            <div class="inner">
                                <div class="ico"><img src="{{ asset('vente-ticket/images/ico3.svg') }}"></div>
                                <h3><strong>03</strong> Choisissez le mode de paiement</h3>
                                <p>Paiement sécurisé par mobile money ou sur place.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="sec-calendar">
                <div class="container">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">Calendrier des évènements</h2>
                    <div class="txt wow fadeInUp" data-wow-delay="400ms">
                        <p>Consultez la liste de nos prochains événements et ne manquez aucun rendez-vous à venir.</p>
                    </div>

                    <div class="calendar wow fadeInUp" data-wow-delay="400ms">
                        <div class="col">
                            <div class="blcLeft">
                                <div class="blc-datepicker">
                                    <div id="datepicker"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="blcRight">
                                <h3>Prochains évènements</h3>
                                <div class="lst-pro-event">
                                    {% if events is not empty %}
                                        {% for event in events|slice(0, 4) %}
                                            {% set startsAt = event.starts_at %}
                                            {% set event_url = isAuthenticated ? path('event_details', { id: event.id }) : path('login') %}
                                    <div class="item">
                                        <div class="inner d-flex justify-content-between align-items-center">
                                            <div class="left">
                                                        <h4>{{ event.title }}</h4>
                                                        {% if startsAt %}
                                                            <span class="date">{{ startsAt|date('d F Y') }}</span>
                                                        {% endif %}
                                            </div>
                                            <div class="right">
                                                <div class="hour">
                                                            {% if startsAt %}
                                                                {{ startsAt|date('H\\hi') }}
                                                            {% endif %}
                                                </div>
                                                        <a href="{{ event_url }}" class="link"></a>
                                            </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-center">Aucun événement à afficher pour le moment.</p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="sec-bandeau-v2">
                <div class="container text-center wow fadeIn" data-wow-delay="300ms">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">Vous êtes un organisateur ?</h2>
                    <div class="s-titre">Publiez vos événements et touchez un large public en quelques clics.</div>
                    <p>Inscrivez-vous pour promouvoir vos concerts, festivals, conférences ou spectacles. Gagnez en visibilité et gérez facilement vos réservations en ligne.</p>
                    <h4>Je souhaite créer un évènement</h4>
                    <div class="blcBtn d-flex justify-content-center">
                        <a href="#" class="btn" title="S'inscrire">S'inscrire</a>
                        <a href="#" class="btn btn-secondary" title="Déjà inscrit">Déjà inscrit</a>
                    </div>
                </div>
            </section>


            <section class="sec-texte">
                <div class="container d-flex">
                    <div class="left wow fadeInLeft" data-wow-delay="300ms">
                        <h2>À propos</h2>
                        <p>Notre plateforme simplifie la découverte, la création et la gestion d’événements. Que vous soyez spectateur ou organisateur, profitez d’un espace unique pour partager, réserver et vivre pleinement chaque expérience.</p>
                        <a href="{{ path('about') }}" class="btn plus" title="Lire plus">lire plus</a>
                    </div>

                    <div class="right wow fadeInRight" data-wow-delay="300ms">
                       <div class="lstAtout d-flex" id="counter" >
                           <div class="item">
                               <div class="inner">
                                   <div class="ico">
                                       <img src="{{ asset('vente-ticket/images/ico4.svg') }}">
                                   </div>
                                    <strong class="count percent" data-count="{{ stats.total_events ?? 0 }}">{{ (stats.total_events ?? 0)|number_format(0, '.', ' ') }}</strong>
                                    <span>Evènements <br>crées</span>
                               </div>
                           </div>
                           <div class="item">
                               <div class="inner">
                                   <div class="ico">
                                       <img src="{{ asset('vente-ticket/images/ico5.svg') }}">
                                   </div>
                                    <strong class="count percent" data-count="{{ stats.tickets_sold ?? 0 }}">{{ (stats.tickets_sold ?? 0)|number_format(0, '.', ' ') }}</strong>
                                    <span>Tickets <br>vendus</span>
                               </div>
                           </div>
                           <div class="item">
                               <div class="inner">
                                   <div class="ico">
                                       <img src="{{ asset('vente-ticket/images/ico6.svg') }}">
                                   </div>
                                    <strong class="count percent" data-count="{{ stats.organizers ?? 0 }}">{{ (stats.organizers ?? 0)|number_format(0, '.', ' ') }}</strong>
                                    <span>Organisateurs <br>inscrits</span>
                               </div>
                           </div>

                       </div>
                    </div>
                </div>
            </section>

        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        {% set calendar_events = [] %}
        {% for event in events %}
            {% if event.starts_at %}
                {% set calendar_events = calendar_events|merge([{
                    'date': event.starts_at|date('Y-m-d'),
                    'title': event.title
                }]) %}
            {% endif %}
        {% endfor %}
        <script>
            window.AIOLIA_EVENT_DATES = {{ calendar_events|json_encode|raw }};
        </script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
{% endblock %}
