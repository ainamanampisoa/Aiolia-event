{% extends 'base.html.twig' %}

{% block title %}{{ 'home.page_title'|trans }}{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/events.css') }}">
{% endblock %}

{% block body %}
        {% set sessionUser = sessionUser ?? null %}
        {% set isAuthenticated = isAuthenticated ?? (sessionUser is iterable and sessionUser.id is defined) %}
        <main>

            <section class="sec-event">
                <div class="container">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">{{ 'home.events_title'|trans }}</h2>
                    <div class="lst-event">
                        {% if events is not empty %}
                            {% for event in events %}
                                {% set startsAt = event.starts_at %}
                                {% set imagePath = event.image_url
                                    ? (event.image_url starts with 'http' ? event.image_url : asset(event.image_url|trim('/')))
                                    : asset('vente-ticket/images/img1.png') %}
                                {% set event_url = isAuthenticated ? path('event_details', { id: event.id }) : path('login') %}
                                <div class="item wow fadeInUp" data-wow-delay="300ms">
                            <div class="inner">
                                {% if isAuthenticated %}
                                <button class="favorite-toggle {% if event.isFavorite is defined and event.isFavorite %}is-active{% endif %}" type="button" data-event-id="{{ event.id }}" title="{{ 'events.add_to_favorites'|trans }}">
                                    <i class="fas fa-heart"></i>
                                </button>
                                {% endif %}
                                <div class="blc-col1">
                                    <div class="col1">
                                        <div class="date">
                                                    {% if startsAt %}
                                                        <span>{{ startsAt|date('l')|capitalize }}</span>
                                                        <strong>{{ startsAt|date('d') }}</strong>
                                                        <span class="text-upper">{{ startsAt|date('M Y')|upper }}</span>
                                                    {% else %}
                                                        <span>{{ 'tickets.filter_upcoming'|trans }}</span>
                                                    {% endif %}
                                                </div>
                                                <div class="hour">
                                                    {% if startsAt %}
                                                        à {{ startsAt|date('H\\hi') }}
                                                    {% else %}
                                                        Horaire à confirmer
                                                    {% endif %}
                                                </div>

                                    </div>
                                    <div class="col2">
                                                <span class="bandeau">
                                                    {{ event.category_label is not empty ? event.category_label : 'events.default_category'|trans }}
                                                </span>
                                                <h3>{{ event.title }}</h3>
                                                {% set location_parts = [] %}
                                                {% if event.venue_name %}
                                                    {% set location_parts = location_parts|merge([event.venue_name]) %}
                                                {% endif %}
                                                {% if event.city %}
                                                    {% set location_parts = location_parts|merge([event.city]) %}
                                                {% endif %}
                                                {% if event.region %}
                                                    {% set location_parts = location_parts|merge([event.region]) %}
                                                {% endif %}
                                                {% if event.country_code %}
                                                    {% set location_parts = location_parts|merge([event.country_code]) %}
                                                {% endif %}
                                                {% if location_parts is not empty %}
                                                    <div class="adresse">
                                                        {{ 'events.location_prefix'|trans }} {{ location_parts|join(', ') }}
                                                    </div>
                                                {% endif %}
                                                <div class="tarif">
                                                    {% if event.min_price is not null %}
                                                        {% if event.max_price is not null and event.max_price > event.min_price %}
                                                            {{ 'events.price_range'|trans({
                                                                '{min}': event.min_price|number_format(0, '.', ' '),
                                                                '{max}': event.max_price|number_format(0, '.', ' ')
                                                            })|raw }}
                                                        {% else %}
                                                            {{ 'events.price_single'|trans({
                                                                '{price}': event.min_price|number_format(0, '.', ' ')
                                                            })|raw }}
                                                        {% endif %}
                                                    {% else %}
                                                        {{ 'events.price_not_set'|trans }}
                                                    {% endif %}
                                                </div>
                                                <div class="blcBtn">
                                                    <a href="{{ event_url }}" class="btn ticket">{{ 'events.buy_ticket'|trans }}</a>
                                                    <a href="{{ event_url }}" class="btn details">{{ 'events.details'|trans }}</a>
                                                </div>
                                    </div>
                                    
                                </div>
                                <div class="blc-col2">
                                    <div class="img">
                                                <img src="{{ imagePath }}" alt="{{ event.title }}">
                                                    </div>
                                                </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p class="text-center">{{ 'home.no_events'|trans }}</p>
                        {% endif %}
                    </div>
                    <div class="pagination">
                        <ul>
                            <li class="prev"><a href="#"></a></li>
                            <li class="selected"><a href="#">1</a></li>
                            <li><a href="#">2</a></li>
                            <li><a href="#">3</a></li>
                            <li><a href="#">4</a></li>
                            <li class="next"><a href="#"></a></li>
                        </ul>
                    </div>

                    <div class="blcBtn-bot text-center">
                        <a href="#" class="btn" title="{{ 'home.see_all_events'|trans }}">{{ 'home.see_all_events'|trans }}</a>
                    </div>
                </div>
            </section>

            <section class="sec-bandeau">
                <div class="container">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">{{ 'home.how_to_buy_title'|trans }}</h2>
                    <div class="lst-step d-flex justify-content-center wow fadeInUp" data-wow-delay="300ms">
                        <div class="item">
                            <div class="inner">
                                <div class="ico"><img src="{{ asset('vente-ticket/images/ico1.svg') }}"></div>
                                <h3>{{ 'home.how_to_buy_step1_title'|trans }}</h3>
                                <p>{{ 'home.how_to_buy_step1_desc'|trans }}</p>
                            </div>
                        </div>
                        <div class="item">
                            <div class="inner">
                                <div class="ico"><img src="{{ asset('vente-ticket/images/ico2.svg') }}"></div>
                                <h3>{{ 'home.how_to_buy_step2_title'|trans }}</h3>
                                <p>{{ 'home.how_to_buy_step2_desc'|trans }}</p>
                            </div>
                        </div>
                        <div class="item">
                            <div class="inner">
                                <div class="ico"><img src="{{ asset('vente-ticket/images/ico3.svg') }}"></div>
                                <h3>{{ 'home.how_to_buy_step3_title'|trans }}</h3>
                                <p>{{ 'home.how_to_buy_step3_desc'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="sec-calendar">
                <div class="container">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">{{ 'home.calendar_title'|trans }}</h2>
                    <div class="txt wow fadeInUp" data-wow-delay="400ms">
                        <p>{{ 'home.calendar_desc'|trans }}</p>
                    </div>

                    <div class="calendar wow fadeInUp" data-wow-delay="400ms">
                        <div class="col">
                            <div class="blcLeft">
                                <div class="blc-datepicker">
                                    <div id="datepicker"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="blcRight">
                                <h3>{{ 'home.upcoming_events'|trans }}</h3>
                                <div class="lst-pro-event">
                                    {% if events is not empty %}
                                        {% for event in events|slice(0, 4) %}
                                            {% set startsAt = event.starts_at %}
                                            {% set event_url = isAuthenticated ? path('event_details', { id: event.id }) : path('login') %}
                                    <div class="item">
                                        <div class="inner d-flex justify-content-between align-items-center">
                                            <div class="left">
                                                        <h4>{{ event.title }}</h4>
                                                        {% if startsAt %}
                                                            <span class="date">{{ startsAt|date('d F Y') }}</span>
                                                        {% endif %}
                                            </div>
                                            <div class="right">
                                                <div class="hour">
                                                            {% if startsAt %}
                                                                {{ startsAt|date('H\\hi') }}
                                                            {% endif %}
                                                </div>
                                                        <a href="{{ event_url }}" class="link"></a>
                                            </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-center">{{ 'events.calendar_no_events'|trans }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="sec-bandeau-v2">
                <div class="container text-center wow fadeIn" data-wow-delay="300ms">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">{{ 'home.organizer_banner_title'|trans }}</h2>
                    <div class="s-titre">{{ 'home.organizer_banner_subtitle'|trans }}</div>
                    <p>{{ 'home.organizer_banner_desc'|trans }}</p>
                    <h4>{{ 'home.organizer_banner_cta_title'|trans }}</h4>
                    <div class="blcBtn d-flex justify-content-center">
                        <a href="#" class="btn" title="{{ 'home.organizer_banner_cta_signup'|trans }}">{{ 'home.organizer_banner_cta_signup'|trans }}</a>
                        <a href="#" class="btn btn-secondary" title="{{ 'home.organizer_banner_cta_already'|trans }}">{{ 'home.organizer_banner_cta_already'|trans }}</a>
                    </div>
                </div>
            </section>


            <section class="sec-texte">
                <div class="container d-flex">
                    <div class="left wow fadeInLeft" data-wow-delay="300ms">
                        <h2>{{ 'home.about_title'|trans }}</h2>
                        <p>{{ 'home.about_desc'|trans }}</p>
                        <a href="{{ path('about') }}" class="btn plus" title="{{ 'home.about_read_more'|trans }}">{{ 'home.about_read_more'|trans }}</a>
                    </div>

                    <div class="right wow fadeInRight" data-wow-delay="300ms">
                       <div class="lstAtout d-flex" id="counter" >
                           <div class="item">
                               <div class="inner">
                                   <div class="ico">
                                       <img src="{{ asset('vente-ticket/images/ico4.svg') }}">
                                   </div>
                                    <strong class="count percent" data-count="{{ stats.total_events ?? 0 }}">{{ (stats.total_events ?? 0)|number_format(0, '.', ' ') }}</strong>
                                    <span>{{ 'home.stats_events'|trans|raw }}</span>
                               </div>
                           </div>
                           <div class="item">
                               <div class="inner">
                                   <div class="ico">
                                       <img src="{{ asset('vente-ticket/images/ico5.svg') }}">
                                   </div>
                                    <strong class="count percent" data-count="{{ stats.tickets_sold ?? 0 }}">{{ (stats.tickets_sold ?? 0)|number_format(0, '.', ' ') }}</strong>
                                    <span>{{ 'home.stats_tickets'|trans|raw }}</span>
                               </div>
                           </div>
                           <div class="item">
                               <div class="inner">
                                   <div class="ico">
                                       <img src="{{ asset('vente-ticket/images/ico6.svg') }}">
                                   </div>
                                    <strong class="count percent" data-count="{{ stats.organizers ?? 0 }}">{{ (stats.organizers ?? 0)|number_format(0, '.', ' ') }}</strong>
                                    <span>{{ 'home.stats_organizers'|trans|raw }}</span>
                               </div>
                           </div>

                       </div>
                    </div>
                </div>
            </section>

        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        {% set calendar_events = [] %}
        {% for event in events %}
            {% if event.starts_at %}
                {% set calendar_events = calendar_events|merge([{
                    'date': event.starts_at|date('Y-m-d'),
                    'title': event.title
                }]) %}
            {% endif %}
        {% endfor %}
        <script>
            window.AIOLIA_EVENT_DATES = {{ calendar_events|json_encode|raw }};
        </script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Gestion des favoris
                document.querySelectorAll('.favorite-toggle').forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const eventId = this.dataset.eventId;
                        const isActive = this.classList.contains('is-active');
                        
                        // Toggle visuel immédiat
                        this.classList.toggle('is-active');
                        this.setAttribute('aria-pressed', this.classList.contains('is-active'));
                        
                        // Appel API pour ajouter/retirer des favoris
                        const method = isActive ? 'DELETE' : 'POST';
                        const url = `/events/${eventId}/favorite`;
                        
                        fetch(url, {
                            method: method,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/json',
                            },
                        })
                        .then(response => {
                            // Vérifier si la réponse est OK
                            if (!response.ok) {
                                throw new Error(`HTTP error! status: ${response.status}`);
                            }
                            // Vérifier si la réponse est du JSON
                            const contentType = response.headers.get('content-type');
                            if (!contentType || !contentType.includes('application/json')) {
                                throw new Error('Response is not JSON');
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (data.status !== 'success') {
                                // En cas d'erreur, annuler le toggle visuel
                                this.classList.toggle('is-active');
                                this.setAttribute('aria-pressed', this.classList.contains('is-active'));
                                console.error('Erreur lors de la mise à jour des favoris:', data.message || 'Erreur inconnue');
                                alert('Erreur: ' + (data.message || 'Impossible de mettre à jour les favoris'));
                            } else {
                                console.log('Favori mis à jour avec succès:', data.message);
                                // Le cœur reste dans l'état actuel (rouge si ajouté, normal si retiré)
                            }
                        })
                        .catch(error => {
                            // En cas d'erreur, annuler le toggle visuel
                            this.classList.toggle('is-active');
                            this.setAttribute('aria-pressed', this.classList.contains('is-active'));
                            console.error('Erreur lors de la mise à jour des favoris:', error);
                            alert('Erreur lors de la mise à jour des favoris. Veuillez réessayer.');
                        });
                    });
                });
            });
        </script>
{% endblock %}
