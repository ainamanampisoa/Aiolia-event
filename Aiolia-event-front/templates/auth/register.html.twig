{% extends 'base.html.twig' %}

{% block title %}{{ 'tickets.create_account_title'|trans }}{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
{% endblock %}

{% block body %}
        <main>
            <section class="sec-login pt-100 pb-100">
                <div class="container">
                    <h2 class="text-center">{{ 'tickets.create_account'|trans }}</h2>
                    <div class="blc-login bg-beige">
                        {% if errors is defined and errors %}
                            <div class="msg-error alert-auto-dismiss">
                                <ul>
                                    {% for error in errors %}
                                        <li>{{ error }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                        <form method="post" action="{{ path('register') }}">
                            <div class="blc-chp">
                                <label>{{ 'tickets.first_name_label'|trans }}</label>
                                <input type="text" name="first_name" class="form-control" value="{{ form_data.first_name|default('') }}" required>
                            </div>
                            <div class="blc-chp">
                                <label>{{ 'tickets.last_name_label'|trans }}</label>
                                <input type="text" name="last_name" class="form-control" value="{{ form_data.last_name|default('') }}" required>
                            </div>
                            <div class="blc-chp">
                                <label>{{ 'tickets.email_label_register'|trans }}</label>
                                <input type="email" name="email" class="form-control" value="{{ form_data.email|default('') }}" required>
                            </div>
                            <div class="blc-chp">
                                <label>{{ 'tickets.phone_label'|trans }}</label>
                                <div class="blc-phone-prefix">
                                    <span class="prefix">
                                        <img src="{{ asset('vente-ticket/images/mdg.png') }}" alt="Flag Madagascar" class="flag-icon">
                                        +261
                                    </span>
                                    <input type="text" name="phone" class="form-control" value="{{ form_data.phone|default('') }}" placeholder="320000000">
                                </div>
                            </div>
                            <div class="blc-chp">
                                <label>{{ 'tickets.password_label'|trans }}</label>
                                <div class="blc-password">
                                    <input type="password" name="password" class="form-control" placeholder="****" required>
                                    <span class="material-symbols-rounded pointer toggle-password"></span>
                                </div>
                            </div>
                            <div class="blc-chp">
                                <label>{{ 'tickets.confirm_password'|trans }}</label>
                                <div class="blc-password">
                                    <input type="password" name="password_confirmation" class="form-control" placeholder="****" required>
                                    <span class="material-symbols-rounded pointer toggle-password"></span>
                                </div>
                            </div>
                            <div class="blc-btn text-center">
                                <input type="submit" class="btn-submit check" value="{{ 'tickets.create_my_account'|trans }}">
                                <a href="{{ path('login') }}" class="link-form">{{ 'tickets.already_have_account'|trans }}</a>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
{% endblock %}
