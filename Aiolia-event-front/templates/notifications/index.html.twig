{% extends 'base.html.twig' %}

{% block title %}Notifications - Vente tickets{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/notifications.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set notifications = notifications|default([]) %}
    {% set unreadCount = unreadCount|default(0) %}

    <main class="notifications-wrapper">
        <div class="container">
            <div class="notifications-panel">
                <div class="notifications-header">
                    <div>
                        <h2>Mes notifications</h2>
                        <p>Retrouvez vos alertes, rappels et confirmations liées à vos évènements.</p>
                    </div>
                    <div class="notifications-actions">
                        <button class="btn-outline" data-action="mark-read"><i class="fas fa-check"></i> Tout marquer comme lu</button>
                        <button class="btn-solid" data-action="settings"><i class="fas fa-sliders-h"></i> Préférences</button>
                    </div>
                </div>

                <div class="notifications-tabs">
                    <button class="notifications-tab active" data-filter="all">Tous <span class="notifications-counter">{{ notifications|length }}</span></button>
                    <button class="notifications-tab" data-filter="unread">Non lus <span class="notifications-counter">{{ unreadCount }}</span></button>
                    <button class="notifications-tab" data-filter="read">Archives <span class="notifications-counter">{{ notifications|filter(n => n.read)|length }}</span></button>
                </div>

                {% set hasNotifications = notifications|length > 0 %}
                {% if hasNotifications %}
                    <ul class="notifications-list">
                        {% for notification in notifications %}
                            <li class="notification-item {% if not notification.read %}is-unread{% endif %}" data-state="{{ notification.read ? 'read' : 'unread' }}">
                                <div class="notification-icon">
                                    {% if notification.type == 'ticket' %}
                                        <i class="fas fa-ticket-alt"></i>
                                    {% elseif notification.type == 'offer' %}
                                        <i class="fas fa-gift"></i>
                                    {% elseif notification.type == 'reminder' %}
                                        <i class="fas fa-clock"></i>
                                    {% else %}
                                        <i class="fas fa-receipt"></i>
                                    {% endif %}
                                </div>
                                <div class="notification-content">
                                    <h3 class="notification-title">{{ notification.title|raw }}</h3>
                                    <div class="notification-meta">
                                        <span><i class="fas fa-calendar-check"></i> {{ notification.date }}</span>
                                        <span><i class="fas fa-hourglass-half"></i> {{ notification.time }}</span>
                                    </div>
                                    <p>{{ notification.description }}</p>
                                    <div class="notification-actions">
                                        {% if not notification.read %}
                                            <button data-action="mark-single" data-id="{{ notification.id }}">Marquer comme lu</button>
                                        {% endif %}
                                        <button data-action="view" data-id="{{ notification.id }}">Voir le détail</button>
                                        <button data-action="archive" data-id="{{ notification.id }}">Archiver</button>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="notifications-empty">
                        <i class="fas fa-bell-slash"></i>
                        <h3>Aucune notification pour le moment</h3>
                        <p>Les nouvelles activités apparaîtront ici : validation de panier, billets disponibles, rappels d'évènements...</p>
                        <a href="{{ path('events') }}" class="btn-solid">Explorer les évènements</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = document.querySelectorAll('.notifications-tab');
            const items = document.querySelectorAll('.notification-item');

            // Filtrage par onglets
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    const filter = tab.dataset.filter;

                    items.forEach(item => {
                        const state = item.dataset.state;
                        if (filter === 'all') {
                            item.style.display = 'flex';
                        } else if (filter === 'unread') {
                            item.style.display = state === 'unread' ? 'flex' : 'none';
                        } else {
                            item.style.display = state === 'read' ? 'flex' : 'none';
                        }
                    });
                });
            });

            // Marquer une notification comme lue
            document.querySelectorAll('[data-action="mark-single"]').forEach(button => {
                button.addEventListener('click', function() {
                    const notificationId = this.dataset.id;
                    const item = this.closest('.notification-item');
                    
                    if (!item || !notificationId) return;

                    fetch(`/api/notifications/${notificationId}/read`, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json',
                        },
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'success') {
                            item.dataset.state = 'read';
                            item.classList.remove('is-unread');
                            this.remove();
                            
                            // Mettre à jour les compteurs
                            updateCounters();
                        } else {
                            alert('Erreur: ' + (data.message || 'Erreur inconnue'));
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        alert('Erreur lors du marquage comme lu. Veuillez réessayer.');
                    });
                });
            });

            // Marquer toutes les notifications comme lues
            const markAll = document.querySelector('[data-action="mark-read"]');
            if (markAll) {
                markAll.addEventListener('click', () => {
                    fetch('/api/notifications/read-all', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json',
                        },
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'success') {
                            items.forEach(item => {
                                item.dataset.state = 'read';
                                item.classList.remove('is-unread');
                                const singleButton = item.querySelector('[data-action="mark-single"]');
                                if (singleButton) {
                                    singleButton.remove();
                                }
                            });
                            
                            // Mettre à jour les compteurs
                            updateCounters();
                        } else {
                            alert('Erreur: ' + (data.message || 'Erreur inconnue'));
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        alert('Erreur lors du marquage. Veuillez réessayer.');
                    });
                });
            }

            // Supprimer/Archiver une notification
            document.querySelectorAll('[data-action="archive"]').forEach(button => {
                button.addEventListener('click', function() {
                    const notificationId = this.dataset.id;
                    const item = this.closest('.notification-item');
                    
                    if (!item || !notificationId) return;

                    if (!confirm('Voulez-vous supprimer cette notification ?')) {
                        return;
                    }

                    // Animation de suppression
                    item.style.transform = 'scale(0.95)';
                    item.style.opacity = '0.5';

                    fetch(`/api/notifications/${notificationId}/delete`, {
                        method: 'DELETE',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json',
                        },
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'success') {
                            setTimeout(() => {
                                item.remove();
                                
                                // Vérifier s'il reste des notifications
                                const remainingItems = document.querySelectorAll('.notification-item').length;
                                if (remainingItems === 0) {
                                    location.reload();
                                }
                                
                                // Mettre à jour les compteurs
                                updateCounters();
                            }, 300);
                        } else {
                            // Annuler l'animation en cas d'erreur
                            item.style.transform = 'scale(1)';
                            item.style.opacity = '1';
                            alert('Erreur: ' + (data.message || 'Erreur inconnue'));
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        // Annuler l'animation en cas d'erreur
                        item.style.transform = 'scale(1)';
                        item.style.opacity = '1';
                        alert('Erreur lors de la suppression. Veuillez réessayer.');
                    });
                });
            });

            // Redirection vers les paramètres
            const settingsBtn = document.querySelector('[data-action="settings"]');
            if (settingsBtn) {
                settingsBtn.addEventListener('click', () => {
                    window.location.href = '{{ path("profile_settings") }}';
                });
            }

            // Fonction pour mettre à jour les compteurs
            function updateCounters() {
                fetch('/api/notifications/count')
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'success') {
                            // Mettre à jour le compteur dans l'onglet "Non lus"
                            const unreadTab = document.querySelector('[data-filter="unread"] .notifications-counter');
                            if (unreadTab) {
                                unreadTab.textContent = data.count;
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Erreur lors de la mise à jour des compteurs:', error);
                    });
            }
        });
    </script>
{% endblock %}
