{% extends 'base.html.twig' %}

{% block title %}{{ 'notifications.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/notifications.css') }}">
{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
    {% set notifications = notifications|default([]) %}
    {% set unreadCount = unreadCount|default(0) %}

    <main class="notifications-wrapper">
        <div class="container">
            <div class="notifications-panel">
                <div class="notifications-header">
                    <div>
                        <h2>{{ 'notifications.header_title'|trans }}</h2>
                        <p>{{ 'notifications.header_desc'|trans }}</p>
                    </div>
                    <div class="notifications-actions">
                        <button class="btn-outline" data-action="mark-read"><i class="fas fa-check"></i> {{ 'notifications.mark_all_read'|trans }}</button>
                        <button class="btn-solid" data-action="settings"><i class="fas fa-sliders-h"></i> {{ 'notifications.preferences'|trans }}</button>
                    </div>
                </div>

                <div class="notifications-tabs">
                    <button class="notifications-tab active" data-filter="all">{{ 'notifications.tab_all'|trans }} <span class="notifications-counter">{{ notifications|length }}</span></button>
                    <button class="notifications-tab" data-filter="unread">{{ 'notifications.tab_unread'|trans }} <span class="notifications-counter">{{ unreadCount }}</span></button>
                    <button class="notifications-tab" data-filter="read">{{ 'notifications.tab_read'|trans }} <span class="notifications-counter">{{ notifications|filter(n => n.read)|length }}</span></button>
                </div>

                {% set hasNotifications = notifications|length > 0 %}
                {% if hasNotifications %}
                    <ul class="notifications-list">
                        {% for notification in notifications %}
                            <li class="notification-item {% if not notification.read %}is-unread{% endif %}" data-state="{{ notification.read ? 'read' : 'unread' }}">
                                <div class="notification-icon">
                                    {% if notification.type == 'ticket' %}
                                        <i class="fas fa-ticket-alt"></i>
                                    {% elseif notification.type == 'offer' %}
                                        <i class="fas fa-gift"></i>
                                    {% elseif notification.type == 'reminder' %}
                                        <i class="fas fa-clock"></i>
                                    {% else %}
                                        <i class="fas fa-receipt"></i>
                                    {% endif %}
                                </div>
                                <div class="notification-content">
                                    <h3 class="notification-title">{{ notification.title|raw }}</h3>
                                    <div class="notification-meta">
                                        <span><i class="fas fa-calendar-check"></i> {{ notification.date }}</span>
                                        <span><i class="fas fa-hourglass-half"></i> {{ notification.time }}</span>
                                    </div>
                                    <p>{{ notification.description }}</p>
                                    <div class="notification-actions">
                                        {% if not notification.read %}
                                            <button data-action="mark-single" data-id="{{ notification.id }}">{{ 'notifications.btn_mark_single'|trans }}</button>
                                        {% endif %}
                                        {% if notification.event_id is defined and notification.event_id %}
                                            <button data-action="view" data-id="{{ notification.id }}" data-event-id="{{ notification.event_id }}">{{ 'notifications.btn_view'|trans }}</button>
                                        {% else %}
                                            <button data-action="view" data-id="{{ notification.id }}">{{ 'notifications.btn_view'|trans }}</button>
                                        {% endif %}
                                        <button data-action="archive" data-id="{{ notification.id }}">{{ 'notifications.btn_archive'|trans }}</button>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                        <div class="notifications-empty">
                            <i class="fas fa-bell-slash"></i>
                            <h3>{{ 'notifications.empty_title'|trans }}</h3>
                            <p>{{ 'notifications.empty_desc'|trans }}</p>
                            <a href="{{ path('events') }}" class="btn-solid">{{ 'notifications.empty_cta'|trans }}</a>
                        </div>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = document.querySelectorAll('.notifications-tab');
            const items = document.querySelectorAll('.notification-item');

            // Filtrage par onglets
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    const filter = tab.dataset.filter;

                    items.forEach(item => {
                        const state = item.dataset.state;
                        if (filter === 'all') {
                            item.style.display = 'flex';
                        } else if (filter === 'unread') {
                            item.style.display = state === 'unread' ? 'flex' : 'none';
                        } else {
                            item.style.display = state === 'read' ? 'flex' : 'none';
                        }
                    });
                });
            });

            // Marquer une notification comme lue
            document.querySelectorAll('[data-action="mark-single"]').forEach(button => {
                button.addEventListener('click', function() {
                    const notificationId = this.dataset.id;
                    const item = this.closest('.notification-item');
                    
                    if (!item || !notificationId) return;

                    fetch(`/api/notifications/${notificationId}/read`, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                        },
                        credentials: 'same-origin',
                    })
                    .then(response => {
                        const contentType = response.headers.get('content-type');
                        if (!contentType || !contentType.includes('application/json')) {
                            throw new Error('Réponse invalide du serveur');
                        }
                        if (!response.ok) {
                            return response.json().then(data => {
                                throw new Error(data.message || 'Erreur HTTP ' + response.status);
                            });
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.status === 'success') {
                            item.dataset.state = 'read';
                            item.classList.remove('is-unread');
                            this.remove();
                            
                            // Mettre à jour les compteurs
                            updateCounters();
                            
                            // Mettre à jour le badge dans le header
                            if (typeof window.updateNotificationBadge === 'function') {
                                window.updateNotificationBadge();
                            }
                        } else {
                            alert('{{ 'notifications.error_prefix'|trans }}: ' + (data.message || '{{ 'notifications.error_unknown'|trans }}'));
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        alert('{{ 'notifications.error_mark_read'|trans }}');
                    });
                });
            });

            // Marquer toutes les notifications comme lues
            const markAll = document.querySelector('[data-action="mark-read"]');
            if (markAll) {
                markAll.addEventListener('click', () => {
                    // Désactiver le bouton pendant le traitement
                    markAll.disabled = true;
                    markAll.textContent = 'Traitement...';
                    
                    fetch('/api/notifications/read-all', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                        },
                        credentials: 'same-origin',
                    })
                    .then(response => {
                        // Vérifier le type de contenu avant de parser
                        const contentType = response.headers.get('content-type');
                        const isJson = contentType && contentType.includes('application/json');
                        
                        if (!response.ok) {
                            if (isJson) {
                                return response.json().then(data => {
                                    throw new Error(data.message || 'Erreur HTTP ' + response.status);
                                });
                            } else {
                                // Si ce n'est pas du JSON, c'est probablement une page d'erreur HTML
                                throw new Error('Erreur serveur. Veuillez réessayer.');
                            }
                        }
                        
                        if (!isJson) {
                            throw new Error('Réponse invalide du serveur');
                        }
                        
                        return response.json();
                    })
                    .then(data => {
                        if (data.status === 'success') {
                            items.forEach(item => {
                                item.dataset.state = 'read';
                                item.classList.remove('is-unread');
                                const singleButton = item.querySelector('[data-action="mark-single"]');
                                if (singleButton) {
                                    singleButton.remove();
                                }
                            });
                            
                            // Mettre à jour les compteurs
                            updateCounters();
                            
                            // Mettre à jour le badge dans le header
                            if (typeof window.updateNotificationBadge === 'function') {
                                window.updateNotificationBadge();
                            }
                        } else {
                            alert('{{ 'notifications.error_prefix'|trans }}: ' + (data.message || '{{ 'notifications.error_unknown'|trans }}'));
                        }
                    })
                    .catch(error => {
                        console.error('Erreur lors du marquage de toutes les notifications:', error);
                        alert('{{ 'notifications.error_prefix'|trans }}: ' + (error.message || '{{ 'notifications.error_mark_all'|trans }}'));
                    })
                    .finally(() => {
                        // Réactiver le bouton
                        markAll.disabled = false;
                        markAll.innerHTML = '<i class="fas fa-check"></i> {{ 'notifications.mark_all_read'|trans }}';
                    });
                });
            }

            // Supprimer/Archiver une notification
            document.querySelectorAll('[data-action="archive"]').forEach(button => {
                button.addEventListener('click', function() {
                    const notificationId = this.dataset.id;
                    const item = this.closest('.notification-item');
                    
                    if (!item || !notificationId) return;

                    if (!confirm('{{ 'notifications.confirm_delete'|trans }}')) {
                        return;
                    }

                    // Animation de suppression
                    item.style.transform = 'scale(0.95)';
                    item.style.opacity = '0.5';

                    fetch(`/api/notifications/${notificationId}/delete`, {
                        method: 'DELETE',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                        },
                        credentials: 'same-origin',
                    })
                    .then(response => {
                        const contentType = response.headers.get('content-type');
                        if (!contentType || !contentType.includes('application/json')) {
                            throw new Error('Réponse invalide du serveur');
                        }
                        if (!response.ok) {
                            return response.json().then(data => {
                                throw new Error(data.message || 'Erreur HTTP ' + response.status);
                            });
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.status === 'success') {
                            setTimeout(() => {
                                item.remove();
                                
                                // Vérifier s'il reste des notifications
                                const remainingItems = document.querySelectorAll('.notification-item').length;
                                if (remainingItems === 0) {
                                    location.reload();
                                }
                                
                                // Mettre à jour les compteurs
                                updateCounters();
                                
                                // Mettre à jour le badge dans le header
                                if (typeof window.updateNotificationBadge === 'function') {
                                    window.updateNotificationBadge();
                                }
                            }, 300);
                        } else {
                            // Annuler l'animation en cas d'erreur
                            item.style.transform = 'scale(1)';
                            item.style.opacity = '1';
                            alert('{{ 'notifications.error_prefix'|trans }}: ' + (data.message || '{{ 'notifications.error_unknown'|trans }}'));
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        // Annuler l'animation en cas d'erreur
                        item.style.transform = 'scale(1)';
                        item.style.opacity = '1';
                        alert('{{ 'notifications.error_delete'|trans }}');
                    });
                });
            });

            // Redirection vers les paramètres
            const settingsBtn = document.querySelector('[data-action="settings"]');
            if (settingsBtn) {
                settingsBtn.addEventListener('click', () => {
                    window.location.href = '{{ path("profile_settings") }}';
                });
            }

            // Gérer le bouton "Voir" pour rediriger vers l'événement ou la page de notifications
            document.querySelectorAll('[data-action="view"]').forEach(button => {
                button.addEventListener('click', function() {
                    const notificationId = this.dataset.id;
                    const eventId = this.dataset.eventId;
                    const item = this.closest('.notification-item');
                    
                    // Marquer comme lu si ce n'est pas déjà fait
                    if (item && item.classList.contains('is-unread')) {
                        fetch(`/api/notifications/${notificationId}/read`, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/json',
                            },
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.status === 'success') {
                                item.dataset.state = 'read';
                                item.classList.remove('is-unread');
                                const markButton = item.querySelector('[data-action="mark-single"]');
                                if (markButton) {
                                    markButton.remove();
                                }
                                updateCounters();
                            }
                        })
                        .catch(error => {
                            console.error('Erreur:', error);
                        });
                    }
                    
                    // Rediriger vers l'événement ou rester sur la page
                    if (eventId) {
                        // Rediriger vers la page de l'événement (utiliser la route Symfony)
                        window.location.href = `{{ path('event_details', {'id': '__EVENT_ID__'}) }}`.replace('__EVENT_ID__', eventId);
                    } else {
                        // Si pas d'événement, juste scroller vers la notification
                        if (item) {
                            item.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                });
            });

            // Fonction pour mettre à jour les compteurs
            function updateCounters() {
                fetch('/api/notifications/count', {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json',
                    },
                    credentials: 'same-origin',
                })
                    .then(response => {
                        const contentType = response.headers.get('content-type');
                        if (!contentType || !contentType.includes('application/json')) {
                            return null;
                        }
                        if (!response.ok) {
                            return null;
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (!data) {
                            return;
                        }
                        if (data.status === 'success') {
                            const count = data.count || 0;
                            
                            // Mettre à jour le compteur dans l'onglet "Non lus"
                            const unreadTab = document.querySelector('[data-filter="unread"] .notifications-counter');
                            if (unreadTab) {
                                unreadTab.textContent = count;
                            }
                            
                            // Mettre à jour le badge dans le header (si la fonction existe)
                            if (typeof window.updateNotificationBadge === 'function') {
                                window.updateNotificationBadge();
                            } else {
                                // Mettre à jour directement le badge avec la même logique que le panier
                                const badge = document.getElementById('notification-badge');
                                if (badge) {
                                    const currentText = badge.textContent.trim();
                                    const isCurrentlyVisible = badge.style.display !== 'none' && badge.offsetParent !== null;
                                    
                                    if (count > 0) {
                                        // Afficher le badge uniquement s'il y a des notifications non lues
                                        const formattedCount = count > 99 ? '99+' : count.toString();
                                        if (currentText !== formattedCount) {
                                            badge.textContent = formattedCount;
                                        }
                                        if (!isCurrentlyVisible) {
                                            badge.style.display = 'flex';
                                            badge.style.visibility = 'visible';
                                            badge.style.opacity = '1';
                                        }
                                    } else {
                                        // Cacher complètement le badge quand il n'y a pas de notifications
                                        badge.textContent = '';
                                        if (isCurrentlyVisible) {
                                            badge.style.opacity = '0';
                                            setTimeout(() => {
                                                badge.style.display = 'none';
                                                badge.style.visibility = 'hidden';
                                            }, 150);
                                        } else {
                                            badge.style.display = 'none';
                                            badge.style.visibility = 'hidden';
                                        }
                                    }
                                }
                            }
                            
                            // Mettre à jour le compteur dans l'onglet "Tous"
                            const allTab = document.querySelector('[data-filter="all"] .notifications-counter');
                            if (allTab) {
                                const allItems = document.querySelectorAll('.notification-item').length;
                                allTab.textContent = allItems;
                            }
                            
                            // Mettre à jour le compteur dans l'onglet "Lus"
                            const readTab = document.querySelector('[data-filter="read"] .notifications-counter');
                            if (readTab) {
                                const readItems = document.querySelectorAll('.notification-item[data-state="read"]').length;
                                readTab.textContent = readItems;
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Erreur lors de la mise à jour des compteurs:', error);
                    });
            }
            
            // Mettre à jour les compteurs toutes les 5 secondes sur cette page
            setInterval(updateCounters, 5000);
        });
    </script>
{% endblock %}
