{% extends 'base.html.twig' %}

{% block title %}{{ 'about.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
{% endblock %}

{% block body %}
<main>
    <section class="sec-apropos">
        <div class="container">
            <div class="modular-texte">
                <div class="col blc-left">
                    <div class="texte">
                        <h2>{{ 'about.title'|trans }}</h2>
                        <p>{{ 'about.description'|trans|raw }}</p>

                        <p>{{ 'about.description_2'|trans|raw }}</p>

                        <div class="espace"></div>

                        <h3>{{ 'about.mission_title'|trans }}</h3>
                        <p>{{ 'about.mission_text'|trans|raw }}</p>
                    </div>
                </div>

                <div class="col blc-right">
                    <div class="img">
                        <img src="{{ asset('vente-ticket/images/img-apropos.jpg') }}" alt="À propos de Aiolia-event">
                    </div>
                    <div class="lstAtout d-flex" id="counter">
                        <div class="item">
                            <div class="inner">
                                <div class="ico">
                                    <img src="{{ asset('vente-ticket/images/ico4.svg') }}" alt="">
                                </div>
                                <strong class="count percent" data-count="4893">4893</strong>
                                <span>{{ 'home.stats_events'|trans|raw }}</span>
                            </div>
                        </div>
                        <div class="item">
                            <div class="inner">
                                <div class="ico">
                                    <img src="{{ asset('vente-ticket/images/ico5.svg') }}" alt="">
                                </div>
                                <strong class="count percent" data-count="85360">85360</strong>
                                <span>{{ 'home.stats_tickets'|trans|raw }}</span>
                            </div>
                        </div>
                        <div class="item">
                            <div class="inner">
                                <div class="ico">
                                    <img src="{{ asset('vente-ticket/images/ico6.svg') }}" alt="">
                                </div>
                                <strong class="count percent" data-count="2320">2320</strong>
                                <span>{{ 'home.stats_organizers'|trans|raw }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
    <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
{% endblock %}
