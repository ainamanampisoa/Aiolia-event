            width: auto;
            height: 18px;
            padding: 0 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: bold;
            line-height: 1;
            box-sizing: border-box;
            transition: opacity 0.15s ease;
            font-variant-numeric: tabular-nums;
            letter-spacing: 0;
            will-change: opacity;
            backface-visibility: hidden;
            text-align: center;
        }
        
        .panier span:empty {
            min-width: 20px;
        }

        @media (max-width: 992px) {
            header .head .container {
                gap: 12px;
            }

            .head-bottom {
                gap: 12px;
                justify-content: center;
            }

            .head-guest {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
            }

            .head-guest .guest-nav {
                flex-wrap: wrap;
                justify-content: space-between;
            }

            .user-connected-search {
                width: 100%;
            }

            .user-connected-link,
            .user-connected-menu {
                width: 30px;
                height: 30px;
                font-size: 13px;
            }

            .icon-notifications, .icon-profile, .icon-menu {
                width: 16px;
                height: 16px;
            }

            .panier a {
                width: 30px;
                height: 30px;
            }

            .panier a::before {
                width: 16px;
                height: 16px;
            }
        }
    </style>
</head>
<body>
        {% set currentUser = app.session.get('user') %}
        {% set isAuthenticated = currentUser is not null %}
        {% set profileName = 'common.profile'|trans %}
        {% if isAuthenticated and currentUser.username is defined and currentUser.username %}
            {% set profileName = currentUser.username %}
        {% elseif isAuthenticated and currentUser.email is defined and currentUser.email %}
            {% set profileName = currentUser.email %}
        {% endif %}
        <header>
            <div class="head">
                <div class="container">
