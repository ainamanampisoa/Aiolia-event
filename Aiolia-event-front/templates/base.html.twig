    {# Gestion du panier avec LocalStorage #}
    <script>
        // ============================================
        // Gestion du panier dans LocalStorage
        // ============================================
        const CartStorage = {
            STORAGE_KEY: 'aiolia_cart_items',
            
            /**
             * Récupère les items du panier depuis LocalStorage
             * @returns {Object} Objet avec les items du panier
             */
            getItems: function() {
                try {
                    const stored = localStorage.getItem(this.STORAGE_KEY);
                    return stored ? JSON.parse(stored) : {};
                } catch (e) {
                    console.error('Erreur lors de la lecture du panier depuis LocalStorage:', e);
                    return {};
                }
            },
            
            /**
             * Sauvegarde les items du panier dans LocalStorage
             * @param {Object} items - Items du panier à sauvegarder
             */
            saveItems: function(items) {
                try {
                    localStorage.setItem(this.STORAGE_KEY, JSON.stringify(items));
                    // Déclencher un événement pour informer les autres composants
                    document.dispatchEvent(new CustomEvent('cartUpdated', { 
                        detail: { count: Object.keys(items).length, source: 'localStorage' }
                    }));
                } catch (e) {
                    console.error('Erreur lors de la sauvegarde du panier dans LocalStorage:', e);
                }
            },
            
            /**
             * Ajoute ou met à jour un item dans le panier
             * @param {string} cartKey - Clé unique de l'item (ex: 'event_123')
             * @param {Object} item - Données de l'item
             */
            addItem: function(cartKey, item) {
                const items = this.getItems();
                items[cartKey] = item;
                this.saveItems(items);
            },
            
            /**
             * Supprime un item du panier
             * @param {string} cartKey - Clé unique de l'item à supprimer
             */
            removeItem: function(cartKey) {
                const items = this.getItems();
                delete items[cartKey];
                this.saveItems(items);
            },
            
            /**
             * Vide le panier
             */
            clear: function() {
                try {
                    localStorage.removeItem(this.STORAGE_KEY);
                    document.dispatchEvent(new CustomEvent('cartUpdated', { 
                        detail: { count: 0, source: 'localStorage' }
                    }));
                } catch (e) {
                    console.error('Erreur lors de la suppression du panier:', e);
                }
            },
            
            /**
             * Récupère le nombre d'items dans le panier
             * @returns {number} Nombre d'items
             */
            getCount: function() {
                return Object.keys(this.getItems()).length;
            },
            
            /**
             * Synchronise le panier avec le serveur
             * @param {Function} callback - Callback appelé après la synchronisation
             */
            syncWithServer: function(callback) {
                const items = this.getItems();
                const syncUrl = '{{ path("api_tickets_cart_sync") }}';
                
                fetch(syncUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                    body: JSON.stringify({ items: items }),
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'success') {
                        // Mettre à jour LocalStorage avec les items fusionnés depuis le serveur
                        // Le serveur retourne les items formatés, on doit les convertir
                        if (data.items && Array.isArray(data.items)) {
                            // Si le serveur retourne les items formatés, on doit récupérer les items bruts
                            // Pour l'instant, on garde les items de LocalStorage
                            console.log('Panier synchronisé avec succès', data);
                        }
                        if (callback) callback(data);
                    }
                })
                .catch(error => {
                    console.error('Erreur lors de la synchronisation du panier:', error);
                    if (callback) callback({ status: 'error', error: error });
                });
            },
            
            /**
             * Charge le panier depuis le serveur et fusionne avec LocalStorage
             * @param {Function} callback - Callback appelé après le chargement
             */
            loadFromServer: function(callback) {
                const loadUrl = '{{ path("api_tickets_cart_load") }}';
                
                fetch(loadUrl, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'success') {
                        // Fusionner avec les items de LocalStorage
                        const localItems = this.getItems();
                        const serverItems = {}; // Convertir data.items en format session si nécessaire
                        
                        // Pour l'instant, on garde les items de LocalStorage en priorité
                        // Le serveur a déjà fusionné lors du chargement
                        if (callback) callback(data);
                    }
                })
                .catch(error => {
                    console.error('Erreur lors du chargement du panier:', error);
                    if (callback) callback({ status: 'error', error: error });
                });
            }
        };
        
        // ============================================
        // Fonction globale pour mettre à jour le badge du panier
        // ============================================
        // Fonction globale pour mettre à jour le badge du panier
        // Cette fonction peut être appelée depuis n'importe quelle page
        function updateCartBadge(count) {
            const cartBadge = document.getElementById('cart-badge');
            if (!cartBadge) return;
            
            // Si un count est fourni, l'utiliser directement
            // Sinon, compter depuis LocalStorage, DOM ou API
            if (typeof count === 'undefined' || count === null) {
                // D'abord, essayer de compter dans le DOM (page du panier)
                const cartCards = document.querySelectorAll('.cart-card');
                if (cartCards.length > 0 || window.location.pathname.includes('/cart')) {
                    count = cartCards.length;
                } else {
                    // Sinon, utiliser LocalStorage pour un affichage immédiat
                    count = CartStorage.getCount();
                    // Mettre à jour le cache
                    lastCartCount = count;
                    lastCartCountTime = Date.now();
                }
            }
            
            // Vérifier si le count a changé avant de mettre à jour
            // Comparer les valeurs formatées pour éviter les mises à jour inutiles
            const formattedCount = count > 0 ? count.toString().padStart(2, '0') : '00';
            const currentText = cartBadge.textContent.trim();
            if (currentText !== formattedCount) {
                displayCartBadge(count);
            }
        }
        
        function displayCartBadge(count) {
            const cartBadge = document.getElementById('cart-badge');
            if (!cartBadge) {
                console.warn('Cart badge element not found');
                return;
            }
            
            count = parseInt(count) || 0;
            
            // Formater avec 2 chiffres (01, 02, 10, etc.)
            const formattedCount = count > 0 ? count.toString().padStart(2, '0') : '00';
            
            // Ne mettre à jour que si le count a changé pour éviter les flashs
            const currentText = cartBadge.textContent.trim();
            const isCurrentlyVisible = cartBadge.style.display !== 'none' && cartBadge.offsetParent !== null;
            
            if (count > 0) {
                // Mettre à jour le texte seulement si nécessaire
                if (currentText !== formattedCount) {
                    // Mettre à jour directement sans transition pour éviter les flashs
                    cartBadge.textContent = formattedCount;
                }
                // Forcer l'affichage du badge même s'il était initialement caché
                if (!isCurrentlyVisible) {
                    cartBadge.style.display = 'flex';
                    cartBadge.style.visibility = 'visible';
                    cartBadge.style.opacity = '1';
                }
            } else {
                // Cacher le badge seulement s'il est actuellement visible
                if (isCurrentlyVisible) {
                    cartBadge.style.opacity = '0';
                    setTimeout(() => {
                        cartBadge.style.display = 'none';
                    }, 150);
                }
            }
        }
        
        // Cache pour éviter les rechargements inutiles
        let lastCartCount = null;
        let lastCartCountTime = 0;
        const CART_COUNT_CACHE_DURATION = 2000; // 2 secondes
        
        // Mettre à jour le badge au chargement de la page
        document.addEventListener('DOMContentLoaded', function() {
            {% set just_logged_in = app.session.get('just_logged_in', false) %}
            {% if isAuthenticated %}
            // Fonction pour charger et afficher le compteur de notifications
            function updateNotificationBadge(count) {
                const badge = document.getElementById('notification-badge');
                if (!badge) return;
                
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count.toString();
                    badge.style.display = 'flex';
                } else {
                    badge.style.display = 'none';
                }
            }
            
            function loadNotificationCount() {
                fetch('/api/notifications/count', {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                })
                .then(response => response.json())
                .then(data => {
                    if (data && data.status === 'success') {
                        updateNotificationBadge(data.count || 0);
                    }
                })
                .catch(error => {
                    console.error('Erreur lors du chargement du compteur de notifications:', error);
                });
            }
            
            // Charger le compteur de notifications au chargement de la page
            loadNotificationCount();
            
            // Recharger le compteur toutes les 30 secondes
            setInterval(loadNotificationCount, 30000);
            
            // Fonction pour charger et afficher le count du panier
            function loadAndDisplayCartCount(force = false) {
                // Vérifier le cache pour éviter les requêtes inutiles
                const now = Date.now();
                if (!force && lastCartCount !== null && (now - lastCartCountTime) < CART_COUNT_CACHE_DURATION) {
                    // Utiliser le count en cache
                    displayCartBadge(lastCartCount);
                    return;
                }
                
                fetch('{{ path("api_tickets_cart_count") }}', {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                })
                .then(response => {
                    // Vérifier si la réponse est OK
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    // Vérifier si la réponse est du JSON
                    const contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        throw new Error('Response is not JSON');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data && data.status === 'success') {
                        const count = data.count || 0;
                        // Mettre en cache le count
                        lastCartCount = count;
                        lastCartCountTime = Date.now();
                        // Mettre à jour le badge seulement si le count a changé
                        updateCartBadge(count);
                    }
                })
                .catch(error => {
                    console.error('Erreur lors du chargement du count:', error);
                    // En cas d'erreur, utiliser LocalStorage comme fallback
                    const localCount = CartStorage.getCount();
                    if (localCount > 0) {
                        displayCartBadge(localCount);
                    }
                });
            }
            
            {% if just_logged_in %}
            // L'utilisateur vient de se connecter - synchroniser d'abord, puis charger le count
            console.log('User just logged in, syncing cart...');
            const localItems = CartStorage.getItems();
            
            if (Object.keys(localItems).length > 0) {
                // Envoyer le panier LocalStorage au serveur pour fusion
                fetch('{{ path("api_tickets_cart_sync") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                    body: JSON.stringify({
                        items: localItems
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'success') {
                        console.log('Cart synced successfully');
                        // Charger le panier fusionné depuis le serveur
                        return fetch('{{ path("api_tickets_cart_load") }}', {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                            }
                        });
                    }
                    return null;
                })
                .then(response => {
                    if (response) {
                        return response.json();
                    }
                    return null;
                })
                .then(data => {
                    if (data && data.status === 'success') {
                        console.log('Cart loaded from server:', data);
                        // Mettre à jour LocalStorage avec les données du serveur si disponible
                        if (data.items) {
                            CartStorage.saveItems(data.items);
                        }
                        // Mettre à jour le badge avec le count final
                        updateCartBadge(data.count || 0);
                    } else {
                        // Si le chargement échoue, charger le count directement
                        loadAndDisplayCartCount();
                    }
                })
                .catch(error => {
                    console.error('Erreur lors de la synchronisation du panier après connexion:', error);
                    // En cas d'erreur, charger le count directement
                    loadAndDisplayCartCount();
                });
            } else {
                // Pas d'items dans LocalStorage, charger depuis le serveur
                console.log('No local items, loading from server...');
                CartStorage.loadFromServer(function(data) {
                    if (data.status === 'success') {
                        console.log('Cart loaded from server:', data);
                        updateCartBadge(data.count || 0);
                    } else {
                        // Si le chargement échoue, charger le count directement
                        loadAndDisplayCartCount();
                    }
                });
            }
            
            // Toujours charger le count après un court délai pour s'assurer que la synchronisation est terminée
            setTimeout(function() {
                loadAndDisplayCartCount();
            }, 500);
            {% else %}
            // Comportement normal pour utilisateur connecté
            // D'abord, afficher le count depuis LocalStorage pour un affichage immédiat
            const localCount = CartStorage.getCount();
            if (localCount > 0) {
                displayCartBadge(localCount);
                lastCartCount = localCount;
                lastCartCountTime = Date.now();
            }
            
            // Charger le count depuis le serveur en arrière-plan (avec cache)
            loadAndDisplayCartCount();
            
            // Synchroniser en arrière-plan si nécessaire
            const localItems = CartStorage.getItems();
            if (Object.keys(localItems).length > 0) {
                // Synchroniser LocalStorage avec le serveur en arrière-plan
                CartStorage.syncWithServer(function(data) {
                    if (data.status === 'success') {
                        // Recharger le count après synchronisation (forcer le rechargement)
                        loadAndDisplayCartCount(true);
                    }
                });
            }
            {% endif %}
            {% else %}
            // Utilisateur non connecté - utiliser LocalStorage uniquement
            const localCount = CartStorage.getCount();
            if (localCount > 0) {
                displayCartBadge(localCount);
            }
            {% endif %}
        });
        
        // Écouter les événements de mise à jour du panier
        document.addEventListener('cartUpdated', function(event) {
            if (event.detail && typeof event.detail.count !== 'undefined') {
                updateCartBadge(event.detail.count);
            } else {
                // Compter depuis LocalStorage
                const count = CartStorage.getCount();
                updateCartBadge(count);
            }
        });
    </script>

    {% if isAuthenticated %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const menuButton = document.querySelector('.user-connected-menu');
            const sidebar = document.getElementById('userSecondarySidebar');
            const overlay = document.getElementById('userSidebarOverlay');
            const closeButton = sidebar ? sidebar.querySelector('.user-sidebar-close') : null;

            if (!menuButton || !sidebar || !overlay) {
                return;
            }

            const openSidebar = () => {
                sidebar.classList.add('is-open');
                overlay.classList.add('is-open');
                sidebar.setAttribute('aria-hidden', 'false');
                menuButton.setAttribute('aria-expanded', 'true');
            };

            const closeSidebar = () => {
                sidebar.classList.remove('is-open');
                overlay.classList.remove('is-open');
                sidebar.setAttribute('aria-hidden', 'true');
                menuButton.setAttribute('aria-expanded', 'false');
            };

            menuButton.addEventListener('click', () => {
                if (sidebar.classList.contains('is-open')) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });

            overlay.addEventListener('click', closeSidebar);
            if (closeButton) {
                closeButton.addEventListener('click', closeSidebar);
            }

            document.addEventListener('keyup', (event) => {
                if (event.key === 'Escape' && sidebar.classList.contains('is-open')) {
                    closeSidebar();
                }
            });
        });
    </script>
    {% endif %}
</body>
</html>