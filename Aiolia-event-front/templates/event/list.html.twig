{% extends 'base.html.twig' %}

{% block title %}Tous les évènements - Vente tickets{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/events.css') }}">
{% endblock %}

{% block body %}
        {% set currentUser = app.session.get('user') %}
        {% set isAuthenticated = currentUser is not null %}
        <main>
            <section class="sec-filtre">
                <div class="container">
                    <form>
                    <div class="cont-filtre d-flex  wow fadeInUp" data-wow-delay="300ms">
                        
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Type d'évènement</label>
                                    <select>
                                        <option>Soirée live</option>
                                        <option>Soirée live1</option>
                                    </select>
                                </div>

                                <div class="blc-chp">
                                    <label for="amount">Prix</label>
                                    <input type="text" id="amount" readonly="" >
                                    <div id="slider-range"></div>
                                    <div class="blc-prix">
                                        <span class="min">5.000MGA</span>
                                        <span class="max">1.000.000MGA</span>

                                    </div>
                                </div>

                            </div>
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Localité</label>
                                    <select>
                                        <option>Antananarivo</option>
                                        <option>Toamasina</option>
                                    </select>
                                </div>
                                 <div class="blc-chp">
                                    <label>Public</label>
                                    <select>
                                        <option>Famille (tout public)</option>
                                        <option>Famille </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Date</label>
                                    <div class="blc-date">
                                        <label for="from">Du</label>
                                        <input type="text" id="from" name="from" class="chp date"  >
                                        <label for="to">Au</label>
                                        <input type="text" id="to" name="to" class="chp date" >
                                    </div>
                                </div> 
                                <div class="blc-chp">
                                    <label>Afficher par</label>
                                    
                                    <div class="blc-option d-flex">
                                       <div class="option">
                                         <div class="check">
                                            <input type="radio" id="prix-croissant" name="radio-group" checked>
                                            <label for="prix-croissant">Prix croissant</label>
                                          </div>
                                          <div class="check">
                                            <input type="radio" id="prix-decroissant" name="radio-group">
                                            <label for="prix-decroissant">Prix décroissant</label>
                                          </div>
                                        </div>

                                        <div class="sep"></div>

                                        <div class="option">
                                            <div class="check">
                                                <input type="radio" id="nouveaute" name="radio-group1" checked>
                                                <label for="nouveaute">Nouveautés</label>
                                            </div>
                                            <div class="check">
                                                <input type="radio" id="popularite" name="radio-group1">
                                                <label for="popularite">Popularité</label>
                                            </div>
                                        </div> 

                                    </div>
                                    

                                </div> 
                            </div>
                        
                    </div>
                    <div class="blcBtn text-center">
                        <input type="button" name="" value="Affiner ma recherche" class="btn submit">
                    </div>
                    </form>
                </div>
            </section>

            <section class="sec-event all-event">
                <div class="container">
                    {% if groupedEvents is defined and groupedEvents %}
                        {% for categoryName, events in groupedEvents %}
                            <h2 class="wow fadeIn" data-wow-delay="300ms">{{ categoryName }}</h2>
                            <div class="lst-event">
                                {% for event in events %}
                                <div class="item  wow fadeInUp" data-wow-delay="300ms">
                                    <div class="inner">
                                        {% if isAuthenticated %}
                                        <button class="favorite-toggle {% if event.isFavorite is defined and event.isFavorite %}is-active{% endif %}" type="button" data-event-id="{{ event.id ?? loop.index }}" title="Ajouter aux favoris">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                        {% endif %}
                                        <div class="blc-col1">
                                            <div class="col1">
                                                <div class="date">
                                                    <span>{{ event.weekday ?? 'Dimanche' }}</span>
                                                    <strong>{{ event.day ?? '20' }}</strong>
                                                    <span class="text-upper">{{ event.monthYear ?? 'juil. 2025' }}</span>
                                                </div>
                                                <div class="hour">
                                                    {{ event.time ?? 'à 20:00' }}
                                                </div>
                                                <div class="code-barre">
                                                    <img src="{{ asset('vente-ticket/images/code1.png') }}">
                                                </div>
                                            </div>
                                            <div class="col2">
                                                <span class="bandeau">{{ event.categoryName ?? categoryName }}</span>
                                                <h3>{{ event.title ?? 'Music on Sunday' }}</h3>
                                                <div class="adresse">{{ event.location ?? 'Lieu : Analakely au Café de la Gare' }}</div>
                                                <div class="tarif">{{ event.priceRange ?? 'Tarifs : 50.000MGA - 150.000MGA' }}</div>
                                                <div class="blcBtn ">
                                                    <a href="#" class="btn ticket">Acheter un ticket</a>
                                                    <a href="{{ path('my_ticket_details', { id: event.id ?? loop.index }) }}" class="btn details">détails</a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="blc-col2">
                                            <div class="img">
                                                <img src="{{ event.imageUrl ?? asset('vente-ticket/images/img1.png') }}" alt="ventes tickets">
                                            </div>  
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    {% else %}
                        <h2 class="wow fadeIn" data-wow-delay="300ms">Tous les évènements</h2>
                        <div class="lst-event">
                            {% for i in 1..4 %}
                            <div class="item  wow fadeInUp" data-wow-delay="300ms">
                                <div class="inner">
                                    {% if isAuthenticated %}
                                    <button class="favorite-toggle" type="button" data-event-id="{{ i }}" title="Ajouter aux favoris">
                                        <i class="fas fa-heart"></i>
                                    </button>
                                    {% endif %}
                                    <div class="blc-col1">
                                        <div class="col1">
                                            <div class="date">
                                                <span>Dimanche</span>
                                                <strong>20</strong>
                                                <span class="text-upper">juil. 2025</span>
                                            </div>
                                            <div class="hour">
                                                à 20:00
                                            </div>
                                            <div class="code-barre">
                                                <img src="{{ asset('vente-ticket/images/code1.png') }}">
                                            </div>
                                        </div>
                                        <div class="col2">
                                            <span class="bandeau">Soirée live</span>
                                            <h3>Music on Sunday</h3>
                                            <div class="adresse">Lieu : Analakely au Café de la Gare</div>
                                            <div class="tarif">Tarifs : 50.000MGA - 150.000MGA</div>
                                            <div class="blcBtn ">
                                                <a href="#" class="btn ticket">Acheter un ticket</a>
                                                <a href="{{ path('my_ticket_details', { id: i }) }}" class="btn details">détails</a>

                                            </div>
                                        </div>
                                        
                                    </div>
                                    <div class="blc-col2">
                                        <div class="img">
                                            <img src="{{ asset('vente-ticket/images/img1.png') }}" alt="ventes tickets">
                                        </div>  
                                    </div>
                                    
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="pagination">
                        <ul>
                            <li class="prev"><a href="#"></a></li>
                            <li class="selected"><a href="#">1</a></li>
                            <li><a href="#">2</a></li>
                            <li><a href="#">3</a></li>
                            <li><a href="#">4</a></li>
                            <li class="next"><a href="#"></a></li>
                        </ul>
                    </div>

                    
                </div>
            </section>
        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.favorite-toggle').forEach(btn => {
                    btn.addEventListener('click', () => {
                        btn.classList.toggle('is-active');
                        btn.setAttribute('aria-pressed', btn.classList.contains('is-active'));
                    });
                });
            });
        </script>
{% endblock %}


