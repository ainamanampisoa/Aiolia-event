{% extends 'base.html.twig' %}

{% block title %}{{ 'events.all_page_title'|trans }}{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/events.css') }}">
{% endblock %}

{% block body %}
        {% set sessionUser = sessionUser ?? null %}
        {% set isAuthenticated = (isAuthenticated ?? false) or (sessionUser is iterable and sessionUser.id is defined) %}
        <main>
            <section class="sec-filtre">
                <div class="container">
                    <form method="GET" action="{{ path('events') }}">
                        {# Conserver la recherche textuelle si présente #}
                        {% if searchQuery is defined and searchQuery %}
                            <input type="hidden" name="q" value="{{ searchQuery }}">
                        {% endif %}
                        
                    <div class="cont-filtre d-flex  wow fadeInUp" data-wow-delay="300ms">
                        
                            <div class="col">
                                <div class="blc-chp">
                                    <label>{{ 'events.filter_type_label'|trans }}</label>
                                    <select name="category">
                                        <option value="">{{ 'events.filter_type_all'|trans }}</option>
                                        {% for category in categories %}
                                            <option value="{{ category.slug }}" {% if filters.category is defined and filters.category == category.slug %}selected{% endif %}>
                                                {{ category.label }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="blc-chp">
                                    <label for="amount">{{ 'events.filter_price_label'|trans }}</label>
                                    <input type="text" id="amount" readonly value="" placeholder="{{ 'events.filter_price_placeholder'|trans }}">
                                    <input type="hidden" id="price_min" name="price_min" value="{{ filters.price_min ?? '' }}">
                                    <input type="hidden" id="price_max" name="price_max" value="{{ filters.price_max ?? '' }}">
                                    <div id="slider-range"
                                         data-min="{{ price_bounds.min }}"
                                         data-max="{{ price_bounds.max }}"></div>
                                    <div class="blc-prix">
                                        <span class="min">{{ price_bounds.min|number_format(0, '.', ' ') }} MGA</span>
                                        <span class="max">{{ price_bounds.max|number_format(0, '.', ' ') }} MGA</span>

                                    </div>
                                    <small style="font-size: 11px; color: #999; display: block; margin-top: 4px;">{{ 'events.filter_price_hint'|trans }}</small>
                                </div>

                            </div>
                            <div class="col">
                                <div class="blc-chp">
                                    <label>{{ 'events.filter_location_label'|trans }}</label>
                                    <select name="city">
                                        <option value="">{{ 'events.filter_location_all'|trans }}</option>
                                        {% for city in locations %}
                                            <option value="{{ city }}" {% if filters.city is defined and filters.city == city %}selected{% endif %}>
                                                {{ city }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col">
                                <div class="blc-chp">
                                    <label>{{ 'events.filter_date_label'|trans }}</label>
                                    <div class="blc-date">
                                        <label for="from">{{ 'events.filter_date_from'|trans }}</label>
                                        <input type="text" id="from" name="date_from" class="chp date" value="{{ filters.date_from ?? '' }}" placeholder="{{ 'events.filter_date_placeholder'|trans }}">
                                        <label for="to">{{ 'events.filter_date_to'|trans }}</label>
                                        <input type="text" id="to" name="date_to" class="chp date" value="{{ filters.date_to ?? '' }}" placeholder="{{ 'events.filter_date_placeholder'|trans }}">
                                    </div>
                                    <small style="font-size: 11px; color: #999; display: block; margin-top: 4px;">{{ 'events.filter_date_hint'|trans }}</small>
                                </div> 
                                <div class="blc-chp">
                                    <label>{{ 'events.filter_sort_label'|trans }}</label>
                                    
                                    <div class="blc-option d-flex">
                                       <div class="option">
                                         <div class="check">
                                            <input type="radio" id="prix-croissant" name="sort_by" value="price_asc" {% if filters.sort_by is defined and filters.sort_by == 'price_asc' or (filters.sort_by is not defined) %}checked{% endif %}>
                                            <label for="prix-croissant">{{ 'events.filter_sort_price_asc'|trans }}</label>
                                          </div>
                                          <div class="check">
                                            <input type="radio" id="prix-decroissant" name="sort_by" value="price_desc" {% if filters.sort_by is defined and filters.sort_by == 'price_desc' %}checked{% endif %}>
                                            <label for="prix-decroissant">{{ 'events.filter_sort_price_desc'|trans }}</label>
                                          </div>
                                        </div>

                                        <div class="sep"></div>

                                        <div class="option">
                                            <div class="check">
                                                <input type="radio" id="nouveaute" name="sort_by" value="date" {% if filters.sort_by is defined and filters.sort_by == 'date' %}checked{% endif %}>
                                                <label for="nouveaute">{{ 'events.filter_sort_new'|trans }}</label>
                                            </div>
                                            <div class="check">
                                                <input type="radio" id="popularite" name="sort_by" value="popularity" {% if filters.sort_by is defined and filters.sort_by == 'popularity' %}checked{% endif %}>
                                                <label for="popularite">{{ 'events.filter_sort_popularity'|trans }}</label>
                                            </div>
                                        </div> 

                                    </div>
                                    

                                </div> 
                            </div>
                        
                    </div>
                    <div class="blcBtn text-center">
                        <button type="submit" class="btn submit">{{ 'events.filter_submit'|trans }}</button>
                    </div>
                    </form>
                </div>
            </section>

            <section class="sec-event all-event">
                <div class="container">
                    {# Afficher le message de recherche si une requête est présente #}
                    {% if searchQuery is defined and searchQuery %}
                        <div class="search-results-header wow fadeIn" data-wow-delay="200ms" style="margin-bottom: 30px;">
                            <h2>{{ 'events.search_results_title'|trans({'{query}': searchQuery})|raw }}</h2>
                            {% set totalResults = 0 %}
                            {% for categoryName, eventsByCategory in groupedEvents %}
                                {% set totalResults = totalResults + eventsByCategory|length %}
                            {% endfor %}
                            <p style="color: #666; margin-top: 10px;">{{ 'events.search_results_count'|trans({'{count}': totalResults})|raw }}</p>
                        </div>
                    {% endif %}
                    
                    {% if groupedEvents is defined and groupedEvents %}
                        {% if groupedEvents|length == 0 %}
                            <div class="no-results wow fadeIn" data-wow-delay="200ms" style="text-align: center; padding: 60px 20px;">
                                <i class="fas fa-search" style="font-size: 48px; color: #ccc; margin-bottom: 20px;"></i>
                                <h3>{{ 'events.no_results_title'|trans }}</h3>
                                <p style="color: #666; margin-top: 10px;">{{ 'events.no_results_desc'|trans }}</p>
                                <a href="{{ path('events') }}" class="btn" style="margin-top: 20px; display: inline-block;">
                                    {{ 'events.no_results_button'|trans }}
                                </a>
                            </div>
                        {% else %}
                            {% for categoryName, eventsByCategory in groupedEvents %}
                                <h2 class="wow fadeIn" data-wow-delay="300ms">{{ categoryName }}</h2>
                            <div class="lst-event">
                                {% for event in eventsByCategory %}
                                {% set startsAt = event.starts_at %}
                                {% set imagePath = event.image_url
                                    ? (event.image_url starts with 'http' ? event.image_url : asset(event.image_url|trim('/')))
                                    : asset('vente-ticket/images/img1.png') %}
                                <div class="item  wow fadeInUp" data-wow-delay="300ms">
                                    <div class="inner">
                                        {% if isAuthenticated %}
                                        <button class="favorite-toggle {% if event.isFavorite is defined and event.isFavorite %}is-active{% endif %}" type="button" data-event-id="{{ event.id }}" title="Ajouter aux favoris">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                        {% endif %}
                                        <div class="blc-col1">
                                            <div class="col1">
                                                <div class="date">
                                                    {% if startsAt %}
                                                        <span>{{ startsAt|date('l')|capitalize }}</span>
                                                        <strong>{{ startsAt|date('d') }}</strong>
                                                        <span class="text-upper">{{ startsAt|date('M Y')|upper }}</span>
                                                    {% else %}
                                                        <span>{{ 'events.date_coming_soon'|trans }}</span>
                                                    {% endif %}
                                                </div>
                                                <div class="hour">
                                                    {% if startsAt %}
                                                        {{ 'events.time_prefix'|trans }} {{ startsAt|date('H\\hi') }}
                                                    {% else %}
                                                        {{ 'events.time_unknown'|trans }}
                                                    {% endif %}
                                                </div>
                                                <div class="code-barre">
                                                    <img src="{{ asset('vente-ticket/images/code1.png') }}">
                                                </div>
                                            </div>
                                            <div class="col2">
                                                <span class="bandeau">{{ event.category_label ?? categoryName }}</span>
                                                <h3>{{ event.title }}</h3>
                                                {% set location_parts = [] %}
                                                {% if event.venue_name %}
                                                    {% set location_parts = location_parts|merge([event.venue_name]) %}
                                                {% endif %}
                                                {% if event.city %}
                                                    {% set location_parts = location_parts|merge([event.city]) %}
                                                {% endif %}
                                                {% if event.region %}
                                                    {% set location_parts = location_parts|merge([event.region]) %}
                                                {% endif %}
                                                {% if event.country_code %}
                                                    {% set location_parts = location_parts|merge([event.country_code]) %}
                                                {% endif %}
                                                {% if location_parts is not empty %}
                                                    <div class="adresse">{{ location_parts|join(', ') }}</div>
                                                {% endif %}
                                                <div class="tarif">
                                                    {% if event.min_price is not null %}
                                                        {% if event.max_price is not null and event.max_price > event.min_price %}
                                                            {{ 'events.price_range'|trans({
                                                                '{min}': event.min_price|number_format(0, '.', ' '),
                                                                '{max}': event.max_price|number_format(0, '.', ' ')
                                                            })|raw }}
                                                        {% else %}
                                                            {{ 'events.price_single'|trans({
                                                                '{price}': event.min_price|number_format(0, '.', ' ')
                                                            })|raw }}
                                                        {% endif %}
                                                    {% else %}
                                                        {{ 'events.price_not_set'|trans }}
                                                    {% endif %}
                                                </div>
                                                {% set event_url = (isAuthenticated ?? false) ? path('event_details', { id: event.id }) : path('login') %}
                                                <div class="blcBtn ">
                                                    <a href="{{ event_url }}" class="btn ticket">{{ 'events.buy_ticket'|trans }}</a>
                                                    <a href="{{ event_url }}" class="btn details">{{ 'events.details'|trans }}</a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="blc-col2">
                                            <div class="img">
                                                <img src="{{ imagePath }}" alt="{{ event.title }}">
                                            </div>  
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                                </div>
                            {% endfor %}
                        {% endif %}
                    {% else %}
                        <div class="no-results wow fadeIn" data-wow-delay="200ms" style="text-align: center; padding: 60px 20px;">
                            <i class="fas fa-calendar-alt" style="font-size: 48px; color: #ccc; margin-bottom: 20px;"></i>
                            <h3>{{ 'events.no_events_available_title'|trans }}</h3>
                            <p style="color: #666; margin-top: 10px;">{{ 'events.no_events_available_desc'|trans }}</p>
                            <a href="{{ path('events') }}" class="btn" style="margin-top: 20px; display: inline-block;">
                                {{ 'events.no_events_reset_filters'|trans }}
                            </a>
                        </div>
                    {% endif %}

                    <div class="pagination">
                        <ul>
                            <li class="prev"><a href="#"></a></li>
                            <li class="selected"><a href="#">1</a></li>
                            <li><a href="#">2</a></li>
                            <li><a href="#">3</a></li>
                            <li><a href="#">4</a></li>
                            <li class="next"><a href="#"></a></li>
                        </ul>
                    </div>

                    
                </div>
            </section>
        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Gestion des favoris
                document.querySelectorAll('.favorite-toggle').forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const eventId = this.dataset.eventId;
                        const isActive = this.classList.contains('is-active');
                        
                        // Toggle visuel immédiat
                        this.classList.toggle('is-active');
                        this.setAttribute('aria-pressed', this.classList.contains('is-active'));
                        
                        // Appel API pour ajouter/retirer des favoris
                        const method = isActive ? 'DELETE' : 'POST';
                        const url = `/events/${eventId}/favorite`;
                        
                        fetch(url, {
                            method: method,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/json',
                            },
                        })
                        .then(response => {
                            // Vérifier si la réponse est OK
                            if (!response.ok) {
                                throw new Error(`HTTP error! status: ${response.status}`);
                            }
                            // Vérifier si la réponse est du JSON
                            const contentType = response.headers.get('content-type');
                            if (!contentType || !contentType.includes('application/json')) {
                                throw new Error('Response is not JSON');
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (data.status !== 'success') {
                                // En cas d'erreur, annuler le toggle visuel
                                this.classList.toggle('is-active');
                                this.setAttribute('aria-pressed', this.classList.contains('is-active'));
                                console.error('Erreur lors de la mise à jour des favoris:', data.message || 'Erreur inconnue');
                                alert('Erreur: ' + (data.message || 'Impossible de mettre à jour les favoris'));
                            } else {
                                console.log('Favori mis à jour avec succès:', data.message);
                                // Le cœur reste dans l'état actuel (rouge si ajouté, normal si retiré)
                            }
                        })
                        .catch(error => {
                            // En cas d'erreur, annuler le toggle visuel
                            this.classList.toggle('is-active');
                            this.setAttribute('aria-pressed', this.classList.contains('is-active'));
                            console.error('Erreur lors de la mise à jour des favoris:', error);
                            alert('Erreur lors de la mise à jour des favoris. Veuillez réessayer.');
                        });
                    });
                });
                
                // Initialiser le slider de prix (optionnel)
                const sliderRange = document.getElementById('slider-range');
                const amountInput = document.getElementById('amount');
                const priceMinInput = document.getElementById('price_min');
                const priceMaxInput = document.getElementById('price_max');
                
                if (sliderRange && typeof jQuery !== 'undefined' && jQuery.fn.slider) {
                    const min = parseFloat(sliderRange.dataset.min) || 0;
                    const max = parseFloat(sliderRange.dataset.max) || 100000;
                    
                    // Récupérer les valeurs actuelles ou utiliser les valeurs par défaut
                    let currentMin = parseFloat(priceMinInput.value);
                    let currentMax = parseFloat(priceMaxInput.value);
                    
                    // Si aucune valeur n'est définie, initialiser à min/max (tous les prix)
                    if (isNaN(currentMin)) currentMin = min;
                    if (isNaN(currentMax)) currentMax = max;
                    
                    jQuery('#slider-range').slider({
                        range: true,
                        min: min,
                        max: max,
                        values: [currentMin, currentMax],
                        slide: function(event, ui) {
                            // Ne mettre à jour les champs cachés que si la valeur a changé
                            if (ui.values[0] > min || ui.values[1] < max) {
                                priceMinInput.value = ui.values[0];
                                priceMaxInput.value = ui.values[1];
                                amountInput.value = ui.values[0].toLocaleString('fr-FR') + ' MGA - ' + ui.values[1].toLocaleString('fr-FR') + ' MGA';
                            } else {
                                // Si la valeur est aux extrémités, vider les champs (tous les prix)
                                priceMinInput.value = '';
                                priceMaxInput.value = '';
                                amountInput.value = '';
                            }
                        },
                        change: function(event, ui) {
                            // Même logique pour le changement
                            if (ui.values[0] > min || ui.values[1] < max) {
                                priceMinInput.value = ui.values[0];
                                priceMaxInput.value = ui.values[1];
                                amountInput.value = ui.values[0].toLocaleString('fr-FR') + ' MGA - ' + ui.values[1].toLocaleString('fr-FR') + ' MGA';
                            } else {
                                priceMinInput.value = '';
                                priceMaxInput.value = '';
                                amountInput.value = '';
                            }
                        }
                    });
                    
                    // Initialiser l'affichage seulement si des valeurs sont définies
                    if (priceMinInput.value && priceMaxInput.value) {
                        const minVal = parseFloat(priceMinInput.value);
                        const maxVal = parseFloat(priceMaxInput.value);
                        if (!isNaN(minVal) && !isNaN(maxVal) && (minVal > min || maxVal < max)) {
                            amountInput.value = minVal.toLocaleString('fr-FR') + ' MGA - ' + maxVal.toLocaleString('fr-FR') + ' MGA';
                        }
                    }
                }
                
                // Initialiser les datepickers
                if (typeof jQuery !== 'undefined' && jQuery.fn.datepicker) {
                    const dateFormat = 'dd/mm/yy';
                    
                    // Récupérer les valeurs actuelles depuis les inputs
                    const fromInput = document.getElementById('from');
                    const toInput = document.getElementById('to');
                    
                    let fromDate = null;
                    let toDate = null;
                    
                    if (fromInput && fromInput.value) {
                        // Convertir la date du format YYYY-MM-DD ou dd/mm/yyyy vers un objet Date
                        const fromParts = fromInput.value.split(/[-\/]/);
                        if (fromParts.length === 3) {
                            if (fromInput.value.includes('-')) {
                                fromDate = new Date(fromParts[0], fromParts[1] - 1, fromParts[2]);
                            } else {
                                fromDate = new Date(fromParts[2], fromParts[1] - 1, fromParts[0]);
                            }
                        }
                    }
                    
                    if (toInput && toInput.value) {
                        const toParts = toInput.value.split(/[-\/]/);
                        if (toParts.length === 3) {
                            if (toInput.value.includes('-')) {
                                toDate = new Date(toParts[0], toParts[1] - 1, toParts[2]);
                            } else {
                                toDate = new Date(toParts[2], toParts[1] - 1, toParts[0]);
                            }
                        }
                    }
                    
                    jQuery('#from').datepicker({
                        dateFormat: dateFormat,
                        defaultDate: fromDate || '+1d',
                        changeMonth: true,
                        changeYear: true,
                        onClose: function(selectedDate) {
                            jQuery('#to').datepicker('option', 'minDate', selectedDate);
                            // Mettre à jour l'input hidden avec le format YYYY-MM-DD
                            if (selectedDate) {
                                const dateParts = selectedDate.split('/');
                                if (dateParts.length === 3) {
                                    fromInput.setAttribute('data-iso-date', dateParts[2] + '-' + dateParts[1] + '-' + dateParts[0]);
                                }
                            }
                        }
                    });
                    
                    jQuery('#to').datepicker({
                        dateFormat: dateFormat,
                        defaultDate: toDate || '+1d',
                        changeMonth: true,
                        changeYear: true,
                        minDate: fromDate || '+1d',
                        onClose: function(selectedDate) {
                            // Mettre à jour l'input hidden avec le format YYYY-MM-DD
                            if (selectedDate) {
                                const dateParts = selectedDate.split('/');
                                if (dateParts.length === 3) {
                                    toInput.setAttribute('data-iso-date', dateParts[2] + '-' + dateParts[1] + '-' + dateParts[0]);
                                }
                            }
                        }
                    });
                    
                    // Gérer la soumission du formulaire pour convertir les dates et nettoyer les champs vides
                    const form = document.querySelector('form[method="GET"]');
                    if (form) {
                        form.addEventListener('submit', function(e) {
                            // Convertir les dates du format dd/mm/yyyy vers YYYY-MM-DD
                            if (fromInput && fromInput.value && !fromInput.value.includes('-')) {
                                const fromParts = fromInput.value.split('/');
                                if (fromParts.length === 3) {
                                    fromInput.value = fromParts[2] + '-' + fromParts[1] + '-' + fromParts[0];
                                }
                            } else if (fromInput && !fromInput.value) {
                                // Supprimer le paramètre si vide
                                fromInput.disabled = true;
                            }
                            
                            if (toInput && toInput.value && !toInput.value.includes('-')) {
                                const toParts = toInput.value.split('/');
                                if (toParts.length === 3) {
                                    toInput.value = toParts[2] + '-' + toParts[1] + '-' + toParts[0];
                                }
                            } else if (toInput && !toInput.value) {
                                // Supprimer le paramètre si vide
                                toInput.disabled = true;
                            }
                            
                            // Nettoyer les champs de prix si vides ou à la valeur par défaut
                            if (priceMinInput && priceMaxInput) {
                                const sliderValues = jQuery('#slider-range').slider('values');
                                const min = parseFloat(sliderRange.dataset.min) || 0;
                                const max = parseFloat(sliderRange.dataset.max) || 100000;
                                
                                // Si les valeurs sont aux extrémités, ne pas envoyer les paramètres de prix
                                if (sliderValues && sliderValues[0] <= min && sliderValues[1] >= max) {
                                    priceMinInput.disabled = true;
                                    priceMaxInput.disabled = true;
                                } else if (!priceMinInput.value || !priceMaxInput.value) {
                                    priceMinInput.disabled = true;
                                    priceMaxInput.disabled = true;
                                }
                            }
                        });
                    }
                }
            });
        </script>
{% endblock %}


