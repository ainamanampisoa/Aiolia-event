{% extends 'base.html.twig' %}

{% block title %}Tous les évènements - Vente tickets{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/events.css') }}">
{% endblock %}

{% block body %}
        {% set sessionUser = sessionUser ?? null %}
        {% set isAuthenticated = (isAuthenticated ?? false) or (sessionUser is iterable and sessionUser.id is defined) %}
        <main>
            <section class="sec-filtre">
                <div class="container">
                    <form>
                    <div class="cont-filtre d-flex  wow fadeInUp" data-wow-delay="300ms">
                        
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Type d'évènement</label>
                                    <select>
                                        <option value="">Tous les types</option>
                                        {% for category in categories %}
                                            <option value="{{ category.slug }}">{{ category.label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="blc-chp">
                                    <label for="amount">Prix</label>
                                    <input type="text" id="amount" readonly value="" >
                                    <div id="slider-range"
                                         data-min="{{ price_bounds.min }}"
                                         data-max="{{ price_bounds.max }}"></div>
                                    <div class="blc-prix">
                                        <span class="min">{{ price_bounds.min|number_format(0, '.', ' ') }} MGA</span>
                                        <span class="max">{{ price_bounds.max|number_format(0, '.', ' ') }} MGA</span>

                                    </div>
                                </div>

                            </div>
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Localité</label>
                                    <select>
                                        <option value="">Toutes les villes</option>
                                        {% for city in locations %}
                                            <option value="{{ city }}">{{ city }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                 <div class="blc-chp">
                                    <label>Public</label>
                                    <select>
                                        <option>Famille (tout public)</option>
                                        <option>Famille </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Date</label>
                                    <div class="blc-date">
                                        <label for="from">Du</label>
                                        <input type="text" id="from" name="from" class="chp date"  >
                                        <label for="to">Au</label>
                                        <input type="text" id="to" name="to" class="chp date" >
                                    </div>
                                </div> 
                                <div class="blc-chp">
                                    <label>Afficher par</label>
                                    
                                    <div class="blc-option d-flex">
                                       <div class="option">
                                         <div class="check">
                                            <input type="radio" id="prix-croissant" name="radio-group" checked>
                                            <label for="prix-croissant">Prix croissant</label>
                                          </div>
                                          <div class="check">
                                            <input type="radio" id="prix-decroissant" name="radio-group">
                                            <label for="prix-decroissant">Prix décroissant</label>
                                          </div>
                                        </div>

                                        <div class="sep"></div>

                                        <div class="option">
                                            <div class="check">
                                                <input type="radio" id="nouveaute" name="radio-group1" checked>
                                                <label for="nouveaute">Nouveautés</label>
                                            </div>
                                            <div class="check">
                                                <input type="radio" id="popularite" name="radio-group1">
                                                <label for="popularite">Popularité</label>
                                            </div>
                                        </div> 

                                    </div>
                                    

                                </div> 
                            </div>
                        
                    </div>
                    <div class="blcBtn text-center">
                        <input type="button" name="" value="Affiner ma recherche" class="btn submit">
                    </div>
                    </form>
                </div>
            </section>

            <section class="sec-event all-event">
                <div class="container">
                    {% if groupedEvents is defined and groupedEvents %}
                                {% for categoryName, eventsByCategory in groupedEvents %}
                            <h2 class="wow fadeIn" data-wow-delay="300ms">{{ categoryName }}</h2>
                            <div class="lst-event">
                                {% for event in eventsByCategory %}
                                {% set startsAt = event.starts_at %}
                                {% set imagePath = event.image_url
                                    ? (event.image_url starts with 'http' ? event.image_url : asset(event.image_url|trim('/')))
                                    : asset('vente-ticket/images/img1.png') %}
                                <div class="item  wow fadeInUp" data-wow-delay="300ms">
                                    <div class="inner">
                                        {% if isAuthenticated %}
                                        <button class="favorite-toggle {% if event.isFavorite is defined and event.isFavorite %}is-active{% endif %}" type="button" data-event-id="{{ event.id }}" title="Ajouter aux favoris">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                        {% endif %}
                                        <div class="blc-col1">
                                            <div class="col1">
                                                <div class="date">
                                                    {% if startsAt %}
                                                        <span>{{ startsAt|date('l')|capitalize }}</span>
                                                        <strong>{{ startsAt|date('d') }}</strong>
                                                        <span class="text-upper">{{ startsAt|date('M Y')|upper }}</span>
                                                    {% else %}
                                                        <span>À venir</span>
                                                    {% endif %}
                                                </div>
                                                <div class="hour">
                                                    {% if startsAt %}
                                                        à {{ startsAt|date('H\\hi') }}
                                                    {% else %}
                                                        Horaire à confirmer
                                                    {% endif %}
                                                </div>
                                                <div class="code-barre">
                                                    <img src="{{ asset('vente-ticket/images/code1.png') }}">
                                                </div>
                                            </div>
                                            <div class="col2">
                                                <span class="bandeau">{{ event.category_label ?? categoryName }}</span>
                                                <h3>{{ event.title }}</h3>
                                                <div class="adresse">
                                                    {% if event.venue_name %}{{ event.venue_name }}{% endif %}
                                                    {% if event.city %}
                                                        {% if event.venue_name %}, {% endif %}
                                                        {{ event.city }}
                                                    {% endif %}
                                                </div>
                                                <div class="tarif">
                                                    {% if event.min_price is not null %}
                                                        {% if event.max_price is not null and event.max_price > event.min_price %}
                                                            Tarifs : {{ event.min_price|number_format(0, '.', ' ') }} MGA - {{ event.max_price|number_format(0, '.', ' ') }} MGA
                                                        {% else %}
                                                            Tarif : {{ event.min_price|number_format(0, '.', ' ') }} MGA
                                                        {% endif %}
                                                    {% else %}
                                                        Tarifs : non communiqué
                                                    {% endif %}
                                                </div>
                                                {% set event_url = (isAuthenticated ?? false) ? path('event_details', { id: event.id }) : path('login') %}
                                                <div class="blcBtn ">
                                                    <a href="{{ event_url }}" class="btn ticket">Acheter un ticket</a>
                                                    <a href="{{ event_url }}" class="btn details">détails</a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="blc-col2">
                                            <div class="img">
                                                <img src="{{ imagePath }}" alt="{{ event.title }}">
                                            </div>  
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    {% else %}
                        <h2 class="wow fadeIn" data-wow-delay="300ms">Tous les évènements</h2>
                        <p class="text-center">Aucun événement disponible pour le moment.</p>
                    {% endif %}

                    <div class="pagination">
                        <ul>
                            <li class="prev"><a href="#"></a></li>
                            <li class="selected"><a href="#">1</a></li>
                            <li><a href="#">2</a></li>
                            <li><a href="#">3</a></li>
                            <li><a href="#">4</a></li>
                            <li class="next"><a href="#"></a></li>
                        </ul>
                    </div>

                    
                </div>
            </section>
        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.favorite-toggle').forEach(btn => {
                    btn.addEventListener('click', () => {
                        btn.classList.toggle('is-active');
                        btn.setAttribute('aria-pressed', btn.classList.contains('is-active'));
                    });
                });
            });
        </script>
{% endblock %}


