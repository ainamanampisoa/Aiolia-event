{% extends 'base.html.twig' %}

{% block title %}Tous les évènements - Vente tickets{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/animate.min.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/slick.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/jquery-ui.css') }}">
        <link rel="stylesheet" type="text/css" href="{{ asset('vente-ticket/css/main.css') }}">
{% endblock %}

{% block body %}
        <main>
            <section class="sec-filtre">
                <div class="container">
                    <form>
                    <div class="cont-filtre d-flex  wow fadeInUp" data-wow-delay="300ms">
                        
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Type d'évènement</label>
                                    <select>
                                        <option>Soirée live</option>
                                        <option>Soirée live1</option>
                                    </select>
                                </div>

                                <div class="blc-chp">
                                    <label for="amount">Prix</label>
                                    <input type="text" id="amount" readonly="" >
                                    <div id="slider-range"></div>
                                    <div class="blc-prix">
                                        <span class="min">5.000MGA</span>
                                        <span class="max">1.000.000MGA</span>

                                    </div>
                                </div>

                            </div>
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Localité</label>
                                    <select>
                                        <option>Antananarivo</option>
                                        <option>Toamasina</option>
                                    </select>
                                </div>
                                 <div class="blc-chp">
                                    <label>Public</label>
                                    <select>
                                        <option>Famille (tout public)</option>
                                        <option>Famille </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col">
                                <div class="blc-chp">
                                    <label>Date</label>
                                    <div class="blc-date">
                                        <label for="from">Du</label>
                                        <input type="text" id="from" name="from" class="chp date"  >
                                        <label for="to">Au</label>
                                        <input type="text" id="to" name="to" class="chp date" >
                                    </div>
                                </div> 
                                <div class="blc-chp">
                                    <label>Afficher par</label>
                                    
                                    <div class="blc-option d-flex">
                                       <div class="option">
                                         <div class="check">
                                            <input type="radio" id="prix-croissant" name="radio-group" checked>
                                            <label for="prix-croissant">Prix croissant</label>
                                          </div>
                                          <div class="check">
                                            <input type="radio" id="prix-decroissant" name="radio-group">
                                            <label for="prix-decroissant">Prix décroissant</label>
                                          </div>
                                        </div>

                                        <div class="sep"></div>

                                        <div class="option">
                                            <div class="check">
                                                <input type="radio" id="nouveaute" name="radio-group1" checked>
                                                <label for="nouveaute">Nouveautés</label>
                                            </div>
                                            <div class="check">
                                                <input type="radio" id="popularite" name="radio-group1">
                                                <label for="popularite">Popularité</label>
                                            </div>
                                        </div> 

                                    </div>
                                    

                                </div> 
                            </div>
                        
                    </div>
                    <div class="blcBtn text-center">
                        <input type="button" name="" value="Affiner ma recherche" class="btn submit">
                    </div>
                    </form>
                </div>
            </section>

            <section class="sec-event all-event">
                <div class="container">
                    <h2 class="wow fadeIn" data-wow-delay="300ms">Tous les évènements</h2>
                    <div class="lst-event">
                        {% for i in 1..4 %}
                        <div class="item  wow fadeInUp" data-wow-delay="300ms">
                            <div class="inner">
                                <div class="blc-col1">
                                    <div class="col1">
                                        <div class="date">
                                            <span>Dimanche</span>
                                            <strong>20</strong>
                                            <span class="text-upper">juil. 2025</span>
                                        </div>
                                        <div class="hour">
                                            à 20:00
                                        </div>
                                        <div class="code-barre">
                                            <img src="{{ asset('vente-ticket/images/code1.png') }}">
                                        </div>
                                    </div>
                                    <div class="col2">
                                        <span class="bandeau">Soirée live</span>
                                        <h3>Music on Sunday</h3>
                                        <div class="adresse">Lieu : Analakely au Café de la Gare</div>
                                        <div class="tarif">Tarifs : 50.000MGA - 150.000MGA</div>
                                        <div class="blcBtn ">
                                            <a href="#" class="btn ticket">Acheter un ticket</a>
                                            <a href="#" class="btn details">détails</a>

                                        </div>
                                    </div>
                                    
                                </div>
                                <div class="blc-col2">
                                    <div class="img">
                                        <img src="{{ asset('vente-ticket/images/img1.png') }}" alt="ventes tickets">
                                    </div>  
                                </div>
                                <div class="blc-col3">
                                    <h3>Option sur le ticket</h3>
                                    <div class="type">
                                        <form>
                                            <div class="blc-select">
                                                <label>Type de ticket</label>
                                                <select>
                                                    <option>Offre VIP</option>
                                                    <option>lorem ipsum</option>

                                                </select>
                                            </div>
                                            <div class="blc-nbr d-flex">
                                                <div class="col">
                                                    <label>Adulte</label>
                                                    <div class="numbers-row">
                                                        <div class="dec button"><span>-</span></div>
                                                        <input type="text" name="qtt" id="qtt" value="1" class="qtt">
                                                        <div class="inc button"><span>+</span></div>    
                                                    </div>
                                                </div>
                                                <div class="col">
                                                    <label>Enfant <span class="info"><img src="{{ asset('vente-ticket/images/info.png') }}"><div class="tooltip">Un ticket est requis pour les enfants de plus de 10 ans</div></span></label>
                                                    <div class="numbers-row">
                                                        <div class="dec button"><span>-</span></div>
                                                        <input type="text" name="qtt" id="qtt" value="1" class="qtt">
                                                        <div class="inc button"><span>+</span></div>    
                                                    </div>
                                                </div>
                                                <div class="col btn-ok">
                                                    <button class="btn ok">OK</button>
                                                </div>


                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <div class="pagination">
                        <ul>
                            <li class="prev"><a href="#"></a></li>
                            <li class="selected"><a href="#">1</a></li>
                            <li><a href="#">2</a></li>
                            <li><a href="#">3</a></li>
                            <li><a href="#">4</a></li>
                            <li class="next"><a href="#"></a></li>
                        </ul>
                    </div>

                    
                </div>
            </section>
        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
{% endblock %}


