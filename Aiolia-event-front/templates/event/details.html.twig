                        {% for i in 1..2 %}
                        <div class="item  wow fadeInUp" data-wow-delay="300ms">
                            <div class="inner">
                                <div class="blc-col1">
                                    <div class="col1">
                                        <div class="date">
                                            <span>Dimanche</span>
                                            <strong>20</strong>
                                            <span class="text-upper">juil. 2025</span>
                                        </div>
                                        <div class="hour">
                                            à 20:00
                                        </div>
                                        <div class="code-barre">
                                            <img src="{{ asset('vente-ticket/images/code1.png') }}">
                                        </div>
                                    </div>
                                    <div class="col2">
                                        <span class="bandeau">Soirée live</span>
                                        <h3>Music on Sunday</h3>
                                        <div class="adresse">Lieu : Analakely au Café de la Gare</div>
                                        <div class="tarif">Tarifs : 50.000MGA - 150.000MGA</div>
                                        <div class="blcBtn ">
                                            <a href="#" class="btn ticket">Acheter un ticket</a>
                                            <a href="#" class="btn details">détails</a>

                                        </div>
                                    </div>
                                    
                                </div>
                                <div class="blc-col2">
                                    <div class="img">
                                        <img src="{{ asset('vente-ticket/images/img1.png') }}" alt="ventes tickets">
                                    </div>  
                                </div>
                                <div class="blc-col3">
                                    <h3>Option sur le ticket</h3>
                                    <div class="type">
                                        <form>
                                            <div class="blc-select">
                                                <label>Type de ticket</label>
                                                <select>
                                                    <option>Offre VIP</option>
                                                    <option>lorem ipsum</option>

                                                </select>
                                            </div>
                                            <div class="blc-nbr d-flex">
                                                <div class="col">
                                                    <label>Adulte</label>
                                                    <div class="numbers-row">
                                                        <div class="dec button"><span>-</span></div>
                                                        <input type="text" name="qtt" id="qtt" value="1" class="qtt">
                                                        <div class="inc button"><span>+</span></div>    
                                                    </div>
                                                </div>
                                                <div class="col">
                                                    <label>Enfant <span class="info"><img src="{{ asset('vente-ticket/images/info.png') }}"><div class="tooltip">Un ticket est requis pour les enfants de plus de 10 ans</div></span></label>
                                                    <div class="numbers-row">
                                                        <div class="dec button"><span>-</span></div>
                                                        <input type="text" name="qtt" id="qtt" value="1" class="qtt">
                                                        <div class="inc button"><span>+</span></div>    
                                                    </div>
                                                </div>
                                                <div class="col btn-ok">
                                                    <button class="btn ok">OK</button>
                                                </div>


                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    

                    
                </div>
            </section>
        </main>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/wow.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/slick.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('vente-ticket/js/jquery-ui.js') }}"></script>  
        <script type="text/javascript" src="{{ asset('vente-ticket/js/custom.js') }}"></script>
{% endblock %}


