                            </div>
                            <div class="lst-hack">
                                <ul class="d-flex">
                                    <li>#jazz</li>
                                    <li>#cafédelagare</li>
                                    <li>#live</li>
                                    <li>#soirée</li>
                                </ul>
                            </div>

                        </div>

                        <div class="blc-video wow fadeInUp" data-wow-delay="300ms">
                            <h3>Vidéo de présentation de l'évènement</h3>
                            <div class="video-container">
                              <video id="video1" width="1506" height="750" poster="{{ asset('vente-ticket/images/poster.jpg') }}">
                                <source src="{{ asset('vente-ticket/video/video.mp4') }}" type="video/mp4">   
                              </video>
                              <button class="play-btn" data-video="video1"></button>
                            </div>
                        </div>

                        <div class="blc-map wow fadeInUp" data-wow-delay="300ms">
                            <h3>Lieu de l'évènement</h3>
                            <div class="map">
                                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7549.281261584579!2d47.52111267994531!3d-18.90301741478975!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x21f07e02f859da69%3A0x71d77dd98fe324ac!2sGrand%20Caf%C3%A9%20de%20la%20Gare!5e0!3m2!1sfr!2smg!4v1754476892148!5m2!1sfr!2smg" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="sec-event all-event">
