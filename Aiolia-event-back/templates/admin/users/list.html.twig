{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - Aiolia Event{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1 data-i18n-fr="Gestion des utilisateurs" data-i18n-en="User management">Gestion des utilisateurs</h1>
            <p class="dashboard-subtitle" data-i18n-fr="Gérez et administrez les comptes utilisateurs de votre plateforme" data-i18n-en="Manage and administer your platform user accounts">
                Gérez et administrez les comptes utilisateurs de votre plateforme
            </p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" onclick="exportUsers()">
                <i class="fas fa-download"></i>
                <span data-i18n-fr="Exporter" data-i18n-en="Export">Exporter</span>
            </button>
        </div>
    </div>

    <!-- Cartes de statistiques rapides -->
    <div class="stats-grid stats-grid-compact">
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-primary">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.total|default(0) }}</h3>
                <p data-i18n-fr="Utilisateurs totaux" data-i18n-en="Total users">Utilisateurs totaux</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-warning">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.pending|default(0) }}</h3>
                <p data-i18n-fr="En attente" data-i18n-en="Pending">En attente</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.active|default(0) }}</h3>
                <p data-i18n-fr="Utilisateurs actifs" data-i18n-en="Active users">Utilisateurs actifs</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-info">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.organizers|default(0) }}</h3>
                <p data-i18n-fr="Organisateurs" data-i18n-en="Organizers">Organisateurs</p>
            </div>
        </div>
    </div>

    <!-- Recherche (séparée) -->
    <div class="search-section">
        <div class="search-header">
            <h3 style="font-size: 1.1rem; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-search"></i>
                <span data-i18n-fr="Recherche multicritère" data-i18n-en="Multi-criteria search">Recherche multicritère</span>
            </h3>
            
        </div>

        <div class="search-form" id="searchFormUsers" aria-hidden="false">
            <form method="get">
                <div class="search-grid">
                    <div class="search-field">
                        <label data-i18n-fr="Recherche (Nom, Email, Téléphone)" data-i18n-en="Search (Name, Email, Phone)">Recherche (Nom, Email, Téléphone)</label>
                        <input type="text" name="search" class="form-input" value="{{ search }}" placeholder="Rechercher par nom, email ou téléphone..." data-i18n-target="placeholder" data-i18n-fr="Rechercher par nom, email ou téléphone..." data-i18n-en="Search by name, email or phone...">
                    </div>

                    <div class="search-field">
                        <label data-i18n-fr="Rôle" data-i18n-en="Role">Rôle</label>
                        <select name="role" class="form-input">
                            <option value="" data-i18n-fr="Tous les rôles" data-i18n-en="All roles">Tous les rôles</option>
                            <option value="user" {{ currentRole == 'user' ? 'selected' : '' }} data-i18n-fr="Utilisateur" data-i18n-en="User">Utilisateur</option>
                            <option value="organizer" {{ currentRole == 'organizer' ? 'selected' : '' }} data-i18n-fr="Organisateur" data-i18n-en="Organizer">Organisateur</option>
                            <option value="admin" {{ currentRole == 'admin' ? 'selected' : '' }} data-i18n-fr="Administrateur" data-i18n-en="Administrator">Administrateur</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n-fr="Statut" data-i18n-en="Status">Statut</label>
                        <select name="status" class="form-input">
                            <option value="" data-i18n-fr="Tous les statuts" data-i18n-en="All statuses">Tous les statuts</option>
                            <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }} data-i18n-fr="Actif" data-i18n-en="Active">Actif</option>
                            <option value="pending_validation" {{ currentStatus == 'pending_validation' ? 'selected' : '' }} data-i18n-fr="En attente" data-i18n-en="Pending">En attente</option>
                            <option value="rejected" {{ currentStatus == 'rejected' ? 'selected' : '' }} data-i18n-fr="Rejeté" data-i18n-en="Rejected">Rejeté</option>
                            <option value="suspended" {{ currentStatus == 'suspended' ? 'selected' : '' }} data-i18n-fr="Suspendu" data-i18n-en="Suspended">Suspendu</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n-fr="Trier par" data-i18n-en="Sort by">Trier par</label>
                        <select name="sort" class="form-input">
                            <option value="created_at" {{ currentSort == 'created_at' ? 'selected' : '' }} data-i18n-fr="Date création" data-i18n-en="Creation date">Date création</option>
                            <option value="email" {{ currentSort == 'email' ? 'selected' : '' }} data-i18n-fr="Email" data-i18n-en="Email">Email</option>
                            <option value="first_name" {{ currentSort == 'first_name' ? 'selected' : '' }} data-i18n-fr="Prénom" data-i18n-en="First name">Prénom</option>
                            <option value="last_name" {{ currentSort == 'last_name' ? 'selected' : '' }} data-i18n-fr="Nom" data-i18n-en="Last name">Nom</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n-fr="Ordre" data-i18n-en="Order">Ordre</label>
                        <select name="order" class="form-input">
                            <option value="DESC" {{ currentOrder == 'DESC' ? 'selected' : '' }} data-i18n-fr="Décroissant" data-i18n-en="Descending">Décroissant</option>
                            <option value="ASC" {{ currentOrder == 'ASC' ? 'selected' : '' }} data-i18n-fr="Croissant" data-i18n-en="Ascending">Croissant</option>
                        </select>
                    </div>
                </div>

                <div class="search-actions">
                    <button type="submit" class="btn btn-primary" style="background: var(--accent); color: var(--text-inverse); border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                        <i class="fas fa-search"></i>
                        <span data-i18n-fr="Rechercher" data-i18n-en="Search">Rechercher</span>
                    </button>
                    <a href="{{ path('admin_users_list') }}" class="btn btn-secondary" style="background: var(--bg-secondary); color: var(--text-secondary); border: 2px solid var(--border-color); padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                        <i class="fas fa-redo"></i>
                        <span data-i18n-fr="Réinitialiser" data-i18n-en="Reset">Réinitialiser</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Carte principale -->
    <div class="card">

        <div class="card-body">
            <!-- Tableau des utilisateurs -->
            <div class="table-responsive">
                <table class="table table-hover users-table" id="usersTable" data-show-url-base="{{ path('admin_users_show', {id: 0}) }}">
                    <thead>
                        <tr>
                            <th class="select-column">
                                <input type="checkbox" id="selectAll" class="form-check-input" aria-label="Select all" data-i18n-attributes="aria-label" data-i18n-attr-aria-label-fr="Tout sélectionner" data-i18n-attr-aria-label-en="Select all">
                            </th>
                            <th class="col-left" data-i18n-fr="Utilisateur" data-i18n-en="User">Utilisateur</th>
                            <th class="col-left" data-i18n-fr="Contact" data-i18n-en="Contact">Contact</th>
                            <th class="col-left" data-i18n-fr="Rôle" data-i18n-en="Role">Rôle</th>
                            <th class="col-left" data-i18n-fr="Statut" data-i18n-en="Status">Statut</th>
                            <th class="col-left" data-i18n-fr="Activité" data-i18n-en="Activity">Activité</th>
                            <th class="actions-column col-center" data-i18n-fr="Actions" data-i18n-en="Actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if users is empty %}
                        <tr>
                            <td colspan="7" class="text-center" style="padding: 40px;">
                                <p style="color: var(--text-secondary);" data-i18n-fr="Aucun utilisateur trouvé" data-i18n-en="No users found">Aucun utilisateur trouvé</p>
                            </td>
                        </tr>
                        {% else %}
                        {% for user in users %}
                        <tr data-user-id="{{ user.id }}">
                            <td class="select-column">
                                <input type="checkbox" class="form-check-input user-checkbox" value="{{ user.id }}">
                            </td>
                            <td class="col-left">
                                <div class="user-info">
                                    <div class="user-avatar-sm">
                                        {% if user.photoUrl %}
                                            <img src="{{ user.photoUrl }}" alt="{{ user.fullName }}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
                                        {% else %}
                                            <div class="user-avatar-initials-sm">
                                                {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="user-details">
                                        <strong class="user-name">{{ user.fullName }}</strong>
                                        <small class="user-id">ID: {{ user.id }}</small>
                                    </div>
                                </div>
                            </td>
                            <td class="col-left">
                                <div class="contact-info">
                                    <div class="email">
                                        <i class="fas fa-envelope"></i>
                                        {{ user.email }}
                                    </div>
                                    {% if user.phone %}
                                    <div class="phone">
                                        <i class="fas fa-phone"></i>
                                        {{ user.phone }}
                                    </div>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="col-left">
                                {% if user.role == 'admin' %}
                                <span class="badge role-badge role-admin">
                                    <i class="fas fa-crown"></i> <span data-i18n-fr="Admin" data-i18n-en="Admin">Admin</span>
                                </span>
                                {% elseif user.role == 'organizer' %}
                                <span class="badge role-badge role-organizer">
                                    <i class="fas fa-calendar-alt"></i> <span data-i18n-fr="Organisateur" data-i18n-en="Organizer">Organisateur</span>
                                </span>
                                {% else %}
                                <span class="badge role-badge role-user">
                                    <i class="fas fa-user"></i> <span data-i18n-fr="Utilisateur" data-i18n-en="User">Utilisateur</span>
                                </span>
                                {% endif %}
                            </td>
                            <td class="col-left">
                                {% if user.accountStatus == 'active' or (user.accountStatus is empty and user.isActive) %}
                                <span class="badge status-badge status-active">
                                    <i class="fas fa-check-circle"></i> <span data-i18n-fr="Actif" data-i18n-en="Active">Actif</span>
                                </span>
                                {% elseif user.accountStatus == 'pending_validation' %}
                                    <span class="badge status-badge status-pending">
                                        <i class="fas fa-clock"></i> <span data-i18n-fr="En attente" data-i18n-en="Pending">En attente</span>
                                </span>
                                {% elseif user.accountStatus == 'rejected' %}
                                <span class="badge status-badge status-rejected">
                                    <i class="fas fa-times-circle"></i> <span data-i18n-fr="Rejeté" data-i18n-en="Rejected">Rejeté</span>
                                </span>
                                {% elseif user.accountStatus == 'suspended' %}
                                    <span class="badge status-badge status-suspended">
                                        <i class="fas fa-pause-circle"></i> <span data-i18n-fr="Suspendu" data-i18n-en="Suspended">Suspendu</span>
                                </span>
                                {% else %}
                                <span class="badge status-badge status-active">
                                    <i class="fas fa-check-circle"></i> <span data-i18n-fr="Actif" data-i18n-en="Active">Actif</span>
                                </span>
                                {% endif %}
                            </td>
                            <td class="col-left">
                                <div class="activity-info">
                                    <div class="created-date">
                                        <small data-i18n-target="html" data-i18n-fr="Créé le {{ user.createdAt|date('d/m/Y') }}" data-i18n-en="Created on {{ user.createdAt|date('d/m/Y') }}">Créé le {{ user.createdAt|date('d/m/Y') }}</small>
                                    </div>
                                    <div class="last-login">
                                        <small data-i18n-target="html" data-i18n-fr="Dernière activité&nbsp;: {{ user.lastLoginAt ? user.lastLoginAt|date('d/m/Y') : 'Jamais' }}" data-i18n-en="Last activity:&nbsp;{{ user.lastLoginAt ? user.lastLoginAt|date('d/m/Y') : 'Never' }}">Dernière activité: {{ user.lastLoginAt ? user.lastLoginAt|date('d/m/Y') : 'Jamais' }}</small>
                                    </div>
                                </div>
                            </td>
                            <td class="actions-column col-center">
                                <div class="action-buttons">
                                    <a href="{{ path('admin_users_show', {id: user.id}) }}" class="btn btn-action btn-view" title="Voir détails" data-bs-toggle="tooltip" data-i18n-attributes="title" data-i18n-attr-title-fr="Voir détails" data-i18n-attr-title-en="View details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_users_show', {id: user.id}) }}" 
                                       class="btn btn-action btn-edit"
                                            title="Modifier"
                                       data-bs-toggle="tooltip"
                                       data-i18n-attributes="title"
                                       data-i18n-attr-title-fr="Modifier"
                                       data-i18n-attr-title-en="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="POST" action="{{ path('admin_users_toggle_status', {id: user.id}) }}" style="display: inline;" onsubmit="return handleStatusConfirm(this);" data-confirm-fr="Voulez-vous changer le statut de cet utilisateur ?" data-confirm-en="Do you want to change this user's status?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ user.id) }}">
                                        <button type="submit" 
                                                class="btn btn-action btn-status"
                                            title="Changer statut"
                                                data-bs-toggle="tooltip"
                                                data-i18n-attributes="title"
                                                data-i18n-attr-title-fr="Changer le statut"
                                                data-i18n-attr-title-en="Change status">
                                        <i class="fas fa-cog"></i>
                                    </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            {% if totalPages > 1 %}
            <div class="pagination-section">
                <nav aria-label="Pagination">
                    <ul class="pagination pagination-horizontal">
                        <!-- Bouton Précédent -->
                        <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                            <a class="page-link" 
                               href="{{ path('admin_users_list', {
                                   'page': currentPage - 1,
                                   'search': search,
                                   'role': currentRole,
                                   'status': currentStatus,
                                   'sort': currentSort,
                                   'order': currentOrder
                               }) }}" 
                               aria-label="Précédent" data-i18n-attributes="aria-label" data-i18n-attr-aria-label-fr="Précédent" data-i18n-attr-aria-label-en="Previous">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        
                        <!-- Pages numérotées -->
                        {% set startPage = max(1, currentPage - 2) %}
                        {% set endPage = min(totalPages, currentPage + 2) %}
                        
                        {% if startPage > 1 %}
                        <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    'page': 1,
                                    'search': search,
                                    'role': currentRole,
                                    'status': currentStatus,
                                    'sort': currentSort,
                                    'order': currentOrder
                                }) }}">1</a>
                            </li>
                            {% if startPage > 2 %}
                                <li class="page-item disabled">
                                    <span class="page-link" data-i18n-fr="..." data-i18n-en="...">...</span>
                                </li>
                            {% endif %}
                        {% endif %}
                        
                        {% for p in startPage..endPage %}
                            <li class="page-item {{ p == currentPage ? 'active' : '' }}">
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    'page': p,
                                    'search': search,
                                    'role': currentRole,
                                    'status': currentStatus,
                                    'sort': currentSort,
                                    'order': currentOrder
                                }) }}">{{ p }}</a>
                            </li>
                        {% endfor %}
                        
                        {% if endPage < totalPages %}
                            {% if endPage < totalPages - 1 %}
                                <li class="page-item disabled">
                                    <span class="page-link" data-i18n-fr="..." data-i18n-en="...">...</span>
                                </li>
                            {% endif %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    'page': totalPages,
                                    'search': search,
                                    'role': currentRole,
                                    'status': currentStatus,
                                    'sort': currentSort,
                                    'order': currentOrder
                                }) }}">{{ totalPages }}</a>
                            </li>
                        {% endif %}
                        
                        <!-- Bouton Suivant -->
                        <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                            <a class="page-link" 
                               href="{{ path('admin_users_list', {
                                   'page': currentPage + 1,
                                   'search': search,
                                   'role': currentRole,
                                   'status': currentStatus,
                                   'sort': currentSort,
                                   'order': currentOrder
                               }) }}" 
                               aria-label="Suivant" data-i18n-attributes="aria-label" data-i18n-attr-aria-label-fr="Suivant" data-i18n-attr-aria-label-en="Next">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
                <div style="text-align: center; padding: 10px; color: var(--text-secondary); font-size: 0.9rem;">
                    <small data-i18n-target="html" data-i18n-fr="Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total" data-i18n-en="Page {{ currentPage }} of {{ totalPages }} - Showing {{ users|length }} user(s) out of {{ totalUsersFiltered }} total">Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total</small>
            </div>
        </div>
            {% elseif users|length > 0 %}
            <div class="pagination-section">
                <div style="text-align: center; padding: 20px; color: var(--text-secondary);">
                    <small data-i18n-target="html" data-i18n-fr="Affichage de {{ users|length }} utilisateur(s)" data-i18n-en="Showing {{ users|length }} user(s)">Affichage de {{ users|length }} utilisateur(s)</small>
    </div>
      </div>
            {% endif %}
  </div>
</div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
(function registerAdminUsersTranslations() {
    if (!window.languageManager) {
        return;
    }

    window.languageManager.extendTranslations({
        fr: {
            'admin.users.export.no_selection': 'Veuillez sélectionner au moins un utilisateur à exporter.',
            'admin.users.export.success': 'Export des utilisateurs : {list}',
            'admin.users.stats.alert': 'Affichage des statistiques utilisateurs'
        },
        en: {
            'admin.users.export.no_selection': 'Please select at least one user to export.',
            'admin.users.export.success': 'Exporting users: {list}',
            'admin.users.stats.alert': 'Displaying user statistics'
        }
    });
})();

function translateInline(key, fallback, params = {}) {
    const manager = window.languageManager;
    if (manager) {
        const translation = manager.translate(key, params);
        if (translation) {
            return translation;
        }
    }
    return fallback;
}

function handleStatusConfirm(form) {
    const manager = window.languageManager;
    const lang = manager ? manager.getLanguage() : 'fr';
    const datasetKey = lang === 'en' ? 'confirmEn' : 'confirmFr';
    const fallback = form.dataset.confirmFr || 'Voulez-vous changer le statut de cet utilisateur ?';
    const message = form.dataset[datasetKey] || fallback;
    return window.confirm(message);
}

// Init simple (sans toggle) : tooltips + sélection multiple
function initUsersPage() {
    // Initialiser les tooltips Bootstrap
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Sélection multiple
    const selectAll = document.getElementById('selectAll');
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.user-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });
    }

}
// Fonction supprimée - Les détails utilisateur sont maintenant accessibles via la page dédiée

function navigateToUserDetails(btn) {
    const tr = btn.closest('tr');
    if (!tr) return;
    const userId = tr.getAttribute('data-user-id');
    const table = document.getElementById('usersTable');
    const base = table ? table.getAttribute('data-show-url-base') : null;
    if (!userId || !base) return;
    // Remplacer le dernier segment numérique (ex: /0) par l'ID réel
    const url = base.replace(/\/(\d+)(?:\/?$)/, '/' + userId);
    window.location.href = url;
}

document.addEventListener('DOMContentLoaded', initUsersPage);
document.addEventListener('turbo:load', initUsersPage);
document.addEventListener('turbo:render', initUsersPage);
document.addEventListener('turbo:frame-load', initUsersPage);
window.addEventListener('pageshow', initUsersPage);

function toggleUserSelection() {
    const checkboxes = document.querySelectorAll('.user-checkbox');
    const selectAll = document.getElementById('selectAll');
    
    checkboxes.forEach(checkbox => {
        checkbox.checked = false;
    });
    if (selectAll) {
        selectAll.checked = false;
    }
    
    const selectColumns = document.querySelectorAll('.select-column');
    selectColumns.forEach(column => {
        column.classList.toggle('visible');
    });
}

function exportUsers() {
    const selectedCheckboxes = document.querySelectorAll('.user-checkbox:checked');
    const selectedUsers = Array.from(selectedCheckboxes).map(checkbox => checkbox.value);
    
    if (selectedUsers.length === 0) {
        alert(translateInline('admin.users.export.no_selection', 'Veuillez sélectionner au moins un utilisateur à exporter.'));
        return;
    }
    
    alert(translateInline('admin.users.export.success', 'Export des utilisateurs : {list}', { list: selectedUsers.join(', ') }));
}

function showUserStats() {
