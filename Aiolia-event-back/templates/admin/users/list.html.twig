{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - Aiolia Event{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1>Gestion des utilisateurs</h1>
            <p class="dashboard-subtitle">
                Gérez et administrez les comptes utilisateurs de votre plateforme
            </p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" onclick="exportUsers()">
                <i class="fas fa-download"></i>
                Exporter
            </button>
        </div>
    </div>

    <!-- Cartes de statistiques rapides -->
    <div class="stats-grid stats-grid-compact">
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-primary">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3>156</h3>
                <p>Utilisateurs totaux</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-warning">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <h3>12</h3>
                <p>En attente</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <h3>134</h3>
                <p>Utilisateurs actifs</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-info">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="stat-content">
                <h3>5</h3>
                <p>Administrateurs</p>
            </div>
        </div>
    </div>

    <!-- Carte principale -->
    <div class="card">
        <div class="card-header">
            <div class="card-header-content">
                <div>
                    <h4 class="mb-0">
                        <i class="fas fa-users-cog"></i> Liste des utilisateurs
                    </h4>
                    <p class="card-subtitle">Filtrez et gérez les comptes utilisateurs</p>
                </div>
                <div class="card-header-actions">
                    <span class="users-count">8 utilisateur(s)</span>
                </div>
            </div>
        </div>

        <div class="card-body">
            {# Recherche et filtres avancés #}
            <div class="filters-section">
                <form method="get" class="filters-form">
                    <div class="filters-grid">
                        <!-- Recherche principale -->
                        <div class="filter-group">
                            <label class="form-label">
                                <i class="fas fa-search"></i> Recherche
                            </label>
                            <div class="search-input-wrapper">
                                <input type="text" 
                                       name="search" 
                                       class="search-input" 
                                       value="" 
                                       placeholder="Nom, email, téléphone..."
                                       id="searchInput">
                                <i class="fas fa-search search-icon"></i>
                            </div>
                        </div>

                        <!-- Filtres rapides -->
                        <div class="filter-group">
                            <label class="form-label">
                                <i class="fas fa-user-tag"></i> Rôle
                            </label>
                            <select name="role" class="form-select filter-select">
                                <option value="">Tous les rôles</option>
                                <option value="user">Utilisateur</option>
                                <option value="organizer">Organisateur</option>
                                <option value="co_organizer">Co-organisateur</option>
                                <option value="admin">Administrateur</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label class="form-label">
                                <i class="fas fa-toggle-on"></i> Statut
                            </label>
                            <select name="status" class="form-select filter-select">
                                <option value="">Tous les statuts</option>
                                <option value="active">Actif</option>
                                <option value="pending_validation">En attente</option>
                                <option value="rejected">Rejeté</option>
                                <option value="suspended">Suspendu</option>
                            </select>
                        </div>

                        <!-- Tri -->
                        <div class="filter-group">
                            <label class="form-label">
                                <i class="fas fa-sort"></i> Trier par
                            </label>
                            <select name="sort" class="form-select filter-select">
                                <option value="created_at">Date création</option>
                                <option value="email">Email</option>
                                <option value="first_name">Prénom</option>
                                <option value="last_name">Nom</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label class="form-label">
                                <i class="fas fa-arrow-down-up-across-line"></i> Ordre
                            </label>
                            <select name="order" class="form-select filter-select">
                                <option value="DESC">Décroissant</option>
                                <option value="ASC">Croissant</option>
                            </select>
                        </div>
                    </div>

                    <div class="filters-actions">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-filter"></i> Appliquer les filtres
                        </button>
                        <a href="{{ path('admin_users_list') }}" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-redo"></i> Réinitialiser
                        </a>
                    </div>
                </form>
