{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-users"></i> Gestion des utilisateurs
                    </h4>
                </div>
                <div class="card-body">
                    {# Recherche multi-critères #}
                    <div class="search-container">
                        <form method="get" class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">
                                    <i class="fas fa-search"></i> Recherche (nom, email)
                                </label>
                                <input type="text" 
                                       name="search" 
                                       class="search-input" 
                                       value="{{ search }}" 
                                       placeholder="Rechercher un utilisateur..."
                                       id="searchInput">
                            </div>
                            
                            <div class="col-md-2">
                                <label class="form-label">
                                    <i class="fas fa-user-tag"></i> Rôle
                                </label>
                                <select name="role" class="form-select">
                                    <option value="">Tous les rôles</option>
                                    <option value="user" {{ currentRole == 'user' ? 'selected' : '' }}>Utilisateur</option>
                                    <option value="organizer" {{ currentRole == 'organizer' ? 'selected' : '' }}>Organisateur</option>
                                    <option value="co_organizer" {{ currentRole == 'co_organizer' ? 'selected' : '' }}>Co-organisateur</option>
                                    <option value="admin" {{ currentRole == 'admin' ? 'selected' : '' }}>Administrateur</option>
                                </select>
                            </div>
                            
                            <div class="col-md-2">
                                <label class="form-label">
                                    <i class="fas fa-toggle-on"></i> Statut
                                </label>
                                <select name="status" class="form-select">
                                    <option value="">Tous les statuts</option>
                                    <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }}>Actif</option>
                                    <option value="pending_validation" {{ currentStatus == 'pending_validation' ? 'selected' : '' }}>En attente</option>
                                    <option value="rejected" {{ currentStatus == 'rejected' ? 'selected' : '' }}>Rejeté</option>
                                    <option value="suspended" {{ currentStatus == 'suspended' ? 'selected' : '' }}>Suspendu</option>
                                </select>
                            </div>
                            
                            <div class="col-md-2">
                                <label class="form-label">
                                    <i class="fas fa-sort"></i> Trier par
                                </label>
                                <select name="sort" class="form-select">
                                    <option value="created_at" {{ currentSort == 'created_at' ? 'selected' : '' }}>Date création</option>
                                    <option value="email" {{ currentSort == 'email' ? 'selected' : '' }}>Email</option>
                                    <option value="first_name" {{ currentSort == 'first_name' ? 'selected' : '' }}>Prénom</option>
                                    <option value="last_name" {{ currentSort == 'last_name' ? 'selected' : '' }}>Nom</option>
                                </select>
                            </div>
                            
                            <div class="col-md-2">
                                <label class="form-label">
                                    <i class="fas fa-arrow-down-up-across-line"></i> Ordre
                                </label>
                                <select name="order" class="form-select">
                                    <option value="DESC" {{ currentOrder == 'DESC' ? 'selected' : '' }}>Décroissant</option>
                                    <option value="ASC" {{ currentOrder == 'ASC' ? 'selected' : '' }}>Croissant</option>
                                </select>
                            </div>
                            
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Rechercher
                                </button>
                                <a href="{{ path('admin_users_list') }}" class="btn btn-secondary">
                                    <i class="fas fa-redo"></i> Réinitialiser
                                </a>
                            </div>
                        </form>
                    </div>

                    {# Résultats #}
                    {% if users is empty %}
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i>
                            Aucun utilisateur trouvé
                        </div>
                    {% else %}
                        <div class="mb-3">
                            <span class="badge bg-primary">{{ users|length }} utilisateur(s) trouvé(s)</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Nom complet</th>
                                        <th>Email</th>
                                        <th>Téléphone</th>
                                        <th>Rôle</th>
                                        <th>Statut</th>
                                        <th>Date création</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in users %}
                                        <tr>
                                            <td>{{ user.id }}</td>
                                            <td>
                                                <strong>{{ user.fullName }}</strong>
                                            </td>
                                            <td>{{ user.email }}</td>
                                            <td>{{ user.phone ?? '-' }}</td>
                                            <td>
                                                {% if user.role == 'admin' %}
                                                    <span class="badge bg-danger">Administrateur</span>
                                                {% elseif user.role == 'organizer' %}
                                                    <span class="badge bg-primary">Organisateur</span>
                                                {% elseif user.role == 'co_organizer' %}
                                                    <span class="badge bg-info">Co-organisateur</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Utilisateur</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if user.accountStatus == 'active' %}
                                                    <span class="badge bg-success">Actif</span>
                                                {% elseif user.accountStatus == 'pending_validation' %}
                                                    <span class="badge bg-warning">En attente</span>
                                                {% elseif user.accountStatus == 'rejected' %}
                                                    <span class="badge bg-danger">Rejeté</span>
                                                {% else %}
                                                    <span class="badge bg-dark">Suspendu</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ user.createdAt|date('d/m/Y') }}</td>
                                            <td>
                                                <a href="{{ path('admin_users_show', {id: user.id}) }}" 
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Voir détails">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialiser Select2 pour l'autocomplete
    $('#searchInput').select2({
        ajax: {
            url: '{{ path('admin_users_autocomplete') }}',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    q: params.term
                };
            },
            processResults: function (data) {
                return {
                    results: data
                };
            },
            cache: true
        },
        minimumInputLength: 2,
        placeholder: 'Rechercher un utilisateur...',
        allowClear: true
    });
});
</script>
{% endblock %}

