{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - Aiolia Event{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1 data-i18n-fr="Gestion des utilisateurs" data-i18n-en="User management">Gestion des utilisateurs</h1>
            <p class="dashboard-subtitle" data-i18n-fr="Gérez et administrez les comptes utilisateurs de votre plateforme" data-i18n-en="Manage and administer your platform user accounts">
                Gérez et administrez les comptes utilisateurs de votre plateforme
            </p>
        </div>
    </div>

    <!-- Cartes de statistiques rapides -->
    <div class="stats-grid stats-grid-compact">
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-primary">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.total|default(0) }}</h3>
                <p data-i18n-fr="Utilisateurs totaux" data-i18n-en="Total users">Utilisateurs totaux</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-warning">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.pending|default(0) }}</h3>
                <p data-i18n-fr="En attente" data-i18n-en="Pending">En attente</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.active|default(0) }}</h3>
                <p data-i18n-fr="Utilisateurs actifs" data-i18n-en="Active users">Utilisateurs actifs</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-info">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.organizers|default(0) }}</h3>
                <p data-i18n-fr="Organisateurs" data-i18n-en="Organizers">Organisateurs</p>
            </div>
        </div>
    </div>

    <!-- Recherche (séparée) -->
    <div class="search-section">
        <div class="search-header">
            <h3 style="font-size: 1.1rem; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-search"></i>
                <span data-i18n-fr="Recherche multicritère" data-i18n-en="Multi-criteria search">Recherche multicritère</span>
            </h3>
            
        </div>

        <div class="search-form" id="searchFormUsers" aria-hidden="false">
            <form method="get">
                <div class="search-grid">
                    <div class="search-field">
                        <label data-i18n-fr="Recherche (Nom, Email, Téléphone)" data-i18n-en="Search (Name, Email, Phone)">Recherche (Nom, Email, Téléphone)</label>
                        <input type="text" name="search" class="form-input" value="{{ search }}" placeholder="Rechercher par nom, email ou téléphone..." data-i18n-target="placeholder" data-i18n-fr="Rechercher par nom, email ou téléphone..." data-i18n-en="Search by name, email or phone...">
                    </div>

                    <div class="search-field">
                        <label data-i18n-fr="Rôle" data-i18n-en="Role">Rôle</label>
                        <select name="role" class="form-input">
                            <option value="" data-i18n-fr="Tous les rôles" data-i18n-en="All roles">Tous les rôles</option>
                            <option value="user" {{ currentRole == 'user' ? 'selected' : '' }} data-i18n-fr="Utilisateur" data-i18n-en="User">Utilisateur</option>
                            <option value="organizer" {{ currentRole == 'organizer' ? 'selected' : '' }} data-i18n-fr="Organisateur" data-i18n-en="Organizer">Organisateur</option>
                            <option value="admin" {{ currentRole == 'admin' ? 'selected' : '' }} data-i18n-fr="Administrateur" data-i18n-en="Administrator">Administrateur</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n-fr="Statut" data-i18n-en="Status">Statut</label>
                        <select name="status" class="form-input">
                            <option value="" data-i18n-fr="Tous les statuts" data-i18n-en="All statuses">Tous les statuts</option>
                            <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }} data-i18n-fr="Actif" data-i18n-en="Active">Actif</option>
                            <option value="pending_validation" {{ currentStatus == 'pending_validation' ? 'selected' : '' }} data-i18n-fr="En attente" data-i18n-en="Pending">En attente</option>
                            <option value="rejected" {{ currentStatus == 'rejected' ? 'selected' : '' }} data-i18n-fr="Rejeté" data-i18n-en="Rejected">Rejeté</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n-fr="Trier par" data-i18n-en="Sort by">Trier par</label>
                        <select name="sort" class="form-input">
                            <option value="created_at" {{ currentSort == 'created_at' ? 'selected' : '' }} data-i18n-fr="Date création" data-i18n-en="Creation date">Date création</option>
                            <option value="email" {{ currentSort == 'email' ? 'selected' : '' }} data-i18n-fr="Email" data-i18n-en="Email">Email</option>
                            <option value="first_name" {{ currentSort == 'first_name' ? 'selected' : '' }} data-i18n-fr="Prénom" data-i18n-en="First name">Prénom</option>
                            <option value="last_name" {{ currentSort == 'last_name' ? 'selected' : '' }} data-i18n-fr="Nom" data-i18n-en="Last name">Nom</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n-fr="Ordre" data-i18n-en="Order">Ordre</label>
                        <select name="order" class="form-input">
                            <option value="DESC" {{ currentOrder == 'DESC' ? 'selected' : '' }} data-i18n-fr="Décroissant" data-i18n-en="Descending">Décroissant</option>
                            <option value="ASC" {{ currentOrder == 'ASC' ? 'selected' : '' }} data-i18n-fr="Croissant" data-i18n-en="Ascending">Croissant</option>
                        </select>
                    </div>
                </div>

                <div class="search-actions">
                    <button type="submit" class="btn btn-primary" style="background: #3498DB !important; color: var(--text-inverse); border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 500;">
                        <i class="fas fa-search"></i>
                        <span data-i18n-fr="Rechercher" data-i18n-en="Search">Rechercher</span>
                    </button>
                    <a href="{{ path('admin_users_list') }}" class="btn btn-secondary" style="background: var(--bg-secondary); color: var(--text-secondary); border: 2px solid var(--border-color); padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 500;">
                        <i class="fas fa-redo"></i>
                        <span data-i18n-fr="Réinitialiser" data-i18n-en="Reset">Réinitialiser</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Carte principale -->
    <div class="card validation-card">

        <div class="card-body">
            <!-- Tableau des utilisateurs -->
            <div class="table-responsive">
                <table class="table table-hover users-table validation-table" id="usersTable" data-show-url-base="{{ path('admin_users_show', {id: 0}) }}">
                    <thead>
                        <tr>
                            <th class="col-left" data-i18n-fr="Utilisateur" data-i18n-en="User">Utilisateur</th>
                            <th class="col-center" data-i18n-fr="Rôle" data-i18n-en="Role">Rôle</th>
                            <th class="col-center" data-i18n-fr="Statut" data-i18n-en="Status">Statut</th>
                            <th class="col-center" data-i18n-fr="Activité" data-i18n-en="Activity">Activité</th>
                            <th class="col-center actions-header" data-i18n-fr="Actions" data-i18n-en="Actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if users is empty %}
                        <tr>
                            <td colspan="7" class="text-center" style="padding: 40px;">
                                <p style="color: var(--text-secondary);" data-i18n-fr="Aucun utilisateur trouvé" data-i18n-en="No users found">Aucun utilisateur trouvé</p>
                            </td>
                        </tr>
                        {% else %}
                        {% for user in users %}
                        <tr data-user-id="{{ user.id }}">
                            <td class="col-left">
                                <div class="user-info">
                                    {% set avatarUrl = user.photoUrl %}
                                    {% if avatarUrl is empty %}
                                        {% set avatarUrl = null %}
                                    {% elseif avatarUrl matches '/^https?:\\/\\//' %}
                                        {% if avatarUrl starts with 'https://cdn.aiolia.test/avatars/' %}
                                            {% set avatarUrl = null %}
                                        {% endif %}
                                    {% else %}
                                        {% set avatarUrl = null %}
                                    {% endif %}
                                    <div class="user-avatar-sm">
                                        {% if avatarUrl %}
                                            <img src="{{ avatarUrl }}" alt="{{ user.fullName }}">
                                        {% else %}
                                            {% set initials = '' %}
                                            {% if user.firstName %}
                                            {% set initials = user.firstName|slice(0, 1) %}
                                            {% if user.lastName %}
                                                {% set initials = initials ~ user.lastName|slice(0, 1) %}
                                            {% elseif user.firstName|length > 1 %}
                                                {% set initials = initials ~ user.firstName|slice(1, 1) %}
                                            {% endif %}
                                            {% elseif user.fullName %}
                                                {% set nameParts = user.fullName|trim|split(' ')|filter(v => v is not empty) %}
                                                {% if nameParts|length > 0 %}
                                                {% set initials = nameParts|first|slice(0, 1) %}
                                                {% if nameParts|length > 1 %}
                                                    {% set initials = initials ~ nameParts|last|slice(0, 1) %}
                                                {% elseif nameParts|first|length > 1 %}
                                                    {% set initials = initials ~ nameParts|first|slice(1, 1) %}
                                                {% endif %}
                                                {% endif %}
                                            {% endif %}

                                            {% if initials is empty and user.email %}
                                                {% set localPart = user.email|split('@')|first %}
                                                {% if localPart|length >= 2 %}
                                                    {% set initials = localPart|slice(0, 2) %}
                                                {% else %}
                                                    {% set initials = localPart|slice(0, 1) ~ '?' %}
                                                {% endif %}
                                            {% endif %}

                                            {% if initials is empty %}
                                                {% set initials = 'AA' %}
                                            {% endif %}

                                            <div class="user-avatar-initials-sm">
                                                {{ initials|upper }}
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="user-details">
                                        <span class="user-name">{{ user.fullName }}</span>
                                        <div class="user-meta">
                                            <span class="user-email">
                                                <i class="fas fa-envelope"></i>{{ user.email }}
                                            </span>
                                            {% if user.phone %}
                                                <span class="user-phone">
                                                    <i class="fas fa-phone"></i>{{ user.phone }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="col-center">
                                {% if user.role == 'admin' %}
                                    <span class="badge role-badge role-admin" data-i18n-fr="Administrateur" data-i18n-en="Administrator">Administrateur</span>
                                {% elseif user.role == 'organizer' %}
                                    <span class="badge role-badge role-organizer" data-i18n-fr="Organisateur" data-i18n-en="Organizer">Organisateur</span>
                                {% else %}
                                    <span class="badge role-badge role-user" data-i18n-fr="Utilisateur" data-i18n-en="User">Utilisateur</span>
                                {% endif %}
                            </td>
                            <td class="col-center">
                                {% if user.accountStatus == 'active' or (user.accountStatus is empty and user.isActive) %}
                                    <span class="badge status-badge status-active" data-i18n-fr="Actif" data-i18n-en="Active">Actif</span>
                                {% elseif user.accountStatus == 'pending_validation' %}
                                    <span class="badge status-badge status-pending" data-i18n-fr="En attente" data-i18n-en="Pending">En attente</span>
                                {% elseif user.accountStatus == 'rejected' %}
                                    <span class="badge status-badge status-rejected" data-i18n-fr="Rejeté" data-i18n-en="Rejected">Rejeté</span>
                                {% else %}
                                    <span class="badge status-badge status-inactive" data-i18n-fr="Inactif" data-i18n-en="Inactive">Inactif</span>
                                {% endif %}
                            </td>
                            <td class="col-center">
                                <div class="date-info">
                                    <span class="date-primary" data-i18n-target="html" data-i18n-fr="Créé le {{ user.createdAt|date('d/m/Y') }}" data-i18n-en="Created on {{ user.createdAt|date('d/m/Y') }}">Créé le {{ user.createdAt|date('d/m/Y') }}</span>
                                </div>
                            </td>
                            <td class="col-center actions-cell">
                                {% set isPendingOrganizer = user.role == 'organizer' and user.accountStatus == 'pending_validation' %}
                                {% if isPendingOrganizer %}
                                    {# Organisateurs en attente de validation : Approuver/Rejeter #}
                                    <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                        <i class="fas fa-eye"></i><span data-i18n-fr="Voir le profil" data-i18n-en="View profile">Voir le profil</span>
                                    </a>
                                    <form method="POST" action="{{ path('admin_validation_approve', {id: user.id}) }}" class="d-inline" onsubmit="return confirmApprove(this);" data-confirm-fr="Approuver la demande de cet organisateur ?" data-confirm-en="Approve this organizer's request?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_user_' ~ user.id) }}">
                                        <button type="submit" class="validation-action-pill pill-approve">
                                            <i class="fas fa-check-circle"></i><span data-i18n-fr="Approuver" data-i18n-en="Approve">Approuver</span>
                                        </button>
                                    </form>
                                    <form method="POST" action="{{ path('admin_validation_reject', {id: user.id}) }}" class="d-inline" onsubmit="return confirmReject(this);" data-confirm-fr="Rejeter la demande de cet organisateur ?" data-confirm-en="Reject this organizer's request?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject_user_' ~ user.id) }}">
                                        <button type="submit" class="validation-action-pill pill-reject">
                                            <i class="fas fa-times-circle"></i><span data-i18n-fr="Rejeter" data-i18n-en="Reject">Rejeter</span>
                                        </button>
                                    </form>
                                {% else %}
                                    {% set isActive = user.accountStatus == 'active' or (user.accountStatus is empty and user.isActive) %}
                                    {% if isActive %}
                                        {# 3 boutons selon le rôle pour les comptes actifs #}
                                        {% if user.role == 'organizer' %}
                                            {# Organisateur : Voir profil, Paiements, Événements #}
                                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                                <i class="fas fa-eye"></i><span data-i18n-fr="Voir le profil" data-i18n-en="View profile">Voir le profil</span>
                                            </a>
                                            <a href="{{ path('admin_users_payments', {id: user.id}) }}" class="validation-action-pill pill-payments" title="Voir l'historique des paiements">
                                                <i class="fas fa-credit-card"></i><span data-i18n-fr="Paiements" data-i18n-en="Payments">Paiements</span>
                                            </a>
                                            <a href="{{ path('admin_users_events', {id: user.id}) }}" class="validation-action-pill pill-events">
                                                <i class="fas fa-calendar-alt"></i><span data-i18n-fr="Événements" data-i18n-en="Events">Événements</span>
                                            </a>
                                        {% elseif user.role == 'admin' %}
                                            {# Admin : Voir profil, Activité, Info #}
                                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                                <i class="fas fa-eye"></i><span data-i18n-fr="Voir le profil" data-i18n-en="View profile">Voir le profil</span>
                                            </a>
                                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-activity" title="Voir l'historique d'activité et les logs d'audit">
                                                <i class="fas fa-history"></i><span data-i18n-fr="Activité" data-i18n-en="Activity">Activité</span>
                                            </a>
                                            <a href="{{ path('admin_users_info', {id: user.id}) }}" class="validation-action-pill pill-info">
                                                <i class="fas fa-info-circle"></i><span data-i18n-fr="Informations" data-i18n-en="Information">Informations</span>
                                            </a>
                                        {% else %}
                                            {# User : Voir profil uniquement #}
                                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                                <i class="fas fa-eye"></i><span data-i18n-fr="Voir le profil" data-i18n-en="View profile">Voir le profil</span>
                                            </a>
                                        {% endif %}
                                    {% else %}
                                        {# Comptes non actifs : seulement Voir profil #}
                                        <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                            <i class="fas fa-eye"></i><span data-i18n-fr="Voir le profil" data-i18n-en="View profile">Voir le profil</span>
                                        </a>
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            {% if totalPages > 1 %}
                {% set maxPagesToShow = 5 %}
                {% set startPage = currentPage - 2 %}
                {% if startPage < 1 %}
                    {% set startPage = 1 %}
                {% endif %}
                {% set endPage = startPage + maxPagesToShow - 1 %}
                {% if endPage > totalPages %}
                    {% set endPage = totalPages %}
                {% endif %}
                {% set startPage = endPage - maxPagesToShow + 1 %}
                {% if startPage < 1 %}
                    {% set startPage = 1 %}
                {% endif %}

                <div class="pagination-wrapper">
                    <ul class="pagination pagination-rounded">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                            {% if currentPage == 1 %}
                                <span class="page-link" aria-disabled="true" data-i18n-fr="Précédent" data-i18n-en="Previous">Précédent</span>
                            {% else %}
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    page: currentPage - 1,
                                    search: search,
                                    role: currentRole,
                                    status: currentStatus,
                                    sort: currentSort,
                                    order: currentOrder
                                }) }}" rel="prev" data-i18n-fr="Précédent" data-i18n-en="Previous">Précédent</a>
                            {% endif %}
                        </li>

                        {% if startPage > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    page: 1,
                                    search: search,
                                    role: currentRole,
                                    status: currentStatus,
                                    sort: currentSort,
                                    order: currentOrder
                                }) }}">1</a>
                            </li>
                            {% if startPage > 2 %}
                                <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                            {% endif %}
                        {% endif %}

                        {% for page in startPage..endPage %}
                            <li class="page-item {{ page == currentPage ? 'active' }}">
                                {% if page == currentPage %}
                                    <span class="page-link" aria-current="page">{{ page }}</span>
                                {% else %}
                                    <a class="page-link" href="{{ path('admin_users_list', {
                                        page: page,
                                        search: search,
                                        role: currentRole,
                                        status: currentStatus,
                                        sort: currentSort,
                                        order: currentOrder
                                    }) }}">{{ page }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}

                        {% if endPage < totalPages %}
                            {% if endPage < totalPages - 1 %}
                                <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                            {% endif %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    page: totalPages,
                                    search: search,
                                    role: currentRole,
                                    status: currentStatus,
                                    sort: currentSort,
                                    order: currentOrder
                                }) }}">{{ totalPages }}</a>
                            </li>
                        {% endif %}

                        <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                            {% if currentPage == totalPages %}
                                <span class="page-link" aria-disabled="true" data-i18n-fr="Suivant" data-i18n-en="Next">Suivant</span>
                            {% else %}
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    page: currentPage + 1,
                                    search: search,
                                    role: currentRole,
                                    status: currentStatus,
                                    sort: currentSort,
                                    order: currentOrder
                                }) }}" rel="next" data-i18n-fr="Suivant" data-i18n-en="Next">Suivant</a>
                            {% endif %}
                        </li>
                    </ul>
                </div>
                <div class="pagination-summary">
                    <small data-i18n-target="html" data-i18n-fr="Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total" data-i18n-en="Page {{ currentPage }} of {{ totalPages }} - Showing {{ users|length }} user(s) of {{ totalUsersFiltered }} total">Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total</small>
                </div>
            {% elseif users|length > 0 %}
                <div class="pagination-wrapper">
                    <div class="pagination-summary">
                        <small data-i18n-target="html" data-i18n-fr="Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total" data-i18n-en="Showing {{ users|length }} user(s) of {{ totalUsersFiltered }} total">Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total</small>
                    </div>
                </div>
            {% endif %}
  </div>
</div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
(function registerAdminUsersTranslations() {
    if (!window.languageManager) {
        return;
    }

    window.languageManager.extendTranslations({
        fr: {
            'admin.users.export.no_selection': 'Veuillez sélectionner au moins un utilisateur à exporter.',
            'admin.users.export.success': 'Export des utilisateurs : {list}',
            'admin.users.stats.alert': 'Affichage des statistiques utilisateurs'
        },
        en: {
            'admin.users.export.no_selection': 'Please select at least one user to export.',
            'admin.users.export.success': 'Exporting users: {list}',
            'admin.users.stats.alert': 'Displaying user statistics'
        }
    });
})();

function translateInline(key, fallback, params = {}) {
    const manager = window.languageManager;
    if (manager) {
        const translation = manager.translate(key, params);
        if (translation) {
            return translation;
        }
    }
    return fallback;
}

function handleStatusConfirm(form) {
    const manager = window.languageManager;
    const lang = manager ? manager.getLanguage() : 'fr';
    const datasetKey = lang === 'en' ? 'confirmEn' : 'confirmFr';
    const fallback = form.dataset.confirmFr || 'Voulez-vous changer le statut de cet utilisateur ?';
    const message = form.dataset[datasetKey] || fallback;
    return window.confirm(message);
}

function confirmApprove(form) {
    const manager = window.languageManager;
    const lang = manager ? manager.getLanguage() : 'fr';
    const datasetKey = lang === 'en' ? 'confirmEn' : 'confirmFr';
    const fallback = form.dataset.confirmFr || 'Approuver la demande de cet organisateur ?';
    const message = form.dataset[datasetKey] || fallback;
    return window.confirm(message);
}

function confirmReject(form) {
    const manager = window.languageManager;
    const lang = manager ? manager.getLanguage() : 'fr';
    const datasetKey = lang === 'en' ? 'confirmEn' : 'confirmFr';
    const fallback = form.dataset.confirmFr || 'Rejeter la demande de cet organisateur ?';
    const message = form.dataset[datasetKey] || fallback;
    return window.confirm(message);
}

// Init simple (sans toggle) : tooltips + sélection multiple
function initUsersPage() {
    // Initialiser les tooltips Bootstrap
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Sélection multiple
    const selectAll = document.getElementById('selectAll');
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.user-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });
    }

}
// Fonction supprimée - Les détails utilisateur sont maintenant accessibles via la page dédiée

function navigateToUserDetails(btn) {
    const tr = btn.closest('tr');
    if (!tr) return;
    const userId = tr.getAttribute('data-user-id');
    const table = document.getElementById('usersTable');
    const base = table ? table.getAttribute('data-show-url-base') : null;
    if (!userId || !base) return;
    // Remplacer le dernier segment numérique (ex: /0) par l'ID réel
    const url = base.replace(/\/(\d+)(?:\/?$)/, '/' + userId);
    window.location.href = url;
}

document.addEventListener('DOMContentLoaded', initUsersPage);
document.addEventListener('turbo:load', initUsersPage);
document.addEventListener('turbo:render', initUsersPage);
document.addEventListener('turbo:frame-load', initUsersPage);
window.addEventListener('pageshow', initUsersPage);

function toggleUserSelection() {
    const checkboxes = document.querySelectorAll('.user-checkbox');
    const selectAll = document.getElementById('selectAll');
    
    checkboxes.forEach(checkbox => {
        checkbox.checked = false;
    });
    if (selectAll) {
        selectAll.checked = false;
    }
    
    const selectColumns = document.querySelectorAll('.select-column');
    selectColumns.forEach(column => {
        column.classList.toggle('visible');
    });
}

function exportUsers() {
    const selectedCheckboxes = document.querySelectorAll('.user-checkbox:checked');
    const selectedUsers = Array.from(selectedCheckboxes).map(checkbox => checkbox.value);
    
    if (selectedUsers.length === 0) {
        alert(translateInline('admin.users.export.no_selection', 'Veuillez sélectionner au moins un utilisateur à exporter.'));
        return;
    }
    
    alert(translateInline('admin.users.export.success', 'Export des utilisateurs : {list}', { list: selectedUsers.join(', ') }));
}

function showUserStats() {
    alert(translateInline('admin.users.stats.alert', 'Affichage des statistiques utilisateurs'));
}

// Les actions sont maintenant gérées directement via les liens et formulaires HTML
