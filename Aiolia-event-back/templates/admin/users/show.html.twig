{% extends 'base.html.twig' %}

{% block title %}Détails utilisateur - {{ user.fullName }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('admin_users_list') }}">Utilisateurs</a></li>
                    <li class="breadcrumb-item active">{{ user.fullName }}</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            {# Informations utilisateur #}
            <div class="card user-profile-card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user"></i> Informations
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="user-avatar">
                            <span class="avatar-initial">{{ user.firstName[0]|default('U') }}{{ user.lastName[0]|default('') }}</span>
                        </div>
                        <h4 class="mt-3 mb-1">{{ user.fullName }}</h4>
                        <p class="text-muted mb-0">{{ user.email }}</p>
                    </div>

                    <div class="user-stats">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-id-card"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-label">ID</span>
                                <span class="stat-value">#{{ user.id }}</span>
                            </div>
                        </div>
                        
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-label">Téléphone</span>
                                <span class="stat-value">{{ user.phone ?? 'Non renseigné' }}</span>
                            </div>
                        </div>
                        
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-user-tag"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-label">Rôle</span>
                                <span class="stat-value">
                                    {% if user.role == 'admin' %}
                                        <span class="badge bg-danger">Administrateur</span>
                                    {% elseif user.role == 'organizer' %}
                                        <span class="badge bg-primary">Organisateur</span>
                                    {% elseif user.role == 'co_organizer' %}
                                        <span class="badge bg-info">Co-organisateur</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Utilisateur</span>
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-label">Statut</span>
                                <span class="stat-value">
                                    {% if user.accountStatus == 'active' %}
                                        <span class="badge bg-success">Actif</span>
                                    {% elseif user.accountStatus == 'pending_validation' %}
                                        <span class="badge bg-warning">En attente</span>
                                    {% elseif user.accountStatus == 'rejected' %}
                                        <span class="badge bg-danger">Rejeté</span>
                                    {% else %}
                                        <span class="badge bg-dark">Suspendu</span>
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-label">Email vérifié</span>
                                <span class="stat-value">
                                    {% if user.emailVerified %}
                                        <span class="text-success"><i class="fas fa-check"></i> Oui</span>
                                    {% else %}
                                        <span class="text-danger"><i class="fas fa-times"></i> Non</span>
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-plus"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-label">Date création</span>
                                <span class="stat-value">{{ user.createdAt|date('d/m/Y H:i') }}</span>
                            </div>
                        </div>
                        
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="stat-content">
                                <span class="stat-label">Dernière connexion</span>
                                <span class="stat-value">{{ user.lastLoginAt ? user.lastLoginAt|date('d/m/Y H:i') : 'Jamais' }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-md-8">
            {# Informations supplémentaires #}
            <div class="card info-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i> Informations supplémentaires
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert info-alert">
                        <i class="fas fa-info-circle"></i>
                        <strong>Gestion des utilisateurs</strong><br>
                        Cette page vous permet de gérer les informations et les actions liées à cet utilisateur. 
                        Vous pouvez modifier son rôle, suspendre ou activer son compte, et effectuer d'autres actions administratives.
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-icon">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <div class="info-content">
                                    <h6>Date d'inscription</h6>
                                    <p class="mb-0">{{ user.createdAt|date('d F Y à H:i') }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-icon">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div class="info-content">
                                    <h6>Dernière activité</h6>
                                    <p class="mb-0">{{ user.lastLoginAt ? user.lastLoginAt|date('d F Y à H:i') : 'Jamais connecté' }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

