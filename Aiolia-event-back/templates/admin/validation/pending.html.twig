{% extends 'base.html.twig' %}

{% block title %}Demandes de validation en attente{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-user-check"></i> Demandes de validation en attente
                    </h4>
                </div>
                <div class="card-body">
                    {% if requests is empty %}
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i>
                            Aucune demande de validation en attente
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date de demande</th>
                                        <th>Utilisateur</th>
                                        <th>Email</th>
                                        <th>Rôle demandé</th>
                                        <th>Raison</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for request in requests %}
                                        <tr>
                                            <td>{{ request.createdAt|date('d/m/Y H:i') }}</td>
                                            <td>
                                                <strong>{{ request.user.fullName }}</strong>
                                            </td>
                                            <td>{{ request.user.email }}</td>
                                            <td>
                                                <span class="badge bg-{{ request.requestedRole == 'organizer' ? 'primary' : 'info' }}">
                                                    {{ request.requestedRole == 'organizer' ? 'Organisateur' : 'Co-organisateur' }}
                                                </span>
                                            </td>
                                            <td>
                                                {% if request.reason %}
                                                    <small>{{ request.reason|length > 100 ? request.reason|slice(0, 100) ~ '...' : request.reason }}</small>
                                                {% else %}
                                                    <em class="text-muted">Aucune raison fournie</em>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-success" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#approveModal{{ request.id }}">
                                                    <i class="fas fa-check"></i> Approuver
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#rejectModal{{ request.id }}">
                                                    <i class="fas fa-times"></i> Rejeter
                                                </button>
                                            </td>
                                        </tr>

                                        {# Modal d'approbation #}
                                        <div class="modal fade" id="approveModal{{ request.id }}" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Approuver la demande</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form method="post" action="{{ path('admin_validation_approve', {id: request.id}) }}">
                                                        <div class="modal-body">
                                                            <p>Voulez-vous approuver la demande de <strong>{{ request.user.fullName }}</strong> pour devenir <strong>{{ request.requestedRole == 'organizer' ? 'Organisateur' : 'Co-organisateur' }}</strong> ?</p>
                                                            
                                                            <div class="mb-3">
                                                                <label class="form-label">Commentaire (optionnel)</label>
                                                                <textarea name="comment" class="form-control" rows="3" placeholder="Ajouter un commentaire..."></textarea>
                                                            </div>

                                                            {% if request.reason %}
                                                                <div class="alert alert-info">
                                                                    <strong>Raison de la demande :</strong><br>
                                                                    {{ request.reason }}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                            <button type="submit" class="btn btn-success">
                                                                <i class="fas fa-check"></i> Approuver
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        {# Modal de rejet #}
                                        <div class="modal fade" id="rejectModal{{ request.id }}" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Rejeter la demande</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form method="post" action="{{ path('admin_validation_reject', {id: request.id}) }}">
                                                        <div class="modal-body">
                                                            <p>Voulez-vous rejeter la demande de <strong>{{ request.user.fullName }}</strong> ?</p>
                                                            
                                                            <div class="mb-3">
                                                                <label class="form-label">Raison du rejet <span class="text-danger">*</span></label>
                                                                <textarea name="comment" class="form-control" rows="3" required placeholder="Indiquez la raison du rejet..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                            <button type="submit" class="btn btn-danger">
                                                                <i class="fas fa-times"></i> Rejeter
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

