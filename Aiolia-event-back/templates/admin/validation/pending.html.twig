{% extends 'base.html.twig' %}

{% block title %}Validation des comptes - Aiolia Event{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1 data-i18n="validation.header.title">Validation des comptes</h1>
            <p class="dashboard-subtitle" data-i18n="validation.header.subtitle">
                Gérez les demandes de validation de rôle des utilisateurs
            </p>
        </div>
    </div>

    <!-- Statistiques validation -->
    <section class="card stats-card">
        <div class="card-header">
            <h4 class="mb-0"><i class="fas fa-user-check"></i> <span data-i18n="validation.stats.summary.title">Résumé des comptes</span></h4>
        </div>
        <div class="card-body">
            <div class="stats-grid stats-grid-compact validation-overview">
                <div class="stat-card stat-card-compact">
                    <div class="stat-icon stat-icon-compact bg-primary">
                        <i class="fas fa-hourglass-half"></i>
                    </div>
                    <div class="stat-content">
                        <h3>{{ pendingStats.total }}</h3>
                        <p data-i18n="validation.stats.total_pending">Comptes en attente</p>
                    </div>
                </div>
                <div class="stat-card stat-card-compact">
                    <div class="stat-icon stat-icon-compact bg-info">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="stat-content">
                        <h3>{{ pendingStats.organizer }}</h3>
                        <p data-i18n="validation.stats.organizers">Organisateurs</p>
                    </div>
                </div>
                <div class="stat-card stat-card-compact">
                    <div class="stat-icon stat-icon-compact bg-success">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-content">
                        <h3>{{ pendingStats.user }}</h3>
                        <p data-i18n="validation.stats.users">Utilisateurs</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Cartes comptes en attente -->
    <section class="card pending-accounts">
        <div class="card-header">
            <div>
                <h4 class="mb-0"><i class="fas fa-user-clock"></i> <span data-i18n="validation.pending.section.title">Comptes en attente de validation</span></h4>
                <p class="card-subtitle" data-i18n="validation.pending.section.subtitle">Liste des comptes nécessitant une validation manuelle</p>
            </div>
        </div>
        <div class="card-body">
            {% if paginatedPendingAccounts is empty %}
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-check-double"></i>
                    </div>
                    <h3 data-i18n="validation.pending.empty.title">Aucun compte en attente</h3>
                    <p data-i18n="validation.pending.empty.subtitle">Tous les comptes ont été traités.</p>
                </div>
            {% else %}
            <div class="table-responsive">
                <table class="table table-hover pending-accounts-table">
                    <thead>
                        <tr>
                            <th class="col-left" data-i18n="validation.table.headers.user">Utilisateur</th>
                            <th class="col-center" data-i18n="validation.table.headers.role">Rôle demandé</th>
                            <th class="col-center" data-i18n="validation.table.headers.status">Statut</th>
                            <th class="col-center" data-i18n="validation.table.headers.submitted_at">Soumis le</th>
                            <th class="col-center" data-i18n="validation.table.headers.actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for account in paginatedPendingAccounts %}
                            <tr>
                                <td class="col-left">
                                    <div class="user-info">
                                        {% set avatarInitials = '' %}
                                        {% if account.fullName %}
                                            {% set nameParts = account.fullName|trim|split(' ')|filter(v => v is not empty) %}
                                            {% if nameParts|length > 0 %}
                                                {% set avatarInitials = nameParts|first|slice(0, 1) %}
                                                {% if nameParts|length > 1 %}
                                                    {% set avatarInitials = avatarInitials ~ nameParts|last|slice(0, 1) %}
                                                {% elseif nameParts|first|length > 1 %}
                                                    {% set avatarInitials = avatarInitials ~ nameParts|first|slice(1, 1) %}
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}
                                        {% if avatarInitials is empty and account.email %}
                                            {% set localPart = account.email|split('@')|first %}
                                            {% if localPart|length >= 2 %}
                                                {% set avatarInitials = localPart|slice(0, 2) %}
                                            {% else %}
                                                {% set avatarInitials = localPart|slice(0, 1) %}
                                            {% endif %}
                                        {% endif %}
                                        {% if avatarInitials is empty %}
                                            {% set avatarInitials = 'AA' %}
                                        {% endif %}
                                        <div class="user-avatar-sm">
                                            <span>{{ avatarInitials|upper }}</span>
                                        </div>
                                        <div class="user-details">
                                            <strong class="user-name">{{ account.fullName }}</strong>
                                            <div class="user-meta">
                                                <span class="user-email">{{ account.email }}</span>
                                                {% if account.phone %}
                                                    <span class="user-phone">{{ account.phone }}</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="col-center">
                                    {% if account.role == 'organizer' %}
                                        <span class="badge role-badge role-organizer" data-i18n="validation.stats.organizers">Organisateurs</span>
                                    {% else %}
                                        <span class="badge role-badge role-user" data-i18n="validation.stats.users">Utilisateurs</span>
                                    {% endif %}
                                </td>
                                <td class="col-center">
                                    <span class="badge bg-warning text-dark" data-i18n="validation.table.status.pending">En attente</span>
                                </td>
                                <td class="col-center">{{ account.createdAt|date('d/m/Y') }}</td>
                                <td class="col-center actions-cell">
                                    <a href="{{ path('admin_users_show', {id: account.id}) }}" class="validation-action-pill pill-view">
                                        <i class="fas fa-eye"></i><span data-i18n="validation.table.button.view">Voir le profil</span>
                                    </a>
                                    <form method="post" action="{{ path('admin_validation_approve', {id: account.id}) }}" class="d-inline" onsubmit="return confirm('Approuver le compte de {{ account.fullName }} ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_user_' ~ account.id) }}">
                                        <button type="submit" class="validation-action-pill pill-approve">
                                            <i class="fas fa-check"></i><span data-i18n="validation.table.button.approve">Approuver</span>
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_validation_reject', {id: account.id}) }}" class="d-inline" onsubmit="return confirm('Rejeter le compte de {{ account.fullName }} ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject_user_' ~ account.id) }}">
                                        <button type="submit" class="validation-action-pill pill-reject">
                                            <i class="fas fa-times"></i><span data-i18n="validation.table.button.reject">Rejeter</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if totalPages > 1 %}
                {% set maxPagesToShow = 5 %}
                {% set startPage = currentPage - 2 %}
                {% if startPage < 1 %}
                    {% set startPage = 1 %}
                {% endif %}
                {% set endPage = startPage + maxPagesToShow - 1 %}
                {% if endPage > totalPages %}
                    {% set endPage = totalPages %}
                {% endif %}
                {% set startPage = endPage - maxPagesToShow + 1 %}
                {% if startPage < 1 %}
                    {% set startPage = 1 %}
                {% endif %}

                <nav class="pagination-wrapper" aria-label="Pagination comptes en attente">
                    <ul class="pagination pagination-rounded">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                            {% if currentPage == 1 %}
                                <span class="page-link" aria-disabled="true" data-i18n="pagination.previous">Précédent</span>
                            {% else %}
                                <a class="page-link" href="{{ path('admin_validation_pending', {page: currentPage - 1}) }}" rel="prev" data-i18n="pagination.previous">Précédent</a>
                            {% endif %}
                        </li>

                        {% if startPage > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_validation_pending', {page: 1}) }}">1</a>
                            </li>
                            {% if startPage > 2 %}
                                <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                            {% endif %}
                        {% endif %}

                        {% for page in startPage..endPage %}
                            <li class="page-item {{ page == currentPage ? 'active' }}">
                                {% if page == currentPage %}
                                    <span class="page-link" aria-current="page">{{ page }}</span>
                                {% else %}
                                    <a class="page-link" href="{{ path('admin_validation_pending', {page: page}) }}">{{ page }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}

                        {% if endPage < totalPages %}
                            {% if endPage < totalPages - 1 %}
                                <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                            {% endif %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_validation_pending', {page: totalPages}) }}">{{ totalPages }}</a>
                            </li>
                        {% endif %}

                        <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                            {% if currentPage == totalPages %}
                                <span class="page-link" aria-disabled="true" data-i18n="pagination.next">Suivant</span>
                            {% else %}
                                <a class="page-link" href="{{ path('admin_validation_pending', {page: currentPage + 1}) }}" rel="next" data-i18n="pagination.next">Suivant</a>
                            {% endif %}
                        </li>
                    </ul>
                </nav>
                <div class="pagination-summary">
                    <small data-i18n-target="html" data-i18n-fr="Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ paginatedPendingAccounts|length }} compte(s) sur {{ pendingStats.total|default(paginatedPendingAccounts|length) }} total" data-i18n-en="Page {{ currentPage }} of {{ totalPages }} - Showing {{ paginatedPendingAccounts|length }} account(s) out of {{ pendingStats.total|default(paginatedPendingAccounts|length) }} total">Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ paginatedPendingAccounts|length }} compte(s) sur {{ pendingStats.total|default(paginatedPendingAccounts|length) }} total</small>
                </div>
            {% endif %}
            {% endif %}
        </div>
    </section>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const updateValidationTitle = (retry = 0) => {
        const manager = window.languageManager;
        if (!manager) {
            if (retry < 20) {
                setTimeout(() => updateValidationTitle(retry + 1), 100);
            }
            return;
        }
        const translated = manager.translate('validation.meta.title') || 'Validation des comptes - Aiolia Event';
        document.title = translated;
    };

    updateValidationTitle();
    document.addEventListener('aiolia:language-changed', () => updateValidationTitle());

    // Initialiser les tooltips Bootstrap
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Filtrage par rôle
    const roleFilter = document.getElementById('roleFilter');
    const sortFilter = document.getElementById('sortFilter');
    const requestRows = document.querySelectorAll('.request-row');

    if (roleFilter) {
        roleFilter.addEventListener('change', function() {
            filterRequests(this.value);
        });
    }

    if (sortFilter) {
        sortFilter.addEventListener('change', function() {
            sortRequests(this.value);
        });
    }

    function filterRequests(role) {
        requestRows.forEach(row => {
            if (role === 'all' || row.dataset.role === role) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function sortRequests(criteria) {
        const tbody = document.querySelector('.requests-table tbody');
        if (!tbody) {
            return;
        }
        const rows = Array.from(requestRows).filter(row => row.style.display !== 'none');
        
        rows.sort((a, b) => {
            switch(criteria) {
                case 'newest':
                    return b.dataset.date - a.dataset.date;
                case 'oldest':
                    return a.dataset.date - b.dataset.date;
                case 'name':
                    return a.dataset.name.localeCompare(b.dataset.name);
                default:
                    return 0;
            }
        });
        
        // Réorganiser les lignes
        rows.forEach(row => tbody.appendChild(row));
    }
});

function showValidationStats() {
    alert('Affichage des statistiques de validation');
}
</script>

<style>
/* Styles spécifiques à la validation */
.dashboard-subtitle {
    color: var(--text-secondary);
    margin-top: 8px;
    font-size: 1rem;
}

.card-header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.card-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-top: 4px;
}

.requests-count {
    background: var(--bg-secondary);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
}

.validation-overview {
    margin-bottom: 1.5rem;
}

.validation-overview.stats-grid-compact {
    gap: 10px;
    margin-bottom: 16px;
}

.validation-overview .stat-card-compact {
    padding: 10px 12px;
}

.validation-overview .stat-icon-compact {
    width: 30px;
    height: 30px;
    font-size: 1rem;
    margin-bottom: 8px;
}

.validation-overview .stat-content h3 {
    font-size: 1.2rem;
    margin-bottom: 2px;
    line-height: 1.1;
}

.pending-accounts-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
}

.pending-accounts-table .col-left {
    text-align: left;
}

.pending-accounts-table .col-center {
    text-align: center;
}

.pending-accounts-table .col-right {
    text-align: right;
}

.pending-accounts-table th {
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-color);
}

.pending-accounts-table td {
    vertical-align: middle;
}

.pending-accounts-table .user-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
}

.pending-accounts-table .user-id-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(52, 152, 219, 0.16);
    color: var(--accent);
    border-radius: 999px;
    padding: 3px 9px;
    font-size: 0.72rem;
    font-weight: 600;
}

.pending-accounts-table .user-id-badge i {
    font-size: 0.75rem;
}

.role-user {
    background: rgba(108, 117, 125, 0.12);
    color: #495057;
    border: 1px solid rgba(108, 117, 125, 0.25);
}

.pending-accounts-table .actions-cell {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
}

.validation-action-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 8px 18px;
    border-radius: 14px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 2px solid transparent;
    text-decoration: none;
}

.validation-action-pill span {
    margin: 0;
}

.validation-action-pill i {
    font-size: 0.95rem;
}

.validation-action-pill.pill-view {
    background: rgba(52, 152, 219, 0.15);
    color: var(--accent);
    border-color: rgba(52, 152, 219, 0.45);
}

.validation-action-pill.pill-approve {
    background: rgba(46, 204, 113, 0.18);
    color: #1d9a58;
    border-color: rgba(46, 204, 113, 0.5);
}

.validation-action-pill.pill-reject {
    background: rgba(231, 76, 60, 0.18);
    color: #c0392b;
    border-color: rgba(231, 76, 60, 0.45);
}

.validation-action-pill:hover {
    filter: brightness(0.95);
}

.pagination-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
}

.pagination {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.pagination-rounded .page-link {
    border-radius: 999px !important;
}

.pagination .page-item.disabled .page-link {
    pointer-events: none;
    opacity: 0.5;
}

.pagination .page-item.active .page-link {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
}

.pagination .page-link {
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--border-color);
    padding: 6px 14px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    transition: all 0.2s ease;
}

.pagination .page-link:hover {
    color: var(--accent);
    border-color: var(--accent);
}

.pagination .ellipsis .page-link {
    border: none;
    background: transparent;
    color: var(--text-secondary);
}

.pagination-summary {
    text-align: center;
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

/* Filtres */
.filters-section {
    background: var(--bg-card);
    border-radius: var(--border-radius-md);
    padding: 16px;
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
}

.filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
}

/* Tableau des demandes */
.requests-table {
    font-size: 0.9rem;
}

.requests-table th {
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-color);
    padding: 12px 8px;
}

.requests-table td {
    padding: 12px 8px;
    vertical-align: middle;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.user-avatar-sm {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2f80ed, #56ccf2);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.9rem;
    flex-shrink: 0;
}

.user-details {
    display: flex;
    flex-direction: column;
}

.user-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.95rem;
    margin-bottom: 2px;
}

.user-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.user-email, .user-phone {
    font-size: 0.8rem;
    color: var(--text-secondary);
}

.contact-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.email, .phone {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
}

.email i, .phone i {
    color: var(--text-secondary);
    width: 14px;
}

/* Badges de rôle */
.role-badge {
    font-size: 0.75rem;
    padding: 6px 10px;
    border-radius: 12px;
    font-weight: 600;
}

.role-organizer {
    background: rgba(52, 152, 219, 0.1);
    color: #3498db;
    border: 1px solid rgba(52, 152, 219, 0.2);
}

.role-co-organizer {
    background: rgba(155, 89, 182, 0.1);
    color: #9b59b6;
    border: 1px solid rgba(155, 89, 182, 0.2);
}

/* Date */
.date-info {
    display: flex;
    flex-direction: column;
}

.request-date {
    font-weight: 600;
    color: var(--text-primary);
}

.request-time {
    font-size: 0.8rem;
    color: var(--text-secondary);
}

/* Raison */
.reason-preview {
    text-align: center;
}

.btn-reason-preview {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-reason-preview:hover {
    background: var(--bg-primary);
    border-color: var(--accent);
    color: var(--accent);
}

.no-reason {
    color: var(--text-secondary);
    font-style: italic;
    font-size: 0.85rem;
}

.no-reason i {
    margin-right: 4px;
}

/* Actions */
.actions-column {
    width: 140px;
}

.action-buttons {
    display: flex;
    gap: 6px;
    justify-content: center;
}

.action-buttons .btn {
    width: 32px;
    height: 32px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 6px;
    font-size: 0.8rem;
}

/* Modals */
.modal-header-content {
    display: flex;
    align-items: center;
    gap: 12px;
}

.modal-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}

.modal-icon-success {
    background: rgba(46, 204, 113, 0.1);
    color: #2ecc71;
}

.modal-icon-danger {
    background: rgba(231, 76, 60, 0.1);
    color: #e74c3c;
}

.modal-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
}

.user-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding: 12px;
    background: var(--bg-secondary);
    border-radius: var(--border-radius-md);
}

.reason-content {
    background: var(--bg-secondary);
    padding: 16px;
    border-radius: var(--border-radius-md);
    border-left: 3px solid var(--accent);
}

.reason-text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
}

/* État vide */
.empty-state {
    text-align: center;
    padding: 60px 20px;
}

.empty-state-icon {
    font-size: 4rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
}

.empty-state h3 {
    color: var(--text-primary);
    margin-bottom: 12px;
}

.empty-state p {
    color: var(--text-secondary);
    margin-bottom: 24px;
}

.empty-state-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
}

/* Responsive */
@media (max-width: 768px) {
    .filters-grid {
        grid-template-columns: 1fr;
    }
    
    .card-header-content {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
    
    .user-info {
        flex-direction: column;
        text-align: center;
        gap: 8px;
