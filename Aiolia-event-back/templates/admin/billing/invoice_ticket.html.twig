<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facture {{ invoice.invoiceNumber }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Arial', sans-serif;
            font-size: 12px;
            color: #4a5568;
            padding: 40px;
            background: #fff;
        }
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
        }
        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 3px solid #718096;
        }
        .company-info h1 {
            font-size: 24px;
            margin-bottom: 10px;
            color: #2d3748;
        }
        .invoice-info {
            text-align: right;
        }
        .invoice-info h2 {
            font-size: 20px;
            margin-bottom: 10px;
            color: #2d3748;
        }
        .invoice-info p {
            color: #4a5568;
        }
        .invoice-info strong {
            color: #2d3748;
        }
        .details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }
        .section h3 {
            font-size: 14px;
            margin-bottom: 10px;
            text-transform: uppercase;
            color: #718096;
            font-weight: 600;
        }
        .section p {
            margin: 5px 0;
            color: #4a5568;
        }
        .section strong {
            color: #2d3748;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }
        table th {
            background: #f7fafc;
            padding: 10px;
            text-align: left;
            border-bottom: 2px solid #cbd5e0;
            color: #2d3748;
            font-weight: 600;
        }
        table td {
            padding: 10px;
            border-bottom: 1px solid #e2e8f0;
            color: #4a5568;
        }
        .totals {
            margin-top: 20px;
        }
        .totals table {
            width: 300px;
            margin-left: auto;
        }
        .totals .total-row {
            background: #f7fafc;
            font-weight: bold;
            font-size: 14px;
            color: #2d3748;
        }
        .totals table td {
            color: #4a5568;
        }
        .footer {
            margin-top: 60px;
            padding-top: 20px;
            border-top: 1px solid #e2e8f0;
            text-align: center;
            color: #718096;
            font-size: 10px;
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <div class="header">
            <div class="company-info">
                <h1>Aiolia Event</h1>
                <p>Plateforme de gestion d'événements</p>
                <p>Madagascar</p>
            </div>
            <div class="invoice-info">
                <h2>FACTURE</h2>
                <p><strong>N° {{ invoice.invoiceNumber }}</strong></p>
                <p>Date: {{ invoice.issuedAt|date('d/m/Y') }}</p>
                {% if invoice.dueAt %}
                    <p>Échéance: {{ invoice.dueAt|date('d/m/Y') }}</p>
                {% endif %}
            </div>
        </div>

        <div class="details">
            <div class="section">
                <h3>Facturé à</h3>
                <p><strong>{{ invoice.customer.getFullName() }}</strong></p>
                <p>{{ invoice.customer.email }}</p>
                {% if invoice.customer.phone %}
                    <p>{{ invoice.customer.phone }}</p>
                {% endif %}
            </div>
            <div class="section">
                <h3>Informations</h3>
                <p><strong>Type:</strong> Facture de billet</p>
                <p><strong>Statut:</strong> 
                    {% if invoice.status == 'paid' %}
                        Payée
                    {% elseif invoice.status == 'issued' %}
                        Émise
                    {% else %}
                        {{ invoice.status }}
                    {% endif %}
                </p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Description</th>
                    <th style="text-align: right;">Montant</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Billet(s) d'événement</td>
                    <td style="text-align: right;">{{ invoice.subtotalAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</td>
                </tr>
            </tbody>
        </table>

        <div class="totals">
            <table>
                <tr>
                    <td>Sous-total HT:</td>
                    <td style="text-align: right;">{{ invoice.subtotalAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</td>
                </tr>
                <tr>
                    <td>TVA (20%):</td>
                    <td style="text-align: right;">{{ invoice.taxAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</td>
                </tr>
                <tr class="total-row">
                    <td>Total TTC:</td>
                    <td style="text-align: right;">{{ invoice.totalAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</td>
                </tr>
            </table>
        </div>

        <div class="footer">
            <p>Merci de votre confiance !</p>
            <p>Aiolia Event - Plateforme de gestion d'événements</p>
        </div>
    </div>
</body>
</html>

