{% extends 'base.html.twig' %}

{% block title %}Facture {{ invoice.invoiceNumber }} - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1 data-i18n-fr="Facture {{ invoice.invoiceNumber }}" data-i18n-en="Invoice {{ invoice.invoiceNumber }}">Facture {{ invoice.invoiceNumber }}</h1>
            <p class="dashboard-subtitle">
                {% if type == 'ticket' %}
                    <span data-i18n-fr="Facture de billet" data-i18n-en="Ticket invoice">Facture de billet</span>
                {% else %}
                    <span data-i18n-fr="Facture d'abonnement" data-i18n-en="Subscription invoice">Facture d'abonnement</span>
                {% endif %}
            </p>
        </div>
        <div class="header-actions">
            {% if type == 'ticket' %}
                <a href="{{ path('admin_billing_ticket_invoice_pdf', {id: invoice.id}) }}" class="btn btn-primary" target="_blank">
                    <i class="fas fa-file-pdf"></i>
                    <span data-i18n-fr="Télécharger PDF" data-i18n-en="Download PDF">Télécharger PDF</span>
                </a>
                <form method="post" action="{{ path('admin_billing_ticket_invoice_resend', {id: invoice.id}) }}" class="d-inline">
                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-envelope"></i>
                        <span data-i18n-fr="Renvoyer par email" data-i18n-en="Resend email">Renvoyer par email</span>
                    </button>
                </form>
            {% else %}
                <a href="{{ path('admin_billing_subscription_invoice_pdf', {id: invoice.id}) }}" class="btn btn-primary" target="_blank">
                    <i class="fas fa-file-pdf"></i>
                    <span data-i18n-fr="Télécharger PDF" data-i18n-en="Download PDF">Télécharger PDF</span>
                </a>
                {% if invoice.status == 'paid' %}
                    <form method="post" action="{{ path('admin_billing_subscription_invoice_resend', {id: invoice.id}) }}" class="d-inline">
                        <button type="submit" class="btn btn-secondary">
                            <i class="fas fa-envelope"></i>
                            <span data-i18n-fr="Renvoyer par email" data-i18n-en="Resend email">Renvoyer par email</span>
                        </button>
                    </form>
                {% elseif invoice.status == 'overdue' %}
                    <form method="post" action="{{ path('admin_billing_subscription_invoice_notify', {id: invoice.id}) }}" class="d-inline">
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span data-i18n-fr="Signaler le retard" data-i18n-en="Report delay">Signaler le retard</span>
                        </button>
                    </form>
                {% endif %}
            {% endif %}
            <a href="{{ path('admin_billing_invoices') }}" class="btn btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span data-i18n-fr="Retour" data-i18n-en="Back">Retour</span>
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="invoice-details">
                <div class="invoice-header invoice-header-{{ invoice.status }}">
                    <div>
                        <h2 class="invoice-number-status-{{ invoice.status }}">Facture {{ invoice.invoiceNumber }}</h2>
                        {% set monthNames = {
                            '1': {'fr': 'Janvier', 'en': 'January'},
                            '2': {'fr': 'Février', 'en': 'February'},
                            '3': {'fr': 'Mars', 'en': 'March'},
                            '4': {'fr': 'Avril', 'en': 'April'},
                            '5': {'fr': 'Mai', 'en': 'May'},
                            '6': {'fr': 'Juin', 'en': 'June'},
                            '7': {'fr': 'Juillet', 'en': 'July'},
                            '8': {'fr': 'Août', 'en': 'August'},
                            '9': {'fr': 'Septembre', 'en': 'September'},
                            '10': {'fr': 'Octobre', 'en': 'October'},
                            '11': {'fr': 'Novembre', 'en': 'November'},
                            '12': {'fr': 'Décembre', 'en': 'December'}
                        } %}
                        {% set month = invoice.issuedAt|date('n') %}
                        {% set year = invoice.issuedAt|date('Y') %}
                        <p class="invoice-period-info">
                            <span data-i18n-fr="Période : {{ monthNames[month].fr }} {{ year }}" data-i18n-en="Period: {{ monthNames[month].en }} {{ year }}">
                                Période : {{ monthNames[month].fr }} {{ year }}
                            </span>
                            <span style="margin: 0 8px;">|</span>
                            <span data-i18n-fr="Émise le {{ invoice.issuedAt|date('d/m/Y à H:i') }}" data-i18n-en="Issued on {{ invoice.issuedAt|date('m/d/Y at H:i') }}">
                                Émise le {{ invoice.issuedAt|date('d/m/Y à H:i') }}
                            </span>
                        </p>
                    </div>
                    <div class="invoice-status">
                        {% if invoice.status == 'paid' %}
                            <span class="badge badge-success badge-lg" data-i18n-fr="Payée" data-i18n-en="Paid">Payée</span>
                        {% elseif invoice.status == 'overdue' %}
                            {% set daysOverdue = invoice.getDaysOverdue() %}
                            <div class="overdue-status">
                                {% if daysOverdue is not null %}
                                    <div class="overdue-days-badge-large">
                                        <i class="fas fa-clock"></i>
                                        <span data-i18n-fr="{{ daysOverdue }} jour{{ daysOverdue > 1 ? 's' : '' }} de retard" data-i18n-en="{{ daysOverdue }} day{{ daysOverdue != 1 ? 's' : '' }} overdue">
                                            {{ daysOverdue }} jour{{ daysOverdue > 1 ? 's' : '' }} de retard
                                        </span>
                                    </div>
                                {% endif %}
                                <span class="badge badge-danger badge-lg" data-i18n-fr="En retard" data-i18n-en="Overdue">En retard</span>
                            </div>
                        {% elseif invoice.status == 'issued' or invoice.status == 'draft' %}
                            <span class="badge badge-warning badge-lg" data-i18n-fr="En attente" data-i18n-en="Pending">En attente</span>
                        {% elseif invoice.status == 'void' or invoice.status == 'refunded' %}
                            <span class="badge badge-danger badge-lg" data-i18n-fr="Annulée" data-i18n-en="Cancelled">Annulée</span>
                        {% else %}
                            <span class="badge badge-secondary badge-lg">{{ invoice.status }}</span>
                        {% endif %}
                    </div>
                </div>

                <div class="invoice-info-grid">
                    <div class="invoice-info-section">
                        <h3 data-i18n-fr="Client" data-i18n-en="Customer">Client</h3>
                        <p><strong>{{ invoice.customer.getFullName() }}</strong></p>
                        <p>
                            <i class="fas fa-envelope"></i> {{ invoice.customer.email }}
                        </p>
                        {% if invoice.customer.phone %}
                            <p>
                                <i class="fas fa-phone"></i> {{ invoice.customer.phone }}
                            </p>
                        {% endif %}
                        {% if type == 'subscription' and organizerType is defined and organizerType %}
                            {% set typeLabels = {
                                'individual': {'fr': 'Individuel', 'en': 'Individual'},
                                'company': {'fr': 'Entreprise', 'en': 'Company'},
                                'non_profit': {'fr': 'Association', 'en': 'Non-Profit'},
                                'collective': {'fr': 'Collectif', 'en': 'Collective'}
                            } %}
                            <p style="margin-top: 0.5rem;">
                                <i class="fas fa-building"></i> 
                                <strong data-i18n-fr="Type:" data-i18n-en="Type:">Type:</strong>
                                <span class="organizer-type-badge-small" data-i18n-fr="{{ typeLabels[organizerType].fr }}" data-i18n-en="{{ typeLabels[organizerType].en }}">
                                    {{ typeLabels[organizerType].fr }}
                                </span>
                            </p>
                        {% endif %}
                    </div>

                    <div class="invoice-info-section">
                        <h3 data-i18n-fr="Informations de facturation" data-i18n-en="Billing information">Informations de facturation</h3>
                        <p>
                            <strong data-i18n-fr="Type de facture" data-i18n-en="Invoice type">Type de facture:</strong> 
                            {% if type == 'ticket' %}
                                <span data-i18n-fr="Billet" data-i18n-en="Ticket">Billet</span>
                            {% else %}
                                <span data-i18n-fr="Abonnement mensuel" data-i18n-en="Monthly subscription">Abonnement mensuel</span>
                            {% endif %}
                        </p>
                        {% if invoice.dueAt %}
                            <p class="billing-info-item">
                                <strong data-i18n-fr="Date d'échéance" data-i18n-en="Due date">Date d'échéance:</strong> 
                                <span class="due-date-status-{{ invoice.status }}">
                                    {{ invoice.dueAt|date('d/m/Y') }}
                                    {% if invoice.status == 'overdue' %}
                                        {% set daysOverdue = invoice.getDaysOverdue() %}
                                        {% if daysOverdue is not null %}
                                            <span class="days-overdue-badge-inline" data-i18n-fr="({{ daysOverdue }} jour{{ daysOverdue > 1 ? 's' : '' }} de retard)" data-i18n-en="({{ daysOverdue }} day{{ daysOverdue != 1 ? 's' : '' }} overdue)">
                                                ({{ daysOverdue }} jour{{ daysOverdue > 1 ? 's' : '' }} de retard)
                                            </span>
                                        {% endif %}
                                    {% endif %}
                                </span>
                            </p>
                        {% endif %}
                        {% if invoice.status == 'overdue' %}
                            {% set daysOverdue = invoice.getDaysOverdue() %}
                            {% if daysOverdue is not null %}
                                <div class="overdue-alert">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <div style="flex: 1;">
                                        <strong data-i18n-fr="Facture en retard de paiement" data-i18n-en="Invoice payment overdue">Facture en retard de paiement</strong>
                                        <div style="margin-top: 10px; display: flex; align-items: center; gap: 10px;">
                                            <span class="days-overdue-number" data-i18n-fr="{{ daysOverdue }} jour{{ daysOverdue > 1 ? 's' : '' }}" data-i18n-en="{{ daysOverdue }} day{{ daysOverdue != 1 ? 's' : '' }}">
                                                {{ daysOverdue }} jour{{ daysOverdue > 1 ? 's' : '' }}
                                            </span>
                                            <span style="color: var(--danger-color); font-weight: var(--font-weight-bold); font-size: 1.1rem;" data-i18n-fr="de retard" data-i18n-en="overdue">de retard</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endif %}
                        {% if invoice.paidAt %}
                            <p class="billing-info-item">
                                <strong data-i18n-fr="Payée le" data-i18n-en="Paid on">Payée le:</strong> 
                                <span class="text-success paid-date-status">{{ invoice.paidAt|date('d/m/Y à H:i') }}</span>
                            </p>
                        {% endif %}
                        <p class="billing-info-item">
                            <strong data-i18n-fr="Date de création" data-i18n-en="Created on">Date de création:</strong> 
                            <span class="text-muted">{{ invoice.createdAt|date('d/m/Y à H:i') }}</span>
                        </p>
                        {% if invoice.updatedAt and invoice.updatedAt != invoice.createdAt %}
                            <p class="billing-info-item">
                                <strong data-i18n-fr="Dernière mise à jour" data-i18n-en="Last updated">Dernière mise à jour:</strong> 
                                <span class="text-muted">{{ invoice.updatedAt|date('d/m/Y à H:i') }}</span>
                            </p>
                        {% endif %}
                    </div>
                </div>

                <div class="invoice-amounts invoice-amounts-{{ invoice.status }}">
                    <table class="table">
                        <tbody>
                            <tr>
                                <td data-i18n-fr="Sous-total" data-i18n-en="Subtotal">Sous-total:</td>
                                <td class="text-right"><strong>{{ invoice.subtotalAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</strong></td>
                            </tr>
                            <tr>
                                <td data-i18n-fr="TVA" data-i18n-en="VAT">TVA:</td>
                                <td class="text-right"><strong>{{ invoice.taxAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</strong></td>
                            </tr>
                            <tr class="total-row total-row-{{ invoice.status }}">
                                <td><strong data-i18n-fr="Total" data-i18n-en="Total">Total:</strong></td>
                                <td class="text-right"><strong class="total-amount-{{ invoice.status }}">{{ invoice.totalAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.invoice-details {
    max-width: 900px;
    margin: 0 auto;
}

.invoice-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 3px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    padding: 1.5rem;
    background: var(--bg-secondary);
}

.invoice-header-paid {
    border-left: 5px solid var(--success-color);
    background: rgba(40, 167, 69, 0.05);
}

.invoice-header-overdue {
    border-left: 5px solid var(--danger-color);
    background: rgba(220, 53, 69, 0.08);
}

.invoice-header-issued,
.invoice-header-draft {
    border-left: 5px solid var(--warning-color);
    background: rgba(255, 193, 7, 0.05);
}

.invoice-header-void,
.invoice-header-refunded {
    border-left: 5px solid var(--text-muted);
    background: rgba(108, 117, 125, 0.05);
}

.invoice-number-status-paid {
    color: var(--success-color);
}

.invoice-number-status-overdue {
    color: var(--danger-color);
}

.invoice-number-status-issued,
.invoice-number-status-draft {
    color: var(--warning-color);
}

.invoice-period-info {
    color: var(--text-secondary);
    margin-top: 0.5rem;
    font-size: 0.95rem;
}

.invoice-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
}

.invoice-info-section h3 {
    margin-bottom: 1rem;
    color: var(--text-primary);
}

.invoice-amounts {
    margin-top: 2rem;
}

.invoice-amounts .table {
    width: 100%;
}

.invoice-amounts .table td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border-color);
}

.invoice-amounts {
    border-radius: var(--border-radius-md);
    padding: 1.5rem;
    background: var(--bg-secondary);
}

.invoice-amounts-paid {
    border-left: 4px solid var(--success-color);
    background: rgba(40, 167, 69, 0.03);
}

.invoice-amounts-overdue {
    border-left: 4px solid var(--danger-color);
    background: rgba(220, 53, 69, 0.05);
}

.invoice-amounts-issued,
.invoice-amounts-draft {
    border-left: 4px solid var(--warning-color);
    background: rgba(255, 193, 7, 0.03);
}

.invoice-amounts .total-row {
    border-top: 3px solid var(--border-color);
    background: transparent;
    padding-top: 1rem;
}

.total-row-paid {
    border-top-color: var(--success-color);
}

.total-row-overdue {
    border-top-color: var(--danger-color);
}

.total-row-issued,
.total-row-draft {
    border-top-color: var(--warning-color);
}

.total-amount-paid {
    font-size: 1.8rem;
    color: var(--success-color);
}

.total-amount-overdue {
    font-size: 1.8rem;
    color: var(--danger-color);
}

.total-amount-issued,
.total-amount-draft {
    font-size: 1.8rem;
    color: var(--warning-color);
}

.total-amount-void,
.total-amount-refunded {
    font-size: 1.8rem;
    color: var(--text-muted);
}

.billing-info-item {
    padding: 8px 0;
    border-bottom: 1px solid var(--border-light);
}

.due-date-status-paid {
    color: var(--success-color);
    font-weight: var(--font-weight-medium);
}

.due-date-status-overdue {
    color: var(--danger-color);
    font-weight: var(--font-weight-bold);
    font-size: 1.05rem;
}

.due-date-status-issued,
.due-date-status-draft {
    color: var(--warning-color);
    font-weight: var(--font-weight-medium);
}

.days-overdue-badge-inline {
    background: var(--danger-color);
    color: white;
    padding: 3px 8px;
    border-radius: var(--border-radius-sm);
    font-size: 0.85rem;
    font-weight: var(--font-weight-bold);
    margin-left: 8px;
}

.paid-date-status {
    color: var(--success-color);
    font-weight: var(--font-weight-medium);
    font-size: 1.05rem;
}

.badge-lg {
    padding: 0.5rem 1rem;
    font-size: 1rem;
}

.overdue-status {
    text-align: right;
}

.overdue-days {
    font-size: 0.9rem;
    margin-top: 0.5rem;
}

.overdue-days-badge {
    margin-top: 0.75rem;
    padding: 8px 14px;
    background: rgba(220, 53, 69, 0.1);
    border: 1px solid var(--danger-color);
    border-radius: var(--border-radius-sm);
    color: var(--danger-color);
    font-weight: var(--font-weight-medium);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
}

.overdue-days-badge i {
    font-size: 1rem;
}

.overdue-days-badge-large {
    margin-bottom: 0.75rem;
    padding: 14px 20px;
    background: linear-gradient(135deg, rgba(220, 53, 69, 0.2), rgba(220, 53, 69, 0.3));
    border: 3px solid var(--danger-color);
    border-radius: var(--border-radius-md);
    color: var(--danger-color);
    font-weight: var(--font-weight-bold);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.2rem;
    box-shadow: 0 3px 10px rgba(220, 53, 69, 0.25);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.overdue-days-badge-large i {
    font-size: 1.2rem;
}

.font-weight-bold {
    font-weight: var(--font-weight-bold) !important;
}

.organizer-type-badge-small {
    font-size: 0.85rem;
    padding: 4px 10px;
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-medium);
    display: inline-block;
    background: linear-gradient(135deg, var(--accent-light), var(--accent));
    color: var(--text-inverse);
    box-shadow: var(--shadow-xs);
    margin-left: 8px;
}

.overdue-alert {
    background: rgba(220, 53, 69, 0.1);
    border-left: 4px solid var(--danger-color);
    padding: 12px 16px;
    border-radius: var(--border-radius-sm);
    margin-top: 12px;
    margin-bottom: 12px;
    color: var(--danger-color);
    font-weight: var(--font-weight-medium);
    display: flex;
    align-items: center;
    gap: 8px;
}

.overdue-alert i {
    font-size: 1.1rem;
}

.days-overdue-number {
    background: linear-gradient(135deg, var(--danger-color), #c82333);
    color: white;
    padding: 10px 18px;
    border-radius: var(--border-radius-md);
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    display: inline-block;
    min-width: 70px;
    text-align: center;
    box-shadow: 0 3px 8px rgba(220, 53, 69, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.3);
}

.text-danger {
    color: var(--danger-color);
}

.text-success {
    color: var(--success-color);
}

.text-muted {
    color: var(--text-secondary);
}

.invoice-info-section p {
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.invoice-info-section i {
    width: 16px;
    text-align: center;
    color: var(--text-secondary);
}
</style>
{% endblock %}

