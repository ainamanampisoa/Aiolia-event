{% extends 'base.html.twig' %}

{% block title %}Changer le mot de passe - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <h1 data-i18n="profile.password.header.title">🔐 Changer le mot de passe</h1>
    </div>

    <div class="chart-card password-card">
        <div class="card-body">
            <form method="post" class="simple-form">
                <div class="form-group">
                    <label for="current_password">
                        <span data-i18n="profile.password.form.current.label">Mot de passe actuel</span>
                        <span class="required">*</span>
                    </label>
                    <input id="current_password"
                           type="password"
                           name="current_password"
                           class="form-control"
                           data-i18n-target="placeholder"
                           data-i18n="profile.password.form.current.placeholder"
                           placeholder="Entrez votre mot de passe actuel"
                           required>
                </div>
                
                <div class="form-group">
                    <label for="new_password">
                        <span data-i18n="profile.password.form.new.label">Nouveau mot de passe</span>
                        <span class="required">*</span>
                    </label>
                    <input id="new_password"
                           type="password"
                           name="new_password"
                           class="form-control"
                           data-i18n-target="placeholder"
                           data-i18n="profile.password.form.new.placeholder"
                           placeholder="Entrez un nouveau mot de passe"
                           required>
                </div>
                
                <div class="form-group">
                    <label for="confirm_password">
                        <span data-i18n="profile.password.form.confirm.label">Confirmer le nouveau mot de passe</span>
                        <span class="required">*</span>
                    </label>
                    <input id="confirm_password"
                           type="password"
                           name="confirm_password"
                           class="form-control"
                           data-i18n-target="placeholder"
                           data-i18n="profile.password.form.confirm.placeholder"
                           placeholder="Confirmez le mot de passe"
                           required>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-key"></i>
                        <span data-i18n="profile.password.form.submit">Changer le mot de passe</span>
                    </button>
                    <a href="{{ path('app_profile_index') }}" class="btn btn-secondary">
                        <i class="fas fa-times"></i>
                        <span data-i18n="profile.password.form.cancel">Annuler</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.password-card {
    max-width: 600px;
    margin: 40px auto;
    background: var(--bg-card);
    box-shadow: var(--shadow-md);
    border-radius: 8px;
    padding: 30px 40px;
}

.simple-form {
    width: 100%;
}

.form-group {
    margin-bottom: 24px;
}

.form-group label {
    display: block;
    margin-bottom: 10px;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
}

.required {
    color: var(--danger);
}

.form-control {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid var(--border-color);
    border-radius: 6px;
    font-size: 1rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    background: var(--bg-secondary);
}

.form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 4px rgba(52, 152, 219, 0.2);
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 15px;
    margin-top: 35px;
}

.btn {
    padding: 12px 22px;
    border-radius: 6px;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-primary {
    background: var(--accent);
    color: var(--text-inverse);
    border-color: var(--accent);
}

.btn-primary:hover {
    background: var(--accent-light);
    border-color: var(--accent-light);
    transform: translateY(-1px);
}

.btn-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border-color: var(--border-color);
}

.btn-secondary:hover {
    background: var(--bg-primary);
    border-color: var(--accent);
    color: var(--accent);
}

.dashboard-header h1 {
    text-align: center;
    margin-bottom: 20px;
    font-size: 1.8rem;
}
</style>
<script>
(function () {
    const updateProfilePasswordTitle = () => {
        if (!window.languageManager) {
            return false;
        }
        document.title = window.languageManager.translate('profile.password.meta.title');
        return true;
    };

    const ensureProfilePasswordTitle = () => {
        if (!updateProfilePasswordTitle()) {
            window.setTimeout(ensureProfilePasswordTitle, 100);
        }
    };

    document.addEventListener('DOMContentLoaded', ensureProfilePasswordTitle);
    document.addEventListener('aiolia:language-changed', updateProfilePasswordTitle);
})();
</script>
{% endblock %}
