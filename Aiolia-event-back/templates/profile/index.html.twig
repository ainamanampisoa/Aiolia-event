{% extends 'base.html.twig' %}

{% block title %}Mon profil - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1 data-i18n="profile.header.title">👤 Mon profil</h1>
            <p data-i18n="profile.header.subtitle" style="color: var(--text-secondary); margin-top: 8px; font-size: 1rem;">
                Gérez vos informations personnelles
            </p>
        </div>
    </div>

    <div class="profile-grid">
        <!-- Colonne gauche -->
        <div class="profile-main">
            <!-- Carte profil -->
            <div class="profile-card">
                <div class="profile-header">
                    <form id="avatarUploadForm" class="profile-avatar-large" action="{{ path('app_profile_photo') }}" method="POST" enctype="multipart/form-data">
                        {% set avatarUrl = app.user.urlAvatar %}
                        {% set userInitials = app.user.urlPhoto %}

                        {% if avatarUrl %}
                            <img src="{{ avatarUrl }}"
                                 data-i18n-attributes="alt"
                                 data-i18n-attr-alt-key="profile.avatar.alt"
                                 data-i18n-params="{{ {'prenom': app.user.prenom, 'nom': app.user.nom}|json_encode|e('html_attr') }}"
                                 alt="Photo de {{ app.user.prenom }} {{ app.user.nom }}">
                        {% else %}
                            <div class="avatar-large-initials">
                                {{ userInitials ?: (app.user.email|first|upper) }}
                            </div>
                        {% endif %}
                        <label for="avatarUpload"
                               class="avatar-edit-trigger"
                               title="Changer la photo de profil"
                               aria-label="Changer la photo de profil">
                            <i class="fas fa-camera"></i>
                        </label>
                        <input type="file" id="avatarUpload" name="avatar" accept="image/*" class="avatar-file-input">
                        <input type="hidden" name="_token" value="{{ csrf_token('profile_photo_upload') }}">
                    </form>
                    <div class="profile-info-header">
                        <h2>{{ app.user.prenom }} {{ app.user.nom }}</h2>
                    </div>
                </div>

                <div class="profile-details">
                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-envelope"></i>
                            <span data-i18n="profile.details.email">Email</span>
                        </div>
                        <div class="detail-value">{{ app.user.email }}</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-phone"></i>
                            <span data-i18n="profile.details.phone">Téléphone</span>
                        </div>
                        <div class="detail-value">
                            {% if app.user.telephone %}
                                {{ app.user.telephone }}
                            {% else %}
                                <span data-i18n="profile.details.phone.unset">Non renseigné</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-user-tag"></i>
                            <span data-i18n="profile.details.role">Rôle</span>
                        </div>
                        <div class="detail-value">{{ app.user.role|capitalize }}</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-calendar"></i>
                            <span data-i18n="profile.details.member_since">Membre depuis</span>
                        </div>
                        <div class="detail-value">{{ app.user.creeLe|date('d F Y') }}</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-clock"></i>
                            <span data-i18n="profile.details.last_login">Dernière connexion</span>
                        </div>
                        <div class="detail-value">{{ app.user.derniereConnexionLe|date('d F Y à H:i') }}</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Colonne droite -->
        <div class="profile-sidebar">
            <!-- Actions rapides -->
            <div class="actions-card">
                 <div class="card-title">
                    <i class="fas fa-cog"></i>
                    <span data-i18n="profile.sidebar.account_settings">Paramètres du compte</span>
                </div>
                <div class="actions-list">
                    <a href="{{ path('app_profile_edit') }}" class="action-link">
                        <i class="fas fa-edit"></i>
                        <span data-i18n="profile.sidebar.edit_profile">Modifier le profil</span>
                    </a>
                    <a href="{{ path('app_profile_password') }}" class="action-link">
                        <i class="fas fa-key"></i>
                        <span data-i18n="profile.sidebar.change_password">Changer le mot de passe</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.profile-grid {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 24px;
    align-items: start;
}

.profile-main {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.profile-card {
    background: var(--bg-card);
    border-radius: var(--border-radius-xl);
    padding: 32px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.profile-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-xl);
}

.profile-header {
    display: flex;
    gap: 24px;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 2px solid var(--border-light);
    align-items: center;
}

.profile-avatar-large {
    flex-shrink: 0;
    position: relative;
}

.profile-avatar-large img,
.avatar-large-initials {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--border-light);
    transition: border-color 0.3s ease;
}

.profile-avatar-large:hover img,
.profile-avatar-large:hover .avatar-large-initials {
    border-color: var(--accent);
}

.avatar-large-initials {
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: var(--font-weight-bold);
    cursor: pointer;
}

.avatar-edit-trigger {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(246, 247, 249, 0.9);
    color: #1d2939;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    border: 2px solid #d0d5dd;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.avatar-edit-trigger:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 14px rgba(15, 23, 42, 0.18);
}

.avatar-file-input {
    display: none;
}

#avatarUploadForm.uploading .avatar-edit-trigger {
    opacity: 0.6;
    pointer-events: none;
}

.profile-info-header h2 {
    font-size: 1.8rem;
    color: var(--text-primary);
    margin: 0 0 8px 0;
    line-height: 1.2;
}

.profile-info-header p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin: 0 0 12px 0;
}

.profile-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-light);
    transition: background-color 0.2s ease;
}

.detail-row:hover {
    background-color: var(--bg-secondary);
    margin: 0 -8px;
    padding: 14px 8px;
    border-radius: var(--border-radius-md);
}

.detail-row:last-child {
    border-bottom: none;
}

.detail-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
}

.detail-label i {
    color: var(--accent);
    width: 20px;
    text-align: center;
}

.detail-value {
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    text-align: right;
    flex: 1;
}

.profile-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 20px;
}

.actions-card {
    background: var(--bg-card);
    border-radius: var(--border-radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-color);
    transition: transform 0.2s ease;
}

.actions-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-lg);
}

.card-title {
    font-size: 1.2rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-light);
}

.card-title i {
    color: var(--accent);
}

.actions-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.action-link {
    padding: 14px 16px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.3s ease;
    border: 1px solid var(--border-light);
    font-weight: var(--font-weight-medium);
}

.action-link:hover {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
    transform: translateX(4px);
}

.action-link i {
    width: 20px;
    transition: transform 0.2s ease;
}

.action-link:hover i {
    transform: scale(1.1);
}

/* Responsive */
@media (max-width: 1024px) {
    .profile-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .profile-sidebar {
        position: static;
    }
}

@media (max-width: 768px) {
    .profile-header {
        flex-direction: column;
        text-align: center;
        gap: 20px;
    }
    
    .profile-card {
        padding: 24px 20px;
    }
    
    .detail-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
    
    .detail-value {
        text-align: left;
        width: 100%;
    }
    
    .action-link {
        padding: 12px 14px;
        font-size: 0.95rem;
    }
}

@media (max-width: 480px) {
    .profile-grid {
        gap: 16px;
    }
    
    .profile-card {
        padding: 20px 16px;
        border-radius: var(--border-radius-lg);
    }
    
    .profile-avatar-large img,
    .avatar-large-initials {
        width: 100px;
        height: 100px;
        font-size: 2rem;
    }
    
    .profile-info-header h2 {
        font-size: 1.5rem;
    }
    
    .actions-card {
        padding: 20px 16px;
    }
}
</style>

<script>
(function () {
    const updateProfileTitle = () => {
        if (!window.languageManager) {
            return false;
        }
        document.title = window.languageManager.translate('profile.meta.title');
        return true;
    };

    const updateAvatarTriggerLabels = () => {
        if (!window.languageManager) {
            return;
        }
        const trigger = document.querySelector('.avatar-edit-trigger');
        if (!trigger) {
            return;
        }
        const label = window.languageManager.translate('profile.avatar.change');
        trigger.setAttribute('title', label);
        trigger.setAttribute('aria-label', label);
    };

    const initAvatarUpload = () => {
        const fileInput = document.getElementById('avatarUpload');
        const form = document.getElementById('avatarUploadForm');

        if (!fileInput || !form) {
            return;
        }

        fileInput.addEventListener('change', function () {
            if (!fileInput.files || fileInput.files.length === 0) {
                return;
            }

            form.classList.add('uploading');
            form.submit();
        });
    };

    const ensureProfileTitle = () => {
        if (!updateProfileTitle()) {
            window.setTimeout(ensureProfileTitle, 100);
        }
    };

    document.addEventListener('DOMContentLoaded', function () {
        ensureProfileTitle();
        updateAvatarTriggerLabels();
        initAvatarUpload();
    });

    document.addEventListener('aiolia:language-changed', function () {
        updateProfileTitle();
        updateAvatarTriggerLabels();
    });
})();
</script>
{% endblock %}

