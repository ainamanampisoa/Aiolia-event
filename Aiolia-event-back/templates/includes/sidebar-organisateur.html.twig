{% set currentRoute = app.request.attributes.get('_route') %}
{% set isStats = currentRoute starts with 'app_organisateur_dashboard_statistiques' %}
{% set isReports = currentRoute starts with 'organisateur_reports' %}
{% set isEvents = currentRoute starts with 'organisateur_events' or currentRoute starts with 'app_event' %}
{% set isPromotions = currentRoute starts with 'organisateur_promotions' %}
{% set isWaitlist = currentRoute starts with 'organisateur_waitlist' %}
{% set isPaiementAbonnement = currentRoute starts with 'organisateur_paiement_abonnement' %}
{% set isScanning = currentRoute == 'app_ticket_scanning' %}
{% set isProfile = currentRoute starts with 'app_profile' %}
{% set isSettings = currentRoute starts with 'app_settings' %}

<aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <img src="{{ asset('images/aiolia-logo.svg') }}" alt="Aiolia Event" class="logo-image">
        </div>
    </div>
    
    <nav class="sidebar-nav" aria-label="Main navigation">
        <ul class="nav-menu">
            <li class="nav-section">
                <span class="nav-section-title" data-i18n="layout.sidebar.organisateur_section">Tableau de bord</span>
            </li>
            
            <li class="nav-item {{ isStats ? 'active' }}">
                <a href="{{ path('app_organisateur_dashboard_statistiques') }}" class="nav-link {{ isStats ? 'active' }}" {% if isStats %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.organisateur.stats">Statistiques</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.organisateur.stats">Statistiques</span>
                </a>
            </li>
            
            <li class="nav-item {{ isReports ? 'active' }}">
                <a href="{{ path('organisateur_reports_index') }}" class="nav-link {{ isReports ? 'active' }}" {% if isReports %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.organisateur.reports">Rapports</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.organisateur.reports">Rapports</span>
                </a>
            </li>
            
            <li class="nav-section">
                <span class="nav-section-title" data-i18n="layout.sidebar.organisateur.events_section">Gestion</span>
            </li>
            
            <li class="nav-item {{ isEvents ? 'active' }}">
                <a href="{{ path('organisateur_events_index') }}" class="nav-link {{ isEvents ? 'active' }}" {% if isEvents %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.organisateur.events">Événement</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.organisateur.events">Événement</span>
                </a>
            </li>
            
            <li class="nav-item {{ isScanning ? 'active' }}">
                <a href="{{ path('app_ticket_scanning') }}" class="nav-link {{ isScanning ? 'active' }}" {% if isScanning %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-qrcode"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.organisateur.scanner">Scanner</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.organisateur.scanner">Scanner</span>
                </a>
            </li>
            
            {% set isStockAlerts = currentRoute == 'app_ticket_stock_alerts' %}
            {% if has_stock_alerts_for_active_events() %}
            <li class="nav-item {{ isStockAlerts ? 'active' }}">
                <a href="{{ path('app_ticket_stock_alerts') }}" class="nav-link {{ isStockAlerts ? 'active' }}" {% if isStockAlerts %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-bell"></i>
                    </div>
                    <span class="nav-text">Alertes de stock</span>
                    <span class="nav-tooltip">Alertes de stock</span>
                </a>
            </li>
            {% endif %}
            
            <li class="nav-item {{ isWaitlist ? 'active' }}">
                <a href="{{ path('organisateur_waitlist_index') }}" class="nav-link {{ isWaitlist ? 'active' }}" {% if isWaitlist %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-list-alt"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.organisateur.waitlist">Liste d'attente</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.organisateur.waitlist">Liste d'attente</span>
                </a>
            </li>
            
            <li class="nav-item {{ isPromotions ? 'active' }}">
                <a href="{{ path('organisateur_promotions_index') }}" class="nav-link {{ isPromotions ? 'active' }}" {% if isPromotions %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-tags"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.organisateur.promotions">Promotions</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.organisateur.promotions">Promotions</span>
                </a>
            </li>
            
            <li class="nav-item {{ isPaiementAbonnement ? 'active' }}">
                <a href="{{ path('organisateur_paiement_abonnement_index') }}" class="nav-link {{ isPaiementAbonnement ? 'active' }}" {% if isPaiementAbonnement %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <span class="nav-text">Paiement Abonnement</span>
                    <span class="nav-tooltip">Paiement Abonnement</span>
                </a>
            </li>
            
            <li class="nav-section">
                <span class="nav-section-title" data-i18n="layout.sidebar.account_section">Compte</span>
            </li>
            
            <li class="nav-item {{ isProfile ? 'active' }}">
                <a href="{{ path('app_profile_index') }}" class="nav-link {{ isProfile ? 'active' }}" {% if isProfile %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.profile">Profil</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.profile">Profil</span>
                </a>
            </li>
            
            <li class="nav-item {{ isSettings ? 'active' }}">
                <a href="{{ path('app_settings_index') }}" class="nav-link {{ isSettings ? 'active' }}" {% if isSettings %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-sliders"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.settings">Paramètres</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.settings">Paramètres</span>
                </a>
            </li>
        </ul>
    </nav>
    
</aside>

<style>
    /* Scroll vertical indépendant pour la sidebar */
    #adminSidebar.admin-sidebar {
        width: 350px !important;
        min-width: 350px !important;
        max-width: 350px !important;
        display: flex !important;
        flex-direction: column !important;
        height: calc(100vh - var(--header-height)) !important;
        max-height: calc(100vh - var(--header-height)) !important;
        overflow: hidden !important;
        position: fixed !important;
        top: var(--header-height) !important;
        border-top: none !important;
        margin-top: 0 !important;
        z-index: var(--z-sticky) !important;
    }
    
    /* Ajuste le contenu principal */
    .admin-main {
        margin-left: 350px !important;
        width: calc(100% - 350px) !important;
        margin-top: var(--header-height) !important;
    }
    
    #adminSidebar .sidebar-header {
        flex-shrink: 0 !important;
        flex-grow: 0 !important;
        height: auto !important;
        min-height: 100px !important;
    }
    
    #adminSidebar .sidebar-nav {
        flex: 1 1 auto !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        min-height: 0 !important;
        -webkit-overflow-scrolling: touch !important;
        position: relative !important;
        padding: 2rem 0 !important;
    }
    
    #adminSidebar .nav-menu {
        min-height: 100% !important;
    }
    
    /* Scrollbar visible et stylisée */
    #adminSidebar .sidebar-nav::-webkit-scrollbar {
        width: 10px !important;
        display: block !important;
    }
    
    #adminSidebar .sidebar-nav::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.03) !important;
        border-radius: 8px !important;
        margin: 8px 0 !important;
    }
    
    #adminSidebar .sidebar-nav::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, rgba(255,255,255,0.25), rgba(255,255,255,0.15)) !important;
        border-radius: 8px !important;
        border: 2px solid rgba(255,255,255,0.1) !important;
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.1) !important;
    }
    
    #adminSidebar .sidebar-nav::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, rgba(255,255,255,0.35), rgba(255,255,255,0.25)) !important;
        border-color: rgba(255,255,255,0.2) !important;
    }
    
    /* Firefox */
    #adminSidebar .sidebar-nav {
        scrollbar-width: thin !important;
        scrollbar-color: rgba(255,255,255,0.25) rgba(255,255,255,0.03) !important;
    }
</style>

<script>
    // Ajuste dynamiquement la hauteur de la sidebar-nav
    document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('adminSidebar');
        const sidebarNav = sidebar?.querySelector('.sidebar-nav');
        const sidebarHeader = sidebar?.querySelector('.sidebar-header');
        
        function adjustSidebarHeight() {
            if (sidebar && sidebarNav && sidebarHeader) {
                // La sidebar utilise flexbox, donc on s'assure juste que les hauteurs sont correctes
                // Le flex: 1 1 auto sur sidebar-nav devrait automatiquement prendre l'espace restant
                const headerHeight = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 145;
                const sidebarHeight = window.innerHeight - headerHeight;
                
                // S'assurer que la sidebar a la bonne hauteur
                sidebar.style.height = sidebarHeight + 'px';
                sidebar.style.maxHeight = sidebarHeight + 'px';
                
                // La sidebar-nav avec flex: 1 1 auto prendra automatiquement l'espace restant
                // On retire toute hauteur fixe pour laisser flexbox gérer
                sidebarNav.style.maxHeight = 'none';
                sidebarNav.style.height = 'auto';
                sidebarNav.style.overflowY = 'auto';
                sidebarNav.style.overflowX = 'hidden';
            }
        }
        
        // Ajuster au chargement
        adjustSidebarHeight();
        
        // Recalculer lors du redimensionnement
        window.addEventListener('resize', adjustSidebarHeight);
        
        // Ajuster après un court délai pour s'assurer que tout est chargé
        setTimeout(adjustSidebarHeight, 100);
    });
</script>


