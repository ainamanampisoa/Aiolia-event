        scrollbar-color: rgba(255,255,255,0.3) rgba(255,255,255,0.03) !important;
    }
    
    /* Amélioration de l'affichage général - Style moderne et professionnel */
    #adminSidebar .nav-section {
        padding: 1.25rem 1.5rem 0.75rem !important;
        margin-top: 1.5rem !important;
    }
    
    #adminSidebar .nav-section:first-child {
        margin-top: 0 !important;
        padding-top: 0.25rem !important;
    }
    
    #adminSidebar .nav-section-title {
