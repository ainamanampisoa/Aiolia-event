    }
    
    #adminSidebar .nav-menu {
        min-height: auto !important;
        padding-bottom: 1.5rem !important;
    }
    
    /* Scrollbar moderne et élégante */
    #adminSidebar .sidebar-nav::-webkit-scrollbar {
