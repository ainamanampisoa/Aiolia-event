{% set currentRoute = app.request.attributes.get('_route') %}
{% set isStats = currentRoute == 'app_reports_statistiques' %}
{% set isUserManagement = currentRoute starts with 'admin_users' or currentRoute starts with 'admin_audit_' %}
{% set isBilling = currentRoute starts with 'admin_billing' %}
{% set isProfile = currentRoute starts with 'app_profile' %}
{% set isSettings = currentRoute starts with 'app_settings' %}

<aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <img src="{{ asset('images/aiolia-logo.svg') }}" alt="Aiolia Event" class="logo-image">
        </div>
    </div>
    
    <nav class="sidebar-nav" aria-label="Main navigation">
        <ul class="nav-menu">
            <li class="nav-section">
                <span class="nav-section-title" data-i18n="layout.sidebar.analytics_section">Analytique & Rapports</span>
            </li>
            
            <li class="nav-item {{ isStats ? 'active' }}">
                <a href="{{ path('app_reports_statistiques') }}" class="nav-link {{ isStats ? 'active' }}" {% if isStats %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.analytics_stats">Statistiques</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.analytics_stats">Statistiques</span>
                </a>
            </li>
            
            {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-section">
                <span class="nav-section-title" data-i18n="layout.sidebar.admin_section"></span>
            </li>
            
            <li class="nav-item {{ isUserManagement ? 'active' }}">
                <a href="{{ path('admin_users_list') }}" class="nav-link {{ isUserManagement ? 'active' }}" {% if isUserManagement %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-users-gear"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.users"></span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.users"></span>
                </a>
            </li>
            
            <li class="nav-item {{ isBilling ? 'active' }}">
                <a href="{{ path('admin_billing_invoices') }}" class="nav-link {{ isBilling ? 'active' }}" {% if isBilling %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.billing">Facturation & Paiement</span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.billing">Facturation & Paiement</span>
                </a>
            </li>
            {% endif %}
            
            <li class="nav-section">
                <span class="nav-section-title" data-i18n="layout.sidebar.account_section"></span>
            </li>
            
            <li class="nav-item {{ isProfile ? 'active' }}">
                <a href="{{ path('app_profile_index') }}" class="nav-link {{ isProfile ? 'active' }}" {% if isProfile %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.profile"></span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.profile"></span>
                </a>
            </li>
            
            <li class="nav-item {{ isSettings ? 'active' }}">
                <a href="{{ path('app_settings_index') }}" class="nav-link {{ isSettings ? 'active' }}" {% if isSettings %}aria-current="page"{% endif %}>
                    <div class="nav-icon">
                        <i class="fas fa-sliders"></i>
                    </div>
                    <span class="nav-text" data-i18n="layout.sidebar.settings"></span>
                    <span class="nav-tooltip" data-i18n="layout.sidebar.settings"></span>
                </a>
            </li>
        </ul>
    </nav>
    
</aside>

<style>
    /* Ajustement de la hauteur de la sidebar avec le nouveau header */
    /* Sidebar moderne et professionnelle avec effets premium */
    #adminSidebar.admin-sidebar {
        width: 350px !important;
        min-width: 350px !important;
        max-width: 350px !important;
        display: flex !important;
        flex-direction: column !important;
        height: calc(100vh - var(--header-height)) !important;
        max-height: calc(100vh - var(--header-height)) !important;
        overflow: hidden !important;
        position: fixed !important;
        top: var(--header-height) !important;
        left: 0 !important;
        border-top: none !important;
        margin-top: 0 !important;
        z-index: var(--z-sticky) !important;
        background: linear-gradient(180deg, #1a2332 0%, #1e2838 50%, #1a2332 100%) !important;
        box-shadow: 4px 0 40px rgba(0, 0, 0, 0.3), 2px 0 20px rgba(0, 0, 0, 0.25), inset -1px 0 0 rgba(255,255,255,0.08), 0 0 60px rgba(0, 0, 0, 0.15) !important;
        border-right: 1px solid rgba(255,255,255,0.12) !important;
        backdrop-filter: blur(20px) saturate(180%) !important;
    }
    
    /* Ajuste le contenu principal */
    .admin-main {
        margin-left: 350px !important;
        width: calc(100% - 350px) !important;
        margin-top: var(--header-height) !important;
        min-height: calc(100vh - var(--header-height)) !important;
    }
    
    #adminSidebar .sidebar-header {
        flex-shrink: 0 !important;
        flex-grow: 0 !important;
        height: 56px !important;
        min-height: 56px !important;
        max-height: 56px !important;
        padding: 0.75rem 1.5rem !important;
        border-bottom: 1px solid rgba(255,255,255,0.1) !important;
        background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)) !important;
        backdrop-filter: blur(10px) !important;
    }
    
    #adminSidebar .sidebar-nav {
        flex: 1 1 auto !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        min-height: 0 !important;
        -webkit-overflow-scrolling: touch !important;
