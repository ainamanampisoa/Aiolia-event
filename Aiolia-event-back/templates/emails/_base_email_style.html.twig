{#
    Template de base pour le style des emails
    Style simple et épuré sans bordures - Inspiré JetBrains
    Couleurs harmonisées avec Aiolia-Event
#}
<style>
    html {
        width: 100%;
        height: 100%;
    }
    
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        text-align: left !important;
    }
    
    body {
        margin: 0;
        padding: 0;
        background: #F8F9FA;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        color: #1F2D3D;
        line-height: 1.6;
        font-size: 15px;
        text-align: left !important;
        width: 100%;
        height: 100%;
    }
    
    p, h1, h2, h3, h4, h5, h6, div, span, td, th, li {
        text-align: left !important;
    }
    
    .email-wrapper {
        width: 100%;
        height: 100%;
        padding: 0;
        box-sizing: border-box;
    }
    
    .email-card {
        width: 100%;
        height: 100%;
        margin: 0;
        background: #ffffff;
        overflow: hidden;
    }
    
    .email-header {
        padding: 32px 32px 24px;
        text-align: left !important;
        background: #ffffff;
    }
    
    .email-header h1 {
        margin: 0 0 8px;
        font-size: 24px;
        font-weight: 600;
        color: #1F2D3D;
        line-height: 1.3;
        text-align: left !important;
    }
    
    .email-header p {
        margin: 0;
        font-size: 15px;
        color: #6C757D;
        font-weight: 400;
        text-align: left !important;
    }
    
    .email-body {
        padding: 0 32px 32px;
        background: #ffffff;
        text-align: left !important;
    }
    
    .greeting {
        font-size: 15px;
        line-height: 1.7;
        color: #1F2D3D;
        margin-bottom: 32px;
        text-align: left !important;
    }
    
    .greeting p {
        margin: 8px 0;
        text-align: left !important;
    }
    
    .content-section {
        margin: 32px 0;
        padding: 24px;
        background: #F1F3F5;
        border-radius: 0;
        text-align: left !important;
    }
    
    .content-section h2 {
        margin: 0 0 16px;
        font-size: 18px;
        font-weight: 600;
        color: #1F2D3D;
        text-align: left !important;
    }
    
    .content-section p {
        margin: 12px 0;
        font-size: 15px;
        color: #495057;
        line-height: 1.6;
        text-align: left !important;
    }
    
    .content-section p:first-child {
        margin-top: 0;
    }
    
    .content-section p:last-child {
        margin-bottom: 0;
    }
    
    .info-box {
        margin: 32px 0;
        padding: 24px;
        background: #F1F3F5;
        text-align: left !important;
    }
    
    .info-box h2 {
        margin: 0 0 20px;
        font-size: 18px;
        font-weight: 600;
        color: #1F2D3D;
        text-align: left !important;
    }
    
    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        font-size: 15px;
    }
    
    .info-row:last-child {
        border-bottom: none;
    }
    
    .info-label {
        color: #6C757D;
        font-weight: 500;
    }
    
    .info-value {
        color: #1F2D3D;
        font-weight: 500;
        text-align: right;
    }
    
    .invoice-details {
        margin: 32px 0;
        padding: 24px;
        background: #F1F3F5;
        text-align: left !important;
    }
    
    .invoice-details h2 {
        margin: 0 0 20px;
        font-size: 18px;
        font-weight: 600;
        color: #1F2D3D;
        text-align: left !important;
    }
    
    .invoice-info {
        margin-bottom: 24px;
    }
    
    .invoice-amounts {
        margin-top: 24px;
        padding-top: 24px;
    }
    
    .amount-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        font-size: 15px;
    }
    
    .amount-row.total {
        font-size: 18px;
        font-weight: 600;
        padding: 16px 0 0;
        margin-top: 16px;
        color: #1F2D3D;
    }
    
    .amount-label {
        color: #6C757D;
        font-weight: 500;
    }
    
    .amount-value {
        color: #1F2D3D;
        font-weight: 500;
    }
    
    .amount-value.total {
        font-size: 20px;
        font-weight: 600;
        color: #1F2D3D;
    }
    
    .badge {
        display: inline;
        font-size: 14px;
        font-weight: 600;
        text-transform: none;
        letter-spacing: 0;
        color: #3498DB;
    }
    
    .status-badge {
        display: inline;
        font-size: 14px;
        font-weight: 600;
        text-transform: none;
        letter-spacing: 0;
    }
    
    .status-badge.success {
        color: #27AE60;
    }
    
    .status-badge.warning {
        color: #F39C12;
    }
    
    .status-badge.error {
        color: #E74C3C;
    }
    
    .cta {
        margin: 32px 0 24px;
    }
    
    .cta a {
        display: inline-block;
        padding: 12px 24px;
        background: #3498DB;
        color: #ffffff;
        text-decoration: none;
        font-weight: 500;
        font-size: 15px;
        border-radius: 4px;
        letter-spacing: 0.3px;
    }
    
    .cta a:hover {
        background: #2980B9;
    }
    
    .divider {
        height: 1px;
        background: #E9ECEF;
        margin: 32px 0;
        border: none;
    }
    
    .footer {
        padding: 24px 32px;
        text-align: left !important;
        font-size: 13px;
        color: #6C757D;
        background: #F8F9FA;
    }
    
    .footer p {
        margin: 6px 0;
        line-height: 1.6;
        text-align: left !important;
    }
    
    .footer a {
        color: #3498DB;
        text-decoration: none;
    }
    
    .footer a:hover {
        text-decoration: underline;
    }
    
    @media only screen and (max-width: 600px) {
        .email-wrapper {
            padding: 0;
        }
        
        .email-header {
            padding: 32px 20px 24px;
        }
        
        .email-header h1 {
            font-size: 24px;
        }
        
        .email-body {
            padding: 0 20px 24px;
        }
        
        .content-section,
        .info-box,
        .invoice-details {
            padding: 20px;
        }
        
        .info-row {
            flex-direction: column;
            gap: 4px;
        }
        
        .info-value {
            text-align: left;
        }
        
        .cta a {
            padding: 12px 24px;
            font-size: 14px;
            display: inline-block;
            margin: 4px 8px 4px 0;
        }
        
        .footer {
            padding: 24px 20px;
        }
    }
</style>

