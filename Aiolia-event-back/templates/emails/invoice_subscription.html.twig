<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Facture {{ invoice.invoiceNumber }} - Aiolia Event</title>
    {% include 'emails/_base_email_style.html.twig' %}
    <style>
        .invoice-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 24px;
        }
        
        .invoice-info-item {
            font-size: 15px;
            line-height: 1.6;
        }
        
        .invoice-info-item strong {
            display: block;
            color: #6C757D;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .invoice-info-item span,
        .invoice-info-item div {
            color: #1F2D3D;
            font-size: 15px;
            font-weight: 500;
        }
        
        .support-info {
            margin: 32px 0;
            padding: 24px;
            background: #F1F3F5;
        }
        
        .support-info p {
            margin: 8px 0;
            font-size: 14px;
            color: #495057;
        }
        
        .support-info a {
            color: #1F2D3D;
            text-decoration: none;
            font-weight: 500;
        }
        
        @media only screen and (max-width: 600px) {
            .invoice-info {
                grid-template-columns: 1fr;
                gap: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <div class="email-card">
            <div class="email-header">
                <h1>
                    {% if isOverdueNotification %}
                        Facture en retard de paiement
                    {% elseif invoice.status == 'paid' %}
                        Confirmation de paiement
                    {% else %}
                        Facture d'abonnement mensuel
                    {% endif %}
                </h1>
                {% if not isOverdueNotification and invoice.status != 'paid' %}
                    <p>Votre facture est prête</p>
                {% endif %}
            </div>

            <div class="email-body">
                <div class="greeting">
                    <p>Bonjour <strong>{{ customer.prenom }} {{ customer.nom }}</strong>,</p>
                </div>

                {% if isOverdueNotification %}
                    {% set daysOverdue = invoice.getDaysOverdue() %}
                    <div class="content-section">
                        <p>
                            Nous vous informons que votre facture d'abonnement mensuel <strong>N° {{ invoice.invoiceNumber }}</strong> est en retard de paiement depuis 
                            {% if daysOverdue is not null %}
                                <strong>{{ daysOverdue }} jour{{ daysOverdue > 1 ? 's' : '' }}</strong>.
                            {% else %}
                                plusieurs jours.
                            {% endif %}
                        </p>
                        <p>
                            Pour maintenir la continuité de votre abonnement organisateur et éviter toute interruption de service, nous vous invitons à régler cette facture dans les plus brefs délais.
                        </p>
                        {% if invoice.dueAt %}
                            <p><strong>Date d'échéance :</strong> {{ invoice.dueAt|date('d/m/Y') }}</p>
                        {% endif %}
                    </div>
                {% elseif invoice.status == 'paid' %}
                    <div class="content-section">
                        <p>Nous vous confirmons la réception et le traitement de votre paiement pour la facture N° {{ invoice.invoiceNumber }}. Votre abonnement reste actif.</p>
                    </div>
                {% endif %}
                

                <div class="invoice-details">
                    <h2>Détails de la facture</h2>
                    <div class="invoice-info">
                        <div class="invoice-info-item">
                            <strong>Numéro de facture</strong>
                            <span>{{ invoice.invoiceNumber }}</span>
                        </div>
                        <div class="invoice-info-item">
                            <strong>Date d'émission</strong>
                            <span>{{ invoice.issuedAt|date('d/m/Y à H:i') }}</span>
                        </div>
                        <div class="invoice-info-item">
                            <strong>Type de facture</strong>
                            <span>Abonnement mensuel organisateur</span>
                        </div>
                        <div class="invoice-info-item">
                            <strong>Statut du paiement</strong>
                            <div>
                                {% if invoice.status == 'paid' %}
                                    <span class="status-badge success" style="color: #27AE60; font-weight: 600;">Payée</span>
                                    {% if invoice.paidAt %}
                                        <br><span style="font-size: 13px; margin-top: 6px; display: block; color: #6C757D;">
                                            Payée le {{ invoice.paidAt|date('d/m/Y à H:i') }}
                                        </span>
                                    {% endif %}
                                {% elseif invoice.status == 'overdue' %}
                                    <span class="status-badge error" style="color: #E74C3C; font-weight: 600;">En retard</span>
                                    {% set daysOverdue = invoice.getDaysOverdue() %}
                                    {% if daysOverdue is not null %}
                                        <span style="font-size: 13px; color: #6C757D; margin-left: 8px;">{{ daysOverdue }} jour{{ daysOverdue > 1 ? 's' : '' }} de retard</span>
                                    {% endif %}
                                {% elseif invoice.status == 'issued' or invoice.status == 'draft' %}
                                    <span class="status-badge warning" style="color: #F39C12; font-weight: 600;">En attente de paiement</span>
                                {% else %}
                                    <span class="status-badge" style="color: #3498DB; font-weight: 600;">{{ invoice.status }}</span>
                                {% endif %}
                            </div>
                        </div>
                        {% if invoice.dueAt %}
                        <div class="invoice-info-item">
                            <strong>Date d'échéance</strong>
                            <span>
                                {{ invoice.dueAt|date('d/m/Y') }}
                                {% if invoice.status == 'overdue' %}
                                    <span style="color: #666666; margin-left: 8px;">(Échue)</span>
                                {% endif %}
                            </span>
                        </div>
                        {% endif %}
                        <div class="invoice-info-item">
                            <strong>Client</strong>
                            <span>{{ customer.prenom }} {{ customer.nom }}</span>
                        </div>
                        <div class="invoice-info-item">
                            <strong>Email de facturation</strong>
                            <span>{{ customer.email }}</span>
                        </div>
                    </div>

                    <div class="invoice-amounts">
                        <div class="amount-row">
                            <span class="amount-label">Montant HT (hors taxes)</span>
                            <span class="amount-value">{{ invoice.subtotalAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</span>
                        </div>
                        <div class="amount-row">
                            <span class="amount-label">TVA (20%)</span>
                            <span class="amount-value">{{ invoice.taxAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</span>
                        </div>
                        <div class="amount-row total">
                            <span class="amount-label">Montant total TTC</span>
                            <span class="amount-value total">{{ invoice.totalAmount|number_format(0, ',', ' ') }} {{ invoice.currency }}</span>
                        </div>
                    </div>
                </div>

                <div class="divider"></div>

                {% if isOverdueNotification %}
                    <div class="content-section">
                        <p>
                            Pour maintenir la continuité de votre service d'abonnement organisateur et éviter toute suspension, veuillez procéder au règlement de cette facture dans les plus brefs délais.
                        </p>
                        <p>
                            Vous pouvez consulter et télécharger votre facture détaillée au format PDF depuis votre espace organisateur.
                        </p>
                    </div>
                {% elseif invoice.status == 'paid' %}
                    <div class="content-section">
                        <p>
                            Votre facture a été payée avec succès. Nous vous remercions pour votre confiance. Votre abonnement organisateur reste actif et vous pouvez continuer à utiliser tous les services inclus dans votre plan.
                        </p>
                        {% if invoice.dueAt and invoice.paidAt %}
                            {% set paidDate = invoice.paidAt|date('U') %}
                            {% set dueDate = invoice.dueAt|date('U') %}
                            {% if paidDate < dueDate %}
                                {% set daysBefore = ((dueDate - paidDate) / 86400)|round %}
                                <p style="margin-top: 12px; font-weight: 500;">
                                    Vous avez réglé votre facture avec {{ daysBefore }} jour{{ daysBefore > 1 ? 's' : '' }} d'avance sur la date d'échéance. Nous apprécions votre ponctualité.
                                </p>
                            {% endif %}
                        {% endif %}
                        <p>
                            Vous pouvez consulter et télécharger votre facture au format PDF depuis votre espace organisateur.
                        </p>
                    </div>
                {% else %}
                    <div class="content-section">
                        <p>
                            Vous pouvez consulter et télécharger votre facture détaillée au format PDF depuis votre espace organisateur. 
                            N'hésitez pas à nous contacter si vous avez des questions concernant cette facture.
                        </p>
                    </div>
                {% endif %}

                <div class="cta">
                    {% if pdf_download_url is defined and pdf_download_url %}
                        <a href="{{ pdf_download_url }}" target="_blank" rel="noopener noreferrer" style="background: #3498DB; color: #ffffff;">
                            Télécharger la facture en PDF
                        </a>
                    {% endif %}
                    <a href="{{ absolute_url(path('app_profile_index')) }}" style="background: #3498DB; color: #ffffff;">
                        {% if isOverdueNotification %}
                            Régler ma facture maintenant
                        {% else %}
                            Accéder à mon espace organisateur
                        {% endif %}
                    </a>
                </div>

                <div class="support-info">
                    <p style="font-weight: 600; color: #1F2D3D; margin-bottom: 8px;">
                        Besoin d'aide ?
                    </p>
                    <p>
                        Notre équipe de support est disponible pour vous accompagner.<br>
                        Contactez-nous par email à <a href="mailto:support@aiolia-event.com" style="color: #3498DB;">support@aiolia-event.com</a><br>
                        ou consultez notre centre d'aide en ligne.
                    </p>
                </div>
            </div>

            <div class="footer">
                <p><strong>Aiolia Event</strong> - Plateforme de gestion d'événements</p>
                <p style="margin-top: 8px;">
                    Cet e-mail a été envoyé automatiquement à l'adresse <a href="mailto:{{ customer.email }}">{{ customer.email }}</a>.<br>
                    Merci de ne pas répondre directement à cet e-mail.
                </p>
                <div class="divider"></div>
                <p>
                    &copy; {{ "now"|date("Y") }} Aiolia Event – Tous droits réservés.<br>
                    <a href="#">Politique de confidentialité</a> | <a href="#">Conditions d'utilisation</a> | <a href="#">Centre d'aide</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>

