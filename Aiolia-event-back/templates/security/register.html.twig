<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - Plateforme de Ticketing</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Styles supplémentaires pour des champs plus grands */
        .auth-wrapper {
            min-height: 750px;
            max-height: 800px;
        }
        
        .auth-left {
            padding: 60px 40px;
        }
        
        .auth-right {
            padding: 50px 40px;
            overflow-y: auto;
        }
        
        .auth-content {
            max-width: 100%;
        }
        
        .form-row {
            display: flex;
            gap: 25px;
            margin-bottom: 30px;
        }
        
        .form-row .form-group {
            flex: 1;
            margin-bottom: 0;
        }
        
        .auth-form-container h2 {
            font-size: 2.2rem;
            margin-bottom: 15px;
        }
        
        .auth-subtitle {
            margin-bottom: 40px;
            font-size: 1.1rem;
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        .auth-form .form-control {
            padding: 18px 20px;
            font-size: 1.1rem;
            border-radius: 12px;
            border: 2px solid var(--beige);
        }
        
        .auth-form label {
            font-size: 1rem;
            margin-bottom: 10px;
        }
        
        .form-check {
            margin-bottom: 30px;
        }
        
        .form-check-label {
            font-size: 1rem;
        }
        
        .auth-btn {
            padding: 18px;
            font-size: 1.1rem;
            border-radius: 12px;
        }
        
        .auth-links {
            margin-top: 30px;
            font-size: 1rem;
        }
        
        /* Espacement supplémentaire */
        .auth-form-container {
            padding: 10px 0;
        }
        
        /* Optimisation pour mobile */
        @media (max-width: 768px) {
            .form-row {
                flex-direction: column;
                gap: 0;
            }
            
            .auth-wrapper {
                min-height: auto;
                max-height: none;
            }
            
            .auth-right {
                overflow-y: visible;
                padding: 40px 30px;
            }
            
            .auth-left {
                padding: 40px 30px;
            }
        }
    </style>
</head>
<body class="auth-body">
    <div class="auth-container">
        <div class="auth-wrapper">
            <!-- Left Side - Branding -->
            <div class="auth-left">
                <div class="auth-features">
                    <div class="auth-logo">
                        <h1>TicketMaster</h1>
                        <p>Rejoignez notre communauté</p>
                    </div>
                    
                   <ul class="feature-list">
                        <li>
                            <i class="fas fa-user-shield"></i>
                            <span>Accès administrateur sécurisé</span>
                        </li>
                        <li>
                            <i class="fas fa-tachometer-alt"></i>
                            <span>Interface de gestion complète</span>
                        </li>
                        <li>
                            <i class="fas fa-cogs"></i>
                            <span>Outils de configuration</span>
                        </li>
                        <li>
                            <i class="fas fa-chart-pie"></i>
                            <span>Statistiques détaillées</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Side - Register Form -->
            <div class="auth-right">
                <div class="auth-content">
                    <div class="auth-form-container">
                        <h2>Inscription</h2>
                        <p class="auth-subtitle">Créez votre compte en quelques secondes</p>

                        <!-- Flash Messages -->
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">{{ message }}</div>
                        {% endfor %}

                        <!-- Register Form -->
                        {{ form_start(registrationForm, {'attr': {'class': 'auth-form'}}) }}
                            <!-- Ligne 1: Prénom et Nom -->
                            <div class="form-row">
                                <div class="form-group">
                                    {{ form_label(registrationForm.firstName) }}
                                    {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
                                </div>

                                <div class="form-group">
                                    {{ form_label(registrationForm.lastName) }}
                                    {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom'}}) }}
                                </div>
                            </div>

                            <!-- Ligne 2: Email et Téléphone -->
                            <div class="form-row">
                                <div class="form-group">
                                    {{ form_label(registrationForm.email) }}
                                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'votre.email@exemple.com'}}) }}
                                </div>

                                <div class="form-group">
                                    {{ form_label(registrationForm.phone) }}
                                    {{ form_widget(registrationForm.phone, {'attr': {'class': 'form-control', 'placeholder': '+261 XX XXX XX'}}) }}
                                </div>
                            </div>

                            <!-- Ligne 3: Mot de passe et Confirmation -->
                            <div class="form-row">
                                <div class="form-group">
                                    {{ form_label(registrationForm.plainPassword.first) }}
                                    <div class="password-input">
                                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Créez un mot de passe'}}) }}
                                        <button type="button" class="toggle-password">
                                            <i class="far fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group">
                                    {{ form_label(registrationForm.plainPassword.second) }}
                                    <div class="password-input">
                                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirmez le mot de passe'}}) }}
                                        <button type="button" class="toggle-password">
                                            <i class="far fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Conditions -->
                            <div class="form-check">
                                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>

                            <!-- Bouton d'inscription -->
                            <button type="submit" class="auth-btn">
                                <i class="fas fa-user-plus"></i> Créer mon compte
                            </button>
                        {{ form_end(registrationForm) }}

                        <div class="auth-links">
                            <a href="{{ path('app_login') }}">Déjà un compte ? Se connecter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Toggle password visibility for all password fields
        document.addEventListener('DOMContentLoaded', function() {
            const toggleButtons = document.querySelectorAll('.toggle-password');
            
            toggleButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const input = this.parentElement.querySelector('input');
                    const icon = this.querySelector('i');
                    const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                    
                    input.setAttribute('type', type);
                    
                    // Toggle icon
                    if (type === 'password') {
                        icon.className = 'far fa-eye';
                    } else {
                        icon.className = 'far fa-eye-slash';
                    }
                });
            });
        });
    </script>
</body>
</html>