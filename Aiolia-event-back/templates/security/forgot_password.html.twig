<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mot de passe oublié - Plateforme de Ticketing</title>
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="auth-body">
    <div class="auth-container">
        <div class="auth-wrapper">
            <!-- Left Side - Branding -->
            <div class="auth-left">
                <div class="auth-features">
                    <div class="auth-logo">
                        <h1>AIOLIA EVENT</h1>
                        <p>Réinitialisez votre mot de passe</p>
                    </div>
                    
                    <ul class="feature-list">
                        <li>
                            <i class="fas fa-lock"></i>
                            <span>Sécurisé et rapide</span>
                        </li>
                        <li>
                            <i class="fas fa-envelope"></i>
                            <span>Lien par email</span>
                        </li>
                        <li>
                            <i class="fas fa-clock"></i>
                            <span>Valide 24h</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Side - Forgot Password Form -->
            <div class="auth-right">
                <div class="auth-content">
                    <div class="auth-form-container">
                        <h2>Mot de passe oublié ?</h2>
                        <p class="auth-subtitle">Entrez votre email et nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>

                        <!-- Flash Messages -->
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">{{ message }}</div>
                        {% endfor %}

                        <!-- Forgot Password Form -->
                        <form method="post" class="auth-form">
                            <div class="form-group">
                                <label for="email">Email <span>*</span></label>
                                <input type="email" name="email" id="email" 
                                       class="form-control" required autofocus 
                                       placeholder="votre@email.com">
                            </div>

                            <button type="submit" class="auth-btn">
                                <i class="fas fa-paper-plane"></i> Envoyer le lien
                            </button>
                        </form>

                        <div class="auth-links">
                            <a href="{{ path('app_login') }}">Retour à la connexion</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

