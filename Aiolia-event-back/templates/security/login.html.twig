<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - Plateforme de Aiolia Event</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Styles spécifiques pour le login */
        .auth-wrapper {
            min-height: 700px;
            max-height: 750px;
        }
        
        .auth-left {
            padding: 60px 40px;
        }
        
        .auth-right {
            padding: 40px 30px;
        }
        
        .auth-form-container {
            max-width: 400px;
            margin: 0 auto;
        }
        
        .auth-form-container h2 {
            font-size: 2rem;
            margin-bottom: 10px;
        }
        
        .auth-subtitle {
            margin-bottom: 30px;
            font-size: 1rem;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .auth-form .form-control {
            padding: 16px 20px;
            font-size: 1rem;
        }
        
        /* Styles améliorés pour les boutons sociaux */
        .social-login {
            display: flex;
            gap: 12px;
            margin-bottom: 25px;
        }
        
        .social-btn {
            flex: 1;
            padding: 14px;
            border: 2px solid var(--beige);
            border-radius: 10px;
            background: var(--white);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 500;
            color: var(--blue);
        }
        
        .social-btn:hover {
            border-color: var(--green);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(31, 45, 61, 0.1);
        }
        
        .social-btn.google {
            background: #DB4437;
            color: white;
            border-color: #DB4437;
        }
        
        .social-btn.google:hover {
            background: #c23321;
            border-color: #c23321;
        }
        
        .social-btn.facebook {
            background: #4267B2;
            color: white;
            border-color: #4267B2;
        }
        
        .social-btn.facebook:hover {
            background: #365899;
            border-color: #365899;
        }
        
        .social-btn .social-icon {
            margin-right: 8px;
            font-size: 1.1rem;
        }
        
        .auth-divider {
            text-align: center;
            margin: 25px 0;
            position: relative;
        }
        
        .auth-divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: var(--beige);
        }
        
        .auth-divider span {
            background: var(--white);
            padding: 0 15px;
            color: #666;
            font-size: 0.9rem;
        }
        
        .form-check {
            margin-bottom: 25px;
        }
        
        .auth-btn {
            padding: 16px;
            font-size: 1rem;
        }
        
        .auth-links {
            margin-top: 25px;
        }

        /* Optimisation pour mobile */
        @media (max-width: 768px) {
            .auth-form-container {
                max-width: 100%;
            }
            
            .social-login {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>
<body class="auth-body">
    <div class="auth-container">
        <div class="auth-wrapper">
            <!-- Left Side - Branding -->
            <div class="auth-left">
                <div class="auth-features">
                    <div class="auth-logo">
                        <img src="{{ asset('images/auth-logo.svg') }}" alt="Aiolia Event" class="auth-logo-image">
                        <p>Votre plateforme de billetterie en ligne</p>
                    </div>
                    
                   <ul class="feature-list">
                        <li>
                            <i class="fas fa-chart-line"></i>
                            <span>Tableau de bord analytics</span>
                        </li>
                        <li>
                            <i class="fas fa-calendar-alt"></i>
                            <span>Gestion des événements</span>
                        </li>
                        <li>
                            <i class="fas fa-users"></i>
                            <span>Administration utilisateurs</span>
                        </li>
                        <li>
                            <i class="fas fa-file-invoice"></i>
                            <span>Rapports financiers</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Side - Login Form -->
            <div class="auth-right">
                <div class="auth-content">
                    <div class="auth-form-container">
                        <h2>Connexion</h2>
                        <p class="auth-subtitle">Content de vous revoir !</p>

                        <!-- Flash Messages (uniquement erreurs à la connexion) -->
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">{{ message }}</div>
                        {% endfor %}

                        {# <!-- Boutons sociaux bien visibles -->
                        <div class="social-login">
                            <button class="social-btn google" type="button">
                                <i class="fab fa-google social-icon"></i>
                                Google
                            </button>
                            <button class="social-btn facebook" type="button">
                                <i class="fab fa-facebook-f social-icon"></i>
                                Facebook
                            </button>
                        </div>

                        <div class="auth-divider">
                            <span>Ou avec votre email</span>
                        </div> #}

                        <!-- Login Form -->
                        <form method="post" class="auth-form" autocomplete="off">
                            {% if error %}
                                <div class="alert alert-danger subscription-error">
                                    <div class="error-header">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        <strong>Accès refusé</strong>
                                    </div>
                                    <div class="error-message">
                                        {{ error.messageKey|trans(error.messageData, 'security') }}
                                    </div>
                                    {% if 'ne pouvez pas vous connecter' in error.messageKey|trans(error.messageData, 'security')|lower or 'facture' in error.messageKey|trans(error.messageData, 'security')|lower or 'suspendu' in error.messageKey|trans(error.messageData, 'security')|lower %}
                                        <div class="error-info">
                                            <p><strong>Règle d'abonnement :</strong></p>
                                            <ul>
                                                <li>Si vous ne payez pas la facture d'un mois, vous ne pouvez pas vous connecter <strong>pour ce mois précis</strong></li>
                                                <li>Vous pouvez faire une pause dans votre activité et vous reconnecter plus tard</li>
                                                <li>Pour vous reconnecter un mois donné, vous devez avoir payé la facture de <strong>ce mois-là</strong></li>
                                                <li>Vous pouvez régler votre abonnement dans les <strong>5 derniers jours du mois précédent</strong> ou dans les <strong>5 premiers jours du mois courant</strong></li>
                                                <li><strong>Exemple :</strong> Si votre dernière connexion était en septembre (payé) et que vous n'avez pas payé octobre/novembre, vous ne pouvez pas vous connecter en octobre ni en novembre. Mais si vous payez en décembre, vous pouvez vous reconnecter en décembre même si octobre/novembre ne sont pas payés.</li>
                                            </ul>
                                            <p class="contact-info">
                                                <i class="fas fa-envelope"></i>
                                                Pour toute question, contactez l'administration.
                                            </p>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            <div style="position:absolute; opacity:0; height:0; width:0; pointer-events:none;">
                                <input type="text" name="identifier" id="hiddenIdentifier" autocomplete="username" tabindex="-1">
                                <input type="password" name="password" id="hiddenPassword" autocomplete="new-password" tabindex="-1">
                            </div>

                            <div class="form-group">
                                <label for="identifierField">Email ou Prénom Nom <span>*</span></label>
                                <input type="text" name="identifier_visible" id="identifierField"
                                       class="form-control" required autocomplete="off" autofocus
                                       placeholder="ex: admin@aiolia.mg ou Jean Dupont">
                                <small class="form-text text-muted">
                                    Saisissez votre email ou votre prénom suivi de votre nom.
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="inputPassword">Mot de passe <span>*</span></label>
                                <div class="password-input">
                                    <input type="password" name="password_visible" id="inputPassword" 
                                           class="form-control" autocomplete="off" required 
                                           placeholder="Votre mot de passe">
                                    <button type="button" class="toggle-password" id="togglePassword">
                                        <i class="far fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-check">
                                <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input" checked>
                                <label for="remember_me" class="form-check-label">
                                    Se souvenir de moi
                                </label>
                            </div>

                            <button type="submit" class="auth-btn">
                                <i class="fas fa-sign-in-alt"></i> Se connecter
                            </button>
                        </form>

                        <div class="auth-links">
                            <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ? </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Toggle password visibility
        document.addEventListener('DOMContentLoaded', function() {
            const identifierField = document.querySelector('#identifierField');
            const passwordField = document.querySelector('#inputPassword');
            const hiddenIdentifier = document.querySelector('#hiddenIdentifier');
            const hiddenPassword = document.querySelector('#hiddenPassword');
            const loginForm = document.querySelector('.auth-form');

            const clearFields = () => {
                if (identifierField) {
                    identifierField.value = '';
                }
                if (passwordField) {
                    passwordField.value = '';
                }
            };

            clearFields();
            setTimeout(clearFields, 150);
            setTimeout(clearFields, 400);
            window.addEventListener('pageshow', clearFields);

            if (loginForm) {
                loginForm.addEventListener('submit', function() {
                    if (identifierField && hiddenIdentifier) {
                        hiddenIdentifier.value = identifierField.value;
                    }
                    if (passwordField && hiddenPassword) {
                        hiddenPassword.value = passwordField.value;
                    }
                });
            }

            const togglePassword = document.querySelector('#togglePassword');
            const password = document.querySelector('#inputPassword');
            const icon = togglePassword.querySelector('i');

            togglePassword.addEventListener('click', function() {
                const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                password.setAttribute('type', type);
                
                // Toggle icon
                if (type === 'password') {
                    icon.className = 'far fa-eye';
                } else {
                    icon.className = 'far fa-eye-slash';
                }
            });
        });
    </script>
</body>
</html>