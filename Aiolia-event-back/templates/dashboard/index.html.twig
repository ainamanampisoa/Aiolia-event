{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête du dashboard -->
    <div class="dashboard-header">
        <div>
            <h1>Tableau de bord</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Bienvenue, <strong>{{ app.user.firstName }} {{ app.user.lastName }}</strong> 👋
            </p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" onclick="window.location.href='{{ path('app_event_new') }}'">
                <i class="fas fa-plus"></i>
                Nouvel événement
            </button>
        </div>
    </div>

    <!-- Cartes de statistiques principales -->
    <div class="stats-grid stats-grid-compact">
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.events.created_count ?? '24' }}</h3>
                <p>Événements créés</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact">
                <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.tickets.sold_count ?? '1,248' }}</h3>
                <p>Billets vendus</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact">
                <i class="fas fa-euro-sign"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.revenue.total ?? '45,890' }} €</h3>
                <p>Revenus totaux</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.events.collaborated_count ?? '8' }}</h3>
                <p>Collaborations actives</p>
            </div>
        </div>
    </div>

    <!-- Actions rapides -->
    <div class="quick-actions-section">
        <h2 style="font-size: 1.1rem; color: var(--primary); margin-bottom: 16px; font-weight: 600;">
            <i class="fas fa-bolt" style="color: var(--success); margin-right: 6px; font-size: 1rem;"></i>
            Actions rapides
        </h2>
        <div class="quick-actions-grid quick-actions-grid-compact">
            <a href="{{ path('app_event_new') }}" class="quick-action-card">
                <div class="action-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                    <i class="fas fa-plus-circle"></i>
                </div>
                <h4>Créer un événement</h4>
                <p>Nouvel événement avec billets</p>
            </a>

            <a href="{{ path('app_event_index') }}" class="quick-action-card">
                <div class="action-icon" style="background: linear-gradient(135deg, rgba(39, 174, 96, 0.1), rgba(39, 174, 96, 0.05)); color: var(--success);">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <h4>Mes événements</h4>
                <p>Gérer tous vos événements</p>
            </a>

            <a href="{{ path('app_reports_rapports') }}" class="quick-action-card">
                <div class="action-icon" style="background: linear-gradient(135deg, rgba(243, 156, 18, 0.1), rgba(243, 156, 18, 0.05)); color: var(--warning);">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <h4>Rapports</h4>
                <p>Rapports fiscaux</p>
            </a>

            <a href="#" class="quick-action-card">
                <div class="action-icon" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.1), rgba(155, 89, 182, 0.05)); color: #9B59B6;">
                    <i class="fas fa-tags"></i>
                </div>
                <h4>Promotions</h4>
                <p>Codes promo et réductions</p>
            </a>
        </div>
    </div>

    <!-- Graphique des ventes -->
    <div class="chart-card" style="margin-top: 24px;">
        <div class="card-header" style="padding: 18px 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="font-size: 1.1rem;">Ventes des 30 derniers jours</h3>
                    <p style="color: var(--gray-600); font-size: 0.8rem; margin-top: 2px;">
                        Évolution des ventes de billets
                    </p>
                </div>
                <div style="display: flex; gap: 8px;">
                    <button class="filter-btn active" style="padding: 8px 16px; border: 2px solid var(--accent); background: var(--accent); color: white; border-radius: 8px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">7 jours</button>
                    <button class="filter-btn" style="padding: 8px 16px; border: 2px solid var(--gray-300); background: white; color: var(--gray-700); border-radius: 8px; cursor: pointer; font-size: 0.85rem;">30 jours</button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="chart-placeholder">
                <i class="fas fa-chart-line"></i>
                <p>Graphique des ventes (Chart.js)</p>
            </div>
        </div>
    </div>
</div>

<style>
/* Stats ultra-compactes */
.stats-grid-compact {
    gap: 12px;
    margin-bottom: 24px;
}

.stat-card-compact {
    padding: 14px 16px;
}

.stat-icon-compact {
    width: 36px;
    height: 36px;
    font-size: 1.1rem;
    margin-bottom: 10px;
}

.stat-card-compact .stat-content h3 {
    font-size: 1.5rem;
    margin-bottom: 4px;
    line-height: 1.2;
}

.stat-card-compact .stat-content p {
    font-size: 0.8rem;
}

/* Actions rapides ultra-compactes */
.quick-actions-section {
    margin-top: 24px;
}

.quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.quick-actions-grid-compact {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
}

.quick-action-card {
    background: var(--white);
    border-radius: var(--border-radius-md);
    padding: 24px;
    text-align: center;
    cursor: pointer;
    transition: var(--transition-base);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    border: 1px solid var(--gray-200);
}

.quick-actions-grid-compact .quick-action-card {
    padding: 14px 12px;
}

.quick-action-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-light);
}

.quick-action-card .action-icon {
    width: 64px;
    height: 64px;
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 16px;
}

.quick-actions-grid-compact .quick-action-card .action-icon {
    width: 42px;
    height: 42px;
    font-size: 1.4rem;
    margin-bottom: 10px;
}

.quick-action-card h4 {
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--primary);
    margin-bottom: 8px;
}

.quick-actions-grid-compact .quick-action-card h4 {
    font-size: 0.85rem;
    margin-bottom: 4px;
    line-height: 1.3;
}

.quick-action-card p {
    font-size: 0.9rem;
    color: var(--gray-600);
}

.quick-actions-grid-compact .quick-action-card p {
    font-size: 0.75rem;
    line-height: 1.4;
}
</style>
{% endblock %}
