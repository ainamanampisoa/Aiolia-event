<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const dateFromInput = document.getElementById('date-from');
    const dateToInput = document.getElementById('date-to');
    
    let dateFromPicker = null;
    let dateToPicker = null;

    // Configuration pour la date de début
    if (dateFromInput) {
        dateFromPicker = flatpickr(dateFromInput, {
            dateFormat: 'Y-m-d',
            locale: 'fr',
            altInput: false,
            allowInput: false,
            clickOpens: true,
            animate: true,
            monthSelectorType: 'static',
            onChange: function(selectedDates, dateStr, instance) {
                // Si une date de fin est sélectionnée et que la date de début est après, réinitialiser la date de fin
                if (dateToPicker) {
                    const dateTo = dateToPicker.selectedDates[0];
                    if (dateTo && selectedDates[0] && selectedDates[0] > dateTo) {
                        dateToPicker.clear();
                    }
                    // Mettre à jour la date minimale pour la date de fin
                    dateToPicker.set('minDate', selectedDates[0] || null);
                }
            },
            onReady: function(selectedDates, dateStr, instance) {
                // Ajouter un style personnalisé au calendrier
                instance.calendarContainer.classList.add('custom-flatpickr');
            }
        });
    }

    // Configuration pour la date de fin
    if (dateToInput) {
        const minDate = dateFromPicker && dateFromPicker.selectedDates[0] 
            ? dateFromPicker.selectedDates[0] 
            : null;

        dateToPicker = flatpickr(dateToInput, {
            dateFormat: 'Y-m-d',
            locale: 'fr',
            altInput: false,
            allowInput: false,
            clickOpens: true,
            animate: true,
            monthSelectorType: 'static',
            minDate: minDate,
            onChange: function(selectedDates, dateStr, instance) {
                // Si une date de début est sélectionnée et que la date de fin est avant, réinitialiser la date de début
                if (dateFromPicker) {
                    const dateFrom = dateFromPicker.selectedDates[0];
                    if (dateFrom && selectedDates[0] && selectedDates[0] < dateFrom) {
                        dateFromPicker.clear();
                    }
                    // Mettre à jour la date maximale pour la date de début
                    dateFromPicker.set('maxDate', selectedDates[0] || null);
                }
            },
            onReady: function(selectedDates, dateStr, instance) {
                // Ajouter un style personnalisé au calendrier
                instance.calendarContainer.classList.add('custom-flatpickr');
            }
        });
    }
});

// Réinitialiser les date pickers lors du clic sur le bouton réinitialiser
document.addEventListener('DOMContentLoaded', function() {
    const resetBtn = document.querySelector('.btn-reset');
    if (resetBtn) {
        resetBtn.addEventListener('click', function(e) {
            // Ne pas empêcher la navigation, juste réinitialiser les dates
            setTimeout(function() {
                const dateFromInput = document.getElementById('date-from');
                const dateToInput = document.getElementById('date-to');
                
                if (dateFromInput && dateFromInput._flatpickr) {
                    dateFromInput._flatpickr.clear();
                }
                if (dateToInput && dateToInput._flatpickr) {
                    dateToInput._flatpickr.clear();
                }
            }, 100);
        });
    }
});
</script>
