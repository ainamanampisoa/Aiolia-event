<script>
(function registerAdminBillingTranslations() {
    function tryRegister() {
        if (!window.languageManager) {
            return false;
        }

        window.languageManager.extendTranslations({
            fr: {
                'billing.filters.month': 'Mois',
                'billing.filters.month.all': 'Tous les mois',
                'billing.filters.month.january': 'Janvier',
                'billing.filters.month.february': 'Février',
                'billing.filters.month.march': 'Mars',
                'billing.filters.month.april': 'Avril',
                'billing.filters.month.may': 'Mai',
                'billing.filters.month.june': 'Juin',
                'billing.filters.month.july': 'Juillet',
                'billing.filters.month.august': 'Août',
                'billing.filters.month.september': 'Septembre',
                'billing.filters.month.october': 'Octobre',
                'billing.filters.month.november': 'Novembre',
                'billing.filters.month.december': 'Décembre',
                'billing.filters.year': 'Année',
                'billing.filters.year.all': 'Toutes les années'
            },
            en: {
                'billing.filters.month': 'Month',
                'billing.filters.month.all': 'All months',
                'billing.filters.month.january': 'January',
                'billing.filters.month.february': 'February',
                'billing.filters.month.march': 'March',
                'billing.filters.month.april': 'April',
                'billing.filters.month.may': 'May',
                'billing.filters.month.june': 'June',
                'billing.filters.month.july': 'July',
                'billing.filters.month.august': 'August',
                'billing.filters.month.september': 'September',
                'billing.filters.month.october': 'October',
                'billing.filters.month.november': 'November',
                'billing.filters.month.december': 'December',
                'billing.filters.year': 'Year',
                'billing.filters.year.all': 'All years'
            }
        });
        return true;
    }

    // Essayer immédiatement
    if (!tryRegister()) {
        // Si languageManager n'est pas encore chargé, réessayer après un court délai
        let attempts = 0;
        const maxAttempts = 20;
        const interval = setInterval(function() {
            attempts++;
            if (tryRegister() || attempts >= maxAttempts) {
                clearInterval(interval);
            }
        }, 50);
    }
})();

// Traduire les options des select après le chargement
function translateSelectOptions() {
    if (!window.languageManager) return;
    
    const monthSelect = document.getElementById('month');
    if (monthSelect) {
        Array.from(monthSelect.options).forEach(option => {
            const i18nKey = option.getAttribute('data-i18n');
            if (i18nKey) {
                const translation = window.languageManager.translate(i18nKey);
                if (translation) {
                    option.textContent = translation;
                }
            }
        });
    }
    
    const yearSelect = document.getElementById('year');
    if (yearSelect) {
        Array.from(yearSelect.options).forEach(option => {
            const i18nKey = option.getAttribute('data-i18n');
            if (i18nKey) {
                const translation = window.languageManager.translate(i18nKey);
                if (translation) {
                    option.textContent = translation;
                }
            }
        });
    }
}

// Appliquer les traductions au chargement et lors du changement de langue
function applyAllTranslations() {
    // Attendre un peu pour s'assurer que les traductions sont enregistrées
    setTimeout(function() {
        translateSelectOptions();
    }, 100);
}

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', function() {
        setTimeout(applyAllTranslations, 200);
    });
} else {
    applyAllTranslations();
}

document.addEventListener('aiolia:language-changed', function() {
    setTimeout(translateSelectOptions, 50);
});
</script>
