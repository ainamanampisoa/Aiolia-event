{% extends 'base.html.twig' %}

{% block title %}Rapports - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-file-alt"></i> Rapports</h1>
            <p class="dashboard-subtitle">
                Rapports fiscaux et exports de données
            </p>
        </div>
    </div>

    <!-- Cartes de statistiques rapides -->
    <div class="stats-grid stats-grid-compact">
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-primary">
                <i class="fas fa-user-tie"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.counts.organizers ?? 0 }}</h3>
                <p>Organisateurs</p>
            </div>
        </div>
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-success">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.counts.paid_invoices ?? 0 }}</h3>
                <p>Factures payées</p>
            </div>
        </div>
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-warning">
                <i class="fas fa-sync-alt"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.counts.active_subscriptions ?? 0 }}</h3>
                <p>Abonnements actifs</p>
            </div>
        </div>
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-info">
                <i class="fas fa-money-bill-wave"></i>
            </div>
            <div class="stat-content">
                <h3>{{ (stats.organizers.subscription_revenue_total ?? 0)|number_format(0, ',', ' ') }}</h3>
                <p>Revenus totaux (MGA)</p>
            </div>
        </div>
    </div>

    <!-- Recherche (séparée) -->
    <div class="search-section">
        <div class="search-header">
            <h3 style="font-size: 1.1rem; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-filter"></i>
                <span data-i18n="reports.filters.title">Filtres de recherche</span>
            </h3>
            
        </div>

        <div class="search-form" id="searchFormReports" aria-hidden="false">
            <form method="get" action="{{ path('app_reports_rapports') }}">
                <div class="search-grid">
                    <div class="search-field">
                        <label data-i18n="reports.filters.month">Mois</label>
                        <select name="month" class="form-input">
                            <option value="">Tous les mois</option>
                            {% set selectedMonth = (month ?? currentMonth ?? '')|trim %}
                            {% if selectedMonth %}
                                {% set monthNum = selectedMonth|number_format(0, '', '') %}
                            {% else %}
                                {% set monthNum = '' %}
                            {% endif %}
                            <option value="1" {% if monthNum == 1 or monthNum == '1' %}selected{% endif %}>Janvier</option>
                            <option value="2" {% if monthNum == 2 or monthNum == '2' %}selected{% endif %}>Février</option>
                            <option value="3" {% if monthNum == 3 or monthNum == '3' %}selected{% endif %}>Mars</option>
                            <option value="4" {% if monthNum == 4 or monthNum == '4' %}selected{% endif %}>Avril</option>
                            <option value="5" {% if monthNum == 5 or monthNum == '5' %}selected{% endif %}>Mai</option>
                            <option value="6" {% if monthNum == 6 or monthNum == '6' %}selected{% endif %}>Juin</option>
                            <option value="7" {% if monthNum == 7 or monthNum == '7' %}selected{% endif %}>Juillet</option>
                            <option value="8" {% if monthNum == 8 or monthNum == '8' %}selected{% endif %}>Août</option>
                            <option value="9" {% if monthNum == 9 or monthNum == '9' %}selected{% endif %}>Septembre</option>
                            <option value="10" {% if monthNum == 10 or monthNum == '10' %}selected{% endif %}>Octobre</option>
                            <option value="11" {% if monthNum == 11 or monthNum == '11' %}selected{% endif %}>Novembre</option>
                            <option value="12" {% if monthNum == 12 or monthNum == '12' %}selected{% endif %}>Décembre</option>
                        </select>
                    </div>
                    <div class="search-field">
                        <label data-i18n="reports.filters.year">Année</label>
                        <select name="year" class="form-input">
                            <option value="">Toutes les années</option>
                            {% set currentYear = "now"|date("Y") %}
                            {% set selectedYear = (year ?? '')|trim %}
                            {% for i in 0..5 %}
                                {% set y = currentYear - i %}
                                {% set yStr = y ~ '' %}
                                <option value="{{ y }}" {% if selectedYear == yStr %}selected{% endif %}>{{ y }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="search-field">
                        <label for="date-from" data-i18n="reports.filters.date_from">Date de début</label>
                        <input 
                            type="date" 
                            id="date-from"
                            name="date_from" 
                            class="form-input" 
                            value="{{ dateFrom ?? '' }}"
                        >
                    </div>
                    <div class="search-field">
                        <label for="date-to" data-i18n="reports.filters.date_to">Date de fin</label>
                        <input 
                            type="date" 
                            id="date-to"
                            name="date_to" 
                            class="form-input" 
                            value="{{ dateTo ?? '' }}"
                        >
                    </div>
                    <div class="search-field">
                        <label data-i18n="reports.filters.plan">Plan (optionnel)</label>
                        <select name="plan" class="form-input">
                            <option value="">Tous les plans</option>
                            {% set planValue = plan ?? '' %}
                            <option value="Basic" {% if planValue == 'Basic' %}selected{% endif %}>Basic</option>
                            <option value="Pro" {% if planValue == 'Pro' %}selected{% endif %}>Pro</option>
                            <option value="Entreprise" {% if planValue == 'Entreprise' %}selected{% endif %}>Entreprise</option>
                        </select>
                    </div>
                    <div class="search-field">
                        <label data-i18n="reports.filters.organizer">Organisateur (optionnel)</label>
                        <select name="organizer" class="form-input">
                            <option value="">Tous les organisateurs</option>
                            {% set organizerValue = currentOrganizer ?? '' %}
                            {% for organizer in organizers ?? [] %}
                                {% set organizerIdStr = organizer.id ~ '' %}
                                <option value="{{ organizer.id }}" {% if organizerValue and (organizerValue == organizer.id or organizerValue == organizerIdStr) %}selected{% endif %}>
                                    {{ organizer.prenom }} {{ organizer.nom }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="search-actions">
                    <button type="submit" class="btn btn-primary" style="background: #3498DB !important; color: var(--text-inverse); border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 500;">
                        <i class="fas fa-search"></i>
                        <span data-i18n="reports.actions.search">Rechercher</span>
                    </button>
                    <a href="{{ path('app_reports_rapports') }}" class="btn btn-secondary" style="background: var(--bg-secondary); color: var(--text-secondary); border: 2px solid var(--border-color); padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 500;">
                        <i class="fas fa-redo"></i>
                        <span data-i18n="reports.actions.reset">Réinitialiser</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Carte principale -->
    <div class="card validation-card">
        <div class="card-body">

            <!-- Section 1: Résumé des abonnements -->
            <div class="chart-card" style="margin-bottom: 24px;">
                <div class="card-header">
                    <h3 style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-clipboard-list" style="color: var(--accent);"></i>
                        Résumé des abonnements
                    </h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
                        Vue d'ensemble des abonnements et revenus
                    </p>
                </div>
        <div class="card-body">
            <div class="report-section-content">
                <div class="summary-grid">
                    <div class="summary-item">
                        <div class="summary-label" data-i18n="reports.subscription_summary.total_organizers">Total organisateurs</div>
                        <div class="summary-value">{{ stats.counts.organizers ?? 0 }}</div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-label" data-i18n="reports.subscription_summary.active_subscriptions">Abonnements actifs</div>
                        <div class="summary-value">{{ stats.counts.active_subscriptions ?? 0 }}</div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-label" data-i18n="reports.subscription_summary.paid_invoices">Factures payées</div>
                        <div class="summary-value">{{ stats.counts.paid_invoices ?? 0 }}</div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-label" data-i18n="reports.subscription_summary.total_revenue">Revenus totaux</div>
                        <div class="summary-value">{{ (stats.organizers.subscription_revenue_total ?? 0)|number_format(0, ',', ' ') }} MGA</div>
                    </div>
                </div>
                <div class="summary-table">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th data-i18n="reports.subscription_summary.table.plan">Plan</th>
                                <th data-i18n="reports.subscription_summary.table.revenue">Revenus</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if stats.organizers.plans.labels is defined and stats.organizers.plans.labels|length > 0 %}
                                {% for i in 0..(stats.organizers.plans.labels|length - 1) %}
                                    <tr>
                                        <td>{{ stats.organizers.plans.labels[i] }}</td>
                                        <td>{{ stats.organizers.plans.revenue_values[i]|number_format(0, ',', ' ') }} MGA</td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="2" class="text-center">Aucune donnée disponible</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

            <!-- Section 2: Performance financière -->
            <div class="chart-card" style="margin-bottom: 24px;">
                <div class="card-header">
                    <h3 style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-chart-line" style="color: var(--success);"></i>
                        Performance financière
                    </h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
                        Analyse détaillée des revenus, taxes et commissions
                    </p>
                </div>
        <div class="card-body">
            <div class="report-section-content">
                <div class="stats-details">
                    <div class="stat-row">
                        <div class="stat-label">
                            <i class="fas fa-money-bill-wave" style="color: var(--success); margin-right: 8px;"></i>
                            <span data-i18n="reports.financial_performance.gross_revenue">Revenus bruts</span>
                        </div>
                        <div class="stat-value-lg">{{ stats.tax.gross_revenue|number_format(0, ',', ' ') }} MGA</div>
                    </div>
                    <div class="stat-row">
                        <div class="stat-label">
                            <i class="fas fa-percentage" style="color: var(--warning); margin-right: 8px;"></i>
                            <span data-i18n="reports.financial_performance.vat">TVA ({{ (stats.tax.vat_rate * 100)|number_format(0) }}%)</span>
                        </div>
                        <div class="stat-value-lg">{{ stats.tax.vat|number_format(0, ',', ' ') }} MGA</div>
                    </div>
                    <div class="stat-row">
                        <div class="stat-label">
                            <i class="fas fa-hand-holding-usd" style="color: var(--info); margin-right: 8px;"></i>
                            <span data-i18n="reports.financial_performance.platform_commission">Commissions plateforme ({{ (stats.tax.commission_rate * 100)|number_format(0) }}%)</span>
                        </div>
                        <div class="stat-value-lg">{{ stats.tax.platform_commission|number_format(0, ',', ' ') }} MGA</div>
                    </div>
                    <div class="stat-row stat-row-total">
                        <div class="stat-label">
                            <i class="fas fa-wallet" style="color: var(--primary); margin-right: 8px;"></i>
                            <strong data-i18n="reports.financial_performance.net_revenue">Revenus nets</strong>
                        </div>
                        <div class="stat-value-lg"><strong>{{ stats.tax.net_revenue|number_format(0, ',', ' ') }} MGA</strong></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

            <!-- Section 3: Revenus consolidés -->
            <div class="chart-card" style="margin-bottom: 24px;">
                <div class="card-header">
                    <h3 style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-money-bill-wave" style="color: var(--info);"></i>
                        Revenus consolidés
                    </h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
                        Revenus HT, TVA et TTC par mois
                    </p>
                </div>
        <div class="card-body">
            <div class="report-section-content">
                <div class="summary-table">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th data-i18n="reports.consolidated_revenue.table.month">Mois</th>
                                <th data-i18n="reports.consolidated_revenue.table.ht">HT</th>
                                <th data-i18n="reports.consolidated_revenue.table.vat">TVA</th>
                                <th data-i18n="reports.consolidated_revenue.table.ttc">TTC</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if stats.fiscal.by_month.labels is defined and stats.fiscal.by_month.labels|length > 0 %}
                                {% for i in 0..(stats.fiscal.by_month.labels|length - 1) %}
                                    <tr>
                                        <td>{{ stats.fiscal.by_month.labels[i] }}</td>
                                        <td>{{ stats.fiscal.by_month.ht_values[i]|number_format(0, ',', ' ') }} MGA</td>
                                        <td>{{ stats.fiscal.by_month.tva_values[i]|number_format(0, ',', ' ') }} MGA</td>
                                        <td>{{ stats.fiscal.by_month.ttc_values[i]|number_format(0, ',', ' ') }} MGA</td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center">Aucune donnée disponible</td>
                                </tr>
                            {% endif %}
                        </tbody>
                        <tfoot>
                            <tr class="table-total">
                                <td><strong>Total</strong></td>
                                <td><strong>{{ stats.fiscal.totals.ht_total|number_format(0, ',', ' ') }} MGA</strong></td>
                                <td><strong>{{ stats.fiscal.totals.tva_total|number_format(0, ',', ' ') }} MGA</strong></td>
                                <td><strong>{{ stats.fiscal.totals.ttc_total|number_format(0, ',', ' ') }} MGA</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

            <!-- Section 4: Analyse des impayés / retards -->
            <div class="chart-card" style="margin-bottom: 24px;">
                <div class="card-header">
                    <h3 style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-exclamation-triangle" style="color: var(--warning);"></i>
                        Analyse des impayés / retards
                    </h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
                        Suivi des factures en attente et en retard
                    </p>
                </div>
        <div class="card-body">
            <div class="report-section-content">
                <div class="summary-grid">
                    <div class="summary-item summary-item-warning">
                        <div class="summary-label" data-i18n="reports.unpaid_analysis.overdue_invoices">Factures en retard</div>
                        <div class="summary-value">{{ stats.unpaid.overdue_count ?? 0 }}</div>
                    </div>
                    <div class="summary-item summary-item-danger">
                        <div class="summary-label" data-i18n="reports.unpaid_analysis.overdue_amount">Montant en retard</div>
                        <div class="summary-value">{{ (stats.unpaid.overdue_amount ?? 0)|number_format(0, ',', ' ') }} MGA</div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-label" data-i18n="reports.unpaid_analysis.pending_invoices">Factures en attente</div>
                        <div class="summary-value">{{ stats.unpaid.pending_count ?? 0 }}</div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-label" data-i18n="reports.unpaid_analysis.pending_amount">Montant en attente</div>
                        <div class="summary-value">{{ (stats.unpaid.pending_amount ?? 0)|number_format(0, ',', ' ') }} MGA</div>
                    </div>
                </div>
                <div class="summary-table">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th data-i18n="reports.unpaid_analysis.table.organizer">Organisateur</th>
                                <th data-i18n="reports.unpaid_analysis.table.invoice_number">N° Facture</th>
                                <th data-i18n="reports.unpaid_analysis.table.amount">Montant</th>
                                <th data-i18n="reports.unpaid_analysis.table.due_date">Date d'échéance</th>
                                <th data-i18n="reports.unpaid_analysis.table.days_overdue">Jours de retard</th>
                                <th data-i18n="reports.unpaid_analysis.table.status">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if stats.unpaid.invoices is defined and stats.unpaid.invoices|length > 0 %}
                                {% for invoice in stats.unpaid.invoices %}
                                    <tr>
                                        <td>{{ invoice.organizer_name }}</td>
                                        <td>{{ invoice.invoice_number }}</td>
                                        <td>{{ invoice.amount|number_format(0, ',', ' ') }} MGA</td>
                                        <td>{{ invoice.due_date|date('d/m/Y') }}</td>
                                        <td>{{ invoice.days_overdue ?? '-' }}</td>
                                        <td>
                                            <span class="badge badge-{{ invoice.status == 'overdue' ? 'danger' : 'warning' }}">
                                                {{ invoice.status == 'overdue' ? 'En retard' : 'En attente' }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center">Aucune facture impayée</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

            <!-- Section 5: Méthodes de paiement -->
            <div class="chart-card">
                <div class="card-header">
                    <h3 style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-credit-card" style="color: var(--primary);"></i>
                        Méthodes de paiement
                    </h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
                        Répartition des paiements par méthode
                    </p>
                </div>
        <div class="card-body">
            <div class="report-section-content">
                <div class="summary-table">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th data-i18n="reports.payment_methods.table.method">Méthode de paiement</th>
                                <th data-i18n="reports.payment_methods.table.count">Nombre de paiements</th>
                                <th data-i18n="reports.payment_methods.table.amount">Montant total</th>
                                <th data-i18n="reports.payment_methods.table.percentage">Pourcentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if stats.payment_methods is defined and stats.payment_methods|length > 0 %}
                                {% for method in stats.payment_methods %}
                                    <tr>
                                        <td>
                                            {% if method.method == 'espace' %}
                                                <i class="fas fa-mobile-alt"></i> Espace
                                            {% elseif method.method == 'orange' %}
                                                <i class="fas fa-mobile-alt"></i> Orange Money
                                            {% elseif method.method == 'airtel' %}
                                                <i class="fas fa-mobile-alt"></i> Airtel Money
                                            {% elseif method.method == 'telma' %}
                                                <i class="fas fa-mobile-alt"></i> Telma Money
                                            {% elseif method.method == 'bank_transfer' %}
                                                <i class="fas fa-university"></i> Virement bancaire
                                            {% else %}
                                                {{ method.method }}
                                            {% endif %}
                                        </td>
                                        <td>{{ method.count }}</td>
                                        <td>{{ method.amount|number_format(0, ',', ' ') }} MGA</td>
                                        <td>{{ method.percentage|number_format(2, ',', ' ') }}%</td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center">Aucune donnée disponible</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const updateReportsTitle = (retry = 0) => {
        const manager = window.languageManager;
        if (!manager) {
            if (retry < 20) {
                setTimeout(() => updateReportsTitle(retry + 1), 100);
            }
            return;
        }

        const translated = manager.translate('reports.meta.title') || 'Rapports - Aiolia Event';
        document.title = translated;
    };

    updateReportsTitle();
    document.addEventListener('aiolia:language-changed', () => updateReportsTitle());
});
</script>

<style>
/* Harmonisation mode sombre pour recherche et tableaux */
.dashboard-header h1 {
    display: flex !important;
    align-items: center;
    gap: 12px;
}

.dashboard-header h1 i {
    font-size: 2rem !important;
    color: var(--accent) !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
}

.search-section {
    background: var(--bg-card);
    border-radius: var(--border-radius-lg);
    padding: 20px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-color);
}

.search-header { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
}

.btn-toggle-search { 
    display: flex; 
    align-items: center; 
    gap: 8px; 
    padding: 8px 16px; 
    background: var(--bg-secondary); 
    border: none; 
    border-radius: var(--border-radius-md); 
    cursor: pointer; 
    font-size: 0.9rem; 
    font-weight: var(--font-weight-medium); 
    color: var(--text-secondary); 
    transition: var(--transition-base); 
}

.btn-toggle-search:hover { 
    background: var(--bg-primary); 
}

.btn-toggle-search i { 
    transition: transform 0.3s ease; 
}

.btn-toggle-search.active i { 
    transform: rotate(180deg); 
}

.search-form { 
    margin-top: 20px; 
    padding-top: 20px; 
    border-top: 1px solid var(--border-light);
    transition: all 0.3s ease;
    display: block;
}

.search-grid { 
    display: grid; 
    grid-template-columns: repeat(4, 1fr); 
    gap: 16px; 
    margin-bottom: 20px; 
}

.search-field { 
    display: flex; 
    flex-direction: column; 
}

.search-field label { 
    font-size: 0.85rem; 
    font-weight: var(--font-weight-medium); 
    color: var(--text-primary); 
    margin-bottom: 6px; 
}

@media (max-width: 1200px) { 
    .search-grid { 
        grid-template-columns: repeat(2, 1fr); 
    } 
}

@media (max-width: 768px) { 
    .search-grid { 
        grid-template-columns: 1fr; 
    } 
}

.form-input { 
    padding: 10px 12px; 
    border: 2px solid var(--border-color); 
    border-radius: var(--border-radius-sm); 
    font-size: 0.9rem; 
    font-family: var(--font-family); 
    transition: var(--transition-base); 
    background: var(--bg-secondary); 
    color: var(--text-primary); 
}

.form-input:focus { 
    outline: none; 
    border-color: var(--accent); 
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1); 
}

