function translateInline(key, fallback, params = {}) {
    const manager = window.languageManager;
    if (manager) {
        const translation = manager.translate(key, params);
        if (translation) {
            return translation;
        }
    }
    return fallback;
}

function translateSubscriptionName(rawName) {
    if (!rawName) return 'N/A';
    
    // Normaliser le nom : enlever les accents, convertir en majuscules
    let normalized = rawName.toUpperCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, ''); // Enlever les accents
    
    // Enlever tous les termes additionnels (prépayé, mensuel, trimestriel, annuel, etc.)
    normalized = normalized
        .replace(/\s*PREPAY[ÉE]\s*/gi, '') // PRÉPAYÉ/PREPAID
        .replace(/\s*PREPAYE\s*/gi, '') // PRÉPAYÉ sans accent
        .replace(/\s*MENSUEL\s*/gi, '') // MENSUEL/MONTHLY
        .replace(/\s*MONTHLY\s*/gi, '') // MONTHLY
        .replace(/\s*TRIMESTRIEL\s*/gi, '') // TRIMESTRIEL/QUARTERLY
        .replace(/\s*QUARTERLY\s*/gi, '') // QUARTERLY
        .replace(/\s*ANNUEL\s*/gi, '') // ANNUEL/ANNUAL
        .replace(/\s*ANNUAL\s*/gi, '') // ANNUAL
        .replace(/\s*YEARLY\s*/gi, '') // YEARLY
        .replace(/\s*SEMESTRIEL\s*/gi, '') // SEMESTRIEL
        .replace(/\s*SEMIANNUAL\s*/gi, '') // SEMIANNUAL
        .trim();
    
    // Extraction du nom de base (BASIC, PRO, ou ENTERPRISE)
    let baseName = '';
    if (normalized.includes('BASIC')) {
        baseName = 'BASIC';
    } else if (normalized.includes('PRO')) {
        baseName = 'PRO';
    } else if (normalized.includes('ENTERPRISE')) {
        baseName = 'ENTERPRISE';
    }
    
    // Mapping des noms de base vers les clés de traduction
    let translationKey = null;
    if (baseName === 'BASIC') {
        translationKey = 'stats.widgets.subscription.basic';
    } else if (baseName === 'PRO') {
        translationKey = 'stats.widgets.subscription.pro';
    } else if (baseName === 'ENTERPRISE') {
        translationKey = 'stats.widgets.subscription.enterprise';
    }
    
    if (translationKey) {
        return translateInline(translationKey, baseName);
    }
    
    // Si aucun mapping trouvé, retourner le nom normalisé
    return normalized || 'N/A';
}

function updateSubscriptionNameTranslation() {
    const nameElement = document.querySelector('#mostUsedSubscriptionName span[data-subscription-name]');
    if (!nameElement) return;
    
    const rawName = nameElement.getAttribute('data-subscription-name');
    const translatedName = translateSubscriptionName(rawName);
    nameElement.textContent = translatedName;
    // Afficher le texte une fois traduit
    nameElement.style.opacity = '1';
}

// Appliquer la traduction immédiatement dès que les fonctions sont définies
(function applySubscriptionTranslationImmediately() {
    function tryTranslate() {
        if (window.languageManager && typeof translateInline === 'function' && typeof translateSubscriptionName === 'function') {
            updateSubscriptionNameTranslation();
            return true;
        }
        return false;
    }
    
    // Essayer immédiatement
    if (!tryTranslate()) {
        // Si languageManager n'est pas encore chargé, réessayer après un court délai
        let attempts = 0;
        const maxAttempts = 20;
        const interval = setInterval(function() {
            attempts++;
            if (tryTranslate() || attempts >= maxAttempts) {
                clearInterval(interval);
                // Forcer l'affichage même si la traduction n'a pas fonctionné
                const nameElement = document.querySelector('#mostUsedSubscriptionName span[data-subscription-name]');
                if (nameElement) {
                    nameElement.style.opacity = '1';
                }
            }
        }, 50);
    }
})();


    // Données pour les graphiques
    const activeOrganizersData = {{ statistics.charts.active_organizers_trend|json_encode|raw }};
    const subscriptionDistribution = {{ statistics.charts.subscription_distribution|json_encode|raw }};
    const revenueBreakdown = {{ statistics.charts.revenue_breakdown|json_encode|raw }};
    const isSingleMonthSelected = {{ selectedMonth > 0 ? 'true' : 'false' }};
    
    // Fonction pour convertir les labels de mois en abréviations (Jan, Feb, Mar, etc.)
    function formatMonthLabel(label) {
        const monthMap = {
            'January': 'Jan', 'Janvier': 'Jan',
            'February': 'Feb', 'Février': 'Feb',
            'March': 'Mar', 'Mars': 'Mar',
            'April': 'Apr', 'Avril': 'Apr',
            'May': 'May', 'Mai': 'May',
            'June': 'Jun', 'Juin': 'Jun',
            'July': 'Jul', 'Juillet': 'Jul',
            'August': 'Aug', 'Août': 'Aug',
            'September': 'Sep', 'Septembre': 'Sep',
            'October': 'Oct', 'Octobre': 'Oct',
            'November': 'Nov', 'Novembre': 'Nov',
            'December': 'Dec', 'Décembre': 'Dec'
        };
        
        // Si le label contient un mois, le remplacer
        for (const [full, abbr] of Object.entries(monthMap)) {
            if (label.includes(full)) {
                return label.replace(full, abbr);
            }
        }
        
        return label;
    }
    
    
    // Debug : afficher les données dans la console
    console.log('Organisateurs actifs:', activeOrganizersData);
    console.log('Répartition abonnements:', subscriptionDistribution);
    console.log('Répartition CA:', revenueBreakdown);

    // Graphique 1 : Organisateurs actifs
    const activeOrganizersCtx = document.getElementById('activeOrganizersChart').getContext('2d');
    const activeOrganizersChartType = activeOrganizersData.length === 1 ? 'bar' : 'line';
    new Chart(activeOrganizersCtx, {
        type: activeOrganizersChartType,
        data: {
            labels: activeOrganizersData.map(item => formatMonthLabel(item.month_label)),
            datasets: [{
                label: translateInline('stats.charts.active_organizers', 'Organisateurs actifs'),
                data: activeOrganizersData.map(item => Number(item.count ?? 0)),
                borderColor: '#3b82f6',
                backgroundColor: activeOrganizersChartType === 'bar' ? 'rgba(59, 130, 246, 0.8)' : 'rgba(59, 130, 246, 0.1)',
                borderWidth: 2,
                fill: activeOrganizersChartType === 'line',
                tension: activeOrganizersChartType === 'line' ? 0.4 : 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            }
        }
    });

    // Graphique 2 : Répartition abonnements (Camembert)
    const subscriptionCtx = document.getElementById('subscriptionDistributionChart').getContext('2d');
    new Chart(subscriptionCtx, {
        type: 'pie',
        data: {
            labels: [
                translateInline('stats.charts.labels.basic', 'Basic'),
                translateInline('stats.charts.labels.pro', 'Pro'),
                translateInline('stats.charts.labels.enterprise', 'Enterprise')
            ],
            datasets: [{
                label: translateInline('stats.charts.labels.subscription_count', 'Nombre d\'abonnements'),
                data: [
                    subscriptionDistribution.basic || 0,
                    subscriptionDistribution.pro || 0,
                    subscriptionDistribution.enterprise || 0
                ],
                backgroundColor: [
                    'rgba(59, 130, 246, 0.8)',
                    'rgba(168, 85, 247, 0.8)',
                    'rgba(249, 115, 22, 0.8)'
                ],
                borderColor: [
                    '#3b82f6',
                    '#a855f7',
                    '#f97316'
                ],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: {
                        padding: 15,
                        font: {
                            size: 12,
                            weight: '500'
                        },
                        usePointStyle: true,
                        pointStyle: 'circle'
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const label = context.label || '';
                            const value = context.parsed || 0;
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                            return label + ': ' + value + ' (' + percentage + '%)';
                        }
                    }
                }
            }
        }
    });

    // Graphique 3 : Prévision CA (HT/TTC/TVA)
    const revenueCtx = document.getElementById('revenueForecastChart').getContext('2d');
    const selectedYear = {{ selectedYear }};
    const allMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const allMonthLabels = selectedYear === 0 
        ? allMonths 
        : allMonths.map(month => month + ' ' + selectedYear);
    
    if (isSingleMonthSelected && revenueBreakdown.length > 0) {
        const monthLabel = formatMonthLabel(revenueBreakdown[0].month_label || '');
        const singleData = {
            ht: Number(revenueBreakdown[0].revenue_ht ?? 0),
            tva: Number(revenueBreakdown[0].revenue_tva ?? 0),
            ttc: Number(revenueBreakdown[0].revenue_ttc ?? 0)
        };
        
        new Chart(revenueCtx, {
            type: 'bar',
            data: {
                labels: [
                    translateInline('stats.charts.labels.ca_ht', 'CA HT (Ar)'),
                    translateInline('stats.charts.labels.tva', 'TVA (Ar)'),
                    translateInline('stats.charts.labels.ca_ttc', 'CA TTC (Ar)')
                ],
                datasets: [{
                    label: `Valeurs - ${monthLabel}`,
                    data: [singleData.ht, singleData.tva, singleData.ttc],
                    backgroundColor: ['#3b82f6', '#f97316', '#22c55e'],
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return new Intl.NumberFormat('fr-FR').format(context.parsed.y) + ' Ar';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('fr-FR', {
                                    notation: 'compact',
                                    maximumFractionDigits: 1
                                }).format(value) + ' Ar';
                            }
                        }
                    }
                }
            }
        });
    } else {
        const monthNameToAbbr = {
            'Jan': 'Jan', 'January': 'Jan', 'Janvier': 'Jan',
            'Feb': 'Feb', 'February': 'Feb', 'Février': 'Feb',
            'Mar': 'Mar', 'March': 'Mar', 'Mars': 'Mar',
            'Apr': 'Apr', 'April': 'Apr', 'Avril': 'Apr',
            'May': 'May', 'Mai': 'May',
            'Jun': 'Jun', 'June': 'Jun', 'Juin': 'Jun',
            'Jul': 'Jul', 'July': 'Jul', 'Juillet': 'Jul',
            'Aug': 'Aug', 'August': 'Aug', 'Août': 'Aug',
            'Sep': 'Sep', 'September': 'Sep', 'Septembre': 'Sep',
            'Oct': 'Oct', 'October': 'Oct', 'Octobre': 'Oct',
            'Nov': 'Nov', 'November': 'Nov', 'Novembre': 'Nov',
            'Dec': 'Dec', 'December': 'Dec', 'Décembre': 'Dec'
        };
        
        // Si toutes les années sont sélectionnées, agréger les données par mois toutes années confondues
        const revenueDataMap = {};
        revenueBreakdown.forEach(item => {
            const monthLabelRaw = item.month_label || '';
            const monthParts = monthLabelRaw.trim().split(' ');
            if (monthParts.length >= 1) {
                const monthName = monthParts[0];
                const monthAbbr = monthNameToAbbr[monthName] || monthName.substring(0, 3);
                const monthIndex = allMonths.indexOf(monthAbbr);
                
                if (monthIndex !== -1) {
                    // Si toutes les années sont sélectionnées, additionner les valeurs pour chaque mois
                    if (selectedYear === 0) {
                        if (!revenueDataMap[monthIndex]) {
                            revenueDataMap[monthIndex] = {
                                ht: 0,
                                tva: 0,
                                ttc: 0
                            };
                        }
                        revenueDataMap[monthIndex].ht += Number(item.revenue_ht ?? 0);
                        revenueDataMap[monthIndex].tva += Number(item.revenue_tva ?? 0);
                        revenueDataMap[monthIndex].ttc += Number(item.revenue_ttc ?? 0);
                    } else {
                        // Pour une année spécifique, utiliser la dernière valeur (normalement il n'y en a qu'une)
                        revenueDataMap[monthIndex] = {
                            ht: Number(item.revenue_ht ?? 0),
                            tva: Number(item.revenue_tva ?? 0),
                            ttc: Number(item.revenue_ttc ?? 0)
                        };
                    }
                }
            }
        });
        
        const revenueHTData = allMonths.map((month, index) => revenueDataMap[index]?.ht ?? 0);
        const revenueTVAData = allMonths.map((month, index) => revenueDataMap[index]?.tva ?? 0);
        const revenueTTCData = allMonths.map((month, index) => revenueDataMap[index]?.ttc ?? 0);
        
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: allMonthLabels,
            datasets: [
                {
                    label: translateInline('stats.charts.labels.ca_ht', 'CA HT (Ar)'),
                    data: revenueHTData,
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                },
                {
                    label: translateInline('stats.charts.labels.tva', 'TVA (Ar)'),
                    data: revenueTVAData,
                    borderColor: '#f97316',
                    backgroundColor: 'rgba(249, 115, 22, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                },
                {
                    label: translateInline('stats.charts.labels.ca_ttc', 'CA TTC (Ar)'),
                    data: revenueTTCData,
                    borderColor: '#22c55e',
                    backgroundColor: 'rgba(34, 197, 94, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                }
            ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        filter: function(tooltipItem) {
                            // Afficher seulement le premier dataset pour éviter la duplication
                            return tooltipItem.datasetIndex === 0;
                        },
                        callbacks: {
                            title: function(context) {
                                return context[0].label;
                            },
                            label: function(context) {
                                // Afficher toutes les valeurs du même point (même index)
                                const index = context.dataIndex;
                                const ht = revenueHTData[index] || 0;
                                const tva = revenueTVAData[index] || 0;
                                const ttc = revenueTTCData[index] || 0;
                                
                                return [
                                    translateInline('stats.charts.labels.ca_ht', 'CA HT (Ar)') + ': ' + new Intl.NumberFormat('fr-FR').format(ht) + ' Ar',
                                    translateInline('stats.charts.labels.tva', 'TVA (Ar)') + ': ' + new Intl.NumberFormat('fr-FR').format(tva) + ' Ar',
                                    translateInline('stats.charts.labels.ca_ttc', 'CA TTC (Ar)') + ': ' + new Intl.NumberFormat('fr-FR').format(ttc) + ' Ar'
                                ];
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('fr-FR', {
                                    notation: 'compact',
                                    maximumFractionDigits: 1
                                }).format(value) + ' Ar';
                            }
                        }
                    }
                }
            }
        });
    }
    
    // Traduire les options des select après le chargement
    function translateSelectOptions() {
        if (!window.languageManager) return;
        
        const monthSelect = document.getElementById('month');
        if (monthSelect) {
            Array.from(monthSelect.options).forEach(option => {
                const i18nKey = option.getAttribute('data-i18n');
                if (i18nKey) {
                    option.textContent = window.languageManager.translate(i18nKey);
                }
            });
        }
        
        const yearSelect = document.getElementById('year');
        if (yearSelect) {
            Array.from(yearSelect.options).forEach(option => {
                const i18nKey = option.getAttribute('data-i18n');
                if (i18nKey) {
                    option.textContent = window.languageManager.translate(i18nKey);
                }
            });
        }
    }
    
    // Appliquer les traductions au chargement et lors du changement de langue
    function applyAllTranslations() {
        translateSelectOptions();
        // updateSubscriptionNameTranslation est déjà appelée immédiatement, mais on la rappelle au cas où
        const nameElement = document.querySelector('#mostUsedSubscriptionName span[data-subscription-name]');
        if (nameElement && nameElement.style.opacity === '0') {
            updateSubscriptionNameTranslation();
        }
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyAllTranslations);
    } else {
        applyAllTranslations();
    }
    
    document.addEventListener('aiolia:language-changed', applyAllTranslations);
</script>
{% endblock %}
