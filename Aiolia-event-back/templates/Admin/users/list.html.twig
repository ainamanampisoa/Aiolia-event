{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - Aiolia Event{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-users"></i> <span data-i18n="users.header.title">Gestion des utilisateurs</span></h1>
            <p class="dashboard-subtitle" data-i18n="users.header.subtitle">
                Gérez et administrez les comptes utilisateurs de votre plateforme
            </p>
        </div>
    </div>

    <!-- Cartes de statistiques rapides -->
    <div class="stats-grid stats-grid-compact">
        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-primary">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.total|default(0) }}</h3>
                <p data-i18n="users.stats.total_users">Total utilisateurs</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-warning">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.pending|default(0) }}</h3>
                <p data-i18n="users.stats.pending">En attente</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.activeOrganizers|default(0) }}</h3>
                <p data-i18n="users.stats.active_organizers">Organisateurs actifs</p>
            </div>
        </div>

        <div class="stat-card stat-card-compact">
            <div class="stat-icon stat-icon-compact bg-info">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="stat-content">
                <h3>{{ stats.totalOrganizers|default(0) }}</h3>
                <p data-i18n="users.stats.total_organizers">Total organisateurs</p>
            </div>
        </div>
    </div>

    <!-- Recherche (séparée) -->
    <div class="search-section">
        <div class="search-header">
            <h3 style="font-size: 1.1rem; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-search"></i>
                <span data-i18n="users.filters.title">Recherche multicritère</span>
            </h3>
            
        </div>

        <div class="search-form" id="searchFormUsers" aria-hidden="false">
            <form method="get">
                <div class="search-grid">
                    <div class="search-field">
                        <label data-i18n="users.filters.search.label">Recherche (Nom, Email, Téléphone)</label>
                        <input type="text" name="search" class="form-input" value="{{ search }}" data-i18n-target="placeholder" data-i18n="users.filters.search.placeholder" placeholder="Rechercher par nom, email ou téléphone...">
                    </div>

                    <div class="search-field">
                        <label data-i18n="users.filters.role">Rôle</label>
                        <select name="role" class="form-input">
                            <option value="" data-i18n="users.filters.role.all">Tous les rôles</option>
                            <option value="user" {{ currentRole == 'user' ? 'selected' : '' }} data-i18n="users.filters.role.user">Utilisateur</option>
                            <option value="organizer" {{ currentRole == 'organizer' ? 'selected' : '' }} data-i18n="users.filters.role.organizer">Organisateur</option>
                            <option value="admin" {{ currentRole == 'admin' ? 'selected' : '' }} data-i18n="users.filters.role.admin">Administrateur</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n="users.filters.status">Statut</label>
                        <select name="status" class="form-input">
                            <option value="" data-i18n="users.filters.status.all">Tous les statuts</option>
                            <option value="active" {{ currentStatus == 'active' ? 'selected' : '' }} data-i18n="users.filters.status.active">Actif</option>
                            <option value="pending_validation" {{ currentStatus == 'pending_validation' ? 'selected' : '' }} data-i18n="users.filters.status.pending">En attente</option>
                            <option value="paused" {{ currentStatus == 'paused' ? 'selected' : '' }} data-i18n="users.filters.status.paused">En pause</option>
                            <option value="rejected" {{ currentStatus == 'rejected' ? 'selected' : '' }} data-i18n="users.filters.status.rejected">Rejeté</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n="users.filters.sort_by">Trier par</label>
                        <select name="sort" class="form-input">
                            <option value="created_at" {{ currentSort == 'created_at' ? 'selected' : '' }} data-i18n="users.filters.sort.created_at">Date création</option>
                            <option value="email" {{ currentSort == 'email' ? 'selected' : '' }} data-i18n="users.filters.sort.email">Email</option>
                            <option value="first_name" {{ currentSort == 'first_name' ? 'selected' : '' }} data-i18n="users.filters.sort.first_name">Prénom</option>
                            <option value="last_name" {{ currentSort == 'last_name' ? 'selected' : '' }} data-i18n="users.filters.sort.last_name">Nom</option>
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n="users.filters.order">Ordre</label>
                        <select name="order" class="form-input">
                            <option value="DESC" {{ currentOrder == 'DESC' ? 'selected' : '' }} data-i18n="users.filters.order.desc">Décroissant</option>
                            <option value="ASC" {{ currentOrder == 'ASC' ? 'selected' : '' }} data-i18n="users.filters.order.asc">Croissant</option>
                        </select>
                    </div>
                </div>

                <div class="search-actions">
                    <button type="submit" class="btn btn-primary" style="background: #3498DB !important; color: var(--text-inverse); border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 500;">
                        <i class="fas fa-search"></i>
                        <span data-i18n="users.actions.search">Rechercher</span>
                    </button>
                    <a href="{{ path('admin_users_list') }}" class="btn btn-secondary" style="background: var(--bg-secondary); color: var(--text-secondary); border: 2px solid var(--border-color); padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 500;">
                        <i class="fas fa-redo"></i>
                        <span data-i18n="users.actions.reset">Réinitialiser</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Carte principale -->
    <div class="card validation-card">

        <div class="card-body">
            <!-- Tableau des utilisateurs -->
            <div class="table-responsive">
                <table class="table table-hover users-table validation-table" id="usersTable" data-show-url-base="{{ path('admin_users_show', {id: 0}) }}">
                    <thead>
                        <tr>
                            <th class="col-left" data-i18n="users.table.user">Utilisateur</th>
                            <th class="col-center" data-i18n="users.table.role">Rôle</th>
                            <th class="col-center" data-i18n="users.table.status">Statut</th>
                            <th class="col-center" data-i18n="users.table.activity">Activité</th>
                            <th class="col-center actions-header" data-i18n="users.table.actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if users is empty %}
                        <tr>
                            <td colspan="7" class="text-center" style="padding: 40px;">
                                <p style="color: var(--text-secondary);" data-i18n="users.table.empty">Aucun utilisateur trouvé</p>
                            </td>
                        </tr>
                        {% else %}
                        {% set subscriptionMap = subscriptionStatuses|default({}) %}
                        {% for user in users %}
                        {% set subscriptionStatus = subscriptionMap[user.id]|default(null) %}
                        <tr data-user-id="{{ user.id }}">
                            <td class="col-left">
                                <div class="user-info">
                                    {% set avatarUrl = user.urlPhoto %}
                                    {% if avatarUrl is empty %}
                                        {% set avatarUrl = null %}
                                    {% elseif avatarUrl matches '/^https?:\\/\\//' %}
                                        {% if avatarUrl starts with 'https://cdn.aiolia.test/avatars/' %}
                                            {% set avatarUrl = null %}
                                        {% endif %}
                                    {% else %}
                                        {% set avatarUrl = null %}
                                    {% endif %}
                                    <div class="user-avatar-sm">
                                        {% if avatarUrl %}
                                            <img src="{{ avatarUrl }}" alt="{{ user.nomComplet }}">
                                        {% else %}
                                            {% set initials = '' %}
                                            {% if user.prenom %}
                                            {% set initials = user.prenom|slice(0, 1) %}
                                            {% if user.nom %}
                                                {% set initials = initials ~ user.nom|slice(0, 1) %}
                                            {% elseif user.prenom|length > 1 %}
                                                {% set initials = initials ~ user.prenom|slice(1, 1) %}
                                            {% endif %}
                                            {% elseif user.nomComplet %}
                                                {% set nameParts = user.nomComplet|trim|split(' ')|filter(v => v is not empty) %}
                                                {% if nameParts|length > 0 %}
                                                {% set initials = nameParts|first|slice(0, 1) %}
                                                {% if nameParts|length > 1 %}
                                                    {% set initials = initials ~ nameParts|last|slice(0, 1) %}
                                                {% elseif nameParts|first|length > 1 %}
                                                    {% set initials = initials ~ nameParts|first|slice(1, 1) %}
                                                {% endif %}
                                                {% endif %}
                                            {% endif %}

                                            {% if initials is empty and user.email %}
                                                {% set localPart = user.email|split('@')|first %}
                                                {% if localPart|length >= 2 %}
                                                    {% set initials = localPart|slice(0, 2) %}
                                                {% else %}
                                                    {% set initials = localPart|slice(0, 1) ~ '?' %}
                                                {% endif %}
                                            {% endif %}

                                            {% if initials is empty %}
                                                {% set initials = 'AA' %}
                                            {% endif %}

                                            <div class="user-avatar-initials-sm">
                                                {{ initials|upper }}
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="user-details">
                                        <span class="user-name">{{ user.nomComplet }}</span>
                                        <div class="user-meta">
                                            <span class="user-email">
                                                <i class="fas fa-envelope"></i>{{ user.email }}
                                            </span>
                                            {% if user.telephone %}
                                                <span class="user-phone">
                                                    <i class="fas fa-phone"></i>{{ user.telephone|phone_format(user.codePays) }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="col-center">
                                {% if user.role == 'admin' %}
                                    <span class="badge role-badge role-admin" data-i18n="users.role.admin">Administrateur</span>
                                {% elseif user.role == 'organizer' %}
                                    <span class="badge role-badge role-organizer" data-i18n="users.role.organizer">Organisateur</span>
                                {% else %}
                                    <span class="badge role-badge role-user" data-i18n="users.role.user">Utilisateur</span>
                                {% endif %}
                            </td>
                            <td class="col-center">
                                {% if user.role == 'organizer' and subscriptionStatus == 'paused' %}
                                    <span class="badge status-badge status-paused" data-i18n="users.status.paused">En pause</span>
                                {% elseif user.statutCompte == 'active' or (user.statutCompte is empty and user.estActif) %}
                                    <span class="badge status-badge status-active" data-i18n="users.status.active">Actif</span>
                                {% elseif user.role == 'organizer' and subscriptionStatus == 'pending' %}
                                    <span class="badge status-badge status-pending" data-i18n="users.status.pending">En attente</span>
                                {% elseif user.statutCompte == 'pending_validation' %}
                                    <span class="badge status-badge status-pending" data-i18n="users.status.pending">En attente</span>
                                {% elseif user.statutCompte == 'rejected' %}
                                    <span class="badge status-badge status-rejected" data-i18n="users.status.rejected">Rejeté</span>
                                {% else %}
                                    <span class="badge status-badge status-inactive" data-i18n="users.status.inactive">Inactif</span>
                                {% endif %}
                            </td>
                            <td class="col-center">
                                <div class="date-info">
                                    <span class="date-primary" data-i18n-target="html" data-i18n-fr="Créé le {{ user.creeLe|date('d/m/Y') }}" data-i18n-en="Created on {{ user.creeLe|date('d/m/Y') }}">Créé le {{ user.creeLe|date('d/m/Y') }}</span>
                                </div>
                            </td>
                            <td class="col-center actions-cell">
                                {% set isPendingOrganizer = user.role == 'organizer' and user.statutCompte == 'pending_validation' %}
                                {% if isPendingOrganizer %}
                                    {# Organisateurs en attente de validation : Approuver/Rejeter #}
                                    <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                        <i class="fas fa-eye"></i><span data-i18n="users.actions.view">Voir le profil</span>
                                    </a>
                                    <form method="POST" action="{{ path('admin_validation_approve', {id: user.id}) }}" class="d-inline" onsubmit="return confirmApprove(this, event);" data-confirm-fr="Approuver la demande de cet organisateur ?" data-confirm-en="Approve this organizer's request?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_user_' ~ user.id) }}">
                                        <button type="submit" class="validation-action-pill pill-approve">
                                            <i class="fas fa-check-circle"></i><span data-i18n="validation.table.button.approve">Approuver</span>
                                        </button>
                                    </form>
                                    <form method="POST" action="{{ path('admin_validation_reject', {id: user.id}) }}" class="d-inline" onsubmit="return confirmReject(this, event);" data-confirm-fr="Rejeter la demande de cet organisateur ?" data-confirm-en="Reject this organizer's request?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject_user_' ~ user.id) }}">
                                        <button type="submit" class="validation-action-pill pill-reject">
                                            <i class="fas fa-times-circle"></i><span data-i18n="validation.table.button.reject">Rejeter</span>
                                        </button>
                                    </form>
                                {% else %}
                                    {% set isActive = user.statutCompte == 'active' or (user.statutCompte is empty and user.estActif) %}
                                    {% if isActive %}
                                        {# 3 boutons selon le rôle pour les comptes actifs #}
                                        {% if user.role == 'organizer' %}
                                            {# Organisateur : Voir profil, Paiements, Événements #}
                                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                                <i class="fas fa-eye"></i><span data-i18n="users.actions.view">Voir le profil</span>
                                            </a>
                                            <a href="{{ path('admin_users_payments', {id: user.id}) }}" class="validation-action-pill pill-payments" title="Voir l'historique des paiements" target="_blank" rel="noopener noreferrer">
                                                <i class="fas fa-credit-card"></i><span data-i18n="users.actions.payments">Paiements</span>
                                            </a>
                                            <a href="{{ path('admin_users_events', {id: user.id}) }}" class="validation-action-pill pill-events" target="_blank" rel="noopener noreferrer">
                                                <i class="fas fa-calendar-alt"></i><span data-i18n="users.actions.events">Événements</span>
                                            </a>
                                        {% elseif user.role == 'admin' %}
                                            {# Admin : Voir profil, Activité, Info #}
                                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                                <i class="fas fa-eye"></i><span data-i18n="users.actions.view">Voir le profil</span>
                                            </a>
                                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-activity" title="Voir l'historique d'activité et les logs d'audit">
                                                <i class="fas fa-history"></i><span data-i18n-fr="Activité" data-i18n-en="Activity">Activité</span>
                                            </a>
                                            <a href="{{ path('admin_users_info', {id: user.id}) }}" class="validation-action-pill pill-info">
                                                <i class="fas fa-info-circle"></i><span data-i18n-fr="Informations" data-i18n-en="Information">Informations</span>
                                            </a>
                                        {% else %}
                                            {# User : Voir profil uniquement #}
                                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                                <i class="fas fa-eye"></i><span data-i18n="users.actions.view">Voir le profil</span>
                                            </a>
                                        {% endif %}
                                    {% else %}
                                        {# Comptes non actifs : seulement Voir profil #}
                                        <a href="{{ path('admin_users_show', {id: user.id}) }}" class="validation-action-pill pill-view">
                                            <i class="fas fa-eye"></i><span data-i18n="users.actions.view">Voir le profil</span>
                                        </a>
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            {% if totalPages > 1 %}
                {% set maxPagesToShow = 5 %}
                {% set startPage = currentPage - 2 %}
                {% if startPage < 1 %}
                    {% set startPage = 1 %}
                {% endif %}
                {% set endPage = startPage + maxPagesToShow - 1 %}
                {% if endPage > totalPages %}
                    {% set endPage = totalPages %}
                {% endif %}
                {% set startPage = endPage - maxPagesToShow + 1 %}
                {% if startPage < 1 %}
                    {% set startPage = 1 %}
                {% endif %}

                <div class="pagination-wrapper">
                    <ul class="pagination pagination-rounded">
                        <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                            {% if currentPage == 1 %}
                                <span class="page-link" aria-disabled="true" data-i18n-fr="Précédent" data-i18n-en="Previous">Précédent</span>
                            {% else %}
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    page: currentPage - 1,
                                    search: search,
                                    role: currentRole,
                                    status: currentStatus,
                                    sort: currentSort,
                                    order: currentOrder
                                }) }}" rel="prev" data-i18n-fr="Précédent" data-i18n-en="Previous">Précédent</a>
                            {% endif %}
                        </li>

                        {% if startPage > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    page: 1,
                                    search: search,
                                    role: currentRole,
                                    status: currentStatus,
                                    sort: currentSort,
                                    order: currentOrder
                                }) }}">1</a>
                            </li>
                            {% if startPage > 2 %}
                                <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                            {% endif %}
                        {% endif %}

                        {% for page in startPage..endPage %}
                            <li class="page-item {{ page == currentPage ? 'active' }}">
                                {% if page == currentPage %}
                                    <span class="page-link" aria-current="page">{{ page }}</span>
                                {% else %}
                                    <a class="page-link" href="{{ path('admin_users_list', {
                                        page: page,
                                        search: search,
                                        role: currentRole,
                                        status: currentStatus,
                                        sort: currentSort,
                                        order: currentOrder
                                    }) }}">{{ page }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}

                        {% if endPage < totalPages %}
                            {% if endPage < totalPages - 1 %}
                                <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                            {% endif %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    page: totalPages,
                                    search: search,
                                    role: currentRole,
                                    status: currentStatus,
                                    sort: currentSort,
                                    order: currentOrder
                                }) }}">{{ totalPages }}</a>
                            </li>
                        {% endif %}

                        <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                            {% if currentPage == totalPages %}
                                <span class="page-link" aria-disabled="true" data-i18n-fr="Suivant" data-i18n-en="Next">Suivant</span>
                            {% else %}
                                <a class="page-link" href="{{ path('admin_users_list', {
                                    page: currentPage + 1,
                                    search: search,
                                    role: currentRole,
                                    status: currentStatus,
                                    sort: currentSort,
                                    order: currentOrder
                                }) }}" rel="next" data-i18n-fr="Suivant" data-i18n-en="Next">Suivant</a>
                            {% endif %}
                        </li>
                    </ul>
                </div>
                <div class="pagination-summary">
                    <small data-i18n-target="html" data-i18n-fr="Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total" data-i18n-en="Page {{ currentPage }} of {{ totalPages }} - Showing {{ users|length }} user(s) of {{ totalUsersFiltered }} total">Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total</small>
                </div>
            {% elseif users|length > 0 %}
                <div class="pagination-wrapper">
                    <div class="pagination-summary">
                        <small data-i18n-target="html" data-i18n-fr="Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total" data-i18n-en="Showing {{ users|length }} user(s) of {{ totalUsersFiltered }} total">Affichage de {{ users|length }} utilisateur(s) sur {{ totalUsersFiltered }} total</small>
                    </div>
                </div>
            {% endif %}
  </div>
</div>
</div>

<!-- Modal de confirmation personnalisée -->
<div id="confirmationModal" class="custom-confirmation-modal" style="display: none;">
    <div class="modal-overlay"></div>
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-icon" id="modalIcon">
                <i class="fas fa-question-circle"></i>
            </div>
            <h3 class="modal-title" id="modalTitle" data-i18n-fr="Confirmation" data-i18n-en="Confirmation">Confirmation</h3>
        </div>
        <div class="modal-body">
            <p class="modal-message" id="modalMessage"></p>
        </div>
        <div class="modal-footer">
            <button type="button" class="modal-btn modal-btn-cancel" id="modalCancelBtn" data-i18n-fr="Annuler" data-i18n-en="Cancel">Annuler</button>
            <button type="button" class="modal-btn modal-btn-confirm" id="modalConfirmBtn">
                <span data-i18n-fr="Confirmer" data-i18n-en="Confirm">Confirmer</span>
            </button>
        </div>
    </div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
(function registerAdminUsersTranslations() {
    if (!window.languageManager) {
        return;
    }

    window.languageManager.extendTranslations({
        fr: {
            'admin.users.export.no_selection': 'Veuillez sélectionner au moins un utilisateur à exporter.',
            'admin.users.export.success': 'Export des utilisateurs : {list}',
            'admin.users.stats.alert': 'Affichage des statistiques utilisateurs'
        },
        en: {
            'admin.users.export.no_selection': 'Please select at least one user to export.',
            'admin.users.export.success': 'Exporting users: {list}',
            'admin.users.stats.alert': 'Displaying user statistics'
        }
    });
})();

function translateInline(key, fallback, params = {}) {
    const manager = window.languageManager;
    if (manager) {
        const translation = manager.translate(key, params);
        if (translation) {
            return translation;
        }
    }
    return fallback;
}

function handleStatusConfirm(form) {
    const manager = window.languageManager;
    const lang = manager ? manager.getLanguage() : 'fr';
    const datasetKey = lang === 'en' ? 'confirmEn' : 'confirmFr';
    const fallback = form.dataset.confirmFr || 'Voulez-vous changer le statut de cet utilisateur ?';
    const message = form.dataset[datasetKey] || fallback;
    return window.confirm(message);
}

// Fonction pour afficher la popup de confirmation personnalisée
function showConfirmationModal(options) {
    return new Promise((resolve) => {
        const modal = document.getElementById('confirmationModal');
        const modalMessage = document.getElementById('modalMessage');
        const modalIcon = document.getElementById('modalIcon');
        const modalTitle = document.getElementById('modalTitle');
        const modalConfirmBtn = document.getElementById('modalConfirmBtn');
        const modalCancelBtn = document.getElementById('modalCancelBtn');
        
        // Définir le message
        modalMessage.textContent = options.message || '';
        
        // Définir le type (approve/reject/default)
        const type = options.type || 'default';
        let iconClass = 'fas fa-question-circle';
        let confirmBtnClass = 'modal-btn-confirm';
        let confirmText = 'Confirmer';
        
        if (type === 'approve') {
            iconClass = 'fas fa-check-circle';
            confirmBtnClass = 'modal-btn-approve';
            confirmText = translateInline('validation.table.button.approve', 'Approuver');
        } else if (type === 'reject') {
            iconClass = 'fas fa-times-circle';
            confirmBtnClass = 'modal-btn-reject';
            confirmText = translateInline('validation.table.button.reject', 'Rejeter');
        }
        
        // Mettre à jour l'icône
        modalIcon.innerHTML = `<i class="${iconClass}"></i>`;
        modalIcon.className = `modal-icon modal-icon-${type}`;
        
        // Mettre à jour le bouton de confirmation
        modalConfirmBtn.className = `modal-btn ${confirmBtnClass}`;
        modalConfirmBtn.innerHTML = `<span>${confirmText}</span>`;
        
        // Traduire le titre et le bouton annuler
        if (window.languageManager) {
            const lang = window.languageManager.getLanguage();
            const titleKey = lang === 'en' ? 'data-i18n-en' : 'data-i18n-fr';
            const titleEl = modalTitle;
            if (titleEl.getAttribute(titleKey)) {
                titleEl.textContent = titleEl.getAttribute(titleKey);
            }
            
            const cancelKey = lang === 'en' ? 'data-i18n-en' : 'data-i18n-fr';
            const cancelEl = modalCancelBtn;
            if (cancelEl.getAttribute(cancelKey)) {
                cancelEl.textContent = cancelEl.getAttribute(cancelKey);
            }
        }
        
        // Afficher la modal
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        
        // Nettoyer les anciens event listeners si nécessaire
        const oldConfirm = modalConfirmBtn._confirmHandler;
        const oldCancel = modalCancelBtn._cancelHandler;
        const oldOverlay = modal._overlayHandler;
        const oldEscape = document._escapeHandler;
        
        if (oldConfirm) modalConfirmBtn.removeEventListener('click', oldConfirm);
        if (oldCancel) modalCancelBtn.removeEventListener('click', oldCancel);
        if (oldOverlay) modal.removeEventListener('click', oldOverlay);
        if (oldEscape) document.removeEventListener('keydown', oldEscape);
        
        // Gérer la confirmation
        const handleConfirm = () => {
            modal.style.display = 'none';
            document.body.style.overflow = '';
            modalConfirmBtn.removeEventListener('click', handleConfirm);
            modalCancelBtn.removeEventListener('click', handleCancel);
            modal.removeEventListener('click', handleOverlayClick);
            document.removeEventListener('keydown', handleEscape);
            modalConfirmBtn._confirmHandler = null;
            modalCancelBtn._cancelHandler = null;
            modal._overlayHandler = null;
            document._escapeHandler = null;
            resolve(true);
        };
        
        // Gérer l'annulation
        const handleCancel = () => {
            modal.style.display = 'none';
            document.body.style.overflow = '';
            modalConfirmBtn.removeEventListener('click', handleConfirm);
            modalCancelBtn.removeEventListener('click', handleCancel);
            modal.removeEventListener('click', handleOverlayClick);
            document.removeEventListener('keydown', handleEscape);
            modalConfirmBtn._confirmHandler = null;
            modalCancelBtn._cancelHandler = null;
            modal._overlayHandler = null;
            document._escapeHandler = null;
            resolve(false);
        };
        
        // Gérer le clic sur l'overlay
        const handleOverlayClick = (e) => {
            if (e.target.classList.contains('modal-overlay')) {
                handleCancel();
            }
        };
        
        // Gérer la touche Escape
        const handleEscape = (e) => {
            if (e.key === 'Escape') {
                handleCancel();
            }
        };
        
        // Stocker les handlers pour nettoyage futur
        modalConfirmBtn._confirmHandler = handleConfirm;
        modalCancelBtn._cancelHandler = handleCancel;
        modal._overlayHandler = handleOverlayClick;
        document._escapeHandler = handleEscape;
        
        // Ajouter les event listeners
        modalConfirmBtn.addEventListener('click', handleConfirm);
        modalCancelBtn.addEventListener('click', handleCancel);
        modal.addEventListener('click', handleOverlayClick);
        document.addEventListener('keydown', handleEscape);
    });
}

function confirmApprove(form, event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }
    
    const manager = window.languageManager;
    const lang = manager ? manager.getLanguage() : 'fr';
    const datasetKey = lang === 'en' ? 'confirmEn' : 'confirmFr';
    const fallback = form.dataset.confirmFr || 'Approuver la demande de cet organisateur ?';
    const message = form.dataset[datasetKey] || fallback;
    
    // Afficher la popup et attendre la réponse
    showConfirmationModal({
        message: message,
        type: 'approve'
    }).then((confirmed) => {
        if (confirmed) {
            form.submit();
        }
    });
    
    return false;
}

function confirmReject(form, event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }
    
    const manager = window.languageManager;
    const lang = manager ? manager.getLanguage() : 'fr';
    const datasetKey = lang === 'en' ? 'confirmEn' : 'confirmFr';
    const fallback = form.dataset.confirmFr || 'Rejeter la demande de cet organisateur ?';
    const message = form.dataset[datasetKey] || fallback;
    
    // Afficher la popup et attendre la réponse
    showConfirmationModal({
        message: message,
        type: 'reject'
    }).then((confirmed) => {
        if (confirmed) {
            form.submit();
        }
    });
    
    return false;
}

// Init simple (sans toggle) : tooltips + sélection multiple
function initUsersPage() {
    // Initialiser les tooltips Bootstrap
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Sélection multiple
    const selectAll = document.getElementById('selectAll');
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.user-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });
    }

}
// Fonction supprimée - Les détails utilisateur sont maintenant accessibles via la page dédiée

function navigateToUserDetails(btn) {
    const tr = btn.closest('tr');
    if (!tr) return;
    const userId = tr.getAttribute('data-user-id');
    const table = document.getElementById('usersTable');
    const base = table ? table.getAttribute('data-show-url-base') : null;
    if (!userId || !base) return;
    // Remplacer le dernier segment numérique (ex: /0) par l'ID réel
    const url = base.replace(/\/(\d+)(?:\/?$)/, '/' + userId);
    window.location.href = url;
}

document.addEventListener('DOMContentLoaded', initUsersPage);
document.addEventListener('turbo:load', initUsersPage);
document.addEventListener('turbo:render', initUsersPage);
document.addEventListener('turbo:frame-load', initUsersPage);
window.addEventListener('pageshow', initUsersPage);

function toggleUserSelection() {
    const checkboxes = document.querySelectorAll('.user-checkbox');
    const selectAll = document.getElementById('selectAll');
    
    checkboxes.forEach(checkbox => {
        checkbox.checked = false;
    });
    if (selectAll) {
        selectAll.checked = false;
    }
    
    const selectColumns = document.querySelectorAll('.select-column');
    selectColumns.forEach(column => {
        column.classList.toggle('visible');
    });
}

function exportUsers() {
    const selectedCheckboxes = document.querySelectorAll('.user-checkbox:checked');
    const selectedUsers = Array.from(selectedCheckboxes).map(checkbox => checkbox.value);
    
    if (selectedUsers.length === 0) {
        alert(translateInline('admin.users.export.no_selection', 'Veuillez sélectionner au moins un utilisateur à exporter.'));
        return;
    }
    
    alert(translateInline('admin.users.export.success', 'Export des utilisateurs : {list}', { list: selectedUsers.join(', ') }));
}

function showUserStats() {
    alert(translateInline('admin.users.stats.alert', 'Affichage des statistiques utilisateurs'));
}

// Les actions sont maintenant gérées directement via les liens et formulaires HTML
</script>

