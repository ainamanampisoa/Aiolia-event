{% extends 'base.html.twig' %}

{% block title %}Historique des paiements - {{ user.nomComplet }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
/* Styles pour les titres avec icônes */
.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.dashboard-header h1 {
    display: flex !important;
    align-items: center;
    gap: 12px;
    margin: 0;
}

.dashboard-header h1 i {
    font-size: 2rem !important;
    color: var(--accent) !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
}

.dashboard-subtitle {
    color: var(--text-secondary);
    margin: 0.5rem 0 0 0;
    font-size: 0.95rem;
}

/* Fil d'Ariane */
.breadcrumb-horizontal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: 1.75rem;
}

.breadcrumb-horizontal a {
    color: var(--accent);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-horizontal a:hover {
    color: var(--accent-light);
    text-decoration: underline;
}

.breadcrumb-horizontal .breadcrumb-active {
    color: var(--text-secondary);
    font-weight: var(--font-weight-semibold);
}

/* Carte d'informations d'abonnement */
.subscription-info-card {
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-xl);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    background: var(--bg-card);
    margin-bottom: 24px;
}

.subscription-info-item {
    padding: 1.5rem;
    border-right: 1px solid var(--border-color);
    transition: var(--transition-base);
    background: var(--bg-card);
}

.subscription-info-item:last-child {
    border-right: none;
}

.subscription-info-item:hover {
    background: var(--bg-secondary);
}

.subscription-info-item .info-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
}

.subscription-info-item .info-icon.icon-success i {
    color: #27AE60;
}

.subscription-info-item .info-icon.icon-primary i {
    color: #3498DB;
}

.subscription-info-item .info-icon.icon-warning i {
    color: #F39C12;
}

.subscription-info-item .info-icon.icon-info i {
    color: #3498DB;
}

.subscription-info-item .info-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: var(--font-weight-medium);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.subscription-info-item .info-value {
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    line-height: 1.2;
}

.subscription-info-item .info-badge {
    display: inline-block;
    margin-top: 0.5rem;
}

/* Carte de validation */
.validation-card {
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    background: var(--bg-card);
}

/* Tableau - style identique à invoices.html.twig */
.validation-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--bg-card);
}

.validation-table thead {
    background: var(--bg-secondary);
    position: sticky;
    top: 0;
    z-index: 10;
}

.validation-table thead th {
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-color);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.5px;
    padding: 14px 20px;
    white-space: nowrap;
    background: linear-gradient(to bottom, var(--bg-secondary), #f8f9fa);
}

.dashboard-header h1 {
    display: flex !important;
    align-items: center;
    gap: 12px;
}

.dashboard-header h1 i {
    font-size: 2rem !important;
    color: var(--accent) !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
}

.validation-table tbody td {
    border-bottom: 1px solid var(--border-light);
    padding: 16px 20px;
    vertical-align: middle;
    background: var(--bg-card);
}

.validation-table tbody tr {
    border-bottom: 1px solid var(--border-light);
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
}

.validation-table tbody tr:last-child {
    border-bottom: none;
}

.validation-table tbody tr:hover {
    background: linear-gradient(to right, rgba(52, 152, 219, 0.03), var(--bg-card));
    border-left-color: var(--accent);
    transform: translateX(2px);
    box-shadow: -2px 0 8px rgba(52, 152, 219, 0.1);
}

/* Amélioration du scroll horizontal */
.table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--border-radius-md);
}

.table-responsive::-webkit-scrollbar {
    height: 8px;
}

.table-responsive::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: 4px;
}

.table-responsive::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 4px;
}

.table-responsive::-webkit-scrollbar-thumb:hover {
    background: var(--text-secondary);
}

/* Alignements colonnes */
.col-left { text-align: left; }
.col-center { text-align: center; }
.col-right { text-align: right; }

.validation-table tbody td strong {
    font-size: 1.1rem;
    color: var(--text-primary);
    font-weight: var(--font-weight-semibold);
}

.status-badge,
.plan-badge {
    font-size: 0.78rem;
    padding: 6px 12px;
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-medium);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    transition: var(--transition-base);
    box-shadow: var(--shadow-xs);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
}

.status-badge:hover,
.plan-badge:hover {
    transform: none;
    box-shadow: var(--shadow-sm);
}

.status-badge.status-paid {
    background: var(--bg-secondary) !important;
    color: var(--success, #27AE60);
    border: 1px solid var(--border-color);
}

.status-badge.status-paid i {
    color: var(--success, #27AE60);
}

.status-badge.status-issued {
    background: var(--bg-secondary) !important;
    color: var(--warning, #F39C12);
    border: 1px solid var(--border-color);
}

.status-badge.status-issued i {
    color: var(--warning, #F39C12);
}

.status-badge.status-overdue {
    background: var(--bg-secondary) !important;
    color: var(--danger, #E74C3C);
    border: 1px solid var(--border-color);
}

.status-badge.status-overdue i {
    color: var(--danger, #E74C3C);
}

.status-badge.status-pending {
    background: var(--bg-secondary) !important;
    color: var(--info, #3498DB);
    border: 1px solid var(--border-color);
}

.status-badge.status-pending i {
    color: var(--info, #3498DB);
}

.status-badge.status-suspended {
    background: var(--bg-secondary) !important;
    color: #F39C12;
    border: 1px solid var(--border-color);
}

.status-badge.status-suspended i {
    color: #F39C12;
}

.plan-badge {
    background: var(--bg-secondary) !important;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
}

.plan-badge.plan-basic {
    color: #3498DB;
}

.plan-badge.plan-pro {
    color: #9B59B6;
}

.plan-badge.plan-enterprise {
    color: #F39C12;
}

.btn-sm,
.btn-sm.btn-primary {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-medium);
    transition: var(--transition-base);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--accent);
}

.btn-sm i,
.btn-sm.btn-primary i {
    color: var(--accent);
}

.btn-sm:hover,
.btn-sm.btn-primary:hover {
    background: var(--bg-primary);
    border-color: var(--accent);
    color: var(--accent);
    transform: none;
    box-shadow: none;
}

.btn-sm:hover i,
.btn-sm.btn-primary:hover i {
    color: var(--accent);
}

/* Responsive */
@media (max-width: 992px) {
    .subscription-info-item {
        border-right: none;
        border-bottom: 1px solid var(--border-color);
    }
    
    .subscription-info-item:last-child {
        border-bottom: none;
    }
    
    .validation-table thead th,
    .validation-table tbody td {
        padding: 14px 16px;
        font-size: 0.9rem;
    }
}

@media (max-width: 768px) {
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 12px;
    }
    
    .validation-table {
        font-size: 0.85rem;
    }
    
    .validation-table thead th {
        padding: 12px 10px;
        font-size: 0.75rem;
    }
    
    .validation-table tbody td {
        padding: 12px 10px;
    }
    
    .subscription-info-item {
        padding: 1.25rem;
    }
    
    .subscription-info-item .info-value {
        font-size: 1.25rem;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- Fil d'Ariane -->
    <div class="breadcrumb-horizontal" style="margin-bottom: 1.75rem;">
        <a href="{{ path('admin_users_list') }}" data-i18n-fr="Gestion des utilisateurs" data-i18n-en="User management">Gestion des utilisateurs</a>
        <span>/</span>
        <a href="{{ path('admin_users_show', {id: user.id}) }}">{{ user.nomComplet }}</a>
        <span>/</span>
        <span class="breadcrumb-active" data-i18n-fr="Historique des paiements" data-i18n-en="Payment history">Historique des paiements</span>
    </div>

    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-receipt"></i> <span data-i18n="users.payments.header.title">Historique des paiements</span> · {{ user.nomComplet }}</h1>
            <p class="dashboard-subtitle" data-i18n="users.payments.header.subtitle">
                Gérez l'historique des paiements de cet organisateur
            </p>
        </div>
    </div>

    {% if subscriptionInfo is defined and subscriptionInfo %}
    <!-- Informations d'abonnement -->
    <div class="subscription-info-card">
        <div class="row g-0">
            <div class="col-md-3">
                <div class="subscription-info-item">
                    <div class="info-icon icon-success">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="info-label" data-i18n="users.payments.prepaid_months">Mois restants prépayés</div>
                    <div class="info-value">{{ prepaidMonths }}</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="subscription-info-item">
                    <div class="info-icon icon-primary">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <div class="info-label" data-i18n="users.payments.next_payment">Prochain paiement prévu</div>
                    <div class="info-value">
                        {% if nextPaymentDate %}
                            {{ nextPaymentDate|date('d/m/Y') }}
                        {% else %}
                            <span style="font-size: 1rem; color: var(--text-secondary);" data-i18n="users.payments.pause.none">Aucun</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="subscription-info-item">
                    <div class="info-icon icon-warning">
                        <i class="fas fa-pause-circle"></i>
                    </div>
                    <div class="info-label" data-i18n="users.payments.current_pause">Pause actuelle</div>
                    <div class="info-value">
                        {% if isPaused %}
                            <span style="color: #F39C12;" data-i18n-fr="Oui{% if pauseMonth %} ({{ pauseMonth }}){% endif %}" data-i18n-en="Yes{% if pauseMonth %} ({{ pauseMonth }}){% endif %}">Oui{% if pauseMonth %} ({{ pauseMonth }}){% endif %}</span>
                        {% else %}
                            <span style="color: #27AE60; font-size: 1rem;" data-i18n="users.payments.pause.no">Non</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="subscription-info-item">
                    <div class="info-icon icon-info">
                        <i class="fas fa-tag"></i>
                    </div>
                    <div class="info-label" data-i18n="users.payments.active_plan">Offre active</div>
                    <div class="info-value">
                        {% set tierLabels = {
                            'basic': {'fr': 'Basic', 'en': 'Basic'},
                            'pro': {'fr': 'Pro', 'en': 'Pro'},
                            'enterprise': {'fr': 'Enterprise', 'en': 'Enterprise'}
                        } %}
                        {% set periodLabels = {
                            'monthly': {'fr': 'Mensuel', 'en': 'Monthly'},
                            'quarterly': {'fr': 'Trimestriel', 'en': 'Quarterly'},
                            'yearly': {'fr': 'Annuel', 'en': 'Yearly'}
                        } %}
                        {% set tierLabel = tierLabels[subscriptionInfo.niveau] ?? {'fr': subscriptionInfo.niveau|upper, 'en': subscriptionInfo.niveau|upper} %}
                        {% set periodLabel = periodLabels[subscriptionInfo.periode_facturation] ?? {'fr': subscriptionInfo.periode_facturation|capitalize, 'en': subscriptionInfo.periode_facturation|capitalize} %}
                        <span class="plan-badge plan-{{ subscriptionInfo.niveau }} info-badge" data-i18n-fr="{{ tierLabel.fr }} {{ periodLabel.fr }}" data-i18n-en="{{ tierLabel.en }} {{ periodLabel.en }}">{{ tierLabel.fr }} {{ periodLabel.fr }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Liste des paiements -->
    <div class="card validation-card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover validation-table">
                    <thead>
                        <tr>
                            <th class="col-left" data-i18n="users.payments.table.billing_month">Mois de facturation</th>
                            <th class="col-right" data-i18n="users.payments.table.amount">Montant</th>
                            <th class="col-center" data-i18n="users.payments.table.plan">Plan</th>
                            <th class="col-center" data-i18n="users.payments.table.status">Statut</th>
                            <th class="col-center" data-i18n="users.payments.table.payment_date">Date de paiement</th>
                            <th class="col-left" data-i18n="users.payments.table.reference">Référence</th>
                            <th class="col-center" data-i18n="users.payments.table.actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if payments is not empty %}
                            {% for payment in payments %}
                                <tr>
                                    <td class="col-left">
                                        {% if payment.mois_facturation %}
                                            {% set monthNames = {
                                                '1': {'fr': 'Janvier', 'en': 'January'},
                                                '2': {'fr': 'Février', 'en': 'February'},
                                                '3': {'fr': 'Mars', 'en': 'March'},
                                                '4': {'fr': 'Avril', 'en': 'April'},
                                                '5': {'fr': 'Mai', 'en': 'May'},
                                                '6': {'fr': 'Juin', 'en': 'June'},
                                                '7': {'fr': 'Juillet', 'en': 'July'},
                                                '8': {'fr': 'Août', 'en': 'August'},
                                                '9': {'fr': 'Septembre', 'en': 'September'},
                                                '10': {'fr': 'Octobre', 'en': 'October'},
                                                '11': {'fr': 'Novembre', 'en': 'November'},
                                                '12': {'fr': 'Décembre', 'en': 'December'}
                                            } %}
                                            {% set billingDate = payment.mois_facturation|date('Y-m-d') %}
                                            {% set month = billingDate|date('n') %}
                                            {% set year = billingDate|date('Y') %}
                                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                                <i class="fas fa-calendar-alt" style="color: var(--accent); font-size: 0.9rem;"></i>
                                                <span data-i18n-fr="{{ monthNames[month].fr }} {{ year }}" data-i18n-en="{{ monthNames[month].en }} {{ year }}">{{ monthNames[month].fr }} {{ year }}</span>
                                            </div>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="col-right">
                                        <strong style="color: var(--text-primary);">{{ payment.montant_total|number_format(0, ',', ' ') }} {{ payment.devise }}</strong>
                                    </td>
                                    <td class="col-center">
                                        {% if payment.niveau %}
                                            {% set tierLabels = {
                                                'basic': {'fr': 'Basic', 'en': 'Basic'},
                                                'pro': {'fr': 'Pro', 'en': 'Pro'},
                                                'enterprise': {'fr': 'Enterprise', 'en': 'Enterprise'}
                                            } %}
                                            {% set tierLabel = tierLabels[payment.niveau] ?? {'fr': payment.niveau|upper, 'en': payment.niveau|upper} %}
                                            <span class="plan-badge plan-{{ payment.niveau }}" data-i18n-fr="{{ tierLabel.fr }}" data-i18n-en="{{ tierLabel.en }}">{{ tierLabel.fr }}</span>
                                        {% else %}
                                            <span class="plan-badge" data-i18n="common.na">N/A</span>
                                        {% endif %}
                                    </td>
                                    <td class="col-center">
                                        {% if payment.statut %}
                                            {% if payment.statut == 'paid' %}
                                                <span class="status-badge status-paid" data-i18n="users.payments.status.paid">
                                                    <i class="fas fa-check-circle"></i> Payé
                                                </span>
                                            {% elseif payment.statut == 'issued' %}
                                                <span class="status-badge status-issued" data-i18n="users.payments.status.issued">
                                                    <i class="fas fa-file-invoice"></i> Émise
                                                </span>
                                            {% elseif payment.statut == 'overdue' %}
                                                <span class="status-badge status-overdue" data-i18n="users.payments.status.overdue">
                                                    <i class="fas fa-exclamation-triangle"></i> En retard
                                                </span>
                                            {% elseif payment.statut == 'pending' %}
                                                <span class="status-badge status-pending" data-i18n="users.payments.status.pending">
                                                    <i class="fas fa-clock"></i> En attente
                                                </span>
                                            {% elseif payment.statut == 'suspendue' %}
                                                <span class="status-badge status-suspended" data-i18n-fr="Suspendue" data-i18n-en="Suspended">
                                                    <i class="fas fa-pause-circle"></i> Suspendue
                                                </span>
                                            {% else %}
                                                <span class="status-badge" style="color: var(--text-secondary);">{{ payment.statut }}</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="status-badge" style="color: var(--text-secondary);" data-i18n-fr="N/A" data-i18n-en="N/A">N/A</span>
                                        {% endif %}
                                    </td>
                                    <td class="col-center">
                                        {% if payment.payee_le %}
                                            <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                                                <i class="fas fa-check-circle" style="color: #27AE60; font-size: 0.85rem;"></i>
                                                <span>{{ payment.payee_le|date('d/m/Y') }}</span>
                                            </div>
                                        {% else %}
                                            <span class="text-muted" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                                                <i class="fas fa-times-circle" style="font-size: 0.85rem;"></i>
                                                <span data-i18n-fr="Non payé" data-i18n-en="Not paid">Non payé</span>
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="col-left">
                                        <code style="background: var(--bg-secondary); padding: 0.25rem 0.5rem; border-radius: var(--border-radius-sm); font-size: 0.85rem; color: var(--text-secondary);">{{ payment.numero_facture ?? '-' }}</code>
                                    </td>
                                    <td class="col-center">
                                        <a href="{{ path('admin_billing_subscription_invoice_show', {id: payment.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i> <span data-i18n-fr="Détails" data-i18n-en="Details">Détails</span>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center" style="padding: 40px;">
                                    <i class="fas fa-receipt" style="font-size: 3rem; color: var(--text-secondary); margin-bottom: 1rem;"></i>
                                    <p style="color: var(--text-secondary);" data-i18n-fr="Aucun paiement enregistré pour cet utilisateur" data-i18n-en="No payment recorded for this user">Aucun paiement enregistré pour cet utilisateur</p>
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

