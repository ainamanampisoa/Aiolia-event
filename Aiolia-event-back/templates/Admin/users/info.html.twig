{% extends 'base.html.twig' %}

{% block title %}Informations supplémentaires - {{ user.nomComplet }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
.dashboard-header h1 {
    display: flex !important;
    align-items: center;
    gap: 12px;
}

.dashboard-header h1 i {
    font-size: 2rem !important;
    color: var(--accent) !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
}

.dashboard-subtitle {
    color: var(--text-secondary);
    margin: 0.5rem 0 0 0;
    font-size: 0.95rem;
}

/* Fil d'Ariane */
.breadcrumb-horizontal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: 1.75rem;
}

.breadcrumb-horizontal a {
    color: var(--accent);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-horizontal a:hover {
    color: var(--accent-light);
    text-decoration: underline;
}

.breadcrumb-horizontal .breadcrumb-active {
    color: var(--text-secondary);
    font-weight: var(--font-weight-semibold);
}

.validation-card {
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    background: var(--bg-card);
}

.user-info-page .info-alert {
    background: rgba(52, 152, 219, 0.1);
    border-left: 4px solid var(--accent);
    padding: 15px;
    border-radius: var(--border-radius-md);
    margin-bottom: 20px;
}

.user-info-page .info-box {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px;
    background: var(--bg-secondary);
    border-radius: var(--border-radius-md);
    margin-bottom: 15px;
}

.user-info-page .info-icon {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
}

.user-info-page .info-content h6 {
    margin: 0 0 5px 0;
    color: var(--text-primary);
    font-weight: 600;
}

.user-info-page .info-content p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
}
</style>
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- Fil d'Ariane -->
    <div class="breadcrumb-horizontal" style="margin-bottom: 1.75rem;">
        <a href="{{ path('admin_users_list') }}" data-i18n-fr="Gestion des utilisateurs" data-i18n-en="User management">Gestion des utilisateurs</a>
        <span>/</span>
        <a href="{{ path('admin_users_show', {id: user.id}) }}">{{ user.nomComplet }}</a>
        <span>/</span>
        <span class="breadcrumb-active" data-i18n-fr="Informations supplémentaires" data-i18n-en="Additional information">Informations supplémentaires</span>
    </div>

    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-info-circle"></i> <span data-i18n="users.info.header.title">Informations supplémentaires</span> · {{ user.nomComplet }}</h1>
            <p class="dashboard-subtitle" data-i18n="users.info.header.subtitle">
                Gérez les informations et les actions liées à cet utilisateur
            </p>
        </div>
    </div>

    <div class="card validation-card">
        <div class="card-body">
                    <div class="alert info-alert">
                        <i class="fas fa-info-circle"></i>
                        <strong data-i18n-fr="Gestion des utilisateurs" data-i18n-en="User management">Gestion des utilisateurs</strong><br>
                        <span data-i18n-fr="Cette page vous permet de gérer les informations et les actions liées à cet utilisateur. Vous pouvez modifier son rôle, suspendre ou activer son compte, et effectuer d'autres actions administratives." data-i18n-en="This page lets you manage the information and actions related to this user. You can change their role, suspend or activate their account, and perform other administrative actions.">
                        Cette page vous permet de gérer les informations et les actions liées à cet utilisateur. 
                        Vous pouvez modifier son rôle, suspendre ou activer son compte, et effectuer d'autres actions administratives.
                        </span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-icon">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <div class="info-content">
                                    <h6 data-i18n-fr="Date d'inscription" data-i18n-en="Registration date">Date d'inscription</h6>
                                    <p class="mb-0" data-i18n-target="html" data-i18n-fr="{{ user.creeLe|date('d F Y à H:i') }}" data-i18n-en="{{ user.creeLe|date('d F Y à H:i') }}">{{ user.creeLe|date('d F Y à H:i') }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <div class="info-icon">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div class="info-content">
                                    <h6 data-i18n-fr="Dernière activité" data-i18n-en="Last activity">Dernière activité</h6>
                                    <p class="mb-0" data-i18n-target="html" data-i18n-fr="{{ user.derniereConnexionLe ? user.derniereConnexionLe|date('d F Y à H:i') : 'Jamais connecté' }}" data-i18n-en="{{ user.derniereConnexionLe ? user.derniereConnexionLe|date('d F Y à H:i') : 'Never logged in' }}">{{ user.derniereConnexionLe ? user.derniereConnexionLe|date('d F Y à H:i') : 'Jamais connecté' }}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modification du rôle -->
                    <div class="mt-4">
                        <h6 class="mb-3">
                            <i class="fas fa-user-cog"></i> <span data-i18n-fr="Modifier le rôle" data-i18n-en="Change role">Modifier le rôle</span>
                        </h6>
                        <form method="POST" action="{{ path('admin_users_change_role', {id: user.id}) }}" 
                              onsubmit="return handleRoleConfirm(this);" data-confirm-fr="Confirmer le changement de rôle ?" data-confirm-en="Confirm role change?">
                            <input type="hidden" name="_token" value="{{ csrf_token('change_role_' ~ user.id) }}">
                            <div class="row">
                                <div class="col-md-8">
                                    <select name="role" class="form-control">
                                        <option value="user" {{ user.role == 'user' ? 'selected' : '' }} data-i18n-fr="Utilisateur" data-i18n-en="User">Utilisateur</option>
                                        <option value="organizer" {{ user.role == 'organizer' ? 'selected' : '' }} data-i18n-fr="Organisateur" data-i18n-en="Organizer">Organisateur</option>
                                        <option value="admin" {{ user.role == 'admin' ? 'selected' : '' }} data-i18n-fr="Administrateur" data-i18n-en="Administrator">Administrateur</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                                        <i class="fas fa-save"></i> <span data-i18n-fr="Modifier" data-i18n-en="Update">Modifier</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Actions supplémentaires -->
                    <div class="mt-4">
                        <h6 class="mb-3">
                            <i class="fas fa-cog"></i> <span data-i18n-fr="Actions supplémentaires" data-i18n-en="Additional actions">Actions supplémentaires</span>
                        </h6>
                        <div class="d-grid gap-2">
                            <a href="{{ path('admin_users_payments', {id: user.id}) }}" class="btn btn-outline-primary">
                                <i class="fas fa-receipt"></i> <span data-i18n-fr="Voir l'historique des paiements" data-i18n-en="View payment history">Voir l'historique des paiements</span>
                            </a>
                            {% if user.role == 'organizer' %}
                            <a href="{{ path('admin_users_events', {id: user.id}) }}" class="btn btn-outline-primary">
                                <i class="fas fa-calendar-alt"></i> <span data-i18n-fr="Voir les événements créés" data-i18n-en="View created events">Voir les événements créés</span>
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function handleRoleConfirm(form) {
    const manager = window.languageManager;
    const lang = manager ? manager.getLanguage() : 'fr';
    const key = lang === 'en' ? 'confirmEn' : 'confirmFr';
    const fallback = form.dataset.confirmFr || 'Confirmer le changement de rôle ?';
    return window.confirm(form.dataset[key] || fallback);
}
</script>
{% endblock %}

