{% extends 'base.html.twig' %}

{% block title %}Détails utilisateur - {{ user.nomComplet }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
.dashboard-header h1 {
    display: flex !important;
    align-items: center;
    gap: 12px;
}

.dashboard-header h1 i {
    font-size: 2rem !important;
    color: var(--accent) !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
}

.dashboard-subtitle {
    color: var(--text-secondary);
    margin: 0.5rem 0 0 0;
    font-size: 0.95rem;
}

/* Fil d'Ariane */
.breadcrumb-horizontal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: 1.75rem;
}

.breadcrumb-horizontal a {
    color: var(--accent);
    text-decoration: none;
    transition: var(--transition-fast);
}

.breadcrumb-horizontal a:hover {
    color: var(--accent-light);
    text-decoration: underline;
}

.breadcrumb-horizontal .breadcrumb-active {
    color: var(--text-secondary);
    font-weight: var(--font-weight-semibold);
}

/* Carte profil utilisateur */
.validation-card {
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    background: var(--bg-card);
}

.user-profile-card {
    border-radius: var(--border-radius-xl);
    box-shadow: var(--shadow-md);
    margin-bottom: 1.5rem;
}

.user-profile-card .card-header {
    background: linear-gradient(135deg, var(--bg-secondary), var(--bg-primary));
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-color);
    padding: 1.5rem 2rem;
}

.user-profile-card .card-header h5 {
    margin: 0;
    font-weight: var(--font-weight-bold);
    font-size: 1.5rem;
    letter-spacing: -0.3px;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
}

.user-profile-card .card-header i {
    color: var(--accent);
    font-size: 1.3rem;
}

.user-profile-card .card-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

/* Section principale avec avatar */
.user-header-section {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border-radius: var(--border-radius-lg);
    margin-bottom: 2rem;
    border: 1px solid var(--border-color);
}

.user-avatar-wrapper {
    flex-shrink: 0;
    position: relative;
}

.user-avatar {
    position: relative;
    width: 64px;
    height: 64px;
}

.user-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg-secondary);
    box-shadow: var(--shadow-sm);
    transition: var(--transition-smooth);
}

.user-avatar-initials {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-weight-bold);
    font-size: 1.5rem;
    border: 3px solid var(--bg-secondary);
    box-shadow: var(--shadow-sm);
    transition: var(--transition-smooth);
}

.user-status {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 16px;
    height: 16px;
    background: var(--success);
    border: 3px solid var(--bg-secondary);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--success-light);
    animation: statusPulse 3s ease-in-out infinite;
}

@keyframes statusPulse {
    0%, 100% {
        box-shadow: 0 0 0 2px var(--success-light);
    }
    50% {
        box-shadow: 0 0 0 4px var(--success-light);
    }
}

.user-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
}

.user-name {
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    font-size: 1.1rem;
    line-height: 1.2;
}

.user-role {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-primary);
    padding: 0.125rem 0.5rem;
    border-radius: var(--border-radius-full);
}

.user-info-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.user-contact-info {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.user-contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
}

.user-contact-item i {
    color: var(--accent);
    font-size: 0.85rem;
    width: 16px;
    text-align: center;
    opacity: 0.8;
}

.user-contact-item span {
    color: var(--text-primary);
    font-weight: var(--font-weight-medium);
}

.phone-formatted {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}

.phone-flag {
    font-size: 1em;
    line-height: 1;
    display: inline-block;
}

.phone-country-code {
    font-weight: 600;
    color: inherit;
}

.phone-number {
    color: inherit;
}

/* Statistiques utilisateur */
.stats-section {
    margin-top: 1rem;
}

.stats-section-title {
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.stats-section-title i {
    color: var(--accent);
    font-size: 1rem;
}

.user-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
}

.stat-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--border-radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    transition: var(--transition-base);
}

.stat-item:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    background: var(--bg-secondary);
}

.stat-icon-wrapper {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--border-radius-md);
    background: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
}

.stat-icon-wrapper i {
    font-size: 1.1rem;
    color: var(--accent);
}

.stat-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
}

.stat-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-weight: var(--font-weight-medium);
    margin: 0;
    line-height: 1.2;
}

.stat-value {
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    line-height: 1.4;
    flex-wrap: wrap;
}

.stat-value i {
    font-size: 0.85rem;
}

.stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.8rem;
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
}

/* Badges */
.badge {
    font-size: 0.8rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--border-radius-full);
    font-weight: var(--font-weight-semibold);
}

.badge.bg-success {
    background: var(--success) !important;
}

.badge.bg-warning {
    background: var(--warning) !important;
}

.badge.bg-danger {
    background: var(--danger) !important;
}

.badge.bg-primary {
    background: var(--accent) !important;
}

.badge.bg-secondary {
    background: var(--secondary) !important;
    color: var(--text-primary);
}

.badge.bg-dark {
    background: var(--primary) !important;
}

/* Icônes de statut */
.text-success {
    color: var(--success) !important;
    font-weight: var(--font-weight-semibold);
}

.text-danger {
    color: var(--danger) !important;
    font-weight: var(--font-weight-semibold);
}

.text-muted {
    color: var(--text-muted) !important;
}

/* Responsive */
@media (max-width: 1200px) {
    .user-profile-card .card-body {
        padding: 1.75rem;
    }
    
    .user-header-section {
        gap: 2rem;
        padding: 1.75rem;
    }
    
    .user-stats {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
}

@media (max-width: 992px) {
    .user-profile-card .card-body {
        padding: 1.5rem;
    }
    
    .user-header-section {
        gap: 1.5rem;
        padding: 1.5rem;
    }
    
    .user-avatar {
        width: 56px;
        height: 56px;
    }
    
    .user-avatar-initials {
        font-size: 1.3rem;
    }
    
    .user-stats {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }
    
    .stat-item {
        padding: 1.25rem;
    }
}

@media (max-width: 768px) {
    .user-profile-card .card-body {
        padding: 1.25rem;
    }
    
    .user-profile-card .card-header {
        padding: 1.25rem 1.5rem;
    }
    
    .user-header-section {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
        padding: 1.5rem;
    }
    
    .user-info-main {
        align-items: center;
        width: 100%;
    }
    
    .user-contact-info {
        flex-direction: column;
        gap: 0.75rem;
        align-items: center;
    }
    
    .user-avatar {
        width: 56px;
        height: 56px;
    }
    
    .user-avatar-initials {
        font-size: 1.3rem;
    }
    
    .user-stats {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .stat-item {
        padding: 1.25rem;
    }
    
    .stat-icon-wrapper {
        width: 44px;
        height: 44px;
    }
    
    .stat-icon-wrapper i {
        font-size: 1rem;
    }
}

@media (max-width: 576px) {
    .user-profile-card .card-body {
        padding: 1rem;
    }
    
    .user-profile-card .card-header {
        padding: 1rem 1.25rem;
    }
    
    .user-profile-card .card-header h5 {
        font-size: 1.25rem;
    }
    
    .user-header-section {
        padding: 1.25rem;
    }
    
    .user-avatar {
        width: 56px;
        height: 56px;
    }
    
    .user-avatar-initials {
        font-size: 1.3rem;
    }
    
    .stat-item {
        padding: 1rem;
        gap: 0.75rem;
    }
    
    .stat-icon-wrapper {
        width: 40px;
        height: 40px;
    }
    
    .stat-icon-wrapper i {
        font-size: 0.95rem;
    }
    
    .stats-section-title {
        font-size: 1rem;
    }
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- Fil d'Ariane -->
    <div class="breadcrumb-horizontal" style="margin-bottom: 1.75rem;">
        <a href="{{ path('admin_users_list') }}" data-i18n-fr="Gestion des utilisateurs" data-i18n-en="User management">Gestion des utilisateurs</a>
        <span>/</span>
        <span class="breadcrumb-active">{{ user.nomComplet }}</span>
    </div>

    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-user-shield"></i> <span data-i18n="users.show.header.title">Profil utilisateur</span> · {{ user.nomComplet }}</h1>
            <p class="dashboard-subtitle" data-i18n="users.show.header.subtitle">
                Consultez et gérez les informations détaillées de cet utilisateur
            </p>
        </div>
    </div>

    <!-- Profil utilisateur -->
    <div class="card validation-card user-profile-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user-shield me-3"></i>
                        {% if user.role == 'admin' %}
                            <span data-i18n-fr="Profil Administrateur" data-i18n-en="Administrator profile">Profil Administrateur</span>
                        {% elseif user.role == 'organizer' %}
                            <span data-i18n-fr="Profil Organisateur" data-i18n-en="Organizer profile">Profil Organisateur</span>
                        {% else %}
                            <span data-i18n-fr="Profil Utilisateur" data-i18n-en="User profile">Profil Utilisateur</span>
                        {% endif %}
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Section principale avec avatar (style header) -->
                    <div class="user-header-section">
                        <div class="user-avatar-wrapper">
                            <div class="user-avatar">
                                {% set avatarUrl = user.urlAvatar %}
                                {% set userInitials = user.urlPhoto %}
                                
                                {% if avatarUrl %}
                                    <img src="{{ avatarUrl }}" alt="Avatar de {{ user.prenom }} {{ user.nom }}">
                                {% else %}
                                    <div class="user-avatar-initials">
                                        {{ userInitials ?: (user.email|first|upper) }}
                                    </div>
                                {% endif %}
                                <div class="user-status"></div>
                            </div>
                        </div>
                        
                        <div class="user-info-main">
                            <div class="user-details">
                                <span class="user-name">{{ user.prenom }} {{ user.nom }}</span>
                                <span class="user-role">{{ user.role|capitalize }}</span>
                            </div>
                            <div class="user-contact-info">
                                <div class="user-contact-item">
                                    <i class="fas fa-envelope"></i>
                                    <span>{{ user.email }}</span>
                                </div>
                                {% if user.telephone %}
                                    <div class="user-contact-item">
                                        <i class="fas fa-phone"></i>
                                        <span>{{ user.telephone|phone_format(user.codePays) }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- Statistiques détaillées -->
                    {% set organizerSubscriptionStatus = (user.role == 'organizer' and subscriptionInfo is not null) ? subscriptionInfo.statut : null %}

                    <div class="stats-section">
                        <h3 class="stats-section-title">
                            <i class="fas fa-chart-line"></i>
                            <span data-i18n-fr="Informations détaillées" data-i18n-en="Detailed information">Informations détaillées</span>
                        </h3>
                        <div class="user-stats">
                            <div class="stat-item">
                                <div class="stat-icon-wrapper">
                                    <i class="fas fa-hashtag"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label" data-i18n-fr="Identifiant" data-i18n-en="Identifier">Identifiant</div>
                                    <div class="stat-value">#{{ user.id }}</div>
                                </div>
                            </div>
                            
                            <div class="stat-item">
                                <div class="stat-icon-wrapper">
                                    <i class="fas fa-user-tag"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label" data-i18n-fr="Niveau d'accès" data-i18n-en="Access level">Niveau d'accès</div>
                                    <div class="stat-value">
                                        {% if user.role == 'admin' %}
                                            <span class="badge bg-danger stat-badge" data-i18n-fr="Administrateur" data-i18n-en="Administrator">Administrateur</span>
                                        {% elseif user.role == 'organizer' %}
                                            <span class="badge bg-primary stat-badge" data-i18n-fr="Organisateur" data-i18n-en="Organizer">Organisateur</span>
                                        {% else %}
                                            <span class="badge bg-secondary stat-badge" data-i18n-fr="Utilisateur" data-i18n-en="User">Utilisateur</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            
                            <div class="stat-item">
                                <div class="stat-icon-wrapper">
                                    <i class="fas fa-circle-check"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label" data-i18n-fr="État du compte" data-i18n-en="Account status">État du compte</div>
                                    <div class="stat-value">
                                        {% if user.role == 'organizer' and organizerSubscriptionStatus == 'paused' %}
                                            <span class="badge bg-warning stat-badge" data-i18n="users.status.paused">En pause</span>
                                        {% elseif user.role == 'organizer' and organizerSubscriptionStatus == 'pending' %}
                                            <span class="badge bg-warning stat-badge" data-i18n="users.status.pending">En attente</span>
                                        {% elseif user.statutCompte == 'active' %}
                                            <span class="badge bg-success stat-badge" data-i18n="users.status.active">Actif</span>
                                        {% elseif user.statutCompte == 'pending_validation' %}
                                            <span class="badge bg-warning stat-badge" data-i18n="users.status.pending">En attente</span>
                                        {% elseif user.statutCompte == 'rejected' %}
                                            <span class="badge bg-danger stat-badge" data-i18n="users.status.rejected">Rejeté</span>
                                        {% else %}
                                            <span class="badge bg-dark stat-badge" data-i18n="users.status.inactive">Inactif</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            
                            <div class="stat-item">
                                <div class="stat-icon-wrapper">
                                    <i class="fas fa-envelope-circle-check"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label" data-i18n-fr="Vérification email" data-i18n-en="Email verification">Vérification email</div>
                                    <div class="stat-value">
                                        {% if user.isEmailVerifie %}
                                            <span class="text-success" data-i18n-fr="<i class='fas fa-check-circle'></i> Confirmé" data-i18n-en="<i class='fas fa-check-circle'></i> Confirmed" data-i18n-target="html"><i class="fas fa-check-circle"></i> Confirmé</span>
                                        {% else %}
                                            <span class="text-danger" data-i18n-fr="<i class='fas fa-times-circle'></i> En attente" data-i18n-en="<i class='fas fa-times-circle'></i> Pending" data-i18n-target="html"><i class="fas fa-times-circle"></i> En attente</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            
                            <div class="stat-item">
                                <div class="stat-icon-wrapper">
                                    <i class="fas fa-calendar-plus"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label" data-i18n-fr="Date d'inscription" data-i18n-en="Registration date">Date d'inscription</div>
                                    <div class="stat-value" data-i18n-target="html" data-i18n-fr="{{ user.creeLe|date('d/m/Y') }}" data-i18n-en="{{ user.creeLe|date('d/m/Y') }}">{{ user.creeLe|date('d/m/Y') }}</div>
                                </div>
                            </div>
                            
                            <div class="stat-item">
                                <div class="stat-icon-wrapper">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label" data-i18n-fr="Dernière activité" data-i18n-en="Last activity">Dernière activité</div>
                                    <div class="stat-value">
                                        {% if user.derniereConnexionLe %}
                                            <span data-i18n-target="html" data-i18n-fr="{{ user.derniereConnexionLe|date('d/m/Y à H:i') }}" data-i18n-en="{{ user.derniereConnexionLe|date('d/m/Y à H:i') }}">{{ user.derniereConnexionLe|date('d/m/Y à H:i') }}</span>
                                        {% else %}
                                            <span class="text-muted" data-i18n-fr="Aucune connexion" data-i18n-en="No connection">Aucune connexion</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            
                            {% if subscriptionInfo is defined and subscriptionInfo %}
                            <div class="stat-item">
                                <div class="stat-icon-wrapper">
                                    <i class="fas fa-tag"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-label" data-i18n-fr="Offre active" data-i18n-en="Active plan">Offre active</div>
                                    <div class="stat-value">
                                        {% set tierLabels = {
                                            'basic': {'fr': 'Basic', 'en': 'Basic'},
                                            'pro': {'fr': 'Pro', 'en': 'Pro'},
                                            'enterprise': {'fr': 'Enterprise', 'en': 'Enterprise'}
                                        } %}
                                        {% set periodLabels = {
                                            'monthly': {'fr': 'Mensuel', 'en': 'Monthly'},
                                            'quarterly': {'fr': 'Trimestriel', 'en': 'Quarterly'},
                                            'yearly': {'fr': 'Annuel', 'en': 'Yearly'}
                                        } %}
                                        {% set tierLabel = tierLabels[subscriptionInfo.niveau] ?? {'fr': subscriptionInfo.niveau|upper, 'en': subscriptionInfo.niveau|upper} %}
                                        {% set periodLabel = periodLabels[subscriptionInfo.periode_facturation] ?? {'fr': subscriptionInfo.periode_facturation|capitalize, 'en': subscriptionInfo.periode_facturation|capitalize} %}
                                        <span class="badge bg-primary stat-badge" data-i18n-fr="{{ tierLabel.fr }} {{ periodLabel.fr }}" data-i18n-en="{{ tierLabel.en }} {{ periodLabel.en }}">{{ tierLabel.fr }} {{ periodLabel.fr }}</span>
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </div>

                </div>
            </div>
</div>
{% endblock %}