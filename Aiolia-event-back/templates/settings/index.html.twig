            <div class="setting-row">
                <div class="setting-info">
                    <div class="setting-icon" style="background: linear-gradient(135deg, #27AE60, #229954); color: white;">
                        <i class="fas fa-euro-sign"></i>
                    </div>
                    <div class="setting-text">
                        <h3 data-i18n="settings.controls.currency.title"></h3>
                        <p data-i18n="settings.controls.currency.description"></p>
                    </div>
                </div>
                <div class="setting-control">
                    <select class="setting-select" id="currencySelect">
                        <option value="eur" data-i18n="settings.controls.currency.option.eur"></option>
