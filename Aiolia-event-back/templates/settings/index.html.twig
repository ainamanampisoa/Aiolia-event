        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    <script>
        // Gestion de la langue
        document.addEventListener('DOMContentLoaded', function() {
            const languageSelect = document.getElementById('languageSelect');
            
            if (languageSelect) {
                const manager = window.languageManager;
                const savedLanguage = manager ? manager.getLanguage() : (localStorage.getItem('aiolia-language') || 'fr');
                languageSelect.value = savedLanguage;

                if (manager) {
                    manager.onLanguageChange(({ current }) => {
                        languageSelect.value = current;
                    });
                }

                languageSelect.addEventListener('change', function() {
                    const newLang = this.value;

                    if (manager) {
                        const appliedLang = manager.setLanguage(newLang);
                        if (this.value !== appliedLang) {
                            this.value = appliedLang;
                        }

                        const label = manager.getTranslation(`settings.controls.language.option.${appliedLang}`) 
                            || manager.getTranslation(`app.language.name.${appliedLang}`)
                            || appliedLang.toUpperCase();

                        if (window.themeManager) {
                            const message = manager.translate('settings.toast.language', { language: label });
                            window.themeManager.showNotification(message);
                        }
                    } else {
                        localStorage.setItem('aiolia-language', newLang);
                        const fallbackLabels = {
                            fr: 'Français',
                            en: 'English'
                        };

                        if (window.themeManager) {
                            window.themeManager.showNotification(`Langue changée : ${fallbackLabels[newLang] || newLang.toUpperCase()} 🌍`);
                        }
                    }
                });
            }

            // Gestion de la devise
            const currencySelect = document.getElementById('currencySelect');
            
            if (currencySelect) {
                // Charger la devise sauvegardée
                const savedCurrency = localStorage.getItem('aiolia-currency') || 'eur';
                currencySelect.value = savedCurrency;
                
                currencySelect.addEventListener('change', function() {
                    localStorage.setItem('aiolia-currency', this.value);
                    const manager = window.languageManager;
                    const currencyKey = `settings.controls.currency.option.${this.value}`;
                    const label = manager ? (manager.getTranslation(currencyKey) || this.options[this.selectedIndex].textContent.trim()) : this.options[this.selectedIndex].textContent.trim();

                    if (window.themeManager) {
                        const message = manager ? manager.translate('settings.toast.currency', { currency: label }) : `Devise changée : ${label} 💱`;
                        window.themeManager.showNotification(message);
                    }
                });
            }
        });
    </script>
{% endblock %}