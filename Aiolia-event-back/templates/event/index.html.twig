{% extends 'base.html.twig' %}

{% block title %}Mes événements - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête de la page -->
    <div class="dashboard-header">
        <div>
            <h1>📅 Mes événements</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Gérez tous vos événements et collaborations
            </p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" onclick="window.location.href='{{ path('app_event_new') }}'">
                <i class="fas fa-plus"></i>
                Nouvel événement
            </button>
        </div>
    </div>

    <!-- Recherche multicritère -->
    <div class="search-section">
        <div class="search-header">
            <h3 style="font-size: 1.1rem; color: var(--primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-search"></i>
                Recherche multicritère
            </h3>
            <button class="btn-toggle-search" id="toggleSearch">
                <i class="fas fa-chevron-down"></i>
                <span>Afficher les filtres</span>
            </button>
        </div>

        <div class="search-form" id="searchForm" style="display: none;">
            <div class="search-grid">
                <div class="search-field">
                    <label>Nom de l'événement</label>
                    <input type="text" placeholder="Rechercher par nom..." class="form-input">
                </div>

                <div class="search-field">
                    <label>Catégorie</label>
                    <select class="form-input">
                        <option value="">Toutes les catégories</option>
                        <option value="concert">Concert</option>
                        <option value="festival">Festival</option>
                        <option value="sport">Sport</option>
                        <option value="theatre">Théâtre</option>
                        <option value="conference">Conférence</option>
                        <option value="autre">Autre</option>
                    </select>
                </div>

                <div class="search-field">
                    <label>Statut</label>
                    <select class="form-input">
                        <option value="">Tous les statuts</option>
                        <option value="en_vente">En vente</option>
                        <option value="complet">Complet</option>
                        <option value="termine">Terminé</option>
                        <option value="annule">Annulé</option>
                    </select>
                </div>

                <div class="search-field">
                    <label>Lieu / Ville</label>
                    <input type="text" placeholder="Ex: Antananarivo" class="form-input">
                </div>

                <div class="search-field-date">
                    <div class="date-group">
                        <div class="search-field">
                            <label>Date de début</label>
                            <input type="date" class="form-input">
                        </div>
                        <div class="search-field">
                            <label>Date de fin</label>
                            <input type="date" class="form-input">
                        </div>
                    </div>
                </div>

                <div class="search-field">
                    <label>Type</label>
                    <select class="form-input">
                        <option value="">Tous les types</option>
                        <option value="mes_evenements">Mes événements</option>
                        <option value="collaborations">Collaborations</option>
                    </select>
                </div>

                <div class="search-field">
                    <label>Tri par</label>
                    <select class="form-input">
                        <option value="date_desc">Date (plus récent)</option>
                        <option value="date_asc">Date (plus ancien)</option>
                        <option value="nom_asc">Nom (A-Z)</option>
                        <option value="nom_desc">Nom (Z-A)</option>
                        <option value="ventes_desc">Ventes (plus élevé)</option>
                        <option value="ventes_asc">Ventes (plus bas)</option>
                    </select>
                </div>
            </div>

            <div class="search-actions">
                <button class="btn btn-primary" style="background: var(--accent); color: white; border: none; padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-search"></i>
                    Rechercher
                </button>
                <button class="btn btn-secondary" style="background: white; color: var(--gray-700); border: 2px solid var(--gray-300); padding: 10px 24px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-redo"></i>
                    Réinitialiser
                </button>
            </div>
        </div>
    </div>

    <!-- Liste des événements -->
    <div class="events-list">
        <!-- Événement 1 -->
        <div class="event-card">
            <div class="event-image">
                <img src="https://via.placeholder.com/300x200/3498db/ffffff?text=Concert+Rock" alt="Concert Rock">
                <div class="event-status status-active">
                    <i class="fas fa-circle"></i> En vente
                </div>
            </div>
            <div class="event-details">
                <div class="event-header">
                    <h3>🎸 Concert Rock Nation 2025</h3>
                    <div class="event-category">Concert</div>
                </div>
                <div class="event-meta-info">
                    <div class="meta-item">
                        <i class="fas fa-calendar"></i>
                        <span>15 Novembre 2025</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Stade Municipal, Antananarivo</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-clock"></i>
                        <span>20:00</span>
                    </div>
                </div>
                <div class="event-stats-row">
                    <div class="stat-item">
                        <div class="stat-label">Billets vendus</div>
                        <div class="stat-value">256 / 300</div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 85%"></div>
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">Revenus</div>
                        <div class="stat-value">12,450 €</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">Collaborateurs</div>
                        <div class="stat-value">3 personnes</div>
                    </div>
                </div>
            </div>
            <div class="event-actions">
                <a href="{{ path('app_event_show', {id: 1}) }}" class="btn-action btn-view" title="Voir les détails">
                    <i class="fas fa-eye"></i>
                </a>
                <a href="{{ path('app_event_edit', {id: 1}) }}" class="btn-action btn-edit" title="Modifier">
                    <i class="fas fa-edit"></i>
                </a>
                <button class="btn-action btn-stats" title="Statistiques">
                    <i class="fas fa-chart-line"></i>
                </button>
                <button class="btn-action btn-share" title="Partager">
                    <i class="fas fa-share-alt"></i>
                </button>
            </div>
        </div>

        <!-- Événement 2 -->
        <div class="event-card">
            <div class="event-image">
                <img src="https://via.placeholder.com/300x200/27ae60/ffffff?text=Festival+Jazz" alt="Festival Jazz">
                <div class="event-status status-active">
                    <i class="fas fa-circle"></i> En vente
                </div>
            </div>
            <div class="event-details">
                <div class="event-header">
                    <h3>🎵 Festival Jazz Mada</h3>
                    <div class="event-category">Festival</div>
                </div>
                <div class="event-meta-info">
                    <div class="meta-item">
                        <i class="fas fa-calendar"></i>
                        <span>22 Novembre 2025</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Centre Culturel, Toamasina</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-clock"></i>
                        <span>19:30</span>
                    </div>
                </div>
                <div class="event-stats-row">
                    <div class="stat-item">
                        <div class="stat-label">Billets vendus</div>
                        <div class="stat-value">189 / 300</div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 63%"></div>
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">Revenus</div>
                        <div class="stat-value">8,920 €</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">Collaborateurs</div>
                        <div class="stat-value">5 personnes</div>
                    </div>
                </div>
            </div>
            <div class="event-actions">
                <a href="{{ path('app_event_show', {id: 2}) }}" class="btn-action btn-view" title="Voir les détails">
                    <i class="fas fa-eye"></i>
                </a>
                <a href="{{ path('app_event_edit', {id: 2}) }}" class="btn-action btn-edit" title="Modifier">
                    <i class="fas fa-edit"></i>
                </a>
                <button class="btn-action btn-stats" title="Statistiques">
                    <i class="fas fa-chart-line"></i>
                </button>
                <button class="btn-action btn-share" title="Partager">
                    <i class="fas fa-share-alt"></i>
                </button>
            </div>
        </div>

        <!-- Événement 3 -->
        <div class="event-card">
            <div class="event-image">
                <img src="https://via.placeholder.com/300x200/e74c3c/ffffff?text=Match+Football" alt="Match Football">
                <div class="event-status status-full">
                    <i class="fas fa-check-circle"></i> Complet
                </div>
            </div>
            <div class="event-details">
                <div class="event-header">
                    <h3>⚽ Match de Football</h3>
                    <div class="event-category">Sport</div>
                </div>
                <div class="event-meta-info">
                    <div class="meta-item">
                        <i class="fas fa-calendar"></i>
                        <span>28 Novembre 2025</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Stade Mahamasina, Antananarivo</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-clock"></i>
                        <span>16:00</span>
                    </div>
                </div>
                <div class="event-stats-row">
                    <div class="stat-item">
                        <div class="stat-label">Billets vendus</div>
                        <div class="stat-value">298 / 298</div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: 100%; background: var(--danger);"></div>
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">Revenus</div>
                        <div class="stat-value">14,900 €</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-label">Collaborateurs</div>
                        <div class="stat-value">2 personnes</div>
                    </div>
                </div>
            </div>
            <div class="event-actions">
                <a href="{{ path('app_event_show', {id: 3}) }}" class="btn-action btn-view" title="Voir les détails">
                    <i class="fas fa-eye"></i>
                </a>
                <a href="{{ path('app_event_edit', {id: 3}) }}" class="btn-action btn-edit" title="Modifier">
                    <i class="fas fa-edit"></i>
                </a>
                <button class="btn-action btn-stats" title="Statistiques">
                    <i class="fas fa-chart-line"></i>
                </button>
                <button class="btn-action btn-share" title="Partager">
                    <i class="fas fa-share-alt"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Toggle de la recherche multicritère
document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('toggleSearch');
    const searchForm = document.getElementById('searchForm');
    
    if (toggleBtn && searchForm) {
        toggleBtn.addEventListener('click', function() {
            const isVisible = searchForm.style.display !== 'none';
            
            if (isVisible) {
                searchForm.style.display = 'none';
                toggleBtn.classList.remove('active');
                toggleBtn.querySelector('span').textContent = 'Afficher les filtres';
            } else {
                searchForm.style.display = 'block';
                toggleBtn.classList.add('active');
                toggleBtn.querySelector('span').textContent = 'Masquer les filtres';
            }
        });
    }

    // Bouton réinitialiser
    const resetBtn = document.querySelector('.search-actions .btn-secondary');
    if (resetBtn) {
        resetBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const inputs = searchForm.querySelectorAll('input, select');
            inputs.forEach(input => {
                if (input.type === 'checkbox' || input.type === 'radio') {
                    input.checked = false;
                } else {
                    input.value = '';
                }
            });
        });
    }
});
</script>

<style>
/* Recherche multicritère */
.search-section {
    background: var(--white);
    border-radius: var(--border-radius-lg);
    padding: 20px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

.search-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.btn-toggle-search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--gray-100);
    border: none;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: var(--font-weight-medium);
    color: var(--gray-700);
    transition: var(--transition-base);
}

.btn-toggle-search:hover {
    background: var(--gray-200);
}

.btn-toggle-search i {
    transition: transform 0.3s ease;
}

.btn-toggle-search.active i {
    transform: rotate(180deg);
}

.search-form {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--gray-200);
}

.search-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 20px;
}

.search-field {
    display: flex;
    flex-direction: column;
}

.search-field-date {
    grid-column: span 2;
}

.date-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.search-field label {
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    margin-bottom: 6px;
}

@media (max-width: 1200px) {
    .search-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .search-field-date {
        grid-column: span 2;
    }
}

@media (max-width: 768px) {
    .search-grid {
        grid-template-columns: 1fr;
    }
    
    .search-field-date {
        grid-column: span 1;
    }
}

.form-input {
    padding: 10px 12px;
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-sm);
    font-size: 0.9rem;
    font-family: var(--font-family);
    transition: var(--transition-base);
    background: var(--white);
}

.form-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.search-actions {
    display: flex;
    gap: 12px;
    padding-top: 10px;
}

.events-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.event-card {
    display: grid;
    grid-template-columns: 300px 1fr auto;
    gap: 24px;
    background: var(--white);
    border-radius: var(--border-radius-lg);
    padding: 20px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
    transition: var(--transition-base);
}

.event-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
}

.event-image {
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
}

.event-image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.event-status {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 8px 14px;
    border-radius: var(--border-radius-sm);
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.status-active {
    background: rgba(39, 174, 96, 0.95);
    color: white;
}

.status-full {
    background: rgba(231, 76, 60, 0.95);
    color: white;
}

.event-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.event-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.event-header h3 {
    font-size: 1.4rem;
    font-weight: var(--font-weight-semibold);
    color: var(--primary);
    margin: 0;
}

.event-category {
    padding: 6px 14px;
    background: rgba(52, 152, 219, 0.1);
    color: var(--accent);
    border-radius: var(--border-radius-sm);
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
}

.event-meta-info {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--gray-600);
    font-size: 0.9rem;
}

.meta-item i {
    color: var(--accent);
}

.event-stats-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--gray-200);
}

.stat-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.stat-label {
    font-size: 0.8rem;
    color: var(--gray-600);
    font-weight: var(--font-weight-medium);
}

.stat-value {
    font-size: 1.1rem;
    font-weight: var(--font-weight-bold);
    color: var(--primary);
}

.progress-bar {
    height: 6px;
    background: var(--gray-200);
    border-radius: 3px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--success), #2ECC71);
    transition: width 0.3s ease;
}

.event-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
}

.btn-action {
    width: 44px;
    height: 44px;
    border: none;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-base);
    font-size: 1.1rem;
}

.btn-view {
    background: rgba(155, 89, 182, 0.1);
    color: #9B59B6;
    text-decoration: none;
}

.btn-view:hover {
    background: #9B59B6;
    color: white;
}

.btn-edit {
    background: rgba(52, 152, 219, 0.1);
    color: var(--accent);
    text-decoration: none;
}

.btn-edit:hover {
    background: var(--accent);
    color: white;
}

.btn-stats {
    background: rgba(39, 174, 96, 0.1);
    color: var(--success);
}

.btn-stats:hover {
    background: var(--success);
    color: white;
}

.btn-share {
    background: rgba(155, 89, 182, 0.1);
    color: #9B59B6;
}

.btn-share:hover {
    background: #9B59B6;
    color: white;
}

.btn-more {
    background: rgba(149, 165, 166, 0.1);
    color: var(--gray-600);
}

.btn-more:hover {
    background: var(--gray-600);
    color: white;
}

@media (max-width: 1200px) {
    .event-card {
        grid-template-columns: 250px 1fr auto;
    }
}

@media (max-width: 992px) {
    .event-card {
        grid-template-columns: 1fr;
    }
    
    .event-actions {
        flex-direction: row;
        justify-content: flex-start;
    }
}
</style>
{% endblock %}

