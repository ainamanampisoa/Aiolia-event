{% extends 'base.html.twig' %}

{% block title %}Créer un événement - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1>✨ Créer un nouvel événement</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Remplissez les informations pour créer votre événement
            </p>
        </div>
        <div class="header-actions">
            <a href="{{ path('app_event_index') }}" class="btn btn-secondary" style="background: white; color: var(--gray-700); border: 2px solid var(--gray-300); padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-arrow-left"></i>
                Retour
            </a>
        </div>
    </div>

    <div class="event-form-container">
        {{ form_start(form, {'attr': {'class': 'event-form', 'enctype': 'multipart/form-data'}}) }}
        
        <!-- Section 1: Informations principales -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div>
                    <h2>01. Informations sur l'événement</h2>
                    <p>Les détails essentiels de votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    {{ form_label(form.title, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Concert de Jazz à Antananarivo'}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.primaryCategory, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.primaryCategory, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.primaryCategory) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.subtitle, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.subtitle, {'attr': {'class': 'form-control', 'placeholder': 'Sous-titre optionnel'}}) }}
                    {{ form_errors(form.subtitle) }}
                </div>

                <div class="form-group span-2">
                    {{ form_label(form.summary, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.summary, {'attr': {'class': 'form-control', 'placeholder': 'Résumé court de l\'événement', 'maxlength': '500'}}) }}
                    {{ form_errors(form.summary) }}
                    <small class="form-help">Maximum 500 caractères</small>
                </div>

                <div class="form-group span-2">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '8', 'placeholder': 'Décrivez votre événement en détails...'}}) }}
                    {{ form_errors(form.description) }}
                </div>
            </div>
        </div>

        <!-- Section 2: Date et lieu -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(39, 174, 96, 0.15), rgba(39, 174, 96, 0.05)); color: var(--success);">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div>
                    <h2>Date et lieu</h2>
                    <p>Quand et où se déroulera votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.startsAt, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.startsAt, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.startsAt) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.endsAt, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.endsAt, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.endsAt) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.timezone, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.timezone, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.timezone) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.capacity, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.capacity, {'attr': {'class': 'form-control', 'placeholder': 'Nombre de places', 'min': '1'}}) }}
                    {{ form_errors(form.capacity) }}
                </div>

                <div class="form-group span-2">
                    {{ form_label(form.venueNameText, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.venueNameText, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Le Grand Café de la Gare'}}) }}
                    {{ form_errors(form.venueNameText) }}
                </div>

                <div class="form-group span-2">
                    {{ form_label(form.fullAddress, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.fullAddress, {'attr': {'class': 'form-control', 'rows': '3', 'placeholder': 'Adresse complète de l\'événement'}}) }}
                    {{ form_errors(form.fullAddress) }}
                </div>
            </div>
        </div>

        <!-- Section 3: Tags -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.15), rgba(155, 89, 182, 0.05)); color: #9B59B6;">
                    <i class="fas fa-tags"></i>
                </div>
                <div>
                    <h2>Tags</h2>
                    <p>Ajoutez des tags pour faciliter la recherche</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    {{ form_label(form.tags, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.tags, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.tags) }}
                    <small class="form-help">Sélectionnez plusieurs tags en maintenant Ctrl (ou Cmd sur Mac)</small>
                </div>
            </div>
        </div>

        <!-- Section 4: Modes de paiement -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(243, 156, 18, 0.15), rgba(243, 156, 18, 0.05)); color: var(--warning);">
                    <i class="fas fa-credit-card"></i>
                </div>
                <div>
                    <h2>Mode de paiement</h2>
                    <p>Sélectionnez les modes de paiement acceptés</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    {{ form_label(form.paymentMethodsData, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.paymentMethodsData, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.paymentMethodsData) }}
                    <small class="form-help">Sélectionnez plusieurs modes de paiement</small>
                </div>
            </div>
        </div>

        <!-- Section 5: Accessibilité -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(39, 174, 96, 0.15), rgba(39, 174, 96, 0.05)); color: var(--success);">
                    <i class="fas fa-universal-access"></i>
                </div>
                <div>
                    <h2>Accessibilité</h2>
                    <p>Indiquez les types d'accessibilité disponibles</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    {{ form_label(form.accessibilitiesData, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.accessibilitiesData, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.accessibilitiesData) }}
                    <small class="form-help">Sélectionnez les types d'accessibilité disponibles pour votre événement</small>
                </div>
            </div>
        </div>

        <!-- Section 6: Langues -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                    <i class="fas fa-language"></i>
                </div>
                <div>
                    <h2>Langues</h2>
                    <p>Langues supportées par l'événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    {{ form_label(form.languagesData, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.languagesData, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.languagesData) }}
                    <small class="form-help">Sélectionnez les langues supportées</small>
                </div>
            </div>
        </div>

        <!-- Section 7: Médias -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                    <i class="fas fa-images"></i>
                </div>
                <div>
                    <h2>02. Médiathèque</h2>
                    <p>Ajoutez des photos pour votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <div class="form-label">Ajouter des photos de l'événement</div>
                    <div class="format-info">Formats conseillés : JPG, PNG et webp. Poids maximum : 3Mo</div>
                    <div class="photos-upload-container">
                        <div class="photo-upload-slot" data-slot="1">
                            <div class="photo-upload-placeholder">
                                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <path d="M21 15l-5-5L5 21"/>
                                </svg>
                                <button type="button" class="photo-add-btn" onclick="triggerPhotoUpload(1)">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <input type="file" name="photo_1" id="photo_1" accept="image/*" class="photo-input" onchange="handlePhotoUpload(1, this)">
                            <div class="photo-preview" id="preview_1"></div>
                        </div>
                        <div class="photo-upload-slot" data-slot="2">
                            <div class="photo-upload-placeholder">
                                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <path d="M21 15l-5-5L5 21"/>
                                </svg>
                                <button type="button" class="photo-add-btn" onclick="triggerPhotoUpload(2)">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <input type="file" name="photo_2" id="photo_2" accept="image/*" class="photo-input" onchange="handlePhotoUpload(2, this)">
                            <div class="photo-preview" id="preview_2"></div>
                        </div>
                        <div class="photo-upload-slot" data-slot="3">
                            <div class="photo-upload-placeholder">
                                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <path d="M21 15l-5-5L5 21"/>
                                </svg>
                                <button type="button" class="photo-add-btn" onclick="triggerPhotoUpload(3)">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <input type="file" name="photo_3" id="photo_3" accept="image/*" class="photo-input" onchange="handlePhotoUpload(3, this)">
                            <div class="photo-preview" id="preview_3"></div>
                        </div>
                    </div>
                    {{ form_widget(form.photos, {'attr': {'style': 'display: none;'}}) }}
                    {{ form_errors(form.photos) }}
                </div>

                <div class="form-group span-2">
                    {{ form_label(form.youtubeUrl, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.youtubeUrl, {'attr': {'class': 'form-control', 'placeholder': 'https://www.youtube.com/watch?v=...'}}) }}
                    {{ form_errors(form.youtubeUrl) }}
                    <small class="form-help">ou URL youtube</small>
                </div>
            </div>
        </div>

        <!-- Section 8: Options -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(231, 76, 60, 0.15), rgba(231, 76, 60, 0.05)); color: var(--danger);">
                    <i class="fas fa-cog"></i>
                </div>
                <div>
                    <h2>Options</h2>
                    <p>Paramètres supplémentaires</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.status, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.status) }}
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        {{ form_widget(form.isFeatured) }}
                        <span>{{ form_label(form.isFeatured) }}</span>
                    </label>
                    {{ form_errors(form.isFeatured) }}
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #3498DB, #5DADE2) !important; color: white; border: none; padding: 14px 32px; border-radius: 10px; font-weight: 600; font-size: 1rem; cursor: pointer; box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);">
                <i class="fas fa-check"></i>
                Créer l'événement
            </button>
            <a href="{{ path('app_event_index') }}" class="btn btn-text" style="color: var(--gray-600); text-decoration: none; padding: 14px 24px;">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<style>
.event-form-container {
    max-width: 1200px;
    margin: 0 auto;
}

.event-form {
    width: 100%;
}

.form-section {
    background: var(--white);
    border-radius: var(--border-radius-xl);
    padding: 28px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

.section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--gray-200);
}

.section-icon {
    width: 50px;
    height: 50px;
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.section-header h2 {
    font-size: 1.3rem;
    font-weight: var(--font-weight-bold);
    color: var(--primary);
    margin: 0;
}

.section-header p {
    font-size: 0.9rem;
    color: var(--gray-600);
    margin: 4px 0 0 0;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.span-2 {
    grid-column: span 2;
}

.form-label {
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    margin-bottom: 8px;
}

.form-control {
    padding: 12px 14px;
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    font-size: 0.95rem;
    font-family: var(--font-family);
    transition: var(--transition-base);
    background: var(--white);
}

.form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.form-help {
    font-size: 0.8rem;
    color: var(--gray-600);
    margin-top: 6px;
}

.checkbox-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-weight: var(--font-weight-medium);
}

.checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

.form-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 24px;
    background: var(--white);
    border-radius: var(--border-radius-xl);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

/* Upload de photos */
.format-info {
    font-size: 0.85rem;
    color: var(--gray-600);
    margin-bottom: 16px;
}

.photos-upload-container {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.photo-upload-slot {
    position: relative;
    width: 180px;
    height: 180px;
    border: 2px dashed var(--gray-300);
    border-radius: 8px;
    background: var(--gray-50);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-base);
}

.photo-upload-slot:hover {
    border-color: var(--accent);
    background: rgba(52, 152, 219, 0.05);
}

.photo-upload-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gray-400);
}

.photo-add-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    box-shadow: 0 2px 8px rgba(52, 152, 219, 0.3);
    transition: var(--transition-base);
}

.photo-add-btn:hover {
    background: var(--accent-light);
    transform: scale(1.1);
}

.photo-input {
    display: none;
}

.photo-preview {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    overflow: hidden;
    display: none;
}

.photo-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.photo-preview.active {
    display: block;
}

.photo-preview .remove-photo {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    background: var(--danger);
    color: white;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}

@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    
    .form-group.span-2 {
        grid-column: span 1;
    }
    
    .form-actions {
        flex-direction: column;
    }
    
    .form-actions button,
    .form-actions a {
        width: 100%;
        text-align: center;
        justify-content: center;
    }
}
</style>

<script>
// Gestion des photos individuelles
function triggerPhotoUpload(slot) {
    document.getElementById('photo_' + slot).click();
}

function handlePhotoUpload(slot, input) {
    const file = input.files[0];
    if (file && file.type.startsWith('image/')) {
        // Vérifier la taille (3Mo max)
        if (file.size > 3 * 1024 * 1024) {
            alert('Le fichier est trop volumineux. Maximum 3Mo.');
            input.value = '';
            return;
        }
        
        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById('preview_' + slot);
            const placeholder = preview.previousElementSibling;
            
            preview.innerHTML = `
                <img src="${e.target.result}" alt="Preview">
                <button type="button" class="remove-photo" onclick="removePhoto(${slot})">
                    <i class="fas fa-times"></i>
                </button>
            `;
            preview.classList.add('active');
            placeholder.style.display = 'none';
            
            // Mettre à jour le champ photos du formulaire Symfony
            updatePhotosField();
        };
        reader.readAsDataURL(file);
    }
}

function removePhoto(slot) {
    const input = document.getElementById('photo_' + slot);
    const preview = document.getElementById('preview_' + slot);
    const placeholder = preview.previousElementSibling;
    
    input.value = '';
    preview.innerHTML = '';
    preview.classList.remove('active');
    placeholder.style.display = 'flex';
    
    // Mettre à jour le champ photos du formulaire Symfony
    updatePhotosField();
}

// Gestion du champ photos Symfony (collecter tous les fichiers)
function updatePhotosField() {
    const symfonyPhotosInput = document.querySelector('input[type="file"][name*="[photos]"]');
    if (!symfonyPhotosInput) {
        // Si le champ n'existe pas, on le crée
        const form = document.querySelector('.event-form');
        if (form) {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'file';
            hiddenInput.name = 'event[photos][]';
            hiddenInput.multiple = true;
            hiddenInput.style.display = 'none';
            form.appendChild(hiddenInput);
        }
        return;
    }
    
    const dt = new DataTransfer();
    [1, 2, 3].forEach(slot => {
        const input = document.getElementById('photo_' + slot);
        if (input && input.files.length > 0) {
            dt.items.add(input.files[0]);
        }
    });
    
    if (dt.files.length > 0) {
        symfonyPhotosInput.files = dt.files;
    }
}

// Mettre à jour lors de la soumission du formulaire
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.event-form');
    if (form) {
        form.addEventListener('submit', function() {
            updatePhotosField();
        });
    }
});
</script>
{% endblock %}

