{% extends 'base.html.twig' %}

{% block title %}Rapports & Statistiques - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête de la page -->
    <div class="dashboard-header">
        <div>
            <h1>📊 Rapports & Statistiques</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Analyses financières et performances détaillées
            </p>
        </div>
        <div class="header-actions">
            <button class="btn" style="background: var(--success); color: white; border: none; padding: 12px 24px; border-radius: var(--border-radius-md); cursor: pointer; font-weight: 600;">
                <i class="fas fa-download"></i>
                Exporter PDF
            </button>
        </div>
    </div>

    <!-- Statistiques fiscales -->
    <div class="chart-card" style="margin-bottom: 32px;">
        <div class="card-header">
            <h3>💰 Statistiques fiscales</h3>
            <p style="color: var(--gray-600); font-size: 0.9rem; margin-top: 4px;">
                Revenus et taxes du mois en cours
            </p>
        </div>
        <div class="card-body">
            <div class="stats-details">
                <div class="stat-row">
                    <div class="stat-label">
                        <i class="fas fa-money-bill-wave" style="color: var(--success); margin-right: 8px;"></i>
                        Revenus bruts
                    </div>
                    <div class="stat-value-lg">45,890 €</div>
                </div>
                <div class="stat-row">
                    <div class="stat-label">
                        <i class="fas fa-percentage" style="color: var(--warning); margin-right: 8px;"></i>
                        TVA (18%)
                    </div>
                    <div class="stat-value-lg">8,260 €</div>
                </div>
                <div class="stat-row">
                    <div class="stat-label">
                        <i class="fas fa-hand-holding-usd" style="color: var(--info); margin-right: 8px;"></i>
                        Commissions plateforme (5%)
                    </div>
                    <div class="stat-value-lg">2,294 €</div>
                </div>
                <div class="stat-row stat-row-total">
                    <div class="stat-label">
                        <i class="fas fa-wallet" style="color: var(--primary); margin-right: 8px;"></i>
                        <strong>Revenus nets</strong>
                    </div>
                    <div class="stat-value-lg"><strong>35,336 €</strong></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertes & Notifications -->
    <div class="chart-card" style="margin-bottom: 32px;">
        <div class="card-header">
            <h3>🔔 Alertes & Notifications</h3>
            <p style="color: var(--gray-600); font-size: 0.9rem; margin-top: 4px;">
                Activités récentes et alertes automatiques
            </p>
        </div>
        <div class="card-body">
            <div class="alerts-list">
                <div class="alert-item alert-warning">
                    <div class="alert-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="alert-content">
                        <h4>Stock bas</h4>
                        <p>Concert Rock Nation - Il reste seulement 15 billets VIP</p>
                        <span class="alert-time">Il y a 2 heures</span>
                    </div>
                    <div class="alert-action">
                        <button class="btn-sm">Voir</button>
                    </div>
                </div>

                <div class="alert-item alert-success">
                    <div class="alert-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="alert-content">
                        <h4>Événement complet !</h4>
                        <p>Match de Football - Tous les billets ont été vendus</p>
                        <span class="alert-time">Il y a 5 heures</span>
                    </div>
                    <div class="alert-action">
                        <button class="btn-sm">Voir</button>
                    </div>
                </div>

                <div class="alert-item alert-info">
                    <div class="alert-icon">
                        <i class="fas fa-calendar"></i>
                    </div>
                    <div class="alert-content">
                        <h4>Rappel événement</h4>
                        <p>Festival Jazz Mada démarre dans 3 jours</p>
                        <span class="alert-time">Il y a 1 jour</span>
                    </div>
                    <div class="alert-action">
                        <button class="btn-sm">Voir</button>
                    </div>
                </div>

                <div class="alert-item alert-default">
                    <div class="alert-icon">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="alert-content">
                        <h4>Nouveau co-organisateur</h4>
                        <p>Jean Dupont a rejoint l'événement "Théâtre Classique"</p>
                        <span class="alert-time">Il y a 2 jours</span>
                    </div>
                    <div class="alert-action">
                        <button class="btn-sm">Voir</button>
                    </div>
                </div>

                <div class="alert-item alert-warning">
                    <div class="alert-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="alert-content">
                        <h4>Promotion expire bientôt</h4>
                        <p>Code promo "EARLYBIRD" expire dans 2 jours</p>
                        <span class="alert-time">Il y a 3 jours</span>
                    </div>
                    <div class="alert-action">
                        <button class="btn-sm">Voir</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Graphique comparatif -->
    <div class="chart-card" style="margin-bottom: 32px;">
        <div class="card-header">
            <h3>📈 Comparatif des événements</h3>
            <p style="color: var(--gray-600); font-size: 0.9rem; margin-top: 4px;">
                Performances de ventes par événement
            </p>
        </div>
        <div class="card-body">
            <div class="chart-placeholder" style="height: 400px;">
                <i class="fas fa-chart-bar"></i>
                <p>Graphique comparatif (Chart.js)</p>
            </div>
        </div>
    </div>

    <!-- Tableau détaillé -->
    <div class="chart-card">
        <div class="card-header">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3>📋 Détails des ventes</h3>
                    <p style="color: var(--gray-600); font-size: 0.9rem; margin-top: 4px;">
                        Tableau récapitulatif des performances
                    </p>
                </div>
                <button class="btn" style="padding: 8px 16px; border: 2px solid var(--accent); background: white; color: var(--accent); border-radius: 8px; cursor: pointer; font-weight: 600;">
                    <i class="fas fa-file-csv"></i> Export CSV
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Événement</th>
                            <th>Date</th>
                            <th>Billets vendus</th>
                            <th>Taux de remplissage</th>
                            <th>Revenus</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="event-cell">
                                    <strong>🎸 Concert Rock Nation</strong>
                                    <span>Concert</span>
                                </div>
                            </td>
                            <td>15 Nov 2025</td>
                            <td>256 / 300</td>
                            <td>
                                <div class="progress-cell">
                                    <div class="progress-bar-sm">
                                        <div class="progress-fill-sm" style="width: 85%"></div>
                                    </div>
                                    <span>85%</span>
                                </div>
                            </td>
                            <td class="revenue-cell">12,450 €</td>
                            <td><span class="badge badge-success">En vente</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="event-cell">
                                    <strong>🎵 Festival Jazz Mada</strong>
                                    <span>Festival</span>
                                </div>
                            </td>
                            <td>22 Nov 2025</td>
                            <td>189 / 300</td>
                            <td>
                                <div class="progress-cell">
                                    <div class="progress-bar-sm">
                                        <div class="progress-fill-sm" style="width: 63%"></div>
                                    </div>
                                    <span>63%</span>
                                </div>
                            </td>
                            <td class="revenue-cell">8,920 €</td>
                            <td><span class="badge badge-success">En vente</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="event-cell">
                                    <strong>⚽ Match de Football</strong>
                                    <span>Sport</span>
                                </div>
                            </td>
                            <td>28 Nov 2025</td>
                            <td>298 / 298</td>
                            <td>
                                <div class="progress-cell">
                                    <div class="progress-bar-sm">
                                        <div class="progress-fill-sm" style="width: 100%; background: var(--danger);"></div>
                                    </div>
                                    <span>100%</span>
                                </div>
                            </td>
                            <td class="revenue-cell">14,900 €</td>
                            <td><span class="badge badge-danger">Complet</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="event-cell">
                                    <strong>🎭 Théâtre Classique</strong>
                                    <span>Théâtre</span>
                                </div>
                            </td>
                            <td>05 Déc 2025</td>
                            <td>134 / 200</td>
                            <td>
                                <div class="progress-cell">
                                    <div class="progress-bar-sm">
                                        <div class="progress-fill-sm" style="width: 67%"></div>
                                    </div>
                                    <span>67%</span>
                                </div>
                            </td>
                            <td class="revenue-cell">6,780 €</td>
                            <td><span class="badge badge-success">En vente</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
.stats-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px;
    background: var(--gray-50);
    border-radius: var(--border-radius-md);
    border-left: 4px solid var(--gray-300);
    transition: var(--transition-base);
}

.stat-row:hover {
    background: var(--gray-100);
}

.stat-row-total {
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(52, 152, 219, 0.05));
    border-left-color: var(--accent);
    margin-top: 12px;
}

.stat-label {
    font-size: 1rem;
    color: var(--gray-700);
    display: flex;
    align-items: center;
    font-weight: var(--font-weight-medium);
}

.stat-value-lg {
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--primary);
}

.alerts-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.alert-item {
    display: flex;
    gap: 16px;
    padding: 18px;
    border-radius: var(--border-radius-md);
    border-left: 4px solid;
    align-items: center;
}

.alert-warning {
    background: rgba(243, 156, 18, 0.08);
    border-left-color: var(--warning);
}

.alert-success {
    background: rgba(39, 174, 96, 0.08);
    border-left-color: var(--success);
}

.alert-info {
    background: rgba(52, 152, 219, 0.08);
    border-left-color: var(--info);
}

.alert-default {
    background: var(--gray-50);
    border-left-color: var(--gray-400);
}

.alert-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1.1rem;
}

.alert-warning .alert-icon {
    background: var(--warning);
    color: white;
}

.alert-success .alert-icon {
    background: var(--success);
    color: white;
}

.alert-info .alert-icon {
    background: var(--info);
    color: white;
}

.alert-default .alert-icon {
    background: var(--gray-400);
    color: white;
}

.alert-content {
    flex: 1;
}

.alert-content h4 {
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--primary);
    margin-bottom: 4px;
}

.alert-content p {
    font-size: 0.9rem;
    color: var(--gray-700);
    margin-bottom: 8px;
}

.alert-time {
    font-size: 0.8rem;
    color: var(--gray-500);
}

.alert-action .btn-sm {
    padding: 8px 16px;
    background: var(--white);
    border: 1px solid var(--gray-300);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    transition: var(--transition-base);
}

.alert-action .btn-sm:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
}

.table-responsive {
    overflow-x: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table thead {
    background: var(--gray-100);
}

.data-table th {
    padding: 16px;
    text-align: left;
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    border-bottom: 2px solid var(--gray-300);
}

.data-table td {
    padding: 16px;
    border-bottom: 1px solid var(--gray-200);
}

.data-table tbody tr {
    transition: var(--transition-base);
}

.data-table tbody tr:hover {
    background: var(--gray-50);
}

.event-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.event-cell strong {
    font-size: 1rem;
    color: var(--primary);
}

.event-cell span {
    font-size: 0.8rem;
    color: var(--gray-600);
}

.progress-cell {
    display: flex;
    align-items: center;
    gap: 12px;
}

.progress-bar-sm {
    width: 80px;
    height: 6px;
    background: var(--gray-200);
    border-radius: 3px;
    overflow: hidden;
}

.progress-fill-sm {
    height: 100%;
    background: linear-gradient(90deg, var(--success), #2ECC71);
    transition: width 0.3s ease;
}

.progress-cell span {
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
}

.revenue-cell {
    font-size: 1.1rem;
    font-weight: var(--font-weight-bold);
    color: var(--success);
}

.badge {
    padding: 6px 12px;
    border-radius: var(--border-radius-sm);
    font-size: 0.8rem;
    font-weight: var(--font-weight-semibold);
}

.badge-success {
    background: rgba(39, 174, 96, 0.1);
    color: var(--success);
}

.badge-danger {
    background: rgba(231, 76, 60, 0.1);
    color: var(--danger);
}
</style>
{% endblock %}

