{% extends 'base.html.twig' %}

{% block title %}Listes des ventes - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête de la page -->
    <div class="dashboard-header">
        <div>
            <h1>📋 Listes des ventes</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Tableau détaillé de toutes les ventes de billets
            </p>
        </div>
        <div class="header-actions">
            <button class="btn" style="background: var(--success); color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                <i class="fas fa-file-csv"></i> Export CSV
            </button>
        </div>
    </div>

    <!-- Filtres rapides -->
    <div class="quick-filters" style="margin-bottom: 20px;">
        <button class="filter-chip active">
            <i class="fas fa-calendar-check"></i> Tous
        </button>
        <button class="filter-chip">
            <i class="fas fa-clock"></i> Aujourd'hui
        </button>
        <button class="filter-chip">
            <i class="fas fa-calendar-week"></i> Cette semaine
        </button>
        <button class="filter-chip">
            <i class="fas fa-calendar-alt"></i> Ce mois
        </button>
        <button class="filter-chip">
            <i class="fas fa-check-circle"></i> Payées
        </button>
        <button class="filter-chip">
            <i class="fas fa-hourglass-half"></i> En attente
        </button>
    </div>

    <!-- Tableau des ventes -->
    <div class="chart-card">
        <div class="card-header">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3>📊 Historique des ventes</h3>
                    <p style="color: var(--gray-600); font-size: 0.9rem; margin-top: 4px;">
                        {{ total_ventes ?? 1248 }} ventes enregistrées
                    </p>
                </div>
                <div class="search-bar-small">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Rechercher une vente..." class="search-input-sm">
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="sales-table">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox">
                            </th>
                            <th>ID Vente</th>
                            <th>Date</th>
                            <th>Événement</th>
                            <th>Client</th>
                            <th>Billets</th>
                            <th>Montant</th>
                            <th>Méthode</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
