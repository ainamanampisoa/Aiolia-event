                            </td>
                            <td>
                                <div class="client-cell">
                                    <div class="client-avatar">PB</div>
                                    <div>
                                        <strong>Pierre Bernard</strong>
                                        <span>p.bernard@email.com</span>
                                    </div>
                                </div>
                            </td>
                            <td>3 × Tribune</td>
                            <td class="td-amount">150.00 €</td>
                            <td>
