                                    <div class="client-avatar">JD</div>
                                    <div>
                                        <strong>Jean Dupont</strong>
                                        <span>jean.dupont@email.com</span>
                                    </div>
                                </div>
                            </td>
                            <td>2 × VIP</td>
                            <td class="td-amount">98.00 €</td>
                            <td>
                                <span class="payment-method">
                                    <i class="fas fa-credit-card"></i> Carte
                                </span>
                            </td>
                            <td><span class="status-badge status-success">Payée</span></td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-icon-sm" title="Voir"><i class="fas fa-eye"></i></button>
                                    <button class="btn-icon-sm" title="Imprimer"><i class="fas fa-print"></i></button>
                                    <button class="btn-icon-sm" title="Plus"><i class="fas fa-ellipsis-v"></i></button>
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td><input type="checkbox"></td>
                            <td class="td-id">#VT-001247</td>
                            <td>17 Oct 2025, 12:20</td>
                            <td>
                                <div class="event-cell">
                                    <strong>🎵 Festival Jazz Mada</strong>
