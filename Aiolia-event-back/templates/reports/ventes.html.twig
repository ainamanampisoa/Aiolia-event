                            <td>5 × Standard</td>
                            <td class="td-amount">200.00 €</td>
                            <td>
                                <span class="payment-method">
                                    <i class="fas fa-mobile-alt"></i> Mobile Money
                                </span>
                            </td>
                            <td><span class="status-badge status-success">Payée</span></td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-icon-sm" title="Voir"><i class="fas fa-eye"></i></button>
                                    <button class="btn-icon-sm" title="Imprimer"><i class="fas fa-print"></i></button>
                                    <button class="btn-icon-sm" title="Plus"><i class="fas fa-ellipsis-v"></i></button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination">
                <button class="pagination-btn" disabled>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="pagination-btn active">1</button>
                <button class="pagination-btn">2</button>
                <button class="pagination-btn">3</button>
                <button class="pagination-btn">4</button>
                <span>...</span>
                <button class="pagination-btn">42</button>
                <button class="pagination-btn">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.quick-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.filter-chip {
    padding: 8px 16px;
    border: 2px solid var(--gray-300);
    background: white;
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: var(--font-weight-medium);
    color: var(--gray-700);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: var(--transition-base);
}

.filter-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
}

.filter-chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
}

.search-bar-small {
    position: relative;
    display: flex;
    align-items: center;
}

.search-bar-small i {
    position: absolute;
    left: 12px;
    color: var(--gray-500);
}

.search-input-sm {
    padding: 8px 12px 8px 36px;
    border: 2px solid var(--gray-200);
    border-radius: 8px;
    width: 250px;
    font-size: 0.9rem;
    transition: var(--transition-base);
}

.search-input-sm:focus {
    outline: none;
    border-color: var(--accent);
}

.table-responsive {
    overflow-x: auto;
}

.sales-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
}

.sales-table thead {
    background: var(--gray-100);
}

.sales-table th {
    padding: 12px;
    text-align: left;
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    border-bottom: 2px solid var(--gray-300);
}

.sales-table td {
    padding: 14px 12px;
    border-bottom: 1px solid var(--gray-200);
}

.sales-table tbody tr {
    transition: var(--transition-base);
}

.sales-table tbody tr:hover {
    background: var(--gray-50);
}

.td-id {
    font-family: 'Courier New', monospace;
    font-weight: var(--font-weight-bold);
    color: var(--accent);
}

.event-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.event-cell strong {
    font-size: 0.9rem;
    color: var(--primary);
}

.event-cell span {
    font-size: 0.75rem;
    color: var(--gray-600);
}

.client-cell {
    display: flex;
    align-items: center;
    gap: 10px;
}

.client-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-weight-bold);
    font-size: 0.8rem;
}

.client-cell strong {
    display: block;
    font-size: 0.9rem;
    color: var(--primary);
}

.client-cell span {
    display: block;
    font-size: 0.75rem;
    color: var(--gray-600);
}

.td-amount {
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    color: var(--success);
}

.payment-method {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--gray-100);
    border-radius: var(--border-radius-sm);
    font-size: 0.8rem;
    color: var(--gray-700);
}

.status-badge {
    padding: 4px 10px;
    border-radius: var(--border-radius-sm);
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
}

.status-success {
    background: rgba(39, 174, 96, 0.1);
    color: var(--success);
}

.status-pending {
    background: rgba(243, 156, 18, 0.1);
    color: var(--warning);
}

.action-buttons {
    display: flex;
    gap: 6px;
}

.btn-icon-sm {
    width: 30px;
    height: 30px;
    border: none;
    background: var(--gray-100);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gray-600);
    transition: var(--transition-base);
}

.btn-icon-sm:hover {
    background: var(--accent);
    color: white;
}

.pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
}

.pagination-btn {
    min-width: 36px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--gray-300);
    background: white;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    font-weight: var(--font-weight-medium);
    color: var(--gray-700);
    transition: var(--transition-base);
}

.pagination-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
}

.pagination-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
}

.pagination-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
</style>
{% endblock %}

