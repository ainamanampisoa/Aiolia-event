{# Composant de pagination générique
   Variables attendues :
   - pagination: { total, page, limit, totalPages, hasNext, hasPrev, startItem, endItem }
   - route: nom de la route Symfony
   - criteria: tableau de critères (sera fusionné avec { page: X })
#}

{% if pagination.total > pagination.limit %}
    <div class="pagination-section">
        <nav aria-label="Pagination">
            <ul class="pagination pagination-horizontal">
                {# Précédent #}
                <li class="page-item {% if not pagination.hasPrev %}disabled{% endif %}">
                    <a class="page-link"
                       href="{% if pagination.hasPrev %}{{ path(route, criteria|merge({page: pagination.page - 1})) }}{% else %}#{% endif %}"
                       aria-label="Précédent">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>

                {# Première page + ellipsis éventuel #}
                {% if pagination.page > 3 and pagination.totalPages > 5 %}
                    <li class="page-item {% if pagination.page == 1 %}active{% endif %}">
                        <a class="page-link" href="{{ path(route, criteria|merge({page: 1})) }}">1</a>
                    </li>
                    {% if pagination.page > 4 %}
                        <li class="page-item disabled">
                            <span class="page-link">…</span>
                        </li>
                    {% endif %}
                {% endif %}

                {# Pages autour de la page courante #}
                {% set startPage = max(1, pagination.page - 2) %}
                {% set endPage = min(pagination.totalPages, pagination.page + 2) %}

                {% for p in startPage..endPage %}
                    <li class="page-item {% if p == pagination.page %}active{% endif %}">
                        <a class="page-link" href="{{ path(route, criteria|merge({page: p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}

                {# Dernière page + ellipsis éventuel #}
                {% if pagination.page < pagination.totalPages - 2 and pagination.totalPages > 5 %}
                    {% if pagination.page < pagination.totalPages - 3 %}
                        <li class="page-item disabled">
                            <span class="page-link">…</span>
                        </li>
                    {% endif %}
                    <li class="page-item {% if pagination.page == pagination.totalPages %}active{% endif %}">
                        <a class="page-link"
                           href="{{ path(route, criteria|merge({page: pagination.totalPages})) }}">{{ pagination.totalPages }}</a>
                    </li>
                {% endif %}

                {# Suivant #}
                <li class="page-item {% if not pagination.hasNext %}disabled{% endif %}">
                    <a class="page-link"
                       href="{% if pagination.hasNext %}{{ path(route, criteria|merge({page: pagination.page + 1})) }}{% else %}#{% endif %}"
                       aria-label="Suivant">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="pagination-info">
            <p>
                Affichage de <strong>{{ pagination.startItem }}</strong> à <strong>{{ pagination.endItem }}</strong> sur <strong>{{ pagination.total }}</strong> événement(s)
            </p>
        </div>
    </div>
{% elseif pagination.total > 0 %}
    <div class="pagination-section">
        <div class="pagination-info">
            <p>
                Affichage de <strong>1</strong> à <strong>{{ pagination.total }}</strong>
                sur <strong>{{ pagination.total }}</strong> événement(s)
            </p>
        </div>
    </div>
{% endif %}

{# Styles locaux harmonisés avec la charte Aiolia (mêmes variables que les autres pages) #}
<style>
.pagination-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    padding: 24px;
    background: var(--bg-card);
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-md);
}

.pagination-horizontal {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
}

.pagination-horizontal .page-item {
    margin: 0;
}

.pagination-horizontal .page-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border-radius: 50%;
    border: 2px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
}

.pagination-horizontal .page-link:hover:not(.disabled) {
    background: var(--bg-card);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(67, 97, 238, 0.2);
}

.pagination-horizontal .page-item.active .page-link {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(67, 97, 238, 0.4);
    font-weight: 700;
}

.pagination-horizontal .page-item.active .page-link:hover {
    background: var(--accent);
    color: #ffffff;
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 6px 16px rgba(67, 97, 238, 0.5);
}

.pagination-horizontal .page-item.disabled .page-link {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    background: var(--bg-secondary);
}

.pagination-horizontal .page-item.disabled .page-link:hover {
    transform: none;
    box-shadow: none;
}

.pagination-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-align: center;
}

.pagination-info p {
    margin: 0;
    line-height: 1.5;
}

.pagination-info strong {
    color: var(--text-primary);
    font-weight: 700;
}
</style>

