{% extends 'base.html.twig' %}

{% block title %}Modifier le code promo - Aiolia Event{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-edit"></i> Modifier le code promo</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Modifiez les paramètres de votre code promo
            </p>
        </div>
        <div class="header-actions">
            <a href="{{ path('organisateur_promotions_index') }}" class="btn" style="background: white; color: var(--gray-700); border: 2px solid var(--gray-300); padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <form method="post" class="promo-form">
        <!-- Section 1: Configuration du code -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.15), rgba(155, 89, 182, 0.05)); color: #9B59B6;">
                    <i class="fas fa-tag"></i>
                </div>
                <div>
                    <h2>Configuration du code promo</h2>
                    <p>Définissez le code et le type de réduction</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Code promo <span class="required">*</span></label>
                    <div class="code-input-group">
                        <input type="text" name="code" class="form-control code-input" value="{{ promotion.code }}" required style="text-transform: uppercase; font-family: 'Courier New', monospace; font-size: 1.2rem; font-weight: bold;">
                    </div>
                    <small class="form-help">
                        <i class="fas fa-lightbulb"></i>
                        Utilisez des lettres majuscules, chiffres et tirets. Ex: PROMO2025, EARLY-BIRD
                    </small>
                </div>

                <div class="form-group span-2">
                    <label>Description <span class="required">*</span></label>
                    <textarea name="description" class="form-control" rows="3" placeholder="Décrivez cette promotion pour vos clients..." required>{{ promotion.metadonnees.description ?? '' }}</textarea>
                </div>
            </div>
        </div>

        <!-- Section 2: Type de réduction -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(243, 156, 18, 0.15), rgba(243, 156, 18, 0.05)); color: var(--warning);">
                    <i class="fas fa-percent"></i>
                </div>
                <div>
                    <h2>Type de réduction</h2>
                    <p>Choisissez le mode de calcul de la réduction</p>
                </div>
            </div>

            <div class="discount-type-selector">
                <label class="discount-card">
                    <input type="radio" name="discount_type" value="percentage" {{ promotion.typePromotion == 'percent' ? 'checked' : '' }}>
                    <div class="discount-card-content">
                        <div class="discount-icon" style="background: linear-gradient(135deg, #3498DB, #2980B9); color: white;">
                            <i class="fas fa-percentage"></i>
                        </div>
                        <h3>Pourcentage</h3>
                        <p>Ex: -20% sur le prix</p>
                        <div class="checkmark">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </label>

                <label class="discount-card">
                    <input type="radio" name="discount_type" value="fixed" {{ promotion.typePromotion == 'amount' ? 'checked' : '' }}>
                    <div class="discount-card-content">
                        <div class="discount-icon" style="background: linear-gradient(135deg, #27AE60, #229954); color: white;">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                        <h3>Montant fixe</h3>
                        <p>Ex: -10€ de réduction</p>
                        <div class="checkmark">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </label>
            </div>

            <div class="form-grid" style="margin-top: 24px;">
                <div class="form-group">
                    <label>Valeur de la réduction <span class="required">*</span></label>
                    <div class="value-input-group">
                        <input type="number" name="discount_value" class="form-control value-input" value="{{ promotion.valeur }}" min="0" max="100" required>
                        <span class="value-unit" id="discountUnit">{{ promotion.typePromotion == 'percent' ? '%' : '€' }}</span>
                    </div>
                    <small class="form-help">Maximum : <span id="maxValue">{{ promotion.typePromotion == 'percent' ? '100%' : '1000€' }}</span></small>
                </div>

                <div class="form-group">
                    <label>Montant minimum de commande</label>
                    <div class="value-input-group">
                        <input type="number" name="min_order" class="form-control" value="{{ promotion.metadonnees.min_order ?? '' }}" min="0" step="0.01">
                        <span class="value-unit">€</span>
                    </div>
                    <small class="form-help">Optionnel : commande minimum pour utiliser le code</small>
                </div>
            </div>
        </div>

        <!-- Section 3: Conditions d'utilisation -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                    <i class="fas fa-sliders-h"></i>
                </div>
                <div>
                    <h2>Conditions d'utilisation</h2>
                    <p>Définissez les règles et limites</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Nombre d'utilisations maximum</label>
                    <input type="number" name="max_uses" class="form-control" value="{{ promotion.utilisationMaximaleTotale ?? '' }}" placeholder="∞ Illimité" min="1">
                    <small class="form-help">Laissez vide pour illimité</small>
                </div>

                <div class="form-group">
                    <label>Utilisations par utilisateur</label>
                    <input type="number" name="max_uses_per_user" class="form-control" value="{{ promotion.utilisationMaximaleParUtilisateur ?? 1 }}" min="1">
                    <small class="form-help">Nombre de fois qu'un client peut utiliser ce code</small>
                </div>

                <div class="form-group">
                    <label>Date de début</label>
                    <div class="datetime-group">
                        <div class="date-input-wrapper">
                            <input type="text" name="start_date" id="start_date" class="form-control date-picker-input" placeholder="--/--/----" autocomplete="off" readonly value="{{ promotion.commenceLe ? promotion.commenceLe|date('d/m/Y') : '' }}">
                            <button type="button" class="clear-date-btn" id="clear_start_date" style="display: {{ promotion.commenceLe ? 'flex' : 'none' }};">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="time-group">
                            <label class="time-label">De :</label>
                            <div class="time-input-wrapper">
                                <input type="text" name="start_time" id="start_time" class="form-control time-picker-input" placeholder="--:--" autocomplete="off" readonly value="{{ promotion.commenceLe ? promotion.commenceLe|date('H:i') : '' }}">
                            </div>
                        </div>
                    </div>
                    <small class="form-help">Si vide, actif immédiatement</small>
                </div>

                <div class="form-group">
                    <label>Date de fin <span class="required">*</span></label>
                    <div class="datetime-group">
                        <div class="date-input-wrapper">
                            <input type="text" name="end_date" id="end_date" class="form-control date-picker-input" placeholder="--/--/----" required autocomplete="off" readonly value="{{ promotion.seTermineLe ? promotion.seTermineLe|date('d/m/Y') : '' }}">
                            <button type="button" class="clear-date-btn" id="clear_end_date" style="display: {{ promotion.seTermineLe ? 'flex' : 'none' }};">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="time-group">
                            <label class="time-label">De :</label>
                            <div class="time-input-wrapper">
                                <input type="text" name="end_time" id="end_time" class="form-control time-picker-input" placeholder="--:--" required autocomplete="off" readonly value="{{ promotion.seTermineLe ? promotion.seTermineLe|date('H:i') : '' }}">
                            </div>
                        </div>
                    </div>
                    <small class="form-help">Date d'expiration du code</small>
                </div>
            </div>
        </div>

        <!-- Section 4: Application -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(39, 174, 96, 0.15), rgba(39, 174, 96, 0.05)); color: var(--success);">
                    <i class="fas fa-filter"></i>
                </div>
                <div>
                    <h2>Application de la promotion</h2>
                    <p>Sur quels événements ou catégories ?</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Événements concernés</label>
                    <div class="events-table-container">
                        <table class="events-table">
                            <thead>
                                <tr>
                                    <th class="checkbox-col">
                                        <input type="checkbox" id="select_all_events" class="select-all-checkbox">
                                    </th>
                                    <th>Événement</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set selectedEvents = promotion.metadonnees.events ?? [] %}
                                {% set allSelected = selectedEvents|length == 0 or 'all' in selectedEvents %}
                                <tr class="event-row">
                                    <td class="checkbox-col">
                                        <input type="checkbox" name="events[]" value="all" id="event_all" class="event-checkbox" {{ allSelected ? 'checked' : '' }}>
                                    </td>
                                    <td>
                                        <label for="event_all" class="event-label">
                                            <span class="event-icon">✨</span>
                                            <span class="event-name">Tous les événements</span>
                                        </label>
                                    </td>
                                </tr>
                                {% if events|length > 0 %}
                                    {% for event in events %}
                                    <tr class="event-row">
                                        <td class="checkbox-col">
                                            <input type="checkbox" name="events[]" value="{{ event.id }}" id="event_{{ event.id }}" class="event-checkbox" {{ event.id in selectedEvents ? 'checked' : '' }}>
                                        </td>
                                        <td>
                                            <label for="event_{{ event.id }}" class="event-label">
                                                <span class="event-icon">
                                                    {% if event.typeEvenement %}
                                                        {% set typeIcon = {
                                                            'Concert': '🎸',
                                                            'Festival': '🎵',
                                                            'Sport': '⚽',
                                                            'Théâtre': '🎭',
                                                            'Conférence': '🎤',
                                                            'Exposition': '🖼️'
                                                        } %}
                                                        {{ typeIcon[event.typeEvenement.nom] ?? '📅' }}
                                                    {% else %}
                                                        📅
                                                    {% endif %}
                                                </span>
                                                <span class="event-name">{{ event.titre }}</span>
                                                {% if event.commenceLe %}
                                                    <span class="event-date">({{ event.commenceLe|date('d/m/Y') }})</span>
                                                {% endif %}
                                            </label>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="2" style="padding: 20px; text-align: center; color: var(--gray-600);">
                                            <i class="fas fa-calendar-times" style="font-size: 2rem; margin-bottom: 8px; opacity: 0.3; display: block;"></i>
                                            <p style="margin: 0;">Aucun événement en cours ou à venir</p>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                    <small class="form-help">Sélectionnez les événements concernés par cette promotion</small>
                </div>

                <div class="form-group">
                    <label>Catégories de billets</label>
                    <div class="checkbox-group">
                        <label class="checkbox-item">
                            <input type="checkbox" name="categories[]" value="all" {{ (promotion.metadonnees.categories ?? [])|length == 0 or 'all' in (promotion.metadonnees.categories ?? []) ? 'checked' : '' }}>
                            <span>Toutes les catégories</span>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" name="categories[]" value="vip" {{ 'vip' in (promotion.metadonnees.categories ?? []) ? 'checked' : '' }}>
                            <span>VIP uniquement</span>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" name="categories[]" value="standard" {{ 'standard' in (promotion.metadonnees.categories ?? []) ? 'checked' : '' }}>
                            <span>Standard uniquement</span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label>Options avancées</label>
                    <div class="checkbox-group">
                        <label class="checkbox-item">
                            <input type="checkbox" name="first_purchase" value="1" {{ (promotion.metadonnees.first_purchase ?? false) ? 'checked' : '' }}>
                            <span>Premier achat uniquement</span>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" name="cumulative" value="1" {{ (promotion.metadonnees.cumulative ?? false) ? 'checked' : '' }}>
                            <span>Cumulable avec d'autres promos</span>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" name="auto_apply" value="1" {{ (promotion.metadonnees.auto_apply ?? false) ? 'checked' : '' }}>
                            <span>Application automatique</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #3498DB, #5DADE2) !important; color: white; border: none; padding: 16px 36px; border-radius: 12px; font-weight: 600; font-size: 1.05rem; box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);">
                <i class="fas fa-check"></i>
                Enregistrer les modifications
            </button>
            <a href="{{ path('organisateur_promotions_index') }}" class="btn" style="color: var(--gray-600); text-decoration: none; padding: 16px 24px;">
                Annuler
            </a>
        </div>
    </form>
</div>

<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // ============================================
    // INITIALISATION FLATPICKR POUR LES DATES ET HEURES
    // ============================================
    const startDateInput = document.getElementById('start_date');
    const startTimeInput = document.getElementById('start_time');
    const endDateInput = document.getElementById('end_date');
    const endTimeInput = document.getElementById('end_time');
    
    let startDatePicker = null;
    let startTimePicker = null;
    let endDatePicker = null;
    let endTimePicker = null;
    
    // Configuration Flatpickr pour les dates (format DD/MM/YYYY)
    const datePickerOptions = {
        dateFormat: "d/m/Y",
        locale: window.flatpickr?.l10ns?.fr || "fr",
        minDate: "today",
        allowInput: false,
        clickOpens: true,
        static: false,
        monthSelectorType: "static",
        onReady: function(selectedDates, dateStr, instance) {
            instance.calendarContainer.classList.add('custom-flatpickr');
            // Améliorer l'affichage du mois
            const monthElement = instance.calendarContainer.querySelector('.flatpickr-month');
            if (monthElement) {
                monthElement.style.display = 'flex';
                monthElement.style.justifyContent = 'space-between';
                monthElement.style.alignItems = 'center';
            }
        },
        onChange: function(selectedDates, dateStr, instance) {
            // Afficher le bouton de suppression si une date est sélectionnée
            const inputId = instance.input.id;
            const clearBtn = document.getElementById('clear_' + inputId);
            if (clearBtn) {
                clearBtn.style.display = selectedDates.length > 0 ? 'flex' : 'none';
            }
        }
    };
    
    // Configuration Flatpickr pour les heures avec dropdown
    const timePickerOptions = {
        enableTime: true,
        noCalendar: true,
        dateFormat: "H:i",
        time_24hr: true,
        locale: window.flatpickr?.l10ns?.fr || "fr",
        allowInput: false,
        clickOpens: true,
        minuteIncrement: 15,
        onReady: function(selectedDates, dateStr, instance) {
            instance.calendarContainer.classList.add('custom-flatpickr-time');
            // Améliorer l'affichage du sélecteur d'heure
            const timeInputs = instance.calendarContainer.querySelectorAll('.flatpickr-time input');
            timeInputs.forEach(input => {
                input.style.fontSize = '1.2rem';
                input.style.fontWeight = '600';
            });
        },
        onChange: function(selectedDates, dateStr, instance) {
            // Mettre à jour l'affichage
            if (selectedDates.length > 0) {
                const time = instance.formatDate(selectedDates[0], "H:i");
                instance.input.value = time;
            }
        }
    };
    
    // Initialiser le date picker pour la date de début
    if (startDateInput) {
        let startDateValue = startDateInput.value;
        // Convertir le format DD/MM/YYYY si présent
        if (startDateValue && startDateValue.includes('/')) {
            const [day, month, year] = startDateValue.split('/');
            startDateValue = `${year}-${month}-${day}`;
        }
        startDatePicker = flatpickr(startDateInput, {
            ...datePickerOptions,
            defaultDate: startDateValue || null,
            onChange: function(selectedDates, dateStr, instance) {
                updatePreview();
                // Mettre à jour la date minimale de fin
                if (selectedDates.length > 0 && endDatePicker) {
                    endDatePicker.set('minDate', selectedDates[0]);
                }
                // Afficher/masquer le bouton de suppression
                const clearBtn = document.getElementById('clear_start_date');
                if (clearBtn) {
                    clearBtn.style.display = selectedDates.length > 0 ? 'flex' : 'none';
                }
            }
        });
    }
    
    // Initialiser le time picker pour l'heure de début
    if (startTimeInput) {
        const startTimeValue = startTimeInput.value;
        startTimePicker = flatpickr(startTimeInput, {
            ...timePickerOptions,
            defaultDate: startTimeValue ? '1970-01-01 ' + startTimeValue : null,
            onChange: function(selectedDates, dateStr, instance) {
                updatePreview();
            }
        });
    }
    
    // Initialiser le date picker pour la date de fin
    if (endDateInput) {
        let endDateValue = endDateInput.value;
        // Convertir le format DD/MM/YYYY si présent
        if (endDateValue && endDateValue.includes('/')) {
            const [day, month, year] = endDateValue.split('/');
            endDateValue = `${year}-${month}-${day}`;
        }
        endDatePicker = flatpickr(endDateInput, {
            ...datePickerOptions,
            defaultDate: endDateValue || null,
            onChange: function(selectedDates, dateStr, instance) {
                updatePreview();
                // Afficher/masquer le bouton de suppression
                const clearBtn = document.getElementById('clear_end_date');
                if (clearBtn) {
                    clearBtn.style.display = selectedDates.length > 0 ? 'flex' : 'none';
                }
            }
        });
    }
    
    // Initialiser le time picker pour l'heure de fin
    if (endTimeInput) {
        const endTimeValue = endTimeInput.value;
        endTimePicker = flatpickr(endTimeInput, {
            ...timePickerOptions,
            defaultDate: endTimeValue ? '1970-01-01 ' + endTimeValue : null,
            onChange: function(selectedDates, dateStr, instance) {
                updatePreview();
            }
        });
    }
    
    // Boutons de suppression de date
    const clearStartDateBtn = document.getElementById('clear_start_date');
    if (clearStartDateBtn) {
        clearStartDateBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (startDatePicker) {
                startDatePicker.clear();
                startDateInput.value = '';
                this.style.display = 'none';
            }
        });
    }
    
    const clearEndDateBtn = document.getElementById('clear_end_date');
    if (clearEndDateBtn) {
        clearEndDateBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (endDatePicker) {
                endDatePicker.clear();
                endDateInput.value = '';
                this.style.display = 'none';
            }
        });
    }
    
    function updatePreview() {
        // Fonction pour mettre à jour l'aperçu si nécessaire
    }
        
        // Mettre à jour la date minimale de fin quand la date de début change
        if (startDatePicker) {
            startDatePicker.config.onChange.push(function(selectedDates) {
                if (selectedDates.length > 0 && endDatePicker) {
                    endDatePicker.set('minDate', selectedDates[0]);
                }
            });
        }
    }

    // ============================================
    // CHANGEMENT TYPE DE RÉDUCTION
    // ============================================
    const discountTypeRadios = document.querySelectorAll('input[name="discount_type"]');
    const discountUnit = document.getElementById('discountUnit');
    const maxValue = document.getElementById('maxValue');
    const valueInput = document.querySelector('input[name="discount_value"]');
    
    discountTypeRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'percentage') {
                discountUnit.textContent = '%';
                maxValue.textContent = '100%';
                valueInput.max = 100;
            } else {
                discountUnit.textContent = '€';
                maxValue.textContent = '1000€';
                valueInput.max = 1000;
            }
        });
    });

    // ============================================
    // CONVERSION DU FORMAT DE DATE AVANT SOUMISSION
    // ============================================
    const form = document.querySelector('.promo-form');
    if (form) {
        form.addEventListener('submit', function(e) {
            // Combiner date et heure de début (convertir DD/MM/YYYY en YYYY-MM-DD)
            if (startDatePicker && startDatePicker.selectedDates.length > 0) {
                const date = startDatePicker.selectedDates[0];
                let timeStr = startTimeInput.value || '00:00';
                if (timeStr === '--:--') timeStr = '00:00';
                const [hours, minutes] = timeStr.split(':');
                const formattedDate = date.getFullYear() + '-' + 
                    String(date.getMonth() + 1).padStart(2, '0') + '-' + 
                    String(date.getDate()).padStart(2, '0') + 'T' + 
                    String(hours || '00').padStart(2, '0') + ':' + 
                    String(minutes || '00').padStart(2, '0');
                startDateInput.value = formattedDate;
            } else if (startDateInput && !startDateInput.value) {
                // Si la date est vide, envoyer une chaîne vide
                startDateInput.value = '';
            }
            
            // Combiner date et heure de fin (convertir DD/MM/YYYY en YYYY-MM-DD)
            if (endDatePicker && endDatePicker.selectedDates.length > 0) {
                const date = endDatePicker.selectedDates[0];
                let timeStr = endTimeInput.value || '23:59';
                if (timeStr === '--:--') timeStr = '23:59';
                const [hours, minutes] = timeStr.split(':');
                const formattedDate = date.getFullYear() + '-' + 
                    String(date.getMonth() + 1).padStart(2, '0') + '-' + 
                    String(date.getDate()).padStart(2, '0') + 'T' + 
                    String(hours || '23').padStart(2, '0') + ':' + 
                    String(minutes || '59').padStart(2, '0');
                endDateInput.value = formattedDate;
            }
        });
    }

    // ============================================
    // GESTION DES ÉVÉNEMENTS (SELECT ALL)
    // ============================================
    const selectAllEvents = document.getElementById('select_all_events');
    const eventCheckboxes = document.querySelectorAll('.event-checkbox:not(#event_all)');
    const eventAllCheckbox = document.getElementById('event_all');
    
    // Fonction pour mettre à jour l'état du select all
    function updateSelectAllState() {
        if (selectAllEvents && eventCheckboxes.length > 0) {
            const allChecked = Array.from(eventCheckboxes).every(cb => cb.checked);
            const someChecked = Array.from(eventCheckboxes).some(cb => cb.checked);
            selectAllEvents.checked = allChecked;
            selectAllEvents.indeterminate = someChecked && !allChecked;
        }
    }
    
    if (selectAllEvents) {
        selectAllEvents.addEventListener('change', function() {
            eventCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            if (this.checked) {
                eventAllCheckbox.checked = false;
            }
        });
    }
    
    if (eventAllCheckbox) {
        eventAllCheckbox.addEventListener('change', function() {
            if (this.checked) {
                eventCheckboxes.forEach(checkbox => checkbox.checked = false);
                if (selectAllEvents) {
                    selectAllEvents.checked = false;
                    selectAllEvents.indeterminate = false;
                }
            }
        });
    }
    
    eventCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            if (this.checked) {
                eventAllCheckbox.checked = false;
            }
            updateSelectAllState();
        });
    });
    
    // Initialiser l'état du select all
    updateSelectAllState();

    // ============================================
    // CHECKBOX "TOUTES LES CATÉGORIES"
    // ============================================
    const allCategoriesCheck = document.querySelector('input[name="categories[]"][value="all"]');
    const categoryChecks = document.querySelectorAll('input[name="categories[]"]:not([value="all"])');
    
    allCategoriesCheck.addEventListener('change', function() {
        if (this.checked) {
            categoryChecks.forEach(check => check.checked = false);
        }
    });
    
    categoryChecks.forEach(check => {
        check.addEventListener('change', function() {
            if (this.checked) {
                allCategoriesCheck.checked = false;
            }
        });
    });
});
</script>

