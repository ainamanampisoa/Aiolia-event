</style>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const deleteModal = document.getElementById('deletePromoModal');
    const deleteMessage = document.getElementById('deletePromoMessage');
    const btnCancel = deleteModal?.querySelector('.modal-cancel');
    const btnConfirm = deleteModal?.querySelector('.modal-confirm');
    const btnClose = deleteModal?.querySelector('.modal-close');
    let formToSubmit = null;

    const openDeleteModal = (form) => {
        formToSubmit = form;
        const code = form.dataset.promoCode || 'ce code promo';
        const codeElement = document.getElementById('deletePromoCode');
        if (codeElement) {
            codeElement.textContent = code;
        }
        deleteModal?.classList.add('active');
        deleteModal?.setAttribute('aria-hidden', 'false');
    };

    const closeDeleteModal = () => {
        formToSubmit = null;
        deleteModal?.classList.remove('active');
        deleteModal?.setAttribute('aria-hidden', 'true');
    };

    document.querySelectorAll('.promo-delete-form').forEach(form => {
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            openDeleteModal(form);
        });
    });

    btnCancel?.addEventListener('click', closeDeleteModal);
    btnClose?.addEventListener('click', closeDeleteModal);
    deleteModal?.addEventListener('click', (e) => {
        if (e.target === deleteModal) closeDeleteModal();
    });

    btnConfirm?.addEventListener('click', () => {
        if (formToSubmit) {
            formToSubmit.submit();
        }
        closeDeleteModal();
    });
});
</script>
