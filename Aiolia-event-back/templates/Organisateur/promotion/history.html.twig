{% extends 'base.html.twig' %}

{% block title %}Historique - {{ promotion.code }} - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-history"></i> Historique du code promo</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Détails des utilisations du code <strong>{{ promotion.code }}</strong>
            </p>
        </div>
        <div class="header-actions">
            <a href="{{ path('organisateur_promotions_index') }}" class="btn" style="background: white; color: var(--gray-700); border: 2px solid var(--gray-300); padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <!-- Informations du code promo -->
    <div class="chart-card" style="margin-bottom: 24px;">
        <div class="card-header">
            <h3>ℹ️ Informations du code promo</h3>
        </div>
        <div class="card-body">
            <div class="promo-info-grid">
                <div class="info-item">
                    <div class="info-label">Code</div>
                    <div class="info-value promo-code-display">{{ promotion.code }}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Type de réduction</div>
                    <div class="info-value">
                        {% if promotion.typePromotion == 'percent' %}
                            -{{ promotion.valeur }}%
                        {% else %}
                            -{{ promotion.valeur|number_format(2, ',', ' ') }} MGA
                        {% endif %}
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-label">Statut</div>
                    <div class="info-value">
                        {% if promotion.isActive() %}
                            <span class="status-badge status-active">Active</span>
                        {% else %}
                            <span class="status-badge status-inactive">Inactive</span>
                        {% endif %}
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-label">Date de création</div>
                    <div class="info-value">{{ promotion.creeLe|date('d/m/Y à H:i') }}</div>
                </div>
                {% if promotion.commenceLe %}
                <div class="info-item">
                    <div class="info-label">Date de début</div>
                    <div class="info-value">{{ promotion.commenceLe|date('d/m/Y à H:i') }}</div>
                </div>
                {% endif %}
                {% if promotion.seTermineLe %}
                <div class="info-item">
                    <div class="info-label">Date de fin</div>
                    <div class="info-value">{{ promotion.seTermineLe|date('d/m/Y à H:i') }}</div>
                </div>
                {% endif %}
                <div class="info-item">
                    <div class="info-label">Utilisations totales</div>
                    <div class="info-value">{{ totalUtilisations }}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Réductions accordées</div>
                    <div class="info-value" style="color: var(--success); font-weight: bold;">
                        -{{ totalRemise|number_format(2, ',', ' ') }}€
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Historique des utilisations -->
    <div class="chart-card">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h3>📋 Historique des utilisations</h3>
            {% if pagination.total_items > 0 %}
            <div style="color: var(--gray-600); font-size: 0.9rem;">
                Affichage de {{ ((pagination.current_page - 1) * pagination.per_page + 1) }} à {{ min(pagination.current_page * pagination.per_page, pagination.total_items) }} sur {{ pagination.total_items }} utilisation{{ pagination.total_items > 1 ? 's' : '' }}
            </div>
            {% endif %}
        </div>
        <div class="card-body">
            {% if applications|length > 0 %}
            <div class="table-responsive">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Utilisateur</th>
                            <th>Commande</th>
                            <th>Montant remise</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for application in applications %}
                        <tr>
                            <td>
                                <div class="date-cell">
                                    <i class="fas fa-calendar"></i>
                                    {{ application.appliqueLe|date('d/m/Y') }}
                                </div>
                                <div class="time-cell">
                                    {{ application.appliqueLe|date('H:i') }}
                                </div>
                            </td>
                            <td>
                                <div class="user-cell">
                                    <i class="fas fa-user"></i>
                                    {{ application.utilisateur.email ?? 'Utilisateur #' ~ application.utilisateur.id }}
                                </div>
                            </td>
                            <td>
                                <div class="order-cell">
                                    <i class="fas fa-shopping-cart"></i>
                                    Commande #{{ application.commande.id }}
                                </div>
                            </td>
                            <td>
                                <div class="amount-cell">
                                    <span class="discount-amount">-{{ application.montantRemise|number_format(2, ',', ' ') }}€</span>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            {% if pagination.total_pages > 1 %}
            <div class="pagination-wrapper" style="margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--gray-200);">
                <nav class="pagination" aria-label="Pagination">
                    {% set currentPage = pagination.current_page %}
                    {% set totalPages = pagination.total_pages %}
                    
                    <ul class="pagination-list">
                        {# Bouton Précédent #}
                        <li class="pagination-item">
                            {% if currentPage > 1 %}
                                <a href="{{ path('organisateur_promotions_history', {id: promotion.id, page: currentPage - 1}) }}" class="pagination-link">
                                    <i class="fas fa-chevron-left"></i>
                                    Précédent
                                </a>
                            {% else %}
                                <span class="pagination-link disabled">
                                    <i class="fas fa-chevron-left"></i>
                                    Précédent
                                </span>
                            {% endif %}
                        </li>

                        {# Numéros de pages #}
                        {% set startPage = max(1, currentPage - 2) %}
                        {% set endPage = min(totalPages, currentPage + 2) %}
                        
                        {% if startPage > 1 %}
                            <li class="pagination-item">
                                <a href="{{ path('organisateur_promotions_history', {id: promotion.id, page: 1}) }}" class="pagination-link">1</a>
                            </li>
                            {% if startPage > 2 %}
                                <li class="pagination-item">
                                    <span class="pagination-ellipsis">...</span>
                                </li>
                            {% endif %}
                        {% endif %}

                        {% for page in startPage..endPage %}
                            <li class="pagination-item">
                                {% if page == currentPage %}
                                    <span class="pagination-link active">{{ page }}</span>
                                {% else %}
                                    <a href="{{ path('organisateur_promotions_history', {id: promotion.id, page: page}) }}" class="pagination-link">{{ page }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}

                        {% if endPage < totalPages %}
                            {% if endPage < totalPages - 1 %}
                                <li class="pagination-item">
                                    <span class="pagination-ellipsis">...</span>
                                </li>
                            {% endif %}
                            <li class="pagination-item">
                                <a href="{{ path('organisateur_promotions_history', {id: promotion.id, page: totalPages}) }}" class="pagination-link">{{ totalPages }}</a>
                            </li>
                        {% endif %}

                        {# Bouton Suivant #}
                        <li class="pagination-item">
                            {% if currentPage < totalPages %}
                                <a href="{{ path('organisateur_promotions_history', {id: promotion.id, page: currentPage + 1}) }}" class="pagination-link">
                                    Suivant
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            {% else %}
                                <span class="pagination-link disabled">
                                    Suivant
                                    <i class="fas fa-chevron-right"></i>
                                </span>
                            {% endif %}
                        </li>
                    </ul>
                </nav>
            </div>
            {% endif %}
            {% else %}
            <div style="text-align: center; padding: 40px; color: var(--gray-600);">
                <i class="fas fa-history" style="font-size: 3rem; margin-bottom: 16px; opacity: 0.3;"></i>
                <p style="font-size: 1.1rem; margin-bottom: 8px;">Aucune utilisation enregistrée</p>
                <p style="font-size: 0.9rem;">Ce code promo n'a pas encore été utilisé.</p>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.promo-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.info-label {
    font-size: 0.85rem;
    color: var(--gray-600);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.info-value {
    font-size: 1.1rem;
    color: var(--primary);
    font-weight: var(--font-weight-semibold);
}

.promo-code-display {
    font-family: 'Courier New', monospace;
    font-size: 1.4rem;
    font-weight: var(--font-weight-bold);
    color: var(--accent);
    background: var(--gray-100);
    padding: 8px 16px;
    border-radius: var(--border-radius-sm);
    display: inline-block;
}

.status-badge {
    padding: 6px 12px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: var(--font-weight-bold);
    display: inline-block;
}

.status-badge.status-active {
    background: rgba(39, 174, 96, 0.1);
    color: var(--success);
}

.status-badge.status-inactive {
    background: rgba(149, 165, 166, 0.1);
    color: var(--gray-600);
}

.table-responsive {
    overflow-x: auto;
}

.history-table {
    width: 100%;
    border-collapse: collapse;
}

.history-table thead {
    background: var(--gray-50);
    border-bottom: 2px solid var(--gray-200);
}

.history-table th {
    padding: 16px;
    text-align: left;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.history-table tbody tr {
    border-bottom: 1px solid var(--gray-200);
    transition: var(--transition-base);
}

.history-table tbody tr:hover {
    background: var(--gray-50);
}

.history-table td {
    padding: 16px;
    color: var(--gray-700);
}

.date-cell {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: var(--font-weight-semibold);
}

.date-cell i {
    color: var(--accent);
}

.time-cell {
    font-size: 0.85rem;
    color: var(--gray-600);
    margin-top: 4px;
}

.user-cell {
    display: flex;
    align-items: center;
    gap: 8px;
}

.user-cell i {
    color: var(--accent);
}

.order-cell {
    display: flex;
    align-items: center;
    gap: 8px;
}

.order-cell i {
    color: var(--accent);
}

.amount-cell {
    text-align: right;
}

.discount-amount {
    color: var(--success);
    font-weight: var(--font-weight-bold);
    font-size: 1.1rem;
}

.pagination-wrapper {
    display: flex;
    justify-content: center;
}

.pagination-list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 8px;
    align-items: center;
}

.pagination-item {
    margin: 0;
}

.pagination-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    background: var(--white);
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    color: var(--gray-700);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    transition: var(--transition-base);
    cursor: pointer;
}

.pagination-link:hover:not(.disabled):not(.active) {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
}

.pagination-link.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
    font-weight: var(--font-weight-bold);
}

.pagination-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--gray-100);
}

.pagination-ellipsis {
    padding: 10px 8px;
    color: var(--gray-500);
}

@media (max-width: 768px) {
    .promo-info-grid {
        grid-template-columns: 1fr;
    }
    
    .history-table {
        font-size: 0.9rem;
    }
    
    .history-table th,
    .history-table td {
        padding: 12px 8px;
    }
    
    .pagination-list {
        flex-wrap: wrap;
        justify-content: center;
    }
}
</style>
{% endblock %}

