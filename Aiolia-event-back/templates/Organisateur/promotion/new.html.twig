{% extends 'base.html.twig' %}

{% block title %}Nouveau code promo - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1>🎁 Créer un code promo</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Offrez des réductions à vos clients
            </p>
        </div>
        <div class="header-actions">
            <a href="{{ path('organisateur_promotions_index') }}" class="btn" style="background: white; color: var(--gray-700); border: 2px solid var(--gray-300); padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <form method="post" class="promo-form">
        <!-- Section 1: Configuration du code -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.15), rgba(155, 89, 182, 0.05)); color: #9B59B6;">
                    <i class="fas fa-tag"></i>
                </div>
                <div>
                    <h2>Configuration du code promo</h2>
                    <p>Définissez le code et le type de réduction</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Code promo <span class="required">*</span></label>
                    <div class="code-input-group">
                        <input type="text" name="code" class="form-control code-input" placeholder="Ex: EARLYBIRD2025" required style="text-transform: uppercase; font-family: 'Courier New', monospace; font-size: 1.2rem; font-weight: bold;">
                        <button type="button" class="btn-generate" onclick="generatePromoCode()">
                            <i class="fas fa-magic"></i>
                            Générer
                        </button>
                    </div>
                    <small class="form-help">
                        <i class="fas fa-lightbulb"></i>
                        Utilisez des lettres majuscules, chiffres et tirets. Ex: PROMO2025, EARLY-BIRD
                    </small>
                </div>

                <div class="form-group span-2">
                    <label>Description <span class="required">*</span></label>
                    <textarea name="description" class="form-control" rows="3" placeholder="Décrivez cette promotion pour vos clients..." required></textarea>
                </div>
            </div>
        </div>

        <!-- Section 2: Type de réduction -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(243, 156, 18, 0.15), rgba(243, 156, 18, 0.05)); color: var(--warning);">
                    <i class="fas fa-percent"></i>
                </div>
                <div>
                    <h2>Type de réduction</h2>
                    <p>Choisissez le mode de calcul de la réduction</p>
                </div>
            </div>

            <div class="discount-type-selector">
                <label class="discount-card">
                    <input type="radio" name="discount_type" value="percentage" checked>
                    <div class="discount-card-content">
                        <div class="discount-icon" style="background: linear-gradient(135deg, #3498DB, #2980B9); color: white;">
                            <i class="fas fa-percentage"></i>
                        </div>
                        <h3>Pourcentage</h3>
                        <p>Ex: -20% sur le prix</p>
                        <div class="checkmark">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </label>

                <label class="discount-card">
                    <input type="radio" name="discount_type" value="fixed">
                    <div class="discount-card-content">
                        <div class="discount-icon" style="background: linear-gradient(135deg, #27AE60, #229954); color: white;">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                        <h3>Montant fixe</h3>
                        <p>Ex: -10€ de réduction</p>
                        <div class="checkmark">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </label>
            </div>

            <div class="form-grid" style="margin-top: 24px;">
                <div class="form-group">
                    <label>Valeur de la réduction <span class="required">*</span></label>
                    <div class="value-input-group">
                        <input type="number" name="discount_value" class="form-control value-input" placeholder="20" min="0" max="100" required>
                        <span class="value-unit" id="discountUnit">%</span>
                    </div>
                    <small class="form-help">Maximum : <span id="maxValue">100%</span></small>
                </div>

                <div class="form-group">
                    <label>Montant minimum de commande</label>
                    <div class="value-input-group">
                        <input type="number" name="min_order" class="form-control" placeholder="0" min="0" step="0.01">
                        <span class="value-unit">€</span>
                    </div>
                    <small class="form-help">Optionnel : commande minimum pour utiliser le code</small>
                </div>
            </div>
        </div>

        <!-- Section 3: Conditions d'utilisation -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                    <i class="fas fa-sliders-h"></i>
                </div>
                <div>
                    <h2>Conditions d'utilisation</h2>
                    <p>Définissez les règles et limites</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Nombre d'utilisations maximum</label>
                    <input type="number" name="max_uses" class="form-control" placeholder="∞ Illimité" min="1">
                    <small class="form-help">Laissez vide pour illimité</small>
                </div>

                <div class="form-group">
                    <label>Utilisations par utilisateur</label>
                    <input type="number" name="max_uses_per_user" class="form-control" placeholder="1" min="1" value="1">
                    <small class="form-help">Nombre de fois qu'un client peut utiliser ce code</small>
                </div>

                <div class="form-group">
                    <label>Date de début</label>
                    <input type="datetime-local" name="start_date" class="form-control">
                    <small class="form-help">Si vide, actif immédiatement</small>
                </div>

                <div class="form-group">
                    <label>Date de fin <span class="required">*</span></label>
                    <input type="datetime-local" name="end_date" class="form-control" required>
                    <small class="form-help">Date d'expiration du code</small>
                </div>
            </div>
        </div>

        <!-- Section 4: Application -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(39, 174, 96, 0.15), rgba(39, 174, 96, 0.05)); color: var(--success);">
                    <i class="fas fa-filter"></i>
                </div>
                <div>
                    <h2>Application de la promotion</h2>
                    <p>Sur quels événements ou catégories ?</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Événements concernés</label>
                    <select name="events[]" class="form-control" multiple size="4">
                        <option value="all" selected>✨ Tous les événements</option>
                        <option value="1">🎸 Concert Rock Nation</option>
                        <option value="2">🎵 Festival Jazz Mada</option>
                        <option value="3">⚽ Match de Football</option>
                        <option value="4">🎭 Théâtre Classique</option>
                    </select>
                    <small class="form-help">Maintenez Ctrl/Cmd pour sélectionner plusieurs événements</small>
                </div>

                <div class="form-group">
                    <label>Catégories de billets</label>
                    <div class="checkbox-group">
                        <label class="checkbox-item">
                            <input type="checkbox" name="categories[]" value="all" checked>
                            <span>Toutes les catégories</span>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" name="categories[]" value="vip">
                            <span>VIP uniquement</span>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" name="categories[]" value="standard">
                            <span>Standard uniquement</span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label>Options avancées</label>
                    <div class="checkbox-group">
                        <label class="checkbox-item">
                            <input type="checkbox" name="first_purchase" value="1">
                            <span>Premier achat uniquement</span>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" name="cumulative" value="1">
                            <span>Cumulable avec d'autres promos</span>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" name="auto_apply" value="1">
                            <span>Application automatique</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aperçu de la promotion -->
        <div class="promo-preview">
            <div class="preview-header">
                <i class="fas fa-eye"></i>
                Aperçu de votre code promo
            </div>
            <div class="preview-card">
                <div class="preview-code" id="previewCode">EARLYBIRD2025</div>
                <div class="preview-discount" id="previewDiscount">-20%</div>
                <div class="preview-description" id="previewDescription">Réduction pour les achats anticipés</div>
                <div class="preview-validity">
                    <i class="fas fa-calendar"></i>
                    <span id="previewValidity">Valide jusqu'au 31 Oct 2025</span>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #3498DB, #5DADE2) !important; color: white; border: none; padding: 16px 36px; border-radius: 12px; font-weight: 600; font-size: 1.05rem; box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);">
                <i class="fas fa-check"></i>
                Créer le code promo
            </button>
            <button type="button" class="btn btn-secondary" style="background: white; color: var(--gray-700); border: 2px solid var(--gray-300); padding: 16px 32px; border-radius: 12px; font-weight: 600; font-size: 1.05rem;">
                <i class="fas fa-save"></i>
                Enregistrer brouillon
            </button>
            <a href="{{ path('organisateur_promotions_index') }}" class="btn" style="color: var(--gray-600); text-decoration: none; padding: 16px 24px;">
                Annuler
            </a>
        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // ============================================
    // GÉNÉRATEUR DE CODE PROMO
    // ============================================
    window.generatePromoCode = function() {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let code = '';
        for (let i = 0; i < 8; i++) {
            code += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        document.querySelector('input[name="code"]').value = code;
        updatePreview();
    };

    // ============================================
    // CHANGEMENT TYPE DE RÉDUCTION
    // ============================================
    const discountTypeRadios = document.querySelectorAll('input[name="discount_type"]');
    const discountUnit = document.getElementById('discountUnit');
    const maxValue = document.getElementById('maxValue');
    const valueInput = document.querySelector('input[name="discount_value"]');
    
    discountTypeRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'percentage') {
                discountUnit.textContent = '%';
                maxValue.textContent = '100%';
                valueInput.max = 100;
            } else {
                discountUnit.textContent = '€';
                maxValue.textContent = '1000€';
                valueInput.max = 1000;
            }
            updatePreview();
        });
    });

    // ============================================
    // APERÇU EN TEMPS RÉEL
    // ============================================
    function updatePreview() {
        const code = document.querySelector('input[name="code"]').value || 'VOTRECODE';
        const description = document.querySelector('textarea[name="description"]').value || 'Description de votre promotion';
        const discountValue = document.querySelector('input[name="discount_value"]').value || '0';
        const discountType = document.querySelector('input[name="discount_type"]:checked').value;
        const endDate = document.querySelector('input[name="end_date"]').value;
        
        document.getElementById('previewCode').textContent = code;
        
        if (discountType === 'percentage') {
            document.getElementById('previewDiscount').textContent = `-${discountValue}%`;
        } else {
            document.getElementById('previewDiscount').textContent = `-${discountValue}€`;
        }
        
        document.getElementById('previewDescription').textContent = description;
        
        if (endDate) {
            const date = new Date(endDate);
            const options = { year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('previewValidity').textContent = 
                `Valide jusqu'au ${date.toLocaleDateString('fr-FR', options)}`;
        }
    }
    
    // Écouter les changements
    document.querySelector('input[name="code"]').addEventListener('input', updatePreview);
    document.querySelector('textarea[name="description"]').addEventListener('input', updatePreview);
    document.querySelector('input[name="discount_value"]').addEventListener('input', updatePreview);
    document.querySelector('input[name="end_date"]').addEventListener('input', updatePreview);

    // ============================================
    // CHECKBOX "TOUTES LES CATÉGORIES"
    // ============================================
    const allCategoriesCheck = document.querySelector('input[name="categories[]"][value="all"]');
    const categoryChecks = document.querySelectorAll('input[name="categories[]"]:not([value="all"])');
    
    allCategoriesCheck.addEventListener('change', function() {
        if (this.checked) {
            categoryChecks.forEach(check => check.checked = false);
        }
    });
    
    categoryChecks.forEach(check => {
        check.addEventListener('change', function() {
            if (this.checked) {
                allCategoriesCheck.checked = false;
            }
        });
    });
});
</script>

<style>
.promo-form {
    max-width: 1200px;
    margin: 0 auto;
}

.form-section {
    background: var(--white);
    border-radius: var(--border-radius-xl);
    padding: 32px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

.section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--gray-200);
}

.section-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--border-radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    flex-shrink: 0;
}

.section-header h2 {
    font-size: 1.4rem;
    font-weight: var(--font-weight-bold);
    color: var(--primary);
    margin: 0;
}

.section-header p {
    font-size: 0.95rem;
    color: var(--gray-600);
    margin: 4px 0 0 0;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.span-2 {
    grid-column: span 2;
}

.form-group label {
    font-size: 0.95rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    margin-bottom: 10px;
}

.required {
    color: var(--danger);
}

.form-control {
    padding: 14px 16px;
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    font-size: 1rem;
    font-family: var(--font-family);
    transition: var(--transition-base);
    background: var(--white);
}

.form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(52, 152, 219, 0.1);
}

.form-help {
    font-size: 0.85rem;
    color: var(--gray-600);
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.form-help i {
    color: var(--accent);
}

/* Input avec bouton générer */
.code-input-group {
    display: flex;
    gap: 12px;
}

.code-input {
    flex: 1;
}

.btn-generate {
    padding: 14px 24px;
    background: linear-gradient(135deg, #9B59B6, #8E44AD);
    color: white;
    border: none;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: var(--transition-base);
    white-space: nowrap;
}

.btn-generate:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(155, 89, 182, 0.3);
}

/* Sélecteur de type de réduction */
.discount-type-selector {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
}

.discount-card {
    position: relative;
    cursor: pointer;
}

.discount-card input {
    position: absolute;
    opacity: 0;
}

.discount-card-content {
    background: var(--white);
    border: 3px solid var(--gray-200);
    border-radius: var(--border-radius-lg);
    padding: 28px;
    text-align: center;
    transition: var(--transition-base);
    position: relative;
}

.discount-card:hover .discount-card-content {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
}

.discount-card input:checked + .discount-card-content {
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.05), rgba(52, 152, 219, 0.02));
    box-shadow: 0 4px 16px rgba(52, 152, 219, 0.2);
}

.discount-icon {
    width: 70px;
    height: 70px;
    border-radius: var(--border-radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 16px;
}

.discount-card-content h3 {
    font-size: 1.3rem;
    color: var(--primary);
    margin: 0 0 8px 0;
}

.discount-card-content p {
    font-size: 0.9rem;
    color: var(--gray-600);
    margin: 0;
}

.checkmark {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 1.5rem;
    color: var(--gray-300);
    transition: var(--transition-base);
}

.discount-card input:checked + .discount-card-content .checkmark {
    color: var(--accent);
}

/* Input avec unité */
.value-input-group {
    position: relative;
    display: flex;
    align-items: center;
}

.value-input {
    flex: 1;
    padding-right: 50px;
}

.value-unit {
    position: absolute;
    right: 16px;
    font-weight: var(--font-weight-bold);
    font-size: 1.1rem;
    color: var(--accent);
}

/* Checkbox group */
.checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.checkbox-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--gray-50);
    border-radius: var(--border-radius-md);
    border: 1px solid var(--gray-200);
    cursor: pointer;
    transition: var(--transition-base);
}

.checkbox-item:hover {
    background: white;
    border-color: var(--accent);
}

.checkbox-item input {
    width: 20px;
    height: 20px;
    cursor: pointer;
}

.checkbox-item span {
    font-size: 0.95rem;
    color: var(--gray-700);
    font-weight: var(--font-weight-medium);
}

/* Aperçu de la promotion */
.promo-preview {
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    border-radius: var(--border-radius-xl);
    padding: 32px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-lg);
}

.preview-header {
    color: white;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0.95;
}

.preview-card {
    background: white;
    border-radius: var(--border-radius-lg);
    padding: 32px;
    text-align: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
}

.preview-code {
    font-family: 'Courier New', monospace;
    font-size: 2.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--primary);
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 16px;
}

.preview-discount {
    font-size: 3rem;
    font-weight: var(--font-weight-bold);
    color: var(--success);
    margin-bottom: 12px;
}

.preview-description {
    font-size: 1.1rem;
    color: var(--gray-700);
    margin-bottom: 20px;
    padding: 0 20px;
}

.preview-validity {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--gray-100);
    border-radius: 20px;
    font-size: 0.9rem;
    color: var(--gray-700);
}

.preview-validity i {
    color: var(--accent);
}

.form-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 28px;
    background: var(--white);
    border-radius: var(--border-radius-xl);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

@media (max-width: 992px) {
    .discount-type-selector {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    
    .form-group.span-2 {
        grid-column: span 1;
    }
    
    .code-input-group {
        flex-direction: column;
    }
    
    .form-actions {
        flex-direction: column;
    }
    
    .form-actions button,
    .form-actions a {
        width: 100%;
        text-align: center;
        justify-content: center;
    }
    
    .preview-code {
        font-size: 1.8rem;
    }
    
    .preview-discount {
        font-size: 2.2rem;
    }
}
</style>
{% endblock %}
