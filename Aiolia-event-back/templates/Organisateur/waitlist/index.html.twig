    font-size: 1.3rem;
    margin-top: 2px;
    flex-shrink: 0;
}

.reject-info-box p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
}

.reject-warning {
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.1), rgba(231, 76, 60, 0.05));
    border: 2px solid rgba(231, 76, 60, 0.3);
    border-left: 4px solid var(--danger);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
}

.reject-warning i {
    color: var(--danger);
    font-size: 1.5rem;
    margin-top: 2px;
    flex-shrink: 0;
}

.reject-warning strong {
    display: block;
    color: var(--danger);
    font-size: 1rem;
    margin-bottom: 8px;
    font-weight: var(--font-weight-semibold);
}

.reject-warning p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
}

.alert.alert-success {
    padding: 16px 20px;
    margin-bottom: 20px;
    background: linear-gradient(135deg, var(--success), #27AE60);
    color: white;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: var(--font-weight-medium);
    animation: slideDown 0.3s ease;
}

.alert.alert-success i {
    font-size: 1.2rem;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-footer {
    padding: 24px 32px;
    border-top: 2px solid var(--border-color);
    display: flex !important;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-secondary) 100%);
    flex-wrap: wrap;
    visibility: visible !important;
    flex-shrink: 0;
}

.modal-footer button {
    display: inline-flex !important;
    visibility: visible !important;
    opacity: 1 !important;
}

.btn-modal {
    padding: 10px 20px;
    border: none;
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.95rem;
    min-width: 120px;
    text-align: center;
    white-space: nowrap;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    visibility: visible !important;
    opacity: 1 !important;
}

.btn-modal-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.btn-modal-secondary:hover {
    background: var(--gray-100);
}

.btn-modal-primary {
    background: linear-gradient(135deg, #5DADE2 0%, #3498DB 100%) !important;
    color: white !important;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
}

.btn-modal-primary:hover:not(:disabled) {
    background: linear-gradient(135deg, #3498DB 0%, #2980B9 100%) !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    color: white !important;
}

.btn-modal-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Fonction pour ouvrir le modal de traitement de liste d'attente
function openEditQuantityModal(userId, eventId, categoriesSegments, userName, eventTitle) {
    try {
        const modal = document.getElementById('editQuantityModal');
        if (!modal) {
            console.error('Modal non trouvé');
            return;
        }
        
        const form = document.getElementById('editQuantityForm');
        const typeBilletSelect = document.getElementById('typeBilletSelect');
        const quantiteInput = document.getElementById('quantiteTotale');
        const prixInput = document.getElementById('prixDeBase');
        const userIdInput = document.getElementById('userId');
        const eventIdInput = document.getElementById('eventId');
        const minQuantiteSpan = document.getElementById('minQuantite');
        const quantiteDemandeeSpan = document.getElementById('quantiteDemandee');
        const userInfoDisplay = document.getElementById('userInfoDisplay');
        const eventInfoDisplay = document.getElementById('eventInfoDisplay');

        if (!form || !typeBilletSelect || !quantiteInput || !prixInput || !userIdInput || !userInfoDisplay || !eventInfoDisplay) {
            console.error('Éléments du formulaire non trouvés');
            return;
        }

        // Clear previous success messages
        const oldSuccessMessage = document.querySelector('#quantityModalBody .alert-success');
        if (oldSuccessMessage) {
            oldSuccessMessage.remove();
        }

        // Set context info
        userInfoDisplay.textContent = userName || `Utilisateur #${userId}`;
        eventInfoDisplay.textContent = eventTitle || (eventId ? `Événement #${eventId}` : '-');

        // Réinitialiser le formulaire
        userIdInput.value = userId;
        eventIdInput.value = eventId || '';
        typeBilletSelect.innerHTML = '<option value="">Sélectionner une catégorie/segment</option>';
        quantiteInput.value = '';
        prixInput.value = '';
        quantiteInput.disabled = true;
        prixInput.disabled = true;
        
        // Remplir le sélecteur avec les catégories/segments
        let categories;
        try {
            categories = typeof categoriesSegments === 'string' ? JSON.parse(categoriesSegments) : categoriesSegments;
        } catch (e) {
            console.error('Erreur lors du parsing JSON:', e);
            alert('Erreur: Format de données invalide');
            return;
        }
    categories.forEach(function(detail) {
        const option = document.createElement('option');
        option.value = detail.typeBilletId;
        const ageText = detail.ageMin !== null || detail.ageMax !== null 
            ? ` (${detail.ageMin !== null ? detail.ageMin : ''}${detail.ageMin !== null && detail.ageMax !== null ? '-' : ''}${detail.ageMax !== null ? detail.ageMax : ''} ans)`
            : '';
        option.textContent = `${detail.categorie} - ${detail.segment}${ageText}`;
        option.dataset.quantiteTotale = detail.quantiteTotale || 0;
        option.dataset.quantiteVendue = detail.quantiteVendue || 0;
        option.dataset.quantiteReservee = detail.quantiteReservee || 0;
        option.dataset.quantiteAttente = detail.quantiteAttente || 0;
        option.dataset.prixDeBase = detail.prixDeBase || 0;
        typeBilletSelect.appendChild(option);
    });
    
    // Fonction de gestion du changement de sélection
    function handleTypeBilletChange() {
        const selectedOption = typeBilletSelect.options[typeBilletSelect.selectedIndex];
        if (selectedOption.value) {
            const quantiteTotale = parseInt(selectedOption.dataset.quantiteTotale) || 0;
            const quantiteVendue = parseInt(selectedOption.dataset.quantiteVendue) || 0;
            const quantiteAttente = parseInt(selectedOption.dataset.quantiteAttente) || 0;
            const prixDeBase = parseFloat(selectedOption.dataset.prixDeBase) || 0;
            
            quantiteInput.value = quantiteTotale;
            quantiteInput.min = quantiteVendue + quantiteAttente;
            quantiteInput.disabled = false;
            minQuantiteSpan.textContent = quantiteVendue;
            quantiteDemandeeSpan.textContent = quantiteAttente;
            
            // Calculer et afficher la quantité minimale requise
            const quantiteMinimale = quantiteVendue + quantiteAttente;
            const quantiteMinimaleSpan = document.getElementById('quantiteMinimale');
            if (quantiteMinimaleSpan) {
                quantiteMinimaleSpan.textContent = quantiteMinimale;
            }
            
            prixInput.value = prixDeBase;
            prixInput.disabled = false;
        } else {
            quantiteInput.value = '';
            prixInput.value = '';
            quantiteInput.disabled = true;
            prixInput.disabled = true;
        }
    }
    
    // Retirer l'ancien écouteur s'il existe
    typeBilletSelect.removeEventListener('change', handleTypeBilletChange);
    // Ajouter le nouvel écouteur
    typeBilletSelect.addEventListener('change', handleTypeBilletChange);
    
    // Réinitialiser les erreurs
    document.getElementById('quantiteError').textContent = '';
    document.getElementById('prixError').textContent = '';
    document.getElementById('typeBilletError').textContent = '';
    quantiteInput.classList.remove('error');
    prixInput.classList.remove('error');
    typeBilletSelect.classList.remove('error');
    
        modal.classList.add('active');
        
        // S'assurer que les boutons sont visibles
        const acceptBtn = document.getElementById('acceptBtn');
        const rejectBtn = document.getElementById('rejectBtn');
        if (acceptBtn) {
            acceptBtn.style.display = 'inline-flex';
            acceptBtn.style.visibility = 'visible';
        }
        if (rejectBtn) {
            rejectBtn.style.display = 'inline-flex';
            rejectBtn.style.visibility = 'visible';
        }
    } catch (error) {
        console.error('Erreur dans openEditQuantityModal:', error);
        alert('Erreur lors de l\'ouverture du modal: ' + error.message);
    }
}

// Fermer le modal
document.getElementById('closeQuantityModal').addEventListener('click', function() {
    closeQuantityModal();
});

document.getElementById('cancelQuantityBtn').addEventListener('click', function() {
    closeQuantityModal();
});

document.getElementById('editQuantityModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeQuantityModal();
    }
});

// Fermer avec Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeQuantityModal();
    }
});

function closeQuantityModal() {
    const modal = document.getElementById('editQuantityModal');
    modal.classList.remove('active');
    // Réinitialiser le formulaire
    document.getElementById('editQuantityForm').reset();
    document.getElementById('quantiteTotale').disabled = true;
    document.getElementById('quantiteError').textContent = '';
    document.getElementById('typeBilletError').textContent = '';
    document.getElementById('quantiteTotale').classList.remove('error');
    document.getElementById('typeBilletSelect').classList.remove('error');
}

// Fonction pour valider le formulaire
function validateForm() {
    const form = document.getElementById('editQuantityForm');
    const formData = new FormData(form);
    const typeBilletId = formData.get('typeBilletId');
    const quantiteTotale = formData.get('quantiteTotale');
    const prixDeBase = formData.get('prixDeBase');
    const typeBilletSelect = document.getElementById('typeBilletSelect');
    const quantiteInput = document.getElementById('quantiteTotale');
    const prixInput = document.getElementById('prixDeBase');
    
    let hasError = false;
    
    if (!typeBilletId) {
        document.getElementById('typeBilletError').textContent = 'Veuillez sélectionner une catégorie/segment';
        typeBilletSelect.classList.add('error');
        hasError = true;
    } else {
        document.getElementById('typeBilletError').textContent = '';
        typeBilletSelect.classList.remove('error');
    }
    
    if (!prixDeBase || parseFloat(prixDeBase) < 0) {
        document.getElementById('prixError').textContent = 'Le prix doit être supérieur ou égal à 0';
        prixInput.classList.add('error');
        hasError = true;
    } else {
        document.getElementById('prixError').textContent = '';
        prixInput.classList.remove('error');
    }
    
    const selectedOption = typeBilletSelect.options[typeBilletSelect.selectedIndex];
    const quantiteVendue = selectedOption ? parseInt(selectedOption.dataset.quantiteVendue) || 0 : 0;
    const quantiteAttente = selectedOption ? parseInt(selectedOption.dataset.quantiteAttente) || 0 : 0;
    const quantiteMinimale = quantiteVendue + quantiteAttente;
    
    if (!quantiteTotale || parseInt(quantiteTotale) < quantiteMinimale) {
        document.getElementById('quantiteError').textContent = `La quantité doit être supérieure ou égale à ${quantiteMinimale} (${quantiteVendue} déjà vendus + ${quantiteAttente} demandés en liste d'attente)`;
        quantiteInput.classList.add('error');
        hasError = true;
    } else {
        document.getElementById('quantiteError').textContent = '';
        quantiteInput.classList.remove('error');
    }
    
    return !hasError;
}

// Fonction pour envoyer la requête d'acceptation ou de rejet
function processWaitlistRequest(action) {
    // Pour l'acceptation, valider le formulaire
    if (action === 'accept' && !validateForm()) {
        return;
    }
    
    const form = document.getElementById('editQuantityForm');
    const formData = new FormData(form);
    const typeBilletId = formData.get('typeBilletId');
    const quantiteTotale = formData.get('quantiteTotale');
    const prixDeBase = formData.get('prixDeBase');
    const userId = formData.get('userId');
    const eventId = formData.get('eventId');
    
    // Pour le rejet, on a besoin au moins du typeBilletId et userId
    if (action === 'reject' && (!typeBilletId || !userId)) {
        alert('Veuillez sélectionner une catégorie/segment avant de rejeter.');
        return;
    }
    
    const acceptBtn = document.getElementById('acceptBtn');
    const rejectBtn = document.getElementById('rejectBtn');
    
    // Désactiver les boutons
    acceptBtn.disabled = true;
    rejectBtn.disabled = true;
    const originalAcceptText = acceptBtn.innerHTML;
    const originalRejectText = rejectBtn.innerHTML;
    
    if (action === 'accept') {
        acceptBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Traitement...';
    } else {
        rejectBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Traitement...';
    }
    
    // Préparer les données à envoyer
    const requestData = {
        action: action,
        eventId: eventId
    };
    
    // Pour l'acceptation, inclure prix et quantité
    if (action === 'accept') {
        requestData.quantiteTotale = quantiteTotale;
        requestData.prixDeBase = prixDeBase;
    }
    
    // Envoyer la requête
    fetch(`/organisateur/waitlist/process/${userId}/${typeBilletId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(requestData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Afficher un message de succès
            const successMessage = document.createElement('div');
            successMessage.className = 'alert alert-success';
            successMessage.style.cssText = 'padding: 16px 20px; margin-bottom: 20px; background: linear-gradient(135deg, var(--success), #27AE60); color: white; border-radius: 12px; box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3); display: flex; align-items: center; gap: 12px; font-weight: var(--font-weight-medium);';
            successMessage.innerHTML = `<i class="fas fa-check-circle" style="font-size: 1.2rem;"></i> <span>${data.message}</span>`;
            
            // Insérer le message au début du modal-body de manière sûre
            const modalBody = document.getElementById('quantityModalBody');
            if (modalBody) {
                // Supprimer les anciens messages de succès s'ils existent
                const existingMessages = modalBody.querySelectorAll('.alert.alert-success');
                existingMessages.forEach(msg => {
                    if (msg && msg.parentNode) {
                        msg.remove();
                    }
                });
                
                // Utiliser insertAdjacentElement qui est plus sûr et ne nécessite pas que l'élément soit un enfant
                try {
                    modalBody.insertAdjacentElement('afterbegin', successMessage);
                } catch (error) {
                    console.error('Erreur lors de l\'insertion du message:', error);
                    // En dernier recours, utiliser prepend ou appendChild
                    if (typeof modalBody.prepend === 'function') {
                        modalBody.prepend(successMessage);
                    } else {
                        modalBody.appendChild(successMessage);
                    }
                }
            }
            
            // Fermer le modal après 1.5 secondes et recharger la page
            setTimeout(() => {
                document.getElementById('editQuantityModal').classList.remove('active');
                window.location.reload();
            }, 1500);
        } else {
            // Afficher l'erreur
            if (data.errors) {
                if (data.errors.quantiteTotale) {
                    document.getElementById('quantiteError').textContent = data.errors.quantiteTotale;
                    document.getElementById('quantiteTotale').classList.add('error');
                }
                if (data.errors.prixDeBase) {
                    document.getElementById('prixError').textContent = data.errors.prixDeBase;
                    document.getElementById('prixDeBase').classList.add('error');
                }
                if (data.errors.typeBilletId) {
                    document.getElementById('typeBilletError').textContent = data.errors.typeBilletId;
                    document.getElementById('typeBilletSelect').classList.add('error');
                }
            } else {
                const errorField = 'quantiteError';
                document.getElementById(errorField).textContent = data.message || 'Une erreur est survenue';
                document.getElementById('quantiteTotale').classList.add('error');
            }
            acceptBtn.disabled = false;
            rejectBtn.disabled = false;
            acceptBtn.innerHTML = originalAcceptText;
            rejectBtn.innerHTML = originalRejectText;
        }
    })
    .catch(error => {
        console.error('Erreur:', error);
        document.getElementById('quantiteError').textContent = 'Une erreur est survenue lors du traitement';
        acceptBtn.disabled = false;
        rejectBtn.disabled = false;
        acceptBtn.innerHTML = originalAcceptText;
        rejectBtn.innerHTML = originalRejectText;
    });
}

// Gestionnaires de clic pour les boutons - Définis globalement
window.handleAcceptClick = function(event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }
    const btn = document.getElementById('acceptBtn');
    if (btn && !btn.disabled) {
        processWaitlistRequest('accept');
    }
    return false;
};

window.handleRejectClick = function(event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }
    const btn = document.getElementById('rejectBtn');
    if (btn && !btn.disabled) {
        if (confirm('Êtes-vous sûr de vouloir rejeter cette demande de liste d\'attente ? Un email de rejet sera envoyé à l\'utilisateur.')) {
            processWaitlistRequest('reject');
        }
    }
    return false;
};

// Fonction globale pour gérer le clic sur le bouton modifier
window.handleEditClick = function(button) {
    try {
        const userId = button.getAttribute('data-user-id');
        const eventId = button.getAttribute('data-event-id') || '';
        const userName = button.getAttribute('data-user-name') || '';
        const eventTitle = button.getAttribute('data-event-title') || '';
        const categoriesJson = button.getAttribute('data-categories');
        
        if (!userId || !categoriesJson) {
            console.error('Données manquantes pour ouvrir le modal');
            alert('Erreur: Données manquantes');
            return;
        }
        
        openEditQuantityModal(userId, eventId, categoriesJson, userName, eventTitle);
    } catch (error) {
        console.error('Erreur lors de l\'ouverture du modal:', error);
        alert('Erreur lors de l\'ouverture du modal');
    }
};
</script>
{% endblock %}
