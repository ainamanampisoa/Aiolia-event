{% extends 'base.html.twig' %}

{% block title %}{{ isEditMode|default(false) ? 'Modifier l\'événement' : 'Créer un événement' }} - Aiolia Event{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
/* Styles globaux */
.event-form {
    max-width: 1200px;
    margin: 0 auto;
}

.form-section {
    background: var(--white);
    border-radius: var(--border-radius-xl);
    padding: 28px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

/* Masquer la section Informations principales en mode édition */
[data-edit-mode="true"] #section-informations-principales {
    display: none !important;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--gray-200);
}

.section-icon {
    width: 50px;
    height: 50px;
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.section-header h2 {
    font-size: 1.3rem;
    font-weight: var(--font-weight-bold);
    color: var(--primary);
    margin: 0;
}

.section-header p {
    font-size: 0.9rem;
    color: var(--gray-600);
    margin: 4px 0 0 0;
}

/* Layout du formulaire */
.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.span-2 {
    grid-column: span 2;
}

/* Labels et champs */
.form-group label {
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
}

.required {
    color: #e74c3c !important;
    font-weight: bold !important;
    font-size: 1.2em !important;
    margin-left: 3px !important;
    display: inline-block !important;
    vertical-align: middle !important;
    line-height: 1 !important;
}

.form-control {
    padding: 12px 14px;
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    font-size: 0.95rem;
    font-family: var(--font-family);
    transition: var(--transition-base);
    background: var(--white);
}

.form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.form-group .invalid-feedback,
.form-group .form-error-message,
.form-group .field-error {
    display: inline-flex;
    align-items: center;
    margin-left: 12px;
    margin-top: 0;
    color: var(--danger);
    font-size: 0.9rem;
    white-space: nowrap;
}

.form-help {
    font-size: 0.8rem;
    color: var(--gray-600);
    margin-top: 6px;
}

/* Sélecteurs visuels */
.tags-selector,
.payment-selector,
.accessibility-selector {
    background: var(--white);
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    padding: 16px;
}

.tags-grid,
.accessibility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
}

.payment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
}

.tag-option,
.accessibility-option {
    cursor: pointer;
}

.payment-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.tag-option input,
.accessibility-option input {
    display: none;
}

.tag-card,
.accessibility-card {
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    padding: 12px;
    text-align: center;
    transition: var(--transition-base);
    background: var(--white);
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.payment-card {
    background: var(--white);
    border: 1px solid var(--gray-300);
    border-radius: 8px;
    padding: 20px 16px;
    width: 100%;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    transition: var(--transition-base);
}

.payment-card-mvola {
    background: var(--white);
    border: 1px solid var(--gray-300);
}

.tag-card:hover,
.payment-card:hover,
.accessibility-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.tag-option input:checked + .tag-card,
.accessibility-option input:checked + .accessibility-card {
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(52, 152, 219, 0.05));
    box-shadow: 0 4px 12px rgba(52, 152, 219, 0.2);
}

.payment-option:has(.payment-checkbox:checked) .payment-card {
    border-color: var(--accent);
    background: var(--white);
    box-shadow: 0 2px 8px rgba(52, 152, 219, 0.2);
}

.payment-option:has(.payment-checkbox:checked) .payment-card-mvola {
    background: var(--white);
    border-color: var(--accent);
}

.tag-icon,
.payment-icon,
.accessibility-icon {
    font-size: 2rem;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.accessibility-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
}

.payment-icon {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 80px;
}

.payment-icon img {
    max-width: 100%;
    max-height: 80px;
    width: auto;
    height: auto;
    object-fit: contain;
}

.payment-icon:not(:has(img)) {
    font-size: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.payment-label {
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-800);
    text-align: center;
    width: 100%;
    margin: 0;
    flex-shrink: 0;
}

.payment-checkbox-label {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-top: 0;
    flex-shrink: 0;
}

.payment-checkbox {
    display: none;
}

.payment-checkbox-custom {
    width: 20px;
    height: 20px;
    border: 2px solid var(--gray-400);
    border-radius: 4px;
    background: var(--gray-100);
    display: inline-block;
    position: relative;
    transition: all 0.2s ease;
}

.payment-checkbox:checked + .payment-checkbox-custom {
    background: var(--accent);
    border-color: var(--accent);
}

.payment-checkbox:checked + .payment-checkbox-custom::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-size: 12px;
    font-weight: bold;
}

.accessibility-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.accessibility-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.accessibility-card {
    text-align: center;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    min-height: 100px;
}

.accessibility-info {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.accessibility-title {
    font-weight: var(--font-weight-semibold);
    color: var(--gray-800);
    display: block;
    font-size: 0.9rem;
    text-align: center;
}

.checkbox-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-weight: var(--font-weight-medium);
}

.checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

/* Upload de fichiers */
.file-upload-area {
    border: 2px dashed var(--gray-300);
    border-radius: var(--border-radius-md);
    padding: 32px;
    text-align: center;
    background: var(--gray-50);
    cursor: pointer;
    transition: var(--transition-base);
}

.file-upload-area:hover {
    border-color: var(--accent);
    background: rgba(52, 152, 219, 0.05);
}

.upload-icon {
    font-size: 3rem;
    color: var(--gray-400);
    margin-bottom: 12px;
}

.upload-text {
    font-size: 1rem;
    color: var(--gray-700);
    margin-bottom: 6px;
}

.upload-info {
    font-size: 0.85rem;
    color: var(--gray-500);
}

.file-input {
    display: none;
}

.image-preview, .gallery-preview {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
    margin-top: 16px;
}

.preview-image {
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    aspect-ratio: 1;
}

.preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.remove-image {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--danger);
    color: white;
    border: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    transition: var(--transition-base);
}

.remove-image:hover {
    opacity: 1;
    transform: scale(1.1);
}

/* Catégories de billets */
.ticket-category {
    background: var(--gray-50);
    border-radius: var(--border-radius-md);
    padding: 20px;
    margin-bottom: 16px;
    border: 1px solid var(--gray-200);
}

.ticket-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.ticket-header h3 {
    font-size: 1.1rem;
    color: var(--primary);
    margin: 0;
}

.btn-remove-ticket {
    background: var(--danger);
    color: white;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-base);
}

.btn-remove-ticket:hover {
    background: #c0392b;
    transform: scale(1.1);
}

.btn-add-ticket {
    width: 100%;
    padding: 14px;
    background: white;
    border: 2px dashed var(--accent);
    color: var(--accent);
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: var(--transition-base);
}

.btn-add-ticket:hover {
    background: rgba(52, 152, 219, 0.05);
    border-color: var(--accent-light);
}

/* Paramètres de vente des billets */
.ticket-sales-settings {
    margin-top: 24px;
    padding: 28px;
    background: var(--white);
    border-radius: var(--border-radius-xl);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

.ticket-sales-settings .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.ticket-sales-settings .form-group {
    margin-bottom: 0;
}

/* Sélecteur de lieu */
.venue-select-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.venue-select-row {
    display: flex;
    gap: 12px;
    align-items: flex-start;
}

.venue-select-row select {
    flex: 1;
}

.btn-create-venue {
    background: linear-gradient(135deg, #27AE60, #2ECC71);
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(39, 174, 96, 0.3);
    transition: all 0.3s ease;
    flex-shrink: 0;
}

.btn-create-venue:hover {
    background: linear-gradient(135deg, #229954, #27AE60);
    box-shadow: 0 4px 12px rgba(39, 174, 96, 0.4);
    transform: translateY(-2px);
    color: white;
}

/* Actions du formulaire */
.form-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 24px;
    background: var(--white);
    border-radius: var(--border-radius-xl);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

.btn-primary {
    background: linear-gradient(135deg, #3498DB, #5DADE2) !important;
    color: white;
    border: none;
    padding: 14px 32px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-secondary {
    background: white;
    color: var(--gray-700);
    border: 2px solid var(--gray-300);
    padding: 14px 32px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-text {
    color: var(--gray-600);
    text-decoration: none;
    padding: 14px 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.datetime-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    align-items: center;
}

.datetime-split .time-only {
    max-width: 130px;
    height: 46px;
    appearance: auto;
    -webkit-appearance: auto;
    -moz-appearance: auto;
    text-align: center;
    font-size: 1rem;
    padding: 10px 8px;
}

/* Responsive */
@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    
    .form-group.span-2 {
        grid-column: span 1;
    }
    
    .tags-grid,
    .payment-grid,
    .accessibility-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .form-actions {
        flex-direction: column;
    }
    
    .form-actions button,
    .form-actions a {
        width: 100%;
        text-align: center;
        justify-content: center;
    }
    
    .payment-card {
        min-height: 120px;
        padding: 16px 12px;
        gap: 10px;
    }
    
    .payment-icon img {
        max-height: 60px;
    }
    
    .payment-icon:not(:has(img)) {
        font-size: 3rem;
    }
    
    .payment-label {
        font-size: 0.85rem;
    }
    
    .venue-select-row {
        flex-direction: column;
    }
    
    .btn-create-venue {
        width: 100%;
        justify-content: center;
    }
    
    .accessibility-card {
        flex-direction: column;
        text-align: center;
        gap: 8px;
        min-height: 90px;
    }
    
    .accessibility-logo {
        width: 40px;
        height: 40px;
    }
}

@media (max-width: 480px) {
    .tags-grid,
    .payment-grid,
    .accessibility-grid {
        grid-template-columns: 1fr;
    }
}

/* Notifications Toast */
.toast-notification {
    position: fixed;
    top: 24px;
    right: 24px;
    min-width: 380px;
    max-width: 520px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12), 0 4px 8px rgba(0, 0, 0, 0.08);
    padding: 0;
    display: flex;
    align-items: stretch;
    z-index: 10000;
    transform: translateX(calc(100% + 50px));
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
}

.toast-notification.show {
    transform: translateX(0);
    opacity: 1;
}

.toast-notification::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: #e74c3c;
    z-index: 1;
}

.toast-notification.toast-error::before {
    background: linear-gradient(180deg, #e74c3c 0%, #c0392b 100%);
}

.toast-notification.toast-warning::before {
    background: linear-gradient(180deg, #f39c12 0%, #e67e22 100%);
}

.toast-notification.toast-info::before {
    background: linear-gradient(180deg, #3498db 0%, #2980b9 100%);
}

.toast-notification.toast-success::before {
    background: linear-gradient(180deg, #27ae60 0%, #229954 100%);
}

.toast-icon-wrapper {
    width: 56px;
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.08), rgba(231, 76, 60, 0.03));
    padding: 20px 16px;
}

.toast-notification.toast-error .toast-icon-wrapper {
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.12), rgba(231, 76, 60, 0.05));
}

.toast-notification.toast-warning .toast-icon-wrapper {
    background: linear-gradient(135deg, rgba(243, 156, 18, 0.12), rgba(243, 156, 18, 0.05));
}

.toast-notification.toast-info .toast-icon-wrapper {
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.12), rgba(52, 152, 219, 0.05));
}

.toast-notification.toast-success .toast-icon-wrapper {
    background: linear-gradient(135deg, rgba(39, 174, 96, 0.12), rgba(39, 174, 96, 0.05));
}

.toast-icon-wrapper i {
    font-size: 1.75rem;
    color: #e74c3c;
}

.toast-notification.toast-error .toast-icon-wrapper i {
    color: #e74c3c;
}

.toast-notification.toast-warning .toast-icon-wrapper i {
    color: #f39c12;
}

.toast-notification.toast-info .toast-icon-wrapper i {
    color: #3498db;
}

.toast-notification.toast-success .toast-icon-wrapper i {
    color: #27ae60;
}

.toast-content {
    flex: 1;
    padding: 20px 20px 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 80px;
    justify-content: center;
}

.toast-title {
    font-size: 1rem;
    font-weight: 700;
    color: #2c3e50;
    line-height: 1.4;
    margin: 0;
    letter-spacing: -0.01em;
}

.toast-message {
    font-size: 0.9rem;
    color: #5a6c7d;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
}

.toast-message strong {
    color: #2c3e50;
    font-weight: 600;
}

.toast-message br {
    line-height: 1.8;
}

.toast-close {
    background: transparent;
    border: none;
    color: #95a5a6;
    cursor: pointer;
    padding: 12px 16px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    border-radius: 0 16px 0 0;
    transition: all 0.2s ease;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin-top: 8px;
    margin-right: 4px;
}

.toast-close:hover {
    background: rgba(0, 0, 0, 0.04);
    color: #7f8c8d;
}

.toast-close i {
    font-size: 0.9rem;
}

@media (max-width: 768px) {
    .toast-notification {
        right: 12px;
        left: 12px;
        min-width: auto;
        max-width: none;
        transform: translateY(-120px);
        top: 16px;
    }
    
    .toast-notification.show {
        transform: translateY(0);
    }
    
    .toast-icon-wrapper {
        width: 48px;
        padding: 16px 12px;
    }
    
    .toast-icon-wrapper i {
        font-size: 1.5rem;
    }
    
    .toast-content {
        padding: 16px 16px 16px 12px;
        min-height: 72px;
    }
    
    .toast-title {
        font-size: 0.95rem;
    }
    
    .toast-message {
        font-size: 0.85rem;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="dashboard" {% if isEditMode is defined and isEditMode %}data-edit-mode="true"{% endif %}>
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1>
                {% if isEditMode|default(false) %}
                    <i class="fa-solid fa-pen"></i> Modifier l'événement
                {% else %}
                    <i class="fa-solid fa-circle-plus"></i> Créer un nouvel événement
                {% endif %}
            </h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                {{ isEditMode|default(false) ? 'Modifiez les informations de votre événement' : 'Remplissez les informations pour créer votre événement' }}
            </p>
        </div>
        <div class="header-actions">
            <a href="{{ path('organisateur_events_index') }}" class="btn btn-secondary" style="background: white; color: var(--gray-700); border: 2px solid var(--gray-300); padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-arrow-left"></i>
                Retour
            </a>
        </div>
    </div>

    {{ form_start(form, {'attr': {'class': 'event-form', 'enctype': 'multipart/form-data'}}) }}
        <!-- Section 1: Informations principales (masquée en mode édition) -->
        {% if not (isEditMode is defined and isEditMode) %}
        <div class="form-section" id="section-informations-principales">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div>
                    <h2>Informations principales</h2>
                    <p>Les détails essentiels de votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Nom de l'événement <span class="required">*</span></label>
                    {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Concert Rock Nation 2025', 'required': 'required'}}) }}
                    {{ form_errors(form.titre) }}
                    <small class="form-help">Un nom accrocheur et descriptif</small>
                </div>

                <div class="form-group">
                    <label>Catégorie <span class="required">*</span></label>
                    {{ form_widget(form.categoriePrincipale, {'attr': {'class': 'form-control', 'required': 'required'}}) }}
                    {{ form_errors(form.categoriePrincipale) }}
                </div>

                <div class="form-group">
                    <label>Type d'événement</label>
                    {{ form_widget(form.typeEvenement, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.typeEvenement) }}
                </div>

                <div class="form-group span-2">
                    <label>Résumé <span class="required">*</span></label>
                    {{ form_widget(form.resume, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Résumé court de l\'événement (max 500 caractères)', 'maxlength': 500}}) }}
                    {{ form_errors(form.resume) }}
                    <small class="form-help"><span id="charCount">0</span>/500 caractères</small>
                </div>

                <div class="form-group span-2">
                    <label>Description complète</label>
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 6, 'placeholder': 'Décrivez votre événement en détail...'}}) }}
                    {{ form_errors(form.description) }}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Section 2: Date et lieu -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(39, 174, 96, 0.15), rgba(39, 174, 96, 0.05)); color: var(--success);">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div>
                    <h2>Date et lieu</h2>
                    <p>Quand et où se déroulera votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Date de début <span class="required">*</span></label>
                    <div class="datetime-split">
                        <input type="text" name="date_start_date" class="form-control date-only date-start-date" placeholder="jj/mm/aaaa" 
                               value="{{ (isEditMode is defined and isEditMode) and event.commenceLe ? event.commenceLe|date('d/m/Y') : '' }}" required>
                        <input type="time" name="date_start_time" class="form-control time-only date-start-time" placeholder="hh:mm" step="60" 
                               value="{{ (isEditMode is defined and isEditMode) and event.commenceLe ? event.commenceLe|date('H:i') : '' }}" required>
                        <input type="hidden" name="date_start" required>
                    </div>
                </div>

                <div class="form-group">
                    <label>Date de fin</label>
                    <div class="datetime-split">
                        <input type="text" name="date_end_date" class="form-control date-only date-end-date" placeholder="jj/mm/aaaa"
                               value="{{ (isEditMode is defined and isEditMode) and event.seTermineLe ? event.seTermineLe|date('d/m/Y') : '' }}">
                        <input type="time" name="date_end_time" class="form-control time-only date-end-time" placeholder="hh:mm" step="60"
                               value="{{ (isEditMode is defined and isEditMode) and event.seTermineLe ? event.seTermineLe|date('H:i') : '' }}">
                        <input type="hidden" name="date_end">
                    </div>
                </div>

                <div class="form-group span-2">
                    <label>Lieu <span class="required">*</span></label>
                    <div class="venue-select-wrapper">
                        <div class="venue-select-row">
                            <select name="venue_id" id="venueSelect" class="form-control" required>
                                <option value="">Sélectionner un lieu...</option>
                                {% for venue in venues %}
                                    <option value="{{ venue.id }}" {% if (isEditMode is defined and isEditMode) and event.lieu and event.lieu.id == venue.id %}selected{% elseif selectedVenueId is defined and selectedVenueId == venue.id %}selected{% endif %}>
                                        {{ venue.nom ?? venue.name ?? venue.label ?? ('Lieu #' ~ venue.id) }}
                                    </option>
                                {% endfor %}
                            </select>
                            <a href="{{ path('organisateur_venues_new', {'return_to': 'events_new'}) }}" class="btn-create-venue" title="Créer un nouveau lieu">
                                <i class="fas fa-plus-circle"></i>
                                <span>Créer un lieu</span>
                            </a>
                        </div>
                        <small class="form-help">Choisissez un lieu existant ou créez-en un nouveau</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: Tags et Classification -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.15), rgba(155, 89, 182, 0.05)); color: #9B59B6;">
                    <i class="fas fa-tags"></i>
                </div>
                <div>
                    <h2>Tags et Classification</h2>
                    <p>Catégorisez votre événement pour une meilleure découverte</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Tags <span class="required">*</span></label>
                    <div class="tags-selector">
                        <div class="tags-grid">
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="musique">
                                <div class="tag-card">
                                    <div class="tag-icon">🎵</div>
                                    <span>Musique Live</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="danse">
                                <div class="tag-card">
                                    <div class="tag-icon">💃</div>
                                    <span>Danse</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="gastronomie">
                                <div class="tag-card">
                                    <div class="tag-icon">🍽️</div>
                                    <span>Gastronomie</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="art">
                                <div class="tag-card">
                                    <div class="tag-icon">🎨</div>
                                    <span>Art</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="technologie">
                                <div class="tag-card">
                                    <div class="tag-icon">💻</div>
                                    <span>Technologie</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="sport">
                                <div class="tag-card">
                                    <div class="tag-icon">⚽</div>
                                    <span>Sport</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="famille">
                                <div class="tag-card">
                                    <div class="tag-icon">👨‍👩‍👧‍👦</div>
                                    <span>Famille</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="business">
                                <div class="tag-card">
                                    <div class="tag-icon">💼</div>
                                    <span>Business</span>
                                </div>
                            </label>
                        </div>
                    </div>
                    <small class="form-help">Sélectionnez les tags qui correspondent à votre événement</small>
                </div>
            </div>
        </div>

        <!-- Section 4: Médias -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.15), rgba(155, 89, 182, 0.05)); color: #9B59B6;">
                    <i class="fas fa-image"></i>
                </div>
                <div>
                    <h2>Images et médias</h2>
                    <p>Ajoutez des visuels attractifs pour votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Image principale <span class="required">*</span></label>
                    <div class="file-upload-area" id="imageUpload">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <div class="upload-text">
                            <strong>Cliquez pour uploader</strong> ou glissez-déposez
                        </div>
                        <div class="upload-info">
                            PNG, JPG jusqu'à 10MB
                        </div>
                        <input type="file" name="image" accept="image/*" class="file-input" required>
                    </div>
                    <div id="imagePreview" class="image-preview"></div>
                </div>

                <div class="form-group span-2">
                    <label>Images supplémentaires</label>
                    <div class="file-upload-area" id="galleryUpload">
                        <div class="upload-icon">
                            <i class="fas fa-images"></i>
                        </div>
                        <div class="upload-text">
                            <strong>Ajouter des images</strong>
                        </div>
                        <input type="file" name="gallery[]" accept="image/*" class="file-input" multiple>
                    </div>
                    <div id="galleryPreview" class="gallery-preview"></div>
                </div>
            </div>
        </div>

        <!-- Section 5: Billets et tarifs -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(243, 156, 18, 0.15), rgba(243, 156, 18, 0.05)); color: var(--warning);">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <div>
                    <h2>Billets et tarifs</h2>
                    <p>Configurez les catégories de billets et leurs prix</p>
                </div>
            </div>

            <div id="ticketsContainer">
                {% if isEditMode is defined and isEditMode and existingTicketTypes is defined and existingTicketTypes|length > 0 %}
                    {% for ticketType in existingTicketTypes %}
                        {% set inventaire = ticketType.inventaire %}
                        {% set quantiteVendue = inventaire ? inventaire.quantiteVendue : 0 %}
                        {% set quantiteTotale = inventaire ? inventaire.quantiteTotale : 0 %}
                        <div class="ticket-category" data-ticket-id="{{ ticketType.id }}">
                            <div class="ticket-header">
                                <h3>Catégorie {{ loop.index }}</h3>
                                <button type="button" class="btn-remove-ticket" onclick="removeTicket(this)">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <input type="hidden" name="ticket_id[]" value="{{ ticketType.id }}">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label>Catégorie <span class="required">*</span></label>
                                    <select name="ticket_categorie[]" class="form-control" required>
                                        <option value="">Sélectionner une catégorie...</option>
                                        <option value="tous">Tous</option>
                                        {% for categorie in categoriesBillets %}
                                            <option value="{{ categorie.id }}" {% if ticketType.configurationCategorie and ticketType.configurationCategorie.id == categorie.id %}selected{% endif %}>{{ categorie.nom }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Segment âge <span class="required">*</span></label>
                                    <select name="ticket_segment[]" class="form-control" required>
                                        <option value="">Sélectionner un segment...</option>
                                        <option value="tous">Tous</option>
                                        {% for segment in segmentsBillets %}
                                            <option value="{{ segment.id }}" {% if ticketType.configurationSegment and ticketType.configurationSegment.id == segment.id %}selected{% endif %}>
                                                {{ segment.nom }}{% if segment.ageMin is not null or segment.ageMax is not null %} 
                                                    ({% if segment.ageMin is not null %}{{ segment.ageMin }}{% endif %}{% if segment.ageMin is not null and segment.ageMax is not null %}-{% endif %}{% if segment.ageMax is not null %}{{ segment.ageMax }}{% endif %} ans)
                                                {% endif %}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Prix (MGA) <span class="required">*</span></label>
                                    <input type="number" name="ticket_price[]" class="form-control" placeholder="0.00" min="0" step="0.01" 
                                           value="{{ ticketType.prixDeBase }}" required>
                                </div>
                                <div class="form-group">
                                    <label>Quantité <span class="required">*</span></label>
                                    <input type="number" name="ticket_quantity[]" class="form-control ticket-quantity-input" 
                                           placeholder="100" min="{{ quantiteVendue }}" step="1" 
                                           value="{{ quantiteTotale }}" 
                                           data-sold="{{ quantiteVendue }}"
                                           data-original="{{ quantiteTotale }}"
                                           required>
                                    {% if quantiteVendue > 0 %}
                                        <small class="form-help" style="color: var(--warning);">
                                            <i class="fas fa-exclamation-triangle"></i> 
                                            {{ quantiteVendue }} billet(s) déjà vendu(s). La quantité ne peut pas être inférieure à {{ quantiteVendue }}.
                                        </small>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="ticket-category">
                        <div class="ticket-header">
                            <h3>Catégorie 1</h3>
                            <button type="button" class="btn-remove-ticket" onclick="removeTicket(this)">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Catégorie <span class="required">*</span></label>
                                <select name="ticket_categorie[]" class="form-control" required>
                                    <option value="">Sélectionner une catégorie...</option>
                                    <option value="tous">Tous</option>
                                    {% for categorie in categoriesBillets %}
                                        <option value="{{ categorie.id }}">{{ categorie.nom }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Segment âge <span class="required">*</span></label>
                                <select name="ticket_segment[]" class="form-control" required>
                                    <option value="">Sélectionner un segment...</option>
                                    <option value="tous">Tous</option>
                                    {% for segment in segmentsBillets %}
                                        <option value="{{ segment.id }}">
                                            {{ segment.nom }}{% if segment.ageMin is not null or segment.ageMax is not null %} 
                                                ({% if segment.ageMin is not null %}{{ segment.ageMin }}{% endif %}{% if segment.ageMin is not null and segment.ageMax is not null %}-{% endif %}{% if segment.ageMax is not null %}{{ segment.ageMax }}{% endif %} ans)
                                            {% endif %}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Prix (MGA) <span class="required">*</span></label>
                                <input type="number" name="ticket_price[]" class="form-control" placeholder="0.00" min="0" step="0.01" required>
                            </div>
                            <div class="form-group">
                                <label>Quantité <span class="required">*</span></label>
                                <input type="number" name="ticket_quantity[]" class="form-control" placeholder="100" min="1" required>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            <button type="button" class="btn-add-ticket" onclick="addTicket()">
                <i class="fas fa-plus"></i>
                Ajouter une catégorie de billet
            </button>

            <!-- Paramètres de vente des billets -->
            <div class="ticket-sales-settings">
                <div class="section-header">
                    <div class="section-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                        <i class="fas fa-cog"></i>
                    </div>
                    <div>
                        <h2>Paramètres de vente</h2>
                        <p>Configurez les dates de vente et les limites par commande pour tous les billets</p>
                    </div>
                </div>
                
                <div class="form-grid">
                    <div class="form-group">
                        <label>Date de début des ventes</label>
                        <div class="datetime-split">
                            <input type="text" name="ticket_sales_start_date" id="ticketSalesStartDate" class="form-control date-sales-start-date" placeholder="jj/mm/aaaa"
                                   value="{{ (isEditMode is defined and isEditMode) and event.ventesCommencentLe ? event.ventesCommencentLe|date('d/m/Y') : '' }}">
                            <input type="time" name="ticket_sales_start_time" id="ticketSalesStartTime" class="form-control time-only date-sales-start-time" placeholder="hh:mm"
                                   value="{{ (isEditMode is defined and isEditMode) and event.ventesCommencentLe ? event.ventesCommencentLe|date('H:i') : '' }}">
                        </div>
                        <input type="hidden" name="ticket_sales_start" id="ticketSalesStart">
                        <small class="form-help">Date et heure à partir de laquelle les billets seront en vente</small>
                    </div>
                    
                    <div class="form-group">
                        <label>Date de fin des ventes</label>
                        <div class="datetime-split">
                            <input type="text" name="ticket_sales_end_date" id="ticketSalesEndDate" class="form-control date-sales-end-date" placeholder="jj/mm/aaaa"
                                   value="{{ (isEditMode is defined and isEditMode) and event.ventesSeTerminentLe ? event.ventesSeTerminentLe|date('d/m/Y') : '' }}">
                            <input type="time" name="ticket_sales_end_time" id="ticketSalesEndTime" class="form-control time-only date-sales-end-time" placeholder="hh:mm"
                                   value="{{ (isEditMode is defined and isEditMode) and event.ventesSeTerminentLe ? event.ventesSeTerminentLe|date('H:i') : '' }}">
                        </div>
                        <input type="hidden" name="ticket_sales_end" id="ticketSalesEnd">
                        <small class="form-help">Date et heure jusqu'à laquelle les billets seront en vente</small>
                    </div>
                    
                    <div class="form-group">
                        <label>Minimum par commande</label>
                        <input type="number" name="ticket_min_per_order" class="form-control" placeholder="1" min="1" value="1">
                        <small class="form-help">Nombre minimum de billets par commande</small>
                    </div>
                    
                    <div class="form-group">
                        <label>Maximum par commande</label>
                        <input type="number" name="ticket_max_per_order" class="form-control" placeholder="Illimité" min="1">
                        <small class="form-help">Nombre maximum de billets par commande (laisser vide pour illimité)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 6: Paiement et Accessibilité -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(46, 204, 113, 0.15), rgba(46, 204, 113, 0.05)); color: #2ECC71;">
                    <i class="fas fa-credit-card"></i>
                </div>
                <div>
                    <h2>Paiement et Accessibilité</h2>
                    <p>Configurez les options de paiement et d'accessibilité</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Modes de paiement acceptés <span class="required">*</span></label>
                    <div class="payment-selector">
                        <div class="payment-grid">
                            {% for modePaiement in modesPaiement %}
                                {% set paymentValue = modePaiement.code %}
                                {% if modePaiement.code == 'mvola' %}
                                    {% set logo = 'images/m-vola1.png' %}
                                {% elseif modePaiement.code == 'orange' %}
                                    {% set logo = 'images/Orange.png' %}
                                {% elseif modePaiement.code == 'airtel' %}
                                    {% set logo = 'images/airtel.png' %}
                                {% else %}
                                    {% set logo = null %}
                                {% endif %}

                                <div class="payment-option">
                                    <div class="payment-card{% if modePaiement.code == 'mvola' %} payment-card-mvola{% endif %}">
                                        <div class="payment-icon">
                                            {% if logo %}
                                                <img src="{{ asset(logo) }}"
                                                    alt="{{ modePaiement.libelle }}"
                                                    class="payment-logo">
                                            {% else %}
                                                💰
                                            {% endif %}
                                        </div>
                                        <span class="payment-label">{{ modePaiement.libelle }}</span>
                                    </div>
                                    <label class="payment-checkbox-label">
                                        <input type="checkbox"
                                            name="payment_methods[]"
                                            value="{{ paymentValue }}"
                                            class="payment-checkbox">
                                        <span class="payment-checkbox-custom"></span>
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="form-group span-2">
                    <label>Options d'accessibilité</label>
                    <div class="accessibility-selector">
                        <div class="accessibility-grid">
                            {% for typeAccessibilite in typesAccessibilite %}
                                {% set accessibilityValue = typeAccessibilite.code %}
                                {% set accessibilityLabel = typeAccessibilite.libelle %}
                                {% set iconUrl = typeAccessibilite.urlImage ?? 'images/acces1.svg' %}
                                {% set isSelected = false %}

                                {% if isEditMode is defined and isEditMode and event.liensAccessibilites is defined %}
                                    {% for lien in event.liensAccessibilites %}
                                        {% if lien.typeAccessibilite.code == accessibilityValue %}
                                            {% set isSelected = true %}
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}

                                <label class="accessibility-option">
                                    <input type="checkbox"
                                        name="accessibility[]"
                                        value="{{ accessibilityValue }}"
                                        {% if isSelected %}checked{% endif %}>
                                    <div class="accessibility-card">
                                        <div class="accessibility-icon">
                                            <img src="{{ asset(iconUrl) }}"
                                                alt="{{ accessibilityLabel }}"
                                                class="accessibility-logo">
                                        </div>
                                        <div class="accessibility-info">
                                            <span class="accessibility-title">{{ accessibilityLabel }}</span>
                                        </div>
                                    </div>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 7: Options avancées (masquée en mode édition) -->
        {% if not (isEditMode is defined and isEditMode) %}
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(231, 76, 60, 0.15), rgba(231, 76, 60, 0.05)); color: var(--danger);">
                    <i class="fas fa-cog"></i>
                </div>
                <div>
                    <h2>Options avancées</h2>
                    <p>Paramètres supplémentaires</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="is_featured" value="1">
                        <span>Événement mis en avant</span>
                    </label>
                    <small class="form-help">L'événement sera affiché en priorité</small>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="allow_waiting_list" value="1" checked>
                        <span>Activer la liste d'attente</span>
                    </label>
                    <small class="form-help">Si complet, les utilisateurs pourront s'inscrire</small>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="send_reminders" value="1" checked>
                        <span>Envoyer des rappels automatiques</span>
                    </label>
                    <small class="form-help">Les participants recevront des rappels avant l'événement</small>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="publish_immediately" value="1" checked>
                        <span>Publier immédiatement</span>
                    </label>
                    <small class="form-help">L'événement sera visible tout de suite</small>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Actions -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-check"></i>
                {{ isEditMode|default(false) ? 'Enregistrer les modifications' : 'Créer l\'événement' }}
            </button>
            <a href="{{ path('organisateur_events_index') }}" class="btn btn-text">
                Annuler
            </a>
        </div>
        
        {# Masquer les champs de date du formulaire Symfony #}
        <div style="display: none !important;">
            {{ form_widget(form.commenceLe) }}
            {{ form_widget(form.seTermineLe) }}
        </div>
        
        {% if isEditMode is defined and isEditMode %}
        <div style="display: none !important;">
            {{ form_widget(form.titre) }}
            {{ form_widget(form.categoriePrincipale) }}
            {{ form_widget(form.typeEvenement) }}
            {{ form_widget(form.resume) }}
            {{ form_widget(form.description) }}
        </div>
        {% endif %}
        
        {{ form_rest(form) }}
    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
<script>
// Variables globales
const allCategories = [
    { id: 'tous', nom: 'Tous' },
    {% for categorie in categoriesBillets %}
    { id: '{{ categorie.id }}', nom: '{{ categorie.nom }}' },
    {% endfor %}
];

const allSegments = [
    { id: 'tous', nom: 'Tous', ageMin: null, ageMax: null, label: 'Tous' },
    {% for segment in segmentsBillets %}
    { 
        id: '{{ segment.id }}', 
        nom: '{{ segment.nom }}',
        ageMin: {{ segment.ageMin ?? 'null' }},
        ageMax: {{ segment.ageMax ?? 'null' }},
        label: '{{ segment.nom }}{% if segment.ageMin is not null or segment.ageMax is not null %} ({% if segment.ageMin is not null %}{{ segment.ageMin }}{% endif %}{% if segment.ageMin is not null and segment.ageMax is not null %}-{% endif %}{% if segment.ageMax is not null %}{{ segment.ageMax }}{% endif %} ans){% endif %}'
    },
    {% endfor %}
];

let selectedCategories = new Set();
let selectedSegments = new Set();
let hasTousCategory = false;
let hasTousSegment = false;
let ticketCount = 1;

// Initialisation
document.addEventListener('DOMContentLoaded', function() {
    // Compteur de caractères pour le résumé
    const textarea = document.querySelector('textarea[name="event[resume]"]');
    const charCount = document.getElementById('charCount');
    
    if (textarea && charCount) {
        textarea.addEventListener('input', function() {
            charCount.textContent = this.value.length;
        });
        if (textarea.value) {
            charCount.textContent = textarea.value.length;
        }
    }

    // Upload d'image avec prévisualisation
    setupImageUpload('imageUpload', 'imagePreview', false);
    setupImageUpload('galleryUpload', 'galleryPreview', true);

    // Configuration des dates et heures
    setupDateTimeControls();

    // Initialiser les écouteurs pour les selects de billets
    initializeTicketSelects();
    
    // Vérifier l'état initial des selects
    checkInitialTicketSelections();
    
    // Validation de la quantité minimale pour les billets existants
    document.querySelectorAll('.ticket-quantity-input').forEach(input => {
        const soldQuantity = parseInt(input.dataset.sold) || 0;
        const originalQuantity = parseInt(input.dataset.original) || 0;
        
        input.addEventListener('change', function() {
            const newQuantity = parseInt(this.value) || 0;
            if (newQuantity < soldQuantity) {
                showNotification(
                    `La quantité ne peut pas être inférieure à ${soldQuantity} (${soldQuantity} billet(s) déjà vendu(s)).`,
                    'error',
                    'Quantité invalide'
                );
                this.value = Math.max(soldQuantity, originalQuantity);
                this.focus();
            }
        });
        
        input.addEventListener('input', function() {
            const newQuantity = parseInt(this.value) || 0;
            if (newQuantity < soldQuantity) {
                this.setCustomValidity(`La quantité minimale est ${soldQuantity} (billets vendus)`);
            } else {
                this.setCustomValidity('');
            }
        });
    });

    // Si un lieu vient d'être créé
    const urlParams = new URLSearchParams(window.location.search);
    const venueId = urlParams.get('venue_id');
    if (venueId) {
        const select = document.getElementById('venueSelect');
        if (select) {
            select.value = venueId;
            select.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }
});

// Configuration des contrôles de date et heure
function setupDateTimeControls() {
    // Date de début et fin de l'événement
    setupDateTimeSplit({
        dateSelector: 'input[name="date_start_date"]',
        timeSelector: 'input[name="date_start_time"]',
        hiddenSelector: 'input[name="date_start"]',
        required: true,
        onChangeCallback: updateSalesDatesFromEventDates
    });
    
    setupDateTimeSplit({
        dateSelector: 'input[name="date_end_date"]',
        timeSelector: 'input[name="date_end_time"]',
        hiddenSelector: 'input[name="date_end"]',
        required: false,
        onChangeCallback: updateSalesDatesFromEventDates
    });

    // Dates de vente des billets
    setupDateTimeSplit({
        dateSelector: 'input[name="ticket_sales_start_date"]',
        timeSelector: 'input[name="ticket_sales_start_time"]',
        hiddenSelector: 'input[name="ticket_sales_start"]',
        required: false
    });
    
    setupDateTimeSplit({
        dateSelector: 'input[name="ticket_sales_end_date"]',
        timeSelector: 'input[name="ticket_sales_end_time"]',
        hiddenSelector: 'input[name="ticket_sales_end"]',
        required: false
    });
}

// Fonction pour mettre à jour automatiquement les dates de vente
function updateSalesDatesFromEventDates() {
    const eventStartDate = document.querySelector('input[name="date_start_date"]').value;
    const eventStartTime = document.querySelector('input[name="date_start_time"]').value;
    const eventEndDate = document.querySelector('input[name="date_end_date"]').value;
    const eventEndTime = document.querySelector('input[name="date_end_time"]').value;
    
    // Si la date de début de l'événement est définie, on la copie dans la date de début des ventes
    if (eventStartDate && eventStartTime) {
        const salesStartDateInput = document.getElementById('ticketSalesStartDate');
        const salesStartTimeInput = document.getElementById('ticketSalesStartTime');
        
        if (salesStartDateInput && !salesStartDateInput.value) {
            salesStartDateInput.value = eventStartDate;
        }
        if (salesStartTimeInput && !salesStartTimeInput.value) {
            salesStartTimeInput.value = eventStartTime;
        }
        
        // Mettre à jour le champ hidden
        updateHiddenField('ticket_sales_start_date', 'ticket_sales_start_time', 'ticket_sales_start');
    }
    
    // Si la date de fin de l'événement est définie, on la copie dans la date de fin des ventes
    if (eventEndDate && eventEndTime) {
        const salesEndDateInput = document.getElementById('ticketSalesEndDate');
        const salesEndTimeInput = document.getElementById('ticketSalesEndTime');
        
        if (salesEndDateInput && !salesEndDateInput.value) {
            salesEndDateInput.value = eventEndDate;
        }
        if (salesEndTimeInput && !salesEndTimeInput.value) {
            salesEndTimeInput.value = eventEndTime;
        }
        
        // Mettre à jour le champ hidden
        updateHiddenField('ticket_sales_end_date', 'ticket_sales_end_time', 'ticket_sales_end');
    }
}

// Fonction générique pour configurer les champs de date et heure
function setupDateTimeSplit({ dateSelector, timeSelector, hiddenSelector, required, onChangeCallback }) {
    const dateInput = document.querySelector(dateSelector);
    const timeInput = document.querySelector(timeSelector);
    const hiddenInput = document.querySelector(hiddenSelector);
    
    if (!dateInput || !timeInput || !hiddenInput) return;

    // Configuration du datepicker pour la date
    flatpickr(dateInput, {
        dateFormat: 'd/m/Y',
        altInput: false,
        allowInput: true,
        locale: 'fr',
        onChange: function() {
            updateHidden();
            if (onChangeCallback) onChangeCallback();
        }
    });

    // Configuration du timepicker pour l'heure
    const timePicker = flatpickr(timeInput, {
        enableTime: true,
        noCalendar: true,
        dateFormat: 'H:i',
        time_24hr: true,
        allowInput: true,
        locale: 'fr',
        onChange: function() {
            updateHidden();
            if (onChangeCallback) onChangeCallback();
        }
    });

    // Mettre à jour le champ hidden
    const updateHidden = () => {
        const dateVal = dateInput.value.trim();
        const timeVal = timeInput.value.trim();
        
        if (!dateVal || !timeVal) {
            hiddenInput.value = '';
            return;
        }
        
        const [day, month, year] = dateVal.split('/');
        if (!day || !month || !year) {
            hiddenInput.value = '';
            return;
        }
        
        const isoDate = `${year.padStart(4, '0')}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
        hiddenInput.value = `${isoDate}T${timeVal}`;
    };

    // Valeurs par défaut
    const initDefaultDateTime = () => {
        const now = new Date();
        const dd = String(now.getDate()).padStart(2, '0');
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const yyyy = now.getFullYear();
        const hh = String(now.getHours()).padStart(2, '0');
        const min = String(now.getMinutes()).padStart(2, '0');
        
        if (!dateInput.value) {
            dateInput.value = `${dd}/${mm}/${yyyy}`;
        }
        if (!timeInput.value) {
            timeInput.value = `${hh}:${min}`;
        }
    };

    initDefaultDateTime();
    updateHidden();

    // Écouteurs d'événements
    dateInput.addEventListener('change', updateHidden);
    timeInput.addEventListener('change', updateHidden);
    timeInput.addEventListener('input', () => {
        if (timePicker) {
            timePicker.setDate(timeInput.value, false, 'H:i');
        }
        updateHidden();
        if (onChangeCallback) onChangeCallback();
    });

    if (required) {
        dateInput.required = true;
        timeInput.required = true;
        hiddenInput.required = true;
    }
}

// Fonction pour mettre à jour un champ hidden
function updateHiddenField(dateFieldName, timeFieldName, hiddenFieldName) {
    const dateInput = document.querySelector(`input[name="${dateFieldName}"]`);
    const timeInput = document.querySelector(`input[name="${timeFieldName}"]`);
    const hiddenInput = document.querySelector(`input[name="${hiddenFieldName}"]`);
    
    if (!dateInput || !timeInput || !hiddenInput) return;
    
    const dateVal = dateInput.value.trim();
    const timeVal = timeInput.value.trim();
    
    if (!dateVal || !timeVal) {
        hiddenInput.value = '';
        return;
    }
    
    const [day, month, year] = dateVal.split('/');
    if (!day || !month || !year) {
        hiddenInput.value = '';
        return;
    }
    
    const isoDate = `${year.padStart(4, '0')}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
    hiddenInput.value = `${isoDate}T${timeVal}`;
}

// Upload d'images
function setupImageUpload(uploadId, previewId, multiple) {
    const uploadArea = document.getElementById(uploadId);
    const preview = document.getElementById(previewId);
    const input = uploadArea.querySelector('input[type="file"]');

    if (!uploadArea || !preview || !input) return;

    uploadArea.addEventListener('click', () => input.click());

    input.addEventListener('change', function() {
        preview.innerHTML = '';
        const files = Array.from(this.files);
        
        files.forEach(file => {
            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement('div');
                    img.className = 'preview-image';
                    img.innerHTML = `
                        <img src="${e.target.result}" alt="Preview">
                        <button type="button" class="remove-image" onclick="this.parentElement.remove()">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                    preview.appendChild(img);
                };
                reader.readAsDataURL(file);
            }
        });
    });

    // Drag and drop
    uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = 'var(--accent)';
        uploadArea.style.background = 'rgba(52, 152, 219, 0.05)';
    });

    uploadArea.addEventListener('dragleave', () => {
        uploadArea.style.borderColor = 'var(--gray-300)';
        uploadArea.style.background = 'var(--gray-50)';
    });

    uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = 'var(--gray-300)';
        uploadArea.style.background = 'var(--gray-50)';
        input.files = e.dataTransfer.files;
        input.dispatchEvent(new Event('change'));
    });
}

// Gestion des billets
function checkInitialTicketSelections() {
    document.querySelectorAll('select[name="ticket_categorie[]"]').forEach(select => {
        if (select.value) {
            const cat = allCategories.find(c => c.id === select.value);
            if (cat) {
                if (cat.id === 'tous' || cat.nom === 'Tous' || cat.nom === 'tous') {
                    hasTousCategory = true;
                } else {
                    selectedCategories.add(select.value);
                }
            }
        }
    });
    
    document.querySelectorAll('select[name="ticket_segment[]"]').forEach(select => {
        if (select.value) {
            const seg = allSegments.find(s => s.id === select.value);
            if (seg) {
                if (seg.id === 'tous' || seg.nom === 'Tous' || seg.nom === 'tous') {
                    hasTousSegment = true;
                } else {
                    selectedSegments.add(select.value);
                }
            }
        }
    });
}

function initializeTicketSelects() {
    document.querySelectorAll('select[name="ticket_categorie[]"]').forEach(select => {
        select.addEventListener('change', function() {
            handleSelectionChange(this, 'category');
        });
    });
    
    document.querySelectorAll('select[name="ticket_segment[]"]').forEach(select => {
        select.addEventListener('change', function() {
            handleSelectionChange(this, 'segment');
        });
    });
}

function handleSelectionChange(select, type) {
    const value = select.value;
    
    if (type === 'category') {
        selectedCategories.clear();
        hasTousCategory = false;
        
        document.querySelectorAll('select[name="ticket_categorie[]"]').forEach(s => {
            if (s.value) {
                const cat = allCategories.find(c => c.id === s.value);
                if (cat) {
                    if (cat.id === 'tous' || cat.nom === 'Tous' || cat.nom === 'tous') {
                        hasTousCategory = true;
                    } else {
                        selectedCategories.add(s.value);
                    }
                }
            }
        });
    } else if (type === 'segment') {
        selectedSegments.clear();
        hasTousSegment = false;
        
        document.querySelectorAll('select[name="ticket_segment[]"]').forEach(s => {
            if (s.value) {
                const seg = allSegments.find(se => se.id === s.value);
                if (seg) {
                    if (seg.id === 'tous' || seg.nom === 'Tous' || seg.nom === 'tous') {
                        hasTousSegment = true;
                    } else {
                        selectedSegments.add(s.value);
                    }
                }
            }
        });
    }
}

function getAllCategoriesOptions() {
    let options = '<option value="">Sélectionner une catégorie...</option>';
    allCategories.forEach(cat => {
        options += `<option value="${cat.id}">${cat.nom}</option>`;
    });
    return options;
}

function getAllSegmentsOptions() {
    let options = '<option value="">Sélectionner un segment...</option>';
    allSegments.forEach(seg => {
        options += `<option value="${seg.id}">${seg.label}</option>`;
    });
    return options;
}

function getFilteredCategoriesOptions() {
    let options = '<option value="">Sélectionner une catégorie...</option>';
    
    if (hasTousCategory) {
        const tousCategory = allCategories.find(c => c.id === 'tous');
        if (tousCategory) {
            options += `<option value="${tousCategory.id}">${tousCategory.nom}</option>`;
        }
        return options;
    }
    
    allCategories.forEach(cat => {
        if (!selectedCategories.has(cat.id)) {
            options += `<option value="${cat.id}">${cat.nom}</option>`;
        }
    });
    
    return options;
}

function getFilteredSegmentsOptions() {
    let options = '<option value="">Sélectionner un segment...</option>';
    
    if (hasTousSegment) {
        const tousSegment = allSegments.find(s => s.id === 'tous');
        if (tousSegment) {
            options += `<option value="${tousSegment.id}">${tousSegment.label}</option>`;
        }
        return options;
    }
    
    allSegments.forEach(seg => {
        if (!selectedSegments.has(seg.id)) {
            options += `<option value="${seg.id}">${seg.label}</option>`;
        }
    });
    
    return options;
}

function addTicket() {
    if (hasTousCategory && hasTousSegment) {
        showNotification(
            'Les deux champs <strong>Catégorie</strong> et <strong>Segment âge</strong> sont déjà sur "tous".<br>Veuillez modifier au moins une sélection avant d\'ajouter un nouveau billet.',
            'error',
            'Impossible d\'ajouter un billet'
        );
        return;
    }
    
    ticketCount++;
    const container = document.getElementById('ticketsContainer');
    const ticketHTML = `
        <div class="ticket-category">
            <div class="ticket-header">
                <h3>Catégorie ${ticketCount}</h3>
                <button type="button" class="btn-remove-ticket" onclick="removeTicket(this)">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Catégorie <span class="required">*</span></label>
                    <select name="ticket_categorie[]" class="form-control ticket-categorie-select" required>${getFilteredCategoriesOptions()}</select>
                </div>
                <div class="form-group">
                    <label>Segment âge <span class="required">*</span></label>
                    <select name="ticket_segment[]" class="form-control ticket-segment-select" required>${getFilteredSegmentsOptions()}</select>
                </div>
                <div class="form-group">
                    <label>Prix (MGA) <span class="required">*</span></label>
                    <input type="number" name="ticket_price[]" class="form-control" placeholder="0.00" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Quantité <span class="required">*</span></label>
                    <input type="number" name="ticket_quantity[]" class="form-control" placeholder="100" min="1" required>
                </div>
            </div>
        </div>
    `;
    container.insertAdjacentHTML('beforeend', ticketHTML);
    
    const newCategorySelect = container.querySelector('.ticket-category:last-child .ticket-categorie-select');
    const newSegmentSelect = container.querySelector('.ticket-category:last-child .ticket-segment-select');
    
    if (newCategorySelect) {
        newCategorySelect.addEventListener('change', function() {
            handleSelectionChange(this, 'category');
        });
    }
    
    if (newSegmentSelect) {
        newSegmentSelect.addEventListener('change', function() {
            handleSelectionChange(this, 'segment');
        });
    }
}

function removeTicket(btn) {
    const tickets = document.querySelectorAll('.ticket-category');
    if (tickets.length > 1) {
        const ticketToRemove = btn.closest('.ticket-category');
        const categorySelect = ticketToRemove.querySelector('select[name="ticket_categorie[]"]');
        const segmentSelect = ticketToRemove.querySelector('select[name="ticket_segment[]"]');
        
        if (categorySelect && categorySelect.value) {
            const cat = allCategories.find(c => c.id === categorySelect.value);
            if (cat && (cat.id === 'tous' || cat.nom === 'Tous' || cat.nom === 'tous')) {
                hasTousCategory = false;
            } else if (cat) {
                selectedCategories.delete(categorySelect.value);
            }
        }
        
        if (segmentSelect && segmentSelect.value) {
            const seg = allSegments.find(s => s.id === segmentSelect.value);
            if (seg && (seg.id === 'tous' || seg.nom === 'Tous' || seg.nom === 'tous')) {
                hasTousSegment = false;
            } else if (seg) {
                selectedSegments.delete(segmentSelect.value);
            }
        }
        
        ticketToRemove.remove();
    } else {
        showNotification(
            'Au moins une catégorie de billet est requise pour votre événement.<br>Vous ne pouvez pas supprimer la dernière catégorie.',
            'error',
            'Suppression impossible'
        );
    }
}

// Notifications
function showNotification(message, type = 'info', title = null) {
    if (!title) {
        switch(type) {
            case 'error':
                title = 'Erreur';
                break;
            case 'warning':
                title = 'Attention';
                break;
            case 'success':
                title = 'Succès';
                break;
            default:
                title = 'Information';
        }
    }
    
    const notification = document.createElement('div');
    notification.className = `toast-notification toast-${type}`;
    notification.innerHTML = `
        <div class="toast-icon-wrapper">
            <i class="fas ${type === 'error' ? 'fa-exclamation-circle' : type === 'warning' ? 'fa-exclamation-triangle' : type === 'success' ? 'fa-check-circle' : 'fa-info-circle'}"></i>
        </div>
        <div class="toast-content">
            <div class="toast-title">${title}</div>
            <div class="toast-message">${message}</div>
        </div>
        <button class="toast-close" onclick="this.parentElement.remove()" aria-label="Fermer">
            <i class="fas fa-times"></i>
        </button>
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.classList.add('show');
    }, 10);
    
    const duration = type === 'error' ? 6000 : 5000;
    setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => {
            if (notification.parentElement) {
                notification.remove();
            }
        }, 300);
    }, duration);
}
</script>
{% endblock %}