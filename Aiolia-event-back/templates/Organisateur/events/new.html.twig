{% extends 'base.html.twig' %}

{% block title %}Créer un événement - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête -->
    <div class="dashboard-header">
        <div>
            <h1>✨ Créer un nouvel événement</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Remplissez les informations pour créer votre événement
            </p>
        </div>
        <div class="header-actions">
            <a href="{{ path('app_event_index') }}" class="btn btn-secondary" style="background: white; color: var(--gray-700); border: 2px solid var(--gray-300); padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-arrow-left"></i>
                Retour
            </a>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" class="event-form">
        <!-- Section 1: Informations principales -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.05)); color: var(--accent);">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div>
                    <h2>Informations principales</h2>
                    <p>Les détails essentiels de votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Nom de l'événement <span class="required">*</span></label>
                    <input type="text" name="name" class="form-control" placeholder="Ex: Concert Rock Nation 2025" required>
                    <small class="form-help">Un nom accrocheur et descriptif</small>
                </div>

                <div class="form-group">
                    <label>Catégorie <span class="required">*</span></label>
                    <select name="category" class="form-control" required>
                        <option value="">Sélectionner...</option>
                        <option value="concert">🎸 Concert</option>
                        <option value="festival">🎵 Festival</option>
                        <option value="sport">⚽ Sport</option>
                        <option value="theatre">🎭 Théâtre</option>
                        <option value="conference">📚 Conférence</option>
                        <option value="autre">✨ Autre</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Type d'événement <span class="required">*</span></label>
                    <select name="type" class="form-control" required>
                        <option value="">Sélectionner...</option>
                        <option value="public">Public</option>
                        <option value="prive">Privé</option>
                        <option value="professionnel">Professionnel</option>
                    </select>
                </div>

                <div class="form-group span-2">
                    <label>Description courte <span class="required">*</span></label>
                    <textarea name="description_short" class="form-control" rows="3" placeholder="Une brève description de votre événement (max 200 caractères)" maxlength="200" required></textarea>
                    <small class="form-help"><span id="charCount">0</span>/200 caractères</small>
                </div>

                <div class="form-group span-2">
                    <label>Description complète</label>
                    <textarea name="description" class="form-control" rows="6" placeholder="Décrivez votre événement en détail..."></textarea>
                </div>
            </div>
        </div>

        <!-- Section 2: Date et lieu -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(39, 174, 96, 0.15), rgba(39, 174, 96, 0.05)); color: var(--success);">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div>
                    <h2>Date et lieu</h2>
                    <p>Quand et où se déroulera votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Date de début <span class="required">*</span></label>
                    <input type="datetime-local" name="date_start" class="form-control" required>
                </div>

                <div class="form-group">
                    <label>Date de fin</label>
                    <input type="datetime-local" name="date_end" class="form-control">
                </div>

                <div class="form-group">
                    <label>Lieu / Salle <span class="required">*</span></label>
                    <input type="text" name="venue" class="form-control" placeholder="Ex: Stade Municipal" required>
                </div>

                <div class="form-group">
                    <label>Ville <span class="required">*</span></label>
                    <input type="text" name="city" class="form-control" placeholder="Ex: Antananarivo" required>
                </div>

                <div class="form-group span-2">
                    <label>Adresse complète <span class="required">*</span></label>
                    <input type="text" name="address" class="form-control" placeholder="Ex: Avenue de l'Indépendance, 101 Antananarivo" required>
                </div>
            </div>
        </div>

        <!-- Section 3: Tags et Classification -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.15), rgba(155, 89, 182, 0.05)); color: #9B59B6;">
                    <i class="fas fa-tags"></i>
                </div>
                <div>
                    <h2>Tags et Classification</h2>
                    <p>Catégorisez votre événement pour une meilleure découverte</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Tags <span class="required">*</span></label>
                    <div class="tags-selector">
                        <div class="tags-grid">
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="musique">
                                <div class="tag-card">
                                    <div class="tag-icon">🎵</div>
                                    <span>Musique Live</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="danse">
                                <div class="tag-card">
                                    <div class="tag-icon">💃</div>
                                    <span>Danse</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="gastronomie">
                                <div class="tag-card">
                                    <div class="tag-icon">🍽️</div>
                                    <span>Gastronomie</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="art">
                                <div class="tag-card">
                                    <div class="tag-icon">🎨</div>
                                    <span>Art</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="technologie">
                                <div class="tag-card">
                                    <div class="tag-icon">💻</div>
                                    <span>Technologie</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="sport">
                                <div class="tag-card">
                                    <div class="tag-icon">⚽</div>
                                    <span>Sport</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="famille">
                                <div class="tag-card">
                                    <div class="tag-icon">👨‍👩‍👧‍👦</div>
                                    <span>Famille</span>
                                </div>
                            </label>
                            <label class="tag-option">
                                <input type="checkbox" name="tags[]" value="business">
                                <div class="tag-card">
                                    <div class="tag-icon">💼</div>
                                    <span>Business</span>
                                </div>
                            </label>
                        </div>
                    </div>
                    <small class="form-help">Sélectionnez les tags qui correspondent à votre événement</small>
                </div>
            </div>
        </div>

        <!-- Section 4: Médias -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.15), rgba(155, 89, 182, 0.05)); color: #9B59B6;">
                    <i class="fas fa-image"></i>
                </div>
                <div>
                    <h2>Images et médias</h2>
                    <p>Ajoutez des visuels attractifs pour votre événement</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label>Image principale <span class="required">*</span></label>
                    <div class="file-upload-area" id="imageUpload">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <div class="upload-text">
                            <strong>Cliquez pour uploader</strong> ou glissez-déposez
                        </div>
                        <div class="upload-info">
                            PNG, JPG jusqu'à 10MB
                        </div>
                        <input type="file" name="image" accept="image/*" class="file-input" required>
                    </div>
                    <div id="imagePreview" class="image-preview"></div>
                </div>

                <div class="form-group span-2">
                    <label>Images supplémentaires</label>
                    <div class="file-upload-area" id="galleryUpload">
                        <div class="upload-icon">
                            <i class="fas fa-images"></i>
                        </div>
                        <div class="upload-text">
                            <strong>Ajouter des images</strong> (max 5)
                        </div>
                        <input type="file" name="gallery[]" accept="image/*" class="file-input" multiple>
                    </div>
                    <div id="galleryPreview" class="gallery-preview"></div>
                </div>
            </div>
        </div>

        <!-- Section 5: Billets et tarifs -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(243, 156, 18, 0.15), rgba(243, 156, 18, 0.05)); color: var(--warning);">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <div>
                    <h2>Billets et tarifs</h2>
                    <p>Configurez les catégories de billets et leurs prix</p>
                </div>
            </div>

            <div id="ticketsContainer">
                <div class="ticket-category">
                    <div class="ticket-header">
                        <h3>Catégorie 1</h3>
                        <button type="button" class="btn-remove-ticket" onclick="removeTicket(this)">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Nom de la catégorie <span class="required">*</span></label>
                            <input type="text" name="ticket_name[]" class="form-control" placeholder="Ex: VIP, Standard..." required>
                        </div>
                        <div class="form-group">
                            <label>Prix (€) <span class="required">*</span></label>
                            <input type="number" name="ticket_price[]" class="form-control" placeholder="0.00" min="0" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label>Quantité <span class="required">*</span></label>
                            <input type="number" name="ticket_quantity[]" class="form-control" placeholder="100" min="1" required>
                        </div>
                        <div class="form-group">
                            <label>Description</label>
                            <input type="text" name="ticket_description[]" class="form-control" placeholder="Avantages de cette catégorie">
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" class="btn-add-ticket" onclick="addTicket()">
                <i class="fas fa-plus"></i>
                Ajouter une catégorie de billet
            </button>
        </div>

        <!-- Section 6: Paiement et Accessibilité -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(46, 204, 113, 0.15), rgba(46, 204, 113, 0.05)); color: #2ECC71;">
                    <i class="fas fa-credit-card"></i>
                </div>
                <div>
                    <h2>Paiement et Accessibilité</h2>
                    <p>Configurez les options de paiement et d'accessibilité</p>
                </div>
            </div>

            <div class="form-grid">
                <!-- Modes de paiement -->
                <div class="form-group span-2">
                    <label>Modes de paiement acceptés <span class="required">*</span></label>
                    <div class="payment-selector">
                        <div class="payment-grid">
                            <!-- Orange Money -->
                            <div class="payment-option">
                                <div class="payment-card">
                                    <div class="payment-icon">
                                        <img src="{{ asset('images/orange-money.png') }}" alt="Orange Money" class="payment-logo">
                                    </div>
                                    <span class="payment-label">Orange Money</span>
                                </div>
                                <label class="payment-checkbox-label">
                                    <input type="checkbox" name="payment_methods[]" value="orange_money" class="payment-checkbox">
                                    <span class="payment-checkbox-custom"></span>
                                </label>
                            </div>
                            
                            <!-- Airtel Money -->
                            <div class="payment-option">
                                <div class="payment-card">
                                    <div class="payment-icon">
                                        <img src="{{ asset('images/airtel.png') }}" alt="Airtel Money" class="payment-logo">
                                    </div>
                                    <span class="payment-label">Airtel Money</span>
                                </div>
                                <label class="payment-checkbox-label">
                                    <input type="checkbox" name="payment_methods[]" value="airtel_money" class="payment-checkbox">
                                    <span class="payment-checkbox-custom"></span>
                                </label>
                            </div>
                            
                            <!-- Mvola -->
                            <div class="payment-option">
                                <div class="payment-card payment-card-mvola">
                                    <div class="payment-icon">
                                        <img src="{{ asset('images/m-vola.png') }}" alt="Mvola" class="payment-logo">
                                    </div>
                                    <span class="payment-label">Mvola</span>
                                </div>
                                <label class="payment-checkbox-label">
                                    <input type="checkbox" name="payment_methods[]" value="mvola" class="payment-checkbox">
                                    <span class="payment-checkbox-custom"></span>
                                </label>
                            </div>
                            
                            <!-- Espèces -->
                            <div class="payment-option">
                                <div class="payment-card">
                                    <div class="payment-icon">💰</div>
                                    <span class="payment-label">Espèces</span>
                                </div>
                                <label class="payment-checkbox-label">
                                    <input type="checkbox" name="payment_methods[]" value="cash" class="payment-checkbox">
                                    <span class="payment-checkbox-custom"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Accessibilité -->
                <div class="form-group span-2">
                    <label>Options d'accessibilité</label>
                    <div class="accessibility-selector">
                        <div class="accessibility-grid">
                            <label class="accessibility-option">
                                <input type="checkbox" name="accessibility[]" value="wheelchair">
                                <div class="accessibility-card">
                                    <div class="accessibility-icon">
                                        <img src="{{ asset('images/acces1.svg') }}" alt="Accès PMR" class="accessibility-logo">
                                    </div>
                                    <div class="accessibility-info">
                                        <span class="accessibility-title">Accès PMR</span>
                                    </div>
                                </div>
                            </label>
                            <label class="accessibility-option">
                                <input type="checkbox" name="accessibility[]" value="hearing">
                                <div class="accessibility-card">
                                    <div class="accessibility-icon">
                                        <img src="{{ asset('images/acces2.svg') }}" alt="Audio" class="accessibility-logo">
                                    </div>
                                    <div class="accessibility-info">
                                        <span class="accessibility-title">Audio</span>
                                    </div>
                                </div>
                            </label>
                            <label class="accessibility-option">
                                <input type="checkbox" name="accessibility[]" value="parking">
                                <div class="accessibility-card">
                                    <div class="accessibility-icon">
                                        <img src="{{ asset('images/acces6.svg') }}" alt="Parking PMR" class="accessibility-logo">
                                    </div>
                                    <div class="accessibility-info">
                                        <span class="accessibility-title">Parking PMR</span>
                                    </div>
                                </div>
                            </label>
                            <label class="accessibility-option">
                                <input type="checkbox" name="accessibility[]" value="family">
                                <div class="accessibility-card">
                                    <div class="accessibility-icon">
                                        <img src="{{ asset('images/acces4.svg') }}" alt="Famille" class="accessibility-logo">
                                    </div>
                                    <div class="accessibility-info">
                                        <span class="accessibility-title">Famille</span>
                                    </div>
                                </div>
                            </label>
                            <label class="accessibility-option">
                                <input type="checkbox" name="accessibility[]" value="visual">
                                <div class="accessibility-card">
                                    <div class="accessibility-icon">
                                        <img src="{{ asset('images/acces3.svg') }}" alt="Visuel" class="accessibility-logo">
                                    </div>
                                    <div class="accessibility-info">
                                        <span class="accessibility-title">Visuel</span>
                                    </div>
                                </div>
                            </label>
                            <label class="accessibility-option">
                                <input type="checkbox" name="accessibility[]" value="elevator">
                                <div class="accessibility-card">
                                    <div class="accessibility-icon">
                                        <img src="{{ asset('images/acces5.svg') }}" alt="Ascenseur" class="accessibility-logo">
                                    </div>
                                    <div class="accessibility-info">
                                        <span class="accessibility-title">Ascenseur</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 7: Options avancées -->
        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background: linear-gradient(135deg, rgba(231, 76, 60, 0.15), rgba(231, 76, 60, 0.05)); color: var(--danger);">
                    <i class="fas fa-cog"></i>
                </div>
                <div>
                    <h2>Options avancées</h2>
                    <p>Paramètres supplémentaires</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="is_featured" value="1">
                        <span>Événement mis en avant</span>
                    </label>
                    <small class="form-help">L'événement sera affiché en priorité</small>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="allow_waiting_list" value="1" checked>
                        <span>Activer la liste d'attente</span>
                    </label>
                    <small class="form-help">Si complet, les utilisateurs pourront s'inscrire</small>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="send_reminders" value="1" checked>
                        <span>Envoyer des rappels automatiques</span>
                    </label>
                    <small class="form-help">Les participants recevront des rappels avant l'événement</small>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="publish_immediately" value="1" checked>
                        <span>Publier immédiatement</span>
                    </label>
                    <small class="form-help">L'événement sera visible tout de suite</small>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-check"></i>
                Créer l'événement
            </button>
            <button type="button" class="btn btn-secondary">
                <i class="fas fa-save"></i>
                Enregistrer comme brouillon
            </button>
            <a href="{{ path('app_event_index') }}" class="btn btn-text">
                Annuler
            </a>
        </div>
    </form>
</div>

<script>
// Compteur de caractères
document.addEventListener('DOMContentLoaded', function() {
    const textarea = document.querySelector('textarea[name="description_short"]');
    const charCount = document.getElementById('charCount');
    
    if (textarea && charCount) {
        textarea.addEventListener('input', function() {
            charCount.textContent = this.value.length;
        });
    }

    // Upload d'image avec prévisualisation
    setupImageUpload('imageUpload', 'imagePreview', false);
    setupImageUpload('galleryUpload', 'galleryPreview', true);
});

function setupImageUpload(uploadId, previewId, multiple) {
    const uploadArea = document.getElementById(uploadId);
    const preview = document.getElementById(previewId);
    const input = uploadArea.querySelector('input[type="file"]');

    uploadArea.addEventListener('click', () => input.click());

    input.addEventListener('change', function() {
        preview.innerHTML = '';
        const files = Array.from(this.files);
        
        files.forEach(file => {
            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement('div');
                    img.className = 'preview-image';
                    img.innerHTML = `
                        <img src="${e.target.result}" alt="Preview">
                        <button type="button" class="remove-image" onclick="this.parentElement.remove()">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                    preview.appendChild(img);
                };
                reader.readAsDataURL(file);
            }
        });
    });

    // Drag and drop
    uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = 'var(--accent)';
        uploadArea.style.background = 'rgba(52, 152, 219, 0.05)';
    });

    uploadArea.addEventListener('dragleave', () => {
        uploadArea.style.borderColor = 'var(--gray-300)';
        uploadArea.style.background = 'var(--gray-50)';
    });

    uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = 'var(--gray-300)';
        uploadArea.style.background = 'var(--gray-50)';
        input.files = e.dataTransfer.files;
        input.dispatchEvent(new Event('change'));
    });
}

// Gestion des catégories de billets
let ticketCount = 1;

function addTicket() {
    ticketCount++;
    const container = document.getElementById('ticketsContainer');
    const ticketHTML = `
        <div class="ticket-category">
            <div class="ticket-header">
                <h3>Catégorie ${ticketCount}</h3>
                <button type="button" class="btn-remove-ticket" onclick="removeTicket(this)">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Nom de la catégorie <span class="required">*</span></label>
                    <input type="text" name="ticket_name[]" class="form-control" placeholder="Ex: VIP, Standard..." required>
                </div>
                <div class="form-group">
                    <label>Prix (€) <span class="required">*</span></label>
                    <input type="number" name="ticket_price[]" class="form-control" placeholder="0.00" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Quantité <span class="required">*</span></label>
                    <input type="number" name="ticket_quantity[]" class="form-control" placeholder="100" min="1" required>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <input type="text" name="ticket_description[]" class="form-control" placeholder="Avantages de cette catégorie">
                </div>
            </div>
        </div>
    `;
    container.insertAdjacentHTML('beforeend', ticketHTML);
}

function removeTicket(btn) {
    const tickets = document.querySelectorAll('.ticket-category');
    if (tickets.length > 1) {
        btn.closest('.ticket-category').remove();
    } else {
        alert('Vous devez avoir au moins une catégorie de billet');
    }
}
</script>

<style>
.event-form {
    max-width: 1200px;
    margin: 0 auto;
}

.form-section {
    background: var(--white);
    border-radius: var(--border-radius-xl);
    padding: 28px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

.section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--gray-200);
}

.section-icon {
    width: 50px;
    height: 50px;
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.section-header h2 {
    font-size: 1.3rem;
    font-weight: var(--font-weight-bold);
    color: var(--primary);
    margin: 0;
}

.section-header p {
    font-size: 0.9rem;
    color: var(--gray-600);
    margin: 4px 0 0 0;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.span-2 {
    grid-column: span 2;
}

.form-group label {
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-700);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
}

/* Astérisque rouge pour les champs obligatoires */
.required {
    color: #e74c3c !important;
    font-weight: bold !important;
    font-size: 1.2em !important;
    margin-left: 3px !important;
    display: inline-block !important;
    vertical-align: middle !important;
    line-height: 1 !important;
}

.form-control {
    padding: 12px 14px;
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    font-size: 0.95rem;
    font-family: var(--font-family);
    transition: var(--transition-base);
    background: var(--white);
}

.form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.form-help {
    font-size: 0.8rem;
    color: var(--gray-600);
    margin-top: 6px;
}

/* Styles pour les sélecteurs visuels */
.tags-selector,
.payment-selector,
.accessibility-selector {
    background: var(--white);
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    padding: 16px;
}

.tags-grid,
.accessibility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
}

.payment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
}

.tag-option,
.accessibility-option {
    cursor: pointer;
}

.payment-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.tag-option input,
.accessibility-option input {
    display: none;
}

.tag-card,
.accessibility-card {
    border: 2px solid var(--gray-200);
    border-radius: var(--border-radius-md);
    padding: 12px;
    text-align: center;
    transition: var(--transition-base);
    background: var(--white);
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.payment-card {
    background: var(--white);
    border: 1px solid var(--gray-300);
    border-radius: 8px;
    padding: 20px 16px;
    width: 100%;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    transition: var(--transition-base);
}

.payment-card-mvola {
    background: var(--white);
    border: 1px solid var(--gray-300);
}

.tag-card:hover,
.payment-card:hover,
.accessibility-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.tag-option input:checked + .tag-card,
.accessibility-option input:checked + .accessibility-card {
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(52, 152, 219, 0.05));
    box-shadow: 0 4px 12px rgba(52, 152, 219, 0.2);
}

.payment-option:has(.payment-checkbox:checked) .payment-card {
    border-color: var(--accent);
    background: var(--white);
    box-shadow: 0 2px 8px rgba(52, 152, 219, 0.2);
}

.payment-option:has(.payment-checkbox:checked) .payment-card-mvola {
    background: var(--white);
    border-color: var(--accent);
}

.tag-icon,
.payment-icon,
.accessibility-icon {
    font-size: 2rem;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.accessibility-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
}

.payment-icon {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 80px;
}

.payment-icon img {
    max-width: 100%;
    max-height: 80px;
    width: auto;
    height: auto;
    object-fit: contain;
}

.payment-icon:not(:has(img)) {
    font-size: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.payment-label {
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    color: var(--gray-800);
    text-align: center;
    width: 100%;
    margin: 0;
    flex-shrink: 0;
}

.payment-checkbox-label {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-top: 0;
    flex-shrink: 0;
}

.payment-checkbox {
    display: none;
}

.payment-checkbox-custom {
    width: 20px;
    height: 20px;
    border: 2px solid var(--gray-400);
    border-radius: 4px;
    background: var(--gray-100);
    display: inline-block;
    position: relative;
    transition: all 0.2s ease;
}

.payment-checkbox:checked + .payment-checkbox-custom {
    background: var(--accent);
    border-color: var(--accent);
}

.payment-checkbox:checked + .payment-checkbox-custom::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-size: 12px;
    font-weight: bold;
}

.accessibility-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.accessibility-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.accessibility-card {
    text-align: center;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    min-height: 100px;
}

.accessibility-info {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.accessibility-title {
    font-weight: var(--font-weight-semibold);
    color: var(--gray-800);
    display: block;
    font-size: 0.9rem;
    text-align: center;
}

.accessibility-desc {
    display: none;
}

.checkbox-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-weight: var(--font-weight-medium);
}

.checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

/* Upload de fichiers */
.file-upload-area {
    border: 2px dashed var(--gray-300);
    border-radius: var(--border-radius-md);
    padding: 32px;
    text-align: center;
    background: var(--gray-50);
    cursor: pointer;
    transition: var(--transition-base);
}

.file-upload-area:hover {
    border-color: var(--accent);
    background: rgba(52, 152, 219, 0.05);
}

.upload-icon {
    font-size: 3rem;
    color: var(--gray-400);
    margin-bottom: 12px;
}

.upload-text {
    font-size: 1rem;
    color: var(--gray-700);
    margin-bottom: 6px;
}

.upload-info {
    font-size: 0.85rem;
    color: var(--gray-500);
}

.file-input {
    display: none;
}

.image-preview, .gallery-preview {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
    margin-top: 16px;
}

.preview-image {
    position: relative;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    aspect-ratio: 1;
}

.preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.remove-image {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--danger);
    color: white;
    border: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    transition: var(--transition-base);
}

.remove-image:hover {
    opacity: 1;
    transform: scale(1.1);
}

/* Catégories de billets */
.ticket-category {
    background: var(--gray-50);
    border-radius: var(--border-radius-md);
    padding: 20px;
    margin-bottom: 16px;
    border: 1px solid var(--gray-200);
}

.ticket-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.ticket-header h3 {
    font-size: 1.1rem;
    color: var(--primary);
    margin: 0;
}

.btn-remove-ticket {
    background: var(--danger);
    color: white;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-base);
}

.btn-remove-ticket:hover {
    background: #c0392b;
    transform: scale(1.1);
}

.btn-add-ticket {
    width: 100%;
    padding: 14px;
    background: white;
    border: 2px dashed var(--accent);
    color: var(--accent);
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: var(--transition-base);
}

.btn-add-ticket:hover {
    background: rgba(52, 152, 219, 0.05);
    border-color: var(--accent-light);
}

/* Actions du formulaire */
.form-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 24px;
    background: var(--white);
    border-radius: var(--border-radius-xl);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-200);
}

.btn-primary {
    background: linear-gradient(135deg, #3498DB, #5DADE2) !important;
    color: white;
    border: none;
    padding: 14px 32px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-secondary {
    background: white;
    color: var(--gray-700);
    border: 2px solid var(--gray-300);
    padding: 14px 32px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-text {
    color: var(--gray-600);
    text-decoration: none;
    padding: 14px 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    
    .form-group.span-2 {
        grid-column: span 1;
    }
    
    .tags-grid,
    .payment-grid,
    .accessibility-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .form-actions {
        flex-direction: column;
    }
    
    .form-actions button,
    .form-actions a {
        width: 100%;
        text-align: center;
        justify-content: center;
    }
    
    .payment-card {
        min-height: 120px;
        padding: 16px 12px;
        gap: 10px;
    }
    
    .payment-icon img {
        max-height: 60px;
    }
    
    .payment-icon:not(:has(img)) {
        font-size: 3rem;
    }
    
    .payment-label {
        font-size: 0.85rem;
    }
    
    .accessibility-card {
        flex-direction: column;
        text-align: center;
        gap: 8px;
        min-height: 90px;
    }
    
    .accessibility-logo {
        width: 40px;
        height: 40px;
    }
}

@media (max-width: 480px) {
    .tags-grid,
    .payment-grid,
    .accessibility-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}