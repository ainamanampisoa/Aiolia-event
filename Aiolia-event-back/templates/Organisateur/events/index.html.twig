{% extends 'base.html.twig' %}

{% block title %}Événements - Aiolia Event{% endblock %}

{% block stylesheets %}
    {{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
/* Styles généraux - harmonisés avec le tableau de bord */

.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
}

.dashboard-header h1 {
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.dashboard-header h1 i {
    color: var(--accent);
}

.dashboard-header p {
    color: var(--text-secondary);
    margin-top: 8px;
    font-size: 1rem;
}

.events-stats {
    display: flex;
    gap: 24px;
    margin-top: 16px;
    flex-wrap: wrap;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--bg-card);
    border-radius: 8px;
    font-size: 0.9rem;
    border: 1px solid var(--border-color);
}

.stat-item strong {
    font-size: 1.1rem;
    color: var(--accent);
}

.stat-item i {
    color: var(--accent);
}

.header-actions {
    display: flex;
    gap: 12px;
    align-items: center;
}

/* Recherche rapide */
.quick-search {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    align-items: center;
}

.search-box {
    flex: 1;
    position: relative;
}

.search-box i {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray);
}

.search-box input {
    width: 100%;
    padding: 12px 16px 12px 48px;
    border: 2px solid var(--gray-light);
    border-radius: var(--border-radius);
    font-size: 0.95rem;
    transition: var(--transition);
}

.search-box input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
}

/* Section de recherche avancée harmonisée avec l'admin */
.search-section {
    background: var(--bg-card);
    border-radius: var(--border-radius-lg);
    padding: 20px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-color);
}

.search-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.search-header-title {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: var(--font-weight-semibold);
}

.btn-toggle-search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--bg-secondary);
    border: none;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: var(--font-weight-medium);
    color: var(--text-secondary);
    transition: var(--transition-base);
}

.btn-toggle-search:hover {
    background: var(--bg-primary);
}

.btn-toggle-search i {
    transition: transform 0.3s ease;
}

.btn-toggle-search.active i {
    transform: rotate(180deg);
}

.search-form {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-light);
    transition: all 0.3s ease;
}

.search-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 20px;
}

.search-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.search-field label {
    font-size: 0.85rem;
    font-weight: var(--font-weight-medium);
    color: var(--text-primary);
}

@media (max-width: 1200px) {
    .search-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .search-grid {
        grid-template-columns: 1fr;
    }
}

.form-input {
    padding: 10px 12px;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-size: 0.9rem;
    font-family: var(--font-family);
    transition: var(--transition-base);
    background: var(--bg-secondary);
    color: var(--text-primary);
}

.form-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

/* Résumé des filtres actifs */
.active-filters {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 20px;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.active-filters-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: var(--font-weight-semibold);
}

.active-filters-label i {
    color: var(--accent);
}

.active-filters-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.filter-chip {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
}

/* Filtres avancés */
.advanced-filters {
    background: var(--bg-card);
    border-radius: var(--border-radius-lg);
    padding: 24px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-color);
}

.advanced-filters .search-form.is-hidden {
    display: none;
}

.filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 24px;
}

.filter-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.filter-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    font-size: 0.9rem;
}

.filter-label i {
    color: var(--accent);
}

.date-range,
.price-range {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.date-input,
.price-input {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.date-input label,
.price-input label {
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.date-input input,
.filter-group input,
.filter-group select {
    padding: 10px 12px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.date-input input:focus,
.filter-group input:focus,
.filter-group select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.1);
}

.input-with-unit {
    position: relative;
    display: flex;
    align-items: center;
}

.input-with-unit input {
    flex: 1;
    padding-right: 40px;
}

.input-with-unit span {
    position: absolute;
    right: 12px;
    color: var(--gray);
    font-size: 0.9rem;
}

.filter-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--gray-light);
}

/* Contrôles d'affichage */
.view-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding: 16px;
    background: var(--bg-card);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-color);
}

.sort-controls {
    display: flex;
    align-items: center;
    gap: 12px;
}

.sort-select {
    padding: 8px 12px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 0.9rem;
    background: var(--bg-secondary);
    color: var(--text-primary);
    cursor: pointer;
    min-width: 220px;
}

.sort-select option {
    color: var(--text-primary);
    background: var(--bg-card);
}

.view-options {
    display: flex;
    gap: 4px;
    background: var(--bg-secondary);
    padding: 4px;
    border-radius: 8px;
}

.view-option {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text-secondary);
    transition: all 0.3s ease;
}

.view-option.active {
    background: var(--bg-card);
    color: var(--accent);
    box-shadow: var(--shadow-md);
}

/* Grille d'événements */
.events-container {
    min-height: 400px;
    position: relative;
    overflow: visible;
}

.events-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 40px;
    overflow: visible;
}

.list-view .events-grid {
    grid-template-columns: 1fr;
}

.list-view .event-card {
    flex-direction: row;
}

.list-view .event-card-image {
    width: 200px;
    height: 200px;
    flex-shrink: 0;
}

.list-view .event-card-body {
    flex: 1;
}

/* Carte d'événement */
.event-card {
    background: var(--bg-card);
    border-radius: var(--border-radius-lg);
    /* important: ne pas couper le menu déroulant des actions */
    overflow: visible;
    box-shadow: var(--shadow-md);
    transition: all 0.3s ease;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.event-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.event-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px 16px 0;
}

.event-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.event-category {
    background: var(--accent);
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
}

.event-status {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: var(--font-weight-semibold);
    display: flex;
    align-items: center;
    gap: 4px;
}

.status-published { background: rgba(6, 214, 160, 0.1); color: var(--success); }
.status-draft { background: rgba(251, 191, 36, 0.1); color: #fbbf24; }
.status-cancelled { background: rgba(239, 71, 111, 0.1); color: var(--danger); }

.event-actions {
    display: flex;
    align-items: center;
    gap: 6px;
}

.event-action-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
}

.event-action-btn:hover {
    background: var(--bg-card);
    color: var(--accent);
    box-shadow: var(--shadow-sm);
}

.event-action-danger {
    color: var(--danger);
}

.event-action-danger:hover {
    color: #fff;
    background: var(--danger);
}

.dropdown-menu a,
.dropdown-menu .dropdown-item-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: var(--transition);
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
}

.dropdown-menu a:hover,
.dropdown-menu .dropdown-item-btn:hover {
    background: var(--bg-secondary);
}

.dropdown-menu a.text-danger {
    color: var(--danger);
}

/* Image de l'événement */
.event-card-image {
    position: relative;
    height: 200px;
    overflow: hidden;
}

.event-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.event-card:hover .event-card-image img {
    transform: scale(1.05);
}

.event-image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
}

.event-card:hover .event-image-overlay {
    opacity: 1;
}

.btn-quick-view {
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--dark);
    cursor: pointer;
    transition: var(--transition);
}

.btn-quick-view:hover {
    background: white;
    transform: scale(1.1);
}

/* Corps de la carte */
.event-card-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.event-title {
    font-size: 1.2rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
}

.event-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.meta-item i {
    width: 16px;
    color: var(--accent);
}

.event-description {
    font-size: 0.9rem;
    color: var(--text-primary);
    line-height: 1.5;
    flex: 1;
}

.event-stats {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--gray-light);
    border-bottom: 1px solid var(--gray-light);
}

.stat {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.stat i {
    color: var(--accent);
}

.event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.tag {
    background: var(--bg-secondary);
    color: var(--text-secondary);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
}

/* Pied de carte */
.event-card-footer {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 16px 20px;
    background: linear-gradient(to bottom, transparent, rgba(67, 97, 238, 0.02));
    border-top: 1px solid var(--border-color);
    margin-top: 12px;
}

.event-price {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    align-items: center;
}

.price-label-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
}

.price-label-line i {
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.price-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
}

.price-value {
    font-size: 1.2rem;
    font-weight: var(--font-weight-bold);
    color: var(--accent);
}

.price-section {
    width: 100%;
    text-align: center;
}

.price-section-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 12px;
    font-size: 0.8rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.price-section-header i {
    font-size: 0.85rem;
    color: var(--accent);
}

.price-section-title {
    font-size: 0.8rem;
}

.price-badges {
    display: flex;
    flex-wrap: nowrap;
    gap: 6px;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    overflow-x: auto;
    padding: 2px 0 4px;
    scrollbar-width: thin;
    scrollbar-color: rgba(67, 97, 238, 0.3) transparent;
    -ms-overflow-style: none;
}

.price-badges::-webkit-scrollbar {
    height: 4px;
}

.price-badges::-webkit-scrollbar-track {
    background: transparent;
}

.price-badges::-webkit-scrollbar-thumb {
    background: rgba(67, 97, 238, 0.3);
    border-radius: 2px;
}

.price-badges::-webkit-scrollbar-thumb:hover {
    background: rgba(67, 97, 238, 0.5);
}

.price-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7px 9px;
    background: linear-gradient(135deg, rgba(67, 97, 238, 0.08) 0%, rgba(67, 97, 238, 0.03) 100%);
    border: 2px solid rgba(67, 97, 238, 0.2);
    border-radius: 10px;
    min-width: 68px;
    max-width: 85px;
    width: auto;
    flex: 0 0 auto;
    transition: all 0.3s ease;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.06);
    position: relative;
    overflow: hidden;
}

.price-badge::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), rgba(67, 97, 238, 0.3));
    opacity: 0;
    transition: opacity 0.3s ease;
}

.price-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(67, 97, 238, 0.15);
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(67, 97, 238, 0.1) 0%, rgba(67, 97, 238, 0.05) 100%);
}

.price-badge:hover::before {
    opacity: 1;
}

.price-badge-name {
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.4px;
    margin-bottom: 3px;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.price-badge-value {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1.2;
    margin-bottom: 1px;
    white-space: nowrap;
}

.price-badge-currency {
    font-size: 0.65rem;
    color: var(--text-secondary);
    font-weight: var(--font-weight-semibold);
    margin-top: 1px;
    opacity: 0.85;
    white-space: nowrap;
}

.btn {
    padding: 8px 16px;
    border-radius: 8px;
    border: none;
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.btn-sm {
    padding: 6px 12px;
    font-size: 0.8rem;
}

.btn-primary {
    background: var(--accent);
    color: white;
}

.btn-primary:hover {
    background: var(--accent-dark);
}

.btn-outline {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
}

.btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
}

.btn-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover {
    background: var(--bg-secondary);
    border-color: var(--accent);
    color: var(--accent);
}

/* Bloc méta bas : compteur + prix alignés à droite comme un ticket */
.event-bottom-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    padding: 0 20px 16px;
}

/* Barre de progression */
.event-progress {
    width: 260px;
}

.progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--gray);
    margin-bottom: 4px;
}

.progress-bar {
    height: 6px;
    background: var(--gray-light);
    border-radius: 3px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: var(--success);
    border-radius: 3px;
    transition: width 0.3s ease;
}

.progress-bar.active .progress-fill {
    background: var(--primary);
}

/* État vide */
.empty-state {
    text-align: center;
    padding: 80px 40px;
    background: white;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
}

.empty-state-icon {
    width: 80px;
    height: 80px;
    background: var(--light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
}

.empty-state-icon i {
    font-size: 2rem;
    color: var(--primary);
}

.empty-state h3 {
    font-size: 1.5rem;
    color: var(--dark);
    margin-bottom: 12px;
}

.empty-state p {
    color: var(--gray);
    margin-bottom: 24px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
}

/* Modal de partage */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal.active {
    display: flex;
}

.modal-content {
    background: white;
    border-radius: var(--border-radius);
    width: 90%;
    max-width: 500px;
    animation: modalSlideIn 0.3s ease;
}

@keyframes modalSlideIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid var(--gray-light);
}

.modal-header h3 {
    margin: 0;
    color: var(--dark);
}

.modal-close {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--gray);
}

.modal-body {
    padding: 20px;
}

.share-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 24px;
}

.share-option {
    padding: 16px;
    border: 1px solid var(--gray-light);
    border-radius: 8px;
    background: white;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.9rem;
}

.share-option:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
}

.share-option[data-platform="facebook"] {
    border-color: #1877f2;
    color: #1877f2;
}

.share-option[data-platform="twitter"] {
    border-color: #1da1f2;
    color: #1da1f2;
}

.share-option[data-platform="whatsapp"] {
    border-color: #25d366;
    color: #25d366;
}

.share-option[data-platform="copy"] {
    border-color: var(--primary);
    color: var(--primary);
}

.share-link {
    display: flex;
    gap: 8px;
}

.share-link input {
    flex: 1;
    padding: 12px;
    border: 1px solid var(--gray-light);
    border-radius: 8px;
    font-size: 0.9rem;
}

.btn-copy {
    padding: 12px 20px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: var(--transition);
}

.btn-copy:hover {
    background: var(--primary-dark);
}

/* Responsive */
@media (max-width: 768px) {
    .dashboard-header {
        flex-direction: column;
    }
    
    .header-actions {
        width: 100%;
        justify-content: flex-start;
    }
    
    .quick-search {
        flex-direction: column;
    }
    
    .events-grid {
        grid-template-columns: 1fr;
    }
    
    .filters-grid {
        grid-template-columns: 1fr;
    }
    
    .share-options {
        grid-template-columns: 1fr;
    }
    
    .list-view .event-card {
        flex-direction: column;
    }
    
    .list-view .event-card-image {
        width: 100%;
        height: 200px;
    }
    
    .event-card-footer {
        padding: 12px 16px;
    }
    
    .price-badges {
        gap: 6px;
        justify-content: flex-start;
        padding-bottom: 4px;
    }
    
    .price-badge {
        min-width: 65px;
        max-width: 80px;
        padding: 6px 8px;
    }
    
    .price-badge-name {
        font-size: 0.65rem;
        margin-bottom: 2px;
    }
    
    .price-badge-value {
        font-size: 0.85rem;
    }
    
    .price-badge-currency {
        font-size: 0.6rem;
    }
    
    .price-section-header {
        font-size: 0.75rem;
        margin-bottom: 10px;
    }
}

@media (max-width: 480px) {
    .events-stats {
        flex-direction: column;
    }
    
    .stat-item {
        width: 100%;
        justify-content: space-between;
    }
    
    .view-controls {
        flex-direction: column;
        gap: 16px;
        align-items: stretch;
    }
    
    .sort-controls {
        flex-direction: column;
        align-items: stretch;
    }
    
    .price-badges {
        gap: 5px;
    }
    
    .price-badge {
        min-width: 60px;
        max-width: 75px;
        padding: 5px 7px;
    }
    
    .price-badge-name {
        font-size: 0.6rem;
    }
    
    .price-badge-value {
        font-size: 0.8rem;
    }
    
    .price-badge-currency {
        font-size: 0.55rem;
    }
}

/* Modal suppression événement */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 3000;
    padding: 16px;
}

.modal-overlay.active {
    display: flex;
}

.modal-content {
    background: var(--white);
    border-radius: var(--border-radius-lg);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.2);
    max-width: 460px;
    width: 100%;
    overflow: hidden;
}

.modal-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--gray-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.modal-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: var(--font-weight-bold);
    color: var(--gray-900);
    font-size: 1rem;
}

.modal-title i {
    color: var(--warning);
}

.modal-close {
    background: transparent;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    color: var(--gray-600);
}

.modal-body {
    padding: 18px 20px 6px;
    color: var(--gray-800);
    line-height: 1.5;
}

.modal-warning {
    color: var(--danger);
    font-weight: var(--font-weight-semibold);
    margin-top: 8px;
}

.modal-footer {
    padding: 14px 20px 18px;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    border-top: 1px solid var(--gray-200);
}

.btn-filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: var(--border-radius-md);
    font-weight: var(--font-weight-semibold);
    font-size: 0.95rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 44px;
    box-sizing: border-box;
}

.btn-filter-primary {
    background: linear-gradient(135deg, #e74c3c, #c0392b);
    color: white;
    box-shadow: 0 2px 8px rgba(231, 76, 60, 0.25);
}

.btn-filter-primary:hover {
    background: linear-gradient(135deg, #c0392b, #a93226);
    box-shadow: 0 4px 12px rgba(231, 76, 60, 0.35);
}

.btn-filter-secondary {
    background: var(--gray-100);
    color: var(--gray-800);
    border: 1px solid var(--gray-300);
}

.btn-filter-secondary:hover {
    background: var(--gray-200);
}
</style>
{% endblock %}

{% block body %}
<div class="dashboard">
    <!-- En-tête de la page -->
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-calendar-alt"></i> Mes événements</h1>
            <p data-i18n="events.header.subtitle">
                Gérez tous vos événements et collaborations
            </p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" onclick="window.location.href='{{ path('app_event_new') }}'" data-i18n="events.actions.new">
                <i class="fas fa-plus"></i>
                Nouvel événement
            </button>
            <a href="{{ path('organisateur_events_calendar') }}" class="btn btn-secondary" data-i18n="events.actions.calendar">
                <i class="fas fa-calendar-alt"></i>
                Vue calendrier
            </a>
        </div>
    </div>

    <!-- Filtres avancés (structure harmonisée avec la liste des utilisateurs) -->
    <div class="search-section advanced-filters" id="advancedFilters">
        <div class="search-header">
            <h3 class="search-header-title">
                <i class="fas fa-filter"></i>
                <span data-i18n="events.filters.title">Recherche multicritère</span>
            </h3>
            <button class="btn-toggle-search" id="toggleAdvancedSearch" type="button" data-i18n="events.filters.toggle.hide">
                <i class="fas fa-sliders-h"></i>
                Masquer les filtres
            </button>
        </div>

        <div class="search-form" id="eventSearchFormWrapper">
            <form id="eventSearchForm" method="GET" action="{{ path('organisateur_events_index') }}">
                <div class="search-grid">
                    <div class="search-field">
                        <div class="date-range">
                            <div class="search-field">
                                <label data-i18n="events.filters.date.from">Du</label>
                                <input type="date" name="dateDebut" class="form-input js-date-picker" placeholder="jj/mm/aaaa" value="{{ criteria.dateDebut ? criteria.dateDebut|date('Y-m-d') : '' }}">
                            </div>
                            <div class="search-field">
                                <label data-i18n="events.filters.date.to">Au</label>
                                <input type="date" name="dateFin" class="form-input js-date-picker" placeholder="jj/mm/aaaa" value="{{ criteria.dateFin ? criteria.dateFin|date('Y-m-d') : '' }}">
                            </div>
                        </div>
                    </div>

                    <div class="search-field">
                        <label data-i18n="events.filters.venue">
                            Lieu
                        </label>
                        <select name="lieuId" class="form-input">
                            <option value="">Tous les lieux</option>
                            {% for venue in venues %}
                                <option value="{{ venue.id }}" {% if criteria.lieuId is defined and criteria.lieuId == venue.id %}selected{% endif %}>
                                    {{ venue.nom }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n="events.filters.type">
                            Type d'événement
                        </label>
                        <select name="typeEvenementId" class="form-input">
                            <option value="">Tous les types</option>
                            {% for eventType in eventTypes %}
                                <option value="{{ eventType.id }}" {% if criteria.typeEvenementId is defined and criteria.typeEvenementId == eventType.id %}selected{% endif %}>
                                    {{ eventType.label }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n="events.filters.status">
                            Statut
                        </label>
                        <select name="statut" class="form-input">
                            <option value="">Tous les statuts</option>
                            {% for statusValue, statusLabel in eventStatuses %}
                                <option value="{{ statusValue }}" {% if criteria.statut is defined and criteria.statut == statusValue %}selected{% endif %}>
                                    {{ statusLabel }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="search-field">
                        <label data-i18n="events.filters.budget.min">
                            Budget min
                        </label>
                        <div class="input-with-unit">
                            <input type="number" name="prixMin" min="0" class="form-input" placeholder="0" value="{{ criteria.prixMin ?? '' }}">
                            <span>MGA</span>
                        </div>
                    </div>

                    <div class="search-field">
                        <label data-i18n="events.filters.budget.max">
                            Budget max
                        </label>
                        <div class="input-with-unit">
                            <input type="number" name="prixMax" min="0" class="form-input" placeholder="500,000" value="{{ criteria.prixMax ?? '' }}">
                            <span>MGA</span>
                        </div>
                    </div>

                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary" data-i18n="events.filters.apply">
                        <i class="fas fa-search"></i>
                        Appliquer les filtres
                    </button>
                    <button type="reset" class="btn btn-secondary" id="resetFilters" data-i18n="events.filters.reset">
                        <i class="fas fa-redo"></i>
                        Réinitialiser
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Contrôles d'affichage -->
    <div class="view-controls">
        <div class="sort-controls">
            <label data-i18n="events.sort.label">Trier par :</label>
            <select name="triPrix" id="sortEvents" class="sort-select" form="eventSearchForm">
                <option value="" {% if criteria.triPrix is empty or criteria.triPrix is null %}selected{% endif %}>Plus de vues</option>
                <option value="asc" {% if criteria.triPrix == 'asc' %}selected{% endif %} data-i18n="events.sort.price.asc">Prix croissant</option>
                <option value="desc" {% if criteria.triPrix == 'desc' %}selected{% endif %} data-i18n="events.sort.price.desc">Prix décroissant</option>
            </select>
        </div>
        <div class="view-options">
            <button class="view-option active" data-view="grid">
                <i class="fas fa-th-large"></i>
            </button>
            <button class="view-option" data-view="list">
                <i class="fas fa-list"></i>
            </button>
        </div>
    </div>

    <!-- Liste des événements -->
    <div class="events-container" id="eventsContainer">
        {% if events|length > 0 %}
            <div class="events-grid" id="eventsGrid">
                {% for event in events %}
                    <div class="event-card" data-event-id="{{ event.id }}">
                        <!-- En-tête de la carte -->
                        <div class="event-card-header">
                            <div class="event-badges">
                                <span class="event-category">
                                    {% if event.typeEvenement %}
                                        {{ event.typeEvenement.label }}
                                    {% else %}
                                        Événement
                                    {% endif %}
                                </span>
                                {% set statusKey = '' %}
                                {% set statusIcon = '' %}
                                {% set statusLabel = '' %}
                                {% if event.statut == 'published' and event.commenceLe and event.commenceLe <= date() and event.seTermineLe >= date() %}
                                    {% set statusKey = 'events.status.live' %}
                                    {% set statusIcon = 'fas fa-circle' %}
                                    {% set statusLabel = 'EN COURS' %}
                                {% elseif event.statut == 'published' and event.commenceLe and event.commenceLe > date() %}
                                    {% set statusKey = 'events.status.upcoming' %}
                                    {% set statusIcon = 'fas fa-clock' %}
                                    {% set statusLabel = 'À VENIR' %}
                                {% elseif event.statut == 'cancelled' %}
                                    {% set statusKey = 'events.status.cancelled' %}
                                    {% set statusIcon = 'fas fa-times-circle' %}
                                    {% set statusLabel = 'ANNULÉ' %}
                                {% elseif event.statut == 'draft' %}
                                    {% set statusKey = 'events.status.draft' %}
                                    {% set statusIcon = 'fas fa-edit' %}
                                    {% set statusLabel = 'BROUILLON' %}
                                {% elseif event.statut == 'archived' %}
                                    {% set statusKey = 'events.status.archived' %}
                                    {% set statusIcon = 'fas fa-archive' %}
                                    {% set statusLabel = 'ARCHIVÉ' %}
                                {% elseif event.statut == 'published' %}
                                    {% set statusKey = 'events.status.published' %}
                                    {% set statusIcon = 'fas fa-check-circle' %}
                                    {% set statusLabel = 'PUBLIÉ' %}
                                {% else %}
                                    {% set statusKey = 'events.status.other' %}
                                    {% set statusIcon = 'fas fa-info-circle' %}
                                    {% set statusLabel = event.statut|upper %}
                                {% endif %}
                                <span class="event-status status-{{ event.statut }}" data-i18n="{{ statusKey }}">
                                    <i class="{{ statusIcon }}"></i> {{ statusLabel }}
                                </span>
                            </div>
                            
                            <div class="event-actions">
                                {# Actions visibles en permanence au lieu d'un dropdown #}
                                <a
                                    href="{{ path('organisateur_events_show', {'id': event.id}) }}"
                                    class="event-action-btn"
                                    title="Voir les détails"
                                    aria-label="Voir les détails de l'événement"
                                >
                                    <i class="fas fa-eye"></i>
                                </a>
                                {# Bouton historique des ventes détaillé #}
                                <a
                                    href="{{ path('organisateur_tickets_index', {'eventId': event.id}) }}"
                                    class="event-action-btn"
                                    title="Historique des ventes"
                                    aria-label="Voir l'historique des ventes"
                                >
                                    <i class="fas fa-file-invoice-dollar"></i>
                                </a>
                                {# Afficher le bouton de modification uniquement pour les événements en cours ou à venir #}
                                {% set isOngoing = event.statut == 'published' and event.commenceLe and event.commenceLe <= date() and (event.seTermineLe is null or event.seTermineLe >= date()) %}
                                {% set isUpcoming = event.statut == 'published' and event.commenceLe and event.commenceLe > date() %}
                                {% if isOngoing or isUpcoming %}
                                    <a
                                        href="{{ path('organisateur_events_edit', {'id': event.id}) }}"
                                        class="event-action-btn"
                                        title="Modifier l'événement"
                                        aria-label="Modifier l'événement"
                                    >
                                        <i class="fas fa-edit"></i>
                                    </a>
                                {% endif %}
                                {% if event.statut == 'draft' %}
                                    <form
                                        method="POST"
                                        action="{{ path('organisateur_events_delete', {'id': event.id}) }}"
                                        style="display: inline;"
                                        class="event-delete-form"
                                        data-event-title="{{ event.titre ?? 'cet événement' }}"
                                    >
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                                        <button
                                            type="submit"
                                            class="event-action-btn event-action-danger"
                                            title="Supprimer l'événement"
                                            aria-label="Supprimer l'événement"
                                        >
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Image de l'événement -->
                        <div class="event-card-image">
                            {% set eventMedias = eventsMedias[event.id] ?? [] %}
                            {% set primaryImage = eventMedias|filter(m => m.isMainPoster)|first %}
                            {% set imageUrl = primaryImage ? primaryImage.url : (event.urlImageCouverture ?: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80') %}
                            <img src="{{ imageUrl }}" alt="{{ event.titre }}">
                            <div class="event-image-overlay">
                                <button class="btn-quick-view" data-event-id="{{ event.id }}">
                                    <i class="fas fa-expand"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Corps de la carte -->
                        <div class="event-card-body">
                            <h3 class="event-title">{{ event.titre }}</h3>
                            
                            <div class="event-meta">
                                <div class="meta-item">
                                    <i class="fas fa-calendar-alt"></i>
                                    {% if event.commenceLe %}
                                        {{ event.commenceLe|date('d/m/Y') }}
                                        à {{ event.commenceLe|date('H:i') }}
                                    {% else %}
                                        <span data-i18n="events.card.date.undefined">Date non définie</span>
                                    {% endif %}
                                </div>
                                
                                <div class="meta-item">
                                    <i class="fas fa-map-marker-alt"></i>
                                    {% if event.lieu %}
                                        {{ event.lieu.nom|length > 30 ? event.lieu.nom|slice(0, 30) ~ '…' : event.lieu.nom }}
                                    {% elseif event.nomLieuTexte %}
                                        {{ event.nomLieuTexte|length > 30 ? event.nomLieuTexte|slice(0, 30) ~ '…' : event.nomLieuTexte }}
                                    {% else %}
                                        <span data-i18n="events.card.location.undefined">Lieu non spécifié</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="event-description">
                                {% set cleanDescription = event.description|striptags %}
                                {{ cleanDescription|length > 120 ? cleanDescription|slice(0, 120) ~ '…' : cleanDescription }}
                            </div>

                            <div class="event-stats">
                                {% set stats = eventsStats[event.id] ?? {'totalTickets': 0, 'soldTickets': 0, 'participantsCount': 0, 'minPrice': null, 'viewsCount': 0, 'favoritesCount': 0} %}
                                <div class="stat">
                                    <i class="fas fa-ticket-alt"></i>
                                    <span>{{ stats.soldTickets }} / {{ stats.totalTickets }}</span>
                                </div>
                                <div class="stat">
                                    <i class="fas fa-eye"></i>
                                    <span>{{ stats.viewsCount|default(0) }} <span data-i18n="events.card.views.label">vues</span></span>
                                </div>
                                <div class="stat">
                                    <i class="fas fa-heart"></i>
                                    <span>{{ stats.favoritesCount|default(0) }} <span data-i18n="events.card.favorites.label">favoris</span></span>
                                </div>
                                <div class="stat">
                                    <i class="fas fa-users"></i>
                                    <span>{{ stats.participantsCount|default(0) }} <span data-i18n="events.card.participants">participants</span></span>
                                </div>
                            </div>

                            <div class="event-tags">
                                {% if event.categoriePrincipale %}
                                    <span class="tag">{{ event.categoriePrincipale.label }}</span>
                                {% endif %}
                                {% if event.formatEvenement %}
                                    <span class="tag">{{ event.formatEvenement|replace({'_': ' '})|title }}</span>
                                {% endif %}
                            </div>
                        </div>

                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-calendar-plus"></i>
                </div>
                <h3 data-i18n="events.empty.title">Aucun événement trouvé</h3>
                <p>
                    {% if criteria|length > 0 %}
                        <span data-i18n="events.empty.filtered">Aucun événement ne correspond à vos critères de recherche.</span>
                    {% else %}
                        <span data-i18n="events.empty.none">Vous n'avez pas encore créé d'événement.</span>
                    {% endif %}
                </p>
                <a href="{{ path('app_event_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    <span data-i18n="events.empty.cta">Créer mon premier événement</span>
                </a>
            </div>
        {% endif %}
    </div>

    <!-- Pagination -->
    {% if pagination.total > pagination.limit %}
        {% include 'components/pagination.html.twig' with {
            'pagination': pagination,
            'route': 'organisateur_events_index',
            'criteria': criteria
        } %}
    {% endif %}
</div>

{# Modal de confirmation suppression événement #}
<div id="deleteEventModal" class="modal-overlay" aria-hidden="true">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title">
                <i class="fas fa-exclamation-triangle"></i>
                Confirmer la suppression
            </div>
            <button type="button" class="modal-close" aria-label="Fermer">&times;</button>
        </div>
        <div class="modal-body">
            <p id="deleteEventMessage">Voulez-vous supprimer cet événement ?</p>
            <p class="modal-warning">Cette action est définitive.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-filter btn-filter-secondary modal-cancel">Annuler</button>
            <button type="button" class="btn-filter btn-filter-primary modal-confirm">Supprimer</button>
        </div>
    </div>
</div>

<!-- Modal de partage -->
<div class="modal" id="shareModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Partager l'événement</h3>
            <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <div class="share-options">
                <button class="share-option" data-platform="facebook">
                    <i class="fab fa-facebook"></i>
                    Facebook
                </button>
                <button class="share-option" data-platform="twitter">
                    <i class="fab fa-twitter"></i>
                    Twitter
                </button>
                <button class="share-option" data-platform="whatsapp">
                    <i class="fab fa-whatsapp"></i>
                    WhatsApp
                </button>
                <button class="share-option" data-platform="copy">
                    <i class="fas fa-link"></i>
                    Copier le lien
                </button>
            </div>
            <div class="share-link">
                <input type="text" id="shareUrl" readonly>
                <button class="btn-copy" id="copyUrl">
                    <i class="fas fa-copy"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
<script src="{{ asset('js/language-manager.js') }}"></script>
<script src="{{ asset('js/language-orgs.js') }}"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle des filtres avancés
    const toggleAdvancedSearch = document.getElementById('toggleAdvancedSearch');
    const searchFormWrapper = document.getElementById('eventSearchFormWrapper');
    
    if (toggleAdvancedSearch && searchFormWrapper) {
        toggleAdvancedSearch.addEventListener('click', function() {
            searchFormWrapper.classList.toggle('is-hidden');
            this.classList.toggle('active');
            
            if (searchFormWrapper.classList.contains('is-hidden')) {
                this.innerHTML = '<i class="fas fa-sliders-h"></i> Afficher les filtres';
            } else {
                this.innerHTML = '<i class="fas fa-times"></i> Masquer les filtres';
            }
        });
    }

    // Initialiser un calendrier sur les filtres de date (affichage jj/mm/aaaa)
    if (window.flatpickr) {
        flatpickr('.js-date-picker', {
            dateFormat: 'Y-m-d',          // format envoyé au backend
            altInput: true,               // champ visible séparé
            altFormat: 'd/m/Y',           // affichage jj/mm/aaaa
            allowInput: true,
            locale: window.flatpickr.l10ns.fr
        });
    }

    // Bouton réinitialiser : rediriger vers la page sans paramètres
    const resetFiltersBtn = document.getElementById('resetFilters');
    if (resetFiltersBtn) {
        resetFiltersBtn.addEventListener('click', function(e) {
            e.preventDefault();
            // Rediriger vers la page sans paramètres de requête
            const url = new URL(window.location.href);
            url.search = '';
            window.location.href = url.toString();
        });
    }

    // Changement de tri : soumettre le formulaire de recherche
    const sortSelect = document.getElementById('sortEvents');
    if (sortSelect) {
        sortSelect.addEventListener('change', function() {
            const form = document.getElementById('eventSearchForm');
            if (form) {
                form.submit();
            }
        });
    }

    // Limiter le nombre d'événements visibles à 6
    function applyEventLimit() {
        const container = document.getElementById('eventsGrid');
        if (!container) {
            return;
        }
        const cards = container.querySelectorAll('.event-card');
        cards.forEach((card, index) => {
            card.style.display = index < 6 ? '' : 'none';
        });
    }

    applyEventLimit();

    // Toggle vue grille/liste
    const viewOptions = document.querySelectorAll('.view-option');
    const eventsContainer = document.getElementById('eventsContainer');
    
    viewOptions.forEach(option => {
        option.addEventListener('click', function() {
            viewOptions.forEach(o => o.classList.remove('active'));
            this.classList.add('active');
            
            const view = this.dataset.view;
            eventsContainer.className = `events-container ${view}-view`;
            applyEventLimit();
        });
    });

    // Gestion des dropdowns (menu actions sur chaque carte)
    document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
        toggle.addEventListener('click', function(e) {
            e.stopPropagation();

            const currentDropdown = this.closest('.dropdown');
            const isActive = currentDropdown.classList.contains('active');

            // Fermer tous les autres menus
            document.querySelectorAll('.dropdown').forEach(dropdown => {
                dropdown.classList.remove('active');
            });

            // Ouvrir / fermer celui qu'on vient de cliquer
            if (!isActive) {
                currentDropdown.classList.add('active');
            }
        });
    });

    // Fermer les dropdowns uniquement si on clique en dehors
    document.addEventListener('click', function(e) {
        if (e.target.closest('.dropdown')) {
            return;
        }
        document.querySelectorAll('.dropdown').forEach(dropdown => {
            dropdown.classList.remove('active');
        });
    });

    // Partage d'événement
    document.querySelectorAll('.share-event').forEach(btn => {
        btn.addEventListener('click', function() {
            const eventId = this.dataset.eventId;
            const shareUrl = `${window.location.origin}/event/${eventId}`;
            openShareModal(shareUrl);
        });
    });

    // Modal de partage
    const shareModal = document.getElementById('shareModal');
    if (shareModal) {
        document.querySelector('.modal-close').addEventListener('click', () => {
            shareModal.classList.remove('active');
        });

        shareModal.addEventListener('click', (e) => {
            if (e.target === shareModal) {
                shareModal.classList.remove('active');
            }
        });

        document.getElementById('copyUrl').addEventListener('click', function() {
            const urlInput = document.getElementById('shareUrl');
            urlInput.select();
            document.execCommand('copy');
            
            // Feedback visuel
            const originalText = this.innerHTML;
            this.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(() => {
                this.innerHTML = originalText;
            }, 2000);
        });

        document.querySelectorAll('.share-option').forEach(option => {
            option.addEventListener('click', function() {
                const platform = this.dataset.platform;
                const url = document.getElementById('shareUrl').value;
                
                switch(platform) {
                    case 'facebook':
                        window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank');
                        break;
                    case 'twitter':
                        window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}`, '_blank');
                        break;
                    case 'whatsapp':
                        window.open(`https://wa.me/?text=${encodeURIComponent(url)}`, '_blank');
                        break;
                }
            });
        });
    }

    // Fonctions utilitaires
    // Modal de suppression événement (remplace confirm natif)
    const deleteModal = document.getElementById('deleteEventModal');
    const deleteMessage = document.getElementById('deleteEventMessage');
    const btnCancel = deleteModal?.querySelector('.modal-cancel');
    const btnConfirm = deleteModal?.querySelector('.modal-confirm');
    const btnClose = deleteModal?.querySelector('.modal-close');
    let formToSubmit = null;

    const openDeleteModal = (form) => {
        formToSubmit = form;
        const title = form.dataset.eventTitle || 'cet événement';
        if (deleteMessage) {
            deleteMessage.textContent = `Voulez-vous supprimer ${title} ?`;
        }
        deleteModal?.classList.add('active');
        deleteModal?.setAttribute('aria-hidden', 'false');
    };

    const closeDeleteModal = () => {
        formToSubmit = null;
        deleteModal?.classList.remove('active');
        deleteModal?.setAttribute('aria-hidden', 'true');
    };

    document.querySelectorAll('.event-delete-form').forEach(form => {
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            openDeleteModal(form);
        });
    });

    btnCancel?.addEventListener('click', closeDeleteModal);
    btnClose?.addEventListener('click', closeDeleteModal);
    deleteModal?.addEventListener('click', (e) => {
        if (e.target === deleteModal) closeDeleteModal();
    });

    btnConfirm?.addEventListener('click', () => {
        if (formToSubmit) {
            formToSubmit.submit();
        }
        closeDeleteModal();
    });

    function sortEventCards(sortBy) {
        const container = document.getElementById('eventsGrid');
        const cards = Array.from(container.querySelectorAll('.event-card'));
        
        cards.sort((a, b) => {
            switch(sortBy) {
                case 'asc':
                    // Prix croissant
                    const priceA = parseFloat(a.querySelector('.price-value')?.textContent?.replace(/\s/g, '') || 0);
                    const priceB = parseFloat(b.querySelector('.price-value')?.textContent?.replace(/\s/g, '') || 0);
                    return priceA - priceB;
                    
                case 'desc':
                    // Prix décroissant
                    const priceC = parseFloat(a.querySelector('.price-value')?.textContent?.replace(/\s/g, '') || 0);
                    const priceD = parseFloat(b.querySelector('.price-value')?.textContent?.replace(/\s/g, '') || 0);
                    return priceD - priceC;
                    
                default:
                    // Par défaut, trier par nombre de vues (décroissant)
                    const viewsA = parseInt(a.querySelector('.meta-item span')?.textContent?.match(/\d+/)?.[0] || 0);
                    const viewsB = parseInt(b.querySelector('.meta-item span')?.textContent?.match(/\d+/)?.[0] || 0);
                    return viewsB - viewsA;
            }
        });
        
        cards.forEach(card => container.appendChild(card));
    }

    function openShareModal(url) {
        document.getElementById('shareUrl').value = url;
        shareModal.classList.add('active');
    }
});
</script>
{% endblock %}