<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ event.titre }} - Rapport PDF</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'DejaVu Sans', Arial, sans-serif;
            font-size: 9pt;
            color: #2c3e50;
            line-height: 1.4;
            background-color: #ffffff;
            margin: 0;
            padding: 10px;
        }
        
        .header {
            text-align: center;
            margin-bottom: 15px;
            padding: 15px 20px;
            background: linear-gradient(135deg, #3498DB 0%, #2980b9 100%);
            color: white;
            border-radius: 6px;
        }
        
        .header h1 {
            font-size: 22pt;
            font-weight: bold;
            margin-bottom: 5px;
            color: white;
        }
        
        .header .subtitle {
            font-size: 9pt;
            color: rgba(255, 255, 255, 0.95);
            font-weight: 500;
        }
        
        .section {
            margin-bottom: 20px;
            page-break-inside: avoid;
            background-color: #ffffff;
            padding: 15px;
            border: 1px solid #e0e0e0;
            border-radius: 6px;
        }
        
        .section-title {
            font-size: 15pt;
            color: #3498DB;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 2px solid #3498DB;
            font-weight: bold;
        }
        
        .info-grid {
            display: table;
            width: 100%;
            margin-bottom: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            overflow: hidden;
        }
        
        .info-row {
            display: table-row;
        }
        
        .info-label {
            display: table-cell;
            font-weight: bold;
            padding: 8px 10px;
            width: 30%;
            background-color: #f8f9fa;
            border-right: 1px solid #e0e0e0;
            color: #2c3e50;
            font-size: 8.5pt;
            vertical-align: top;
        }
        
        .info-value {
            display: table-cell;
            padding: 8px 10px;
            width: 70%;
            background-color: #ffffff;
            font-size: 8.5pt;
            vertical-align: top;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 8.5pt;
            border-radius: 4px;
            overflow: hidden;
        }
        
        table thead {
            background: linear-gradient(135deg, #3498DB 0%, #2980b9 100%);
            color: white;
        }
        
        table th {
            padding: 8px 10px;
            text-align: left;
            font-weight: bold;
            border: none;
            font-size: 8.5pt;
            color: #ffffff !important;
            background-color: transparent !important;
            text-transform: uppercase;
            letter-spacing: 0.2px;
        }
        
        table td {
            padding: 8px 10px;
            border: 1px solid #e8e8e8;
            background-color: #ffffff;
        }
        
        table tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }
        
        table tbody tr:hover {
            background-color: #e8f4f8;
            transition: background-color 0.2s;
        }
        
        table tfoot {
            background-color: #ecf0f1;
            font-weight: bold;
        }
        
        table tfoot td {
            background-color: #ecf0f1 !important;
            color: #2c3e50 !important;
            padding: 8px 10px;
            border-top: 2px solid #3498DB;
        }
        
        .text-right {
            text-align: right;
        }
        
        .text-center {
            text-align: center;
        }
        
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 10px;
            font-size: 7.5pt;
            font-weight: bold;
        }
        
        .badge-sold {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        
        .badge-available {
            background-color: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }
        
        .stats-summary {
            display: table;
            width: 100%;
            margin-top: 12px;
            margin-bottom: 15px;
            border-collapse: separate;
            border-spacing: 10px 0;
        }
        
        .stat-box {
            display: table-cell;
            width: 33.33%;
            padding: 12px 10px;
            text-align: center;
            border: 2px solid #3498DB;
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            border-radius: 6px;
        }
        
        .stat-value {
            font-size: 18pt;
            font-weight: bold;
            color: #3498DB;
            margin-bottom: 5px;
        }
        
        .stat-label {
            font-size: 8pt;
            color: #7f8c8d;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        
        .progress-bar {
            width: 100%;
            height: 18px;
            background-color: #ecf0f1;
            border-radius: 9px;
            overflow: hidden;
            border: 1px solid #ddd;
        }
        
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #3498DB 0%, #2ecc71 100%);
            min-width: 2px;
            border-radius: 9px;
        }
        
        .chart-container {
            margin: 15px 0;
            padding: 15px;
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
            border-radius: 6px;
            border: 1px solid #e0e0e0;
        }
        
        .chart-title {
            font-size: 11pt;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 12px;
            text-align: center;
            padding-bottom: 8px;
            border-bottom: 2px solid #3498DB;
        }
        
        .bar-chart {
            width: 100%;
            height: 220px;
            margin: 12px 0;
            display: block;
        }
        
        .pie-chart {
            width: 100%;
            max-width: 700px;
            height: 280px;
            margin: 12px auto;
            display: block;
        }
        
        .line-chart {
            width: 100%;
            height: 200px;
            margin: 12px 0;
            display: block;
        }
        
        .highlight-box {
            background: linear-gradient(135deg, #e8f4f8 0%, #f0f8fc 100%);
            padding: 12px;
            border-radius: 6px;
            border-left: 4px solid #3498DB;
            margin: 10px 0;
        }
        
        .footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 2px solid #e0e0e0;
            text-align: center;
            font-size: 7.5pt;
            color: #7f8c8d;
        }
        
        .page-break {
            page-break-before: always;
        }
        
        h3 {
            margin-top: 12px;
            margin-bottom: 8px;
            font-size: 11pt;
            color: #2c3e50;
            font-weight: bold;
            border-left: 3px solid #3498DB;
            padding-left: 8px;
        }
        
        .accessibility-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .accessibility-item {
            margin-bottom: 8px;
            padding-left: 20px;
            position: relative;
        }
        
        .accessibility-icon {
            position: absolute;
            left: 0;
            color: #27ae60;
            font-weight: bold;
            font-size: 10pt;
        }
        
        .info-compact {
            display: table;
            width: 100%;
            margin-bottom: 8px;
        }
        
        .info-compact-row {
            display: table-row;
        }
        
        .info-compact-label {
            display: table-cell;
            font-weight: bold;
            padding: 4px 8px;
            width: 30%;
            color: #2c3e50;
            font-size: 8pt;
        }
        
        .info-compact-value {
            display: table-cell;
            padding: 4px 8px;
            width: 70%;
            font-size: 8pt;
        }
    </style>
</head>
<body>
    <!-- En-tête -->
    <div class="header">
        <h1>{{ event.titre }}</h1>
        <div class="subtitle">Rapport d'événement complet - Généré le {{ "now"|date('d/m/Y à H:i') }}</div>
    </div>

    <!-- Section 1: Vue d'ensemble (show.html.twig) -->
    <div class="section">
        <h2 class="section-title">📄 Vue d'ensemble</h2>
        
        <!-- Description de l'événement -->
        <h3>Description de l'événement</h3>
        <div class="highlight-box" style="margin-bottom: 10px;">
            {% if event.description %}
                <div style="line-height: 1.5; color: #2c3e50; text-align: justify; font-size: 8.5pt;">{{ event.description|raw }}</div>
            {% elseif event.resume %}
                <div style="line-height: 1.5; color: #2c3e50; text-align: justify; font-size: 8.5pt;">{{ event.resume|raw }}</div>
            {% else %}
                <p style="color: #7f8c8d; font-style: italic; font-size: 8.5pt;">Aucune description détaillée n'a encore été renseignée pour cet événement.</p>
            {% endif %}
        </div>

        <!-- Accessibilité -->
        <h3>Accessibilité</h3>
        <div class="highlight-box" style="margin-bottom: 10px;">
            {% set accessLinks = event.liensAccessibilites ?? [] %}
            {% if accessLinks|length > 0 %}
                <ul class="accessibility-list">
                    {% for lien in accessLinks %}
                        <li class="accessibility-item">
                            <span class="accessibility-icon">✓</span>
                            <div>
                                <strong style="color: #2c3e50; font-size: 10pt;">{{ lien.typeAccessibilite.libelle }}</strong>
                                {% if lien.description %}
                                    <div style="font-size: 9pt; color: #7f8c8d; margin-top: 5px; line-height: 1.5;">
                                        {{ lien.description }}
                                    </div>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p style="color: #7f8c8d; font-style: italic;">Aucune information d'accessibilité spécifique n'a encore été ajoutée pour cet événement.</p>
            {% endif %}
        </div>
    </div>

    <!-- Section 2: Informations détaillées (information.html.twig) -->
    <div class="section page-break">
        <h2 class="section-title">📋 Informations détaillées</h2>
        
        <!-- Mise en page compacte à deux colonnes -->
        <div style="display: table; width: 100%; margin-bottom: 10px;">
            <div style="display: table-cell; width: 48%; padding-right: 10px; vertical-align: top;">
                <div class="info-grid" style="margin-bottom: 10px;">
                    <div class="info-row">
                        <div class="info-label">Date de début</div>
                        <div class="info-value">
                            {% if event.commenceLe %}
                                {{ event.commenceLe|date('d/m/Y H:i') }}
                            {% else %}
                                Non définie
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Date de fin</div>
                        <div class="info-value">
                            {% if event.seTermineLe %}
                                {{ event.seTermineLe|date('d/m/Y H:i') }}
                            {% else %}
                                Non définie
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Lieu</div>
                        <div class="info-value">
                            {% if event.lieu %}
                                {{ event.lieu.nom }}{% if event.lieu.ville %}, {{ event.lieu.ville }}{% endif %}
                            {% elseif event.nomLieuTexte %}
                                {{ event.nomLieuTexte }}
                            {% else %}
                                Non renseigné
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Catégorie</div>
                        <div class="info-value">
                            {% if event.categoriePrincipale %}
                                {{ event.categoriePrincipale.label }}
                            {% else %}
                                Aucune
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Statut</div>
                        <div class="info-value">{{ event.statut|upper }}</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Format</div>
                        <div class="info-value">
                            {% if event.formatEvenement %}
                                {{ event.formatEvenement|replace({'_': ' '})|title }}
                            {% else %}
                                Non défini
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            <div style="display: table-cell; width: 48%; padding-left: 10px; vertical-align: top;">
                <div class="info-grid" style="margin-bottom: 10px;">
                    <div class="info-row">
                        <div class="info-label">Visibilité</div>
                        <div class="info-value">
                            {% if event.visibilite %}
                                {{ event.visibilite|capitalize }}
                            {% else %}
                                Non définie
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Capacité</div>
                        <div class="info-value">
                            {% if event.capacite %}
                                {{ event.capacite }} places
                            {% else %}
                                Illimitée
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Créé le</div>
                        <div class="info-value">
                            {% if event.creeLe %}
                                {{ event.creeLe|date('d/m/Y H:i') }}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Modifié le</div>
                        <div class="info-value">
                            {% if event.modifieLe %}
                                {{ event.modifieLe|date('d/m/Y H:i') }}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Langue</div>
                        <div class="info-value">{{ event.codeLangue|default('fr-FR')|upper }}</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Fuseau horaire</div>
                        <div class="info-value">{{ event.fuseauHoraire|default('Indian/Antananarivo') }}</div>
                    </div>
                </div>
            </div>
        </div>

        {% if primaryOrganizer or (coOrganizers is defined and coOrganizers|length > 0) %}
            <h3>Équipe organisatrice</h3>
            <div class="info-grid" style="margin-bottom: 0;">
                {% if primaryOrganizer %}
                    <div class="info-row">
                        <div class="info-label">Organisateur principal</div>
                        <div class="info-value">{{ primaryOrganizer.nomAffichage }}</div>
                    </div>
                {% endif %}
                {% if coOrganizers is defined and coOrganizers|length > 0 %}
                    {% for organizer in coOrganizers %}
                        {% if primaryOrganizer is not defined or organizer.id != primaryOrganizer.id %}
                            <div class="info-row">
                                <div class="info-label">Co-organisateur {{ loop.index }}</div>
                                <div class="info-value">{{ organizer.nomAffichage }}</div>
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </div>
        {% endif %}
    </div>

    <!-- Section 3: Statistiques (statistics.html.twig) -->
    <div class="section page-break">
        <h2 class="section-title">📊 Statistiques de ventes</h2>
        
        {% if ticketTypes is defined and ticketTypes|length > 0 %}
            {% set totalRevenue = 0 %}
            {% set totalSold = 0 %}
            {% set totalStock = 0 %}
            {% for ticket in ticketTypes %}
                {% set inventaire = ticket.inventaire %}
                {% set total = inventaire ? inventaire.quantiteTotale : 0 %}
                {% set vendus = inventaire ? inventaire.quantiteVendue : 0 %}
                {% set totalRevenue = totalRevenue + (vendus * ticket.prixDeBase) %}
                {% set totalSold = totalSold + vendus %}
                {% set totalStock = totalStock + total %}
            {% endfor %}
            {% set tauxVente = totalStock > 0 ? ((totalSold / totalStock) * 100)|round(1) : 0 %}

            <!-- Résumé des statistiques -->
            <div class="stats-summary">
                <div class="stat-box">
                    <div class="stat-value">{{ totalRevenue|number_format(0, ',', ' ') }}</div>
                    <div class="stat-label">{{ ticketTypes[0].devise|default('MGA') }} de revenus</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value">{{ totalSold }}</div>
                    <div class="stat-label">Billets vendus</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value">{{ totalStock - totalSold }}</div>
                    <div class="stat-label">Billets disponibles</div>
                </div>
            </div>

            <!-- Tableau récapitulatif -->
            <table>
                <thead>
                    <tr>
                        <th>Type de billet</th>
                        <th class="text-right">Prix unitaire</th>
                        <th class="text-center">Stock total</th>
                        <th class="text-center">Vendus</th>
                        <th class="text-center">Disponibles</th>
                        <th class="text-right">Revenus</th>
                        <th class="text-center">Taux de vente</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ticket in ticketTypes %}
                        {% set inventaire = ticket.inventaire %}
                        {% set total = inventaire ? inventaire.quantiteTotale : 0 %}
                        {% set vendus = inventaire ? inventaire.quantiteVendue : 0 %}
                        {% set disponibles = total - vendus %}
                        {% set revenue = vendus * ticket.prixDeBase %}
                        {% set tauxVenteTicket = total > 0 ? ((vendus / total) * 100)|round(1) : 0 %}
                        <tr>
                            <td>
                                <strong>{{ ticket.nom }}</strong>
                                {% if ticket.configurationCategorie %}
                                    <br><small style="color: #7f8c8d;">({{ ticket.configurationCategorie.nom|capitalize }})</small>
                                {% endif %}
                            </td>
                            <td class="text-right">{{ ticket.prixDeBase|number_format(0, ',', ' ') }} {{ ticket.devise }}</td>
                            <td class="text-center">{{ total }}</td>
                            <td class="text-center">
                                <span class="badge badge-sold">{{ vendus }}</span>
                            </td>
                            <td class="text-center">
                                <span class="badge badge-available">{{ disponibles }}</span>
                            </td>
                            <td class="text-right" style="font-weight: bold; color: #27ae60;">{{ revenue|number_format(0, ',', ' ') }} {{ ticket.devise }}</td>
                            <td class="text-center">
                                <div style="display: table; width: 100%;">
                                    <div style="display: table-cell; width: 60px; padding-right: 8px; vertical-align: middle; text-align: right;">
                                        <strong style="font-size: 10pt; color: #2c3e50;">{{ tauxVenteTicket }}%</strong>
                                    </div>
                                    <div style="display: table-cell; vertical-align: middle;">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: {{ tauxVenteTicket }}%;"></div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td><strong>TOTAL</strong></td>
                        <td class="text-right">-</td>
                        <td class="text-center"><strong>{{ totalStock }}</strong></td>
                        <td class="text-center"><strong>{{ totalSold }}</strong></td>
                        <td class="text-center"><strong>{{ totalStock - totalSold }}</strong></td>
                        <td class="text-right" style="font-size: 11pt;"><strong>{{ totalRevenue|number_format(0, ',', ' ') }} {{ ticketTypes[0].devise|default('MGA') }}</strong></td>
                        <td class="text-center">
                            <div style="display: table; width: 100%;">
                                <div style="display: table-cell; width: 60px; padding-right: 8px; vertical-align: middle; text-align: right;">
                                    <strong style="font-size: 11pt; color: #2c3e50;">{{ tauxVente }}%</strong>
                                </div>
                                <div style="display: table-cell; vertical-align: middle;">
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: {{ tauxVente }}%;"></div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>

            <!-- Graphique en barres - Comparaison des ventes -->
            <div class="chart-container">
                <div class="chart-title">Comparaison des ventes par type de billet</div>
                <svg class="bar-chart" width="800" height="300" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1">
                    {% set maxValue = 0 %}
                    {% for ticket in ticketTypes %}
                        {% set inventaire = ticket.inventaire %}
                        {% set vendus = inventaire ? inventaire.quantiteVendue : 0 %}
                        {% set disponibles = inventaire ? (inventaire.quantiteTotale - inventaire.quantiteVendue) : 0 %}
                        {% set maxValue = max(maxValue, vendus, disponibles) %}
                    {% endfor %}
                    {% set scale = maxValue > 0 ? (240 / maxValue) : 1 %}
                    {% set barWidth = 55 %}
                    {% set spacing = 95 %}
                    {% set startX = 80 %}
                    {% set baseY = 270 %}
                    
                    <!-- Axes -->
                    <line x1="60" y1="20" x2="60" y2="270" stroke="#2c3e50" stroke-width="2"/>
                    <line x1="60" y1="270" x2="750" y2="270" stroke="#2c3e50" stroke-width="2"/>
                    
                    <!-- Grille horizontale -->
                    {% for i in 0..5 %}
                        {% set y = 20 + (i * 50) %}
                        <line x1="60" y1="{{ y }}" x2="750" y2="{{ y }}" stroke="#e0e0e0" stroke-width="1" stroke-dasharray="3,3"/>
                    {% endfor %}
                    
                    <!-- Labels Y -->
                    {% for i in 0..5 %}
                        {% set value = (maxValue / 5 * (5 - i))|round %}
                        {% set y = 20 + (i * 50) %}
                        <text x="55" y="{{ y + 5 }}" text-anchor="end" font-size="10" fill="#666" font-weight="bold">{{ value }}</text>
                    {% endfor %}
                    
                    {% set xPos = startX %}
                    {% set colors = ['#3498DB', '#2ecc71', '#f39c12', '#e74c3c', '#9b59b6', '#1abc9c'] %}
                    {% set colorIndex = 0 %}
                    
                    {% for ticket in ticketTypes %}
                        {% set inventaire = ticket.inventaire %}
                        {% set vendus = inventaire ? inventaire.quantiteVendue : 0 %}
                        {% set disponibles = inventaire ? (inventaire.quantiteTotale - inventaire.quantiteVendue) : 0 %}
                        {% set barHeightVendus = (vendus * scale)|round %}
                        {% set barHeightDisponibles = (disponibles * scale)|round %}
                        {% set color = colors[colorIndex % colors|length] %}
                        {% set colorIndex = colorIndex + 1 %}
                        
                        <!-- Barre vendus avec gradient -->
                        <defs>
                            <linearGradient id="grad{{ loop.index }}" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" style="stop-color:{{ color }};stop-opacity:1" />
                                <stop offset="100%" style="stop-color:{{ color }};stop-opacity:0.7" />
                            </linearGradient>
                        </defs>
                        <rect x="{{ xPos }}" y="{{ baseY - barHeightVendus }}" width="{{ barWidth }}" height="{{ barHeightVendus }}" fill="url(#grad{{ loop.index }})" rx="3"/>
                        <text x="{{ xPos + barWidth / 2 }}" y="{{ baseY - barHeightVendus - 8 }}" text-anchor="middle" font-size="11" font-weight="bold" fill="#2c3e50">{{ vendus }}</text>
                        
                        <!-- Barre disponibles -->
                        <rect x="{{ xPos + barWidth + 8 }}" y="{{ baseY - barHeightDisponibles }}" width="{{ barWidth }}" height="{{ barHeightDisponibles }}" fill="#95a5a6" opacity="0.7" rx="3"/>
                        <text x="{{ xPos + barWidth + 8 + barWidth / 2 }}" y="{{ baseY - barHeightDisponibles - 8 }}" text-anchor="middle" font-size="11" font-weight="bold" fill="#2c3e50">{{ disponibles }}</text>
                        
                        <!-- Label type -->
                        <text x="{{ xPos + barWidth / 2 }}" y="290" text-anchor="middle" font-size="9" fill="#2c3e50" font-weight="600">{{ ticket.nom|slice(0, 12) }}</text>
                        
                        {% set xPos = xPos + spacing %}
                    {% endfor %}
                    
                    <!-- Légende améliorée -->
                    <rect x="580" y="25" width="160" height="60" fill="white" stroke="#ddd" stroke-width="1" rx="5" opacity="0.95"/>
                    <rect x="590" y="40" width="18" height="18" fill="#3498DB" rx="2"/>
                    <text x="615" y="53" font-size="11" fill="#2c3e50" font-weight="600">Vendus</text>
                    <rect x="590" y="65" width="18" height="18" fill="#95a5a6" rx="2"/>
                    <text x="615" y="78" font-size="11" fill="#2c3e50" font-weight="600">Disponibles</text>
                </svg>
            </div>

            <!-- Graphique en camembert (fromage) - Répartition des ventes -->
            <div class="chart-container">
                <div class="chart-title">Répartition des ventes par type de billet</div>
                <svg class="pie-chart" width="700" height="350" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1">
                    {% set totalSold = 0 %}
                    {% set ticketData = [] %}
                    {% for ticket in ticketTypes %}
                        {% set inventaire = ticket.inventaire %}
                        {% set vendus = inventaire ? inventaire.quantiteVendue : 0 %}
                        {% set totalSold = totalSold + vendus %}
                        {% set ticketData = ticketData|merge([{nom: ticket.nom, vendus: vendus}]) %}
                    {% endfor %}
                    
                    {% if totalSold > 0 %}
                        {% set colors = ['#3498DB', '#2ecc71', '#f39c12', '#e74c3c', '#9b59b6', '#1abc9c', '#e67e22', '#34495e'] %}
                        {% set centerX = 250 %}
                        {% set centerY = 175 %}
                        {% set radius = 120 %}
                        {% set currentAngle = -90 %}
                        {% set colorIndex = 0 %}
                        
                        <!-- Ombre du camembert -->
                        <defs>
                            <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
                                <feGaussianBlur in="SourceAlpha" stdDeviation="3"/>
                                <feOffset dx="2" dy="2" result="offsetblur"/>
                                <feMerge>
                                    <feMergeNode/>
                                    <feMergeNode in="SourceGraphic"/>
                                </feMerge>
                            </filter>
                        </defs>
                        
                        <g filter="url(#shadow)">
                            {% for data in ticketData %}
                                {% if data.vendus > 0 %}
                                    {% set percentage = (data.vendus / totalSold * 100)|round(1) %}
                                    {% set angle = (360 * data.vendus / totalSold) %}
                                    {% set endAngle = currentAngle + angle %}
                                    {% set color = colors[colorIndex % colors|length] %}
                                    {% set colorIndex = colorIndex + 1 %}
                                    
                                    <!-- Calcul des coordonnées -->
                                    {% set startRadians = currentAngle * 3.14159 / 180 %}
                                    {% set endRadians = endAngle * 3.14159 / 180 %}
                                    {% set x1 = centerX + (radius * (startRadians|cos)) %}
                                    {% set y1 = centerY + (radius * (startRadians|sin)) %}
                                    {% set x2 = centerX + (radius * (endRadians|cos)) %}
                                    {% set y2 = centerY + (radius * (endRadians|sin)) %}
                                    {% set largeArc = angle > 180 ? 1 : 0 %}
                                    
                                    <!-- Part du camembert -->
                                    <path d="M {{ centerX }} {{ centerY }} L {{ x1 }} {{ y1 }} A {{ radius }} {{ radius }} 0 {{ largeArc }} 1 {{ x2 }} {{ y2 }} Z" 
                                          fill="{{ color }}" 
                                          stroke="white" 
                                          stroke-width="2"
                                          opacity="0.9"/>
                                    
                                    <!-- Pourcentage sur la part -->
                                    {% if percentage >= 5 %}
                                        {% set midAngle = currentAngle + (angle / 2) %}
                                        {% set midRadians = midAngle * 3.14159 / 180 %}
                                        {% set textX = centerX + ((radius * 0.7) * (midRadians|cos)) %}
                                        {% set textY = centerY + ((radius * 0.7) * (midRadians|sin)) %}
                                        <text x="{{ textX }}" y="{{ textY + 5 }}" text-anchor="middle" font-size="12" font-weight="bold" fill="white">{{ percentage }}%</text>
                                    {% endif %}
                                    
                                    {% set currentAngle = endAngle %}
                                {% endif %}
                            {% endfor %}
                        </g>
                        
                        <!-- Cercle central pour effet de donut (optionnel) -->
                        <circle cx="{{ centerX }}" cy="{{ centerY }}" r="50" fill="white" stroke="#ddd" stroke-width="2"/>
                        <text x="{{ centerX }}" y="{{ centerY - 10 }}" text-anchor="middle" font-size="14" font-weight="bold" fill="#2c3e50">TOTAL</text>
                        <text x="{{ centerX }}" y="{{ centerY + 10 }}" text-anchor="middle" font-size="16" font-weight="bold" fill="#3498DB">{{ totalSold }}</text>
                        <text x="{{ centerX }}" y="{{ centerY + 28 }}" text-anchor="middle" font-size="10" fill="#7f8c8d">billets</text>
                        
                        <!-- Légende à droite -->
                        {% set legendX = 450 %}
                        {% set legendY = 40 %}
                        {% set colorIndex = 0 %}
                        <rect x="{{ legendX - 10 }}" y="{{ legendY - 10 }}" width="230" height="{{ (ticketData|length * 35) + 20 }}" fill="white" stroke="#ddd" stroke-width="1" rx="5" opacity="0.95"/>
                        
                        {% for data in ticketData %}
                            {% if data.vendus > 0 %}
                                {% set color = colors[colorIndex % colors|length] %}
                                {% set colorIndex = colorIndex + 1 %}
                                {% set percentage = (data.vendus / totalSold * 100)|round(1) %}
                                
                                <rect x="{{ legendX }}" y="{{ legendY }}" width="20" height="20" fill="{{ color }}" rx="3"/>
                                <text x="{{ legendX + 30 }}" y="{{ legendY + 15 }}" font-size="10" fill="#2c3e50" font-weight="600">{{ data.nom|slice(0, 18) }}</text>
                                <text x="{{ legendX + 190 }}" y="{{ legendY + 15 }}" text-anchor="end" font-size="10" fill="#7f8c8d" font-weight="bold">{{ data.vendus }} ({{ percentage }}%)</text>
                                
                                {% set legendY = legendY + 30 %}
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <text x="350" y="175" text-anchor="middle" font-size="14" fill="#999" font-style="italic">Aucune vente enregistrée</text>
                    {% endif %}
                </svg>
            </div>

            <!-- Graphique linéaire - Évolution temporelle -->
            {% if statistics.salesEvolution is defined and statistics.salesEvolution|length > 0 %}
                <div class="chart-container">
                    <div class="chart-title">Évolution des ventes dans le temps</div>
                    <svg class="line-chart" width="800" height="250" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1">
                        {% set maxTickets = 0 %}
                        {% set maxRevenue = 0 %}
                        {% for point in statistics.salesEvolution %}
                            {% set maxTickets = max(maxTickets, point.ticketsSold) %}
                            {% set maxRevenue = max(maxRevenue, point.revenue) %}
                        {% endfor %}
                        {% set scaleTickets = maxTickets > 0 ? (190 / maxTickets) : 1 %}
                        {% set scaleRevenue = maxRevenue > 0 ? (190 / maxRevenue) : 1 %}
                        {% set pointCount = statistics.salesEvolution|length %}
                        {% set stepX = pointCount > 1 ? (700 / (pointCount - 1)) : 700 %}
                        {% set startX = 80 %}
                        {% set baseY = 210 %}
                        
                        <!-- Définition du gradient pour la zone sous la courbe -->
                        <defs>
                            <linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" style="stop-color:#3498DB;stop-opacity:0.3" />
                                <stop offset="100%" style="stop-color:#3498DB;stop-opacity:0.05" />
                            </linearGradient>
                        </defs>
                        
                        <!-- Axes -->
                        <line x1="60" y1="20" x2="60" y2="210" stroke="#2c3e50" stroke-width="2"/>
                        <line x1="60" y1="210" x2="750" y2="210" stroke="#2c3e50" stroke-width="2"/>
                        
                        <!-- Grille et labels Y -->
                        {% for i in 0..4 %}
                            {% set value = (maxTickets / 4 * (4 - i))|round %}
                            {% set y = 20 + (i * 47.5) %}
                            <line x1="60" y1="{{ y }}" x2="750" y2="{{ y }}" stroke="#e0e0e0" stroke-width="1" stroke-dasharray="3,3"/>
                            <text x="55" y="{{ y + 5 }}" text-anchor="end" font-size="10" fill="#666" font-weight="bold">{{ value }}</text>
                        {% endfor %}
                        
                        <!-- Zone sous la courbe des billets -->
                        {% set areaPoints = '' %}
                        {% set xPos = startX %}
                        {% for point in statistics.salesEvolution %}
                            {% set y = baseY - (point.ticketsSold * scaleTickets)|round %}
                            {% if loop.first %}
                                {% set areaPoints = areaPoints ~ startX ~ ',' ~ baseY ~ ' ' %}
                            {% endif %}
                            {% set areaPoints = areaPoints ~ xPos ~ ',' ~ y ~ ' ' %}
                            {% if loop.last %}
                                {% set areaPoints = areaPoints ~ xPos ~ ',' ~ baseY %}
                            {% endif %}
                            {% set xPos = xPos + stepX %}
                        {% endfor %}
                        <polygon points="{{ areaPoints }}" fill="url(#areaGradient)"/>
                        
                        <!-- Ligne des billets vendus -->
                        {% set points = '' %}
                        {% set xPos = startX %}
                        {% for point in statistics.salesEvolution %}
                            {% set y = baseY - (point.ticketsSold * scaleTickets)|round %}
                            {% if loop.first %}
                                {% set points = points ~ xPos ~ ',' ~ y %}
                            {% else %}
                                {% set points = points ~ ' ' ~ xPos ~ ',' ~ y %}
                            {% endif %}
                            <circle cx="{{ xPos }}" cy="{{ y }}" r="6" fill="#3498DB" stroke="white" stroke-width="3"/>
                            <text x="{{ xPos }}" y="{{ y - 15 }}" text-anchor="middle" font-size="10" fill="#3498DB" font-weight="bold">{{ point.ticketsSold }}</text>
                            {% set xPos = xPos + stepX %}
                        {% endfor %}
                        <polyline points="{{ points }}" fill="none" stroke="#3498DB" stroke-width="3"/>
                        
                        <!-- Ligne des revenus -->
                        {% set pointsRevenue = '' %}
                        {% set xPos = startX %}
                        {% for point in statistics.salesEvolution %}
                            {% set y = baseY - (point.revenue * scaleRevenue)|round %}
                            {% if loop.first %}
                                {% set pointsRevenue = pointsRevenue ~ xPos ~ ',' ~ y %}
                            {% else %}
                                {% set pointsRevenue = pointsRevenue ~ ' ' ~ xPos ~ ',' ~ y %}
                            {% endif %}
                            <circle cx="{{ xPos }}" cy="{{ y }}" r="5" fill="#2ecc71" stroke="#ffffff" stroke-width="2"/>
                            {% set xPos = xPos + stepX %}
                        {% endfor %}
                        <polyline points="{{ pointsRevenue }}" fill="none" stroke="#2ecc71" stroke-width="3" stroke-dasharray="5,5"/>
                        
                        <!-- Labels X -->
                        {% set xPos = startX %}
                        {% for point in statistics.salesEvolution %}
                            {% if point.date %}
                                {% set dateParts = point.date|split('-') %}
                                {% if dateParts|length == 3 %}
                                    {% set dateLabel = dateParts[2] ~ '/' ~ dateParts[1] %}
                                {% else %}
                                    {% set dateLabel = point.date|slice(0, 5) %}
                                {% endif %}
                            {% else %}
                                {% set dateLabel = '-' %}
                            {% endif %}
                            <text x="{{ xPos }}" y="230" text-anchor="middle" font-size="9" fill="#666" font-weight="600">{{ dateLabel }}</text>
                            {% set xPos = xPos + stepX %}
                        {% endfor %}
                        
                        <!-- Légende améliorée -->
                        <rect x="580" y="20" width="160" height="65" fill="white" stroke="#ddd" stroke-width="1" rx="5" opacity="0.95"/>
                        <line x1="590" y1="40" x2="620" y2="40" stroke="#3498DB" stroke-width="3"/>
                        <circle cx="605" cy="40" r="4" fill="#3498DB"/>
                        <text x="630" y="45" font-size="11" fill="#2c3e50" font-weight="600">Billets vendus</text>
                        <line x1="590" y1="65" x2="620" y2="65" stroke="#2ecc71" stroke-width="3" stroke-dasharray="5,5"/>
                        <circle cx="605" cy="65" r="4" fill="#2ecc71"/>
                        <text x="630" y="70" font-size="11" fill="#2c3e50" font-weight="600">Revenus</text>
                    </svg>
                </div>

                <!-- Tableau d'évolution -->
                <h3>Détail de l'évolution des ventes</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th class="text-center">Billets vendus</th>
                            <th class="text-right">Revenus</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for point in statistics.salesEvolution %}
                            <tr>
                                <td>
                                    {% if point.date %}
                                        {% set dateParts = point.date|split('-') %}
                                        {% if dateParts|length == 3 %}
                                            {{ dateParts[2] }}/{{ dateParts[1] }}/{{ dateParts[0] }}
                                        {% else %}
                                            {{ point.date }}
                                        {% endif %}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="text-center"><strong>{{ point.ticketsSold }}</strong></td>
                                <td class="text-right" style="font-weight: bold; color: #27ae60;">{{ point.revenue|number_format(0, ',', ' ') }} {{ ticketTypes[0].devise|default('MGA') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% else %}
            <div class="highlight-box">
                <p style="color: #7f8c8d; font-style: italic; text-align: center; padding: 20px;">Aucun type de billet configuré pour cet événement.</p>
            </div>
        {% endif %}
    </div>

    <!-- Pied de page -->
    <div class="footer">
        <p><strong>Aiolia Event</strong> - Plateforme de gestion d'événements</p>
        <p>Généré le {{ "now"|date('d/m/Y à H:i') }} - Document confidentiel - Usage interne uniquement</p>
    </div>
</body>
</html>