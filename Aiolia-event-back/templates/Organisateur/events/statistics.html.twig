{% extends 'base.html.twig' %}

{% block title %}{{ event.titre ?? 'Événement' }} - Statistiques - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    {% include 'Organisateur/events/_header.html.twig' %}

    <!-- Contenu Statistiques -->
    <div class="event-main-content">
        <!-- Graphiques de ventes -->
        <div class="charts-grid">
            <!-- Graphique d'évolution temporelle -->
            <div class="content-card">
                <div class="card-title">
                    <i class="fas fa-chart-line"></i>
                    Évolution des ventes dans le temps
                </div>
                <div class="card-content">
                    <canvas id="salesChart" style="height: 300px;"></canvas>
                </div>
            </div>

            <!-- Graphique en camembert - Répartition par type -->
            <div class="content-card">
                <div class="card-title">
                    <i class="fas fa-chart-pie"></i>
                    Répartition des ventes par type
                </div>
                <div class="card-content">
                    <canvas id="salesPieChart" style="height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Graphique en barres - Comparaison des types -->
        <div class="content-card">
            <div class="card-title">
                <i class="fas fa-chart-bar"></i>
                Comparaison des ventes par type de billet
            </div>
            <div class="card-content">
                <canvas id="salesBarChart" style="height: 300px;"></canvas>
            </div>
        </div>

        <!-- Statistiques de ventes -->
        {% if ticketTypes is defined and ticketTypes|length > 0 %}
            {% set totalSold = 0 %}
            {% set totalStock = 0 %}
            {% set totalRevenue = statistics.totalRevenue|default(0) %}
            {% for ticket in ticketTypes %}
                {% set inventaire = ticket.inventaire %}
                {% set total = inventaire ? inventaire.quantiteTotale : 0 %}
                {% set vendus = inventaire ? inventaire.quantiteVendue : 0 %}
                {% set revenuFactures = statistics.revenuesByType[ticket.id]|default(0) %}
                {% set totalSold = totalSold + vendus %}
                {% set totalStock = totalStock + total %}
                {% set totalRevenue = totalRevenue + revenuFactures %}
            {% endfor %}
            {% set tauxVente = totalStock > 0 ? ((totalSold / totalStock) * 100)|round(1) : 0 %}
            
            <div class="content-card sales-stats-card">
                <div class="card-title">
                    <i class="fas fa-chart-line"></i>
                    Résumé des ventes
                </div>
                <div class="card-content">
                    <div class="sales-stats-content">
                        <div class="stat-item-large">
                            <div class="stat-value-large">{{ totalRevenue|number_format(0, ',', ' ') }}</div>
                            <div class="stat-label-large">{{ ticketTypes[0].devise|default('MGA') }} de revenus</div>
                        </div>
                        <div class="stats-grid-mini">
                            <div class="stat-item-mini">
                                <div class="stat-value-mini">{{ totalSold }}</div>
                                <div class="stat-label-mini">Billets vendus</div>
                            </div>
                            <div class="stat-item-mini">
                                <div class="stat-value-mini">{{ totalStock - totalSold }}</div>
                                <div class="stat-label-mini">Disponibles</div>
                            </div>
                        </div>
                        <div class="stat-progress-wrapper">
                            <div class="stat-progress-label">
                                <span>Taux de vente</span>
                                <span class="stat-progress-percent">{{ tauxVente }}%</span>
                            </div>
                            <div class="stat-progress-bar">
                                <div class="stat-progress-fill" style="width: {{ tauxVente }}%; background: {% if tauxVente >= 80 %}var(--success){% elseif tauxVente >= 50 %}var(--warning){% else %}var(--accent){% endif %};"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

{# Chart.js pour les graphiques de ventes #}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const textColor = getComputedStyle(document.documentElement).getPropertyValue('--text-primary') || '#333';
    const textSecondary = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary') || '#666';
    
    // Données des types de billets depuis Twig
    const ticketTypes = [
        {% for ticket in ticketTypes|default([]) %}
        {
            id: {{ ticket.id }},
            nom: {{ ticket.nom|json_encode|raw }},
            prixDeBase: {{ ticket.prixDeBase|default(0) }},
            devise: {{ ticket.devise|default('MGA')|json_encode|raw }},
            revenuFactures: {{ statistics.revenuesByType[ticket.id]|default(0) }},
            inventaire: {
                quantiteTotale: {{ ticket.inventaire ? ticket.inventaire.quantiteTotale : 0 }},
                quantiteVendue: {{ ticket.inventaire ? ticket.inventaire.quantiteVendue : 0 }},
                quantiteReservee: {{ ticket.inventaire ? ticket.inventaire.quantiteReservee : 0 }}
            }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    // 1. Graphique d'évolution temporelle
    const salesChartCtx = document.getElementById('salesChart');
    if (salesChartCtx) {
        const stats = {{ statistics.salesEvolution|default([])|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
        const labels = stats.map(point => {
            const date = new Date(point.date);
            return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
        });
        const ticketsData = stats.map(point => point.ticketsSold);
            const revenueData = stats.map(point => point.revenue);

        if (labels.length === 0) {
            salesChartCtx.parentElement.innerHTML = '<p style="font-size: 0.9rem; color: var(--gray-600); text-align: center; padding: 40px;">Pas encore de ventes enregistrées pour cet événement.</p>';
        } else {
            new Chart(salesChartCtx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Billets vendus',
                            data: ticketsData,
                            borderColor: 'rgba(52, 152, 219, 1)',
                            backgroundColor: 'rgba(52, 152, 219, 0.2)',
                            tension: 0.4,
                            fill: true,
                            yAxisID: 'y',
                        },
                        {
                            label: 'Revenu',
                            data: revenueData,
                            borderColor: 'rgba(46, 204, 113, 1)',
                            backgroundColor: 'rgba(46, 204, 113, 0.15)',
                            tension: 0.4,
                            fill: true,
                            yAxisID: 'y1',
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: {
                            labels: { color: textColor }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: textSecondary },
                            grid: { color: 'rgba(0, 0, 0, 0.05)' }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            ticks: { color: textSecondary },
                            grid: { color: 'rgba(0, 0, 0, 0.05)' }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            ticks: { color: textSecondary }
                        }
                    }
                }
            });
        }
    }

    // 2. Graphique en camembert
    const pieChartCtx = document.getElementById('salesPieChart');
    if (pieChartCtx && ticketTypes && ticketTypes.length > 0) {
        const pieLabels = ticketTypes.map(t => t.nom);
        const pieData = ticketTypes.map(t => {
            return t.inventaire ? t.inventaire.quantiteVendue : 0;
        });
        const totalSold = pieData.reduce((a, b) => a + b, 0);

        if (totalSold === 0) {
            pieChartCtx.parentElement.innerHTML = '<p style="font-size: 0.9rem; color: var(--gray-600); text-align: center; padding: 40px;">Aucune vente enregistrée.</p>';
        } else {
            const colors = [
                'rgba(52, 152, 219, 0.8)', 'rgba(46, 204, 113, 0.8)', 'rgba(241, 196, 15, 0.8)',
                'rgba(231, 76, 60, 0.8)', 'rgba(155, 89, 182, 0.8)', 'rgba(52, 73, 94, 0.8)',
            ];

            new Chart(pieChartCtx, {
                type: 'doughnut',
                data: {
                    labels: pieLabels,
                    datasets: [{
                        data: pieData,
                        backgroundColor: colors.slice(0, pieLabels.length),
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: textColor,
                                padding: 15,
                                usePointStyle: true
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.parsed || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((value / total) * 100).toFixed(1);
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }
    }

    // 3. Graphique en barres
    const barChartCtx = document.getElementById('salesBarChart');
    if (barChartCtx && ticketTypes && ticketTypes.length > 0) {
        const barLabels = ticketTypes.map(t => t.nom);
        const soldData = ticketTypes.map(t => {
            return t.inventaire ? t.inventaire.quantiteVendue : 0;
        });
        const availableData = ticketTypes.map(t => {
            if (!t.inventaire) return 0;
            const total = t.inventaire.quantiteTotale || 0;
            const sold = t.inventaire.quantiteVendue || 0;
            return total - sold;
        });
        const revenueData = ticketTypes.map(t => t.revenuFactures || 0);

        new Chart(barChartCtx, {
            type: 'bar',
            data: {
                labels: barLabels,
                datasets: [
                    {
                        label: 'Billets vendus',
                        data: soldData,
                        backgroundColor: 'rgba(52, 152, 219, 0.8)',
                        borderColor: 'rgba(52, 152, 219, 1)',
                        borderWidth: 1,
                        yAxisID: 'y',
                    },
                    {
                        label: 'Billets disponibles',
                        data: availableData,
                        backgroundColor: 'rgba(149, 165, 166, 0.6)',
                        borderColor: 'rgba(149, 165, 166, 1)',
                        borderWidth: 1,
                        yAxisID: 'y',
                    },
                    {
                        label: 'Revenus',
                        data: revenueData,
                        backgroundColor: 'rgba(46, 204, 113, 0.8)',
                        borderColor: 'rgba(46, 204, 113, 1)',
                        borderWidth: 1,
                        yAxisID: 'y1',
                        type: 'line',
                        tension: 0.4,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {
                        labels: { color: textColor }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                    }
                },
                scales: {
                    x: {
                        ticks: { color: textSecondary },
                        grid: { display: false }
                    },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        ticks: { color: textSecondary },
                        grid: { color: 'rgba(0, 0, 0, 0.05)' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: { drawOnChartArea: false },
                        ticks: { 
                            color: textSecondary,
                            callback: function(value) {
                                return value.toLocaleString('fr-FR') + ' MGA';
                            }
                        }
                    }
                }
            }
        });
    }
});
</script>

{% include 'Organisateur/events/_styles.html.twig' %}
{% endblock %}

