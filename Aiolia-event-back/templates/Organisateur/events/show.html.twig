{% extends 'base.html.twig' %}

{% block title %}{{ event.titre ?? 'Événement' }} - Vue d'ensemble - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    {% include 'Organisateur/events/_header.html.twig' %}

    <!-- Contenu Vue d'ensemble -->
        <div class="event-main-content">
            <!-- Description -->
            <div class="content-card">
                <div class="card-title">
                    <i class="fas fa-align-left"></i>
                    Description de l'événement
                </div>
                <div class="card-content">
                    {% if event.description %}
                        <p>{{ event.description|raw }}</p>
                    {% elseif event.resume %}
                        <p>{{ event.resume }}</p>
                    {% else %}
                    <p>Aucune description détaillée n'a encore été renseignée pour cet événement.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Accessibilité -->
            <div class="content-card">
                <div class="card-title">
                    <i class="fas fa-universal-access"></i>
                    Accessibilité
                </div>
                <div class="card-content">
                    {% set accessLinks = event.liensAccessibilites ?? [] %}
                    {% if accessLinks|length > 0 %}
                        <div class="accessibility-grid">
                            {% for lien in accessLinks %}
                                {% set typeCode = lien.typeAccessibilite.code|lower %}
                                {% set typeLibelle = lien.typeAccessibilite.libelle|lower %}
                                {% set iconPath = 'images/acces1.svg' %}
                                {% if 'fauteuil' in typeCode or 'roulant' in typeCode or 'wheelchair' in typeCode or 'fauteuil' in typeLibelle or 'roulant' in typeLibelle %}
                                    {% set iconPath = 'images/acces1.svg' %}
                                {% elseif 'malentendant' in typeCode or 'sourd' in typeCode or 'hearing' in typeCode or 'malentendant' in typeLibelle or 'sourd' in typeLibelle %}
                                    {% set iconPath = 'images/acces2.svg' %}
                                {% elseif 'malvoyant' in typeCode or 'aveugle' in typeCode or 'visuel' in typeCode or 'visual' in typeCode or 'malvoyant' in typeLibelle or 'aveugle' in typeLibelle or 'visuel' in typeLibelle %}
                                    {% set iconPath = 'images/acces3.svg' %}
                                {% elseif 'mobilite' in typeCode or 'mobility' in typeCode or 'mobilite' in typeLibelle %}
                                    {% set iconPath = 'images/acces4.svg' %}
                                {% elseif 'cognitif' in typeCode or 'cognitive' in typeCode or 'cognitif' in typeLibelle %}
                                    {% set iconPath = 'images/acces5.svg' %}
                                {% else %}
                                    {% set iconPath = 'images/acces6.svg' %}
                                {% endif %}
                                <div class="accessibility-item">
                                    <div class="accessibility-icon-wrapper">
                                        <img src="{{ asset(iconPath) }}" alt="{{ lien.typeAccessibilite.libelle }}" class="accessibility-icon">
                                        <div class="accessibility-check">
                                            <i class="fas fa-check-circle"></i>
                                        </div>
                                    </div>
                                    <div class="accessibility-content">
                                        <h4 class="accessibility-title">{{ lien.typeAccessibilite.libelle }}</h4>
                                        {% if lien.description %}
                                            <p class="accessibility-description">{{ lien.description }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="accessibility-empty">
                            <i class="fas fa-info-circle"></i>
                            <p>Aucune information d'accessibilité spécifique n'a encore été ajoutée pour cet événement.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'Organisateur/events/_styles.html.twig' %}
{% endblock %}

