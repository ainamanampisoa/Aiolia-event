{% extends 'base.html.twig' %}

{% block title %}{{ event.titre ?? 'Événement' }} - Vue d'ensemble - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    {% include 'Organisateur/events/_header.html.twig' %}

    <!-- Contenu Vue d'ensemble -->
        <div class="event-main-content">
            <!-- Description -->
            <div class="content-card">
                <div class="card-title">
                    <i class="fas fa-align-left"></i>
                    Description de l'événement
                </div>
                <div class="card-content">
                    {% if event.description %}
                        <p>{{ event.description|raw }}</p>
                    {% elseif event.resume %}
                        <p>{{ event.resume }}</p>
                    {% else %}
                    <p>Aucune description détaillée n'a encore été renseignée pour cet événement.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Accessibilité -->
            <div class="content-card">
                <div class="card-title">
                    <i class="fas fa-universal-access"></i>
                    Accessibilité
                </div>
                <div class="card-content">
                    {% set accessLinks = event.liensAccessibilites ?? [] %}
                    {% if accessLinks|length > 0 %}
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                            {% for lien in accessLinks %}
                                <li style="display: flex; align-items: flex-start; gap: 8px;">
                                    <i class="fas fa-check-circle" style="color: var(--success); margin-top: 2px;"></i>
                                    <div>
                                        <strong>{{ lien.typeAccessibilite.libelle }}</strong>
                                        {% if lien.description %}
                                            <div style="font-size: 0.85rem; color: var(--gray-700);">
                                                {{ lien.description }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p style="font-size: 0.9rem; color: var(--gray-600);">
                        Aucune information d'accessibilité spécifique n'a encore été ajoutée pour cet événement.
                        </p>
                    {% endif %}
            </div>
        </div>
    </div>
</div>

{% include 'Organisateur/events/_styles.html.twig' %}
{% endblock %}
