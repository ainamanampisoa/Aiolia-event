{% extends 'base.html.twig' %}

{% block title %}Paiement Abonnement - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1> <i class="fas fa-credit-card"></i> Paiement Abonnement</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Choisissez votre niveau d'abonnement, la durée et votre mode de paiement
            </p>
        </div>
    </div>

    <!-- Sélection du niveau d'abonnement -->
    <div class="card">
        <div class="card-body">
            <h2 class="section-title">
                <i class="fas fa-layer-group"></i>
                Choisissez votre niveau d'abonnement
            </h2>
            
            <div class="level-options">
                {% for niveau in niveaux %}
                    <div class="level-option" data-niveau="{{ niveau }}">
                        <input type="radio" name="niveau" id="niveau_{{ niveau }}" value="{{ niveau }}" class="level-radio" {% if loop.first %}checked{% endif %}>
                        <label for="niveau_{{ niveau }}" class="level-label">
                            <div class="level-header">
                                <span class="level-name">{{ niveau|capitalize }}</span>
                                {% if niveau == 'basic' %}
                                    <span class="level-badge basic">Essentiel</span>
                                {% elseif niveau == 'pro' %}
                                    <span class="level-badge pro">Professionnel</span>
                                {% elseif niveau == 'enterprise' %}
                                    <span class="level-badge enterprise">Entreprise</span>
                                {% endif %}
                            </div>
                        </label>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Sélection de la période d'abonnement -->
    <div class="card" id="period-section" style="display: none; margin-top: 20px;">
        <div class="card-body">
            <h2 class="section-title">
                <i class="fas fa-calendar-alt"></i>
                Choisissez la durée de votre abonnement
            </h2>
            
            <div class="period-options" id="period-options">
                <!-- Les options seront générées dynamiquement via JavaScript -->
            </div>
        </div>
    </div>

    <!-- Résumé de la sélection -->
    <div class="card" id="selection-summary" style="margin-top: 20px;">
        <div class="card-body">
            <h2 class="section-title">
                <i class="fas fa-info-circle"></i>
                Récapitulatif
            </h2>
            <div class="summary-card">
                <div class="summary-item">
                    <span class="summary-label">Niveau :</span>
                    <span class="summary-value" id="summary-niveau">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Durée :</span>
                    <span class="summary-value" id="summary-duree">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Prix :</span>
                    <span class="summary-value summary-price" id="summary-prix">-</span>
                </div>
                {% if plansGroupedByNiveau is defined %}
                    <div class="summary-discount" id="summary-discount" style="display: none;">
                        <i class="fas fa-tag"></i>
                        <span id="discount-text"></span>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Sélection du mode de paiement -->
    <div class="card" id="payment-section" style="display: none; margin-top: 20px;">
        <div class="card-body">
            <h2 class="section-title">
                <i class="fas fa-money-bill-wave"></i>
                Choisissez votre mode de paiement
            </h2>
            
            <div class="payment-methods">
                <div class="payment-method-option">
                    <input type="radio" name="mode_paiement" id="mvola" value="mvola" class="payment-radio" checked>
                    <label for="mvola" class="payment-label">
                        <div class="payment-icon">
                            <img src="{{ asset('images/m-vola1.png') }}" alt="MVola" class="payment-logo">
                        </div>
                        <span class="payment-name">MVola</span>
                    </label>
                </div>

                <div class="payment-method-option">
                    <input type="radio" name="mode_paiement" id="airtel" value="airtel" class="payment-radio">
                    <label for="airtel" class="payment-label">
                        <div class="payment-icon">
                            <img src="{{ asset('images/airtel.png') }}" alt="Airtel Money" class="payment-logo">
                        </div>
                        <span class="payment-name">Airtel Money</span>
                    </label>
                </div>

                <div class="payment-method-option">
                    <input type="radio" name="mode_paiement" id="orange" value="orange" class="payment-radio">
                    <label for="orange" class="payment-label">
                        <div class="payment-icon">
                            <img src="{{ asset('images/Orange.png') }}" alt="Orange Money" class="payment-logo">
                        </div>
                        <span class="payment-name">Orange Money</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- Vérification du compte MVola -->
    <div class="card" id="mvola-verification-section" style="display: none; margin-top: 20px;">
        <div class="card-body">
            <h2 class="section-title">
                <i class="fas fa-shield-alt"></i>
                Vérification de votre compte MVola
            </h2>
            
            <div class="security-notice">
                <i class="fas fa-lock"></i>
                <span>Pour garantir la sécurité de votre compte, veuillez confirmer votre numéro MVola et entrer votre code PIN.</span>
            </div>

            {% if mvolaNumberMasked %}
                <div class="mvola-verification-form">
                    <div class="form-group">
                        <label for="mvola-number-display" class="form-label">
                            <i class="fas fa-mobile-alt"></i>
                            Numéro MVola associé à votre compte
                        </label>
                        <div class="phone-display">
                            <span class="phone-number-masked" id="mvola-number-display">{{ mvolaNumberMasked }}</span>
                            <button type="button" class="btn-change-number" id="btn-change-number">
                                <i class="fas fa-edit"></i>
                                Modifier
                            </button>
                        </div>
                        <input type="hidden" id="mvola-number-hidden" value="{{ mvolaNumber|default('')|e('html_attr') }}">
                    </div>

                    <div class="form-group" id="change-number-form" style="display: none;">
                        <label for="new-mvola-number" class="form-label">
                            <i class="fas fa-phone"></i>
                            Nouveau numéro MVola
                        </label>
                        <input 
                            type="tel" 
                            id="new-mvola-number" 
                            class="form-control" 
                            placeholder="0341234567"
                            maxlength="20"
                            pattern="^[\+]?[0-9]{10,20}$"
                            title="Le numéro de téléphone ne peut pas contenir d'email. Veuillez entrer uniquement des chiffres. Exemple: 0341234567"
                            oninput="validatePhoneNumberInput(this)"
                        >
                        <small class="form-text text-danger" id="phone-error" style="display: none;">
                            <i class="fas fa-exclamation-circle"></i>
                            <span id="phone-error-text"></span>
                        </small>
                        <small class="form-text">Format: 0341234567 ou +261341234567 (chiffres uniquement)</small>
                    </div>

                    <div class="form-group">
                        <label for="mvola-pin" class="form-label">
                            <i class="fas fa-key"></i>
                            Code PIN MVola
                            <span class="required-indicator">*</span>
                        </label>
                        <div class="pin-input-wrapper">
                            <input 
                                type="password" 
                                id="mvola-pin" 
                                class="form-control pin-input" 
                                placeholder="Entrez votre code PIN"
                                maxlength="6"
                                pattern="[0-9]{4,6}"
                                autocomplete="off"
                            >
                            <button type="button" class="btn-toggle-pin" id="btn-toggle-pin" title="Afficher/Masquer">
                                <i class="fas fa-eye" id="pin-eye-icon"></i>
                            </button>
                        </div>
                        <small class="form-text">Le code PIN de votre compte MVola (4 à 6 chiffres)</small>
                        <div class="pin-error" id="pin-error" style="display: none;">
                            <i class="fas fa-exclamation-circle"></i>
                            <span id="pin-error-text"></span>
                        </div>
                    </div>

                    <div class="attempts-counter" id="attempts-counter" style="display: none;">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Tentatives restantes: <strong id="attempts-remaining">3</strong></span>
                    </div>
                </div>
            {% else %}
                <div class="no-mvola-number">
                    <i class="fas fa-info-circle"></i>
                    <p>Aucun numéro MVola enregistré dans votre profil.</p>
                    <p>Veuillez d'abord configurer votre numéro MVola dans les paramètres de votre compte.</p>
                    <a href="{{ path('app_profile_index') }}" class="btn-link">
                        <i class="fas fa-cog"></i>
                        Aller aux paramètres
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Bouton de paiement -->
    <div class="payment-button-section" id="payment-button-section" style="display: none; margin-top: 20px; text-align: center;">
        <button type="button" class="btn-payment" id="btn-payment" disabled>
            <i class="fas fa-lock"></i>
            <span>Procéder au paiement</span>
        </button>
    </div>
</div>

<!-- Modale de confirmation de paiement -->
<div class="payment-modal-overlay" id="payment-modal-overlay" style="display: none;">
    <div class="payment-modal-container">
        <div class="payment-modal">
            <div class="payment-modal-header">
                <div class="payment-modal-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h2 class="payment-modal-title">Confirmation de paiement</h2>
                <button type="button" class="payment-modal-close" id="payment-modal-close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <div class="payment-modal-body">
                <div class="payment-confirmation-message">
                    <p class="confirmation-question">Confirmez-vous ce paiement ?</p>
                </div>

                <div class="payment-details-card">
                    <div class="payment-detail-row">
                        <div class="payment-detail-label">
                            <i class="fas fa-layer-group"></i>
                            <span>Niveau d'abonnement</span>
                        </div>
                        <div class="payment-detail-value" id="modal-niveau">-</div>
                    </div>
                    
                    <div class="payment-detail-row">
                        <div class="payment-detail-label">
                            <i class="fas fa-calendar-alt"></i>
                            <span>Durée</span>
                        </div>
                        <div class="payment-detail-value" id="modal-duree">-</div>
                    </div>
                    
                    <div class="payment-detail-row highlight">
                        <div class="payment-detail-label">
                            <i class="fas fa-money-bill-wave"></i>
                            <span>Montant à payer</span>
                        </div>
                        <div class="payment-detail-value payment-amount" id="modal-montant">-</div>
                    </div>
                    
                    <div class="payment-detail-row" id="modal-mvola-row" style="display: none;">
                        <div class="payment-detail-label">
                            <i class="fas fa-mobile-alt"></i>
                            <span>Numéro MVola</span>
                        </div>
                        <div class="payment-detail-value" id="modal-mvola-number">-</div>
                    </div>
                    
                    <div class="payment-detail-row" id="modal-payment-method-row">
                        <div class="payment-detail-label">
                            <i class="fas fa-credit-card"></i>
                            <span>Mode de paiement</span>
                        </div>
                        <div class="payment-detail-value" id="modal-payment-method">-</div>
                    </div>
                </div>

                <div class="payment-redirect-notice">
                    <i class="fas fa-info-circle"></i>
                    <span>Vous allez être redirigé vers votre opérateur mobile pour finaliser le paiement.</span>
                </div>
            </div>
            
            <div class="payment-modal-footer">
                <button type="button" class="btn-modal-cancel" id="btn-modal-cancel">
                    <i class="fas fa-times"></i>
                    <span>Annuler</span>
                </button>
                <button type="button" class="btn-modal-confirm" id="btn-modal-confirm">
                    <i class="fas fa-check"></i>
                    <span>Confirmer le paiement</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Données des plans depuis le backend (format optimisé pour JavaScript)
const plansData = {{ plansForJs|json_encode|raw }};

// Prochain mois de facturation depuis la base de données
{% if nextBillingMonth %}
    const nextBillingMonth = '{{ nextBillingMonth|date('Y-m-01') }}';
    console.log('📅 [Initialisation] Prochain mois de facturation depuis la base:', nextBillingMonth);
{% else %}
    const nextBillingMonth = null;
    console.log('📅 [Initialisation] Aucun mois de facturation depuis la base, utilisation du mois suivant');
{% endif %}

// Prix de base par niveau (mensuel)
const basePrices = {
    'basic': 50000,
    'pro': 150000,
    'enterprise': 300000
};

// Prix avec réductions
const prices = {
    'basic': {
        'monthly': 50000,
        'quarterly': 135000,
        'yearly': 480000
    },
    'pro': {
        'monthly': 150000,
        'quarterly': 405000,
        'yearly': 1440000
    },
    'enterprise': {
        'monthly': 300000,
        'quarterly': 810000,
        'yearly': 2880000
    }
};

// Réductions
const discounts = {
    'quarterly': { percent: 10, label: '10% de réduction' },
    'yearly': { percent: 20, label: '20% de réduction' }
};

// Initialisation avec les valeurs par défaut
let selectedNiveau = null;
let selectedPeriod = 'monthly'; // Par défaut : 1 mois
let selectedPaymentMethod = 'mvola'; // Par défaut : MVola

// Variables pour la sécurité MVola
let mvolaNumber = {% if mvolaNumber %}{{ mvolaNumber|json_encode|raw }}{% else %}null{% endif %};
let mvolaNumberMasked = {% if mvolaNumberMasked %}{{ mvolaNumberMasked|json_encode|raw }}{% else %}null{% endif %};

// Valider que mvolaNumber n'est pas un email (validation inline car isValidPhoneNumberForPayment n'est pas encore définie)
if (mvolaNumber && typeof mvolaNumber === 'string') {
    const phoneStr = mvolaNumber.trim();
    // Vérifier si c'est un email (@) ou contient des lettres
    if (phoneStr.includes('@')) {
        console.error('❌ [Initialisation] Numéro MVola invalide (contient un email):', phoneStr);
        mvolaNumber = null;
        mvolaNumberMasked = null;
    } else if (/[a-zA-Z]/.test(phoneStr)) {
        console.error('❌ [Initialisation] Numéro MVola invalide (contient des lettres):', phoneStr);
        mvolaNumber = null;
        mvolaNumberMasked = null;
    }
}

// Variables de validation
let mvolaPinAttempts = 3;
let mvolaPinValidated = false;
let isPinVisible = false;
let isPhoneNumberValid = true;
let previousPaymentMethod = null; // Pour détecter les changements de méthode de paiement

// Fonction de validation en temps réel du numéro de téléphone
function validatePhoneNumberInput(input) {
    const phoneError = document.getElementById('phone-error');
    const phoneErrorText = document.getElementById('phone-error-text');
    const value = input.value.trim();
    
    // Masquer l'erreur par défaut
    if (phoneError) {
        phoneError.style.display = 'none';
    }
    input.classList.remove('error', 'error-border');
    isPhoneNumberValid = true;
    
    // Si le champ est vide, ne pas afficher d'erreur
    if (value === '') {
        console.log('📞 [validatePhoneNumberInput] Champ vide');
        updatePaymentButton();
        return true;
    }
    
    // Vérification 1: Ne doit pas contenir d'email (@)
    if (value.includes('@')) {
        if (phoneError) {
            phoneError.style.display = 'block';
            phoneErrorText.textContent = 'Le numéro de téléphone ne peut pas contenir d\'email (@). Veuillez entrer uniquement des chiffres.';
        }
        input.classList.add('error', 'error-border');
        isPhoneNumberValid = false;
        updatePaymentButton();
        return false;
    }
    
    // Vérification 2: Ne doit pas contenir de lettres
    if (/[a-zA-Z]/.test(value)) {
        if (phoneError) {
            phoneError.style.display = 'block';
            phoneErrorText.textContent = 'Le numéro de téléphone ne peut pas contenir de lettres. Veuillez entrer uniquement des chiffres.';
        }
        input.classList.add('error', 'error-border');
        isPhoneNumberValid = false;
        updatePaymentButton();
        return false;
    }
    
    // Vérification 3: Doit contenir uniquement des chiffres, +, espaces, tirets, parenthèses
    const validPattern = /^[\+]?[0-9\s\-\(\)]{10,20}$/;
    if (!validPattern.test(value)) {
        if (phoneError) {
            phoneError.style.display = 'block';
            phoneErrorText.textContent = 'Format invalide. Utilisez uniquement des chiffres, le signe +, espaces, tirets ou parenthèses.';
        }
        input.classList.add('error', 'error-border');
        isPhoneNumberValid = false;
        updatePaymentButton();
        return false;
    }
    
    // Vérification 4: Doit contenir au moins 9 chiffres
    const digitCount = (value.match(/\d/g) || []).length;
    if (digitCount < 9) {
        if (phoneError) {
            phoneError.style.display = 'block';
            phoneErrorText.textContent = 'Le numéro doit contenir au moins 9 chiffres. Exemple: 0341234567';
        }
        input.classList.add('error', 'error-border');
        isPhoneNumberValid = false;
        updatePaymentButton();
        return false;
    }
    
    // Si toutes les validations passent
    console.log('✅ [validatePhoneNumberInput] Numéro valide:', value);
    updatePaymentButton();
    return true;
}

// Fonction pour valider strictement un numéro de téléphone avant paiement
function isValidPhoneNumberForPayment(phone) {
    if (!phone || typeof phone !== 'string') {
        return false;
    }
    
    const phoneStr = phone.trim();
    
    // 1. Ne doit pas être vide
    if (phoneStr === '') {
        return false;
    }
    
    // 2. Ne doit pas contenir d'email (@)
    if (phoneStr.includes('@')) {
        console.error('❌ [Validation] Numéro contient un email:', phoneStr);
        return false;
    }
    
    // 3. Ne doit pas contenir de lettres
    if (/[a-zA-Z]/.test(phoneStr)) {
        console.error('❌ [Validation] Numéro contient des lettres:', phoneStr);
        return false;
    }
    
    // 4. Doit contenir uniquement des caractères autorisés
    const validPattern = /^[\+]?[0-9\s\-\(\)]{10,20}$/;
    if (!validPattern.test(phoneStr)) {
        console.error('❌ [Validation] Format invalide:', phoneStr);
        return false;
    }
    
    // 5. Doit contenir au moins 9 chiffres
    const digitCount = (phoneStr.match(/\d/g) || []).length;
    if (digitCount < 9) {
        console.error('❌ [Validation] Pas assez de chiffres:', phoneStr, 'Chiffres:', digitCount);
        return false;
    }
    
    return true;
}

// Fonction pour nettoyer automatiquement le champ de numéro de téléphone
function cleanPhoneNumberField() {
    const newNumberInput = document.getElementById('new-mvola-number');
    if (!newNumberInput) return false;
    
    const value = newNumberInput.value.trim();
    
    // Si le champ contient un email ou des lettres (sauf +, espaces, tirets, parenthèses), le vider
    if (value.includes('@') || (/[a-zA-Z]/.test(value) && !/^[\+]?[0-9\s\-\(\)]+$/.test(value))) {
        console.warn('⚠️ [Nettoyage] Valeur invalide détectée dans new-mvola-number:', value, '- Vidage du champ...');
        newNumberInput.value = '';
        const phoneError = document.getElementById('phone-error');
        if (phoneError) {
            phoneError.style.display = 'none';
        }
        newNumberInput.classList.remove('error', 'error-border');
        isPhoneNumberValid = true;
        return true;
    }
    
    return false;
}

// Initialisation au chargement de la page
document.addEventListener('DOMContentLoaded', function() {
    try {
        // Nettoyer le champ new-mvola-number s'il contient des valeurs invalides au chargement
        cleanPhoneNumberField();
        
        // Gestion de la sélection du niveau
        document.querySelectorAll('input[name="niveau"]').forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.checked) {
                    selectedNiveau = this.value;
                    selectedPeriod = 'monthly'; // Réinitialiser à monthly lors du changement de niveau
                    console.log('🔄 [Niveau] Changement de niveau:', selectedNiveau);
                    showPeriodOptions();
                    updateSummary(); // Mettre à jour le récapitulatif immédiatement
                }
            });
        });

        // Sélectionner le premier niveau par défaut
        const firstLevelRadio = document.querySelector('input[name="niveau"]:checked');
        if (firstLevelRadio) {
            selectedNiveau = firstLevelRadio.value;
            console.log('✅ [Initialisation] Niveau sélectionné:', selectedNiveau);
            showPeriodOptions();
            updateSummary(); // Mettre à jour le récapitulatif au chargement
        } else {
            console.error('❌ [Initialisation] Aucun niveau sélectionné par défaut');
        }

        // Gestion de la sélection du mode de paiement
        document.querySelectorAll('input[name="mode_paiement"]').forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.checked) {
                    previousPaymentMethod = selectedPaymentMethod; // Sauvegarder l'ancienne méthode
                    selectedPaymentMethod = this.value;
                    showMvolaVerification();
                    updatePaymentButton();
                }
            });
        });

        // Sélectionner MVola par défaut
        const mvolaRadio = document.getElementById('mvola');
        if (mvolaRadio) {
            mvolaRadio.checked = true;
            selectedPaymentMethod = 'mvola';
        }
        
        // Mettre à jour le bouton et le résumé
        updatePaymentButton();
        if (selectedNiveau && selectedPeriod) {
            updateSummary();
        }
        
        // Afficher la section de vérification MVola si MVola est sélectionné ET que le numéro est valide
        // Note: mvolaNumber a déjà été validé lors de l'initialisation ci-dessus
        if (selectedPaymentMethod === 'mvola' && mvolaNumber) {
            // Double vérification que le numéro est toujours valide
            const phoneStr = String(mvolaNumber).trim();
            if (!phoneStr.includes('@') && !/[a-zA-Z]/.test(phoneStr)) {
                showMvolaVerification();
            } else {
                console.error('❌ [Initialisation] Numéro MVola invalide détecté, la section ne sera pas affichée');
                mvolaNumber = null;
                mvolaNumberMasked = null;
            }
        }

        // Gestion du clic sur le bouton de paiement
        const btnPayment = document.getElementById('btn-payment');
        if (btnPayment) {
            btnPayment.addEventListener('click', function() {
                console.log('🖱️ [Bouton cliqué] État:', {
                    disabled: this.disabled,
                    selectedNiveau,
                    selectedPeriod,
                    selectedPaymentMethod,
                    mvolaPinValidated,
                    isPhoneNumberValid
                });
                
                if (this.disabled) {
                    console.error('❌ [Bouton cliqué] Bouton désactivé!');
                    showNotification('Veuillez remplir tous les champs obligatoires correctement.', 'error');
                    validateAllFields(); // Forcer la validation pour voir quels champs sont manquants
                    return;
                }
                
                // Vérification finale avant le paiement
                if (selectedPaymentMethod === 'mvola' && mvolaNumber) {
                    const pinInput = document.getElementById('mvola-pin');
                    if (pinInput) {
                        const pin = pinInput.value.trim();
                        if (!mvolaPinValidated || pin.length < 4) {
                            showNotification('Veuillez entrer un code PIN valide pour continuer.', 'error');
                            pinInput.focus();
                            return;
                        }
                    }
                }
                
                // Afficher la modale de confirmation
                showPaymentConfirmationModal();
            });
        }
        
        // Ajouter des écouteurs d'événements pour les changements
        document.addEventListener('change', function() {
            setTimeout(validateAllFields, 100);
        });

        document.addEventListener('input', function() {
            setTimeout(validateAllFields, 100);
        });

        // Validation initiale
        setTimeout(validateAllFields, 500);

        // Gestion de la modale de confirmation
        setupPaymentModal();

        // Event listeners pour la vérification MVola
        // Gestion de l'affichage/masquage du code PIN
        const btnTogglePin = document.getElementById('btn-toggle-pin');
        if (btnTogglePin) {
            btnTogglePin.addEventListener('click', function() {
                const pinInput = document.getElementById('mvola-pin');
                const pinEyeIcon = document.getElementById('pin-eye-icon');
                
                if (!pinInput || !pinEyeIcon) return;
                
                if (isPinVisible) {
                    pinInput.type = 'password';
                    pinEyeIcon.classList.remove('fa-eye-slash');
                    pinEyeIcon.classList.add('fa-eye');
                    isPinVisible = false;
                } else {
                    pinInput.type = 'text';
                    pinEyeIcon.classList.remove('fa-eye');
                    pinEyeIcon.classList.add('fa-eye-slash');
                    isPinVisible = true;
                }
            });
        }

        // Gestion du changement de numéro MVola
        const btnChangeNumber = document.getElementById('btn-change-number');
        if (btnChangeNumber) {
            btnChangeNumber.addEventListener('click', function() {
                const changeForm = document.getElementById('change-number-form');
                if (!changeForm) return;
                
                if (changeForm.style.display === 'none' || changeForm.style.display === '') {
                    changeForm.style.display = 'block';
                    this.innerHTML = '<i class="fas fa-times"></i> Annuler';
                    
                    // Nettoyer le champ s'il contient des valeurs invalides
                    cleanPhoneNumberField();
                    
                    // Ajouter une validation en temps réel sur le champ
                    const newNumberInput = document.getElementById('new-mvola-number');
                    if (newNumberInput) {
                        // Empêcher la saisie de caractères invalides
                        newNumberInput.addEventListener('keypress', function(e) {
                            // Autoriser: chiffres, +, espaces, tirets, parenthèses
                            const allowedKeys = /[0-9+\s\-()]/;
                            const controlKeys = /[Backspace|Delete|Tab|ArrowLeft|ArrowRight|Home|End]/;
                            
                            if (!allowedKeys.test(e.key) && !controlKeys.test(e.key) && !e.ctrlKey && !e.metaKey) {
                                e.preventDefault();
                                showNotification('Caractère non autorisé. Utilisez uniquement des chiffres, le signe + et des espaces/tirets.', 'error');
                                return false;
                            }
                        });
                        
                        // Validation au blur
                        newNumberInput.addEventListener('blur', function() {
                            validatePhoneNumberInput(this);
                        });
                        
                        // Validation au paste
                        newNumberInput.addEventListener('paste', function(e) {
                            e.preventDefault();
                            const pastedText = (e.clipboardData || window.clipboardData).getData('text');
                            
                            // Nettoyer le texte collé
                            const cleaned = pastedText.replace(/[^0-9+\s\-()]/g, '');
                            if (cleaned) {
                                this.value = cleaned;
                                validatePhoneNumberInput(this);
                            } else {
                                showNotification('Le texte collé ne contient pas de numéro de téléphone valide.', 'error');
                            }
                        });
                    }
                } else {
                    changeForm.style.display = 'none';
                    const newNumberInput = document.getElementById('new-mvola-number');
                    if (newNumberInput) {
                        newNumberInput.value = '';
                        const phoneError = document.getElementById('phone-error');
                        if (phoneError) {
                            phoneError.style.display = 'none';
                        }
                        newNumberInput.classList.remove('error', 'error-border');
                        isPhoneNumberValid = true;
                    }
                    this.innerHTML = '<i class="fas fa-edit"></i> Modifier';
                }
                updatePaymentButton();
            });
        }

        // Validation du code PIN en temps réel
        const mvolaPinInput = document.getElementById('mvola-pin');
        if (mvolaPinInput) {
            mvolaPinInput.addEventListener('input', function() {
                validateMvolaPin();
            });

            mvolaPinInput.addEventListener('keypress', function(e) {
                // N'autoriser que les chiffres
                if (!/[0-9]/.test(e.key) && e.key !== 'Enter') {
                    e.preventDefault();
                }
            });
        }
    } catch (error) {
        console.error('Erreur lors de l\'initialisation:', error);
    }
});

// Fonction pour afficher les options de période
function showPeriodOptions() {
    if (!selectedNiveau) {
        console.warn('⚠️ [showPeriodOptions] selectedNiveau n\'est pas défini');
        return;
    }

    const periodSection = document.getElementById('period-section');
    const periodOptions = document.getElementById('period-options');
    
    if (!periodSection || !periodOptions) {
        console.error('❌ [showPeriodOptions] Éléments period-section ou period-options non trouvés');
        return;
    }
    
    console.log('📅 [showPeriodOptions] Affichage de la section période pour:', selectedNiveau);
    periodSection.style.display = 'block';
    periodOptions.innerHTML = '';

    const periods = [
        { key: 'monthly', label: '1 mois', months: 1 },
        { key: 'quarterly', label: '3 mois', months: 3 },
        { key: 'yearly', label: '12 mois', months: 12 }
    ];

    periods.forEach(period => {
        const price = prices[selectedNiveau][period.key];
        const basePrice = basePrices[selectedNiveau] * period.months;
        const hasDiscount = period.key !== 'monthly';
        const discountAmount = hasDiscount ? basePrice - price : 0;
        const discountPercent = hasDiscount ? discounts[period.key].percent : 0;

        const periodOption = document.createElement('div');
        periodOption.className = 'period-option';
        periodOption.innerHTML = `
            <input type="radio" name="periode" id="periode_${period.key}" value="${period.key}" class="period-radio">
            <label for="periode_${period.key}" class="period-label">
                <div class="period-header">
                    <span class="period-name">${period.label}</span>
                    ${hasDiscount ? `<span class="period-badge">${discountPercent}% de réduction</span>` : ''}
                </div>
                <div class="period-price-info">
                    <span class="period-price">${formatPrice(price)} MGA</span>
                    ${hasDiscount ? `<span class="period-old-price">${formatPrice(basePrice)} MGA</span>` : ''}
                </div>
                ${hasDiscount ? `<div class="period-savings">Vous économisez ${formatPrice(discountAmount)} MGA</div>` : ''}
            </label>
        `;
        periodOptions.appendChild(periodOption);

        // Ajouter l'événement de changement
        const periodRadio = periodOption.querySelector('.period-radio');
        periodRadio.addEventListener('change', function() {
            if (this.checked) {
                selectedPeriod = period.key;
                showPaymentSection();
                updateSummary();
            }
        });

        // Sélectionner monthly par défaut
        if (period.key === 'monthly') {
            periodRadio.checked = true;
            selectedPeriod = 'monthly';
            console.log('✅ [showPeriodOptions] Période monthly sélectionnée par défaut');
        }
    });

    // Mettre à jour après avoir créé toutes les options
    console.log('📋 [showPeriodOptions] Mise à jour des sections après création des options');
    showPaymentSection();
    updateSummary();
    updatePaymentButton();
    
    // Afficher la section de vérification MVola si nécessaire
    if (selectedPaymentMethod === 'mvola') {
        showMvolaVerification();
    }
}

