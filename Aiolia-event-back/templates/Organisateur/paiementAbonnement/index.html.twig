        // Si le formulaire de changement n'est pas visible, le numéro est valide (on utilise celui du profil)
        if (!changeForm || changeForm.style.display === 'none') {
            isPhoneNumberValid = true;
            console.log('✅ [validateAllFields] Formulaire de changement non visible - numéro du profil utilisé');
        } else if (newNumberInput) {
            const newNumber = newNumberInput.value.trim();
            
            // Si le champ est vide, il est valide (optionnel - on garde le numéro du profil)
            if (newNumber === '') {
                console.log('✅ [validateAllFields] Champ new-mvola-number vide - numéro du profil utilisé');
