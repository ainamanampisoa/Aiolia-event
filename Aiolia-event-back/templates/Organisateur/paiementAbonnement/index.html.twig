// Configuration de la modale de paiement
function setupPaymentModal() {
    const modal = document.getElementById('payment-modal-overlay');
    const closeBtn = document.getElementById('payment-modal-close');
    const cancelBtn = document.getElementById('btn-modal-cancel');
    const confirmBtn = document.getElementById('btn-modal-confirm');

    // Fermer en cliquant sur le bouton X
    if (closeBtn) {
        closeBtn.addEventListener('click', closePaymentModal);
    }

    // Fermer en cliquant sur Annuler
    if (cancelBtn) {
        cancelBtn.addEventListener('click', closePaymentModal);
    }

    // Fermer en cliquant sur l'overlay (fond)
    if (modal) {
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                closePaymentModal();
            }
        });
    }

    // Confirmer le paiement
    if (confirmBtn) {
        confirmBtn.addEventListener('click', function() {
            // Désactiver le bouton pendant le traitement
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Traitement en cours...</span>';
            
            // Récupérer le plan_id depuis les données
            let planId = null;
            if (plansData && plansData[selectedNiveau]) {
                const plansForNiveau = plansData[selectedNiveau];
                const selectedPlan = plansForNiveau.find(plan => {
                    const periode = plan.periodeFacturation || plan.periode_facturation || plan.periode;
                    return periode === selectedPeriod;
                });
                if (selectedPlan) {
                    planId = selectedPlan.id || selectedPlan.getId?.() || null;
                }
            }
            
            // Si pas de plan trouvé
            if (!planId) {
                planId = null;
            }
            
            // Récupérer le numéro de téléphone
            let customerPhone = '';
            
            // Vérifier d'abord si l'utilisateur a modifié le numéro
            const newMvolaNumberInput = document.getElementById('new-mvola-number');
            if (newMvolaNumberInput && newMvolaNumberInput.value.trim() !== '') {
                const newNumber = String(newMvolaNumberInput.value).trim();
                
                // Validation stricte du numéro de téléphone modifié
                if (!isValidPhoneNumberForPayment(newNumber)) {
                    showNotification('Le numéro de téléphone ne peut pas contenir d\'email. Veuillez entrer uniquement des chiffres. Exemple: 0341234567', 'error');
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '<i class="fas fa-check"></i> <span>Confirmer le paiement</span>';
                    return;
                }
                
                customerPhone = newNumber;
            } else {
                // Utiliser le numéro depuis le champ caché ou la variable JavaScript
                const hiddenNumberInput = document.getElementById('mvola-number-hidden');
                
                if (hiddenNumberInput && hiddenNumberInput.value) {
                    const rawValue = hiddenNumberInput.value;
                    const stringValue = String(rawValue).trim();
                    
                    // Valider que ce n'est pas un email avant de l'utiliser
                    if (isValidPhoneNumberForPayment(stringValue)) {
                        customerPhone = stringValue;
                    } else {
                        console.error('❌ [Confirmation] Numéro dans champ caché invalide:', stringValue);
                    }
                }
                
                // Si pas trouvé dans le champ caché ou invalide, essayer la variable JavaScript
                if (!customerPhone && mvolaNumber) {
                    const mvolaStr = String(mvolaNumber).trim();
                    // Valider que ce n'est pas un email
                    if (isValidPhoneNumberForPayment(mvolaStr)) {
                        customerPhone = mvolaStr;
                    } else {
                        console.error('❌ [Confirmation] Numéro MVola invalide (contient email):', mvolaStr);
                    }
                }
            }
            
            // Vérification finale du numéro
            if (!customerPhone || !isValidPhoneNumberForPayment(customerPhone)) {
                showNotification('Erreur: Le numéro MVola enregistré dans votre profil n\'est pas valide (contient un email ou format incorrect). Veuillez le modifier dans vos paramètres ou utiliser le champ "Modifier" pour entrer un numéro valide.', 'error');
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fas fa-check"></i> <span>Confirmer le paiement</span>';
                return;
            }
            
            // S'assurer que customerPhone est une chaîne
            customerPhone = String(customerPhone || '').trim();
            
            // Préparer les données pour l'API
            const paymentData = {
                plan_id: planId ? String(planId) : '',
                customer_phone: String(customerPhone),
                niveau: selectedNiveau,
                periode: selectedPeriod,
                montant: String(prices[selectedNiveau][selectedPeriod]),
                mode_paiement: selectedPaymentMethod
            };
            
            // Si MVola, ajouter le PIN
            if (selectedPaymentMethod === 'mvola' && customerPhone) {
                const pinInput = document.getElementById('mvola-pin');
                if (pinInput) {
                    paymentData.pin = pinInput.value.trim();
                }
            }
            
            // Envoyer la requête au serveur
            fetch('{{ path('organisateur_paiement_abonnement_initiate') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(paymentData)
            })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                    return;
                }
                return response.json();
            })
            .then(data => {
                if (data && data.console_logs) {
                    console.log('📋 [Transaction]', data.console_logs);
                }

                if (data && data.success) {
                    console.log('✅ [Transaction] Transaction initiée avec succès', {
                        reference: data.transaction_reference,
                        server_correlation_id: data.server_correlation_id
                    });
                    
                    showNotification('Transaction initiée avec succès ! Envoi de l\'email en cours...', 'info');
                    
                    return fetch('{{ path('organisateur_paiement_abonnement_finalize') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            transaction_reference: data.transaction_reference,
                            server_correlation_id: data.server_correlation_id || '',
                            plan_id: planId || '',
                            niveau: selectedNiveau,
                            periode: selectedPeriod,
                            montant: prices[selectedNiveau][selectedPeriod],
                            mode_paiement: selectedPaymentMethod
                        })
                    });
                } else {
                    const errorMsg = data?.error || 'Erreur inconnue';
                    console.error('❌ [Transaction] Échec de l\'initiation', { error: errorMsg });
                    showNotification('Erreur: ' + errorMsg, 'error');
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '<i class="fas fa-check"></i> <span>Confirmer le paiement</span>';
                    return Promise.reject(new Error(errorMsg));
                }
            })
            .then(response => {
                if (!response) return;
                return response.json();
            })
            .then(data => {
                if (!data) return;
                
                if (data.console_logs) {
                    console.log('📋 [Finalisation]', data.console_logs);
                }

                if (data.success) {
                    if (data.email_sent) {
                        console.log('✅ [Email] Email envoyé avec succès', {
                            invoice_number: data.invoice_number,
                            email: data.customer_email
                        });
                        console.log('✅ [Facture] Facture créée et enregistrée dans la base de données', {
                            invoice_number: data.invoice_number,
                            invoice_id: data.invoice_id
                        });
                        
                        showNotification(
                            'Paiement effectué avec succès ! Votre facture ' + data.invoice_number + 
                            ' a été générée et envoyée par email.', 
                            'success'
                        );
                    } else {
                        console.warn('⚠️ [Email] Échec de l\'envoi de l\'email', {
                            error: data.error
                        });
                        showNotification(
                            'Transaction initiée mais l\'email n\'a pas pu être envoyé. ' +
                            'Veuillez contacter le support.', 
                            'warning'
                        );
                    }
                    
                    closePaymentModal();
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else {
                    const errorMsg = data?.error || 'Erreur inconnue';
                    console.error('❌ [Finalisation] Erreur', { error: errorMsg });
                    showNotification('Erreur lors de la finalisation: ' + errorMsg, 'error');
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '<i class="fas fa-check"></i> <span>Confirmer le paiement</span>';
                }
            })
            .catch(error => {
                console.error('❌ [Paiement] Erreur lors du processus de paiement', error);
                showNotification('Erreur lors du processus de paiement: ' + (error.message || 'Erreur inconnue'), 'error');
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fas fa-check"></i> <span>Confirmer le paiement</span>';
            });
        });
    }

    // Fermer avec la touche Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
            closePaymentModal();
        }
    });
}

// Fonction pour afficher des notifications
function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `notification notification-${type}`;
    notification.innerHTML = `
        <div class="notification-content">
            <i class="fas ${type === 'error' ? 'fa-exclamation-circle' : type === 'success' ? 'fa-check-circle' : 'fa-info-circle'}"></i>
            <span>${message}</span>
        </div>
    `;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.classList.add('show');
    }, 10);
    
    setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => {
            notification.remove();
        }, 300);
    }, 5000);
}

</script>

