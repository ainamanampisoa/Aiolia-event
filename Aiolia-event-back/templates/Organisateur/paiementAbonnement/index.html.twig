// Fonction de validation du code PIN
function validateMvolaPin() {
    const pinInput = document.getElementById('mvola-pin');
    const pinError = document.getElementById('pin-error');
    const pinErrorText = document.getElementById('pin-error-text');
    const attemptsCounter = document.getElementById('attempts-counter');
    const attemptsRemaining = document.getElementById('attempts-remaining');
    
    if (!pinInput) return false;
    
    const pin = pinInput.value.trim();
    
    // Réinitialiser les erreurs
    pinError.style.display = 'none';
    pinInput.classList.remove('error', 'error-border', 'success');
    mvolaPinValidated = false;
    
    // Validation basique du format
    if (pin.length === 0) {
        pinInput.classList.add('error-border');
        updatePaymentButton();
        return false;
    }
    
    // Vérifier la longueur
    if (pin.length < 4 || pin.length > 6) {
        pinError.style.display = 'flex';
        pinErrorText.textContent = 'Le code PIN doit contenir entre 4 et 6 chiffres';
        pinInput.classList.add('error', 'error-border');
        mvolaPinValidated = false;
        updatePaymentButton();
        return false;
    }
    
    // Vérifier que ce sont uniquement des chiffres
    if (!/^[0-9]+$/.test(pin)) {
        pinError.style.display = 'flex';
        pinErrorText.textContent = 'Le code PIN ne doit contenir que des chiffres';
        pinInput.classList.add('error', 'error-border');
        mvolaPinValidated = false;
        updatePaymentButton();
        return false;
    }
    
    // Si le format est valide
    mvolaPinValidated = true;
    pinError.style.display = 'none';
    pinInput.classList.remove('error', 'error-border');
    pinInput.classList.add('success');
    attemptsCounter.style.display = 'none';
    
    console.log('✅ [validateMvolaPin] PIN validé:', pin.length, 'chiffres');
    updatePaymentButton();
    
    return true;
}

// Fonction pour mettre à jour le bouton de paiement
function updatePaymentButton() {
    const btnPayment = document.getElementById('btn-payment');
    if (!btnPayment) return;
    
    // Vérifier toutes les conditions nécessaires
    const hasNiveau = selectedNiveau !== null;
    const hasPeriod = selectedPeriod !== null;
    const hasPaymentMethod = selectedPaymentMethod !== null;
    
    // Si MVola est sélectionné
    let canProceed = hasNiveau && hasPeriod && hasPaymentMethod;
    
    if (selectedPaymentMethod === 'mvola' && mvolaNumber) {
        // Vérifier que le numéro MVola est valide (ne contient pas d'email)
        if (!isValidPhoneNumberForPayment(mvolaNumber)) {
            console.error('❌ [updatePaymentButton] Numéro MVola invalide (contient email ou format incorrect):', mvolaNumber);
            canProceed = false;
        }
        
        // Vérifier le code PIN
        const pinInput = document.getElementById('mvola-pin');
        if (pinInput) {
            const pin = pinInput.value.trim();
            // Le PIN doit avoir entre 4 et 6 chiffres
            const isPinValid = mvolaPinValidated && pin.length >= 4 && pin.length <= 6;
            
            if (!isPinValid) {
                canProceed = false;
            }
        }
        
        // Vérifier si l'utilisateur a modifié le numéro
        const newNumberInput = document.getElementById('new-mvola-number');
        const changeForm = document.getElementById('change-number-form');
        
        // Si le formulaire de changement de numéro n'est pas visible, utiliser le numéro du profil
        if (!changeForm || changeForm.style.display === 'none') {
            // Le formulaire n'est pas visible, donc on utilise le numéro du profil (déjà validé)
            isPhoneNumberValid = true;
            console.log('✅ [updatePaymentButton] Formulaire de changement non visible - numéro du profil utilisé');
        } else if (newNumberInput) {
            // Le formulaire est visible
            const newNumber = newNumberInput.value.trim();
            if (newNumber !== '') {
                // Le numéro modifié doit être valide
                if (!isPhoneNumberValid || !isValidPhoneNumberForPayment(newNumber)) {
                    canProceed = false;
                }
            } else {
                // Champ vide = on garde le numéro du profil
                isPhoneNumberValid = true;
            }
        } else {
            // Pas de champ de modification, utiliser le numéro du profil
            isPhoneNumberValid = true;
        }
    }
    
    // Mettre à jour l'état du bouton
    btnPayment.disabled = !canProceed;
    
    // Ajouter/retirer les classes CSS
    if (canProceed) {
        btnPayment.classList.add('enabled');
        btnPayment.classList.remove('has-invalid-fields');
    } else {
        btnPayment.classList.remove('enabled');
        btnPayment.classList.add('has-invalid-fields');
    }
    
    console.log('🔘 [updatePaymentButton]', {
        hasNiveau,
        hasPeriod,
        hasPaymentMethod,
        canProceed,
        selectedPaymentMethod,
        mvolaPinValidated,
        isPhoneNumberValid
    });
}

