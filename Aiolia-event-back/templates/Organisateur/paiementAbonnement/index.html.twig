    updatePaymentButton();
    
    // Log pour déboguer
    console.log('📋 [validateAllFields] État:', {
        selectedNiveau,
        selectedPeriod,
        selectedPaymentMethod,
        mvolaPinValidated,
        isPhoneNumberValid
    });
}

// Fonction pour obtenir les mois selon la période (avec année)
function getMonthsForPeriod(period) {
    const months = [
        'janvier', 'février', 'mars', 'avril', 'mai', 'juin',
        'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'
    ];
    
    // Utiliser le prochain mois de facturation depuis la base de données si disponible
    let startDate;
    if (nextBillingMonth) {
        console.log('📅 [getMonthsForPeriod] nextBillingMonth reçu:', nextBillingMonth, 'type:', typeof nextBillingMonth);
        // Parser la date au format YYYY-MM-DD
        const dateParts = nextBillingMonth.split('-');
        if (dateParts.length === 3) {
            const year = parseInt(dateParts[0]);
            const month = parseInt(dateParts[1]) - 1; // Les mois en JavaScript sont 0-indexés
            const day = parseInt(dateParts[2]);
            startDate = new Date(year, month, day);
            console.log('📅 [getMonthsForPeriod] Parsing de la date:', {
                input: nextBillingMonth,
                year, month: month + 1, day,
                result: startDate,
                formatted: startDate.toISOString()
            });
        } else {
            // Si le format n'est pas correct, essayer de parser directement
            startDate = new Date(nextBillingMonth);
            console.log('📅 [getMonthsForPeriod] Parsing direct de la date:', nextBillingMonth, '->', startDate);
        }
        
        // Vérifier que la date est valide
        if (isNaN(startDate.getTime())) {
            console.warn('⚠️ [getMonthsForPeriod] Date invalide, utilisation du mois suivant');
            startDate = new Date();
            startDate.setMonth(startDate.getMonth() + 1);
            startDate.setDate(1);
        } else {
            console.log('✅ [getMonthsForPeriod] Date valide:', startDate.toISOString(), 'Mois:', startDate.getMonth() + 1, 'Année:', startDate.getFullYear());
        }
    } else {
        // Fallback : utiliser le mois suivant si pas de données depuis la base
        startDate = new Date();
        startDate.setMonth(startDate.getMonth() + 1);
        startDate.setDate(1); // Premier jour du mois
        console.log('📅 [getMonthsForPeriod] Pas de date depuis la base, utilisation du mois suivant:', startDate);
    }
    
    const startMonth = startDate.getMonth(); // 0-11
    const startYear = startDate.getFullYear();
    
    console.log('📅 [getMonthsForPeriod] Mois calculé:', {
        period,
        startMonth,
        startYear,
        monthName: months[startMonth]
    });
    
    if (period === 'monthly') {
        return months[startMonth] + ' ' + startYear;
    } else if (period === 'quarterly') {
        const quarterMonths = [];
        const quarterYears = [];
        for (let i = 0; i < 3; i++) {
            const monthIndex = (startMonth + i) % 12;
            const year = startYear + Math.floor((startMonth + i) / 12);
            quarterMonths.push(months[monthIndex]);
            quarterYears.push(year);
        }
        // Si toutes les années sont identiques, afficher une seule fois
        if (quarterYears[0] === quarterYears[2]) {
            return quarterMonths[0] + ' - ' + quarterMonths[2] + ' ' + quarterYears[0];
        } else {
            return quarterMonths[0] + ' ' + quarterYears[0] + ' - ' + quarterMonths[2] + ' ' + quarterYears[2];
        }
    } else if (period === 'yearly') {
        const yearlyMonths = [];
        const yearlyYears = [];
        for (let i = 0; i < 12; i++) {
            const monthIndex = (startMonth + i) % 12;
            const year = startYear + Math.floor((startMonth + i) / 12);
            yearlyMonths.push(months[monthIndex]);
            yearlyYears.push(year);
        }
        // Si toutes les années sont identiques, afficher une seule fois
        if (yearlyYears[0] === yearlyYears[11]) {
            return yearlyMonths[0] + ' - ' + yearlyMonths[11] + ' ' + yearlyYears[0];
        } else {
            return yearlyMonths[0] + ' ' + yearlyYears[0] + ' - ' + yearlyMonths[11] + ' ' + yearlyYears[11];
        }
    }
    
    return '';
}

