function validateAllFields() {
    console.log('🔍 [validateAllFields] Validation de tous les champs...');
    
    // Nettoyer d'abord le champ s'il contient des valeurs invalides
    cleanPhoneNumberField();
    
    // Valider le PIN si MVola est sélectionné
    if (selectedPaymentMethod === 'mvola') {
        validateMvolaPin();
        
        // Valider le numéro de téléphone si le formulaire de modification est visible
        const changeForm = document.getElementById('change-number-form');
