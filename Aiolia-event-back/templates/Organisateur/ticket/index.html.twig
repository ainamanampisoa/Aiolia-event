    const modalBody = document.getElementById('modalBody');
    const closeModalBtn = document.getElementById('closeModal');
    const editButtons = document.querySelectorAll('[data-edit-price]');
    
    // Ouvrir le modal
    editButtons.forEach(button => {
        button.addEventListener('click', function() {
            const billetId = this.getAttribute('data-billet-id');
            
            // Charger le formulaire via AJAX
            fetch(`/tickets/${billetId}/edit-price`, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                },
            })
            .then(response => response.json())
            .then(data => {
                modalBody.innerHTML = data.html;
                modal.classList.add('active');
                
                // Gérer la soumission du formulaire
                const form = modalBody.querySelector('form');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        
                        const formData = new FormData(form);
                        const submitButton = form.querySelector('button[type="submit"]');
                        const originalText = submitButton.innerHTML;
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
                        
                        fetch(form.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Afficher un message de succès
                                const successMessage = document.createElement('div');
                                successMessage.className = 'alert alert-success';
                                successMessage.style.cssText = 'padding: 12px; margin-bottom: 16px; background: var(--success); color: white; border-radius: var(--border-radius-sm);';
                                successMessage.innerHTML = `<i class="fas fa-check-circle"></i> ${data.message}`;
                                modalBody.insertBefore(successMessage, form);
                                
                                // Fermer le modal après 1.5 secondes et recharger la page
                                setTimeout(() => {
                                    modal.classList.remove('active');
                                    window.location.reload();
                                }, 1500);
                            }
                        })
                        .catch(error => {
                            console.error('Erreur:', error);
                            submitButton.disabled = false;
                            submitButton.innerHTML = originalText;
                        });
                    });
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
            });
        });
    });
    
    // Fermer le modal
    closeModalBtn.addEventListener('click', function() {
        modal.classList.remove('active');
    });
    
    modal.addEventListener('click', function(e) {
        if (e.target === modal) {
            modal.classList.remove('active');
        }
    });
    
    // Fermer avec la touche Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('active')) {
            modal.classList.remove('active');
        }
    });
});

// Fonction pour afficher le QR code dans un modal
function showQrCodeModal(billetId, numeroFacture, qrCodeData, statut) {
    // Utiliser le vrai code QR du billet depuis la base de données
    // Si le code QR n'est pas fourni, utiliser l'ID comme fallback
    let hasValidQrCode = true;
    if (!qrCodeData || qrCodeData === '' || qrCodeData === 'null' || qrCodeData === 'undefined') {
        qrCodeData = 'TKT-' + billetId;
        hasValidQrCode = false;
    }
    
    // Nettoyer le code QR (supprimer les espaces et caractères spéciaux)
    qrCodeData = String(qrCodeData).trim();
    
    // Générer l'URL du QR code avec l'API QR Server
    const qrCodeUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(qrCodeData);
    
    // Debug: afficher l'URL dans la console
    console.log('QR Code URL:', qrCodeUrl);
    console.log('QR Code Data:', qrCodeData);
    
    // Créer ou récupérer le modal QR code
    let qrModal = document.getElementById('qr-code-modal');
    if (!qrModal) {
        qrModal = document.createElement('div');
        qrModal.id = 'qr-code-modal';
        qrModal.className = 'qr-code-modal';
        qrModal.innerHTML = `
            <div class="qr-code-modal-content">
                <div class="qr-code-modal-header">
                    <h3><i class="fas fa-qrcode"></i> QR Code du billet</h3>
                    <button class="qr-code-modal-close" onclick="closeQrCodeModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="qr-code-modal-body">
                    <div class="qr-code-preview-container">
                        <div id="qr-code-dispo-notice" class="qr-code-dispo-notice" style="display: none;">
                            <i class="fas fa-info-circle"></i>
                            <span>Billet disponible - QR code prêt à être scanné</span>
                        </div>
                        <img id="qr-code-preview-image" src="" alt="QR Code" class="qr-code-preview-image">
                        <p class="qr-code-preview-label" id="qr-code-preview-label"></p>
                        <div class="qr-code-preview-code" id="qr-code-preview-code" style="display: none;">
                            <i class="fas fa-key"></i>
                            <code id="qr-code-preview-code-text"></code>
                        </div>
                        <div class="qr-code-preview-actions">
                            <a id="qr-code-download-link" href="" download class="btn-download-qr-preview">
                                <i class="fas fa-download"></i> Télécharger
                            </a>
                            <button type="button" id="qr-code-print-btn" class="btn-print-qr-preview" onclick="window.print()">
                                <i class="fas fa-print"></i> Imprimer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;
        document.body.appendChild(qrModal);
    }
    
    // Mettre à jour le contenu du modal
    const qrImage = document.getElementById('qr-code-preview-image');
    const qrLabel = document.getElementById('qr-code-preview-label');
    const qrDownloadLink = document.getElementById('qr-code-download-link');
    const qrDispoNotice = document.getElementById('qr-code-dispo-notice');
    const qrCodePreview = document.getElementById('qr-code-preview-code');
    const qrCodeText = document.getElementById('qr-code-preview-code-text');
    const qrPrintBtn = document.getElementById('qr-code-print-btn');
    
    // Afficher/masquer la notice pour les billets disponibles
    if (statut === 'dispo') {
        qrDispoNotice.style.display = 'flex';
        qrCodePreview.style.display = 'block';
        qrCodeText.textContent = qrCodeData.length > 30 ? qrCodeData.substring(0, 30) + '...' : qrCodeData;
    } else {
        qrDispoNotice.style.display = 'none';
        qrCodePreview.style.display = 'none';
    }
    
    // Le bouton imprimer est toujours visible pour tous les statuts
    qrPrintBtn.style.display = 'inline-flex';
    
    // Réinitialiser l'image avant de charger
    qrImage.style.border = '';
    qrImage.style.display = 'block';
    
    // Charger l'image avec gestion d'erreur améliorée
    qrImage.onload = function() {
        console.log('QR Code image chargée avec succès');
        this.style.border = '';
        this.style.display = 'block';
    };
    
    qrImage.onerror = function() {
        console.error('Erreur lors du chargement du QR code:', qrCodeUrl);
        this.src = 'data:image/svg+xml;base64,';
        this.style.border = '2px solid #dc3545';
        this.style.display = 'block';
    };
    
    // Définir la source de l'image
    qrImage.src = qrCodeUrl;
    
    // Afficher un avertissement si le code QR n'est pas valide
    if (!hasValidQrCode) {
        const warningNotice = document.createElement('div');
        warningNotice.className = 'qr-code-warning-notice';
        warningNotice.innerHTML = '<i class="fas fa-exclamation-triangle"></i><span>Code QR non disponible - Utilisation de l\'ID du billet</span>';
        qrModal.querySelector('.qr-code-modal-body').insertBefore(warningNotice, qrModal.querySelector('.qr-code-preview-container'));
    }
    
    qrLabel.textContent = numeroFacture || 'Billet #' + billetId;
    qrDownloadLink.href = qrCodeUrl;
    qrDownloadLink.download = 'qrcode-' + (numeroFacture || 'billet-' + billetId).replace(/[^a-zA-Z0-9]/g, '-') + '.png';
    
    // Afficher le modal
    qrModal.classList.add('active');
}

function closeQrCodeModal() {
    const qrModal = document.getElementById('qr-code-modal');
    if (qrModal) {
        qrModal.classList.remove('active');
        // Nettoyer les notices d'avertissement
        const warningNotice = qrModal.querySelector('.qr-code-warning-notice');
        if (warningNotice) {
            warningNotice.remove();
        }
    }
}

// Fermer le modal QR code en cliquant à l'extérieur
document.addEventListener('click', function(e) {
    const qrModal = document.getElementById('qr-code-modal');
    if (qrModal && e.target === qrModal) {
        closeQrCodeModal();
    }
});

// Fermer avec Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeQrCodeModal();
    }
});
</script>
{% endblock %}

