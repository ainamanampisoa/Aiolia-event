{# Pas de thème Bootstrap, utilisation de styles personnalisés #}

<div class="price-info">
    <p><strong>Type de billet:</strong> {{ typeBillet.nom }}</p>
    <p><strong>Prix actuel:</strong> {{ typeBillet.prixDeBase|number_format(2, ',', ' ') }} {{ typeBillet.devise }}</p>
    {% if typeBillet.evenement %}
        <p><strong>Événement:</strong> {{ typeBillet.evenement.titre }}</p>
    {% endif %}
</div>

{{ form_start(form, {'action': path('app_ticket_edit_price', {id: billet.id}), 'method': 'POST'}) }}

<div class="form-group">
    {{ form_label(form.prixDeBase) }}
    {{ form_widget(form.prixDeBase, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.prixDeBase) }}
</div>

<div class="form-group">
    {{ form_label(form.raison) }}
    {{ form_widget(form.raison, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.raison) }}
</div>

<div class="modal-footer">
    <button type="button" class="btn-modal btn-modal-secondary" id="cancelEditPrice">Annuler</button>
    {{ form_widget(form.submit, {'attr': {'class': 'btn-modal btn-modal-primary'}}) }}
</div>

{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const cancelBtn = document.getElementById('cancelEditPrice');
    if (cancelBtn) {
        cancelBtn.addEventListener('click', function() {
            document.getElementById('editPriceModal').classList.remove('active');
        });
    }
});
</script>

