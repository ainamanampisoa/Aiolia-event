{% extends 'base.html.twig' %}

{% block title %}Scanner de billets - Aiolia Event{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Styles pour le breadcrumb */
.event-detail-header {
    margin-bottom: 20px;
}

.header-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    font-size: 0.9rem;
}

.header-breadcrumb a {
    color: var(--accent);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
}

.header-breadcrumb a:hover {
    text-decoration: underline;
}

.header-breadcrumb i {
    font-size: 0.7rem;
    color: var(--gray-500);
}

.header-breadcrumb span {
    color: var(--gray-700);
    font-weight: var(--font-weight-semibold);
}

.dashboard-header {
    margin-bottom: 24px;
}

.scanner-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 24px;
}

.scanner-section {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    padding: 28px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
}

.scanner-section:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
}

.scanner-section h3 {
    margin: 0 0 20px 0;
    font-size: 1.3rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
}

.scanner-section h3 i {
    color: var(--accent);
}

#video-container {
    width: 100%;
    max-width: 100%;
    margin-bottom: 20px;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    background: #000;
    position: relative;
}

#reader {
    width: 100%;
    min-height: 400px;
    position: relative;
}

#scanner-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    transition: all 0.3s ease;
}

#reader video {
    width: 100%;
    height: auto;
    display: block;
}

#reader #qr-shaded-region {
    border: 4px solid rgba(52, 152, 219, 1) !important;
    border-radius: 16px !important;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.5) !important;
}

.scanner-controls {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.btn-scanner {
    flex: 1;
    padding: 12px 24px;
    border: none;
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.btn-scanner-primary {
    background: linear-gradient(135deg, #5DADE2 0%, #3498DB 100%);
    color: white;
}

.btn-scanner-primary:hover {
    background: linear-gradient(135deg, #3498DB 0%, #2980B9 100%);
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.btn-scanner-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.btn-scanner-secondary:hover {
    background: var(--gray-100);
}

.btn-scanner:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.scan-result {
    margin-top: 20px;
    padding: 20px;
    border-radius: var(--border-radius-md);
    display: none;
}

.scan-result.success {
    background: rgba(39, 174, 96, 0.1);
    border: 2px solid var(--success);
    display: block;
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-20px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.6;
    }
}

.scan-result.error {
    background: rgba(231, 76, 60, 0.1);
    border: 2px solid var(--danger);
    display: block;
}

.scan-result h4 {
    margin: 0 0 16px 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
}

.scan-result.success h4 {
    color: var(--success);
}

.scan-result.error h4 {
    color: var(--danger);
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-color);
    transition: background-color 0.2s ease;
    border-radius: var(--border-radius-sm);
    margin-bottom: 4px;
}

.detail-row:hover {
    background-color: rgba(52, 152, 219, 0.03);
}

.detail-row:last-child {
    border-bottom: none;
    margin-bottom: 0;
}

.detail-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: var(--font-weight-medium);
    color: var(--text-secondary);
    font-size: 0.9rem;
    min-width: 150px;
}

.detail-label i {
    color: var(--accent);
    font-size: 0.85rem;
    width: 16px;
    text-align: center;
}

.detail-value {
    flex: 1;
    text-align: right;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: var(--font-weight-medium);
    word-break: break-word;
}

.status-badge {
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-medium);
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

/* Styles harmonisés pour les badges de statut */
.status-dispo {
    background: linear-gradient(135deg, #d4edda, #c3e6cb);
    color: #155724;
    border: 1px solid #28a745;
    font-weight: var(--font-weight-semibold);
}

.status-dispo i {
    color: #28a745;
}

.status-active {
    background: linear-gradient(135deg, rgba(39, 174, 96, 0.15), rgba(39, 174, 96, 0.08));
    color: #27ae60;
    border: 1px solid rgba(39, 174, 96, 0.3);
    font-weight: var(--font-weight-medium);
}

.status-active i {
    color: #27ae60;
}

.status-pending {
    background: linear-gradient(135deg, rgba(243, 156, 18, 0.15), rgba(243, 156, 18, 0.08));
    color: #d68910;
    border: 1px solid rgba(243, 156, 18, 0.3);
    font-weight: var(--font-weight-medium);
}

.status-pending i {
    color: #f39c12;
}

.status-transferred {
    background: linear-gradient(135deg, rgba(52, 152, 219, 0.15), rgba(52, 152, 219, 0.08));
    color: #2980b9;
    border: 1px solid rgba(52, 152, 219, 0.3);
    font-weight: var(--font-weight-medium);
}

.status-transferred i {
    color: #3498db;
}

.status-refunded {
    background: linear-gradient(135deg, rgba(192, 57, 43, 0.15), rgba(192, 57, 43, 0.08));
    color: #c0392b;
    border: 1px solid rgba(192, 57, 43, 0.3);
    font-weight: var(--font-weight-medium);
}

.status-refunded i {
    color: #c0392b;
}

.status-inactive {
    background: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    font-weight: var(--font-weight-medium);
}

/* Messages de statut du billet */
.ticket-status-message {
    margin-top: 16px;
    padding: 16px 20px;
    border-radius: var(--border-radius-md);
    display: none;
    animation: slideIn 0.4s ease;
    font-size: 0.95rem;
    line-height: 1.5;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.ticket-status-message.active {
    display: block;
}

.ticket-status-message.success {
    background: linear-gradient(135deg, rgba(39, 174, 96, 0.12), rgba(39, 174, 96, 0.06));
    border-left: 4px solid var(--success);
    color: #155724;
}

.ticket-status-message.error {
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.12), rgba(231, 76, 60, 0.06));
    border-left: 4px solid var(--danger);
    color: #721c24;
}

.ticket-status-message.warning {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.12), rgba(251, 191, 36, 0.06));
    border-left: 4px solid var(--warning);
    color: #856404;
}

.ticket-status-message-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    font-weight: var(--font-weight-semibold);
    font-size: 1rem;
}

.ticket-status-message-header i {
    font-size: 1.2rem;
}

.ticket-status-message.success .ticket-status-message-header {
    color: var(--success);
}

.ticket-status-message.error .ticket-status-message-header {
    color: var(--danger);
}

.ticket-status-message.warning .ticket-status-message-header {
    color: var(--warning);
}

.ticket-status-message-body {
    margin-top: 8px;
    font-size: 0.9rem;
    opacity: 0.9;
}

@media (max-width: 992px) {
    .scanner-container {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-qrcode"></i> Scanner de billets</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Scannez le code QR d'un billet pour voir ses détails et les informations de facture
            </p>
        </div>
    </div>

    <div class="scanner-container">
        <!-- Section Scanner -->
        <div class="scanner-section">
            <h3><i class="fas fa-qrcode"></i> Scanner</h3>
            <div id="scannerTips" style="background: rgba(52, 152, 219, 0.05); border-left: 3px solid var(--accent); padding: 12px; margin-bottom: 16px; border-radius: var(--border-radius-sm);">
                <p style="margin: 0; font-size: 0.9rem; color: var(--text-secondary);">
                    <i class="fas fa-info-circle" style="color: var(--accent); margin-right: 8px;"></i>
                    <strong>Conseil :</strong> Pour scanner un QR code sur écran :
                </p>
                <ul style="margin: 8px 0 0 20px; font-size: 0.85rem; color: var(--text-secondary);">
                    <li>Augmentez la luminosité de l'écran qui affiche le QR code</li>
                    <li>Maintenez une distance de 15-25 cm</li>
                    <li>Le QR code doit occuper 70-80% du cadre bleu</li>
                    <li>Évitez les reflets sur l'écran</li>
                </ul>
            </div>
            <div id="scannedQrCodeDisplay" style="display: none; background: linear-gradient(135deg, rgba(39, 174, 96, 0.12), rgba(39, 174, 96, 0.06)); border-left: 4px solid var(--success); padding: 16px; margin-bottom: 20px; border-radius: var(--border-radius-md); box-shadow: 0 2px 8px rgba(39, 174, 96, 0.15); animation: slideIn 0.4s ease;">
                <p style="margin: 0 0 14px 0; font-size: 0.95rem; color: var(--text-primary); display: flex; align-items: center; gap: 10px; font-weight: var(--font-weight-semibold);">
                    <i class="fas fa-qrcode" style="color: var(--success); font-size: 1.1rem;"></i>
                    <span>Code QR scanné :</span>
                </p>
                <p id="scannedQrCodeText" style="margin: 0; font-family: 'Courier New', monospace; font-size: 0.9rem; color: var(--text-primary); word-break: break-all; background: var(--bg-card); padding: 14px; border-radius: var(--border-radius-sm); border: 1px solid rgba(39, 174, 96, 0.2); box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05); line-height: 1.6;"></p>
            </div>
            
            <!-- Message de statut du billet -->
            <div id="ticketStatusMessage" class="ticket-status-message"></div>
            <div id="video-container">
                <div id="reader" style="width: 100%; min-height: 400px; background: #000; border-radius: var(--border-radius-md); position: relative; overflow: hidden; display: none;"></div>
                <div id="scanner-placeholder" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 400px; background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); border-radius: var(--border-radius-md); color: #fff; padding: 20px; position: relative; overflow: hidden;">
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 200px; height: 200px; background: radial-gradient(circle, rgba(52, 152, 219, 0.1) 0%, transparent 70%); border-radius: 50%;"></div>
                    <div style="position: relative; z-index: 1; text-align: center;">
                        <div style="width: 100px; height: 100px; margin: 0 auto 24px; background: rgba(52, 152, 219, 0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid rgba(52, 152, 219, 0.3);">
                            <i class="fas fa-camera" style="font-size: 2.5rem; color: rgba(52, 152, 219, 0.8);"></i>
                        </div>
                        <p style="margin: 0; font-size: 1.05rem; opacity: 0.9; font-weight: var(--font-weight-medium);">Prêt à scanner</p>
                        <p style="margin: 8px 0 0 0; font-size: 0.9rem; opacity: 0.7;">Cliquez sur "Démarrer le scan" pour activer la caméra</p>
                    </div>
                </div>
            </div>
            <div class="scanner-controls">
                <button id="startScan" class="btn-scanner btn-scanner-primary">
                    <i class="fas fa-play"></i> Démarrer le scan
                </button>
                <button id="stopScan" class="btn-scanner btn-scanner-secondary" disabled>
                    <i class="fas fa-stop"></i> Arrêter
                </button>
            </div>
            <div id="scanResult" class="scan-result"></div>
            <div id="scanningIndicator" style="display: none; margin-top: 16px; padding: 12px; background: rgba(52, 152, 219, 0.1); border-radius: var(--border-radius-sm); border-left: 3px solid var(--accent);">
                <div style="display: flex; align-items: center; gap: 10px; color: var(--accent);">
                    <i class="fas fa-search fa-spin"></i>
                    <span style="font-weight: var(--font-weight-medium);">Recherche d'un code QR...</span>
                </div>
                <div id="scanStats" style="margin-top: 8px; font-size: 0.85rem; color: var(--text-secondary);">
                    <span id="scanAttemptsCount">0</span> tentatives
                </div>
            </div>
        </div>

        <!-- Section Résultats -->
        <div class="scanner-section">
            <h3><i class="fas fa-info-circle"></i> Informations du billet</h3>
            <div id="ticketInfo" style="display: none;"></div>
            <div id="factureInfo" style="display: none;"></div>
            <div id="noInfo" style="text-align: center; padding: 60px 40px; color: var(--text-secondary);">
                <div style="width: 120px; height: 120px; margin: 0 auto 24px; background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(52, 152, 219, 0.05)); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-qrcode" style="font-size: 3.5rem; color: var(--accent); opacity: 0.4;"></i>
                </div>
                <p style="font-size: 1.1rem; font-weight: var(--font-weight-medium); margin-bottom: 8px; color: var(--text-primary);">Aucun scan effectué</p>
                <p style="font-size: 0.95rem; opacity: 0.8;">Scannez un code QR pour voir les informations du billet</p>
            </div>
            <div id="loadingInfo" style="display: none; text-align: center; padding: 60px 40px;">
                <div style="width: 80px; height: 80px; margin: 0 auto 24px; background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(52, 152, 219, 0.05)); border-radius: 50%; display: flex; align-items: center; justify-content: center; animation: pulse 2s ease-in-out infinite;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 2.5rem; color: var(--accent);"></i>
                </div>
                <p style="margin-top: 16px; color: var(--text-secondary); font-size: 1rem; font-weight: var(--font-weight-medium);">Chargement des informations...</p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<style>
#reader video {
    width: 100% !important;
    height: auto !important;
    object-fit: cover;
    filter: contrast(1.3) brightness(1.2) saturate(1.1);
}

#reader canvas {
    display: none !important;
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const reader = document.getElementById('reader');
    const placeholder = document.getElementById('scanner-placeholder');
    const startScanBtn = document.getElementById('startScan');
    const stopScanBtn = document.getElementById('stopScan');
    const scanResult = document.getElementById('scanResult');
    const scanningIndicator = document.getElementById('scanningIndicator');
    const ticketInfo = document.getElementById('ticketInfo');
    const factureInfo = document.getElementById('factureInfo');
    const noInfo = document.getElementById('noInfo');
    const loadingInfo = document.getElementById('loadingInfo');
    const scanStatsDiv = document.getElementById('scanStats');
    const scanAttemptsCount = document.getElementById('scanAttemptsCount');
    const scannerTips = document.getElementById('scannerTips');
    const scannedQrCodeDisplay = document.getElementById('scannedQrCodeDisplay');
    const scannedQrCodeText = document.getElementById('scannedQrCodeText');
    const ticketStatusMessage = document.getElementById('ticketStatusMessage');
    
    let html5QrCode = null;
    let scanning = false;
    let scanAttempts = 0;
    let hasScanned = false;

    startScanBtn.addEventListener('click', function() {
        if (scanning) return;
        
        placeholder.style.display = 'none';
        reader.style.display = 'block';
        
        html5QrCode = new Html5Qrcode("reader");
        scanning = true;
        hasScanned = false;
        scanAttempts = 0;
        startScanBtn.disabled = true;
        stopScanBtn.disabled = false;
        scanResult.style.display = 'none';
        scanningIndicator.style.display = 'block';
        scanStatsDiv.style.display = 'block';
        scanAttemptsCount.textContent = '0';
        
        // Réafficher les conseils au démarrage d'un nouveau scan
        scannerTips.style.display = 'block';
        scannedQrCodeDisplay.style.display = 'none';
        ticketStatusMessage.classList.remove('active', 'success', 'error', 'warning');
        ticketStatusMessage.innerHTML = '';
        
        // Configuration optimisée pour écrans
        const config = {
            fps: 30,
            qrbox: function(viewfinderWidth, viewfinderHeight) {
                let minEdge = Math.min(viewfinderWidth, viewfinderHeight);
                let size = Math.floor(minEdge * 0.75);
                return {
                    width: Math.max(280, size),
                    height: Math.max(280, size)
                };
            },
            aspectRatio: 1.0,
            disableFlip: false,
            videoConstraints: {
                facingMode: "environment",
                width: { ideal: 1920, min: 1280 },
                height: { ideal: 1080, min: 720 },
                focusMode: 'continuous',
                exposureMode: 'continuous',
                whiteBalanceMode: 'continuous',
                advanced: [
                    { focusDistance: { ideal: 0.25 } },
                    { exposureCompensation: { ideal: 0 } }
                ]
            },
            formatsToSupport: [Html5QrcodeSupportedFormats.QR_CODE],
            experimentalFeatures: {
                useBarCodeDetectorIfSupported: true
            }
        };
        
        html5QrCode.start(
            { facingMode: "environment" },
            config,
            function(decodedText, decodedResult) {
                if (!scanning || hasScanned) return;
                if (!decodedText || decodedText.trim().length === 0) return;
                
                hasScanned = true;
                console.log('✅ QR Code détecté:', decodedText);
                
                scanningIndicator.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 10px; color: var(--success);">
                        <i class="fas fa-check-circle"></i>
                        <span style="font-weight: var(--font-weight-medium);">Code QR détecté !</span>
                    </div>
                `;
                scanningIndicator.style.background = 'rgba(39, 174, 96, 0.1)';
                scanningIndicator.style.borderLeftColor = 'var(--success)';
                
                // Arrêter le scanner
                if (html5QrCode) {
                    html5QrCode.stop().then(() => {
                        html5QrCode.clear();
                        scanning = false;
                        startScanBtn.disabled = false;
                        stopScanBtn.disabled = true;
                        placeholder.style.display = 'flex';
                        reader.style.display = 'none';
                    }).catch(err => console.error('Erreur arrêt:', err));
                }
                
                scanResult.className = 'scan-result success';
                scanResult.innerHTML = '<h4><i class="fas fa-check-circle"></i> Code QR détecté !</h4><p style="margin: 8px 0 0 0;">Chargement des informations...</p>';
                scanResult.style.display = 'block';
                
                // Remplacer les conseils par le code QR scanné dans le panneau Scanner
                scannerTips.style.display = 'none';
                scannedQrCodeText.textContent = decodedText;
                scannedQrCodeDisplay.style.display = 'block';
                
                setTimeout(() => {
                    scanningIndicator.style.display = 'none';
                }, 1500);
                
                loadTicketInfo(decodedText);
            },
            function(errorMessage) {
                if (!scanning) return;
                
                scanAttempts++;
                if (scanAttempts % 5 === 0) {
                    scanAttemptsCount.textContent = scanAttempts;
                }
            }
        ).then(() => {
            console.log('✅ Scanner démarré');
        }).catch(err => {
            console.error('❌ Erreur démarrage:', err);
            scanning = false;
            startScanBtn.disabled = false;
            stopScanBtn.disabled = true;
            scanningIndicator.style.display = 'none';
            
            let errorMsg = 'Impossible de démarrer le scanner. ';
            if (err.name === 'NotAllowedError') {
                errorMsg += '<strong>Veuillez autoriser l\'accès à la caméra.</strong>';
            } else if (err.name === 'NotFoundError') {
                errorMsg += '<strong>Aucune caméra trouvée.</strong>';
            } else {
                errorMsg += '<strong>Erreur technique.</strong>';
            }
            
            scanResult.className = 'scan-result error';
            scanResult.innerHTML = '<h4><i class="fas fa-exclamation-circle"></i> Erreur</h4><p style="margin: 8px 0 0 0;">' + errorMsg + '</p>';
            scanResult.style.display = 'block';
            placeholder.style.display = 'flex';
            reader.style.display = 'none';
        });
    });

    stopScanBtn.addEventListener('click', function() {
        if (html5QrCode && scanning) {
            html5QrCode.stop().then(() => {
                html5QrCode.clear();
                scanning = false;
                hasScanned = false;
                startScanBtn.disabled = false;
                stopScanBtn.disabled = true;
                scanResult.style.display = 'none';
                scanningIndicator.style.display = 'none';
                placeholder.style.display = 'flex';
                reader.style.display = 'none';
                // Réafficher les conseils et masquer le code QR
                scannerTips.style.display = 'block';
                scannedQrCodeDisplay.style.display = 'none';
                ticketStatusMessage.classList.remove('active', 'success', 'error', 'warning');
                ticketStatusMessage.innerHTML = '';
            }).catch(err => console.error('Erreur arrêt:', err));
        }
    });

    function displayTicketStatusMessage(billet, statusChanged) {
        const statut = billet.statut;
        
        // Réinitialiser le message
        ticketStatusMessage.classList.remove('active', 'success', 'error', 'warning');
        ticketStatusMessage.innerHTML = '';
        
        if (statusChanged && statut === 'used') {
            // Billet validé avec succès (statut changé de valid à used)
            ticketStatusMessage.classList.add('active', 'success');
            ticketStatusMessage.innerHTML = `
                <div class="ticket-status-message-header">
                    <i class="fas fa-check-circle"></i>
                    <span>Billet validé avec succès</span>
                </div>
                <div class="ticket-status-message-body">
                    Ce billet a été validé et marqué comme utilisé. L'accès à l'événement est autorisé.
                </div>
            `;
        } else if (statut === 'used') {
            // Billet déjà utilisé
            ticketStatusMessage.classList.add('active', 'warning');
            ticketStatusMessage.innerHTML = `
                <div class="ticket-status-message-header">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Billet déjà utilisé</span>
                </div>
                <div class="ticket-status-message-body">
                    Ce billet a déjà été utilisé et validé précédemment. Veuillez vérifier l'identité du porteur du billet.
                </div>
            `;
        } else if (statut === 'refunded') {
            // Billet remboursé (utilisé à la place de cancelled)
            ticketStatusMessage.classList.add('active', 'error');
            ticketStatusMessage.innerHTML = `
                <div class="ticket-status-message-header">
                    <i class="fas fa-times-circle"></i>
                    <span>Billet remboursé</span>
                </div>
                <div class="ticket-status-message-body">
                    Ce billet a été annulé et n'est plus valide. L'accès à l'événement n'est pas autorisé avec ce billet.
                </div>
            `;
        } else if (statut === 'refunded') {
            // Billet remboursé
            ticketStatusMessage.classList.add('active', 'error');
            ticketStatusMessage.innerHTML = `
                <div class="ticket-status-message-header">
                    <i class="fas fa-money-bill-wave"></i>
                    <span>Billet remboursé</span>
                </div>
                <div class="ticket-status-message-body">
                    Ce billet a été remboursé et n'est plus valide. L'accès à l'événement n'est pas autorisé avec ce billet.
                </div>
            `;
        } else {
            // Autres statuts (valid, transferred, etc.)
            ticketStatusMessage.classList.remove('active');
        }
    }

    function loadTicketInfo(qrCode) {
        loadingInfo.style.display = 'block';
        noInfo.style.display = 'none';
        ticketInfo.style.display = 'none';
        factureInfo.style.display = 'none';
        ticketStatusMessage.classList.remove('active');
        
        fetch('{{ scanApiUrl }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin',
            body: JSON.stringify({ qrCode: qrCode })
        })
        .then(async response => {
            if (!response.ok) {
                let errorMessage = `Erreur serveur (${response.status})`;
                try {
                    const errorData = await response.json();
                    errorMessage = errorData.message || errorMessage;
                } catch (e) {
                    if (response.status === 401) {
                        errorMessage = 'Session expirée. Veuillez rafraîchir la page.';
                    }
                }
                throw new Error(errorMessage);
            }
            
            const contentType = response.headers.get('content-type');
            if (!contentType || !contentType.includes('application/json')) {
                throw new Error('Réponse invalide du serveur.');
            }
            
            return response.json();
        })
        .then(data => {
            loadingInfo.style.display = 'none';
            
            if (data.success) {
                // Afficher le message de statut selon le statut du billet
                displayTicketStatusMessage(data.billet, data.statusChanged || false);
                
                displayTicketInfo(data.billet);
                if (data.facture) {
                    displayFactureInfo(data.facture);
                }
            } else {
                scanResult.className = 'scan-result error';
                scanResult.innerHTML = `<h4><i class="fas fa-exclamation-circle"></i> Erreur</h4><p>${data.message || 'Erreur de chargement'}</p>`;
                scanResult.style.display = 'block';
                noInfo.style.display = 'block';
                ticketStatusMessage.classList.remove('active');
            }
        })
        .catch(error => {
            loadingInfo.style.display = 'none';
            scanResult.className = 'scan-result error';
            scanResult.innerHTML = `<h4><i class="fas fa-exclamation-circle"></i> Erreur</h4><p>${error.message}</p>`;
            scanResult.style.display = 'block';
            noInfo.style.display = 'block';
            console.error('Erreur:', error);
        });
    }

    function displayTicketInfo(billet) {
        let html = '';
        
        html += `<div class="detail-row">
            <div class="detail-label"><i class="fas fa-hashtag"></i> Code billet</div>
            <div class="detail-value">#TKT-${String(billet.id).slice(-6)}</div>
        </div>`;
        
        html += `<div class="detail-row">
            <div class="detail-label"><i class="fas fa-calendar-check"></i> Statut</div>
            <div class="detail-value">${getStatusBadge(billet.statut)}</div>
        </div>`;
        
        if (billet.evenement) {
            html += `<div class="detail-row">
                <div class="detail-label"><i class="fas fa-calendar-alt"></i> Événement</div>
                <div class="detail-value">${billet.evenement.titre}</div>
            </div>`;
        }
        
        if (billet.typeBillet) {
            html += `<div class="detail-row">
                <div class="detail-label"><i class="fas fa-tags"></i> Type</div>
                <div class="detail-value">${billet.typeBillet.nom}</div>
            </div>`;
            
            html += `<div class="detail-row">
                <div class="detail-label"><i class="fas fa-euro-sign"></i> Prix</div>
                <div class="detail-value">${parseFloat(billet.typeBillet.prixDeBase).toLocaleString('fr-FR', {minimumFractionDigits: 2})} ${billet.typeBillet.devise}</div>
            </div>`;
        }
        
        if (billet.client) {
            html += `<div class="detail-row">
                <div class="detail-label"><i class="fas fa-user"></i> Client</div>
                <div class="detail-value">${billet.client.prenom} ${billet.client.nom}</div>
            </div>`;
            
            html += `<div class="detail-row">
                <div class="detail-label"><i class="fas fa-envelope"></i> Email</div>
                <div class="detail-value">${billet.client.email}</div>
            </div>`;
        }
        
        if (billet.emisLe) {
            const date = new Date(billet.emisLe);
            html += `<div class="detail-row">
                <div class="detail-label"><i class="fas fa-clock"></i> Date d'émission</div>
                <div class="detail-value">${date.toLocaleDateString('fr-FR')} à ${date.toLocaleTimeString('fr-FR', {hour: '2-digit', minute: '2-digit'})}</div>
            </div>`;
        }
        
        ticketInfo.innerHTML = html;
        ticketInfo.style.display = 'block';
        noInfo.style.display = 'none';
        
        setTimeout(() => {
            scanResult.style.display = 'none';
        }, 2000);
    }

    function displayFactureInfo(facture) {
        let html = '<h4 style="margin-bottom: 16px; color: var(--text-primary); margin-top: 24px;">Informations de la facture</h4>';
        
        html += `<div class="detail-row">
            <div class="detail-label"><i class="fas fa-hashtag"></i> Numéro facture</div>
            <div class="detail-value">#FAC-${facture.numeroFacture}</div>
        </div>`;
        
        html += `<div class="detail-row">
            <div class="detail-label"><i class="fas fa-calendar-check"></i> Statut</div>
            <div class="detail-value">${getFactureStatusBadge(facture.statut)}</div>
        </div>`;
        
        if (facture.emiseLe) {
            const date = new Date(facture.emiseLe);
            html += `<div class="detail-row">
                <div class="detail-label"><i class="fas fa-calendar"></i> Date d'émission</div>
                <div class="detail-value">${date.toLocaleDateString('fr-FR')}</div>
            </div>`;
        }
        
        if (facture.montantTotal) {
            html += `<div class="detail-row">
                <div class="detail-label"><i class="fas fa-money-bill-wave"></i> Montant total</div>
                <div class="detail-value"><strong style="color: var(--success); font-size: 1.1rem;">${parseFloat(facture.montantTotal).toLocaleString('fr-FR', {minimumFractionDigits: 2})} ${facture.devise}</strong></div>
            </div>`;
        }
        
        factureInfo.innerHTML = html;
        factureInfo.style.display = 'block';
    }

    function getStatusBadge(statut) {
        const badges = {
            'dispo': '<span class="status-badge status-dispo"><i class="fas fa-ticket-alt"></i> Disponible</span>',
            'valid': '<span class="status-badge status-pending"><i class="fas fa-clock"></i> En attente</span>',
            'used': '<span class="status-badge status-active"><i class="fas fa-check-circle"></i> Utilisé</span>',
            'refunded': '<span class="status-badge status-refunded"><i class="fas fa-undo"></i> Remboursé</span>',
            'transferred': '<span class="status-badge status-transferred"><i class="fas fa-exchange-alt"></i> Transféré</span>',
        };
        return badges[statut] || `<span class="status-badge">${statut}</span>`;
    }

    function getFactureStatusBadge(statut) {
        const badges = {
            'paid': '<span class="status-badge status-active">Payée</span>',
            'issued': '<span class="status-badge status-pending">Émise</span>',
            'draft': '<span class="status-badge status-pending">Brouillon</span>',
            'void': '<span class="status-badge status-inactive">Annulée</span>',
            'refunded': '<span class="status-badge status-inactive">Remboursée</span>',
            'overdue': '<span class="status-badge status-inactive">En retard</span>',
        };
        return badges[statut] || `<span class="status-badge">${statut}</span>`;
    }
});
</script>
{% endblock %}