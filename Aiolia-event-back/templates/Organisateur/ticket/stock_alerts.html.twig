{% extends 'base.html.twig' %}

{% block title %}Alertes automatiques - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <h1>
                    <i class="fas fa-bell" style="color: var(--warning); margin-right: 12px;"></i>
                    Alertes automatiques
                </h1>
                <p class="header-subtitle">
                    Surveillance en temps réel des stocks et événements
                </p>
            </div>
            <div class="header-actions">
                <button class="btn btn-secondary" id="markAllRead">
                    <i class="fas fa-check-double"></i>
                    Tout marquer comme lu
                </button>
                <button class="btn btn-primary" id="refreshAlerts">
                    <i class="fas fa-sync-alt"></i>
                    Actualiser
                </button>
            </div>
        </div>
    </div>

    <!-- Statistiques des alertes (toujours le total, même avec filtres) -->
    <div class="alerts-stats">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--warning), #f39c12);">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <h3>{{ alertesTotal|length }}</h3>
                <p>Alertes actives</p>
                <div class="stat-trend">
                    <i class="fas fa-info-circle"></i>
                    <span>Total des alertes</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--danger), #e74c3c);">
                <i class="fas fa-fire"></i>
            </div>
            <div class="stat-content">
                <h3>{{ alertesCritiques|length }}</h3>
                <p>Stock critique</p>
                <div class="stat-trend critical">
                    <i class="fas fa-exclamation"></i>
                    <span>Action requise</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--warning), #f39c12);">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <h3>{{ alertesAttention|length }}</h3>
                <p>Attention</p>
                <div class="stat-trend">
                    <i class="fas fa-bell"></i>
                    <span>Surveillance nécessaire</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--success), #27ae60);">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-content">
                <h3>{{ alertesTotal|length == 0 ? 1 : 0 }}</h3>
                <p>Aucune alerte</p>
                <div class="stat-trend success">
                    <i class="fas fa-check"></i>
                    <span>Tout va bien</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres des alertes -->
    <div class="alerts-filters">
        <div class="filters-header">
            <h3>
                <i class="fas fa-filter"></i>
                Filtres et recherche
            </h3>
            <button class="btn btn-sm btn-outline" id="clearFilters">
                <i class="fas fa-times"></i>
                Effacer
            </button>
        </div>
        
        <div class="filters-content">
            <div class="filter-group">
                <label>
                    <i class="fas fa-exclamation-circle"></i>
                    Niveau
                </label>
                <select id="filterNiveau" class="filter-select">
                    <option value="">Tous les niveaux</option>
                    <option value="critique" {% if niveauFilter == 'critique' %}selected{% endif %}>Critique</option>
                    <option value="attention" {% if niveauFilter == 'attention' %}selected{% endif %}>Attention</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label>
                    <i class="fas fa-tag"></i>
                    Catégorie
                </label>
                <select id="filterCategorie" class="filter-select">
                    <option value="">Toutes les catégories</option>
                    {% for categorieNom in categories %}
                        <option value="{{ categorieNom }}" {% if categorieFilter == categorieNom %}selected{% endif %}>
                            {{ categorieNom|capitalize }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="filter-group">
                <label>
                    <i class="fas fa-user"></i>
                    Segment d'âge
                </label>
                <select id="filterSegment" class="filter-select">
                    <option value="">Tous les segments</option>
                    {% for segmentNom in segments %}
                        <option value="{{ segmentNom }}" {% if segmentFilter == segmentNom %}selected{% endif %}>
                            {{ segmentNom|capitalize }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>

    <!-- Liste des alertes -->
    <div class="alerts-container">
        {% if alertes is empty %}
            <div style="text-align: center; padding: 60px; color: var(--gray-600);">
                <i class="fas fa-check-circle" style="font-size: 4rem; margin-bottom: 16px; display: block; color: var(--success); opacity: 0.5;"></i>
                <h3 style="color: var(--success); margin-bottom: 8px;">Aucune alerte</h3>
                <p>Tous vos stocks sont à un niveau acceptable.</p>
            </div>
        {% else %}
            {% if alertesCritiquesPaginated|length > 0 %}
        <div class="alerts-section">
            <h3 class="section-title">
                <i class="fas fa-exclamation-triangle" style="color: var(--danger);"></i>
                Alertes critiques
            </h3>
            
                    {% for alerte in alertesCritiquesPaginated %}
                        {% set typeBillet = alerte.typeBillet %}
                        {% set inventaire = alerte.inventaire %}
                        {% set evenement = typeBillet.evenement %}
                        <div class="alert-item alert-critical">
                <div class="alert-status">
                    <div class="alert-icon">
                        <i class="fas fa-fire"></i>
                    </div>
                    <div class="alert-priority">
                        <span class="priority-badge critical">
                            <i class="fas fa-exclamation"></i>
                            CRITIQUE
                        </span>
                    </div>
                </div>
                
                <div class="alert-content">
                    <div class="alert-header">
                                    <h4>{{ evenement ? evenement.titre : 'N/A' }} - {{ typeBillet.nom }}</h4>
                                    <span class="alert-time">Stock bas</span>
                    </div>
                    <p class="alert-description">
                                    Stock critique : seulement {{ alerte.quantiteRestante }} billet(s) restant(s) sur {{ inventaire.quantiteTotale }} ({{ alerte.pourcentage|number_format(1) }}%)
                    </p>
                    <div class="alert-details">
                                    {% if evenement %}
                                        {% if evenement.commenceLe %}
                        <span class="detail-item">
                            <i class="fas fa-calendar"></i>
                                                Événement : {{ evenement.commenceLe|date('d M Y') }}
                        </span>
                                        {% endif %}
                                        {% if evenement.lieu %}
                        <span class="detail-item">
                            <i class="fas fa-map-marker-alt"></i>
                                                {{ evenement.lieu.nom }}
                        </span>
                                        {% endif %}
                                    {% endif %}
                        <span class="detail-item">
                            <i class="fas fa-euro-sign"></i>
                                        Prix : {{ typeBillet.prixDeBase|number_format(2, ',', ' ') }} {{ typeBillet.devise }}
                        </span>
                    </div>
                </div>
                
                <div class="alert-actions">
                                {% if evenement %}
                                    <a href="{{ path('organisateur_events_show', { id: evenement.id }) }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                        Voir l'événement
                                    </a>
                                {% endif %}
                    <button class="btn btn-sm btn-secondary">
                        <i class="fas fa-edit"></i>
                        Modifier stock
                    </button>
                </div>
            </div>
                    {% endfor %}
                    </div>
            {% endif %}
            
            {% if alertesAttentionPaginated|length > 0 %}
        <div class="alerts-section">
            <h3 class="section-title">
                <i class="fas fa-exclamation-triangle" style="color: var(--warning);"></i>
                Alertes d'attention
            </h3>
            
                    {% for alerte in alertesAttentionPaginated %}
                        {% set typeBillet = alerte.typeBillet %}
                        {% set inventaire = alerte.inventaire %}
                        {% set evenement = typeBillet.evenement %}
            <div class="alert-item alert-warning">
                <div class="alert-status">
                    <div class="alert-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="alert-priority">
                        <span class="priority-badge warning">ATTENTION</span>
                    </div>
                </div>
                
                <div class="alert-content">
                    <div class="alert-header">
                                    <h4>{{ evenement ? evenement.titre : 'N/A' }} - {{ typeBillet.nom }}</h4>
                                    <span class="alert-time">Surveillance requise</span>
                    </div>
                    <p class="alert-description">
                                    Stock bas : {{ alerte.quantiteRestante }} billet(s) restant(s) sur {{ inventaire.quantiteTotale }} ({{ alerte.pourcentage|number_format(1) }}%)
                    </p>
                    <div class="alert-details">
                                    {% if evenement %}
                                        {% if evenement.commenceLe %}
                        <span class="detail-item">
                            <i class="fas fa-calendar"></i>
                                                Événement : {{ evenement.commenceLe|date('d M Y') }}
                        </span>
                                        {% endif %}
                                        {% if evenement.lieu %}
                        <span class="detail-item">
                            <i class="fas fa-map-marker-alt"></i>
                                                {{ evenement.lieu.nom }}
                        </span>
                                        {% endif %}
                                    {% endif %}
                        <span class="detail-item">
                            <i class="fas fa-euro-sign"></i>
                                        Prix : {{ typeBillet.prixDeBase|number_format(2, ',', ' ') }} {{ typeBillet.devise }}
                        </span>
                    </div>
                </div>
                
                <div class="alert-actions">
                                {% if evenement %}
                                    <a href="{{ path('organisateur_events_show', { id: evenement.id }) }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                        Voir l'événement
                                    </a>
                                {% endif %}
                    <button class="btn btn-sm btn-secondary">
                        <i class="fas fa-edit"></i>
                        Modifier stock
                    </button>
                </div>
            </div>
                    {% endfor %}
        </div>
            {% endif %}
        {% endif %}

        <!-- Pagination -->
        {% if totalPages > 1 %}
            {% set maxPagesToShow = 5 %}
            {% set startPage = currentPage - 2 %}
            {% if startPage < 1 %}
                {% set startPage = 1 %}
            {% endif %}
            {% set endPage = startPage + maxPagesToShow - 1 %}
            {% if endPage > totalPages %}
                {% set endPage = totalPages %}
            {% endif %}
            {% set startPage = endPage - maxPagesToShow + 1 %}
            {% if startPage < 1 %}
                {% set startPage = 1 %}
            {% endif %}

            <div class="pagination-wrapper" style="margin-top: 2rem;">
                <ul class="pagination pagination-rounded">
                    <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                        {% if currentPage == 1 %}
                            <span class="page-link" aria-disabled="true">Précédent</span>
                        {% else %}
                            <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                page: currentPage - 1,
                                niveau: niveauFilter|default(''),
                                categorie: categorieFilter|default(''),
                                segment: segmentFilter|default('')
                            }) }}" rel="prev">Précédent</a>
                        {% endif %}
                    </li>

                    {% if startPage > 1 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                page: 1,
                                niveau: niveauFilter|default(''),
                                categorie: categorieFilter|default(''),
                                segment: segmentFilter|default('')
                            }) }}">1</a>
                        </li>
                        {% if startPage > 2 %}
                            <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                        {% endif %}
                    {% endif %}

                    {% for page in startPage..endPage %}
                        <li class="page-item {{ page == currentPage ? 'active' }}">
                            {% if page == currentPage %}
                                <span class="page-link" aria-current="page">{{ page }}</span>
                            {% else %}
                                <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                    page: page,
                                    niveau: niveauFilter|default(''),
                                    categorie: categorieFilter|default(''),
                                    segment: segmentFilter|default('')
                                }) }}">{{ page }}</a>
                            {% endif %}
                        </li>
                    {% endfor %}

                    {% if endPage < totalPages %}
                        {% if endPage < totalPages - 1 %}
                            <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                        {% endif %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                page: totalPages,
                                niveau: niveauFilter|default(''),
                                categorie: categorieFilter|default(''),
                                segment: segmentFilter|default('')
                            }) }}">{{ totalPages }}</a>
                        </li>
                    {% endif %}

                    <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                        {% if currentPage == totalPages %}
                            <span class="page-link" aria-disabled="true">Suivant</span>
                        {% else %}
                            <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                page: currentPage + 1,
                                niveau: niveauFilter|default(''),
                                categorie: categorieFilter|default(''),
                                segment: segmentFilter|default('')
                            }) }}" rel="next">Suivant</a>
                        {% endif %}
                    </li>
                </ul>
                </div>
            <div class="pagination-summary" style="text-align: center; margin-top: 0.75rem; color: var(--text-secondary); font-size: 0.9rem;">
                {% set startItem = ((currentPage - 1) * limit) + 1 %}
                {% set endItem = min(currentPage * limit, totalItems) %}
                <small>Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ startItem }} à {{ endItem }} sur {{ totalItems }} alerte(s)</small>
            </div>
        {% elseif totalItems > 0 %}
            <div class="pagination-wrapper" style="margin-top: 2rem;">
                <div class="pagination-summary" style="text-align: center; color: var(--text-secondary); font-size: 0.9rem;">
                    <small>Affichage de {{ totalItems }} alerte(s)</small>
        </div>
            </div>
        {% endif %}
    </div>
</div>

<style>
/* Styles pour les alertes */
.alerts-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

/* Styles des cartes de statistiques */
.stat-card h3 {
    font-size: 2.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
}

.stat-trend {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    margin-top: 5px;
    padding: 4px 8px;
    border-radius: var(--border-radius-sm);
    background: rgba(52, 152, 219, 0.1);
    color: var(--info);
    width: fit-content;
}

.stat-trend.critical {
    background: rgba(231, 76, 60, 0.1);
    color: var(--danger);
}

.stat-trend.success {
    background: rgba(39, 174, 96, 0.1);
    color: var(--success);
}

.stat-trend i {
    font-size: 0.7rem;
}

.alerts-filters {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    margin-bottom: 30px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}

.filters-header {
    background: var(--gray-50);
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.filters-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
}

.filters-content {
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.filter-group label {
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-select, .filter-search {
    padding: 10px 12px;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.filter-select:focus, .filter-search:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.filter-search {
    width: 100%;
}

.btn-outline {
    background: transparent;
    border: 2px solid var(--border-color);
    color: var(--text-secondary);
}

.btn-outline:hover {
    background: var(--gray-100);
    border-color: var(--accent);
    color: var(--accent);
}

.alerts-container {
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.alerts-section {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    overflow: hidden;
}

.section-title {
    background: var(--gray-50);
    padding: 16px 20px;
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 10px;
}

.alert-item {
    display: flex;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid var(--border-light);
    transition: var(--transition-base);
    gap: 20px;
}

.alert-item:last-child {
    border-bottom: none;
}

.alert-item:hover {
    background: var(--gray-50);
}

.alert-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.alert-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--white);
    position: relative;
    overflow: hidden;
}


.alert-critical .alert-icon {
    background: var(--danger);
}

.alert-warning .alert-icon {
    background: var(--warning);
}

.alert-info .alert-icon {
    background: var(--info);
}

.priority-badge {
    padding: 6px 10px;
    border-radius: var(--border-radius-sm);
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 4px;
}

.priority-badge.critical {
    background: rgba(231, 76, 60, 0.1);
    color: var(--danger);
}

.priority-badge.warning {
    background: rgba(243, 156, 18, 0.1);
    color: var(--warning);
}

.priority-badge.info {
    background: rgba(52, 152, 219, 0.1);
    color: var(--info);
}

.alert-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.alert-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
}

.alert-header h4 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    line-height: 1.3;
}

.alert-time {
    color: var(--text-muted);
    font-size: 0.85rem;
    white-space: nowrap;
}

.alert-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0;
}

.alert-details {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 8px;
}

.detail-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 0.85rem;
}

.detail-item i {
    color: var(--accent);
    width: 12px;
}

.alert-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
}

.btn-sm {
    padding: 6px 12px;
    font-size: 0.8rem;
    border-radius: var(--border-radius-sm);
}

/* Responsive */
@media (max-width: 768px) {
    .alerts-filters {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
    }
    
    .filter-group {
        width: 100%;
    }
    
    .filter-select {
        width: 100%;
    }
    
    .alert-item {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
    }
    
    .alert-status {
        flex-direction: row;
        justify-content: space-between;
    }
    
    .alert-actions {
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .alert-details {
        flex-direction: column;
        gap: 8px;
    }
}

/* Pagination */
.pagination-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
}

.pagination {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.pagination-rounded .page-link {
    border-radius: 999px !important;
}

.pagination .page-item.disabled .page-link {
    pointer-events: none;
    opacity: 0.5;
}

.pagination .page-item.active .page-link {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--text-inverse);
    font-weight: var(--font-weight-medium);
}

.pagination .page-link {
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--border-color);
    padding: 6px 14px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    transition: var(--transition-base);
    text-decoration: none;
}

.pagination .page-link:hover {
    color: var(--accent);
    border-color: var(--accent);
}

.pagination .ellipsis .page-link {
    border: none;
    background: transparent;
    color: var(--text-secondary);
}

.pagination-summary {
    text-align: center;
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion des filtres
    function updateFilters() {
        const url = new URL(window.location.href);
        const selectedNiveau = document.getElementById('filterNiveau')?.value || '';
        const selectedCategorie = document.getElementById('filterCategorie')?.value || '';
        const selectedSegment = document.getElementById('filterSegment')?.value || '';
        
        if (selectedNiveau) {
            url.searchParams.set('niveau', selectedNiveau);
        } else {
            url.searchParams.delete('niveau');
        }
        
        if (selectedCategorie) {
            url.searchParams.set('categorie', selectedCategorie);
        } else {
            url.searchParams.delete('categorie');
        }
        
        if (selectedSegment) {
            url.searchParams.set('segment', selectedSegment);
        } else {
            url.searchParams.delete('segment');
        }
        
        url.searchParams.delete('page'); // Réinitialiser à la page 1 lors du changement de filtre
        
        window.location.href = url.toString();
    }
    
    const clearFiltersBtn = document.getElementById('clearFilters');
    const filterNiveau = document.getElementById('filterNiveau');
    const filterCategorie = document.getElementById('filterCategorie');
    const filterSegment = document.getElementById('filterSegment');
    
    if (clearFiltersBtn) {
        clearFiltersBtn.addEventListener('click', function() {
            if (filterNiveau) filterNiveau.selectedIndex = 0;
            if (filterCategorie) filterCategorie.selectedIndex = 0;
            if (filterSegment) filterSegment.selectedIndex = 0;
            updateFilters();
        });
    }
    
    if (filterNiveau) {
        filterNiveau.addEventListener('change', updateFilters);
    }
    
    if (filterCategorie) {
        filterCategorie.addEventListener('change', updateFilters);
    }
    
    if (filterSegment) {
        filterSegment.addEventListener('change', updateFilters);
    }
});
</script>
{% endblock %}

