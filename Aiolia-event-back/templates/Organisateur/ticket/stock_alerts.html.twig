{% extends 'base.html.twig' %}

{% block title %}Alertes automatiques - Aiolia Event{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <h1>
                    <i class="fas fa-bell" style="color: var(--warning); margin-right: 12px;"></i>
                    Alertes automatiques
                </h1>
                <p class="header-subtitle">
                    Surveillance en temps réel des stocks et événements
                </p>
            </div>
            <div class="header-actions">
                <button class="btn btn-secondary" id="markAllRead">
                    <i class="fas fa-check-double"></i>
                    Tout marquer comme lu
                </button>
                <button class="btn btn-primary" id="refreshAlerts">
                    <i class="fas fa-sync-alt"></i>
                    Actualiser
                </button>
            </div>
        </div>
    </div>

    <!-- Statistiques des alertes -->
    <div class="alerts-stats">
        <div class="stat-card stat-card-animated" data-aos="fade-up" data-aos-delay="100">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--warning), #f39c12);">
                <i class="fas fa-exclamation-triangle"></i>
                <div class="pulse-ring"></div>
            </div>
            <div class="stat-content">
                <h3 class="counter" data-target="12">0</h3>
                <p>Alertes actives</p>
                <div class="stat-trend">
                    <i class="fas fa-arrow-up"></i>
                    <span>+2 depuis hier</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card stat-card-animated" data-aos="fade-up" data-aos-delay="200">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--danger), #e74c3c);">
                <i class="fas fa-fire"></i>
                <div class="pulse-ring"></div>
            </div>
            <div class="stat-content">
                <h3 class="counter" data-target="3">0</h3>
                <p>Stock critique</p>
                <div class="stat-trend critical">
                    <i class="fas fa-exclamation"></i>
                    <span>Action requise</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card stat-card-animated" data-aos="fade-up" data-aos-delay="300">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--info), #3498db);">
                <i class="fas fa-clock"></i>
                <div class="pulse-ring"></div>
            </div>
            <div class="stat-content">
                <h3 class="counter" data-target="5">0</h3>
                <p>Rappels événements</p>
                <div class="stat-trend">
                    <i class="fas fa-bell"></i>
                    <span>Prochains 7 jours</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card stat-card-animated" data-aos="fade-up" data-aos-delay="400">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--success), #27ae60);">
                <i class="fas fa-check-circle"></i>
                <div class="pulse-ring"></div>
            </div>
            <div class="stat-content">
                <h3 class="counter" data-target="24">0</h3>
                <p>Résolues aujourd'hui</p>
                <div class="stat-trend success">
                    <i class="fas fa-arrow-up"></i>
                    <span>+8 vs hier</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres des alertes -->
    <div class="alerts-filters" data-aos="fade-up" data-aos-delay="500">
        <div class="filters-header">
            <h3>
                <i class="fas fa-filter"></i>
                Filtres et recherche
            </h3>
            <button class="btn btn-sm btn-outline" id="clearFilters">
                <i class="fas fa-times"></i>
                Effacer
            </button>
        </div>
        
        <div class="filters-content">
            <div class="filter-group">
                <label>
                    <i class="fas fa-tag"></i>
                    Type d'alerte
                </label>
                <select class="filter-select">
                    <option value="all">Toutes les alertes</option>
                    <option value="stock">Stock bas</option>
                    <option value="reminder">Rappels</option>
                    <option value="system">Système</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label>
                    <i class="fas fa-exclamation-circle"></i>
                    Priorité
                </label>
                <select class="filter-select">
                    <option value="all">Toutes</option>
                    <option value="critical">Critique</option>
                    <option value="warning">Attention</option>
                    <option value="info">Information</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label>
                    <i class="fas fa-eye"></i>
                    Statut
                </label>
                <select class="filter-select">
                    <option value="all">Toutes</option>
                    <option value="unread">Non lues</option>
                    <option value="read">Lues</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label>
                    <i class="fas fa-search"></i>
                    Recherche
                </label>
                <input type="text" class="filter-search" placeholder="Rechercher dans les alertes...">
            </div>
        </div>
    </div>

    <!-- Liste des alertes -->
    <div class="alerts-container">
        <div class="alerts-section">
            <h3 class="section-title">
                <i class="fas fa-exclamation-triangle" style="color: var(--danger);"></i>
                Alertes critiques
            </h3>
            
            <div class="alert-item alert-critical" data-aos="fade-right" data-aos-delay="600">
                <div class="alert-status">
                    <div class="alert-icon">
                        <i class="fas fa-fire"></i>
                        <div class="alert-pulse"></div>
                    </div>
                    <div class="alert-priority">
                        <span class="priority-badge critical">
                            <i class="fas fa-exclamation"></i>
                            CRITIQUE
                        </span>
                    </div>
                </div>
                
                <div class="alert-content">
                    <div class="alert-header">
                        <h4>Concert Rock Nation - Billets VIP</h4>
                        <span class="alert-time">Il y a 2 minutes</span>
                    </div>
                    <p class="alert-description">
                        Stock critique : seulement 3 billets VIP restants sur 50 (6%)
                    </p>
                    <div class="alert-details">
                        <span class="detail-item">
                            <i class="fas fa-calendar"></i>
                            Événement : 15 Mars 2024
                        </span>
                        <span class="detail-item">
                            <i class="fas fa-map-marker-alt"></i>
                            Paris, Zénith
                        </span>
                        <span class="detail-item">
                            <i class="fas fa-euro-sign"></i>
                            Prix : 89€
                        </span>
                    </div>
                </div>
                
                <div class="alert-actions">
                    <button class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                        Voir l'événement
                    </button>
                    <button class="btn btn-sm btn-secondary">
                        <i class="fas fa-edit"></i>
                        Modifier stock
                    </button>
                    <button class="btn btn-sm btn-success">
                        <i class="fas fa-check"></i>
                        Marquer comme lu
                    </button>
                </div>
            </div>
            
            <div class="alert-item alert-critical">
                <div class="alert-status">
                    <div class="alert-icon">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <div class="alert-priority">
                        <span class="priority-badge critical">CRITIQUE</span>
                    </div>
                </div>
                
                <div class="alert-content">
                    <div class="alert-header">
                        <h4>Festival Summer Vibes - Pass 3 jours</h4>
                        <span class="alert-time">Il y a 15 minutes</span>
                    </div>
                    <p class="alert-description">
                        Plus que 5 billets disponibles ! Vente en cours depuis 2h
                    </p>
                    <div class="alert-details">
                        <span class="detail-item">
                            <i class="fas fa-calendar"></i>
                            Événement : 20-22 Juillet 2024
                        </span>
                        <span class="detail-item">
                            <i class="fas fa-map-marker-alt"></i>
                            Nice, Parc Phoenix
                        </span>
                        <span class="detail-item">
                            <i class="fas fa-euro-sign"></i>
                            Prix : 149€
                        </span>
                    </div>
                </div>
                
                <div class="alert-actions">
                    <button class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                        Voir l'événement
                    </button>
                    <button class="btn btn-sm btn-secondary">
                        <i class="fas fa-edit"></i>
                        Modifier stock
                    </button>
                    <button class="btn btn-sm btn-success">
                        <i class="fas fa-check"></i>
                        Marquer comme lu
                    </button>
                </div>
            </div>
        </div>
        
        <div class="alerts-section">
            <h3 class="section-title">
                <i class="fas fa-exclamation-triangle" style="color: var(--warning);"></i>
                Alertes d'attention
            </h3>
            
            <div class="alert-item alert-warning">
                <div class="alert-status">
                    <div class="alert-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="alert-priority">
                        <span class="priority-badge warning">ATTENTION</span>
                    </div>
                </div>
                
                <div class="alert-content">
                    <div class="alert-header">
                        <h4>Conférence Tech Summit - Standard</h4>
                        <span class="alert-time">Il y a 1 heure</span>
                    </div>
                    <p class="alert-description">
                        Stock bas : 25 billets restants sur 200 (12.5%)
                    </p>
                    <div class="alert-details">
                        <span class="detail-item">
                            <i class="fas fa-calendar"></i>
                            Événement : 10 Avril 2024
                        </span>
                        <span class="detail-item">
                            <i class="fas fa-map-marker-alt"></i>
                            Lyon, Centre de Congrès
                        </span>
                        <span class="detail-item">
                            <i class="fas fa-euro-sign"></i>
                            Prix : 45€
                        </span>
                    </div>
                </div>
                
                <div class="alert-actions">
                    <button class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                        Voir l'événement
                    </button>
                    <button class="btn btn-sm btn-secondary">
                        <i class="fas fa-edit"></i>
                        Modifier stock
                    </button>
                    <button class="btn btn-sm btn-success">
                        <i class="fas fa-check"></i>
                        Marquer comme lu
                    </button>
                </div>
            </div>
        </div>
        
        <div class="alerts-section">
            <h3 class="section-title">
                <i class="fas fa-info-circle" style="color: var(--info);"></i>
                Rappels et informations
            </h3>
            
            <div class="alert-item alert-info">
                <div class="alert-status">
                    <div class="alert-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="alert-priority">
                        <span class="priority-badge info">RAPPEL</span>
                    </div>
                </div>
                
                <div class="alert-content">
                    <div class="alert-header">
                        <h4>Rappel : Concert Jazz Night dans 2 jours</h4>
                        <span class="alert-time">Il y a 3 heures</span>
                    </div>
                    <p class="alert-description">
                        N'oubliez pas de préparer les derniers détails pour votre événement
                    </p>
                    <div class="alert-details">
                        <span class="detail-item">
                            <i class="fas fa-calendar"></i>
                            Événement : 18 Mars 2024
                        </span>
                        <span class="detail-item">
                            <i class="fas fa-map-marker-alt"></i>
                            Marseille, Opéra
                        </span>
                        <span class="detail-item">
                            <i class="fas fa-ticket-alt"></i>
                            127 billets vendus
                        </span>
                    </div>
                </div>
                
                <div class="alert-actions">
                    <button class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                        Voir l'événement
                    </button>
                    <button class="btn btn-sm btn-secondary">
                        <i class="fas fa-cog"></i>
                        Paramètres
                    </button>
                    <button class="btn btn-sm btn-success">
                        <i class="fas fa-check"></i>
                        Marquer comme lu
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Styles pour les alertes */
.alerts-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

/* Animations des cartes de statistiques */
.stat-card-animated {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    transform: translateY(0);
}

.stat-card-animated:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
}

.stat-card-animated::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s;
}

.stat-card-animated:hover::before {
    left: 100%;
}

/* Effet de pulsation pour les icônes critiques */
.pulse-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border: 2px solid rgba(231, 76, 60, 0.3);
    border-radius: 50%;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% {
        transform: translate(-50%, -50%) scale(0.8);
        opacity: 1;
    }
    100% {
        transform: translate(-50%, -50%) scale(1.2);
        opacity: 0;
    }
}

/* Compteurs animés */
.counter {
    font-size: 2.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    transition: all 0.3s ease;
}

.stat-trend {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    margin-top: 5px;
    padding: 4px 8px;
    border-radius: var(--border-radius-sm);
    background: rgba(52, 152, 219, 0.1);
    color: var(--info);
    width: fit-content;
}

.stat-trend.critical {
    background: rgba(231, 76, 60, 0.1);
    color: var(--danger);
}

.stat-trend.success {
    background: rgba(39, 174, 96, 0.1);
    color: var(--success);
}

.stat-trend i {
    font-size: 0.7rem;
}

.alerts-filters {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    margin-bottom: 30px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}

.filters-header {
    background: var(--gray-50);
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.filters-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
}

.filters-content {
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.filter-group label {
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-select, .filter-search {
    padding: 10px 12px;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.filter-select:focus, .filter-search:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.filter-search {
    width: 100%;
}

.btn-outline {
    background: transparent;
    border: 2px solid var(--border-color);
    color: var(--text-secondary);
}

.btn-outline:hover {
    background: var(--gray-100);
    border-color: var(--accent);
    color: var(--accent);
}

.alerts-container {
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.alerts-section {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    overflow: hidden;
}

.section-title {
    background: var(--gray-50);
    padding: 16px 20px;
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 10px;
}

.alert-item {
    display: flex;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid var(--border-light);
    transition: var(--transition-base);
    gap: 20px;
}

.alert-item:last-child {
    border-bottom: none;
}

.alert-item:hover {
    background: var(--gray-50);
}

.alert-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.alert-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--white);
    position: relative;
    overflow: hidden;
}

.alert-pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    animation: alertPulse 1.5s infinite;
}

@keyframes alertPulse {
    0% {
        transform: translate(-50%, -50%) scale(0.8);
        opacity: 1;
    }
    100% {
        transform: translate(-50%, -50%) scale(1.4);
        opacity: 0;
    }
}

.alert-critical .alert-icon {
    background: var(--danger);
}

.alert-warning .alert-icon {
    background: var(--warning);
}

.alert-info .alert-icon {
    background: var(--info);
}

.priority-badge {
    padding: 6px 10px;
    border-radius: var(--border-radius-sm);
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 4px;
    animation: badgeGlow 2s infinite;
}

@keyframes badgeGlow {
    0%, 100% {
        box-shadow: 0 0 5px rgba(231, 76, 60, 0.3);
    }
    50% {
        box-shadow: 0 0 15px rgba(231, 76, 60, 0.6);
    }
}

.priority-badge.critical {
    background: rgba(231, 76, 60, 0.1);
    color: var(--danger);
}

.priority-badge.warning {
    background: rgba(243, 156, 18, 0.1);
    color: var(--warning);
}

.priority-badge.info {
    background: rgba(52, 152, 219, 0.1);
    color: var(--info);
}

.alert-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.alert-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
}

.alert-header h4 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    line-height: 1.3;
}

.alert-time {
    color: var(--text-muted);
    font-size: 0.85rem;
    white-space: nowrap;
}

.alert-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0;
}

.alert-details {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 8px;
}

.detail-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 0.85rem;
}

.detail-item i {
    color: var(--accent);
    width: 12px;
}

.alert-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
}

.btn-sm {
    padding: 6px 12px;
    font-size: 0.8rem;
    border-radius: var(--border-radius-sm);
}

/* Responsive */
@media (max-width: 768px) {
    .alerts-filters {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
    }
    
    .filter-group {
        width: 100%;
    }
    
    .filter-select {
        width: 100%;
    }
    
    .alert-item {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
    }
    
    .alert-status {
        flex-direction: row;
        justify-content: space-between;
    }
    
    .alert-actions {
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .alert-details {
        flex-direction: column;
        gap: 8px;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animation des compteurs
    function animateCounters() {
        const counters = document.querySelectorAll('.counter');
        counters.forEach(counter => {
            const target = parseInt(counter.getAttribute('data-target'));
            const duration = 2000; // 2 secondes
            const increment = target / (duration / 16); // 60fps
            let current = 0;
            
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                counter.textContent = Math.floor(current);
            }, 16);
        });
    }
    
    // Délai pour l'animation des compteurs
    setTimeout(animateCounters, 500);
    
    // Gestion des filtres
    const clearFiltersBtn = document.getElementById('clearFilters');
    const filterSelects = document.querySelectorAll('.filter-select');
    const filterSearch = document.querySelector('.filter-search');
    
    if (clearFiltersBtn) {
        clearFiltersBtn.addEventListener('click', function() {
            filterSelects.forEach(select => {
                select.selectedIndex = 0;
            });
            if (filterSearch) {
                filterSearch.value = '';
            }
        });
    }
    
    // Animation des cartes d'alertes au scroll
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateX(0)';
            }
        });
    }, observerOptions);
    
    // Observer toutes les cartes d'alertes
    const alertItems = document.querySelectorAll('.alert-item');
    alertItems.forEach((item, index) => {
        item.style.opacity = '0';
        item.style.transform = 'translateX(-30px)';
        item.style.transition = `all 0.6s ease ${index * 0.1}s`;
        observer.observe(item);
    });
    
    // Effet de survol sur les cartes de stats
    const statCards = document.querySelectorAll('.stat-card-animated');
    statCards.forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-8px) scale(1.02)';
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0) scale(1)';
        });
    });
    
    // Animation des boutons d'action
    const actionButtons = document.querySelectorAll('.alert-actions .btn');
    actionButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Effet de clic
            this.style.transform = 'scale(0.95)';
            setTimeout(() => {
                this.style.transform = 'scale(1)';
            }, 150);
            
            // Simulation d'action
            const originalText = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Traitement...';
            this.disabled = true;
            
            setTimeout(() => {
                this.innerHTML = originalText;
                this.disabled = false;
                
                // Ajouter un effet de succès
                this.style.background = 'var(--success)';
                this.style.borderColor = 'var(--success)';
                setTimeout(() => {
                    this.style.background = '';
                    this.style.borderColor = '';
                }, 1000);
            }, 1500);
        });
    });
    
    // Auto-refresh des alertes (simulation)
    const refreshBtn = document.getElementById('refreshAlerts');
    if (refreshBtn) {
        refreshBtn.addEventListener('click', function() {
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Actualisation...';
            this.disabled = true;
            
            setTimeout(() => {
                this.innerHTML = '<i class="fas fa-sync-alt"></i> Actualiser';
                this.disabled = false;
                
                // Animation de rafraîchissement
                const alertItems = document.querySelectorAll('.alert-item');
                alertItems.forEach((item, index) => {
                    item.style.animation = 'none';
                    setTimeout(() => {
                        item.style.animation = `fadeInUp 0.5s ease ${index * 0.1}s`;
                    }, 10);
                });
            }, 2000);
        });
    }
    
    // Marquer toutes les alertes comme lues
    const markAllReadBtn = document.getElementById('markAllRead');
    if (markAllReadBtn) {
        markAllReadBtn.addEventListener('click', function() {
            const alertItems = document.querySelectorAll('.alert-item');
            alertItems.forEach((item, index) => {
                setTimeout(() => {
                    item.style.opacity = '0.6';
                    item.style.transform = 'scale(0.98)';
                    
                    // Ajouter un indicateur "lu"
                    const readIndicator = document.createElement('div');
                    readIndicator.className = 'read-indicator';
                    readIndicator.innerHTML = '<i class="fas fa-check"></i> Lu';
                    readIndicator.style.cssText = `
                        position: absolute;
                        top: 10px;
                        right: 10px;
                        background: var(--success);
                        color: white;
                        padding: 4px 8px;
                        border-radius: 4px;
                        font-size: 0.7rem;
                        opacity: 0;
                        transform: translateY(-10px);
                        transition: all 0.3s ease;
                    `;
                    
                    item.style.position = 'relative';
                    item.appendChild(readIndicator);
                    
                    setTimeout(() => {
                        readIndicator.style.opacity = '1';
                        readIndicator.style.transform = 'translateY(0)';
                    }, 100);
                }, index * 100);
            });
        });
    }
});

// CSS pour les animations
const style = document.createElement('style');
style.textContent = `
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .read-indicator {
        animation: slideInRight 0.3s ease;
    }
    
    @keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
`;
document.head.appendChild(style);
</script>
{% endblock %}

