<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion des filtres
    function updateFilters() {
        const url = new URL(window.location.href);
        const selectedNiveau = document.getElementById('filterNiveau')?.value || '';
        const selectedCategorie = document.getElementById('filterCategorie')?.value || '';
        const selectedSegment = document.getElementById('filterSegment')?.value || '';
        
        if (selectedNiveau) {
            url.searchParams.set('niveau', selectedNiveau);
        } else {
            url.searchParams.delete('niveau');
        }
        
        if (selectedCategorie) {
            url.searchParams.set('categorie', selectedCategorie);
        } else {
            url.searchParams.delete('categorie');
        }
        
        if (selectedSegment) {
            url.searchParams.set('segment', selectedSegment);
        } else {
            url.searchParams.delete('segment');
        }
        
        url.searchParams.delete('page'); // Réinitialiser à la page 1 lors du changement de filtre
        
        window.location.href = url.toString();
    }
    
    const clearFiltersBtn = document.getElementById('clearFilters');
    const filterNiveau = document.getElementById('filterNiveau');
    const filterCategorie = document.getElementById('filterCategorie');
    const filterSegment = document.getElementById('filterSegment');
    
    if (clearFiltersBtn) {
        clearFiltersBtn.addEventListener('click', function() {
            if (filterNiveau) filterNiveau.selectedIndex = 0;
            if (filterCategorie) filterCategorie.selectedIndex = 0;
            if (filterSegment) filterSegment.selectedIndex = 0;
            updateFilters();
        });
    }
    
    if (filterNiveau) {
        filterNiveau.addEventListener('change', updateFilters);
    }
    
    if (filterCategorie) {
        filterCategorie.addEventListener('change', updateFilters);
    }
    
    if (filterSegment) {
        filterSegment.addEventListener('change', updateFilters);
    }
});

// Fonction pour ouvrir le modal de modification
function openEditModal(typeBilletId, prixDeBase, stockTotal, vendus, capaciteTotaleCategorie = 0) {
    const modal = document.getElementById('editModal');
    const form = document.getElementById('editForm');
    const prixInput = document.getElementById('prixDeBase');
    const quantiteInput = document.getElementById('quantiteTotale');
    const typeBilletIdInput = document.getElementById('typeBilletId');
    const minQuantiteSpan = document.getElementById('minQuantite');
    const capaciteTotaleSpan = document.getElementById('capaciteTotaleCategorie');

    typeBilletIdInput.value = typeBilletId;
    // Convertir le prix en nombre (supprimer les espaces et formater)
    const prix = parseFloat(String(prixDeBase).replace(/\s/g, '').replace(',', '.'));
    prixInput.value = isNaN(prix) ? 0 : prix;
    quantiteInput.value = stockTotal;
    quantiteInput.min = vendus;
    minQuantiteSpan.textContent = vendus;
    if (capaciteTotaleSpan) {
        capaciteTotaleSpan.textContent = capaciteTotaleCategorie || 0;
    }
    
    // Réinitialiser les erreurs
    document.getElementById('prixError').textContent = '';
    document.getElementById('quantiteError').textContent = '';
    prixInput.classList.remove('error');
    quantiteInput.classList.remove('error');
    
    // Supprimer les messages de succès précédents
    const successMessages = document.querySelectorAll('#modalBody .alert-success');
    successMessages.forEach(msg => msg.remove());
    
    modal.classList.add('active');
}

// Fermer le modal
document.addEventListener('DOMContentLoaded', function() {
    const closeModalBtn = document.getElementById('closeModal');
    const cancelBtn = document.getElementById('cancelBtn');
    const modal = document.getElementById('editModal');
    
    if (closeModalBtn) {
        closeModalBtn.addEventListener('click', function() {
            modal.classList.remove('active');
        });
    }
    
    if (cancelBtn) {
        cancelBtn.addEventListener('click', function() {
            modal.classList.remove('active');
        });
    }
    
    if (modal) {
        modal.addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.remove('active');
            }
        });
    }
    
    // Fermer avec Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
            modal.classList.remove('active');
        }
    });
    
    // Soumettre le formulaire
    const saveBtn = document.getElementById('saveBtn');
    if (saveBtn) {
        saveBtn.addEventListener('click', function() {
            const form = document.getElementById('editForm');
            const formData = new FormData(form);
            const typeBilletId = formData.get('typeBilletId');
            const prixDeBase = formData.get('prixDeBase');
            const quantiteTotale = formData.get('quantiteTotale');
            const vendus = parseInt(document.getElementById('quantiteTotale').min);
            
            // Validation
            let hasError = false;
            
            if (!prixDeBase || parseFloat(prixDeBase) < 0) {
                document.getElementById('prixError').textContent = 'Le prix doit être supérieur ou égal à 0';
                document.getElementById('prixDeBase').classList.add('error');
                hasError = true;
            } else {
                document.getElementById('prixError').textContent = '';
                document.getElementById('prixDeBase').classList.remove('error');
            }
            
            if (!quantiteTotale || parseInt(quantiteTotale) < vendus) {
                document.getElementById('quantiteError').textContent = `La quantité doit être supérieure ou égale à ${vendus}`;
                document.getElementById('quantiteTotale').classList.add('error');
                hasError = true;
            } else {
                document.getElementById('quantiteError').textContent = '';
                document.getElementById('quantiteTotale').classList.remove('error');
            }
            
            if (hasError) {
                return;
            }
            
            // Désactiver le bouton
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
            
            // Envoyer la requête
            fetch(`/tickets/types/${typeBilletId}/edit`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({
                    prixDeBase: prixDeBase,
                    quantiteTotale: quantiteTotale
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Afficher un message de succès
                    const successMessage = document.createElement('div');
                    successMessage.className = 'alert alert-success';
                    successMessage.style.cssText = 'padding: 12px; margin-bottom: 16px; background: var(--success); color: white; border-radius: var(--border-radius-sm);';
                    successMessage.innerHTML = `<i class="fas fa-check-circle"></i> ${data.message}`;
                    document.getElementById('modalBody').insertBefore(successMessage, form);
                    
                    // Fermer le modal après 1.5 secondes et recharger la page
                    setTimeout(() => {
                        modal.classList.remove('active');
                        window.location.reload();
                    }, 1500);
                } else {
                    // Afficher l'erreur
                    if (data.errors) {
                        if (data.errors.prixDeBase) {
                            document.getElementById('prixError').textContent = data.errors.prixDeBase;
                            document.getElementById('prixDeBase').classList.add('error');
                        }
                        if (data.errors.quantiteTotale) {
                            document.getElementById('quantiteError').textContent = data.errors.quantiteTotale;
                            document.getElementById('quantiteTotale').classList.add('error');
                        }
                    } else if (data.message) {
                        document.getElementById('quantiteError').textContent = data.message;
                    }
                    this.disabled = false;
                    this.innerHTML = 'Enregistrer';
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                document.getElementById('quantiteError').textContent = 'Une erreur est survenue lors de l\'enregistrement';
                this.disabled = false;
                this.innerHTML = 'Enregistrer';
            });
        });
    }
});
</script>

<!-- Modal pour modifier le prix et la quantité -->
<div id="editModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fas fa-edit"></i> Modifier le type de billet</h3>
            <button type="button" class="modal-close" id="closeModal">&times;</button>
        </div>
        <div class="modal-body" id="modalBody">
            <form id="editForm" method="post">
                <div class="form-group">
                    <label for="prixDeBase">Prix unitaire</label>
                    <input type="number" id="prixDeBase" name="prixDeBase" class="form-control" step="0.01" min="0" required>
                    <div class="form-error" id="prixError"></div>
                </div>
                <div class="form-group">
                    <label for="quantiteTotale">Quantité totale</label>
                    <input type="number" id="quantiteTotale" name="quantiteTotale" class="form-control" min="1" required>
                    <div class="form-error" id="quantiteError"></div>
                    <small style="color: var(--text-secondary); margin-top: 4px; display: block;">
                        La quantité ne peut pas être inférieure à <span id="minQuantite">0</span> (quantité déjà vendue)
                    </small>
                    <small style="color: var(--accent); margin-top: 8px; display: block; font-weight: var(--font-weight-medium);">
                        <i class="fas fa-info-circle"></i> Capacité totale de l'événement pour cette catégorie : <span id="capaciteTotaleCategorie">0</span> billet(s)
                    </small>
                </div>
                <input type="hidden" id="typeBilletId" name="typeBilletId">
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-modal btn-modal-secondary" id="cancelBtn">Annuler</button>
            <button type="button" class="btn-modal btn-modal-primary" id="saveBtn">Enregistrer</button>
        </div>
    </div>
</div>
{% endblock %}

