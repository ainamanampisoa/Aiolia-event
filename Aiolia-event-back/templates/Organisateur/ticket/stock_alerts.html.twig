{% extends 'base.html.twig' %}

{% block title %}Alertes automatiques - Aiolia Event{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Styles pour les alertes */
.alerts-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

/* Styles des cartes de statistiques */
.alerts-stats .stat-card h3 {
    font-size: 2.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
}

.stat-trend {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    margin-top: 5px;
    padding: 4px 8px;
    border-radius: var(--border-radius-sm);
    background: rgba(52, 152, 219, 0.1);
    color: var(--info);
    width: fit-content;
}

.stat-trend.critical {
    background: rgba(231, 76, 60, 0.1);
    color: var(--danger);
}

.stat-trend.success {
    background: rgba(39, 174, 96, 0.1);
    color: var(--success);
}

.stat-trend i {
    font-size: 0.7rem;
}

.alerts-filters {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    margin-bottom: 30px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}

.filters-header {
    background: var(--gray-50);
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.filters-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
}

.filters-content {
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.filter-group label {
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 6px;
}

.filter-select, .filter-search {
    padding: 10px 12px;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.filter-select:focus, .filter-search:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.filter-search {
    width: 100%;
}

.btn-outline {
    background: transparent;
    border: 2px solid var(--border-color);
    color: var(--text-secondary);
}

.btn-outline:hover {
    background: var(--gray-100);
    border-color: var(--accent);
    color: var(--accent);
}

.alerts-container {
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.alerts-section {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    overflow: hidden;
}

.section-title {
    background: var(--gray-50);
    padding: 16px 20px;
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 10px;
}

.alert-item {
    display: flex;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid var(--border-light);
    transition: var(--transition-base);
    gap: 20px;
}

.alert-item:last-child {
    border-bottom: none;
}

.alert-item:hover {
    background: var(--gray-50);
}

.alert-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.alert-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--white);
    position: relative;
    overflow: hidden;
}

.alert-critical .alert-icon {
    background: var(--danger);
}

.alert-warning .alert-icon {
    background: var(--warning);
}

.alert-info .alert-icon {
    background: var(--info);
}

.priority-badge {
    padding: 6px 10px;
    border-radius: var(--border-radius-sm);
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 4px;
}

.priority-badge.critical {
    background: rgba(231, 76, 60, 0.1);
    color: var(--danger);
}

.priority-badge.warning {
    background: rgba(243, 156, 18, 0.1);
    color: var(--warning);
}

.priority-badge.info {
    background: rgba(52, 152, 219, 0.1);
    color: var(--info);
}

.alert-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.alert-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
}

.alert-header h4 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    line-height: 1.3;
}

.alert-time {
    color: var(--text-muted);
    font-size: 0.85rem;
    white-space: nowrap;
}

.alert-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0;
}

.alert-details {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 8px;
}

.detail-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 0.85rem;
}

.detail-item i {
    color: var(--accent);
    width: 12px;
}

.alert-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
}

.btn-sm {
    padding: 6px 12px;
    font-size: 0.8rem;
    border-radius: var(--border-radius-sm);
}

/* Responsive */
@media (max-width: 768px) {
    .alerts-filters {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
    }
    
    .filter-group {
        width: 100%;
    }
    
    .filter-select {
        width: 100%;
    }
    
    .alert-item {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
    }
    
    .alert-status {
        flex-direction: row;
        justify-content: space-between;
    }
    
    .alert-actions {
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .alert-details {
        flex-direction: column;
        gap: 8px;
    }
}

/* Pagination */
.pagination-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
}

.pagination {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.pagination-rounded .page-link {
    border-radius: 999px !important;
}

.pagination .page-item.disabled .page-link {
    pointer-events: none;
    opacity: 0.5;
}

.pagination .page-item.active .page-link {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--text-inverse);
    font-weight: var(--font-weight-medium);
}

.pagination .page-link {
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--border-color);
    padding: 6px 14px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    transition: var(--transition-base);
    text-decoration: none;
}

.pagination .page-link:hover {
    color: var(--accent);
    border-color: var(--accent);
}

.pagination .ellipsis .page-link {
    border: none;
    background: transparent;
    color: var(--text-secondary);
}

.pagination-summary {
    text-align: center;
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

/* Modal styles */
.modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal-overlay.active {
    display: flex;
}

.modal-content {
    background: var(--bg-card);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-lg);
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    animation: modalFadeIn 0.3s ease;
}

@keyframes modalFadeIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-header {
    padding: 24px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h3 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
}

.modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--border-radius-sm);
    transition: all 0.3s ease;
}

.modal-close:hover {
    background: var(--bg-secondary);
    color: var(--text-primary);
}

.modal-body {
    padding: 24px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: var(--font-weight-medium);
    color: var(--text-primary);
    font-size: 0.95rem;
}

.form-group .form-control {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 1rem;
    transition: all 0.3s ease;
}

.form-group .form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.form-group .form-control.error {
    border-color: var(--danger);
}

.form-error {
    color: var(--danger);
    font-size: 0.85rem;
    margin-top: 4px;
}

.modal-footer {
    padding: 20px 24px;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: flex-end;
    gap: 12px;
}

.btn-modal {
    padding: 10px 20px;
    border: none;
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.95rem;
}

.btn-modal-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.btn-modal-secondary:hover {
    background: var(--gray-100);
}

.btn-modal-primary {
    background: linear-gradient(135deg, #5DADE2 0%, #3498DB 100%);
    color: white;
}

.btn-modal-primary:hover {
    background: linear-gradient(135deg, #3498DB 0%, #2980B9 100%);
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}
</style>
{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-bell"></i> Alertes automatiques</h1>
            <p style="color: var(--gray-600); margin-top: 8px; font-size: 1rem;">
                Surveillance en temps réel des stocks et événements
            </p>
        </div>
    </div>

    <!-- Statistiques des alertes (toujours le total, même avec filtres) -->
    <div class="alerts-stats">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--warning), #f39c12);">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <h3>{{ alertesTotal|length }}</h3>
                <p>Alertes actives</p>
                <div class="stat-trend">
                    <i class="fas fa-info-circle"></i>
                    <span>Total des alertes</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--danger), #e74c3c);">
                <i class="fas fa-fire"></i>
            </div>
            <div class="stat-content">
                <h3>{{ alertesCritiques|length }}</h3>
                <p>Stock critique</p>
                <div class="stat-trend critical">
                    <i class="fas fa-exclamation"></i>
                    <span>Action requise</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--warning), #f39c12);">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <h3>{{ alertesAttention|length }}</h3>
                <p>Attention</p>
                <div class="stat-trend">
                    <i class="fas fa-bell"></i>
                    <span>Surveillance nécessaire</span>
                </div>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--accent), #3498db);">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-content">
                <h3>{{ eventsCount|default(0) }}</h3>
                <p>Événements actifs</p>
                <div class="stat-trend">
                    <i class="fas fa-info-circle"></i>
                    <span>En cours + à venir</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres des alertes -->
    <div class="card filters-card" style="margin-top: 20px;">
        <div class="card-body">
            <div class="filters-header" style="margin-bottom: 20px;">
                <h3 style="margin: 0;">
                    <i class="fas fa-filter"></i>
                    Filtres et recherche
                </h3>
                <button class="btn btn-sm btn-outline" id="clearFilters">
                    <i class="fas fa-times"></i>
                    Effacer
                </button>
            </div>
            
            <div class="filters-content">
            <div class="filter-group">
                <label>
                    <i class="fas fa-exclamation-circle"></i>
                    Niveau
                </label>
                <select id="filterNiveau" class="filter-select">
                    <option value="">Tous les niveaux</option>
                    <option value="critique" {% if niveauFilter == 'critique' %}selected{% endif %}>Critique</option>
                    <option value="attention" {% if niveauFilter == 'attention' %}selected{% endif %}>Attention</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label>
                    <i class="fas fa-tag"></i>
                    Catégorie
                </label>
                <select id="filterCategorie" class="filter-select">
                    <option value="">Toutes les catégories</option>
                    {% for categorieNom in categories %}
                        <option value="{{ categorieNom }}" {% if categorieFilter == categorieNom %}selected{% endif %}>
                            {{ categorieNom|capitalize }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="filter-group">
                <label>
                    <i class="fas fa-user"></i>
                    Segment d'âge
                </label>
                <select id="filterSegment" class="filter-select">
                    <option value="">Tous les segments</option>
                    {% for segmentNom in segments %}
                        <option value="{{ segmentNom }}" {% if segmentFilter == segmentNom %}selected{% endif %}>
                            {{ segmentNom|capitalize }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            </div>
        </div>
    </div>

    <!-- Liste des alertes -->
    <div class="alerts-container">
        {% if alertes is empty %}
            <div style="text-align: center; padding: 60px; color: var(--gray-600);">
                <i class="fas fa-check-circle" style="font-size: 4rem; margin-bottom: 16px; display: block; color: var(--success); opacity: 0.5;"></i>
                <h3 style="color: var(--success); margin-bottom: 8px;">Aucune alerte</h3>
                <p>Tous vos stocks sont à un niveau acceptable.</p>
            </div>
        {% else %}
            {% if alertesCritiquesPaginated|length > 0 %}
        <div class="alerts-section">
            <h3 class="section-title">
                <i class="fas fa-exclamation-triangle" style="color: var(--danger);"></i>
                Alertes critiques
            </h3>
            
                    {% for alerte in alertesCritiquesPaginated %}
                        {% set typeBillet = alerte.typeBillet %}
                        {% set inventaire = alerte.inventaire %}
                        {% set evenement = typeBillet.evenement %}
                        {% set categorieId = typeBillet.configurationCategorie ? typeBillet.configurationCategorie.id : 'sans_categorie' %}
                        {% set capaciteTotaleCategorie = (evenement and capaciteParCategorie[evenement.id][categorieId] is defined) ? capaciteParCategorie[evenement.id][categorieId] : 0 %}
                        <div class="alert-item alert-critical">
                <div class="alert-status">
                    <div class="alert-icon">
                        <i class="fas fa-fire"></i>
                    </div>
                    <div class="alert-priority">
                        <span class="priority-badge critical">
                            <i class="fas fa-exclamation"></i>
                            CRITIQUE
                        </span>
                    </div>
                </div>
                
                <div class="alert-content">
                    <div class="alert-header">
                                    <h4>{{ evenement ? evenement.titre : 'N/A' }} - {{ typeBillet.nom }}</h4>
                                    <span class="alert-time">Stock bas</span>
                    </div>
                    <p class="alert-description">
                                    Stock critique : seulement {{ alerte.quantiteRestante }} billet(s) restant(s) sur {{ inventaire.quantiteTotale }} ({{ alerte.pourcentage|number_format(1) }}%)
                    </p>
                    <div class="alert-details">
                                    {% if evenement %}
                                        {% if evenement.commenceLe %}
                        <span class="detail-item">
                            <i class="fas fa-calendar"></i>
                                                Événement : {{ evenement.commenceLe|date('d M Y') }}
                        </span>
                                        {% endif %}
                                        {% if evenement.lieu %}
                        <span class="detail-item">
                            <i class="fas fa-map-marker-alt"></i>
                                                {{ evenement.lieu.nom }}
                        </span>
                                        {% endif %}
                                    {% endif %}
                        <span class="detail-item">
                            <i class="fas fa-euro-sign"></i>
                                        Prix : {{ typeBillet.prixDeBase|number_format(2, ',', ' ') }} {{ typeBillet.devise }}
                        </span>
                    </div>
                </div>
                
                <div class="alert-actions">
                                {% if evenement %}
                                    <a href="{{ path('organisateur_events_show', { id: evenement.id }) }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                        Voir l'événement
                                    </a>
                                {% endif %}
                    <button class="btn btn-sm btn-secondary" onclick="openEditModal({{ typeBillet.id }}, '{{ typeBillet.prixDeBase }}', {{ inventaire.quantiteTotale }}, {{ inventaire.quantiteVendue }}, {{ capaciteTotaleCategorie }})">
                        <i class="fas fa-edit"></i>
                        Modifier stock
                    </button>
                </div>
            </div>
                    {% endfor %}
                    </div>
            {% endif %}
            
            {% if alertesAttentionPaginated|length > 0 %}
        <div class="alerts-section">
            <h3 class="section-title">
                <i class="fas fa-exclamation-triangle" style="color: var(--warning);"></i>
                Alertes d'attention
            </h3>
            
                    {% for alerte in alertesAttentionPaginated %}
                        {% set typeBillet = alerte.typeBillet %}
                        {% set inventaire = alerte.inventaire %}
                        {% set evenement = typeBillet.evenement %}
                        {% set categorieId = typeBillet.configurationCategorie ? typeBillet.configurationCategorie.id : 'sans_categorie' %}
                        {% set capaciteTotaleCategorie = (evenement and capaciteParCategorie[evenement.id][categorieId] is defined) ? capaciteParCategorie[evenement.id][categorieId] : 0 %}
            <div class="alert-item alert-warning">
                <div class="alert-status">
                    <div class="alert-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="alert-priority">
                        <span class="priority-badge warning">ATTENTION</span>
                    </div>
                </div>
                
                <div class="alert-content">
                    <div class="alert-header">
                                    <h4>{{ evenement ? evenement.titre : 'N/A' }} - {{ typeBillet.nom }}</h4>
                                    <span class="alert-time">Surveillance requise</span>
                    </div>
                    <p class="alert-description">
                                    Stock bas : {{ alerte.quantiteRestante }} billet(s) restant(s) sur {{ inventaire.quantiteTotale }} ({{ alerte.pourcentage|number_format(1) }}%)
                    </p>
                    <div class="alert-details">
                                    {% if evenement %}
                                        {% if evenement.commenceLe %}
                        <span class="detail-item">
                            <i class="fas fa-calendar"></i>
                                                Événement : {{ evenement.commenceLe|date('d M Y') }}
                        </span>
                                        {% endif %}
                                        {% if evenement.lieu %}
                        <span class="detail-item">
                            <i class="fas fa-map-marker-alt"></i>
                                                {{ evenement.lieu.nom }}
                        </span>
                                        {% endif %}
                                    {% endif %}
                        <span class="detail-item">
                            <i class="fas fa-euro-sign"></i>
                                        Prix : {{ typeBillet.prixDeBase|number_format(2, ',', ' ') }} {{ typeBillet.devise }}
                        </span>
                    </div>
                </div>
                
                <div class="alert-actions">
                                {% if evenement %}
                                    <a href="{{ path('organisateur_events_show', { id: evenement.id }) }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i>
                        Voir l'événement
                                    </a>
                                {% endif %}
                    <button class="btn btn-sm btn-secondary" onclick="openEditModal({{ typeBillet.id }}, '{{ typeBillet.prixDeBase }}', {{ inventaire.quantiteTotale }}, {{ inventaire.quantiteVendue }}, {{ capaciteTotaleCategorie }})">
                        <i class="fas fa-edit"></i>
                        Modifier stock
                    </button>
                </div>
            </div>
                    {% endfor %}
        </div>
            {% endif %}
        {% endif %}

        <!-- Pagination -->
        {% if totalPages > 1 %}
            {% set maxPagesToShow = 5 %}
            {% set startPage = currentPage - 2 %}
            {% if startPage < 1 %}
                {% set startPage = 1 %}
            {% endif %}
            {% set endPage = startPage + maxPagesToShow - 1 %}
            {% if endPage > totalPages %}
                {% set endPage = totalPages %}
            {% endif %}
            {% set startPage = endPage - maxPagesToShow + 1 %}
            {% if startPage < 1 %}
                {% set startPage = 1 %}
            {% endif %}

            <div class="pagination-wrapper" style="margin-top: 2rem;">
                <ul class="pagination pagination-rounded">
                    <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                        {% if currentPage == 1 %}
                            <span class="page-link" aria-disabled="true">Précédent</span>
                        {% else %}
                            <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                page: currentPage - 1,
                                niveau: niveauFilter|default(''),
                                categorie: categorieFilter|default(''),
                                segment: segmentFilter|default('')
                            }) }}" rel="prev">Précédent</a>
                        {% endif %}
                    </li>

                    {% if startPage > 1 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                page: 1,
                                niveau: niveauFilter|default(''),
                                categorie: categorieFilter|default(''),
                                segment: segmentFilter|default('')
                            }) }}">1</a>
                        </li>
                        {% if startPage > 2 %}
                            <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                        {% endif %}
                    {% endif %}

                    {% for page in startPage..endPage %}
                        <li class="page-item {{ page == currentPage ? 'active' }}">
                            {% if page == currentPage %}
                                <span class="page-link" aria-current="page">{{ page }}</span>
                            {% else %}
                                <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                    page: page,
                                    niveau: niveauFilter|default(''),
                                    categorie: categorieFilter|default(''),
                                    segment: segmentFilter|default('')
                                }) }}">{{ page }}</a>
                            {% endif %}
                        </li>
                    {% endfor %}

                    {% if endPage < totalPages %}
                        {% if endPage < totalPages - 1 %}
                            <li class="page-item ellipsis" aria-hidden="true"><span class="page-link">…</span></li>
                        {% endif %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                page: totalPages,
                                niveau: niveauFilter|default(''),
                                categorie: categorieFilter|default(''),
                                segment: segmentFilter|default('')
                            }) }}">{{ totalPages }}</a>
                        </li>
                    {% endif %}

                    <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                        {% if currentPage == totalPages %}
                            <span class="page-link" aria-disabled="true">Suivant</span>
                        {% else %}
                            <a class="page-link" href="{{ path('app_ticket_stock_alerts', { 
                                page: currentPage + 1,
                                niveau: niveauFilter|default(''),
                                categorie: categorieFilter|default(''),
                                segment: segmentFilter|default('')
                            }) }}" rel="next">Suivant</a>
                        {% endif %}
                    </li>
                </ul>
                </div>
            <div class="pagination-summary" style="text-align: center; margin-top: 0.75rem; color: var(--text-secondary); font-size: 0.9rem;">
                {% set startItem = ((currentPage - 1) * limit) + 1 %}
                {% set endItem = min(currentPage * limit, totalItems) %}
                <small>Page {{ currentPage }} sur {{ totalPages }} - Affichage de {{ startItem }} à {{ endItem }} sur {{ totalItems }} alerte(s)</small>
            </div>
        {% elseif totalItems > 0 %}
            <div class="pagination-wrapper" style="margin-top: 2rem;">
                <div class="pagination-summary" style="text-align: center; color: var(--text-secondary); font-size: 0.9rem;">
                    <small>Affichage de {{ totalItems }} alerte(s)</small>
        </div>
            </div>
        {% endif %}
    </div>
</div>

