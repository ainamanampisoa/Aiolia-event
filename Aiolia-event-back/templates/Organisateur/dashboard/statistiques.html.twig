{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Statistiques{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    .dashboard-header h1 {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .dashboard-header h1 i {
        font-size: 2rem;
        color: var(--accent);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.5rem;
        margin-bottom: 24px;
    }

    .stat-card {
        background: var(--bg-card);
        border-radius: var(--border-radius-lg);
        padding: 1.25rem 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.15rem;
    }

    .bg-primary { background: #2563eb; }
    .bg-success { background: #16a34a; }
    .bg-warning { background: #f59e0b; }
    .bg-info { background: #0ea5e9; }

    .stat-content h3 {
        font-size: 1.4rem;
        margin: 0;
    }

    .stat-content p {
        margin: 0.1rem 0 0;
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .search-section {
        background: var(--bg-card);
        border-radius: var(--border-radius-lg);
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-color);
    }

    .search-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        align-items: end;
    }

    .search-field label {
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
    }

    .form-input {
        width: 100%;
        padding: 10px 12px;
        border-radius: var(--border-radius-md);
        border: 1px solid var(--border-color);
        background: var(--bg-secondary);
        color: var(--text-primary);
    }

    .search-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 14px;
    }

    .btn {
        border-radius: var(--border-radius-md);
        padding: 10px 20px;
        font-size: 0.9rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: #2563eb;
        color: #fff;
    }

    .btn-secondary {
        background: var(--bg-secondary);
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
    }

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
    }

    .chart-card-full-width {
        grid-column: span 2;
    }

    .chart-card {
        background: var(--bg-card);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
    }

    .chart-card h3 {
        font-size: 1.1rem;
        margin-bottom: 0.75rem;
    }

    .chart-container {
        position: relative;
        height: 260px;
    }

    @media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .charts-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1><i class="fas fa-chart-line"></i> Statistiques de vos événements</h1>
            <p class="dashboard-subtitle">Suivez les performances de vos événements et vos dépenses d’abonnement.</p>
        </div>
    </div>

    <!-- 4 widgets -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon bg-primary">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-content">
                <h3>{{ statistics.widgets.published_events ?? 0 }}</h3>
                <p>Événements publiés</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon bg-success">
                <i class="fas fa-coins"></i>
            </div>
            <div class="stat-content">
                <h3>{{ (statistics.widgets.total_revenue ?? 0)|number_format(0, ',', ' ') }} Ar</h3>
                <p>Chiffre d'affaires ({{ periodLabel }})</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon bg-warning">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3>{{ statistics.widgets.total_participants ?? 0 }}</h3>
                <p>Participants totaux</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon bg-info">
                <i class="fas fa-credit-card"></i>
            </div>
            <div class="stat-content">
                <h3>{{ (statistics.widgets.current_month_subscription_expense ?? 0)|number_format(0, ',', ' ') }} Ar</h3>
                <p>Dépense abonnement (toutes les périodes)</p>
            </div>
        </div>
    </div>

    <!-- Filtres dates -->
    <div class="search-section">
        <form method="get" action="{{ path('app_organisateur_dashboard_statistiques') }}">
            <div class="search-grid">
                <div class="search-field">
                    <label for="date_from">Date de début</label>
                    <input
                        type="date"
                        id="date_from"
                        name="date_from"
                        class="form-input"
                        value="{{ dateFrom ? dateFrom|date('Y-m-d') : '' }}"
                    >
                </div>
                <div class="search-field">
                    <label for="date_to">Date de fin</label>
                    <input
                        type="date"
                        id="date_to"
                        name="date_to"
                        class="form-input"
                        value="{{ dateTo ? dateTo|date('Y-m-d') : '' }}"
                    >
                </div>
            </div>
            <div class="search-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Filtrer
                </button>
                <a href="{{ path('app_organisateur_dashboard_statistiques') }}" class="btn btn-secondary">
                    <i class="fas fa-redo"></i> Réinitialiser
                </a>
            </div>
        </form>
    </div>

    <!-- 4 charts -->
    <div class="charts-grid">
        <div class="chart-card">
            <h3><i class="fas fa-chart-line"></i> Évolution des ventes dans le temps ({{ periodLabel }})</h3>
            <div class="chart-container">
                <canvas id="salesEvolutionChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <h3><i class="fas fa-chart-pie"></i> Répartition des ventes par type ({{ periodLabel }})</h3>
            <div class="chart-container">
                <canvas id="salesDistributionChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <h3><i class="fas fa-chart-bar"></i> Comparaison des ventes par type de billet ({{ periodLabel }})</h3>
            <div class="chart-container">
                <canvas id="salesComparisonChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <h3><i class="fas fa-ticket-alt"></i> Taux de remplissage par événement ({{ periodLabel }})</h3>
            <div class="chart-container">
                <canvas id="occupancyChart"></canvas>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Données pour les graphiques
    const salesEvolution = {{ statistics.charts.sales_evolution|json_encode|raw }};
    const salesDistribution = {{ statistics.charts.sales_distribution|json_encode|raw }};
    const salesComparison = {{ statistics.charts.sales_comparison|json_encode|raw }};
    const ticketOccupancy = {{ statistics.charts.ticket_occupancy|json_encode|raw }};

    // Graphique 1 : Évolution des ventes dans le temps
    const salesEvolutionCtx = document.getElementById('salesEvolutionChart').getContext('2d');
    const salesEvolutionLabels = salesEvolution.map(item => {
        const date = new Date(item.date);
        return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
    });
    const salesEvolutionCounts = salesEvolution.map(item => item.count);
    const salesEvolutionRevenues = salesEvolution.map(item => item.revenue);

    new Chart(salesEvolutionCtx, {
        type: 'line',
        data: {
            labels: salesEvolutionLabels,
            datasets: [
                {
                    label: 'Nombre de billets vendus',
                    data: salesEvolutionCounts,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.1)',
                    yAxisID: 'y',
                    tension: 0.4
                },
                {
                    label: 'Chiffre d\'affaires (Ar)',
                    data: salesEvolutionRevenues,
                    borderColor: '#16a34a',
                    backgroundColor: 'rgba(22, 163, 74, 0.1)',
                    yAxisID: 'y1',
                    tension: 0.4
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Nombre de billets'
                    }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'CA (Ar)'
                    },
                    grid: {
                        drawOnChartArea: false,
                    },
                }
            }
        }
    });

    // Graphique 2 : Répartition des ventes par type (camembert)
    const salesDistributionCtx = document.getElementById('salesDistributionChart').getContext('2d');
    const distributionLabels = salesDistribution.map(item => item.category);
    const distributionRevenues = salesDistribution.map(item => item.revenue);

    new Chart(salesDistributionCtx, {
        type: 'pie',
        data: {
            labels: distributionLabels,
            datasets: [{
                label: 'Chiffre d\'affaires (Ar)',
                data: distributionRevenues,
                backgroundColor: [
                    'rgba(37, 99, 235, 0.8)',
                    'rgba(22, 163, 74, 0.8)',
                    'rgba(249, 115, 22, 0.8)',
                    'rgba(168, 85, 247, 0.8)',
                    'rgba(236, 72, 153, 0.8)',
                ],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const label = context.label || '';
                            const value = context.parsed || 0;
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                            return label + ': ' + new Intl.NumberFormat('fr-FR').format(value) + ' Ar (' + percentage + '%)';
                        }
                    }
                }
            }
        }
    });

    // Graphique 3 : Comparaison des ventes par type de billet
    const salesComparisonCtx = document.getElementById('salesComparisonChart').getContext('2d');
    const comparisonLabels = salesComparison.map(item => item.ticket_type);
    const comparisonCounts = salesComparison.map(item => item.count);
    const comparisonRevenues = salesComparison.map(item => item.revenue);

    new Chart(salesComparisonCtx, {
        type: 'bar',
        data: {
            labels: comparisonLabels,
            datasets: [
                {
                    label: 'Nombre de billets',
                    data: comparisonCounts,
                    backgroundColor: 'rgba(37, 99, 235, 0.8)',
                    yAxisID: 'y',
                },
                {
                    label: 'Chiffre d\'affaires (Ar)',
                    data: comparisonRevenues,
                    backgroundColor: 'rgba(22, 163, 74, 0.8)',
                    yAxisID: 'y1',
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Nombre de billets'
                    }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'CA (Ar)'
                    },
                    grid: {
                        drawOnChartArea: false,
                    },
                    ticks: {
                        callback: function(value) {
                            return new Intl.NumberFormat('fr-FR', {
                                notation: 'compact',
                                maximumFractionDigits: 1
                            }).format(value) + ' Ar';
                        }
                    }
                }
            }
        }
    });

    // Graphique 4 : Taux de remplissage par événement
    const occupancyCtx = document.getElementById('occupancyChart').getContext('2d');
    const occupancyLabels = ticketOccupancy.map(item => item.event_title);
    const occupancyRates = ticketOccupancy.map(item => item.occupation_rate);
    const soldTickets = ticketOccupancy.map(item => item.sold_tickets);
    const totalCapacity = ticketOccupancy.map(item => item.total_capacity);

    new Chart(occupancyCtx, {
        type: 'bar',
        data: {
            labels: occupancyLabels,
            datasets: [
                {
                    label: 'Taux de remplissage (%)',
                    data: occupancyRates,
                    backgroundColor: occupancyRates.map(rate => {
                        if (rate >= 90) return 'rgba(239, 68, 68, 0.8)'; // Rouge : presque complet
                        if (rate >= 70) return 'rgba(249, 115, 22, 0.8)'; // Orange : bien rempli
                        if (rate >= 50) return 'rgba(234, 179, 8, 0.8)'; // Jaune : moyen
                        return 'rgba(34, 197, 94, 0.8)'; // Vert : encore de la place
                    }),
                    borderColor: occupancyRates.map(rate => {
                        if (rate >= 90) return '#ef4444';
                        if (rate >= 70) return '#f97316';
                        if (rate >= 50) return '#eab308';
                        return '#22c55e';
                    }),
                    borderWidth: 1,
                    borderRadius: 6,
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    max: 100,
                    title: {
                        display: true,
                        text: 'Taux de remplissage (%)'
                    },
                    ticks: {
                        callback: function(value) {
                            return value + '%';
                        }
                    }
                }
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        afterLabel: function(context) {
                            const index = context.dataIndex;
                            const sold = soldTickets[index];
                            const total = totalCapacity[index];
                            const remaining = total - sold;
                            return [
                                `Billets vendus: ${sold}`,
                                `Capacité totale: ${total}`,
                                `Places restantes: ${remaining}`
                            ];
                        }
                    }
                },
                legend: {
                    display: true,
                    position: 'top'
                }
            }
        }
    });
</script>
{% endblock %}

