// ============================================================
// AIOLIA - STRUCTURE BACK-END OPTIMISÉE (50 TABLES)
// Génération : 2025-12-17
// Compatible avec dbdiagram.io
// ============================================================

Project aiolia_backend {
  database_type: 'PostgreSQL'
  
  Note: '''
    # AIOLIA - Plateforme de billetterie événementielle
    
    ## 50 tables organisées en 14 modules
    - Admin & Organisateurs
    - Gestion complète des événements
    - Billetterie & Paiements
    - Transactions mobiles
    - Notifications & Audit
  '''
}

// ============================================================
// MODULE 1 : UTILISATEURS & SESSIONS
// ============================================================

Table utilisateurs {
  id bigint [pk, increment]
  email text [not null, unique]
  identifiant_connexion varchar(255) [not null]
  methode_connexion varchar(20) [not null, default: 'password']
  hash_mot_de_passe text [not null]
  prenom text [not null]
  nom text
  telephone text
  code_langue varchar(10) [not null, default: 'fr-FR']
  url_avatar text
  role varchar(20) [not null, default: 'user']
  statut smallint [not null, default: 0]
  email_verifie boolean [not null, default: false]
  telephone_verifie boolean [not null, default: false]
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
  derniere_connexion_le timestamptz
  
  indexes {
    email
    (identifiant_connexion, methode_connexion) [unique]
  }
}

Table jetons_rafraichissement {
  id bigint [pk, increment]
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  hash_jeton text [not null, unique]
  id_session uuid
  adresse_ip inet
  emis_le timestamptz [not null, default: `now()`]
  expire_le timestamptz [not null]
  revoque_le timestamptz
  
  indexes {
    id_utilisateur
  }
}

// ============================================================
// MODULE 2 : AUDIT
// ============================================================

Table journaux_audit {
  id bigint [pk, increment]
  id_utilisateur_acteur bigint [ref: > utilisateurs.id]
  portee varchar(120) [not null]
  action varchar(120) [not null]
  type_entite varchar(120)
  id_entite bigint
  modifications jsonb
  adresse_ip inet
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    portee
    cree_le
    (type_entite, id_entite)
  }
}

// ============================================================
// MODULE 3 : PROFILS
// ============================================================

Table profils_admin {
  id bigint [pk, increment]
  id_utilisateur bigint [not null, unique, ref: - utilisateurs.id]
  nom_affichage text [not null]
  nom_legal text
  numero_tva text
  email_support text
  telephone_support varchar(20)
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
}

Table profils_organisateurs {
  id bigint [pk, increment]
  id_utilisateur bigint [not null, unique, ref: - utilisateurs.id]
  nom_affichage text [not null]
  nom_legal text
  numero_tva text
  email_support text
  telephone_support varchar(20)
  url_site_web text
  type_organisation varchar(20) [not null, default: 'individual']
  statut_verification varchar(20) [not null, default: 'pending']
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
}

// ============================================================
// MODULE 4 : ABONNEMENTS
// ============================================================

Table plans_abonnements {
  id bigint [pk, increment]
  code text [not null, unique]
  nom text [not null]
  description text
  niveau varchar(20) [not null, default: 'basic']
  periode_facturation varchar(20) [not null]
  nombre_periodes integer [not null, default: 1]
  devise char(3) [not null, default: 'MGA']
  prix decimal(12,2) [not null]
  taux_tva decimal(5,2) [not null, default: 20]
  fonctionnalites jsonb
  est_actif boolean [not null, default: true]
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (niveau, periode_facturation) [unique]
  }
}

Table abonnements_organisateurs {
  id bigint [pk, increment]
  id_profil_organisateur bigint [not null, ref: > profils_organisateurs.id]
  id_plan bigint [not null, ref: > plans_abonnements.id]
  statut varchar(20) [not null, default: 'pending']
  mois_prepayes_restants integer [not null, default: 0]
  commence_le timestamptz [not null, default: `now()`]
  debut_periode_courante timestamptz [not null, default: `now()`]
  fin_periode_courante timestamptz
  renouvellement_le timestamptz
  annuler_a_la_fin_periode boolean [not null, default: false]
  annule_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_profil_organisateur, statut)
  }
}

Table factures_abonnements {
  id bigint [pk, increment]
  numero_facture text [not null, unique]
  id_abonnement bigint [not null, ref: > abonnements_organisateurs.id]
  id_client bigint [not null, ref: > utilisateurs.id]
  id_mode_paiement bigint [ref: > modes_paiement.id]
  devise char(3) [not null, default: 'MGA']
  montant_total decimal(12,2) [not null, default: 0]
  mois_facturation date [not null]
  statut varchar(20) [not null, default: 'draft']
  emise_le timestamptz [not null, default: `now()`]
  echeance_le timestamptz
  payee_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    statut
    (id_abonnement, mois_facturation)
  }
}

Table elements_factures_abonnements {
  id bigint [pk, increment]
  id_facture bigint [not null, ref: > factures_abonnements.id]
  id_plan bigint [ref: > plans_abonnements.id]
  description text
  quantite integer [not null, default: 1]
  prix_unitaire decimal(12,2) [not null]
  montant_total decimal(12,2) [not null]
}

Table historique_paiements_abonnements {
  id bigint [pk, increment]
  id_facture bigint [not null, ref: > factures_abonnements.id]
  statut_de varchar(20)
  statut_vers varchar(20) [not null]
  modifie_le timestamptz [not null, default: `now()`]
}

// ============================================================
// MODULE 5 : LIEUX
// ============================================================

Table lieux {
  id bigint [pk, increment]
  id_profil_organisateur bigint [ref: > profils_organisateurs.id]
  nom text [not null]
  slug varchar(255) [unique]
  description text
  ligne_adresse_1 text
  ville text
  code_pays char(2) [not null, default: 'MG']
  latitude decimal(9,6)
  longitude decimal(9,6)
  email_contact text
  telephone_contact varchar(20)
  capacite integer
  est_actif boolean [not null, default: true]
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
  
  indexes {
    (ville, code_pays)
  }
}

Table espaces_lieux {
  id bigint [pk, increment]
  id_lieu bigint [not null, ref: > lieux.id]
  nom text [not null]
  description text
  capacite integer
  est_par_defaut boolean [not null, default: false]
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    id_lieu
  }
}

// ============================================================
// MODULE 6 : ÉVÉNEMENTS
// ============================================================

Table categories_evenements {
  id bigint [pk, increment]
  slug varchar(120) [not null, unique]
  libelle varchar(255) [not null]
  description text
  est_actif boolean [not null, default: true]
  ordre_affichage integer [not null, default: 0]
  cree_le timestamptz [not null, default: `now()`]
}

Table types_evenements {
  id bigint [pk, increment]
  slug varchar(120) [not null, unique]
  libelle varchar(255) [not null]
  description text
  cree_le timestamptz [not null, default: `now()`]
}

Table evenements {
  id bigint [pk, increment]
  id_profil_organisateur bigint [ref: > profils_organisateurs.id]
  id_categorie_principale bigint [ref: > categories_evenements.id]
  id_type_evenement bigint [ref: > types_evenements.id]
  id_lieu bigint [ref: > lieux.id]
  id_espace_principal bigint [ref: > espaces_lieux.id]
  slug varchar(255) [not null, unique]
  titre varchar(255) [not null]
  sous_titre varchar(255)
  description text
  url_image_couverture text
  statut varchar(20) [not null, default: 'draft']
  visibilite varchar(20) [not null, default: 'public']
  format_evenement varchar(20) [not null, default: 'in_person']
  capacite integer
  commence_le timestamptz [not null]
  se_termine_le timestamptz [not null]
  ventes_commencent_le timestamptz
  ventes_se_terminent_le timestamptz
  est_en_vedette boolean [not null, default: false]
  code_qr text
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
  
  indexes {
    (commence_le, se_termine_le)
    (statut, visibilite)
    id_profil_organisateur
  }
}

Table liens_categories_evenements {
  id_evenement bigint [not null, ref: > evenements.id]
  id_categorie bigint [not null, ref: > categories_evenements.id]
  
  indexes {
    (id_evenement, id_categorie) [pk]
  }
}

Table tags_evenements {
  id bigint [pk, increment]
  slug text [not null, unique]
  libelle text [not null]
  cree_le timestamptz [not null, default: `now()`]
}

Table liens_tags_evenements {
  id_evenement bigint [not null, ref: > evenements.id]
  id_tag bigint [not null, ref: > tags_evenements.id]
  
  indexes {
    (id_evenement, id_tag) [pk]
  }
}

Table sessions_evenements {
  id bigint [pk, increment]
  id_evenement bigint [not null, ref: > evenements.id]
  id_espace_lieu bigint [ref: > espaces_lieux.id]
  titre text
  description text
  commence_le timestamptz [not null]
  se_termine_le timestamptz [not null]
  capacite integer
  cree_le timestamptz [not null, default: `now()`]
}

Table medias_evenements {
  id bigint [pk, increment]
  id_evenement bigint [not null, ref: > evenements.id]
  type_media varchar(20) [not null]
  url text [not null]
  texte_alternatif text
  ordre_affichage integer [not null, default: 0]
  est_public boolean [not null, default: true]
  cree_le timestamptz [not null, default: `now()`]
}

Table vues_evenements {
  id bigint [pk, increment]
  id_evenement bigint [not null, ref: > evenements.id]
  id_utilisateur bigint [ref: > utilisateurs.id]
  adresse_ip inet
  type_vue varchar(20) [not null, default: 'page']
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_evenement, cree_le)
    id_utilisateur
  }
}

Table organisateurs_evenements {
  id_evenement bigint [not null, ref: > evenements.id]
  id_profil_organisateur bigint [not null, ref: > profils_organisateurs.id]
  role varchar(30) [not null, default: 'co_organisateur']
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_evenement, id_profil_organisateur) [pk]
  }
}

Table langues {
  id bigint [pk, increment]
  code varchar(10) [not null, unique]
  libelle varchar(255) [not null]
  est_actif boolean [not null, default: true]
  cree_le timestamptz [not null, default: `now()`]
}

Table liens_langues_evenements {
  id_evenement bigint [not null, ref: > evenements.id]
  id_langue bigint [not null, ref: > langues.id]
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_evenement, id_langue) [pk]
  }
}

// ============================================================
// MODULE 7 : BILLETTERIE
// ============================================================

Table configuration_segments_billets {
  id bigint [pk, increment]
  nom varchar(20) [not null, unique]
  age_min integer
  age_max integer
  pourcentage_prix decimal(5,2) [not null, default: 0]
  est_actif boolean [not null, default: true]
  cree_le timestamptz [not null, default: `now()`]
}

Table configuration_categories_billets {
  id bigint [pk, increment]
  nom varchar(20) [not null, unique]
  description text
  pourcentage_prix decimal(5,2) [not null, default: 0]
  est_actif boolean [not null, default: true]
  cree_le timestamptz [not null, default: `now()`]
}

Table types_billets {
  id bigint [pk, increment]
  id_evenement bigint [not null, ref: > evenements.id]
  id_session bigint [ref: > sessions_evenements.id]
  id_configuration_categorie bigint [not null, ref: > configuration_categories_billets.id]
  id_configuration_segment bigint [not null, ref: > configuration_segments_billets.id]
  nom text [not null]
  description text
  devise char(3) [not null, default: 'MGA']
  prix_de_base decimal(12,2) [not null]
  frais_service decimal(12,2) [not null, default: 0]
  taux_tva decimal(5,2) [not null, default: 0]
  ventes_commencent_le timestamptz
  ventes_se_terminent_le timestamptz
  minimum_par_commande integer [not null, default: 1]
  maximum_par_commande integer
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    id_evenement
  }
}

Table inventaire_billets {
  id_type_billet bigint [pk, ref: - types_billets.id]
  quantite_totale integer [not null]
  quantite_reservee integer [not null, default: 0]
  quantite_vendue integer [not null, default: 0]
  modifie_le timestamptz [not null, default: `now()`]
}

Table historique_prix_billets {
  id bigint [pk, increment]
  id_type_billet bigint [not null, ref: > types_billets.id]
  modifie_par bigint [ref: > utilisateurs.id]
  prix_precedent decimal(12,2)
  nouveau_prix decimal(12,2)
  modifie_le timestamptz [not null, default: `now()`]
  raison text
}

Table listes_attente_billets {
  id bigint [pk, increment]
  id_evenement bigint [not null, ref: > evenements.id]
  id_type_billet bigint [not null, ref: > types_billets.id]
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  quantite_demandee integer [not null]
  statut varchar(20) [not null, default: 'pending']
  position integer
  cree_le timestamptz [not null, default: `now()`]
  notifie_le timestamptz
  
  indexes {
    id_type_billet
    id_utilisateur
    (id_type_billet, statut)
    (id_evenement, id_type_billet, id_utilisateur) [unique]
  }
}

Table billets {
  id bigint [pk, increment]
  id_element_commande bigint [ref: > elements_commandes.id]
  id_type_billet bigint [not null, ref: > types_billets.id]
  id_utilisateur_proprietaire bigint [ref: > utilisateurs.id]
  statut varchar(20) [not null, default: 'valid']
  code_qr text [not null]
  checksum_qr text
  emis_le timestamptz [not null, default: `now()`]
}

// ============================================================
// MODULE 8 : PANIERS
// ============================================================

Table paniers {
  id bigint [pk, increment]
  id_utilisateur bigint [ref: > utilisateurs.id]
  statut varchar(20) [not null, default: 'active']
  jeton_session text [unique]
  devise char(3) [not null, default: 'MGA']
  montant_total decimal(12,2) [not null, default: 0]
  expire_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
}

Table elements_paniers {
  id bigint [pk, increment]
  id_panier bigint [not null, ref: > paniers.id]
  id_type_billet bigint [not null, ref: > types_billets.id]
  quantite integer [not null]
  prix_unitaire decimal(12,2) [not null]
  prix_total decimal(12,2) [not null]
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_panier, id_type_billet) [unique]
  }
}

// ============================================================
// MODULE 9 : COMMANDES
// ============================================================

Table commandes {
  id bigint [pk, increment]
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  id_panier bigint [ref: > paniers.id]
  statut varchar(20) [not null, default: 'pending']
  montant_total decimal(12,2) [not null]
  montant_remise decimal(12,2) [not null, default: 0]
  devise char(3) [not null, default: 'MGA']
  code_promotion text
  paiement_due_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
  
  indexes {
    id_utilisateur
  }
}

Table elements_commandes {
  id bigint [pk, increment]
  id_commande bigint [not null, ref: > commandes.id]
  id_type_billet bigint [not null, ref: > types_billets.id]
  quantite integer [not null]
  prix_unitaire decimal(12,2) [not null]
  frais_service decimal(12,2) [not null, default: 0]
  montant_tva decimal(12,2) [not null, default: 0]
  montant_total decimal(12,2) [not null]
  cree_le timestamptz [not null, default: `now()`]
}

Table historique_statuts_commandes {
  id bigint [pk, increment]
  id_commande bigint [not null, ref: > commandes.id]
  statut_de varchar(20)
  statut_vers varchar(20) [not null]
  modifie_par bigint [ref: > utilisateurs.id]
  modifie_le timestamptz [not null, default: `now()`]
}

// ============================================================
// MODULE 10 : PAIEMENTS & FACTURES
// ============================================================

Table modes_paiement {
  id bigint [pk, increment]
  code varchar(50) [not null, unique]
  libelle varchar(255) [not null]
  description text
  icone varchar(120)
  est_actif boolean [not null, default: true]
  ordre_affichage integer [not null, default: 0]
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    code
  }
}

Table factures_billets {
  id bigint [pk, increment]
  numero_facture text [not null, unique]
  id_commande bigint [ref: > commandes.id]
  id_client bigint [not null, ref: > utilisateurs.id]
  id_mode_paiement bigint [ref: > modes_paiement.id]
  devise char(3) [not null, default: 'MGA']
  montant_total decimal(12,2) [not null, default: 0]
  statut varchar(20) [not null, default: 'draft']
  emise_le timestamptz [not null, default: `now()`]
  echeance_le timestamptz
  payee_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    statut
    id_mode_paiement
  }
}

Table historique_paiements_billets {
  id bigint [pk, increment]
  id_facture bigint [not null, ref: > factures_billets.id]
  statut_de varchar(20)
  statut_vers varchar(20) [not null]
  modifie_le timestamptz [not null, default: `now()`]
}

// ============================================================
// MODULE 11 : TRANSACTIONS MOBILES
// ============================================================

Table transactions_paiement_mobile {
  id bigint [pk, increment]
  reference_transaction text [not null, unique]
  id_facture bigint [not null, ref: > factures_abonnements.id]
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  id_profil_organisateur bigint [not null, ref: > profils_organisateurs.id]
  operateur_mobile varchar(20) [not null]
  type_paiement varchar(20) [not null, default: 'abonnement']
  numero_telephone varchar(20) [not null]
  numero_transaction_operateur text
  montant decimal(12,2) [not null]
  devise char(3) [not null, default: 'MGA']
  statut_paiement varchar(20) [not null, default: 'initiated']
  initie_le timestamptz [not null, default: `now()`]
  confirme_le timestamptz
  expire_le timestamptz [not null, default: `now() + 24 hours`]
  
  indexes {
    reference_transaction
    id_facture
    id_utilisateur
    statut_paiement
  }
}

// ============================================================
// MODULE 12 : PROMOTIONS
// ============================================================

Table codes_promotionnels {
  id bigint [pk, increment]
  id_profil_organisateur bigint [ref: > profils_organisateurs.id]
  code text [not null, unique]
  type_promotion varchar(20) [not null]
  valeur decimal(12,2) [not null]
  utilisation_maximale_totale integer
  utilisation_maximale_par_utilisateur integer
  commence_le timestamptz
  se_termine_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  date_suppression timestamptz
}

Table applications_promotions {
  id bigint [pk, increment]
  id_promotion bigint [not null, ref: > codes_promotionnels.id]
  id_commande bigint [not null, ref: > commandes.id]
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  montant_remise decimal(12,2) [not null, default: 0]
  applique_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_promotion, id_commande) [unique]
  }
}

Table regles_tarification {
  id bigint [pk, increment]
  id_type_billet bigint [not null, ref: > types_billets.id]
  type_regle varchar(20) [not null]
  valeur_seuil decimal(12,2)
  valeur decimal(12,2)
  commence_le timestamptz
  se_termine_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
}

// ============================================================
// MODULE 13 : FAVORIS & RÉSEAUX
// ============================================================

Table listes_souhaits {
  id bigint [pk, increment]
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  titre text [not null, default: 'Favoris']
  est_par_defaut boolean [not null, default: false]
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_utilisateur) [unique, note: 'WHERE est_par_defaut']
  }
}

Table elements_listes_souhaits {
  id_liste_souhaits bigint [not null, ref: > listes_souhaits.id]
  id_evenement bigint [not null, ref: > evenements.id]
  ajoute_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_liste_souhaits, id_evenement) [pk]
  }
}

Table participations_loteries_billets {
  id bigint [pk, increment]
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  id_evenement bigint [ref: > evenements.id]
  type_lot varchar(20) [not null]
  valeur_lot decimal(12,2) [not null, default: 0]
  statut varchar(20) [not null, default: 'pending']
  cree_le timestamptz [not null, default: `now()`]
  reclame_le timestamptz
}

Table connexions_utilisateurs {
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  id_utilisateur_cible bigint [not null, ref: > utilisateurs.id]
  type_relation varchar(20) [not null, default: 'friend']
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_utilisateur, id_utilisateur_cible) [pk]
  }
}

Table invitations_evenements {
  id bigint [pk, increment]
  id_evenement bigint [not null, ref: > evenements.id]
  id_utilisateur_expediteur bigint [not null, ref: > utilisateurs.id]
  id_utilisateur_destinataire bigint [ref: > utilisateurs.id]
  email_destinataire text
  statut varchar(20) [not null, default: 'pending']
  jeton text [not null, unique]
  envoye_le timestamptz [not null, default: `now()`]
}

Table cache_recommandations {
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  id_evenement bigint [not null, ref: > evenements.id]
  score decimal(6,3) [not null]
  raison text
  genere_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_utilisateur, id_evenement) [pk]
  }
}

// ============================================================
// MODULE 14 : NOTIFICATIONS
// ============================================================

Table modeles_notifications {
  id bigint [pk, increment]
  code text [not null, unique]
  canal varchar(20) [not null]
  sujet text
  corps text [not null]
  cree_le timestamptz [not null, default: `now()`]
}

Table notifications {
  id bigint [pk, increment]
  id_utilisateur bigint [not null, ref: > utilisateurs.id]
  id_modele bigint [ref: > modeles_notifications.id]
  canal varchar(20) [not null]
  statut varchar(20) [not null, default: 'pending']
  charge_utile jsonb
  programme_le timestamptz
  envoye_le timestamptz
  lu_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  
  indexes {
    (id_utilisateur, statut)
  }
}

Table historique_notifications {
  id bigint [pk, increment]
  id_notification bigint [not null, ref: > notifications.id]
  statut varchar(20) [not null]
  message text
  cree_le timestamptz [not null, default: `now()`]
}

Table transferts_billets {
  id bigint [pk, increment]
  id_billet bigint [not null, ref: > billets.id]
  id_utilisateur_de bigint [ref: > utilisateurs.id]
  id_utilisateur_vers bigint [ref: > utilisateurs.id]
  email_vers text
  statut varchar(20) [not null, default: 'pending']
  jeton text [not null, unique]
  expire_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
}

